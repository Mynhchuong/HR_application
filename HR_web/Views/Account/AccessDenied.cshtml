@{
    ViewData["Title"] = "Không có quyền truy cập";
    Layout = "_Layout";
}

<style>
    .denied-wrap {
        min-height: 60vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
    }
    .denied-card {
        max-width: 420px;
        width: 100%;
        background: #fff;
        border-radius: 24px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.08);
        padding: 2.5rem 2rem;
        text-align: center;
    }
    .denied-icon {
        width: 72px; height: 72px;
        background: #fff1f2;
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 1.25rem;
    }
    .denied-icon i { font-size: 2rem; color: #ef4444; }
    .denied-title { font-size: 1.2rem; font-weight: 800; color: #1e293b; margin-bottom: 0.5rem; }
    .denied-sub { font-size: 0.88rem; color: #64748b; line-height: 1.6; margin-bottom: 1.75rem; }
    .denied-btn { border-radius: 10px; font-weight: 600; padding: .55rem 1.5rem; }
</style>

<div class="denied-wrap">
    <div class="denied-card">
        <div class="denied-icon">
            <i class="bi bi-shield-lock-fill"></i>
        </div>
        <div class="denied-title">Không có quyền truy cập</div>
        <p class="denied-sub">
            Trang này chỉ dành cho <strong>quản trị viên</strong>.<br>
            Vui lòng liên hệ Admin nếu bạn cần hỗ trợ.
        </p>
        <a href="@Url.Action("Index", "Home")" class="btn btn-primary denied-btn mb-0">
            <i class="bi bi-house me-1"></i>Về trang chủ
        </a>
    </div>
</div>
