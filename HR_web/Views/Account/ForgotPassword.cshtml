@model HR_web.Models.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0">
    <title>Quên mật khẩu | My Samho</title>

    <link href="https://fonts.googleapis.com/css?family=Inter:300,400,500,600,700" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        html, body { margin:0; padding:0; min-height:100vh; font-family:'Inter',sans-serif; background:#0f172a; overflow-x:hidden; }
        .fp-wrap {
            min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px;
            background: linear-gradient(rgba(0,0,0,.4), rgba(0,0,0,.4)), url('@Url.Content("~/assets/img/Login.jpg")');
            background-size: cover; background-position: center;
        }
        .fp-card {
            width: 100%; max-width: 440px;
            background: rgba(255,255,255,.92);
            backdrop-filter: blur(15px);
            border-radius: 28px; box-shadow: 0 25px 50px -12px rgba(0,0,0,.5);
            overflow: hidden;
        }
        .fp-hd {
            padding: 28px 30px 14px; text-align: center;
        }
        .fp-hd-icon {
            width: 72px; height: 72px; display: inline-flex; align-items: center; justify-content: center;
            background: linear-gradient(135deg, #dc2626, #b91c1c);
            border-radius: 18px; box-shadow: 0 8px 20px rgba(220,38,38,.35);
            color: white; font-size: 2rem; margin-bottom: 14px;
        }
        .fp-hd h4 { font-weight: 800; color: #1e293b; margin: 0; letter-spacing: -.01em; }
        .fp-hd small { color: #64748b; font-size: .85rem; }

        .fp-body { padding: 0 28px 26px; }

        .form-group { margin-bottom: .9rem; }
        .form-label { font-size: .78rem; font-weight: 700; color: #475569; margin-bottom: 5px;
                      text-transform: uppercase; letter-spacing: .04em; display: block; }
        .form-control-custom {
            width: 100%; padding: .65rem .85rem; font-size: .95rem;
            background: white; border: 1.5px solid #e2e8f0; border-radius: 12px;
            outline: none; transition: border-color .15s, box-shadow .15s; font-family: inherit;
        }
        .form-control-custom:focus { border-color: #dc2626; box-shadow: 0 0 0 3px rgba(220,38,38,.12); }

        .fp-info {
            background: #fffbeb; border: 1.5px solid #fcd34d; border-radius: 12px;
            padding: .65rem .85rem; margin-bottom: 1rem; color: #78350f; font-size: .8rem; line-height: 1.45;
        }
        .fp-info b { color: #b45309; }

        .btn-submit {
            width: 100%; padding: .75rem; border: none;
            background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
            color: white; border-radius: 12px; font-weight: 800; font-size: .95rem; cursor: pointer;
            transition: transform .15s, box-shadow .15s;
            box-shadow: 0 8px 18px rgba(220,38,38,.3);
        }
        .btn-submit:hover { transform: translateY(-1px); }
        .btn-submit:active { transform: translateY(0); opacity: .9; }

        .fp-back {
            display: block; text-align: center; margin-top: 14px;
            color: #64748b; font-size: .85rem; text-decoration: none; font-weight: 600;
        }
        .fp-back:hover { color: #1e293b; }

        .error-message {
            background: #fef2f2; border: 1.5px solid #fecaca; color: #b91c1c;
            border-radius: 10px; padding: .55rem .75rem; font-size: .82rem; margin-bottom: 1rem; line-height: 1.45;
        }
    </style>
</head>
<body>
<div class="fp-wrap">
    <div class="fp-card">
        <div class="fp-hd">
            <div class="fp-hd-icon">🔑</div>
            <h4>Quên mật khẩu</h4>
            <small>Đặt lại mật khẩu bằng CCCD đã đăng ký</small>
        </div>
        <div class="fp-body">
            <div class="fp-info">
                <b>⚠️ Lưu ý:</b> Mỗi nhân viên chỉ được tự đặt lại mật khẩu <b>1 lần / tuần</b>.<br>
                Nếu quá hạn hoặc không nhớ CCCD, vui lòng liên hệ <b>phòng Nhân sự</b>.
            </div>

            <form asp-controller="Account" asp-action="ForgotPassword" method="post" autocomplete="off">
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="error-message">
                        @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage))
                        {
                            <div>● @err</div>
                        }
                    </div>
                }

                <div class="form-group">
                    <label class="form-label">Mã số nhân viên</label>
                    <input asp-for="EMPCD" class="form-control-custom" placeholder="VD: 24092522"
                           autocomplete="off" />
                </div>
                <div class="form-group">
                    <label class="form-label">Số CCCD</label>
                    <input asp-for="Juminno" class="form-control-custom" placeholder="VD: 071202003456" maxlength="20"
                           autocomplete="off" />
                </div>
                <div class="form-group">
                    <label class="form-label">Ngày cấp CCCD</label>
                    <input asp-for="JuminnoDate" type="date" class="form-control-custom" />
                </div>
                <div class="form-group">
                    <label class="form-label">Mật khẩu mới</label>
                    <input asp-for="NewPassword" type="password" class="form-control-custom"
                           placeholder="Ít nhất 6 ký tự" autocomplete="new-password" />
                </div>
                <div class="form-group">
                    <label class="form-label">Xác nhận mật khẩu</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control-custom"
                           placeholder="Nhập lại" autocomplete="new-password" />
                </div>

                <button type="submit" class="btn-submit">🔑 Đặt lại mật khẩu</button>
                <a href="@Url.Action("Login","Account")" class="fp-back">← Quay lại đăng nhập</a>
            </form>
        </div>
    </div>
</div>
</body>
</html>
