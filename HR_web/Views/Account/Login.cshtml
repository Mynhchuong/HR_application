@model HR_web.Models.Account.LoginModel
@{
    ViewData["Title"] = "Đăng nhập / Sign in";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0">
    <title>HR Application | Login</title>
    <link rel="icon" type="image/png" href="~/assets/img/samho-logo.png" />

    <link href="~/lib/googlefonts/inter.css" rel="stylesheet" />
    <link href="~/lib/googlefonts/material-symbols.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        :root {
            --primary: #4f46e5;
            --primary-dark: #4338ca;
        }

        html, body {
            margin: 0; padding: 0; min-height: 100vh;
            font-family: 'Inter', sans-serif;
            background: #0f172a;
            overflow-x: hidden;
        }

        .login-wrapper {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            position: relative;
            background: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)), url('@Url.Content("~/assets/img/Login.jpg")');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }

        .login-card {
            width: 100%;
            max-width: 400px;
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border-radius: 32px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.3);
            overflow: hidden;
            z-index: 1;
            animation: cardAppear 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @@keyframes cardAppear {
            from { transform: translateY(20px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        .login-header {
            padding: 40px 30px 20px;
            text-align: center;
        }

        .login-logo {
            width: 80px;
            height: 80px;
            margin-bottom: 20px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 10px 20px rgba(0,0,0,0.05);
        }

        .login-logo img { width: 48px; height: auto; }

        .login-header h4 { font-weight: 800; color: #1e293b; letter-spacing: -0.02em; margin: 0; }
        .login-header p { color: #64748b; font-size: 0.95rem; margin-top: 8px; }

        .login-body { padding: 0 32px 40px; }

        .input-group-custom {
            margin-bottom: 20px;
        }

        .form-label {
            font-size: 0.85rem;
            font-weight: 700;
            color: #475569;
            margin-bottom: 8px;
            display: block;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .form-control-custom {
            width: 100%;
            height: 58px;
            background: rgba(255, 255, 255, 0.9);
            border: 2px solid transparent;
            border-radius: 16px;
            padding: 0 20px;
            font-size: 1rem;
            font-weight: 500;
            transition: all 0.2s ease;
            color: #1e293b;
        }

        .form-control-custom:focus {
            outline: none;
            border-color: var(--primary);
            background: #fff;
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
        }

        .password-wrap { position: relative; }
        .password-toggle {
            position: absolute; right: 16px; top: 50%;
            transform: translateY(-50%); cursor: pointer;
            color: #94a3b8;
            padding: 8px;
        }

        .btn-login {
            width: 100%;
            height: 58px;
            background: var(--primary);
            color: #fff;
            border: none;
            border-radius: 18px;
            font-size: 1.1rem;
            font-weight: 700;
            box-shadow: 0 10px 15px -3px rgba(79, 70, 229, 0.4);
            transition: all 0.2s ease;
            margin-top: 10px;
        }

        .btn-login:active { transform: scale(0.97); background: var(--primary-dark); }

        .form-check-input { width: 1.25em; height: 1.25em; border-radius: 6px !important; }
        .form-check-label { font-size: 0.95rem; font-weight: 500; color: #475569; padding-left: 5px; }

        .error-message {
            color: #ef4444;
            font-size: 0.85rem;
            font-weight: 600;
            margin-top: 15px;
            text-align: center;
        }

        /* Máy tính: trang này CHỈ dành cho web desktop (điện thoại/app đi LoginMobile.cshtml),
           nên trải thẻ ra 2 cột cho đỡ trống trải thay vì 1 thẻ 400px lọt giữa màn hình rộng. */
        @@media (min-width: 992px) {
            .login-card {
                max-width: 880px;
                display: grid;
                grid-template-columns: 0.85fr 1.15fr;
                background: rgba(255, 255, 255, 0.92);
            }

            .login-header {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                text-align: center;
                padding: 56px 36px;
                background: linear-gradient(160deg, #1e293b 0%, #0f172a 100%);
            }

            .login-header h4 span:last-child { color: #fff !important; }

            .login-tagline { display: block; }

            .login-body {
                padding: 52px 48px;
                display: flex;
                align-items: center;
            }

            .login-body > form { width: 100%; }
        }

        @@media (max-width: 480px) {
            .login-card { border-radius: 24px; border: none; max-width: 92%; background: rgba(255, 255, 255, 0.9); }
            .login-wrapper { padding: 15px; background-attachment: fixed; }
            .login-header { padding: 30px 20px 15px; }
            .login-body { padding: 0 24px 30px; }
        }
    </style>
    <style>.ic3d{width:1.25em;height:1.25em;object-fit:contain;display:inline-block;vertical-align:-0.25em}</style>
</head>
<body>
    <div class="login-wrapper">

        <div class="login-card">
            <div class="login-header">
                <div class="login-logo">
                    <img src="~/assets/img/samho-logo.png" alt="Company Logo" />
                </div>
                <h4 style="font-size: 1.8rem;">
                    <span style="color: #ed1c24;">My</span> 
                    <span style="color: #1e293b;">SAMHO</span>
                </h4>
                <p class="login-tagline"
                   style="display:none;color:#94a3b8;font-size:.9rem;line-height:1.6;margin:14px 0 0;">
                    Cổng thông tin nhân sự Samho<br />
                    <span style="color:#64748b;">Samho HR portal</span>
                </p>
            </div>

            <div class="login-body">
                <form asp-controller="Account" asp-action="Login" method="post" autocomplete="off">
                    @Html.AntiForgeryToken()

                    @if (TempData["InfoMessage"] != null)
                    {
                        <div style="background:#dcfce7;border:1.5px solid #86efac;color:#166534;border-radius:10px;padding:.6rem .8rem;font-size:.82rem;margin-bottom:1rem;line-height:1.45;">
                            @Html.Icon3D("success") @TempData["InfoMessage"]
                        </div>
                    }

                    <div class="input-group-custom">
                        <label class="form-label">Mã số nhân viên / Employee ID</label>
                        <input asp-for="EMPCD" class="form-control-custom" placeholder="VD / e.g. 11292522"
                               autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" />
                    </div>

                    <div class="input-group-custom">
                        <label class="form-label">Mật khẩu / Password</label>
                        <div class="password-wrap">
                            <input asp-for="Password" type="password" id="passwordInput"
                                   class="form-control-custom" placeholder="••••••••"
                                   autocomplete="new-password" />
                            <span class="password-toggle material-symbols-rounded" onclick="togglePassword()">visibility</span>
                        </div>
                    </div>

                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" id="rememberMe" />
                            <label class="form-check-label" for="rememberMe">Lưu tài khoản / Remember me</label>
                        </div>
                    </div>

                    @* Chỉ hiện khi mở trong app (JS ở cuối trang bỏ d-none) — trình duyệt thường
                       không có Face ID/vân tay nên hiện ra chỉ gây khó hiểu. *@
                    <div class="form-check mb-4 d-none" id="bioOptIn">
                        <input class="form-check-input" type="checkbox" id="bioOptInCheck" />
                        <label class="form-check-label" for="bioOptInCheck">
                            Lần sau đăng nhập bằng Face ID / vân tay
                            <span class="d-block text-muted" style="font-size:.78rem;line-height:1.3">
                                Sign in with Face ID / fingerprint next time
                            </span>
                        </label>
                    </div>

                    @* Thông báo đẩy từ nơi khác sang (vd phiên hết hạn -> AntiforgeryExpiredFilter).
                       Trước đây TempData không được hiện ở trang này nên NV bị đá về Login mà
                       không hiểu vì sao (2026-11-12). *@
                    @if (TempData["ErrorMessage"] is string loginNotice && !string.IsNullOrWhiteSpace(loginNotice))
                    {
                        <div class="error-message">
                            <span class="material-symbols-rounded align-middle me-1" style="font-size: 1.1rem;">info</span>
                            @loginNotice
                        </div>
                    }

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="error-message">
                            <span class="material-symbols-rounded align-middle me-1" style="font-size: 1.1rem;">error</span>
                            Sai tài khoản hoặc mật khẩu / Incorrect ID or password
                        </div>
                    }

                    <button type="submit" class="btn-login">Đăng nhập / Sign in</button>

                    <a href="@Url.Action("ForgotPassword","Account")"
                       style="display:block;text-align:center;font-size:.85rem;color:#dc2626;font-weight:700;text-decoration:none;margin-top:.65rem;">
                        @Html.Icon3D("login") Quên mật khẩu? / Forgot password?
                    </a>
                </form>
            </div>
        </div>
    </div>

    <script>
        function togglePassword() {
            const input = document.getElementById("passwordInput");
            const icon = document.querySelector(".password-toggle");
            if (input.type === "password") {
                input.type = "text";
                icon.textContent = "visibility_off";
            } else {
                input.type = "password";
                icon.textContent = "visibility";
            }
        }

        // Prevent iOS zoom on input focus
        document.addEventListener('gesturestart', function (e) {
            e.preventDefault();
        });

        // Gửi mã NV + mật khẩu cho app native lưu an toàn (Keychain/Keystore, gắn Face ID/vân tay) để
        // tự đăng nhập lại lần sau khỏi gõ tay — session web hết hạn cứng sau 24h (Program.cs,
        // SlidingExpiration=false) nên NV bị văng ra đăng nhập lại MỖI NGÀY (yêu cầu 2026-10-26).
        //
        // 2026-11-13: TRƯỚC ĐÂY LƯU LUÔN KHÔNG HỎI — NV không biết mật khẩu mình đang được lưu trên máy
        // và không có chỗ nào tắt. Giờ phải có ô tick, NV tự chọn; tắt được lại ở trang Cài đặt.
        // Lựa chọn lưu trong localStorage (theo từng MÁY, đúng bản chất — Face ID gắn với máy đó),
        // Settings/Index đọc ghi đúng khoá này.
        // Không chặn submit dù bridge lỗi gì — đây chỉ là tiện ích phụ, đăng nhập thường vẫn phải chạy.
        (function () {
            var form = document.querySelector('.login-body form');
            if (!form) return;

            var hasBridge =
                (window.webkit && window.webkit.messageHandlers && window.webkit.messageHandlers.saveCredentials) ||
                (window.Android && typeof window.Android.saveCredentials === 'function');

            // Khoá ĐỔI TÊN sang _v2 có chủ ý (2026-11-13): bản trước có đoạn dò sinh trắc học bằng
            // PublicKeyCredential — trong WKWebView nó luôn trả false nên đã GHI NHẦM '0' (tắt) vào máy
            // của mọi NV mở trang Cài đặt lúc đó. Giữ nguyên khoá cũ thì họ cứ thấy "Đang tắt" mãi mà
            // không hiểu vì sao. Dùng khoá mới = bỏ qua giá trị rác đó, ai cũng về mặc định bật lại.
            var KEY = 'bio_login_v2';
            function prefOn() {
                try { return localStorage.getItem(KEY) !== '0'; } catch (e) { return true; }
            }

            // Chỉ hiện ô tick khi đang chạy trong app — trình duyệt thường không có Face ID/vân tay.
            var box = document.getElementById('bioOptIn');
            if (hasBridge && box) {
                box.classList.remove('d-none');
                var cb = document.getElementById('bioOptInCheck');
                cb.checked = prefOn();
                cb.addEventListener('change', function () {
                    try { localStorage.setItem(KEY, cb.checked ? '1' : '0'); } catch (e) {}
                    // Bỏ tick = không muốn nữa -> xoá luôn thông tin đã lưu trước đó trên máy này.
                    if (!cb.checked) {
                        try {
                            if (window.Android && typeof window.Android.clearCredentials === 'function')
                                window.Android.clearCredentials();
                            else if (window.webkit && window.webkit.messageHandlers
                                && window.webkit.messageHandlers.clearCredentials)
                                window.webkit.messageHandlers.clearCredentials.postMessage(null);
                        } catch (e) {}
                    }
                });
            }

            form.addEventListener('submit', function () {
                try {
                    if (!hasBridge || !prefOn()) return;   // NV không chọn -> KHÔNG lưu gì cả
                    var empcd = document.getElementById('EMPCD')?.value || '';
                    var pwd   = document.getElementById('passwordInput')?.value || '';
                    if (!empcd || !pwd) return;
                    if (window.webkit && window.webkit.messageHandlers && window.webkit.messageHandlers.saveCredentials) {
                        window.webkit.messageHandlers.saveCredentials.postMessage({ empcd: empcd, password: pwd });
                    } else if (window.Android && typeof window.Android.saveCredentials === 'function') {
                        window.Android.saveCredentials(empcd, pwd);
                    }
                } catch (e) {}
            });
        })();
    </script>
</body>
</html>
