@{
    ViewData["Title"] = "Câu trả lời mẫu";
}

@section Styles {
<style>
    .cr-page { max-width: 1100px; margin: 0 auto; padding-bottom: 3rem; }

    .cr-btn-new {
        background: white; color: #dc2626; border: none; border-radius: 10px;
        padding: .5rem .9rem; font-weight: 800; font-size: .85rem; cursor: pointer;
        display: inline-flex; align-items: center; gap: .25rem;
        transition: all .15s; box-shadow: 0 1px 4px rgba(0,0,0,.1);
    }
    .cr-btn-new:hover { background: #fef2f2; transform: translateY(-1px); }

    .cr-table-wrap { background: white; border-radius: 14px; box-shadow: 0 1px 4px rgba(0,0,0,.06);
                     overflow: hidden; }
    .cr-table { width: 100%; border-collapse: collapse; }
    .cr-table th { padding: .7rem 1rem; font-size: .72rem; font-weight: 800; color: #64748b;
                   text-transform: uppercase; letter-spacing: .04em; background: #f8fafc;
                   border-bottom: 1px solid #f1f5f9; white-space: nowrap; text-align: left; }
    .cr-table th.center { text-align: center; }
    .cr-table td { padding: .7rem 1rem; border-bottom: 1px solid #f8fafc;
                   font-size: .85rem; vertical-align: middle; }
    .cr-table tr:last-child td { border-bottom: none; }
    .cr-table tr:hover td { background: #fef2f2; }
    .cr-table tr.is-hidden td { background: #fafafa; color: #94a3b8; }

    .cr-title  { font-weight: 700; color: #1e293b; }
    .cr-preview { font-size: .78rem; color: #94a3b8; margin-top: 2px; max-width: 420px;
                  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    .pill-active { font-size: .68rem; font-weight: 800; padding: 2px 9px; border-radius: 20px;
                   background: #dcfce7; color: #166534; text-transform: uppercase; }
    .pill-hidden { font-size: .68rem; font-weight: 800; padding: 2px 9px; border-radius: 20px;
                   background: #f1f5f9; color: #64748b; text-transform: uppercase; }

    .cr-actions { display: flex; gap: .35rem; justify-content: flex-end; }
    .cr-act-btn { background: white; border: 1px solid #e2e8f0; color: #475569; border-radius: 8px;
                  padding: .3rem .55rem; font-size: .72rem; font-weight: 700; cursor: pointer;
                  display: inline-flex; align-items: center; gap: .2rem; transition: all .12s; }
    .cr-act-btn:hover { background: #f8fafc; }
    .cr-act-btn.edit:hover   { background: #fef9c3; border-color: #facc15; color: #a16207; }
    .cr-act-btn.toggle:hover { background: #dbeafe; border-color: #60a5fa; color: #1d4ed8; }
    .cr-act-btn.delete:hover { background: #fee2e2; border-color: #f87171; color: #b91c1c; }
    .cr-act-btn .mat { font-size: .9rem; }

    .cr-empty   { padding: 3rem 1rem; text-align: center; color: #94a3b8; }
    .cr-loading { padding: 3rem 1rem; text-align: center; color: #94a3b8; }

    /* Modal */
    .cr-modal-back { position: fixed; inset: 0; background: rgba(15,23,42,.45);
        z-index: 1050; display: none; align-items: center; justify-content: center; padding: 1rem; }
    .cr-modal-back.show { display: flex; }
    .cr-modal { background: white; border-radius: 16px; max-width: 620px; width: 100%;
        box-shadow: 0 12px 40px rgba(0,0,0,.18); overflow: hidden; }
    .cr-modal-hd { padding: 1rem 1.25rem; background: linear-gradient(135deg, #7f1d1d, #dc2626);
        color: white; display: flex; align-items: center; justify-content: space-between; }
    .cr-modal-hd h5 { margin: 0; font-size: 1rem; font-weight: 800; color: white; }
    .cr-modal-close { background: transparent; border: none; color: white; cursor: pointer;
        font-size: 1.25rem; padding: 0; line-height: 1; }
    .cr-modal-bd { padding: 1.1rem 1.25rem; }
    .cr-modal-ft { padding: .75rem 1.25rem; background: #f8fafc; display: flex;
        justify-content: flex-end; gap: .5rem; border-top: 1px solid #f1f5f9; }
    .cr-form-row { margin-bottom: .75rem; }
    .cr-form-row label { display: block; font-size: .75rem; font-weight: 700;
        color: #475569; margin-bottom: .25rem; text-transform: uppercase; letter-spacing: .03em; }
    .cr-form-row input[type=text], .cr-form-row input[type=number] {
        width: 100%; border: 1.5px solid #e2e8f0; border-radius: 10px;
        padding: .45rem .65rem; font-size: .9rem; outline: none; }
    .cr-form-row input:focus { border-color: #dc2626; }
    .cr-form-row .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem; }
    .cr-checkbox { display: inline-flex; align-items: center; gap: .35rem; font-size: .85rem; }
    .cr-btn { border: none; border-radius: 10px; padding: .5rem .9rem;
        font-weight: 700; font-size: .85rem; cursor: pointer; transition: all .12s; }
    .cr-btn-primary   { background: #dc2626; color: white; }
    .cr-btn-primary:hover   { background: #b91c1c; }
    .cr-btn-secondary { background: #f1f5f9; color: #475569; }
    .cr-btn-secondary:hover { background: #e2e8f0; }
    .cr-btn:disabled { opacity: .55; cursor: not-allowed; }

    /* Editor tối giản cho nội dung mẫu — contenteditable + execCommand, khỏi load Tiptap riêng */
    .cr-editor-toolbar { display: flex; gap: 2px; padding: 4px; border: 1.5px solid #e2e8f0;
        border-bottom: none; border-radius: 10px 10px 0 0; background: #f8fafc; }
    .cr-ed-btn { background: white; border: 1px solid #e2e8f0; border-radius: 6px;
        width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;
        cursor: pointer; font-size: .85rem; color: #475569; }
    .cr-ed-btn:hover { background: #f1f5f9; }
    #crContentEditor { min-height: 140px; max-height: 320px; overflow-y: auto;
        border: 1.5px solid #e2e8f0; border-radius: 0 0 10px 10px; padding: .6rem .75rem;
        font-size: .9rem; outline: none; }
    #crContentEditor:focus { border-color: #dc2626; }
</style>
}

<div class="cr-page px-2 py-2">

    @await Html.PartialAsync("_AdminHeroBar", new AdminHeroBarVM
    {
        Icon = "forum",
        Title = "Câu trả lời mẫu",
        SubtitleHtml = "Kho mẫu dùng chung cho Admin/HR/CSR khi trả lời nhân viên trong chat.",
        ActionHtml = "<button class=\"cr-btn-new\" onclick=\"openCreate()\"><span class=\"material-symbols-rounded\" style=\"font-size:1.1rem;vertical-align:middle\">add</span> Thêm mẫu</button>"
    })

    <div class="cr-table-wrap">
        <table class="cr-table">
            <thead>
                <tr>
                    <th>Tiêu đề</th>
                    <th class="center">Thứ tự</th>
                    <th class="center">Trạng thái</th>
                    <th class="center">Thao tác</th>
                </tr>
            </thead>
            <tbody id="crBody">
                <tr><td colspan="4"><div class="cr-loading">Đang tải...</div></td></tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Edit / Create -->
<div class="cr-modal-back" id="crModal" onclick="if(event.target===this)closeModal()">
    <div class="cr-modal">
        <div class="cr-modal-hd">
            <h5 id="crModalTitle">Thêm mẫu</h5>
            <button class="cr-modal-close" onclick="closeModal()">&times;</button>
        </div>
        <div class="cr-modal-bd">
            <div class="cr-form-row">
                <label>Tiêu đề <span style="color:#dc2626">*</span></label>
                <input type="text" id="fldTitle" maxlength="200" placeholder="VD: Hướng dẫn xin nghỉ phép">
            </div>
            <div class="cr-form-row">
                <label>Nội dung <span style="color:#dc2626">*</span></label>
                <div class="cr-editor-toolbar">
                    <button type="button" class="cr-ed-btn" title="Đậm" onmousedown="event.preventDefault()" onclick="document.execCommand('bold')"><strong>B</strong></button>
                    <button type="button" class="cr-ed-btn" title="Nghiêng" onmousedown="event.preventDefault()" onclick="document.execCommand('italic')"><em>I</em></button>
                    <button type="button" class="cr-ed-btn" title="Gạch chân" onmousedown="event.preventDefault()" onclick="document.execCommand('underline')"><u>U</u></button>
                    <button type="button" class="cr-ed-btn" title="Danh sách" onmousedown="event.preventDefault()" onclick="document.execCommand('insertUnorderedList')"><span class="material-symbols-rounded" style="font-size:1rem">format_list_bulleted</span></button>
                    <button type="button" class="cr-ed-btn" title="Chèn ảnh" onmousedown="event.preventDefault()" onclick="document.getElementById('crImageFile').click()"><span class="material-symbols-rounded" style="font-size:1rem">image</span></button>
                    <button type="button" class="cr-ed-btn" title="Xóa định dạng" onmousedown="event.preventDefault()" onclick="document.execCommand('removeFormat')"><span class="material-symbols-rounded" style="font-size:1rem">format_clear</span></button>
                    <input type="file" id="crImageFile" accept="image/jpeg,image/png,image/webp,image/gif" style="display:none" onchange="insertCannedImage()">
                </div>
                <div id="crContentEditor" contenteditable="true"></div>
            </div>
            <div class="cr-form-row">
                <div class="row2">
                    <div>
                        <label>Thứ tự sắp xếp</label>
                        <input type="number" id="fldSort" min="0" max="999" value="0">
                    </div>
                    <div>
                        <label>Trạng thái</label>
                        <div style="padding-top:.4rem">
                            <label class="cr-checkbox">
                                <input type="checkbox" id="fldActive" checked>
                                <span>Hiển thị (Active)</span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="cr-modal-ft">
            <button class="cr-btn cr-btn-secondary" onclick="closeModal()">Hủy</button>
            <button class="cr-btn cr-btn-primary" id="btnSave" onclick="saveCanned()">
                <span class="material-symbols-rounded" style="font-size:.95rem;vertical-align:middle">save</span>
                Lưu
            </button>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
<script>
// Không chỉ định controller — view này dùng chung cho cả AdminInquiry (Admin) và HrInquiry
// (HR/CSR, yêu cầu 2026-09-14), Url.Action không tham số controller tự trỏ về đúng controller
// đang xử lý request hiện tại.
const URL_LIST   = '@Url.Action("GetAdminCannedReplies")';
const URL_SAVE   = '@Url.Action("SaveCannedReply")';
const URL_DELETE = '@Url.Action("DeleteCannedReply")';
const URL_UPLOAD_IMG = '@Url.Action("UploadCannedReplyImage", "Image")';
const TOKEN      = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

let cannedReplies = [];
let editingId = null;   // null = create, otherwise Id being edited

function esc(s) { return (s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function stripHtml(html) { const d = document.createElement('div'); d.innerHTML = html || ''; return d.textContent || ''; }

async function loadCannedReplies() {
    document.getElementById('crBody').innerHTML =
        '<tr><td colspan="4"><div class="cr-loading"><div class="spinner-border text-danger" role="status"></div><div style="margin-top:.5rem">Đang tải...</div></div></td></tr>';
    try {
        const res  = await fetch(URL_LIST);
        const data = await res.json();
        if (!data.success) {
            document.getElementById('crBody').innerHTML =
                `<tr><td colspan="4"><div class="cr-empty">Lỗi: ${esc(data.message||'Không tải được')}</div></td></tr>`;
            return;
        }
        cannedReplies = data.data || [];
        renderTable();
    } catch (e) {
        document.getElementById('crBody').innerHTML =
            `<tr><td colspan="4"><div class="cr-empty">Lỗi kết nối: ${esc(e.message)}</div></td></tr>`;
    }
}

function renderTable() {
    if (!cannedReplies.length) {
        document.getElementById('crBody').innerHTML =
            '<tr><td colspan="4"><div class="cr-empty">Chưa có mẫu trả lời nào</div></td></tr>';
        return;
    }
    const rows = cannedReplies.map(c => {
        const cls    = c.isActive ? '' : 'is-hidden';
        const status = c.isActive ? '<span class="pill-active">Hiển thị</span>' : '<span class="pill-hidden">Đã ẩn</span>';
        const toggleLabel = c.isActive ? 'Ẩn' : 'Hiện';
        const toggleIcon  = c.isActive ? 'visibility_off' : 'visibility';
        return `
        <tr class="${cls}">
            <td>
                <div class="cr-title">${esc(c.title)}</div>
                <div class="cr-preview">${esc(stripHtml(c.content))}</div>
            </td>
            <td class="center">${c.displayOrder}</td>
            <td class="center">${status}</td>
            <td class="center">
                <div class="cr-actions">
                    <button class="cr-act-btn edit" onclick="openEdit(${c.id})" title="Sửa">
                        <span class="material-symbols-rounded mat">edit</span>
                    </button>
                    <button class="cr-act-btn toggle" onclick="toggleActive(${c.id}, ${!c.isActive})" title="${toggleLabel}">
                        <span class="material-symbols-rounded mat">${toggleIcon}</span>
                    </button>
                    <button class="cr-act-btn delete" onclick="deleteCanned(${c.id})" title="Xóa">
                        <span class="material-symbols-rounded mat">delete</span>
                    </button>
                </div>
            </td>
        </tr>`;
    }).join('');
    document.getElementById('crBody').innerHTML = rows;
}

function openCreate() {
    editingId = null;
    document.getElementById('crModalTitle').textContent = 'Thêm mẫu';
    document.getElementById('fldTitle').value = '';
    document.getElementById('crContentEditor').innerHTML = '';
    document.getElementById('fldSort').value = (cannedReplies.length ? Math.max(...cannedReplies.map(x=>x.displayOrder||0)) + 1 : 0);
    document.getElementById('fldActive').checked = true;
    document.getElementById('crModal').classList.add('show');
}

function openEdit(id) {
    const c = cannedReplies.find(x => x.id === id);
    if (!c) return;
    editingId = id;
    document.getElementById('crModalTitle').textContent = 'Sửa mẫu';
    document.getElementById('fldTitle').value = c.title || '';
    document.getElementById('crContentEditor').innerHTML = c.content || '';
    document.getElementById('fldSort').value = c.displayOrder || 0;
    document.getElementById('fldActive').checked = !!c.isActive;
    document.getElementById('crModal').classList.add('show');
}

function closeModal() {
    document.getElementById('crModal').classList.remove('show');
}

// ── Chèn ảnh vào nội dung — lưu file chung thư mục ảnh Bulletin (BULLETIN\IMG),
// không tạo thư mục riêng vì canned reply ít ảnh. Phải nhớ vị trí con trỏ trước khi mở
// hộp thoại chọn file, vì click ra ngoài contenteditable làm mất selection.
let crSavedRange = null;
document.getElementById('crContentEditor').addEventListener('mouseup', saveCrSelection);
document.getElementById('crContentEditor').addEventListener('keyup', saveCrSelection);
function saveCrSelection() {
    const sel = window.getSelection();
    if (sel.rangeCount > 0 && document.getElementById('crContentEditor').contains(sel.anchorNode)) {
        crSavedRange = sel.getRangeAt(0).cloneRange();
    }
}

async function insertCannedImage() {
    const input = document.getElementById('crImageFile');
    const file = input.files[0];
    if (!file) return;
    if (file.size > 10 * 1024 * 1024) { showToast('Ảnh vượt quá 10MB', 'error'); input.value = ''; return; }

    try {
        const fd = new FormData();
        fd.append('file', file);
        const res = await fetch(URL_UPLOAD_IMG, { method: 'POST', body: fd });
        const data = await res.json();
        if (!data.success) { showToast(data.message || 'Lỗi upload ảnh', 'error'); return; }

        const editor = document.getElementById('crContentEditor');
        editor.focus();
        const sel = window.getSelection();
        sel.removeAllRanges();
        if (crSavedRange) sel.addRange(crSavedRange);
        document.execCommand('insertHTML', false, `<img src="${data.url}" style="max-width:100%;border-radius:8px;margin:4px 0;">`);
    } catch (e) {
        showToast('Lỗi upload ảnh: ' + e.message, 'error');
    } finally {
        input.value = '';
    }
}

async function saveCanned() {
    const title   = document.getElementById('fldTitle').value.trim();
    const content = document.getElementById('crContentEditor').innerHTML.trim();
    const displayOrder = parseInt(document.getElementById('fldSort').value, 10) || 0;
    const isActive = document.getElementById('fldActive').checked;

    if (!title)   { showToast('Vui lòng nhập tiêu đề', 'error'); return; }
    if (!content || !stripHtml(content).trim()) { showToast('Vui lòng nhập nội dung', 'error'); return; }

    const btn = document.getElementById('btnSave');
    btn.disabled = true;
    try {
        const payload = { id: editingId, title, content, displayOrder, isActive };
        const res = await fetch(URL_SAVE, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN },
            body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (!data.success) { showToast(data.message || 'Lưu thất bại', 'error'); return; }
        showToast(editingId ? 'Đã cập nhật mẫu' : 'Đã thêm mẫu', 'success');
        closeModal();
        await loadCannedReplies();
    } catch (e) {
        showToast('Lỗi: ' + e.message, 'error');
    } finally {
        btn.disabled = false;
    }
}

async function toggleActive(id, makeActive) {
    const c = cannedReplies.find(x => x.id === id);
    if (!c) return;
    try {
        const payload = { id, title: c.title, content: c.content, displayOrder: c.displayOrder, isActive: makeActive };
        const res = await fetch(URL_SAVE, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN },
            body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (!data.success) { showToast(data.message || 'Thất bại', 'error'); return; }
        showToast(makeActive ? 'Đã hiển thị mẫu' : 'Đã ẩn mẫu', 'success');
        await loadCannedReplies();
    } catch (e) { showToast('Lỗi: ' + e.message, 'error'); }
}

async function deleteCanned(id) {
    if (!confirm('Xóa mẫu trả lời này?')) return;
    try {
        const res = await fetch(URL_DELETE, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN },
            body: JSON.stringify({ id })
        });
        const data = await res.json();
        if (!data.success) { showToast(data.message || 'Không thể xóa', 'error'); return; }
        showToast('Đã xóa mẫu', 'success');
        await loadCannedReplies();
    } catch (e) { showToast('Lỗi: ' + e.message, 'error'); }
}

loadCannedReplies();
</script>
}
