@{
    ViewData["Title"] = "Báo cáo hội thoại";
}

<style>
.inqhr-page { max-width: 1100px; margin: 0 auto; padding-bottom: 3rem; }

/* Hero */
.inqhr-hero {
    background: linear-gradient(135deg, #7f1d1d 0%, #991b1b 50%, #dc2626 100%);
    border-radius: 18px; padding: 1rem 1.25rem; margin-bottom: .75rem;
    color: #fff; display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    flex-wrap: wrap;
}
.inqhr-hero h5    { font-size: 1.05rem; font-weight: 800; margin: 0 0 .15rem; color: #fff !important; }
.inqhr-hero small { font-size: .75rem; opacity: .85; }

.rpt-export-btn {
    background: rgba(255,255,255,.18); border: 1px solid rgba(255,255,255,.35);
    color: #fff; border-radius: 10px; padding: .45rem .75rem;
    font-size: .8rem; font-weight: 700; cursor: pointer;
    display: inline-flex; align-items: center; gap: .25rem;
}
.rpt-export-btn:hover { background: rgba(255,255,255,.28); }
.rpt-export-btn:disabled { opacity: .5; cursor: not-allowed; }

/* Filter */
.rpt-ctrl { background: white; border-radius: 14px; padding: .75rem 1rem;
            box-shadow: 0 1px 4px rgba(0,0,0,.06); margin-bottom: .6rem;
            display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; }
.rpt-date-input { border: 1.5px solid #e2e8f0; border-radius: 10px; padding: .4rem .65rem;
                  font-size: .85rem; font-weight: 700; color: #475569; outline: none; }
.rpt-date-input:focus { border-color: #dc2626; }
.rpt-arrow { color: #94a3b8; font-weight: 800; }
.rpt-quick { display: flex; gap: .3rem; flex-wrap: wrap; }
.rpt-quick-btn {
    background: #f1f5f9; border: none; border-radius: 8px; padding: .35rem .65rem;
    font-size: .75rem; font-weight: 700; color: #475569; cursor: pointer;
}
.rpt-quick-btn:hover  { background: #fee2e2; color: #dc2626; }
.rpt-apply {
    background: #dc2626; border: none; color: white; border-radius: 10px;
    padding: .4rem .9rem; font-size: .82rem; font-weight: 700; cursor: pointer;
    display: inline-flex; align-items: center; gap: .25rem;
}
.rpt-apply:hover { background: #b91c1c; }

/* Summary cards */
.rpt-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: .5rem; margin-bottom: .6rem; }
.rpt-card  { background: white; border-radius: 14px; padding: .9rem 1rem; text-align: center;
             box-shadow: 0 1px 4px rgba(0,0,0,.06); }
.rpt-card-val { font-size: 1.7rem; font-weight: 800; color: #1e293b; line-height: 1.1; }
.rpt-card-val.green  { color: #16a34a; }
.rpt-card-val.gray   { color: #64748b; }
.rpt-card-val.red    { color: #dc2626; }
.rpt-card-val.amber  { color: #d97706; }
.rpt-card-lbl { font-size: .7rem; font-weight: 700; color: #94a3b8;
                text-transform: uppercase; letter-spacing: .04em; margin-top: .2rem; }

/* Highlight cards (top/bottom rated) */
.rpt-highlights { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem; margin-bottom: .6rem; }
.rpt-hl {
    background: white; border-radius: 14px; padding: .9rem 1rem;
    box-shadow: 0 1px 4px rgba(0,0,0,.06); display: flex; align-items: center; gap: .75rem;
    position: relative; overflow: hidden;
}
.rpt-hl.top    { border-left: 4px solid #16a34a; }
.rpt-hl.bottom { border-left: 4px solid #dc2626; }
.rpt-hl-icon {
    width: 44px; height: 44px; border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.4rem; flex-shrink: 0;
}
.rpt-hl-icon.top    { background: #dcfce7; color: #16a34a; }
.rpt-hl-icon.bottom { background: #fee2e2; color: #dc2626; }
.rpt-hl-body  { flex: 1; min-width: 0; }
.rpt-hl-label { font-size: .68rem; font-weight: 800; color: #94a3b8;
                text-transform: uppercase; letter-spacing: .04em; }
.rpt-hl-name  { font-size: .95rem; font-weight: 800; color: #1e293b; margin: 2px 0;
                white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rpt-hl-meta  { font-size: .72rem; color: #94a3b8; }
.rpt-hl-rating{ font-size: 1.1rem; font-weight: 800; }
.rpt-hl-rating.top    { color: #d97706; }
.rpt-hl-rating.bottom { color: #b91c1c; }

/* Closed-by */
.rpt-closed-by { background: white; border-radius: 14px; padding: .75rem 1rem;
                 box-shadow: 0 1px 4px rgba(0,0,0,.06); margin-bottom: .6rem;
                 display: flex; gap: 1rem; flex-wrap: wrap; }
.rpt-cb-item   { flex: 1; min-width: 80px; text-align: center; }
.rpt-cb-val    { font-size: 1.2rem; font-weight: 800; color: #1e293b; }
.rpt-cb-lbl    { font-size: .7rem; color: #94a3b8; font-weight: 700; text-transform: uppercase; }

/* Charts */
.rpt-charts { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem; margin-bottom: .6rem; }
.rpt-chart-card { background: white; border-radius: 14px; padding: 1rem;
                  box-shadow: 0 1px 4px rgba(0,0,0,.06); }
.rpt-chart-title { font-size: .78rem; font-weight: 800; color: #475569;
                   text-transform: uppercase; letter-spacing: .04em; margin-bottom: .5rem; }
.rpt-chart-box { position: relative; height: 280px; }

/* Section + Tables */
.rpt-section-title { font-size: .78rem; font-weight: 800; color: #64748b;
                     text-transform: uppercase; letter-spacing: .05em;
                     margin: .6rem 0 .35rem; padding-left: .25rem; }
.rpt-table-wrap { background: white; border-radius: 14px; box-shadow: 0 1px 4px rgba(0,0,0,.06);
                  overflow: hidden; margin-bottom: .75rem; }
.rpt-table { width: 100%; border-collapse: collapse; }
.rpt-table th { padding: .6rem 1rem; font-size: .72rem; font-weight: 800; color: #64748b;
                text-transform: uppercase; letter-spacing: .04em; background: #f8fafc;
                border-bottom: 1px solid #f1f5f9; white-space: nowrap; text-align: left; }
.rpt-table th.num { text-align: right; }
.rpt-table td { padding: .65rem 1rem; border-bottom: 1px solid #f8fafc;
                font-size: .85rem; vertical-align: middle; }
.rpt-table td.num { text-align: right; font-weight: 700; }
.rpt-table tr:last-child td { border-bottom: none; }
.rpt-table tr:hover td { background: #fef2f2; }

.topic-dot  { display: inline-block; width: 10px; height: 10px; border-radius: 50%;
              margin-right: 6px; vertical-align: middle; }
.star-val   { color: #d97706; font-weight: 800; }

.rpt-empty   { text-align: center; padding: 2rem; color: #94a3b8; font-size: .85rem; }
.rpt-loading { text-align: center; padding: 2.5rem; color: #94a3b8; }
.rpt-err     { background: #fef2f2; border-radius: 10px; padding: .75rem 1rem;
               color: #dc2626; font-size: .85rem; font-weight: 700; margin-bottom: .6rem; }

@@media (max-width: 768px) {
    .rpt-cards      { grid-template-columns: repeat(2, 1fr); }
    .rpt-highlights { grid-template-columns: 1fr; }
    .rpt-charts     { grid-template-columns: 1fr; }
}
</style>

<div class="inqhr-page px-2 py-2">

    <div class="inqhr-hero">
        <div>
            <h5>
                <span class="material-symbols-rounded" style="font-size:1.1rem;vertical-align:middle">bar_chart</span>
                Báo cáo hội thoại
            </h5>
            <small id="heroPeriod">Đang tải...</small>
        </div>
        <button class="rpt-export-btn" id="btnExport" onclick="exportExcel()" title="Xuất Excel">
            <span class="material-symbols-rounded" style="font-size:1.1rem;vertical-align:middle">download</span>
            Excel
        </button>
    </div>

    <!-- Filter -->
    <div class="rpt-ctrl">
        <label style="font-size:.78rem;font-weight:700;color:#475569">Từ</label>
        <input type="date" id="fldFrom" class="rpt-date-input">
        <span class="rpt-arrow">→</span>
        <label style="font-size:.78rem;font-weight:700;color:#475569">Đến</label>
        <input type="date" id="fldTo"   class="rpt-date-input">
        <button class="rpt-apply" onclick="onApply()">
            <span class="material-symbols-rounded" style="font-size:1rem">search</span>
            Áp dụng
        </button>
        <div class="rpt-quick" style="margin-left:auto">
            <button class="rpt-quick-btn" onclick="quickRange('week')">Tuần này</button>
            <button class="rpt-quick-btn" onclick="quickRange('lastweek')">Tuần trước</button>
            <button class="rpt-quick-btn" onclick="quickRange('month')">Tháng này</button>
            <button class="rpt-quick-btn" onclick="quickRange('lastmonth')">Tháng trước</button>
        </div>
    </div>

    <div id="rptContent">
        <div class="rpt-loading">
            <span class="material-symbols-rounded" style="font-size:2rem;color:#dc2626">hourglass_top</span>
            <div style="margin-top:.5rem">Đang tải...</div>
        </div>
    </div>

</div>

<!-- Chart.js (CDN) -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

<script>
const URL_REPORT = '@Url.Action("GetReport","AdminInquiry")';
const URL_EXPORT = '@Url.Action("ExportReport","AdminInquiry")';

let chartTopic = null;
let chartHr    = null;

function fmtDateISO(d) {
    const y = d.getFullYear(), m = String(d.getMonth()+1).padStart(2,'0'), dd = String(d.getDate()).padStart(2,'0');
    return `${y}-${m}-${dd}`;
}
function startOfWeek(d) {
    const x = new Date(d); const dow = x.getDay(); const diff = dow === 0 ? -6 : 1 - dow;
    x.setDate(x.getDate() + diff); x.setHours(0,0,0,0); return x;
}
function endOfWeek(d) { const s = startOfWeek(d); const e = new Date(s); e.setDate(e.getDate() + 6); return e; }
function startOfMonth(d) { return new Date(d.getFullYear(), d.getMonth(), 1); }
function endOfMonth(d)   { return new Date(d.getFullYear(), d.getMonth()+1, 0); }
function fmtMinutes(min) {
    if (min == null) return '—';
    min = Math.round(min); const h = Math.floor(min/60), m = min % 60;
    return h > 0 ? `${h}g ${m}p` : `${m}p`;
}
function fmtRating(r) { if (r == null) return '—'; return `<span class="star-val">&#9733; ${Number(r).toFixed(1)}</span>`; }
function pct(part, total) { if (!total) return 0; return Math.round(part / total * 100); }
function esc(s) { return (s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

// Quick ranges
function quickRange(kind) {
    const now = new Date();
    let s, e;
    if (kind === 'week')      { s = startOfWeek(now); e = endOfWeek(now); }
    else if (kind === 'lastweek') {
        const last = new Date(now); last.setDate(last.getDate() - 7);
        s = startOfWeek(last); e = endOfWeek(last);
    }
    else if (kind === 'month')     { s = startOfMonth(now); e = endOfMonth(now); }
    else if (kind === 'lastmonth') {
        const last = new Date(now.getFullYear(), now.getMonth()-1, 15);
        s = startOfMonth(last); e = endOfMonth(last);
    }
    document.getElementById('fldFrom').value = fmtDateISO(s);
    document.getElementById('fldTo').value   = fmtDateISO(e);
    loadReport();
}

function onApply() { loadReport(); }

function exportExcel() {
    const f = document.getElementById('fldFrom').value;
    const t = document.getElementById('fldTo').value;
    window.location.href = `${URL_EXPORT}?from=${encodeURIComponent(f)}&to=${encodeURIComponent(t)}`;
}

// Init = current week
(function initRange() {
    const now = new Date();
    document.getElementById('fldFrom').value = fmtDateISO(startOfWeek(now));
    document.getElementById('fldTo').value   = fmtDateISO(endOfWeek(now));
})();
loadReport();

async function loadReport() {
    const f = document.getElementById('fldFrom').value;
    const t = document.getElementById('fldTo').value;

    document.getElementById('rptContent').innerHTML =
        `<div class="rpt-loading">
            <span class="material-symbols-rounded" style="font-size:2rem;color:#dc2626">hourglass_top</span>
            <div style="margin-top:.5rem">Đang tải...</div>
         </div>`;

    try {
        const url  = `${URL_REPORT}?from=${encodeURIComponent(f)}&to=${encodeURIComponent(t)}`;
        const res  = await fetch(url);
        const data = await res.json();
        if (!data.success) {
            document.getElementById('rptContent').innerHTML =
                `<div class="rpt-err">Lỗi: ${esc(data.message ?? 'Không tải được dữ liệu')}</div>`;
            return;
        }
        renderReport(data);
    } catch (e) {
        document.getElementById('rptContent').innerHTML =
            `<div class="rpt-err">Lỗi kết nối: ${esc(e.message)}</div>`;
    }
}

function renderReport(data) {
    const s  = data.summary ?? {};
    const total = s.total ?? 0;
    document.getElementById('heroPeriod').textContent =
        `${data.from ?? '—'} → ${data.to ?? '—'}`;

    // Compute top/bottom rated HR (only those with rating)
    const rated = (data.byHr ?? []).filter(h => h.avgRating != null);
    rated.sort((a,b) => b.avgRating - a.avgRating);
    const topRated    = rated.length > 0 ? rated[0]                 : null;
    const bottomRated = rated.length > 1 ? rated[rated.length - 1]  : null;

    let html = '';

    // ─── Summary cards
    html += `<div class="rpt-cards">
        <div class="rpt-card"><div class="rpt-card-val">${total}</div><div class="rpt-card-lbl">Tổng hội thoại</div></div>
        <div class="rpt-card"><div class="rpt-card-val green">${s.cntOpen ?? 0}</div><div class="rpt-card-lbl">Đang mở</div></div>
        <div class="rpt-card"><div class="rpt-card-val gray">${s.cntClosed ?? 0}</div><div class="rpt-card-lbl">Đã đóng</div></div>
        <div class="rpt-card"><div class="rpt-card-val" style="color:#6366f1">${s.cntAnon ?? 0}</div><div class="rpt-card-lbl">Ẩn danh</div></div>
        <div class="rpt-card"><div class="rpt-card-val amber">${s.avgRating != null ? '&#9733; ' + Number(s.avgRating).toFixed(1) : '—'}</div><div class="rpt-card-lbl">Đánh giá TB</div></div>
        <div class="rpt-card"><div class="rpt-card-val" style="color:#0ea5e9">${fmtMinutes(s.avgHandleMin)}</div><div class="rpt-card-lbl">TG xử lý TB</div></div>
    </div>`;

    // ─── Top/bottom rated highlights
    html += `<div class="rpt-highlights">`;
    if (topRated) {
        html += `<div class="rpt-hl top">
            <div class="rpt-hl-icon top"><span class="material-symbols-rounded">emoji_events</span></div>
            <div class="rpt-hl-body">
                <div class="rpt-hl-label">Đánh giá cao nhất</div>
                <div class="rpt-hl-name vni-font">${esc(topRated.hrName ?? '—')}</div>
                <div class="rpt-hl-meta">${esc(topRated.hrCd ?? '')} · ${topRated.handled ?? 0} hội thoại</div>
            </div>
            <div class="rpt-hl-rating top">&#9733; ${Number(topRated.avgRating).toFixed(1)}</div>
        </div>`;
    } else {
        html += `<div class="rpt-hl top"><div class="rpt-hl-body"><div class="rpt-hl-label">Đánh giá cao nhất</div><div class="rpt-hl-meta">Chưa có dữ liệu</div></div></div>`;
    }
    if (bottomRated && bottomRated.hrCd !== topRated?.hrCd) {
        html += `<div class="rpt-hl bottom">
            <div class="rpt-hl-icon bottom"><span class="material-symbols-rounded">trending_down</span></div>
            <div class="rpt-hl-body">
                <div class="rpt-hl-label">Đánh giá thấp nhất</div>
                <div class="rpt-hl-name vni-font">${esc(bottomRated.hrName ?? '—')}</div>
                <div class="rpt-hl-meta">${esc(bottomRated.hrCd ?? '')} · ${bottomRated.handled ?? 0} hội thoại</div>
            </div>
            <div class="rpt-hl-rating bottom">&#9733; ${Number(bottomRated.avgRating).toFixed(1)}</div>
        </div>`;
    } else {
        html += `<div class="rpt-hl bottom"><div class="rpt-hl-body"><div class="rpt-hl-label">Đánh giá thấp nhất</div><div class="rpt-hl-meta">Chưa đủ dữ liệu (cần ≥ 2 HR có đánh giá)</div></div></div>`;
    }
    html += `</div>`;

    // ─── Closed-by
    const tc = (s.closedByHr ?? 0) + (s.closedByEmp ?? 0) + (s.closedByAdmin ?? 0);
    if (tc > 0) {
        html += `<div class="rpt-closed-by">
            <div class="rpt-cb-item"><div class="rpt-cb-val" style="color:#dc2626">${s.closedByHr ?? 0} <span style="font-size:.75rem;color:#94a3b8">(${pct(s.closedByHr??0, tc)}%)</span></div><div class="rpt-cb-lbl">HR đóng</div></div>
            <div class="rpt-cb-item"><div class="rpt-cb-val" style="color:#16a34a">${s.closedByEmp ?? 0} <span style="font-size:.75rem;color:#94a3b8">(${pct(s.closedByEmp??0, tc)}%)</span></div><div class="rpt-cb-lbl">NV tự đóng</div></div>
            <div class="rpt-cb-item"><div class="rpt-cb-val" style="color:#7c3aed">${s.closedByAdmin ?? 0} <span style="font-size:.75rem;color:#94a3b8">(${pct(s.closedByAdmin??0, tc)}%)</span></div><div class="rpt-cb-lbl">Admin đóng</div></div>
            <div class="rpt-cb-item"><div class="rpt-cb-val gray" style="font-size:1rem">${s.avgMsg != null ? Number(s.avgMsg).toFixed(1) : '—'}</div><div class="rpt-cb-lbl">Tin TB/HT</div></div>
        </div>`;
    }

    // ─── Charts (placeholder canvases)
    html += `<div class="rpt-charts">
        <div class="rpt-chart-card">
            <div class="rpt-chart-title"><span class="material-symbols-rounded" style="font-size:.9rem;vertical-align:middle">pie_chart</span> Tỉ lệ theo chủ đề</div>
            <div class="rpt-chart-box"><canvas id="chartTopic"></canvas></div>
        </div>
        <div class="rpt-chart-card">
            <div class="rpt-chart-title"><span class="material-symbols-rounded" style="font-size:.9rem;vertical-align:middle">bar_chart</span> Hội thoại đã xử lý / HR</div>
            <div class="rpt-chart-box"><canvas id="chartHr"></canvas></div>
        </div>
    </div>`;

    // ─── Topic table
    html += `<div class="rpt-section-title"><span class="material-symbols-rounded" style="font-size:.85rem;vertical-align:middle">topic</span> Chi tiết theo chủ đề</div>`;
    if (!data.byTopic || data.byTopic.length === 0) {
        html += `<div class="rpt-table-wrap"><div class="rpt-empty">Không có dữ liệu</div></div>`;
    } else {
        html += `<div class="rpt-table-wrap"><table class="rpt-table">
            <thead><tr><th>Chủ đề</th><th class="num">Tổng</th><th class="num">Đang mở</th><th class="num">Đã đóng</th><th class="num">Đánh giá TB</th></tr></thead><tbody>`;
        for (const t of data.byTopic) {
            html += `<tr>
                <td><span class="topic-dot" style="background:${t.color ?? '#94a3b8'}"></span>${esc(t.topicName ?? t.topicCd)}</td>
                <td class="num">${t.total}</td>
                <td class="num" style="color:#16a34a">${t.cntOpen}</td>
                <td class="num" style="color:#64748b">${t.cntClosed}</td>
                <td class="num">${fmtRating(t.avgRating)}</td>
            </tr>`;
        }
        html += `</tbody></table></div>`;
    }

    // ─── HR table
    html += `<div class="rpt-section-title"><span class="material-symbols-rounded" style="font-size:.85rem;vertical-align:middle">manage_accounts</span> Chi tiết Workload HR</div>`;
    if (!data.byHr || data.byHr.length === 0) {
        html += `<div class="rpt-table-wrap"><div class="rpt-empty">Không có dữ liệu</div></div>`;
    } else {
        html += `<div class="rpt-table-wrap"><table class="rpt-table">
            <thead><tr><th>Nhân sự</th><th class="num">Tiếp nhận</th><th class="num">Đã đóng</th><th class="num">Đánh giá TB</th><th class="num">TG xử lý TB</th></tr></thead><tbody>`;
        for (const h of data.byHr) {
            html += `<tr>
                <td><span class="vni-font" style="font-weight:700;color:#1e293b">${esc(h.hrName ?? '—')}</span> ${h.hrCd ? `<span style="font-size:.72rem;color:#94a3b8;margin-left:4px">${esc(h.hrCd)}</span>` : ''}</td>
                <td class="num">${h.handled}</td>
                <td class="num" style="color:#64748b">${h.cntClosed}</td>
                <td class="num">${fmtRating(h.avgRating)}</td>
                <td class="num" style="color:#0ea5e9">${fmtMinutes(h.avgHandleMin)}</td>
            </tr>`;
        }
        html += `</tbody></table></div>`;
    }

    document.getElementById('rptContent').innerHTML = html;
    renderCharts(data);
}

function renderCharts(data) {
    // Destroy previous instances
    if (chartTopic) { chartTopic.destroy(); chartTopic = null; }
    if (chartHr)    { chartHr.destroy();    chartHr    = null; }

    // Pie: topic ratio
    const topics = (data.byTopic ?? []).filter(t => t.total > 0);
    const topicCtx = document.getElementById('chartTopic');
    if (topicCtx && topics.length > 0) {
        chartTopic = new Chart(topicCtx, {
            type: 'doughnut',
            data: {
                labels:   topics.map(t => t.topicName ?? t.topicCd),
                datasets: [{
                    data:            topics.map(t => t.total),
                    backgroundColor: topics.map(t => t.color ?? '#94a3b8'),
                    borderWidth:     2,
                    borderColor:     '#fff'
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', labels: { font: { size: 11 }, padding: 8, boxWidth: 12 } },
                    tooltip: {
                        callbacks: {
                            label: ctx => {
                                const t = ctx.dataset.data.reduce((a,b)=>a+b, 0);
                                const v = ctx.parsed;
                                const p = t > 0 ? Math.round(v/t*100) : 0;
                                return `${ctx.label}: ${v} (${p}%)`;
                            }
                        }
                    }
                }
            }
        });
    }

    // Bar: HR workload
    const hrs = (data.byHr ?? []);
    const hrCtx = document.getElementById('chartHr');
    if (hrCtx && hrs.length > 0) {
        chartHr = new Chart(hrCtx, {
            type: 'bar',
            data: {
                labels:   hrs.map(h => h.hrName ?? h.hrCd ?? '—'),
                datasets: [{
                    label:           'Tiếp nhận',
                    data:            hrs.map(h => h.handled),
                    backgroundColor: '#dc2626',
                    borderRadius:    6
                }, {
                    label:           'Đã đóng',
                    data:            hrs.map(h => h.cntClosed),
                    backgroundColor: '#16a34a',
                    borderRadius:    6
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false, indexAxis: 'y',
                plugins: { legend: { position: 'bottom', labels: { font: { size: 11 }, padding: 8, boxWidth: 12 } } },
                scales:  {
                    x: { beginAtZero: true, ticks: { precision: 0 } },
                    y: { ticks: { font: { size: 11 } } }
                }
            }
        });
    }
}
</script>
