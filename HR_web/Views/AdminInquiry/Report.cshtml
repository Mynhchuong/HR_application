        <div class="rpt-card"><div class="rpt-card-val green">${s.cntOpen ?? 0}</div><div class="rpt-card-lbl">Đang mở</div></div>
        <div class="rpt-card"><div class="rpt-card-val gray">${s.cntClosed ?? 0}</div><div class="rpt-card-lbl">Đã đóng</div></div>
        <div class="rpt-card"><div class="rpt-card-val" style="color:#0ea5e9">${s.avgMsg != null ? Number(s.avgMsg).toFixed(1) : '—'}</div><div class="rpt-card-lbl">Tin TB/đoạn</div></div>
        <div class="rpt-card"><div class="rpt-card-val amber">${s.failedCnt ?? 0}</div><div class="rpt-card-lbl">AI trả lời lỗi</div></div>
    </div>`;

    const hrs = ai.byHr ?? [];
    if (hrs.length === 0) {
        html += `<div class="rpt-table-wrap"><div class="rpt-empty">Chưa có CSR/HR nào trả lời AI chat trong khoảng thời gian này</div></div>`;
    } else {
        html += `<div class="rpt-table-wrap"><table class="rpt-table">
            <thead><tr><th>Nhân sự</th><th class="num">Số đoạn đã trả lời</th><th class="num">Tổng số tin đã gửi</th></tr></thead><tbody>`;
        for (const h of hrs) {
            html += `<tr>
                <td><span class="vni-font" style="font-weight:700;color:#1e293b">${esc(h.hrName || '—')}</span> ${h.hrCd ? `<span style="font-size:.72rem;color:#94a3b8;margin-left:4px">${esc(h.hrCd)}</span>` : ''}</td>
                <td class="num">${h.repliedChats}</td>
                <td class="num" style="color:#64748b">${h.repliedMsgs}</td>
            </tr>`;
        }
        html += `</tbody></table></div>`;
    }
    return html;
}

function renderPage(data, d, f, t) {
    const s = data.summary ?? {}, o = d.overview, r = d.resolve, fr = d.firstResponse, pop = d.population, cs = d.caseStats;
    document.getElementById('heroPeriod').textContent = `${d.from ?? data.from ?? '—'} → ${d.to ?? data.to ?? '—'}`;
    const total = s.total ?? 0, closed = s.cntClosed ?? 0;
    const repeatByTopic = {}; (d.repeat.topics ?? []).forEach(x => repeatByTopic[x.topicCd] = x);
    let html = '';

    // ─── Chỉ số chính (mỗi chỉ số 1 lần)
    html += `<div class="db-cards kpi">
        ${dashCard(dashN(total), 'Hội thoại', `${dashN(s.cntDirect)} công khai (${dashPct(s.cntDirect, total)}) · ${dashN(s.cntAnon)} ẩn danh (${dashPct(s.cntAnon, total)})`)}
        ${dashCard(dashN(s.cntOpen), 'Đang mở', `${dashN(cs.open)} mới · ${dashN(cs.inProgress)} đang xử lý`, '#d97706')}
        ${dashCard(dashN(closed), 'Đã đóng', dashPct(closed, total), '#16a34a')}
        ${dashCard(dashN(o.overdueNow), 'Quá hạn đang mở', '', o.overdueNow ? '#dc2626' : '#16a34a')}
        ${dashCard(dashN(d.activeUsers), 'Người liên hệ', dashPct(d.activeUsers, pop.headcount) + ' nhân viên' + (d.activeUsers ? ` · TB ${(o.newDirect / d.activeUsers).toFixed(1)} hội thoại/người` : ''), '#4f46e5')}
        ${dashCard(dashN(o.empMsgs), 'Lượt liên hệ', s.avgMsg != null ? Number(s.avgMsg).toFixed(1) + ' tin / hội thoại' : '')}
        ${dashCard(dashHours(r.avgHours), 'TG giải quyết TB', 'Trung vị ' + dashHours(r.medianHours))}
        ${dashCard(dashHours(fr.avgHours), 'TG phản hồi đầu TB', 'Trung vị ' + dashHours(fr.medianHours))}
        ${dashCard(s.avgRating != null ? '&#9733; ' + Number(s.avgRating).toFixed(1) + '<span style="font-size:1rem;color:#94a3b8">/5</span>' : '—', 'Sao trung bình', `${dashPct((s.cntSatisfied ?? 0) + (s.cntUnrated ?? 0), closed)} hài lòng<br>😊 ${dashN((s.cntSatisfied ?? 0) + (s.cntUnrated ?? 0))} · 😐 ${dashN(s.cntNormal)} · 😞 ${dashN(s.cntNotSatisfied)}`, '#d97706')}
        <div class="db-card" style="cursor:pointer" onclick="openRepeat()" title="Xem chi tiết">
            <div class="db-val" style="color:#7c3aed">${dashN(d.repeat.employees)}</div><div class="db-lbl">Người lặp lại</div>
            <div class="db-sub">${dashN(d.repeat.cases)} hội thoại · <b style="color:#7c3aed">Xem chi tiết ›</b></div></div>
    </div>`;

    // ─── Ai đóng hội thoại
    const tc = (s.closedByHr ?? 0) + (s.closedByCsr ?? 0) + (s.closedByEmp ?? 0) + (s.closedByAdmin ?? 0);
    if (tc > 0) {
        const cb = (v, col, lbl) => `<div class="rpt-cb-item"><div class="rpt-cb-val" style="color:${col}">${v ?? 0} <span style="font-size:.75rem;color:#94a3b8">(${pct(v ?? 0, tc)}%)</span></div><div class="rpt-cb-lbl">${lbl}</div></div>`;
        html += `<div class="rpt-closed-by">${cb(s.closedByHr, '#dc2626', 'HR đóng')}${cb(s.closedByCsr, '#0ea5e9', 'CSR đóng')}${cb(s.closedByEmp, '#16a34a', 'NV tự đóng')}${cb(s.closedByAdmin, '#7c3aed', 'Admin đóng')}</div>`;
    }

    // ─── Hài lòng cao nhất / thấp nhất (cần ≥ 5 hội thoại đã đóng)
    const rated = (data.byHr ?? []).filter(h => (h.cntClosed ?? 0) >= 5).sort((a, b) => satPct(b) - satPct(a));
    const topRated = rated[0] ?? null, bottomRated = rated.length > 1 ? rated[rated.length - 1] : null;
    const hl = (cls, icon, label, h) => h
