@{
    ViewData["Title"] = "Báo cáo & Dashboard hội thoại";
}

<style>
.inqhr-page { max-width: 1100px; margin: 0 auto; padding-bottom: 3rem; }

.rpt-export-btn {
    background: rgba(255,255,255,.18); border: 1px solid rgba(255,255,255,.35);
    color: #fff; border-radius: 10px; padding: .45rem .75rem;
    font-size: .8rem; font-weight: 700; cursor: pointer;
    display: inline-flex; align-items: center; gap: .25rem;
}
.rpt-export-btn:hover { background: rgba(255,255,255,.28); }
.rpt-export-btn:disabled { opacity: .8; cursor: not-allowed; }
.rpt-spin { animation: rpt-spin-anim 1s linear infinite; }
@@keyframes rpt-spin-anim { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

/* Filter */
.rpt-ctrl { background: white; border-radius: 14px; padding: .75rem 1rem;
            box-shadow: 0 1px 4px rgba(0,0,0,.06); margin-bottom: .6rem;
            display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; }
.rpt-date-input { border: 1.5px solid #e2e8f0; border-radius: 10px; padding: .4rem .65rem;
                  font-size: .85rem; font-weight: 700; color: #475569; outline: none; }
.rpt-date-input:focus { border-color: #dc2626; }
.rpt-arrow { color: #94a3b8; font-weight: 800; }
.rpt-quick { display: flex; gap: .3rem; flex-wrap: wrap; }
.rpt-quick-btn {
    background: #f1f5f9; border: none; border-radius: 8px; padding: .35rem .65rem;
    font-size: .75rem; font-weight: 700; color: #475569; cursor: pointer;
}
.rpt-quick-btn:hover  { background: #fee2e2; color: #dc2626; }
.rpt-apply {
    background: #dc2626; border: none; color: white; border-radius: 10px;
    padding: .4rem .9rem; font-size: .82rem; font-weight: 700; cursor: pointer;
    display: inline-flex; align-items: center; gap: .25rem;
}
.rpt-apply:hover { background: #b91c1c; }

/* Summary cards */
.rpt-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: .5rem; margin-bottom: .6rem; }
.rpt-card  { background: white; border-radius: 14px; padding: .9rem 1rem; text-align: center;
             box-shadow: 0 1px 4px rgba(0,0,0,.06); }
.rpt-card-val { font-size: 1.7rem; font-weight: 800; color: #1e293b; line-height: 1.1; }
.rpt-card-val.green  { color: #16a34a; }
.rpt-card-val.gray   { color: #64748b; }
.rpt-card-val.red    { color: #dc2626; }
.rpt-card-val.amber  { color: #d97706; }
.rpt-card-lbl { font-size: .7rem; font-weight: 700; color: #94a3b8;
                text-transform: uppercase; letter-spacing: .04em; margin-top: .2rem; }

/* Highlight cards (top/bottom rated) */
.rpt-highlights { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem; margin-bottom: .6rem; }
.rpt-hl {
    background: white; border-radius: 14px; padding: .9rem 1rem;
    box-shadow: 0 1px 4px rgba(0,0,0,.06); display: flex; align-items: center; gap: .75rem;
    position: relative; overflow: hidden;
}
.rpt-hl.top    { border-left: 4px solid #16a34a; }
.rpt-hl.bottom { border-left: 4px solid #dc2626; }
.rpt-hl-icon {
    width: 44px; height: 44px; border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.4rem; flex-shrink: 0;
}
.rpt-hl-icon.top    { background: #dcfce7; color: #16a34a; }
.rpt-hl-icon.bottom { background: #fee2e2; color: #dc2626; }
.rpt-hl-body  { flex: 1; min-width: 0; }
.rpt-hl-label { font-size: .68rem; font-weight: 800; color: #94a3b8;
                text-transform: uppercase; letter-spacing: .04em; }
.rpt-hl-name  { font-size: .95rem; font-weight: 800; color: #1e293b; margin: 2px 0;
                white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rpt-hl-meta  { font-size: .72rem; color: #94a3b8; }
.rpt-hl-rating{ font-size: 1.1rem; font-weight: 800; }
.rpt-hl-rating.top    { color: #d97706; }
.rpt-hl-rating.bottom { color: #b91c1c; }

/* Closed-by */
.rpt-closed-by { background: white; border-radius: 14px; padding: .75rem 1rem;
                 box-shadow: 0 1px 4px rgba(0,0,0,.06); margin-bottom: .6rem;
                 display: flex; gap: 1rem; flex-wrap: wrap; }
.rpt-cb-item   { flex: 1; min-width: 80px; text-align: center; }
.rpt-cb-val    { font-size: 1.2rem; font-weight: 800; color: #1e293b; }
.rpt-cb-lbl    { font-size: .7rem; color: #94a3b8; font-weight: 700; text-transform: uppercase; }

/* Charts */
.rpt-charts { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem; margin-bottom: .6rem; }
.rpt-chart-card { background: white; border-radius: 14px; padding: 1rem;
                  box-shadow: 0 1px 4px rgba(0,0,0,.06); }
.rpt-chart-title { font-size: .78rem; font-weight: 800; color: #475569;
                   text-transform: uppercase; letter-spacing: .04em; margin-bottom: .5rem; }
.rpt-chart-box { position: relative; height: 280px; }

/* Section + Tables */
.rpt-section-title { font-size: .78rem; font-weight: 800; color: #64748b;
                     text-transform: uppercase; letter-spacing: .05em;
                     margin: .6rem 0 .35rem; padding-left: .25rem; }
.rpt-table-wrap { background: white; border-radius: 14px; box-shadow: 0 1px 4px rgba(0,0,0,.06);
                  overflow: hidden; margin-bottom: .75rem; }
.rpt-table { width: 100%; border-collapse: collapse; }
.rpt-table th { padding: .6rem 1rem; font-size: .72rem; font-weight: 800; color: #64748b;
                text-transform: uppercase; letter-spacing: .04em; background: #f8fafc;
                border-bottom: 1px solid #f1f5f9; white-space: nowrap; text-align: left; }
.rpt-table th.num { text-align: right; }
.rpt-table td { padding: .65rem 1rem; border-bottom: 1px solid #f8fafc;
                font-size: .85rem; vertical-align: middle; }
.rpt-table td.num { text-align: right; font-weight: 700; }
.rpt-table tr:last-child td { border-bottom: none; }
.rpt-table tr:hover td { background: #fef2f2; }

.topic-dot  { display: inline-block; width: 10px; height: 10px; border-radius: 50%;
              margin-right: 6px; vertical-align: middle; }
.star-val   { color: #d97706; font-weight: 800; }
.star-row   { color: #d97706; letter-spacing: 1px; white-space: nowrap; }
.star-row .off { color: #e2e8f0; }

/* Rating detail table */
.rpt-rating-wrap { max-height: 480px; overflow-y: auto; }
.rpt-rating-wrap table { width: 100%; }
.rpt-rating-wrap thead th { position: sticky; top: 0; z-index: 1; }
.rpt-note-cell { max-width: 320px; white-space: normal; color: #475569; }
.rpt-note-empty { color: #cbd5e1; font-style: italic; }
.rpt-chat-link {
    display: inline-flex; align-items: center; gap: .2rem;
    color: #dc2626; font-weight: 700; font-size: .78rem; text-decoration: none;
    cursor: pointer;
}
.rpt-chat-link:hover { text-decoration: underline; }

.rpt-empty   { text-align: center; padding: 2rem; color: #94a3b8; font-size: .85rem; }
.rpt-loading { text-align: center; padding: 2.5rem; color: #94a3b8; }
.rpt-err     { background: #fef2f2; border-radius: 10px; padding: .75rem 1rem;
               color: #dc2626; font-size: .85rem; font-weight: 700; margin-bottom: .6rem; }

.rp-back { position: fixed; inset: 0; background: rgba(15,23,42,.5); z-index: 2000; display: none; align-items: center; justify-content: center; padding: 1rem; }
.rp-back.show { display: flex; }
.rp-modal { background: #fff; border-radius: 16px; width: 100%; max-width: 980px; max-height: 92vh; display: flex; flex-direction: column; box-shadow: 0 20px 50px rgba(0,0,0,.3); }
.rp-hd { display: flex; justify-content: space-between; align-items: center; padding: .9rem 1.2rem; border-bottom: 1px solid #f1f5f9; }
.rp-hd h5 { margin: 0; font-weight: 800; font-size: 1.05rem; color: #1e293b; }
.rp-hd button { border: 0; background: none; font-size: 1.7rem; line-height: 1; color: #64748b; cursor: pointer; }
.rp-bd { padding: 1rem 1.2rem; overflow: auto; }
.rp-sum { display: grid; grid-template-columns: 1fr 2fr; gap: .8rem; margin-bottom: 1rem; }
.rp-sum .db-box { box-shadow: none; border: 1px solid #f1f5f9; }
.rp-sum .db-bar-num { width: auto !important; min-width: 100px; white-space: nowrap; }
.rp-sum .db-bar-name { width: 120px; }
.rp-sex { display: flex; justify-content: space-between; font-size: .78rem; color: #64748b; margin-top: .15rem; }
.rpt-table.compact th, .rpt-table.compact td { padding: .45rem .55rem; font-size: .8rem; }
.rpt-table.compact td:first-child { white-space: nowrap; }
@@media (max-width: 768px) {
    .rpt-cards      { grid-template-columns: repeat(2, 1fr); }
    .rpt-highlights { grid-template-columns: 1fr; }
    .rpt-charts     { grid-template-columns: 1fr; }
}

    .db-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: .8rem; margin-bottom: 1rem; }
    .db-card { background: #fff; border-radius: 14px; box-shadow: 0 1px 4px rgba(0,0,0,.06); padding: .9rem 1rem; }
    .db-val { font-size: 1.7rem; font-weight: 800; line-height: 1.1; color: #1e293b; }
    .db-lbl { font-size: .74rem; font-weight: 800; color: #64748b; text-transform: uppercase; letter-spacing: .03em; margin-top: .25rem; }
    .db-sub { font-size: .74rem; color: #94a3b8; margin-top: .2rem; }
    .db-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: .9rem; margin-bottom: 1rem; }
    .db-box { background: #fff; border-radius: 14px; box-shadow: 0 1px 4px rgba(0,0,0,.06); padding: 1rem 1.1rem; }
    .db-box h6 { font-weight: 800; color: #1e293b; margin: 0 0 .15rem; font-size: .95rem; }
    .db-note { font-size: .74rem; color: #94a3b8; margin-bottom: .7rem; line-height: 1.4; }
    .db-bar-row { display: flex; align-items: center; gap: .6rem; margin-bottom: .4rem; font-size: .82rem; }
    .db-bar-name { width: 150px; flex: none; color: #334155; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .db-bar-track { flex: 1; background: #f1f5f9; border-radius: 6px; height: 14px; overflow: hidden; }
    .db-bar-fill { height: 100%; border-radius: 6px; background: #6366f1; }
    .db-bar-num { min-width: 64px; text-align: right; font-weight: 800; color: #1e293b; white-space: nowrap; }
    .db-stack { display: flex; height: 14px; border-radius: 7px; overflow: hidden; background: #f1f5f9; margin: .5rem 0 .7rem; }
.db-stack > div { min-width: 2px; }
.db-leg { display: flex; align-items: center; gap: .5rem; font-size: .82rem; padding: .18rem 0; }
.db-leg i { width: 10px; height: 10px; border-radius: 3px; flex: none; }
.db-leg .nm { color: #334155; flex: 1; min-width: 0; }
.db-leg .vl { font-weight: 800; color: #1e293b; white-space: nowrap; }
.db-leg .pc { color: #94a3b8; font-size: .74rem; min-width: 46px; text-align: right; }
.db-stats { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem .9rem; }
.db-stat .v { font-size: 1.45rem; font-weight: 800; line-height: 1.1; color: #1e293b; }
.db-stat .l { font-size: .74rem; font-weight: 800; color: #64748b; text-transform: uppercase; letter-spacing: .02em; margin-top: .1rem; }
.db-stat .s { font-size: .74rem; color: #94a3b8; }
.db-sub-h { font-size: .72rem; font-weight: 800; color: #64748b; text-transform: uppercase; letter-spacing: .03em; margin: .6rem 0 0; }
.db-spark { display: flex; align-items: flex-end; gap: 2px; height: 110px; padding-top: .3rem; }
    .db-spark div { flex: 1; min-width: 3px; background: #6366f1; border-radius: 3px 3px 0 0; position: relative; }
    .db-spark div.msg { background: #f59e0b; }
    .db-legend { font-size: .74rem; color: #64748b; margin-top: .4rem; display: flex; gap: 1rem; }
    .db-legend i { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 4px; }
    .db-empty { color: #94a3b8; font-size: .85rem; padding: .6rem 0; }
.db-cards.kpi { grid-template-columns: repeat(5, 1fr); }
@@media (max-width: 768px) { .db-cards, .db-cards.kpi { grid-template-columns: repeat(2, 1fr); } .db-grid { grid-template-columns: 1fr; } .rp-sum { grid-template-columns: 1fr; } .db-bar-name { width: 110px; } }
</style>

