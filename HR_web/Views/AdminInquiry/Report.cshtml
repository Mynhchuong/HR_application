    // ─── Biểu đồ theo ngày (đúng từ ngày → đến ngày của bộ lọc)
    html += `<div class="db-box" style="margin-bottom:.9rem"><h6>Diễn biến theo ngày</h6><div style="height:300px"><canvas id="chartDaily"></canvas></div></div>`;
