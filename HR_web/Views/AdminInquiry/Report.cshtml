<!-- Chart.js (CDN) -->
<script src="~/lib/chartjs/chart.umd.min.js"></script>

<script>
const URL_REPORT          = '@Url.Action("GetReport","AdminInquiry")';
const URL_EXPORT          = '@Url.Action("ExportReport","AdminInquiry")';
const URL_RATING_DETAIL   = '@Url.Action("GetRatingDetail","AdminInquiry")';
const URL_UNRESOLVED      = '@Url.Action("GetUnresolvedList","AdminInquiry")';
const URL_EXPORT_UNRESOLVED = '@Url.Action("ExportUnresolved","AdminInquiry")';
const URL_CHAT          = '@Url.Action("Chat","AdminInquiry")';
const IS_ADMIN = @(((bool?)ViewBag.IsAdmin ?? false) ? "true" : "false");

let unresolvedPage = 1;
const UNRESOLVED_PAGE_SIZE = 20;

function fmtDateISO(d) {
    const y = d.getFullYear(), m = String(d.getMonth()+1).padStart(2,'0'), dd = String(d.getDate()).padStart(2,'0');
    return `${y}-${m}-${dd}`;
}
function startOfWeek(d) {
    const x = new Date(d); const dow = x.getDay(); const diff = dow === 0 ? -6 : 1 - dow;
    x.setDate(x.getDate() + diff); x.setHours(0,0,0,0); return x;
}
function endOfWeek(d) { const s = startOfWeek(d); const e = new Date(s); e.setDate(e.getDate() + 6); return e; }
function startOfMonth(d) { return new Date(d.getFullYear(), d.getMonth(), 1); }
function endOfMonth(d)   { return new Date(d.getFullYear(), d.getMonth()+1, 0); }
function fmtMinutes(min) {
    if (min == null) return '—';
    min = Math.round(min); const h = Math.floor(min/60), m = min % 60;
    return h > 0 ? `${h}g ${m}p` : `${m}p`;
}
// Đánh giá 3 mức (Phase 4): lưu số 5/3/1; đọc ≥4 Hài lòng · 3 Bình thường · ≤2 Không hài lòng. Chưa đánh giá (đã đóng) tính Hài lòng.
function ratingKey(r) { r = Number(r) || 0; return r <= 0 ? '' : r >= 4 ? 'S' : r === 3 ? 'N' : 'X'; }
const RATE_UI = { S: ['😊', 'Hài lòng', '#16a34a'], N: ['😐', 'Bình thường', '#d97706'], X: ['😞', 'Không hài lòng', '#dc2626'] };
// Cột đánh giá rõ ràng: sao trung bình (x.x / 5, kèm số lượt chấm) + số lượng từng mức + % hài lòng (chưa đánh giá tính Hài lòng)
const RATING_TH = '<th class="num">Sao TB</th><th class="num" title="4–5 sao">😊</th><th class="num" title="3 sao">😐</th><th class="num" title="1–2 sao">😞</th><th class="num" title="Chưa đánh giá được tính là Hài lòng">% hài lòng</th>';
function ratingCells(x) {
    const s = x.cntSatisfied ?? 0, n = x.cntNormal ?? 0, b = x.cntNotSatisfied ?? 0, u = x.cntUnrated ?? 0;
    const closed = x.cntClosed ?? 0;
    const avg = x.avgRating != null
        ? `<span class="star-val">&#9733; ${Number(x.avgRating).toFixed(1)}</span><span style="color:#94a3b8">/5</span>`
        : '<span style="color:#cbd5e1">—</span>';
    const pct = closed ? Math.round((s + u) * 100 / closed) + '%' : '—';
    return `<td class="num" style="white-space:nowrap" title="${s + n + b} lượt chấm">${avg}</td><td class="num" style="color:#16a34a">${s}</td><td class="num" style="color:#d97706">${n}</td><td class="num" style="color:#dc2626">${b}</td><td class="num" title="${u} chưa đánh giá"><b style="color:#16a34a">${pct}</b></td>`;
}
function satPct(x) { const c = x.cntClosed ?? 0; return c ? ((x.cntSatisfied ?? 0) + (x.cntUnrated ?? 0)) * 100 / c : null; }
function pct(part, total) { if (!total) return 0; return Math.round(part / total * 100); }
function esc(s) { return (s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

// Quick ranges
function quickRange(kind) {
    const now = new Date();
    let s, e;
    if (kind === 'week')      { s = startOfWeek(now); e = endOfWeek(now); }
    else if (kind === 'lastweek') {
        const last = new Date(now); last.setDate(last.getDate() - 7);
        s = startOfWeek(last); e = endOfWeek(last);
    }
    else if (kind === 'month')     { s = startOfMonth(now); e = endOfMonth(now); }
    else if (kind === 'lastmonth') {
        const last = new Date(now.getFullYear(), now.getMonth()-1, 15);
        s = startOfMonth(last); e = endOfMonth(last);
    }
    document.getElementById('fldFrom').value = fmtDateISO(s);
    document.getElementById('fldTo').value   = fmtDateISO(e);
    loadReport();
}

function onApply() { loadReport(); }

async function exportExcel() {
    const f = document.getElementById('fldFrom').value;
    const t = document.getElementById('fldTo').value;
    const btn = document.getElementById('btnExport');
    const originalHtml = btn.innerHTML;

    btn.disabled = true;
    btn.innerHTML = `<span class="material-symbols-rounded rpt-spin" style="font-size:1.1rem;vertical-align:middle">progress_activity</span> Đang xuất...`;

    try {
        const url = `${URL_EXPORT}?from=${encodeURIComponent(f)}&to=${encodeURIComponent(t)}`;
        const res = await fetch(url);
        if (!res.ok) {
            const text = await res.text().catch(() => '');
            throw new Error(text || `Lỗi xuất báo cáo (HTTP ${res.status})`);
        }

        const blob = await res.blob();
        const disp = res.headers.get('content-disposition') || '';
        const match = /filename\*?=(?:UTF-8'')?"?([^";]+)"?/i.exec(disp);
        const fileName = match ? decodeURIComponent(match[1]) : `BaoCaoHoiThoai_${f}_${t}.xlsx`;

        const blobUrl = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = blobUrl;
        a.download = fileName;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(blobUrl);
    } catch (e) {
        alert('Xuất Excel thất bại: ' + e.message);
    } finally {
        btn.disabled = false;
        btn.innerHTML = originalHtml;
    }
}

// Init = current week
(function initRange() {
    const now = new Date();
    document.getElementById('fldFrom').value = fmtDateISO(startOfWeek(now));
    document.getElementById('fldTo').value   = fmtDateISO(endOfWeek(now));
})();

// ═══ Dashboard gộp chung báo cáo: mỗi chỉ số CHỈ xuất hiện 1 lần ═══
const URL_DASH = '@Url.Action("GetDashboard","AdminInquiry")';
const DASH_DEV = { APP_ANDROID: 'App Android', APP_IOS: 'App iOS', WEB_MOBILE: 'Web trên điện thoại', WEB_DESKTOP: 'Web máy tính', UNKNOWN: 'Không rõ' };
const DASH_TYPES = { GRIEVANCE: 'Kiến nghị', OPINION: 'Ý kiến', NONE: 'Chưa phân loại (đơn cũ)' };
const DASH_SEV_COLOR = { LOW: '#6366f1', HIGH: '#f59e0b', ZT: '#dc2626', NONE: '#94a3b8' };
const dashN = v => Number(v ?? 0).toLocaleString('vi-VN');
const dashPct = (a, b) => b ? (a * 100 / b).toFixed(1) + '%' : '—';
let chartDaily = null, chartSeriesTopic = null, chartMonthly = null, chartBacklog = null;
function dashHours(h) {
    if (h == null) return '—';
    if (h < 1) return Math.round(h * 60) + ' phút';
    if (h < 48) return h.toFixed(1) + ' giờ';
    return (h / 24).toFixed(1) + ' ngày';
}
// valText: hiển thị bên phải thanh (mặc định là số); max: mốc 100% của thanh
function dashBars(rows, nameFn, valFn, color, valText, maxVal) {
    const max = maxVal ?? Math.max(1, ...rows.map(valFn));
    return rows.map(r => `<div class="db-bar-row"><div class="db-bar-name" title="${esc(nameFn(r))}">${esc(nameFn(r))}</div>
        <div class="db-bar-track"><div class="db-bar-fill" style="width:${Math.min(100, valFn(r) * 100 / max)}%;background:${(color && color(r)) || '#6366f1'}"></div></div>
        <div class="db-bar-num">${valText ? valText(r) : dashN(valFn(r))}</div></div>`).join('') || '<div class="db-empty">Chưa có dữ liệu</div>';
}
// Thanh xếp chồng 100% + chú giải (cho cơ cấu: công khai/ẩn danh, giới tính, loại báo cáo, mức độ)
function dashStack(items, total, extra) {
    // items: [{name, value, color, note}]
    const tot = total ?? items.reduce((a, x) => a + x.value, 0);
    return `<div class="db-stack">${items.filter(x => x.value > 0).map(x => `<div title="${esc(x.name)}: ${dashN(x.value)}" style="width:${tot ? x.value * 100 / tot : 0}%;background:${x.color}"></div>`).join('')}</div>`
        + items.map(x => `<div class="db-leg"><i style="background:${x.color}"></i><span class="nm">${esc(x.name)}${x.note ? ` <span style="color:#94a3b8;font-size:.72rem">${x.note}</span>` : ''}</span><span class="vl">${dashN(x.value)}</span><span class="pc">${dashPct(x.value, tot)}</span></div>`).join('');
}
const dashCard = (val, lbl, sub, color) => `<div class="db-card"><div class="db-val"${color ? ` style="color:${color}"` : ''}>${val}</div><div class="db-lbl">${lbl}</div>${sub ? `<div class="db-sub">${sub}</div>` : ''}</div>`;

async function loadReport() {
    const f = document.getElementById('fldFrom').value;
    const t = document.getElementById('fldTo').value;

    document.getElementById('rptContent').innerHTML =
        `<div class="rpt-loading">
            <span class="material-symbols-rounded" style="font-size:2rem;color:#dc2626">hourglass_top</span>
            <div style="margin-top:.5rem">Đang tải...</div>
         </div>`;

    try {
        const q = `from=${encodeURIComponent(f)}&to=${encodeURIComponent(t)}`;
        const [data, dash] = await Promise.all([
            fetch(`${URL_REPORT}?${q}`).then(r => r.json()),
            fetch(`${URL_DASH}?${q}`).then(r => r.json())
        ]);
        if (!data.success) {
            document.getElementById('rptContent').innerHTML =
                `<div class="rpt-err">Lỗi: ${esc(data.message ?? 'Không tải được dữ liệu')}</div>`;
            return;
        }
        if (!dash.success) {
            document.getElementById('rptContent').innerHTML =
                `<div class="rpt-err">Lỗi: ${esc(dash.message ?? 'Không tải được dashboard')}</div>`;
            return;
        }
        renderPage(data, dash, f, t);
        loadRatingDetail(f, t);
        unresolvedPage = 1;
        loadUnresolvedList(f, t, unresolvedPage);
    } catch (e) {
        document.getElementById('rptContent').innerHTML =
            `<div class="rpt-err">Lỗi kết nối: ${esc(e.message)}</div>`;
    }
}

function renderStars(n) {
    n = Number(n) || 0;
    const k = ratingKey(n); if (!k) return '—';
    const u = RATE_UI[k];
    let html = '<span class="star-row">';
    for (let i = 1; i <= 5; i++) html += `<span class="${i <= n ? '' : 'off'}">&#9733;</span>`;
    html += `</span> <span style="color:${u[2]};font-weight:800;font-size:.74rem;white-space:nowrap">${u[1]}</span>`;
    return html;
}

function fmtDateTime(iso) {
    if (!iso) return '—';
    const d = new Date(iso);
    if (isNaN(d)) return '—';
    const p = x => String(x).padStart(2,'0');
    return `${p(d.getDate())}/${p(d.getMonth()+1)}/${d.getFullYear()} ${p(d.getHours())}:${p(d.getMinutes())}`;
}

async function loadRatingDetail(f, t) {
    const box = document.getElementById('rptRatingBox');
    if (!box) return;
    try {
        const url  = `${URL_RATING_DETAIL}?from=${encodeURIComponent(f)}&to=${encodeURIComponent(t)}`;
        const res  = await fetch(url);
        const data = await res.json();
        if (!data.success) {
            box.innerHTML = `<div class="rpt-empty">Lỗi: ${esc(data.message ?? 'Không tải được dữ liệu')}</div>`;
            return;
        }
        renderRatingDetail(data.data ?? []);
    } catch (e) {
        box.innerHTML = `<div class="rpt-empty">Lỗi kết nối: ${esc(e.message)}</div>`;
    }
}

function renderRatingDetail(rows) {
    const box = document.getElementById('rptRatingBox');
    if (!box) return;
    if (!rows.length) {
        box.innerHTML = `<div class="rpt-empty">Chưa có đánh giá nào trong khoảng thời gian này</div>`;
        return;
    }
    let html = `<div class="rpt-rating-wrap"><table class="rpt-table">
        <thead><tr>
            <th>Ngày đóng</th><th>Nhân viên</th><th>Phòng ban</th><th>Chủ đề</th>
            <th>Người xử lý</th><th>Đánh giá</th><th>Lý do / nhận xét</th><th></th>
        </tr></thead><tbody>`;
    for (const r of rows) {
        const note = (r.ratingNote ?? '').trim();
        const noteHtml = note ? esc(note) : `<span class="rpt-note-empty">Không có ghi chú</span>`;
        const chatBtn = IS_ADMIN
            ? `<a class="rpt-chat-link" href="${URL_CHAT}?id=${r.id}" target="_blank" rel="noopener">
                 <span class="material-symbols-rounded" style="font-size:1rem">chat</span> Xem chat
               </a>`
            : '';
        html += `<tr>
            <td style="white-space:nowrap;color:#64748b;font-size:.8rem">${fmtDateTime(r.closedDt)}</td>
            <td><span class="vni-font" style="font-weight:700;color:#1e293b">${esc(r.empDisplay ?? '—')}</span><br><span style="font-size:.72rem;color:#94a3b8">${esc(r.empCd ?? '')}</span></td>
            <td class="vni-font" style="font-size:.8rem">${esc(r.deptName ?? '—')}</td>
            <td style="font-size:.8rem">${esc(r.topicName ?? '—')}</td>
            <td class="vni-font" style="font-size:.8rem">${esc(r.assignedName ?? '—')}</td>
            <td>${renderStars(r.rating)}</td>
            <td class="rpt-note-cell">${noteHtml}</td>
            <td>${chatBtn}</td>
        </tr>`;
    }
    html += `</tbody></table></div>`;
    box.innerHTML = html;
}

// Danh sách hội thoại CHƯA XỬ LÝ (STATUS='OPEN') trong kỳ — yêu cầu 2026-10-16. Có phân trang vì
// hộp thư có thể tồn đọng hàng trăm/ngàn hội thoại mở, không thể render hết 1 lần.
async function loadUnresolvedList(f, t, page) {
    const box = document.getElementById('rptUnresolvedBox');
    if (!box) return;
    box.innerHTML = `<div class="rpt-loading" style="padding:1.2rem"><span class="material-symbols-rounded" style="font-size:1.4rem;color:#dc2626">hourglass_top</span></div>`;
    try {
        const url  = `${URL_UNRESOLVED}?from=${encodeURIComponent(f)}&to=${encodeURIComponent(t)}&page=${page}&pageSize=${UNRESOLVED_PAGE_SIZE}`;
        const res  = await fetch(url);
        const data = await res.json();
        if (!data.success) {
            box.innerHTML = `<div class="rpt-empty">Lỗi: ${esc(data.message ?? 'Không tải được dữ liệu')}</div>`;
            return;
        }
        unresolvedPage = data.page || 1;
        renderUnresolvedList(data);
    } catch (e) {
        box.innerHTML = `<div class="rpt-empty">Lỗi kết nối: ${esc(e.message)}</div>`;
    }
}

function dashAge(iso) {
    const h = (Date.now() - new Date(iso).getTime()) / 3600000;
    return h < 1 ? Math.max(1, Math.round(h * 60)) + ' phút' : h < 48 ? Math.round(h) + ' giờ' : Math.round(h / 24) + ' ngày';
}
function renderUnresolvedList(data) {
    const box  = document.getElementById('rptUnresolvedBox');
    const rows = data.data ?? [];
    if (!rows.length) {
        box.innerHTML = `<div class="rpt-empty">Không có hội thoại nào đang chờ phản hồi 🎉</div>`;
        const pg = document.getElementById('rptUnresolvedPaging');
        if (pg) pg.innerHTML = '';
        return;
    }
    const today = new Date(); today.setHours(0, 0, 0, 0);
    let html = `<table class="rpt-table compact">
        <thead><tr><th>Tạo lúc</th><th>Đã chờ</th><th>Nhân viên</th><th>Chủ đề</th><th>Tin nhắn đầu</th><th>PIC</th><th>Hạn</th><th></th></tr></thead><tbody>`;
    for (const r of rows) {
        const chatBtn = IS_ADMIN
            ? `<a class="rpt-chat-link" href="${URL_CHAT}?id=${r.id}" target="_blank" rel="noopener"><span class="material-symbols-rounded" style="font-size:1rem">chat</span></a>`
            : '';
        const dl = r.deadlineDt ? new Date(r.deadlineDt) : null;
        const late = dl && dl < today;
        const dlHtml = dl ? `<span style="${late ? 'color:#dc2626;font-weight:800' : ''}">${String(dl.getDate()).padStart(2, '0')}/${String(dl.getMonth() + 1).padStart(2, '0')}${late ? ' · quá hạn' : ''}</span>` : '<span style="color:#cbd5e1">—</span>';
        html += `<tr>
            <td style="white-space:nowrap;color:#64748b">${fmtDateTime(r.instDt)}</td>
            <td style="white-space:nowrap;font-weight:700">${dashAge(r.instDt)}</td>
            <td>${r.empDisplay && r.chatType !== 'ANON' ? `<span class="vni-font" style="font-weight:700;color:#1e293b">${esc(r.empDisplay)}</span> <span style="font-size:.72rem;color:#94a3b8">${esc(r.empCd ?? '')}</span>` : '<span style="color:#94a3b8">Ẩn danh</span>'}</td>
            <td>${esc(r.topicName ?? '—')}</td>
            <td class="rpt-note-cell">${r.firstMsg ? esc(r.firstMsg) : '<span class="rpt-note-empty">—</span>'}</td>
            <td>${r.picName ? esc(r.picName) : '<span style="color:#cbd5e1">—</span>'}${r.draftPending > 0 ? ' <span title="Có bản nháp chờ CSR duyệt" style="background:#fef3c7;color:#92400e;border-radius:999px;padding:0 .4rem;font-size:.68rem;font-weight:800">✍ nháp</span>' : ''}</td>
            <td style="white-space:nowrap">${dlHtml}</td>
            <td>${chatBtn}</td>
        </tr>`;
    }
    html += `</tbody></table>`;
    box.innerHTML = html;

    // Phân trang
    const totalPages = data.totalPages || 1;
    const pgBox = document.getElementById('rptUnresolvedPaging');
    if (!pgBox) return;
    if (totalPages <= 1) { pgBox.innerHTML = ''; return; }
    let pg = `<span style="font-size:.78rem;color:#64748b;margin-right:.6rem">${data.total} hội thoại — trang ${data.page}/${totalPages}</span>`;
    pg += `<button class="rpt-quick-btn" ${data.page<=1?'disabled':''} onclick="gotoUnresolvedPage(${data.page-1})">‹ Trước</button>`;
    pg += `<button class="rpt-quick-btn" ${data.page>=totalPages?'disabled':''} onclick="gotoUnresolvedPage(${data.page+1})">Sau ›</button>`;
    pgBox.innerHTML = pg;
}

function gotoUnresolvedPage(p) {
    const f = document.getElementById('fldFrom').value;
    const t = document.getElementById('fldTo').value;
    loadUnresolvedList(f, t, p);
}

async function exportUnresolved() {
    const f = document.getElementById('fldFrom').value;
    const t = document.getElementById('fldTo').value;
    const btn = document.getElementById('btnExportUnresolved');
    const originalHtml = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = `<span class="material-symbols-rounded rpt-spin" style="font-size:1rem;vertical-align:middle">progress_activity</span> Đang xuất...`;
    try {
        const url = `${URL_EXPORT_UNRESOLVED}?from=${encodeURIComponent(f)}&to=${encodeURIComponent(t)}`;
        const res = await fetch(url);
        if (!res.ok) {
            const text = await res.text().catch(() => '');
            throw new Error(text || `Lỗi xuất (HTTP ${res.status})`);
        }
        const blob = await res.blob();
        const disp = res.headers.get('content-disposition') || '';
        const match = /filename\*?=(?:UTF-8'')?"?([^";]+)"?/i.exec(disp);
        const fileName = match ? decodeURIComponent(match[1]) : `HoiThoaiChuaXuLy_${f}_${t}.xlsx`;
        const blobUrl = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = blobUrl; a.download = fileName;
        document.body.appendChild(a); a.click(); a.remove();
        URL.revokeObjectURL(blobUrl);
    } catch (e) {
        alert('Xuất Excel thất bại: ' + e.message);
    } finally {
        btn.disabled = false;
        btn.innerHTML = originalHtml;
    }
}

// "AI SAMHO - CSR" (HR_AI_CHAT) — khối riêng, tách hẳn khỏi phần Inquiry phía trên vì không có
