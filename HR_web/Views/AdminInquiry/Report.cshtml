        <div style="height:120px"><canvas id="chartBacklog"></canvas></div></div>`;
    html += `<div class="db-box" style="margin-bottom:.9rem"><h6>Chủ đề theo thời gian</h6><div style="height:280px"><canvas id="chartSeriesTopic"></canvas></div></div>`;

    // ─── Các khối phân tích
    const devTotal = d.devices.reduce((a, x) => a + x.count, 0);
    const onTimePct = r.withDeadline ? Math.round(r.onTime * 100 / r.withDeadline) : null;
    const SEXN = { F: 'Nữ', M: 'Nam', '?': 'Không rõ' }, SEXC = { F: '#ec4899', M: '#3b82f6', '?': '#94a3b8' };
    const aSex = {}, hSex = {}; let hTot = 0; (d.activeBySex || []).forEach(x => aSex[x.sex] = x.count); (d.headBySex || []).forEach(x => { hSex[x.sex] = x.count; hTot += x.count; });
    const sexItems = ['F', 'M', '?'].filter(k => aSex[k] || (k === 'F' || k === 'M')).map(k => ({ name: SEXN[k], value: aSex[k] || 0, color: SEXC[k], note: k === '?' ? '' : `(toàn NV ${dashPct(hSex[k] || 0, hTot)})` }));
    // % đã đóng riêng cho Kiến nghị / Ý kiến (yêu cầu CSR 2026-11-12)
    const closedByType = d.byType.filter(x => x.key !== 'NONE' && x.count > 0)
        .map(x => `${esc(DASH_TYPES[x.key] || x.key)} <b style="color:#16a34a">${dashPct(x.closed ?? 0, x.count)}</b> (${dashN(x.closed ?? 0)}/${dashN(x.count)})`).join(' · ');
    const typeItems = d.byType.map(x => ({ name: DASH_TYPES[x.key] || x.key, value: x.count, color: { GRIEVANCE: '#dc2626', OPINION: '#6366f1', NONE: '#cbd5e1' }[x.key] || '#94a3b8' }));
    const sevItems = d.bySeverity.map(x => ({ name: x.name || (x.key === 'NONE' ? 'Chưa phân loại (đơn cũ)' : x.key), value: x.count, color: DASH_SEV_COLOR[x.key] || '#94a3b8' }));
    // Mức độ sử dụng My Samho (yêu cầu CSR 2026-11-12).
    // Tổng NV = người đang làm (ECM100.JEAJIKGB='Y') + người nghỉ việc trong kỳ (RETDAT trong kỳ — đã rời nhóm đang làm nên không trùng).
    // Chốt lại 2026-11-12: khối này hiện 4 ô Tổng / Đã dùng / Nghỉ việc / NV mới và KHÔNG in dòng phép cộng nữa.
    //   → "NV mới vào làm" đã nằm sẵn trong nhóm đang làm, nên 4 ô này KHÔNG cộng ra Tổng. Phần đối chiếu cộng khớp
    //     (ô "Chưa dùng" + dòng "Cộng kiểm tra") vẫn còn trong bản xuất Excel ở AdminInquiryController.
    // Yêu cầu 2026-11-12: "ĐÃ DÙNG MY SAMHO + NGHỈ VIỆC TRONG KỲ = TỔNG NHÂN VIÊN" phải khớp.
    //   → ô "Đã dùng" lấy TRỌN nhóm đang làm (headcount), không trừ ra 14 người chưa đăng nhập, để phép cộng đúng.
    //   → Số đăng nhập THẬT vẫn giữ ở useLoggedIn và hiện ở phụ đề + tooltip, đừng xoá: báo cáo này gửi khách,
    //     nói "đã dùng" mà gồm cả người chưa từng đăng nhập thì phải có chỗ tra lại cho đúng.
    //     (Đã kiểm 2026-11-12: 14 người này KHÔNG phải NV mới — vào làm từ 2007 đến 07/2026.)
    const useLoggedIn = pop.loggedIn ?? 0;
    const useUsed     = pop.headcount ?? 0;
    const useNotLogged= Math.max(0, useUsed - useLoggedIn);
    const useResigned = d.accounts.resigned ?? 0;
    const useHired    = d.accounts.hired ?? 0;
    const useTotal    = (pop.headcount ?? 0) + useResigned;
    const stat = (v, l, sub, col, tip) => `<div class="db-stat"${tip ? ` title="${esc(tip)}"` : ''}><div class="v"${col ? ` style="color:${col}"` : ''}>${v}</div><div class="l">${l}</div>${sub ? `<div class="s">${sub}</div>` : ''}</div>`;
    html += `<div class="db-grid">
        <div class="db-box"><h6>Thiết bị người dùng</h6>
            ${dashBars(d.devices, x => DASH_DEV[x.device] || x.device, x => x.count, null, x => `${dashN(x.count)} · ${dashPct(x.count, devTotal)}`)}</div>
        <div class="db-box"><h6>Công khai / Ẩn danh</h6>
            ${dashStack([{ name: 'Công khai', value: s.cntDirect ?? 0, color: '#6366f1' }, { name: 'Ẩn danh', value: s.cntAnon ?? 0, color: '#475569' }], total)}</div>
        <div class="db-box"><h6>Giới tính người liên hệ</h6>
            ${dashStack(sexItems, d.activeUsers)}</div>
        <div class="db-box"><h6>Mức độ sử dụng My Samho</h6>
            <div class="db-stats" style="margin-top:.4rem">
                ${stat(dashN(useTotal), 'Tổng nhân viên', 'đang làm + nghỉ việc trong kỳ')}
                ${stat(dashN(useUsed), 'Đã dùng My Samho', `${dashPct(useUsed, useTotal)}${useNotLogged ? ` · ${dashN(useNotLogged)} chưa đăng nhập` : ''}`, '#4f46e5',
                    useNotLogged ? `Tính trọn ${dashN(useUsed)} nhân viên đang làm để cộng khớp Tổng nhân viên. Thực tế có ${dashN(useLoggedIn)} người đã đăng nhập My Samho, còn ${dashN(useNotLogged)} người chưa đăng nhập lần nào.` : null)}
                ${stat(dashN(useResigned), 'Nghỉ việc trong kỳ', `${dashN(d.accounts.resignedLocked)} đã khóa tài khoản`, '#dc2626')}
                ${stat(dashN(useHired), 'NV mới vào làm', `${dashN(d.accounts.hiredUsed)} đã dùng · trong kỳ`, '#16a34a')}
            </div></div>
        <div class="db-box"><h6>Thời gian giải quyết</h6>
            ${dashBars([['Dưới 1 giờ', r.buckets[0]], ['1 – 4 giờ', r.buckets[1]], ['4 – 24 giờ', r.buckets[2]], ['1 – 3 ngày', r.buckets[3]], ['Trên 3 ngày', r.buckets[4]]], x => x[0], x => x[1])}
            ${onTimePct == null ? '' : `<div class="db-note" style="margin-top:.5rem">Đúng hạn: <b>${onTimePct}%</b> (${dashN(r.onTime)}/${dashN(r.withDeadline)})</div>`}
            ${d.overdueByPic.length ? `<div class="db-note"><b>Quá hạn theo phòng:</b> ${d.overdueByPic.map(x => esc(x.pic) + ' (' + x.count + ')').join(' · ')}</div>` : ''}</div>
        <div class="db-box"><h6>Phân loại</h6>
            <div class="db-sub-h" style="margin-top:.3rem">Loại báo cáo</div>${dashStack(typeItems)}
            ${closedByType ? `<div class="db-note" style="margin:.35rem 0 .2rem">Đã đóng: ${closedByType}</div>` : ''}
            <div class="db-sub-h">Mức độ</div>${dashStack(sevItems)}</div>
    </div>`;

    // ─── Bảng theo chủ đề (đã gộp: tỷ lệ, nhiều/ít nhất, lặp lại, đánh giá)
    html += `<div class="rpt-section-title"><span class="material-symbols-rounded" style="font-size:.85rem;vertical-align:middle">topic</span> Chi tiết theo chủ đề</div>`;
    if (!data.byTopic || data.byTopic.length === 0) {
        html += `<div class="rpt-table-wrap"><div class="rpt-empty">Không có dữ liệu</div></div>`;
    } else {
        const maxT = Math.max(1, ...data.byTopic.map(x => x.total));
        html += `<div class="rpt-table-wrap"><table class="rpt-table compact">
            <thead><tr><th>Chủ đề</th><th>Số hội thoại</th><th class="num">Mở</th><th class="num">Đóng</th><th class="num" title="Cùng nhân viên, cùng chủ đề, từ 2 hội thoại — chỉ hội thoại công khai">Lặp lại</th>${RATING_TH}</tr></thead><tbody>`;
        for (const x of data.byTopic) {
            const rp = repeatByTopic[x.topicCd];
            html += `<tr>
                <td><span class="topic-dot" style="background:${x.color ?? '#94a3b8'}"></span>${esc(x.topicName ?? x.topicCd)}</td>
                <td><div style="display:flex;align-items:center;gap:.5rem"><div class="db-bar-track" style="width:90px;flex:none"><div class="db-bar-fill" style="width:${x.total * 100 / maxT}%;background:${x.color ?? '#6366f1'}"></div></div><b>${dashN(x.total)}</b><span style="color:#94a3b8;font-size:.72rem">${pct(x.total, total)}%</span></div></td>
                <td class="num" style="color:#16a34a">${x.cntOpen}</td>
                <td class="num" style="color:#64748b">${x.cntClosed}</td>
                <td class="num" title="${rp ? rp.employees + ' người' : ''}">${rp ? dashN(rp.cases) : '<span style="color:#cbd5e1">—</span>'}</td>
                ${ratingCells(x)}
            </tr>`;
        }
        html += `</tbody></table></div>`;
    }

    // ─── Bảng người tham gia xử lý
    html += `<div class="rpt-section-title"><span class="material-symbols-rounded" style="font-size:.85rem;vertical-align:middle">manage_accounts</span> Chi tiết người tham gia xử lý</div>`;
    if (!data.byHr || data.byHr.length === 0) {
        html += `<div class="rpt-table-wrap"><div class="rpt-empty">Không có dữ liệu</div></div>`;
    } else {
        const maxH = Math.max(1, ...data.byHr.map(x => x.handled));
        html += `<div class="rpt-table-wrap"><table class="rpt-table compact">
            <thead><tr><th>Người xử lý</th><th>Tham gia</th><th class="num">Đã đóng</th>${RATING_TH}<th class="num">TG xử lý TB</th></tr></thead><tbody>`;
        for (const h of data.byHr) {
            html += `<tr>
                <td><span class="vni-font" style="font-weight:700;color:#1e293b">${esc(h.hrName ?? '—')}</span> ${h.hrCd ? `<span style="font-size:.72rem;color:#94a3b8;margin-left:4px">${esc(h.hrCd)}</span>` : ''}</td>
                <td><div style="display:flex;align-items:center;gap:.5rem"><div class="db-bar-track" style="width:90px;flex:none"><div class="db-bar-fill" style="width:${h.handled * 100 / maxH}%"></div></div><b>${dashN(h.handled)}</b></div></td>
                <td class="num" style="color:#64748b">${h.cntClosed}</td>
                ${ratingCells(h)}
                <td class="num" style="color:#0ea5e9">${fmtMinutes(h.avgHandleMin)}</td>
            </tr>`;
        }
        // Dòng tổng: % hài lòng của TẤT CẢ nhân viên (yêu cầu CSR 2026-11-12).
        // Lấy từ summary toàn kỳ, KHÔNG cộng các dòng trên — cộng dòng sẽ sai theo cả 2 chiều:
        //   • thiếu: hội thoại nhân viên tự đóng, không ai trong HR/CSR tham gia thì không có dòng nào chứa nó;
        //   • trùng: 1 hội thoại nhiều người cùng xử lý thì bị đếm ở nhiều dòng.
        html += `</tbody><tfoot><tr style="background:#f8fafc;border-top:2px solid #e2e8f0;font-weight:800">
                <td style="font-weight:800;color:#1e293b">TẤT CẢ nhân viên</td>
                <td><b>${dashN(total)}</b> <span style="font-size:.72rem;color:#94a3b8;font-weight:600">hội thoại</span></td>
                <td class="num" style="color:#64748b">${dashN(closed)}</td>
                ${ratingCells(s)}
                <td class="num" style="color:#0ea5e9">${fmtMinutes(s.avgHandleMin)}</td>
            </tr></tfoot></table></div>`;
        html += `<div class="db-note" style="margin-top:.4rem">Dòng <b>TẤT CẢ nhân viên</b> tính trên toàn bộ ${dashN(total)} hội thoại trong kỳ (gồm cả hội thoại nhân viên tự đóng, không ai trong HR/CSR tham gia), nên không bằng tổng các dòng ở trên.</div>`;
    }

    // ─── Chưa có phản hồi (tải riêng, có phân trang)
    html += `<div class="rpt-section-title" style="display:flex;align-items:center;justify-content:space-between">
        <span><span class="material-symbols-rounded" style="font-size:.85rem;vertical-align:middle">report</span> Hội thoại chưa có phản hồi</span>
        <button class="rpt-export-btn" id="btnExportUnresolved" onclick="exportUnresolved()" style="font-size:.72rem;padding:.3rem .7rem">
            <span class="material-symbols-rounded" style="font-size:.95rem;vertical-align:middle">download</span> Xuất Excel
        </button>
    </div>`;
    html += `<div class="rpt-table-wrap" id="rptUnresolvedBox"><div class="rpt-loading" style="padding:1.2rem"><span class="material-symbols-rounded" style="font-size:1.4rem;color:#dc2626">hourglass_top</span></div></div>`;
    html += `<div id="rptUnresolvedPaging" style="text-align:right;margin:.4rem 0 1rem"></div>`;

    html += buildAiSectionHtml(data.ai);

    html += `<div class="rpt-section-title"><span class="material-symbols-rounded" style="font-size:.85rem;vertical-align:middle">reviews</span> Chi tiết đánh giá</div>`;
    html += `<div class="rpt-table-wrap" id="rptRatingBox"><div class="rpt-loading" style="padding:1.2rem"><span class="material-symbols-rounded" style="font-size:1.4rem;color:#dc2626">hourglass_top</span></div></div>`;

    document.getElementById('rptContent').innerHTML = html;
    renderCharts(d, f, t);
}

function renderCharts(d, f, t) {
    if (chartDaily)       { chartDaily.destroy();       chartDaily       = null; }
    if (chartMonthly)     { chartMonthly.destroy();     chartMonthly     = null; }
    if (chartBacklog)     { chartBacklog.destroy();     chartBacklog     = null; }
    if (chartSeriesTopic) { chartSeriesTopic.destroy(); chartSeriesTopic = null; }
    if (typeof Chart === 'undefined') return;
    const sr = d.series;
    // Trục thời gian: từng ngày, đúng khoảng bộ lọc mà API đã áp dụng
    const df = d.from || f, dt = d.to || t;
    const dayKeys = [], labels = [];
    for (let x = new Date(df + 'T00:00:00'), end = new Date(dt + 'T00:00:00'); x <= end; x.setDate(x.getDate() + 1)) {
        dayKeys.push(fmtDateISO(x)); labels.push(`${String(x.getDate()).padStart(2, '0')}/${String(x.getMonth() + 1).padStart(2, '0')}`);
    }
    const pick = (rows, keyField, key) => dayKeys.map(k => (rows.find(r => r.bucket === k && (keyField == null || r[keyField] === key)) || {}).count || 0);
    const dotR = labels.length > 45 ? 0 : 3;
    const common = { responsive: true, maintainAspectRatio: false, interaction: { mode: 'index', intersect: false },
                     plugins: { legend: { position: 'bottom', labels: { font: { size: 11 }, boxWidth: 12 } } } };

    // Hội thoại mới theo loại báo cáo (cột chồng) + tin nhắn công nhân (đường) + số người liên hệ cộng dồn (đường, trục phải)
    const types = [['GRIEVANCE', 'Kiến nghị', '#dc2626'], ['OPINION', 'Ý kiến', '#6366f1'], ['NONE', 'Chưa phân loại (đơn cũ)', '#cbd5e1']];
    const msgByDay = {}; d.dailyMsgs.forEach(x => msgByDay[x.date] = x.count);
    let cum = 0; const newByDay = {}; sr.newContacts.forEach(x => newByDay[x.bucket] = x.count);
    const cumData = dayKeys.map(k => (cum += (newByDay[k] || 0)));
    const c1 = document.getElementById('chartDaily');
    if (c1) chartDaily = new Chart(c1, {
        data: { labels, datasets: [
            ...types.map(([k, name, color]) => ({ type: 'bar', label: 'Hội thoại mới — ' + name, data: pick(sr.byType, 'key', k), backgroundColor: color, stack: 'a', yAxisID: 'y' })),
            { type: 'line', label: 'Tin nhắn công nhân', data: dayKeys.map(k => msgByDay[k] || 0), borderColor: '#f59e0b', backgroundColor: '#f59e0b', tension: .25, pointRadius: dotR, yAxisID: 'y' },
            { type: 'line', label: 'Số người liên hệ (cộng dồn)', data: cumData, borderColor: '#0f172a', backgroundColor: '#0f172a', tension: .25, pointRadius: dotR, borderDash: [5, 3], yAxisID: 'y1' } ] },
        options: { ...common, scales: { x: { stacked: true, ticks: { maxTicksLimit: 16 } }, y: { stacked: true, beginAtZero: true, title: { display: true, text: 'Số hội thoại / tin nhắn' } },
                   y1: { position: 'right', beginAtZero: true, grid: { drawOnChartArea: false }, title: { display: true, text: 'Số người' } } } }
    });

    // Theo tháng: nhận / đã giải quyết / còn tồn cuối tháng (cắt theo khoảng của bộ lọc)
    const mk = [], ml = [];
    for (let x = new Date(df.slice(0, 7) + '-01T00:00:00'), end = new Date(dt + 'T00:00:00'); x <= end; x.setMonth(x.getMonth() + 1)) {
        mk.push(`${x.getFullYear()}-${String(x.getMonth() + 1).padStart(2, '0')}`); ml.push(`${String(x.getMonth() + 1).padStart(2, '0')}/${x.getFullYear()}`);
    }
    const byM = rows => mk.map(k => (rows.find(r => r.bucket === k) || {}).count || 0);
    const recv = byM(d.monthly.received), done = byM(d.monthly.resolved);
    let bal = d.monthly.openAtStart; const backlog = mk.map((_, i) => (bal += recv[i] - done[i]));
    // Nhãn số trên đầu cột / điểm (để tháng ít số liệu vẫn đọc được dù cột rất thấp so với tháng cao điểm)
    const valueLabels = { id: 'valueLabels', afterDatasetsDraw(ch) {
        const ctx = ch.ctx; ctx.save(); ctx.font = '600 11px Inter, sans-serif'; ctx.textAlign = 'center';
        ch.data.datasets.forEach((ds, i) => { if (!ds.showValues) return;
            ch.getDatasetMeta(i).data.forEach((el, k) => { const v = ds.data[k]; if (v == null) return;
                ctx.fillStyle = ds.borderColor && ds.type === 'line' ? ds.borderColor : '#334155';
                ctx.fillText(Number(v).toLocaleString('vi-VN'), el.x, el.y - 6); }); });
        ctx.restore(); } };
    const c3 = document.getElementById('chartMonthly');
    if (c3) chartMonthly = new Chart(c3, {
        type: 'bar', plugins: [valueLabels],
        data: { labels: ml, datasets: [
            { label: 'Nhận mới', data: recv, backgroundColor: '#6366f1', borderRadius: 5, showValues: true },
            { label: 'Đã giải quyết', data: done, backgroundColor: '#16a34a', borderRadius: 5, showValues: true } ] },
        options: { responsive: true, maintainAspectRatio: false, categoryPercentage: .7, barPercentage: .9, layout: { padding: { top: 18 } },
            plugins: { legend: { position: 'top', align: 'end', labels: { font: { size: 11 }, boxWidth: 12 } }, tooltip: { mode: 'index', intersect: false } },
            scales: { x: { grid: { display: false } }, y: { beginAtZero: true, grace: '8%', ticks: { maxTicksLimit: 4 }, grid: { color: '#f1f5f9' } } } }
    });
    const c4 = document.getElementById('chartBacklog');
    if (c4) chartBacklog = new Chart(c4, {
        type: 'line', plugins: [valueLabels],
        data: { labels: ml, datasets: [{ label: 'Còn tồn cuối tháng', data: backlog, type: 'line', borderColor: '#dc2626', backgroundColor: 'rgba(220,38,38,.10)', fill: true, tension: .3, pointRadius: 4, pointBackgroundColor: '#dc2626', showValues: true }] },
        options: { responsive: true, maintainAspectRatio: false, layout: { padding: { top: 18 } },
            plugins: { legend: { display: false }, tooltip: { mode: 'index', intersect: false } },
            scales: { x: { offset: true, grid: { display: false } }, y: { display: false, beginAtZero: true, grace: '20%' } } }
    });

    const pal = ['#dc2626', '#6366f1', '#10b981', '#f59e0b', '#0ea5e9'];
    const c2 = document.getElementById('chartSeriesTopic');
    if (c2) chartSeriesTopic = new Chart(c2, {
        type: 'line',
        data: { labels, datasets: sr.topTopics.map((tp, i) => ({ label: tp.topicName || tp.topicCd, data: pick(sr.byTopic, 'topicCd', tp.topicCd), borderColor: pal[i % pal.length], backgroundColor: pal[i % pal.length], tension: .25, pointRadius: dotR })) },
        options: { ...common, scales: { x: { ticks: { maxTicksLimit: 16 } }, y: { beginAtZero: true, title: { display: true, text: 'Số hội thoại' } } } }
    });
}

// ── Chi tiết "người lặp lại" (popup): giới tính, loại báo cáo, danh sách ──
const URL_REPEAT = '@Url.Action("GetRepeatDetail","AdminInquiry")';
let repeatRows = [];
const SEX_NAME = { M: 'Nam', F: 'Nữ', '?': 'Không rõ' };
function closeRepeat() { document.getElementById('rpBack').classList.remove('show'); }
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeRepeat(); });
async function openRepeat() {
    const f = document.getElementById('fldFrom').value, t = document.getElementById('fldTo').value;
    const body = document.getElementById('rpBody');
    document.getElementById('rpBack').classList.add('show');
    body.innerHTML = '<div class="db-empty">Đang tải...</div>';
    try {
        const d = await (await fetch(`${URL_REPEAT}?from=${encodeURIComponent(f)}&to=${encodeURIComponent(t)}`)).json();
        if (!d.success) { body.innerHTML = `<div class="rpt-err">${esc(d.message || 'Không tải được')}</div>`; return; }
        repeatRows = d.rows || [];
        const sm = d.summary, ppl = sm.people || 0;
        const typeRows = dashBars([['Kiến nghị', sm.grievance], ['Ý kiến', sm.opinion], ['Chưa phân loại (đơn cũ)', sm.unclassified]], x => x[0], x => x[1], null,
            x => `${dashN(x[1])} · ${dashPct(x[1], sm.cases)}`);
        body.innerHTML = `
            <div class="rp-sum">
                <div class="db-box"><h6>Tổng</h6><div class="db-val">${dashN(ppl)}</div><div class="db-lbl">người</div><div class="db-sub">${dashN(sm.cases)} hội thoại · cùng chủ đề từ 2 lần</div></div>
                <div class="db-box"><h6>Loại báo cáo</h6>${typeRows}</div>
            </div>
            <div style="display:flex;gap:.6rem;align-items:center;margin-bottom:.6rem;flex-wrap:wrap">
                <input type="text" id="rpSearch" placeholder="Tìm mã NV, tên, chủ đề..." oninput="renderRepeatRows()" style="border:1.5px solid #e2e8f0;border-radius:10px;padding:.4rem .7rem;font-size:.85rem;min-width:240px">
                <span style="font-size:.74rem;color:#94a3b8">${repeatRows.length < ppl ? `Hiển thị ${repeatRows.length} dòng nhiều nhất` : `${repeatRows.length} dòng`}</span>
            </div>
            <div class="rpt-table-wrap" style="max-height:48vh;overflow:auto"><table class="rpt-table compact">
                <thead><tr><th>Nhân viên</th><th>Giới tính</th><th>Phòng ban</th><th>Chủ đề</th><th class="num">Số hội thoại</th><th class="num">Kiến nghị / Ý kiến</th><th>Gần nhất</th></tr></thead>
                <tbody id="rpRows"></tbody></table></div>`;
        renderRepeatRows();
    } catch (e) { body.innerHTML = `<div class="rpt-err">Lỗi: ${esc(e.message)}</div>`; }
}
function renderRepeatRows() {
    const q = (document.getElementById('rpSearch')?.value || '').trim().toLowerCase();
    const rows = repeatRows.filter(r => !q || [r.empCd, r.empName, r.topicName, r.topicCd, r.dept].some(v => (v || '').toLowerCase().includes(q)));
    document.getElementById('rpRows').innerHTML = rows.map(r => `<tr>
        <td><span class="vni-font" style="font-weight:700;color:#1e293b">${esc(r.empName || '—')}</span> <span style="font-size:.72rem;color:#94a3b8">${esc(r.empCd)}</span></td>
        <td>${r.sex === 'F' ? '<span style="color:#ec4899;font-weight:700">Nữ</span>' : r.sex === 'M' ? '<span style="color:#3b82f6;font-weight:700">Nam</span>' : '<span style="color:#cbd5e1">—</span>'}</td>
        <td class="vni-font" style="font-size:.78rem">${esc(r.dept || '—')}</td>
        <td>${esc(r.topicName || r.topicCd)}</td>
        <td class="num"><b>${r.cases}</b></td>
        <td class="num" style="white-space:nowrap">${r.grievance} / ${r.opinion}${r.unclassified ? ` <span style="color:#94a3b8" title="Chưa phân loại (đơn cũ)">(+${r.unclassified})</span>` : ''}</td>
        <td style="white-space:nowrap;color:#64748b">${fmtDateTime(r.lastDt)}</td></tr>`).join('') || '<tr><td colspan="7" class="rpt-empty">Không có dữ liệu</td></tr>';
}

loadReport();   // chạy sau khi toàn bộ hàm/hằng số đã khai báo
</script>
