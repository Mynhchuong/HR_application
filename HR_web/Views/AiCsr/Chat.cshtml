@{
    Layout = "_Layout";
    ViewData["Title"] = "AI SAMHO - CSR";
    var empCd = (string)(ViewBag.EmpCd ?? "");
}

@section Styles {
<style>
    .aic-wrap { max-width: 720px; margin: 0 auto; }
    .aic-head { display:flex; align-items:center; gap:.6rem; padding:.75rem 1rem; background:linear-gradient(135deg,#4f46e5,#7c3aed); color:#fff; border-radius:16px 16px 0 0; }
    .aic-head .bot { width:38px;height:38px;border-radius:50%;background:rgba(255,255,255,.18);display:flex;align-items:center;justify-content:center;font-size:1.2rem; }
    .aic-head h6 { margin:0;font-weight:800;font-size:.95rem; }
    .aic-head small { opacity:.85;font-size:.72rem; }
    .aic-body { background:#f8fafc; border:1px solid #e2e8f0; border-top:0; height:min(62vh,560px); overflow-y:auto; padding:1rem; }
    .aic-foot { display:flex; gap:.5rem; padding:.75rem; background:#fff; border:1px solid #e2e8f0; border-top:0; border-radius:0 0 16px 16px; }
    .aic-foot textarea { flex:1; resize:none; border:1.5px solid #e2e8f0; border-radius:12px; padding:.55rem .8rem; font-size:.9rem; outline:none; max-height:120px; }
    .aic-foot textarea:focus { border-color:#4f46e5; }
    .aic-send { border:0; background:#4f46e5; color:#fff; border-radius:12px; padding:0 1.1rem; font-weight:700; cursor:pointer; }
    .aic-send:disabled { opacity:.5; cursor:not-allowed; }
    .msg { display:flex; margin-bottom:.85rem; gap:.5rem; align-items:flex-start; }
    .msg .av { width:30px;height:30px;border-radius:50%;flex:0 0 30px;display:flex;align-items:center;justify-content:center;font-size:.85rem; }
    .msg .col { display:flex; flex-direction:column; max-width:76%; min-width:0; }
    .msg .bub { padding:.55rem .85rem; border-radius:14px; font-size:.9rem; line-height:1.55;
                white-space:pre-wrap; overflow-wrap:break-word; word-break:normal; }
    .msg .bub strong { font-weight:700; }
    .msg .who { font-size:.7rem; color:#94a3b8; margin-bottom:2px; font-weight:700; }
    .msg.emp { flex-direction:row-reverse; }
    .msg.emp .col { align-items:flex-end; }
    .msg.emp .bub { background:#4f46e5; color:#fff; border-bottom-right-radius:4px; }
    .msg.ai  .av { background:#ede9fe; }
    .msg.ai  .bub { background:#fff; border:1px solid #e2e8f0; border-bottom-left-radius:4px; }
    .msg.ai.failed .bub { background:#fff7ed; border-color:#fed7aa; color:#9a3412; }
    .msg.csr .av { background:#dcfce7; }
    .msg.csr .bub { background:#f0fdf4; border:1px solid #bbf7d0; border-bottom-left-radius:4px; }
    .msg.csr .who { color:#15803d; }
    .msg.pending .bub { opacity:.65; }
    .aic-empty { text-align:center; color:#94a3b8; padding:2.5rem 1rem; font-size:.9rem; }
    .aic-typing { font-size:.8rem; color:#7c3aed; padding:.3rem .5rem; }
</style>
}

<div class="container-fluid py-4">
<div class="aic-wrap">
    @Html.AntiForgeryToken()
    <div class="aic-head">
        <div class="bot">🤖</div>
        <div style="flex:1">
            <h6>AI SAMHO - CSR</h6>
            <small>Hỏi nhanh — AI trả lời ngay, CSR sẽ hỗ trợ thêm nếu cần</small>
        </div>
        <button id="btnNew" class="btn btn-sm btn-light mb-0" style="font-weight:700" onclick="newThread()" title="Bắt đầu cuộc trò chuyện mới">
            <i class="bi bi-plus-lg"></i> Mới
        </button>
    </div>
    <div class="aic-body" id="aicBody">
        <div class="aic-empty" id="aicEmpty">Chưa có tin nhắn. Hãy đặt câu hỏi đầu tiên cho AI SAMHO - CSR 👇</div>
    </div>
    <div class="aic-typing" id="aicTyping" style="display:none;">AI đang trả lời…</div>
    <div class="aic-foot">
        <textarea id="aicInput" rows="1" placeholder="Nhập câu hỏi… (Enter để gửi)"></textarea>
        <button class="aic-send" id="aicSend" onclick="sendMsg()">Gửi</button>
    </div>
</div>
</div>

@section Scripts {
<script>
const EMPCD = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(empCd));
const TOKEN = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
let chatId = 0;
let lastMsgId = 0;
let sending = false;
let pollTimer = null;

function esc(s){return (s??'').toString().replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
// esc trước rồi mới đổi **đậm** -> <strong> (AI hay trả lời có markdown nhẹ)
function fmt(s){ return esc(s).replace(/\*\*([^*\n]+)\*\*/g, '<strong>$1</strong>'); }

function bubble(m){
    const t = m.senderType;
    const cls = (t === 'EMP' ? 'emp' : t === 'CSR' ? 'csr' : ('ai' + (m.aiFailed ? ' failed' : ''))) + (m.pending ? ' pending' : '');
    const av  = t === 'EMP' ? '🧑' : t === 'CSR' ? '🎧' : '🤖';
    const who = t === 'EMP' ? '' : t === 'CSR' ? `<div class="who">${esc(m.senderName) || 'Hỗ trợ CSR'}</div>` : `<div class="who">AI SAMHO - CSR</div>`;
    return `<div class="msg ${cls}">
        <div class="av">${av}</div>
        <div class="col">${who}<div class="bub">${fmt(m.content)}</div></div>
    </div>`;
}

function render(msgs, append){
    const body = document.getElementById('aicBody');
    const empty = document.getElementById('aicEmpty');
    if (msgs.length) { if (empty) empty.remove(); }
    const html = msgs.map(bubble).join('');
    if (append) body.insertAdjacentHTML('beforeend', html);
    else if (html) body.innerHTML = html;
    if (msgs.length) lastMsgId = Math.max(lastMsgId, ...msgs.filter(m => m.id > 0).map(m => m.id), lastMsgId);
    body.scrollTop = body.scrollHeight;
}

async function loadThread(){
    try {
        const r = await fetch('@Url.Action("MyThread","AiCsr")');
        const d = await r.json();
        if (!d.success) return;
        if (d.thread) { chatId = d.thread.chatId; }
        render(d.messages || [], false);
        if (chatId) { markRead(); startPoll(); }
    } catch {}
}

async function sendMsg(){
    if (sending) return;
    const ta = document.getElementById('aicInput');
    const q = ta.value.trim();
    if (!q) return;

    // Xoá ô nhập NGAY, trước mọi thao tác async (Brave/vài trình duyệt giữ lại text nếu clear
    // sau await); setTimeout để chắc chắn ăn sau default của phím Enter.
    ta.value = ''; ta.style.height = 'auto';
    setTimeout(() => { ta.value = ''; ta.style.height = 'auto'; }, 0);

    sending = true;
    document.getElementById('aicSend').disabled = true;
    document.getElementById('aicTyping').style.display = '';
    // Bubble NV tạm (pending) — không đụng lastMsgId, sẽ được thay bằng bản thật từ server.
    render([{ id: 0, senderType:'EMP', content:q, pending:true }], true);
    try {
        const r = await fetch('@Url.Action("Ask","AiCsr")', {
            method:'POST',
            headers:{'Content-Type':'application/json','RequestVerificationToken':TOKEN},
            body: JSON.stringify({ question: q })
        });
        const d = await r.json();
        // bỏ mọi bubble pending
        document.querySelectorAll('#aicBody .msg.pending').forEach(el => el.remove());
        if (!d.success) { restoreInput(q); showToast(d.message || 'Gửi thất bại', 'error'); }
        else {
            chatId = d.chatId;
            // chỉ thêm tin MỚI (id > lastMsgId) — không dựng lại cả khung
            const fresh = (d.messages || []).filter(m => m.id > lastMsgId);
            render(fresh, true);
            markRead(); startPoll();
        }
    } catch {
        document.querySelectorAll('#aicBody .msg.pending').forEach(el => el.remove());
        restoreInput(q);
        showToast('Lỗi kết nối', 'error');
    }
    finally {
        sending = false;
        document.getElementById('aicSend').disabled = false;
        document.getElementById('aicTyping').style.display = 'none';
    }
}

// Trả lại nội dung vào ô nhập khi gửi lỗi (chỉ khi ô đang trống — tránh đè text NV gõ tiếp).
function restoreInput(text){
    const ta = document.getElementById('aicInput');
    if (!ta.value) { ta.value = text; ta.style.height = 'auto'; ta.style.height = Math.min(ta.scrollHeight, 120) + 'px'; }
}

async function markRead(){
    if (!chatId) return;
    try { await fetch('@Url.Action("MarkRead","AiCsr")', {
        method:'POST', headers:{'Content-Type':'application/json','RequestVerificationToken':TOKEN},
        body: JSON.stringify({ chatId })
    }); } catch {}
}

function startPoll(){
    if (pollTimer) return;
    pollTimer = setInterval(async () => {
        if (!chatId || document.hidden) return;
        try {
            const r = await fetch(`@Url.Action("Messages","AiCsr")?chatId=${chatId}&afterMsgId=${lastMsgId}`);
            const d = await r.json();
            if (d.success && d.messages?.length) { render(d.messages, true); markRead(); }
        } catch {}
    }, 15000);
}

async function newThread(){
    showConfirm('Bắt đầu cuộc trò chuyện mới? Đoạn chat hiện tại vẫn được lưu lại.', async () => {
        try {
            await fetch('@Url.Action("NewThread","AiCsr")', {
                method:'POST', headers:{'Content-Type':'application/json','RequestVerificationToken':TOKEN}
            });
        } catch {}
        chatId = 0; lastMsgId = 0;
        document.getElementById('aicBody').innerHTML = '<div class="aic-empty" id="aicEmpty">Chưa có tin nhắn. Hãy đặt câu hỏi đầu tiên 👇</div>';
    }, { title:'Cuộc trò chuyện mới', okText:'Bắt đầu', okClass:'btn-primary', icon:'add_comment', iconColor:'#4f46e5', iconBg:'#eef2ff' });
}

const inp = document.getElementById('aicInput');
inp.addEventListener('input', () => { inp.style.height = 'auto'; inp.style.height = Math.min(inp.scrollHeight, 120) + 'px'; });
inp.addEventListener('keydown', e => {
    if (e.key === 'Enter' && !e.shiftKey && !e.isComposing && e.keyCode !== 229) {
        e.preventDefault();
        sendMsg();
    }
});

loadThread();
</script>
}
