@{
    ViewData["Title"] = "Xác nhận chấm công thiếu";
    var dateFrom = (string)(ViewBag.DateFrom ?? DateTime.Today.AddDays(-30).ToString("yyyy-MM-dd"));
    var dateTo   = (string)(ViewBag.DateTo   ?? DateTime.Today.ToString("yyyy-MM-dd"));
}

@section Styles {
<style>
    #attTableBody tr td { vertical-align: middle; }
    .pagination .page-link { cursor: pointer; border-radius: 8px !important; margin: 0 2px; }
    .pagination .page-item.disabled .page-link { cursor: default; }
    .att-save-chk { transform: scale(1.15); cursor: pointer; }
    .att-status-badge { font-size: .72rem; padding: 4px 8px; border-radius: 6px; font-weight: 600; }
    .att-time-input { width: 90px; display: inline-block; }
    @@media (max-width: 767px) {
        .container-fluid { padding-left: 8px !important; padding-right: 8px !important; }
    }
</style>
}

<div class="container-fluid py-4">
    <div class="card my-4">
        <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
            <div class="bg-gradient-success shadow-success border-radius-lg pt-3 pb-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h6 class="text-white mb-0"><i class="bi bi-clock-history me-1"></i> Xác nhận chấm công thiếu</h6>
                <div class="d-flex align-items-center flex-wrap gap-2">
                    <button type="button" id="requestBtn" class="btn btn-sm mb-0 text-nowrap" style="background:#fff;color:#166534;font-weight:600;height:34px;" disabled>
                        <i class="bi bi-bell me-1"></i> Gửi yêu cầu xác nhận<span id="selCountBadge" class="badge bg-danger ms-1" style="display:none;">0</span>
                    </button>
                    <button type="button" id="exportBtn" class="btn btn-sm mb-0 text-nowrap" style="background:#fff;color:#344767;font-weight:600;height:34px;">
                        <i class="bi bi-file-earmark-excel me-1"></i> Xuất Excel
                    </button>
                    <div class="d-flex align-items-center bg-white border-radius-md px-2 shadow-sm" style="height:34px;gap:4px;">
                        <i class="bi bi-calendar3 text-success"></i>
                        <input type="date" id="filterDateFrom" class="form-control form-control-sm border-0 bg-transparent text-dark p-0" style="width:115px;" value="@dateFrom" onchange="loadData(1)" />
                    </div>
                    <span class="text-white small">→</span>
                    <div class="d-flex align-items-center bg-white border-radius-md px-2 shadow-sm" style="height:34px;gap:4px;">
                        <i class="bi bi-calendar3 text-success"></i>
                        <input type="date" id="filterDateTo" class="form-control form-control-sm border-0 bg-transparent text-dark p-0" style="width:115px;" value="@dateTo" onchange="loadData(1)" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter bar -->
        <div class="px-3 pt-3 pb-2 d-flex flex-wrap align-items-end gap-2 filter-bar" style="background:#f8fafc;border-bottom:1px solid #e9ecef;">
            <div style="min-width:140px;flex:1 1 140px;max-width:180px;">
                <label class="form-label small fw-bold mb-1 text-primary">Mã NV</label>
                <input type="text" id="searchEmpcd" class="form-control form-control-sm" placeholder="🔍 Tìm mã NV..." />
            </div>
            <div style="min-width:150px;flex:2 1 150px;max-width:220px;">
                <label class="form-label small fw-bold mb-1 text-primary">Bộ Phận</label>
                <select id="filterDept" class="select2 form-control"
                        data-url="@Url.Action("GetDept", "Dropdown")"
                        data-placeholder="Tất cả"></select>
            </div>
            <div style="min-width:140px;flex:2 1 140px;max-width:200px;">
                <label class="form-label small fw-bold mb-1 text-primary">Line</label>
                <select id="filterLine" class="select2 form-control"
                        data-url="@Url.Action("GetLine", "Dropdown")"
                        data-parent="#filterDept"
                        data-placeholder="Tất cả"></select>
            </div>
            <div style="min-width:140px;flex:2 1 140px;max-width:200px;">
                <label class="form-label small fw-bold mb-1 text-primary">Nhóm Việc</label>
                <select id="filterWork" class="select2 form-control"
                        data-url="@Url.Action("GetWork", "Dropdown")"
                        data-parent="#filterLine"
                        data-parent-key="lineCd"
                        data-parent2="#filterDept"
                        data-parent2-key="deptCd"
                        data-placeholder="Tất cả"></select>
            </div>
            <div style="min-width:170px;flex:1 1 170px;max-width:210px;">
                <label class="form-label small fw-bold mb-1 text-primary">Trạng thái</label>
                <select id="filterStatus" class="form-select form-select-sm">
                    <option value="">Tất cả</option>
                    <option value="MISSING">Chưa gửi yêu cầu</option>
                    <option value="PENDING_WORKER">Chờ NV khai</option>
                    <option value="PENDING_MANAGER">Chờ quản lý xác nhận</option>
                    <option value="CONFIRMED">Đã xác nhận</option>
                    <option value="REJECTED">Bị từ chối</option>
                </select>
            </div>
            <div style="min-width:160px;flex:1 1 160px;max-width:200px;">
                <label class="form-label small fw-bold mb-1 text-primary">ERP thiếu</label>
                <select id="filterMissingType" class="form-select form-select-sm">
                    <option value="">Tất cả</option>
                    <option value="IN">Not Time In</option>
                    <option value="OUT">Not Time Out</option>
                    <option value="BOTH">Not In &amp; Out</option>
                </select>
            </div>
            <div class="d-flex align-items-end gap-2 ms-auto">
                <button type="button" id="clearFilterBtn" class="btn btn-outline-secondary btn-sm" title="Xóa bộ lọc"><i class="bi bi-x-circle"></i></button>
            </div>
        </div>

        <div class="card-body px-0 pb-2">
            <div id="summaryBar" class="d-flex flex-wrap gap-2 px-3 pb-2"></div>
            <div class="table-responsive px-3">
                <table class="table table-sm align-items-center mb-0">
                    <thead>
                        <tr>
                            <th class="text-center" style="width:36px;" data-mobile="hidden"><input type="checkbox" id="selectAllChk" title="Chọn tất cả trang này"></th>
                            <th class="text-xs text-secondary" data-mobile="hidden">#</th>
                            <th class="text-xs text-secondary" data-mobile="primary" data-mobile-slot="name" data-mobile-label="Mã NV / Tên">Mã NV / Tên</th>
                            <th class="text-xs text-secondary" data-mobile="primary" data-mobile-label="Ngày">Ngày</th>
                            <th class="text-xs text-secondary" data-mobile="detail" data-mobile-label="Bộ phận/Chuyền/Việc">Bộ phận / Chuyền / Nhóm việc</th>
                            <th class="text-xs text-secondary" data-mobile="primary" data-mobile-label="ERP thiếu">ERP thiếu</th>
                            <th class="text-xs text-secondary" data-mobile="primary" data-mobile-label="Trạng thái">Trạng thái</th>
                            <th class="text-xs text-secondary" data-mobile="detail" data-mobile-label="Giờ khai/Chốt">Giờ NV khai / Xác nhận</th>
                            <th class="text-xs text-secondary" data-mobile="detail" data-mobile-label="Ghi chú">Ghi chú</th>
                            <th class="text-xs text-secondary text-center" data-mobile="primary" data-mobile-label="Hành động">Hành động</th>
                        </tr>
                    </thead>
                    <tbody id="attTableBody"></tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center px-4 mt-3 mb-2">
                <div id="paginationCount" class="text-sm text-secondary"></div>
                <nav><ul class="pagination pagination-sm mb-0" id="paginationBar"></ul></nav>
            </div>
        </div>
    </div>
</div>

<!-- Modal xác nhận / từ chối -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title mb-0"><i class="bi bi-check2-circle me-1"></i> Xác nhận chấm công</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="cfConfirmId" />
                <div id="cfShiftInfo" class="text-xs text-secondary mb-2"></div>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label small fw-bold">Giờ vào</label>
                        <input type="time" id="cfTimeIn" class="form-control form-control-sm" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-bold">Giờ ra</label>
                        <input type="time" id="cfTimeOut" class="form-control form-control-sm" />
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label small fw-bold">Ghi chú</label>
                    <textarea id="cfNote" class="form-control form-control-sm" rows="2" maxlength="500" placeholder="Ghi chú (không bắt buộc)"></textarea>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-outline-danger" onclick="doConfirm('REJECTED')"><i class="bi bi-x-lg me-1"></i>Từ chối</button>
                <button type="button" class="btn btn-sm btn-success" onclick="doConfirm('CONFIRMED')"><i class="bi bi-check-lg me-1"></i>Xác nhận</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/vendor/xlsx.full.min.js" asp-append-version="true"></script>
<script src="~/js/xlsx-export-helper.js" asp-append-version="true"></script>
<script>
const LIST_URL    = '@Url.Action("GetList")';
const SUBMIT_URL  = '@Url.Action("SubmitWorker")';
const CONFIRM_URL = '@Url.Action("ManagerConfirm")';
const REQUEST_URL = '@Url.Action("RequestConfirm")';

let currentPage = 1, totalPages = 1, totalRecords = 0, pageSize = 50;
let canConfirmGlobal = false; // Admin/HR luôn false — chỉ quản lý đúng scope mới bấm Xác nhận được

const STATUS_LABEL = {
    MISSING: 'Chưa gửi yêu cầu', PENDING_WORKER: 'Chờ NV khai',
    PENDING_MANAGER: 'Chờ quản lý xác nhận', CONFIRMED: 'Đã xác nhận', REJECTED: 'Bị từ chối'
};
const STATUS_COLOR = {
    MISSING: '#94a3b8', PENDING_WORKER: '#f59e0b', PENDING_MANAGER: '#3b82f6', CONFIRMED: '#10b981', REJECTED: '#ef4444'
};
const MISSING_LABEL = { IN: 'Thiếu giờ vào', OUT: 'Thiếu giờ ra', BOTH: 'Thiếu cả vào/ra' };
const MISSING_COLOR = { IN: '#f59e0b', OUT: '#ef4444', BOTH: '#7c3aed' };

function escHtml(str) { return String(str==null?'':str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function formatDate(s) { if(!s) return '-'; const p = s.split('-'); return p.length===3 ? `${p[2]}/${p[1]}/${p[0]}` : s; }

function renderSummaryBar(summary) {
    const $bar = $('#summaryBar');
    if (!summary) { $bar.empty(); return; }
    const chips = [
        { label: 'Chưa gửi yêu cầu', val: summary.MISSING, color: STATUS_COLOR.MISSING },
        { label: 'Chờ NV khai', val: summary.PENDING_WORKER, color: STATUS_COLOR.PENDING_WORKER },
        { label: 'Chờ quản lý xác nhận', val: summary.PENDING_MANAGER, color: STATUS_COLOR.PENDING_MANAGER },
        { label: 'Đã xác nhận', val: summary.CONFIRMED, color: STATUS_COLOR.CONFIRMED },
    ];
    $bar.html(chips.map(c => `<span class="att-status-badge" style="background:${c.color}22;color:${c.color};">${c.label}: <strong>${c.val || 0}</strong></span>`).join(''));
}

function buildRow(item, idx) {
    const rowKey = `${item.EMPCD}__${item.WORK_DATE}`;
    const deptLine = [item.DEPT_NAME, item.LINE_NAME, item.WORK_NAME].filter(Boolean).map(escHtml).join('<br>');
    const status = item.CONFIRM_STATUS || 'MISSING';
    const canRequest = status === 'MISSING';
    const canConfirm = status === 'PENDING_MANAGER' && canConfirmGlobal;

    let actionHtml = '-';
    const shiftInfo = item.SHIFT_STIME ? `${escHtml(item.SHIFT_CD || '')} (${item.SHIFT_STIME} - ${item.SHIFT_ETIME || '?'})${item.IS_NIGHT_SHIFT ? ' · ca đêm' : ''}` : (item.SHIFT_CD || '');
    if (canConfirm) {
        actionHtml = `<button type="button" class="btn btn-sm btn-outline-success"
                data-confirm-id="${item.CONFIRM_ID}" data-time-in="${escHtml(item.WORKER_TIME_IN || '')}" data-time-out="${escHtml(item.WORKER_TIME_OUT || '')}"
                data-shift-info="${escHtml(shiftInfo)}" data-worker-note="${escHtml(item.WORKER_NOTE || '')}"
                onclick="event.stopPropagation(); openConfirmModal(this)">
            <i class="bi bi-check2-circle"></i> Xác nhận</button>`;
    } else if (status === 'PENDING_WORKER') {
        actionHtml = `<span class="text-xs text-warning"><i class="bi bi-hourglass-split"></i> Đang chờ NV</span>`;
    } else if (status === 'PENDING_MANAGER') {
        actionHtml = `<span class="text-xs text-primary"><i class="bi bi-hourglass-split"></i> Đang chờ quản lý xác nhận</span>`;
    } else if (status === 'CONFIRMED') {
        actionHtml = `<span class="text-xs text-success"><i class="bi bi-check-circle"></i> <span class="vni-font">${escHtml(item.CONFIRMED_BY_NAME || '')}</span> (${escHtml(item.CONFIRMED_BY || '')})</span>`;
    } else if (status === 'REJECTED') {
        actionHtml = `<span class="text-xs text-danger"><i class="bi bi-x-circle"></i> Đã từ chối</span>`;
    }

    return `<tr data-row-key="${escHtml(rowKey)}">
        <td class="text-center"><input type="checkbox" class="att-save-chk" data-empcd="${escHtml(item.EMPCD)}" data-workdate="${escHtml(item.WORK_DATE)}" ${canRequest ? '' : 'disabled'} onchange="updateSelCount()"></td>
        <td class="text-xs text-secondary">${idx}</td>
        <td>
            <div class="text-xs text-secondary">${escHtml(item.EMPCD)}</div>
            <div class="text-sm vni-font fw-bold">${escHtml(item.EMP_NAME)}</div>
        </td>
        <td class="text-sm text-nowrap">${formatDate(item.WORK_DATE)}</td>
        <td class="text-xxs vni-font text-secondary" style="line-height:1.3;">
            <div style="max-width:170px;overflow-wrap:break-word;word-break:break-word;">${deptLine}</div>
        </td>
        <td class="text-xs">
            <span class="badge" style="background:${MISSING_COLOR[item.MISSING_TYPE] || '#ef4444'};">${MISSING_LABEL[item.MISSING_TYPE] || item.MISSING_TYPE}</span>
            <div class="text-xxs text-secondary mt-1">ERP: ${item.ERP_TIME_IN || '--:--'} → ${item.ERP_TIME_OUT || '--:--'}</div>
            ${shiftInfo ? `<div class="text-xxs text-secondary">Ca: ${shiftInfo}</div>` : ''}
        </td>
        <td><span class="att-status-badge" style="background:${STATUS_COLOR[status]}22;color:${STATUS_COLOR[status]};">${STATUS_LABEL[status] || status}</span></td>
        <td class="text-xs">
            ${item.WORKER_TIME_IN ? `NV: ${item.WORKER_TIME_IN} → ${item.WORKER_TIME_OUT || '--:--'}<br>` : ''}
            ${item.CONFIRM_TIME_IN ? `<span class="text-success">Chốt: ${item.CONFIRM_TIME_IN} → ${item.CONFIRM_TIME_OUT || '--:--'}</span>` : ''}
        </td>
        <td class="text-xxs text-secondary">
            <div style="max-width:150px;overflow-wrap:break-word;word-break:break-word;white-space:normal;">
                ${item.WORKER_NOTE ? `<div>NV: ${escHtml(item.WORKER_NOTE)}</div>` : ''}
                ${item.NOTE ? `<div class="text-success">QL: ${escHtml(item.NOTE)}</div>` : ''}
            </div>
        </td>
        <td class="text-center">${actionHtml}</td>
    </tr>`;
}

function openConfirmModal(btn) {
    $('#cfConfirmId').val(btn.dataset.confirmId);
    $('#cfTimeIn').val(btn.dataset.timeIn || '');
    $('#cfTimeOut').val(btn.dataset.timeOut || '');
    $('#cfNote').val('');
    let infoHtml = btn.dataset.shiftInfo ? `<i class="bi bi-clock"></i> Ca: ${escHtml(btn.dataset.shiftInfo)}` : '';
    if (btn.dataset.workerNote) infoHtml += `<div class="mt-1"><i class="bi bi-chat-left-text"></i> NV ghi chú: ${escHtml(btn.dataset.workerNote)}</div>`;
    $('#cfShiftInfo').html(infoHtml);
    new bootstrap.Modal(document.getElementById('confirmModal')).show();
}

async function doConfirm(status) {
    const payload = {
        CONFIRM_ID: parseInt($('#cfConfirmId').val()),
        TIME_IN: $('#cfTimeIn').val(),
        TIME_OUT: $('#cfTimeOut').val(),
        NOTE: $('#cfNote').val(),
        STATUS: status
    };
    try {
        const res = await $.ajax({ url: CONFIRM_URL, type: 'POST', contentType: 'application/json', data: JSON.stringify(payload) });
        if (res.success) {
            bootstrap.Modal.getInstance(document.getElementById('confirmModal'))?.hide();
            showToast(res.message || 'Đã cập nhật', 'success');
            loadData(currentPage);
        } else showToast(res.message || 'Lỗi', 'error');
    } catch (e) { showToast('Lỗi kết nối', 'error'); }
}

function updateSelCount() {
    const n = $('#attTableBody .att-save-chk:checked').length;
    $('#requestBtn').prop('disabled', n === 0);
    $('#selCountBadge').toggle(n > 0).text(n);
}

$('#requestBtn').on('click', async function () {
    const targets = $('#attTableBody .att-save-chk:checked').map((_, el) => ({ EMPCD: $(el).data('empcd'), WORK_DATE: $(el).data('workdate') })).get();
    if (!targets.length) return;
    const $btn = $(this).prop('disabled', true);
    try {
        const res = await $.ajax({ url: REQUEST_URL, type: 'POST', contentType: 'application/json', data: JSON.stringify(targets) });
        showToast(res.message || 'Đã xử lý', res.failed > 0 ? 'warning' : 'success');
        loadData(currentPage);
    } catch (e) { showToast('Lỗi kết nối', 'error'); }
    finally { $btn.prop('disabled', false); }
});

$('#selectAllChk').on('change', function () {
    const checked = this.checked;
    $('#attTableBody .att-save-chk:not(:disabled)').prop('checked', checked);
    updateSelCount();
});

function getParams(page) {
    return {
        date_from: $('#filterDateFrom').val(), date_to: $('#filterDateTo').val(),
        search: ($('#searchEmpcd').val() || '').trim(),
        dept_id: $('#filterDept').val(), line_id: $('#filterLine').val(), work_id: $('#filterWork').val(),
        status: $('#filterStatus').val(),
        missing_type: $('#filterMissingType').val(),
        page, page_size: pageSize
    };
}

function loadData(page = 1) {
    currentPage = page;
    $('#attTableBody').html(`<tr><td colspan="10" class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></td></tr>`);
    MobileTableHelper.refresh('attTableBody');
    $.ajax({
        url: LIST_URL, type: 'GET', data: getParams(page),
        success: function (res) {
            if (!res.success) {
                $('#attTableBody').html(`<tr><td colspan="10" class="text-center text-danger py-4">Lỗi: ${escHtml(res.message||'')}</td></tr>`);
                MobileTableHelper.refresh('attTableBody');
                return;
            }
            totalRecords = res.total || 0;
            totalPages   = res.total_pages || 0;
            canConfirmGlobal = !!res.can_confirm;
            const rows   = res.data || [];
            renderSummaryBar(res.summary);
            if (!rows.length) {
                $('#attTableBody').html(`<tr><td colspan="10" class="text-center text-secondary py-4">Không có dữ liệu</td></tr>`);
            } else {
                $('#attTableBody').html(rows.map((r,i) => buildRow(r,(page-1)*pageSize+i+1)).join(''));
            }
            MobileTableHelper.refresh('attTableBody');
            updateSelCount();
            renderPagination();
        },
        error: function (xhr) {
            $('#attTableBody').html(`<tr><td colspan="10" class="text-center text-danger py-4">Lỗi kết nối (${xhr.status})</td></tr>`);
            MobileTableHelper.refresh('attTableBody');
        }
    });
}

function renderPagination() {
    if (!totalRecords) { $('#paginationCount').text(''); $('#paginationBar').empty(); return; }
    const s = (currentPage-1)*pageSize+1, e = Math.min(currentPage*pageSize, totalRecords);
    $('#paginationCount').html(`<span class="text-xs">${s}-${e} / <strong>${totalRecords}</strong> dòng</span>`);
    const $bar = $('#paginationBar').empty();
    const mk = (label,p,disabled,active) => {
        const li = $('<li class="page-item">').toggleClass('disabled', !!disabled).toggleClass('active', !!active);
        $('<a class="page-link">').html(label).on('click', () => { if (!disabled && !active) loadData(p); }).appendTo(li);
        return li;
    };
    $bar.append(mk('&lsaquo;', currentPage-1, currentPage<=1));
    let from = Math.max(1, currentPage-2), to = Math.min(totalPages, currentPage+2);
    for (let p=from; p<=to; p++) $bar.append(mk(p, p, false, p===currentPage));
    $bar.append(mk('&rsaquo;', currentPage+1, currentPage>=totalPages));
}

$('#filterDept').on('change', function () { $('#filterLine, #filterWork').val(null).trigger('change.select2'); loadData(1); });
$('#filterLine').on('change', function () { $('#filterWork').val(null).trigger('change.select2'); loadData(1); });
$('#filterWork, #filterStatus, #filterMissingType').on('change', () => loadData(1));
let searchTimeout;
$('#searchEmpcd').on('input', function () { clearTimeout(searchTimeout); searchTimeout = setTimeout(() => loadData(1), 400); });
$('#clearFilterBtn').on('click', function () {
    $('#searchEmpcd').val('');
    $('#filterDept, #filterLine, #filterWork').val(null).trigger('change.select2');
    $('#filterStatus').val('');
    $('#filterMissingType').val('');
    loadData(1);
});

$('#exportBtn').on('click', async function () {
    const $btn = $(this), orig = $btn.html();
    $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Đang xuất...');
    try {
        let rows = [], pg = 1, pgTotal = 1;
        do {
            const p = getParams(pg); p.page_size = 1000;
            const res = await $.getJSON(LIST_URL, p);
            if (!res || !res.success) break;
            pgTotal = res.total_pages; rows = rows.concat(res.data || []);
            pg++;
        } while (pg <= pgTotal);
        if (!rows.length) { showToast('Không có dữ liệu để xuất', 'warning'); return; }
        const headers = ['STT', 'Mã NV', 'Họ Tên', 'Ngày', 'Bộ phận', 'Chuyền', 'Nhóm việc', 'ERP giờ vào', 'ERP giờ ra', 'Trạng thái', 'Giờ NV khai vào', 'Giờ NV khai ra', 'Giờ chốt vào', 'Giờ chốt ra', 'Ghi chú', 'Người xác nhận', 'Ngày xác nhận'];
        let html = '<html><head><meta charset="utf-8"/></head><body><table border="1"><thead><tr>';
        html += headers.map(h => `<th style="background:#bbf7d0;font-weight:bold">${h}</th>`).join('') + '</tr></thead><tbody>';
        rows.forEach((r, i) => {
            html += `<tr><td>${i + 1}</td><td data-t="s">${escHtml(r.EMPCD)}</td><td>${escHtml(r.EMP_NAME||'')}</td><td>${formatDate(r.WORK_DATE)}</td>` +
                `<td>${escHtml(r.DEPT_NAME||'')}</td><td>${escHtml(r.LINE_NAME||'')}</td><td>${escHtml(r.WORK_NAME||'')}</td>` +
                `<td>${escHtml(r.ERP_TIME_IN||'')}</td><td>${escHtml(r.ERP_TIME_OUT||'')}</td>` +
                `<td>${escHtml(STATUS_LABEL[r.CONFIRM_STATUS||'MISSING']||'')}</td>` +
                `<td>${escHtml(r.WORKER_TIME_IN||'')}</td><td>${escHtml(r.WORKER_TIME_OUT||'')}</td>` +
                `<td>${escHtml(r.CONFIRM_TIME_IN||'')}</td><td>${escHtml(r.CONFIRM_TIME_OUT||'')}</td>` +
                `<td>${escHtml(r.NOTE||'')}</td><td>${escHtml(r.CONFIRMED_BY||'')}</td><td>${escHtml(r.CONFIRMED_DATE||'')}</td></tr>`;
        });
        html += '</tbody></table></body></html>';
        exportHtmlTableToXlsx(html, `AttendanceConfirm_${$('#filterDateFrom').val()}_${$('#filterDateTo').val()}.xlsx`);
    } catch (err) { showToast('Lỗi xuất file: ' + err.message, 'error'); }
    finally { $btn.prop('disabled', false).html(orig); }
});

$(function () {
    if (typeof Select2Helper !== 'undefined') Select2Helper.init();
    if (typeof MobileTableHelper !== 'undefined') MobileTableHelper.init('attTableBody');
    loadData(1);
});
</script>
}
