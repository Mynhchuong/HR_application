@model HR_web.Models.Bulletin.BulletinModel
@{
    ViewData["Title"] = Model.TITLE;
    bool isHrAdmin = ViewBag.IsHrAdmin is bool b && b;
    var user      = ViewBag.CurrentUser as HR_web.Models.Account.UserInfoModel;
    bool isUpdated = Model.UPDT_DT.HasValue && Model.INST_DT.HasValue
                   && (Model.UPDT_DT.Value - Model.INST_DT.Value).TotalMinutes > 1;
    var videos = Model.MEDIA.Where(m => m.MEDIA_TYPE == "VIDEO").OrderBy(m => m.DISPLAY_ORDER).ToList();

    // Reaction config
    var reactionMap = new Dictionary<string, string>
    {
        { "LIKE",  "👍" },
        { "LOVE",  "❤️" },
        { "HAHA",  "😆" },
        { "WOW",   "😮" },
        { "SAD",   "😢" },
        { "ANGRY", "😡" },
    };
    int GetCount(string k) => Model.REACTIONS.FirstOrDefault(r => r.REACTION == k)?.CNT ?? 0;
}

@section Styles {
<style>
    .bd-container { max-width: 820px; margin: 0 auto; padding: 16px 14px 120px; }

    .bd-cover { width: 100%; max-height: 360px; object-fit: cover; border-radius: 12px; margin-bottom: 16px; }
    .bd-title { font-size: 1.55rem; font-weight: 800; color: #111827; line-height: 1.3; margin-bottom: 6px; }
    .bd-meta  { color: #6b7280; font-size: .82rem; margin-bottom: 14px; display: flex; gap: 14px; flex-wrap: wrap; }

    .bd-updated-banner {
        background: #fef3c7; color: #92400e;
        padding: 8px 12px; border-radius: 8px;
        font-size: .82rem; font-weight: 600;
        display: flex; align-items: center; gap: 6px;
        margin-bottom: 16px;
    }

    .bd-content { font-size: 1rem; line-height: 1.7; color: #1f2937; }
    .bd-content img { max-width: 100%; height: auto; border-radius: 8px; margin: 10px 0; display: block; }

    .img-dl-btn {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 6px 14px; border-radius: 8px;
        background: #f59e0b; color: #fff; border: none;
        font-size: .85rem; font-weight: 600;
        cursor: pointer; text-decoration: none;
        margin: 4px 0 14px;
    }
    .img-dl-btn:hover { background: #d97706; color: #fff; }
    .bd-content h1, .bd-content h2, .bd-content h3 { margin-top: 1.2rem; }
    .bd-content ul, .bd-content ol { padding-left: 1.5rem; }

    .video-block { margin: 16px 0; }
    .video-block video { width: 100%; border-radius: 10px; background: #000; }

    /* ─── Reaction bar ─── */
    .reaction-bar {
        display: flex; gap: 8px; flex-wrap: wrap;
        padding: 14px 0; margin: 18px 0;
        border-top: 1px solid #e5e7eb;
        border-bottom: 1px solid #e5e7eb;
    }
    .reaction-btn {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 6px 12px; border-radius: 999px;
        border: 1.5px solid #e5e7eb; background: #fff;
        cursor: pointer; font-size: .95rem;
        transition: all .15s;
    }
    .reaction-btn:hover { background: #f3f4f6; transform: scale(1.05); }
    .reaction-btn.active {
        background: #fef3c7; border-color: #f59e0b; color: #92400e; font-weight: 700;
    }
    .reaction-btn .cnt { font-size: .8rem; color: #6b7280; min-width: 16px; text-align: center; }
    .reaction-btn.active .cnt { color: #92400e; }

    /* ─── Comments ─── */
    .cmt-section { margin-top: 24px; }
    .cmt-heading { font-weight: 700; color: #111827; font-size: 1rem; margin-bottom: 14px; }
    .cmt-item {
        background: #f9fafb; border-radius: 10px;
        padding: 10px 14px; margin-bottom: 10px;
        position: relative;
    }
    .cmt-header {
        display: flex; align-items: baseline; gap: 6px;
        font-size: .82rem; margin-bottom: 4px;
    }
    .cmt-empcd { font-weight: 700; color: #111827; }
    .cmt-name  { color: #374151; font-weight: 600; }
    .cmt-meta  { color: #9ca3af; font-size: .75rem; }
    .cmt-content { font-size: .95rem; color: #1f2937; line-height: 1.5; white-space: pre-wrap; }
    .cmt-time  { font-size: .72rem; color: #9ca3af; margin-top: 4px; }
    .cmt-delete {
        position: absolute; top: 8px; right: 10px;
        background: transparent; border: none; cursor: pointer;
        color: #9ca3af; font-size: .85rem;
    }
    .cmt-delete:hover { color: #ef4444; }
    .cmt-empty { text-align: center; color: #9ca3af; padding: 20px; font-size: .9rem; }

    /* ─── Sticky input bar ─── */
    .cmt-input-bar {
        position: fixed; bottom: 0; left: 0; right: 0;
        background: #fff; border-top: 1px solid #e5e7eb;
        padding: 10px 14px; display: flex; gap: 8px; align-items: flex-end;
        z-index: 50; max-width: 820px; margin: 0 auto;
        box-shadow: 0 -4px 16px rgba(0,0,0,.06);
    }
    .cmt-input {
        flex: 1; resize: none; border: 1.5px solid #d1d5db;
        border-radius: 18px; padding: 8px 14px; font-size: .95rem;
        max-height: 100px; min-height: 38px; line-height: 1.4;
        outline: none;
    }
    .cmt-input:focus { border-color: #f59e0b; box-shadow: 0 0 0 3px rgba(245,158,11,.12); }
    .cmt-send-btn {
        background: #f59e0b; color: #fff; border: none;
        border-radius: 50%; width: 38px; height: 38px;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer; flex-shrink: 0;
    }
    .cmt-send-btn:hover { background: #d97706; }
    .cmt-send-btn:disabled { background: #d1d5db; cursor: not-allowed; }

    @@media (max-width: 768px) {
        .bd-title { font-size: 1.3rem; }
    }
</style>
}

@Html.AntiForgeryToken()

<div class="bd-container">
    <img src="@(string.IsNullOrEmpty(Model.COVER_IMG)
                ? Url.Content("~/assets/img/bulletin-default-cover.png")
                : Url.Action("GetBulletinImage", "Image", new { fileName = Model.COVER_IMG }))"
         class="bd-cover" alt="cover" />

    <h1 class="bd-title">@Model.TITLE</h1>
    <div class="bd-meta">
        <span><i class="bi bi-calendar3 me-1"></i>đến hết @Model.PUBLISH_TO.ToString("dd/MM/yyyy")</span>
        <span><i class="bi bi-eye me-1"></i>@Model.VIEW_COUNT lượt xem</span>
    </div>

    @if (isUpdated && !string.IsNullOrEmpty(Model.UPDT_FULL_NAME))
    {
        <div class="bd-updated-banner">
            <i class="bi bi-pencil-square"></i>
            Được cập nhật bởi <strong>@Model.UPDT_FULL_NAME</strong> lúc @Model.UPDT_DT?.ToString("HH:mm dd/MM/yyyy")
        </div>
    }

    <div class="bd-content">
        @Html.Raw(Model.CONTENT)
    </div>

    @foreach (var v in videos)
    {
        <div class="video-block">
            <video controls preload="metadata">
                <source src="@Url.Action("Stream", "Video", new { folder = "BULLETIN_VIDEO", id = v.ID })" />
            </video>
        </div>
    }

    <!-- Reaction bar -->
    <div class="reaction-bar">
        @foreach (var (key, emoji) in reactionMap)
        {
            <button type="button" class="reaction-btn @(Model.MY_REACTION == key ? "active" : "")"
                    data-reaction="@key" onclick="toggleReaction('@key', this)">
                <span>@emoji</span>
                <span class="cnt">@GetCount(key)</span>
            </button>
        }
    </div>

    <!-- Comments -->
    <div class="cmt-section">
        <div class="cmt-heading">
            <i class="bi bi-chat-square-text me-1"></i>
            Bình luận (<span id="cmtCount">@Model.COMMENT_COUNT</span>)
        </div>
        <div id="cmtList">
            <div class="cmt-empty"><i class="bi bi-hourglass-split"></i> Đang tải...</div>
        </div>
    </div>
</div>

<!-- Sticky comment input -->
<div class="cmt-input-bar">
    <textarea id="cmtInput" class="cmt-input" placeholder="Viết bình luận..." maxlength="1000" rows="1"
              oninput="autoResize(this)"></textarea>
    <button id="cmtSendBtn" class="cmt-send-btn" onclick="sendComment()" title="Gửi">
        <i class="bi bi-send-fill"></i>
    </button>
</div>

@section Scripts {
<script>
    const BULLETIN_ID = @Model.ID;
    const CURRENT_EMPCD = '@(user?.EmpCd ?? "")';
    const IS_HR_ADMIN = @(isHrAdmin ? "true" : "false");
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

    function escapeHtml(s) {
        return (s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function fmtTime(dateStr) {
        const d = new Date(dateStr);
        return d.toLocaleString('vi-VN', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit', hour12:false });
    }

    function autoResize(el) {
        el.style.height = 'auto';
        el.style.height = Math.min(el.scrollHeight, 100) + 'px';
    }

    // ── Load comments ──
    async function loadComments() {
        try {
            const res = await fetch('@Url.Action("Comments", "Bulletin")/' + BULLETIN_ID);
            const data = await res.json();
            renderComments(data.data || []);
        } catch (e) {
            document.getElementById('cmtList').innerHTML = '<div class="cmt-empty">Không tải được bình luận.</div>';
        }
    }

    function renderComments(items) {
        const list = document.getElementById('cmtList');
        document.getElementById('cmtCount').textContent = items.length;
        if (items.length === 0) {
            list.innerHTML = '<div class="cmt-empty">Chưa có bình luận. Hãy là người đầu tiên!</div>';
            return;
        }
        list.innerHTML = items.map(c => {
            const canDelete = IS_HR_ADMIN || c.EMPCD === CURRENT_EMPCD;
            const displayName = c.FULL_NAME || c.EMP_CNAME || '';
            const meta = [c.DEPT_NAME, c.LINE_NAME, c.WORK_NAME].filter(Boolean).join(' / ');
            return `
                <div class="cmt-item" data-id="${c.ID}">
                    ${canDelete ? `<button class="cmt-delete" onclick="deleteComment(${c.ID})" title="Xóa"><i class="bi bi-trash"></i></button>` : ''}
                    <div class="cmt-header">
                        <span class="cmt-name vni-font">${escapeHtml(displayName)}</span>
                        <span class="cmt-empcd">#${escapeHtml(c.EMPCD)}</span>
                        ${meta ? `<span class="cmt-meta">— ${escapeHtml(meta)}</span>` : ''}
                    </div>
                    <div class="cmt-content">${escapeHtml(c.CONTENT)}</div>
                    <div class="cmt-time">${fmtTime(c.INST_DT)}</div>
                </div>`;
        }).join('');
    }

    // ── Send comment ──
    async function sendComment() {
        const input = document.getElementById('cmtInput');
        const content = input.value.trim();
        if (!content) return;
        const btn = document.getElementById('cmtSendBtn');
        btn.disabled = true;
        try {
            const fd = new FormData();
            fd.append('bulletinId', BULLETIN_ID);
            fd.append('content', content);
            fd.append('__RequestVerificationToken', token);
            const res = await fetch('@Url.Action("AddComment", "Bulletin")', { method: 'POST', body: fd });
            const data = await res.json();
            if (data.success) {
                input.value = '';
                autoResize(input);
                await loadComments();
            } else {
                alert(data.message || 'Lỗi gửi bình luận');
            }
        } catch (e) {
            alert('Lỗi kết nối: ' + e.message);
        } finally {
            btn.disabled = false;
        }
    }

    // ── Delete comment ──
    async function deleteComment(id) {
        if (!confirm('Xóa bình luận này?')) return;
        const fd = new FormData();
        fd.append('id', id);
        fd.append('__RequestVerificationToken', token);
        const res = await fetch('@Url.Action("DeleteComment", "Bulletin")', { method: 'POST', body: fd });
        const data = await res.json();
        if (data.success) {
            await loadComments();
        } else {
            alert(data.message || 'Lỗi xóa');
        }
    }

    // ── React ──
    async function toggleReaction(reaction, btnEl) {
        const fd = new FormData();
        fd.append('bulletinId', BULLETIN_ID);
        fd.append('reaction', reaction);
        fd.append('__RequestVerificationToken', token);
        const res = await fetch('@Url.Action("React", "Bulletin")', { method: 'POST', body: fd });
        const data = await res.json();
        if (!data.success) {
            alert(data.message || 'Lỗi');
            return;
        }
        // Update UI inline
        const cntEl = btnEl.querySelector('.cnt');
        let cnt = parseInt(cntEl.textContent) || 0;
        const wasActive = btnEl.classList.contains('active');

        // Bỏ active các nút khác (1 emp = 1 reaction)
        document.querySelectorAll('.reaction-btn').forEach(b => {
            if (b !== btnEl && b.classList.contains('active')) {
                b.classList.remove('active');
                const otherCnt = b.querySelector('.cnt');
                otherCnt.textContent = Math.max(0, parseInt(otherCnt.textContent) - 1);
            }
        });

        if (data.action === 'added' || data.action === 'changed') {
            btnEl.classList.add('active');
            if (!wasActive) cnt++;
            cntEl.textContent = cnt;
        } else if (data.action === 'removed') {
            btnEl.classList.remove('active');
            cntEl.textContent = Math.max(0, cnt - 1);
        }
    }

    // ── Download image (mọi ảnh trong nội dung) ──
    async function downloadImg(src, filename) {
        try {
            const res = await fetch(src, { credentials: 'same-origin' });
            if (!res.ok) throw new Error('HTTP ' + res.status);
            const blob = await res.blob();
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = filename || ('bulletin-' + BULLETIN_ID + '.jpg');
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            setTimeout(() => URL.revokeObjectURL(url), 1000);
        } catch (e) {
            // Fallback: mở ảnh tab mới để user long-press lưu
            window.open(src, '_blank');
        }
    }

    // Tự động chèn nút tải dưới mỗi ảnh trong nội dung
    document.querySelectorAll('.bd-content img').forEach((img, i) => {
        const btn = document.createElement('a');
        btn.href = '#';
        btn.className = 'img-dl-btn';
        btn.innerHTML = '<i class="bi bi-download"></i> Tải ảnh';
        btn.onclick = (e) => {
            e.preventDefault();
            const url = img.getAttribute('src');
            const name = (url.split('/').pop() || '').split('?')[0] || ('bulletin-' + BULLETIN_ID + '-' + (i+1) + '.jpg');
            downloadImg(url, name);
        };
        img.insertAdjacentElement('afterend', btn);
    });

    // Initial load
    loadComments();

    // Enter to send (Shift+Enter newline)
    document.getElementById('cmtInput').addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            sendComment();
        }
    });
</script>
}
