@model HR_web.Models.Bulletin.BulletinModel
@{
    bool isHrAdmin = ViewBag.IsHrAdmin is bool b && b;
    var user      = ViewBag.CurrentUser as HR_web.Models.Account.UserInfoModel;
    // NV nước ngoài đọc bản tiếng Anh (TITLE_EN/CONTENT_EN) — xem BulletinModel.TitleFor.
    var bLang     = user?.UiLang ?? "vi";
    // D(vi, en): NV nước ngoài thấy tiếng của họ, NV Việt giữ nguyên tiếng Việt như cũ.
    // DJ(...) dùng TRONG <script> — xuất ra JSON literal nên an toàn với dấu nháy/& .
    Func<string, string, string> D = (vi, en) => HR_web.Helpers.ExpatText.Dual(bLang, vi, en);
    Func<string, string, Microsoft.AspNetCore.Html.IHtmlContent> DJ = (vi, en) =>
        new Microsoft.AspNetCore.Html.HtmlString(
            System.Text.Json.JsonSerializer.Serialize(HR_web.Helpers.ExpatText.Dual(bLang, vi, en)));
    ViewData["Title"] = Model.TitleFor(bLang);
    bool isUpdated = Model.UPDT_DT.HasValue && Model.INST_DT.HasValue
                   && (Model.UPDT_DT.Value - Model.INST_DT.Value).TotalMinutes > 1;
    var videos = Model.MEDIA.Where(m => m.MEDIA_TYPE == "VIDEO").OrderBy(m => m.DISPLAY_ORDER).ToList();

    // Reaction config
    string pacmanImg = $"<img src=\"{Url.Content("~/assets/img/reaction-pacman.png")}\" alt=\"pacman\" style=\"width:22px;height:22px;vertical-align:-5px;\" />";
    var reactionMap = new Dictionary<string, string>
    {
        { "LIKE",   "👍" },
        { "LOVE",   "❤️" },
        { "HAHA",   "😆" },
        { "WOW",    "😮" },
        { "SAD",    "😢" },
        { "ANGRY",  "😡" },
        { "PACMAN", pacmanImg },
    };
    int GetCount(string k) => Model.REACTIONS.FirstOrDefault(r => r.REACTION == k)?.CNT ?? 0;
    // Phòng đăng bài (HR/CSR/Lean) — API tính theo role người tạo
    string roleKey = Model.CREATED_ROLE is "CSR" or "Lean" ? Model.CREATED_ROLE! : "HR";
}

@section Styles {
<style>
    .bd-container { max-width: 820px; margin: 0 auto; padding: 10px 14px 150px; }

    .bd-back-row { max-width: 820px; margin: 0 auto; padding: 10px 14px 0; }
    .bd-back-btn {
        width: 36px; height: 36px; border-radius: 10px;
        background: #fff; border: 1.5px solid #fde68a;
        display: inline-flex; align-items: center; justify-content: center;
        color: #92400e; text-decoration: none; box-shadow: 0 1px 3px rgba(0,0,0,.06);
        -webkit-tap-highlight-color: transparent; transition: background .15s;
    }
    .bd-back-btn:hover, .bd-back-btn:active { background: #fef3c7; color: #92400e; }

    /* Ảnh bìa thường là infographic → hiện ĐỦ ảnh (contain), không cắt mất chữ */
    .bd-cover { width: 100%; max-height: 70vh; object-fit: contain; background: #f3f4f6; border-radius: 12px; margin-bottom: 14px; display: block; }
    .bd-tags { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; flex-wrap: wrap; }
    .bd-tag { font-size: .72rem; font-weight: 800; padding: 3px 9px; border-radius: 6px; }
    .bd-tag.HR   { background: #fef3c7; color: #92400e; }
    .bd-tag.CSR  { background: #dcfce7; color: #166534; }
    .bd-tag.Lean { background: #ede9fe; color: #5b21b6; }
    .bd-title { font-size: clamp(1.15rem, 4.5vw, 1.55rem); font-weight: 700; color: #111827; line-height: 1.4; margin-bottom: 6px; }
    .bd-meta  { color: #6b7280; font-size: .82rem; margin-bottom: 14px; display: flex; gap: 14px; flex-wrap: wrap; }

    .bd-updated-banner {
        color: #92400e; font-size: .78rem; font-weight: 600;
        margin: -2px 0 12px;
    }

    .bd-content { font-size: 1rem; line-height: 1.65; color: #1f2937; overflow-wrap: anywhere; }
    /* HR hay dán nội dung "căn đều" + tiêu đề to từ Word → trên điện thoại chữ giãn cách xấu và quá to.
       Ép căn trái + cỡ tiêu đề vừa phải cho dễ đọc. */
    .bd-content, .bd-content * { text-align: left !important; }
    .bd-content h1 { font-size: 1.2rem !important; }
    .bd-content h2 { font-size: 1.1rem !important; }
    .bd-content h3, .bd-content h4 { font-size: 1.02rem !important; }
    .bd-content h1, .bd-content h2, .bd-content h3, .bd-content h4 { font-weight: 800; line-height: 1.4; margin: 1.1rem 0 .4rem; color: #111827; }
    .bd-content p { margin-bottom: .6rem; }
    .bd-content img { max-width: 100%; height: auto; border-radius: 8px; margin: 10px 0; display: block; }

    .img-dl-btn {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 6px 14px; border-radius: 8px;
        background: #f59e0b; color: #fff; border: none;
        font-size: .85rem; font-weight: 600;
        cursor: pointer; text-decoration: none;
        margin: 4px 0 14px;
    }
    .img-dl-btn:hover { background: #d97706; color: #fff; }
    .bd-content ul, .bd-content ol { padding-left: 1.5rem; }

    .video-block { margin: 16px 0; }
    .video-block video { width: 100%; border-radius: 10px; background: #000; }

    /* ─── Reaction bar ─── */
    /* 1 hàng cuộn ngang — không chiếm 2-3 dòng trên điện thoại */
    .reaction-bar {
        display: flex; gap: 6px; flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none;
        padding: 10px 0; margin: 16px 0;
        border-top: 1px solid #e5e7eb;
        border-bottom: 1px solid #e5e7eb;
    }
    .reaction-bar::-webkit-scrollbar { display: none; }
    .reaction-btn {
        display: inline-flex; align-items: center; gap: 4px; flex-shrink: 0;
        padding: 5px 10px; border-radius: 999px;
        border: 1.5px solid #e5e7eb; background: #fff;
        cursor: pointer; font-size: .95rem;
        transition: all .15s;
    }
    .reaction-btn:hover { background: #f3f4f6; transform: scale(1.05); }
    .reaction-btn.active {
        background: #fef3c7; border-color: #f59e0b; color: #92400e; font-weight: 700;
    }
    .reaction-btn .cnt { font-size: .8rem; color: #6b7280; min-width: 16px; text-align: center; }
    .reaction-btn.active .cnt { color: #92400e; }

    /* ─── Comments ─── */
    .cmt-section { margin-top: 24px; }
    .cmt-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 14px;
    }
    .cmt-heading { font-weight: 700; color: #111827; font-size: 1rem; margin-bottom: 0; }
    .cmt-sort-select {
        font-size: .82rem;
        padding: 4px 8px;
        border-radius: 8px;
        border: 1.5px solid #e5e7eb;
        background-color: #fff;
        color: #374151;
        outline: none;
        cursor: pointer;
        font-weight: 600;
    }
    .cmt-sort-select:focus {
        border-color: #f59e0b;
    }
    .cmt-item {
        background: #f3f4f6; border-radius: 14px;
        padding: 9px 13px; margin-bottom: 8px;
        position: relative;
    }
    .cmt-header {
        display: flex; flex-direction: column; gap: 2px;
        margin-bottom: 4px;
    }
    .cmt-header-sub {
        display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap;
    }
    .cmt-empcd { font-weight: 700; color: #6b7280; font-size: .62rem; flex-shrink: 0; }
    .cmt-name  { color: #1f2937; font-weight: 700; font-size: .88rem; }
    .cmt-meta  { color: #9ca3af; font-size: .6rem; }

    /* Bình luận của chính mình — nền vàng nhạt + viền trái cam + tag "Bạn" */
    .cmt-item.cmt-mine { background: #fffbeb; border-left: 3px solid #f59e0b; }
    .cmt-replies .cmt-item.cmt-mine { background: #fffbeb; border-color: #fcd34d; }
    .cmt-item.cmt-focus { animation: cmtFocus 2.4s ease; }
    @@keyframes cmtFocus { 0%, 60% { background: #dbeafe; box-shadow: 0 0 0 2px #60a5fa; } 100% { box-shadow: 0 0 0 0 transparent; } }
    .cmt-mine-tag {
        display: inline-block; background: #f59e0b; color: #fff;
        font-size: .58rem; font-weight: 700; border-radius: 6px;
        padding: 1px 6px; vertical-align: 2px; margin-left: 4px;
    }
    .cmt-content { font-size: .95rem; color: #1f2937; line-height: 1.5; white-space: pre-wrap; }
    .cmt-time  { font-size: .72rem; color: #9ca3af; }
    .cmt-delete {
        position: absolute; top: 8px; right: 10px;
        background: transparent; border: none; cursor: pointer;
        color: #9ca3af; font-size: .85rem;
    }
    .cmt-delete:hover { color: #ef4444; }
    .cmt-empty { text-align: center; color: #9ca3af; padding: 20px; font-size: .9rem; }

    .cmt-actions {
        margin-top: 4px; display: flex; gap: 14px; align-items: center;
        font-size: .8rem;
    }
    .cmt-action-btn {
        background: none; border: none; padding: 4px 0;
        color: #4b5563; font-weight: 700; cursor: pointer;
    }
    .cmt-action-btn:hover { color: #f59e0b; }

    .cmt-replies { margin-top: 8px; margin-left: 28px; }
    .cmt-replies .cmt-item { background: #fff; border: 1px solid #e5e7eb; }
    .more-replies-btn-wrap { margin-top: 4px; margin-bottom: 8px; }
    .more-replies-btn {
        background: none; border: none; padding: 0;
        color: #f59e0b; font-weight: 700; font-size: .8rem;
        cursor: pointer; display: inline-flex; align-items: center; gap: 4px;
    }
    .more-replies-btn:hover { color: #d97706; text-decoration: underline; }

    .cmt-reply-box {
        display: flex; gap: 6px; margin: 8px 0 6px 28px;
    }
    .cmt-reply-box textarea {
        flex: 1; resize: none; border: 1.5px solid #d1d5db;
        border-radius: 14px; padding: 6px 12px; font-size: .9rem;
        max-height: 140px; min-height: 38px; line-height: 1.4;
        outline: none;
    }
    .cmt-reply-box textarea:focus { border-color: #f59e0b; box-shadow: 0 0 0 3px rgba(245,158,11,.12); }
    .cmt-reply-box button {
        background: #f59e0b; color: #fff; border: none;
        border-radius: 50%; width: 32px; height: 32px;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer; flex-shrink: 0;
    }
    .cmt-reply-box button:hover { background: #d97706; }
    .cmt-reply-box button:disabled { background: #d1d5db; cursor: not-allowed; }

    /* ─── Sticky input bar ─── */
    .cmt-input-bar {
        position: fixed; bottom: 0; left: 0; right: 0;
        background: #fff; border-top: 1px solid #e5e7eb;
        padding: 8px 12px calc(8px + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 6px;
        z-index: 50; max-width: 820px; margin: 0 auto;
        box-shadow: 0 -4px 16px rgba(0,0,0,.06);
    }
    .cmt-input-row { display: flex; gap: 6px; align-items: flex-end; }
    /* Đang trả lời ai — hiện ngay trên ô nhập, bấm ✕ để huỷ */
    .reply-chip {
        display: flex; align-items: center; gap: 6px;
        background: #eff6ff; color: #1e40af; border-radius: 10px;
        padding: 5px 10px; font-size: .8rem; font-weight: 600;
    }
    .reply-chip .who { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .reply-chip button { background: none; border: none; color: #1e40af; font-size: 1.05rem; padding: 0 2px; line-height: 1; }
    /* Nút nhảy xuống phần bình luận (chỉ mobile) */
    .cmt-jump-btn {
        flex-shrink: 0; height: 38px; border-radius: 19px; border: 1.5px solid #e5e7eb; background: #fff;
        color: #374151; font-weight: 700; font-size: .85rem; padding: 0 10px;
        display: inline-flex; align-items: center; gap: 4px;
    }

    .emoji-btn {
        background: transparent; border: none; cursor: pointer;
        font-size: 1.3rem; padding: 4px 6px; flex-shrink: 0;
        color: #6b7280;
    }
    .emoji-btn:hover { color: #f59e0b; }

    /* position:fixed (không phải absolute) — getBoundingClientRect trả toạ độ theo viewport,
       absolute tính theo document nên khi trang đã cuộn popup bị đẩy tuốt lên đầu trang,
       trên mobile nhìn như "bấm không ra gì". */
    .emoji-pop {
        position: fixed; background: #fff;
        border: 1px solid #e5e7eb; border-radius: 12px;
        padding: 8px; box-shadow: 0 6px 24px rgba(0,0,0,.12);
        display: grid; grid-template-columns: repeat(8, 1fr);
        gap: 2px; z-index: 1060; max-width: 280px;
    }
    .emoji-pop button {
        background: none; border: none; cursor: pointer;
        font-size: 1.25rem; padding: 4px; border-radius: 6px;
        line-height: 1;
    }
    .emoji-pop button:hover { background: #fef3c7; }
    .cmt-input {
        flex: 1; resize: none; border: 1.5px solid #d1d5db;
        border-radius: 18px; padding: 8px 14px; font-size: .95rem;
        max-height: 100px; min-height: 38px; line-height: 1.4;
        outline: none;
    }
    .cmt-input:focus { border-color: #f59e0b; box-shadow: 0 0 0 3px rgba(245,158,11,.12); }
    .cmt-send-btn {
        background: #f59e0b; color: #fff; border: none;
        border-radius: 50%; width: 38px; height: 38px;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer; flex-shrink: 0;
    }
    .cmt-send-btn:hover { background: #d97706; }
    .cmt-send-btn:disabled { background: #d1d5db; cursor: not-allowed; }

    /* Nút "Xem hết bình luận" */
    .cmt-show-all-wrap { text-align: center; margin: 4px 0 10px; }
    .cmt-show-all-btn {
        background: #fff; border: 1.5px solid #f59e0b; color: #92400e;
        font-weight: 700; font-size: .85rem; border-radius: 999px;
        padding: 7px 18px; cursor: pointer;
        display: inline-flex; align-items: center; gap: 6px;
    }
    .cmt-show-all-btn:hover { background: #fef3c7; }

    @@media (max-width: 768px) {
        .bd-title { font-size: 1.2rem; }
    }
    /* Mobile: thanh menu dưới (68px, z-index 1020) che mất ô bình luận → đặt ô nhập ngay trên menu.
       Khi bàn phím mở menu bị ẩn (body.kb-open) thì ô nhập xuống sát đáy. */
    @@media (max-width: 991.98px) {
        .cmt-input-bar { bottom: 68px; z-index: 1019; }
        body.kb-open .cmt-input-bar { bottom: 0; }
    }

    /* ─── Desktop ≥992px: chia 6.5 (bài viết) : 3.5 (reaction + bình luận) ─── */
    @@media (min-width: 992px) {
        .bd-container { max-width: 1320px; padding-bottom: 24px; }
        .bd-back-row  { max-width: 1320px; }
        .bd-layout {
            display: grid;
            grid-template-columns: minmax(0, 6.5fr) minmax(0, 3.5fr);
            gap: 28px;
            align-items: start;
        }
        /* Cột bình luận dính theo màn hình, cuộn độc lập kiểu Facebook */
        .bd-side {
            position: sticky; top: 16px;
            max-height: calc(100vh - 32px);
            overflow-y: auto;
            padding-right: 4px;
        }
        .bd-side .reaction-bar { margin-top: 0; padding-top: 0; border-top: none; }
        .bd-side .cmt-section { margin-top: 12px; }
        /* Ô nhập bình luận nằm luôn trong cột phải thay vì dính đáy màn hình */
        .bd-side .cmt-input-bar {
            position: static; box-shadow: none; border-top: 1px solid #e5e7eb;
            padding: 10px 0 0; margin-top: 10px; max-width: none;
        }
        .cmt-jump-btn { display: none; }
    }
</style>
}

@Html.AntiForgeryToken()

<div class="bd-back-row">
    <a href="@Url.Action("Index", "Bulletin")" class="bd-back-btn" title="@D("Quay lại bản tin", "Back to bulletins")">
        <span class="material-symbols-rounded">arrow_back</span>
    </a>
</div>

<div class="bd-container">
    <div class="bd-layout">
        <div class="bd-main">
            <img src="@(string.IsNullOrEmpty(Model.COVER_IMG)
                        ? Url.Content("~/assets/img/bulletin-default-cover.png")
                        : Url.Action("GetBulletinImage", "Image", new { fileName = Model.COVER_IMG }))"
                 class="bd-cover" alt="" onerror="this.onerror=null;this.src='@Url.Content("~/assets/img/bulletin-default-cover.png")'" />

            <div class="bd-tags">
                <span class="bd-tag @roleKey">@(roleKey == "HR" ? D("Nhân sự", "HR") : roleKey)</span>
                <span class="bd-meta" style="margin:0">
                    <span><i class="bi bi-calendar3 me-1"></i>@((Model.PUBLISHED_DT ?? Model.PUBLISH_FROM).ToString("dd/MM/yyyy"))</span>
                    <span><i class="bi bi-eye me-1"></i>@Model.VIEW_COUNT</span>
                </span>
            </div>
            <h1 class="bd-title">@Model.TitleFor(bLang)</h1>

            @if (isUpdated && !string.IsNullOrEmpty(Model.UPDT_FULL_NAME))
            {
                @* Bỏ tên người sửa (tên lưu font VNI, công nhân cũng không cần) — chỉ báo bài đã được cập nhật *@
                <div class="bd-updated-banner">
                    <i class="bi bi-pencil-square no-ic3d"></i>
                    @D("Đã cập nhật lúc", "Updated at") @Model.UPDT_DT?.ToString("HH:mm dd/MM/yyyy")
                </div>
            }

            <div class="bd-content">
                @Html.Raw(Model.ContentFor(bLang))
            </div>

            @foreach (var v in videos)
            {
                <div class="video-block">
                    <video controls preload="metadata">
                        <source src="@Url.Action("Stream", "Video", new { folder = "BULLETIN_VIDEO", id = v.ID })" />
                    </video>
                </div>
            }
        </div>

        <div class="bd-side">
            <!-- Reaction bar -->
            <div class="reaction-bar">
                @foreach (var (key, emoji) in reactionMap)
                {
                    <button type="button" class="reaction-btn @(Model.MY_REACTION == key ? "active" : "")"
                            data-reaction="@key" onclick="toggleReaction('@key', this)">
                        <span>@Html.Raw(emoji)</span>
                        <span class="cnt">@GetCount(key)</span>
                    </button>
                }
            </div>

            <!-- Comments -->
            <div class="cmt-section" id="cmtSection">
                <div class="cmt-header-row">
                    <div class="cmt-heading">
                        <i class="bi bi-chat-square-text me-1"></i>
                        @D("Bình luận", "Comments") (<span id="cmtCount">@Model.COMMENT_COUNT</span>)
                    </div>
                    <select id="cmtSortSelect" class="cmt-sort-select" onchange="renderSortedComments(true)">
                        <option value="all">@D("Tất cả", "All")</option>
                        <option value="newest">@D("Mới nhất", "Newest")</option>
                        <option value="interacted">@D("Tương tác nhiều nhất", "Most reactions")</option>
                    </select>
                </div>
                <div id="cmtList">
                    <div class="cmt-empty"><i class="bi bi-hourglass-split"></i> @D("Đang tải...", "Loading...")</div>
                </div>
            </div>

            <!-- Ô nhập: mobile dính đáy màn hình (position:fixed), desktop nằm trong cột phải -->
            <div class="cmt-input-bar">
                <div class="reply-chip" id="replyChip" style="display:none">
                    <i class="bi bi-reply-fill"></i>
                    <span class="who">@D("Đang trả lời", "Replying to") <b id="replyWho"></b></span>
                    <button type="button" onclick="cancelReply()" title="@D("Huỷ", "Cancel")">&times;</button>
                </div>
                <div class="cmt-input-row">
                    <button type="button" class="cmt-jump-btn" onclick="jumpToComments()" title="@D("Xem bình luận", "View comments")">
                        <i class="bi bi-chat-dots no-ic3d"></i><span id="cmtJumpCount">@Model.COMMENT_COUNT</span>
                    </button>
                    <button type="button" class="emoji-btn" onclick="toggleEmojiPop('cmtInput', this)" title="Emoji">
                        <i class="bi bi-emoji-smile"></i>
                    </button>
                    <textarea id="cmtInput" class="cmt-input" placeholder="@D("Viết bình luận...", "Write a comment...")" maxlength="1000" rows="1"
                              oninput="autoResize(this)"></textarea>
                    <button id="cmtSendBtn" class="cmt-send-btn" onclick="sendComment()" title="Gửi">
                        <i class="bi bi-send-fill"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
// Nhãn tiếng Việt/Anh cho phần bình luận dựng bằng JS. Gom 1 chỗ thay vì nhét lời gọi Razor vào
// giữa template literal (khó đọc, dễ sai dấu nháy). NV Việt vẫn thấy y như cũ.
const LBL = {
    del:          @DJ("Xóa", "Delete"),
    reply:        @DJ("Trả lời", "Reply"),
    writeReply:   @DJ("Viết trả lời...", "Write a reply..."),
    moreReplies:  @DJ("Xem thêm {n} phản hồi", "Show {n} more replies"),
    moreComments: @DJ("Xem hết {n} bình luận còn lại", "Show the remaining {n} comments")
};

    const BULLETIN_ID = @Model.ID;
    const CURRENT_EMPCD = '@(user?.EmpCd ?? "")';
    const IS_HR_ADMIN = @(isHrAdmin ? "true" : "false");
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

    function escapeHtml(s) {
        return (s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // "Vừa xong / 5 phút trước / 3 giờ trước / 2 ngày trước", quá 7 ngày thì hiện ngày giờ
    const IS_VI = @(bLang == "vi" ? "true" : "false");
    function fmtTime(dateStr) {
        const d = new Date(dateStr);
        const m = Math.floor((Date.now() - d.getTime()) / 60000);
        if (m < 1)  return IS_VI ? 'Vừa xong' : 'Just now';
        if (m < 60) return m + (IS_VI ? ' phút trước' : ' min ago');
        const h = Math.floor(m / 60);
        if (h < 24) return h + (IS_VI ? ' giờ trước' : ' h ago');
        const dd = Math.floor(h / 24);
        if (dd < 7) return dd + (IS_VI ? ' ngày trước' : ' d ago');
        return d.toLocaleString('vi-VN', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit', hour12:false });
    }

    function autoResize(el) {
        el.style.height = 'auto';
        el.style.height = Math.min(el.scrollHeight, 100) + 'px';
    }

    // ── Emoji picker ──
    const EMOJI_LIST = [
        '😀','😂','🤣','😊','😍','😘','😎','🤩',
        '🥰','😋','😅','😉','😢','😭','😡','😱',
        '🤔','😴','🤤','🙄','😇','🥳','🤗','😏',
        '👍','👎','👏','🙏','💪','🤝','✌️','🤞',
        '❤️','🧡','💛','💚','💙','💜','🖤','💯',
        '🔥','✨','⭐','🎉','🎊','🎁','🌹','☕'
    ];
    let _emojiPop = null;
    function toggleEmojiPop(targetId, anchor) {
        if (_emojiPop) { _emojiPop.remove(); _emojiPop = null; return; }
        const pop = document.createElement('div');
        pop.className = 'emoji-pop';
        pop.innerHTML = EMOJI_LIST.map(e => `<button type="button">${e}</button>`).join('');
        pop.querySelectorAll('button').forEach((b, i) => {
            b.onclick = (ev) => {
                ev.stopPropagation();
                insertAtCursor(targetId, EMOJI_LIST[i]);
            };
        });
        document.body.appendChild(pop);
        // Kẹp popup trong viewport (position:fixed) — mobile màn hình nhỏ, anchor sát mép/đáy
        const r = anchor.getBoundingClientRect();
        const w = pop.offsetWidth, h = pop.offsetHeight;
        let left = Math.min(Math.max(8, r.left), window.innerWidth - w - 8);
        let top  = r.top - h - 6;
        if (top < 8) top = Math.min(window.innerHeight - h - 8, r.bottom + 6);
        pop.style.left = left + 'px';
        pop.style.top  = Math.max(8, top) + 'px';
        _emojiPop = pop;
        setTimeout(() => {
            document.addEventListener('click', closeEmojiOnOutside, { once: true });
        }, 0);
    }
    function closeEmojiOnOutside(ev) {
        if (_emojiPop && !_emojiPop.contains(ev.target)) { _emojiPop.remove(); _emojiPop = null; }
        else if (_emojiPop) setTimeout(() => document.addEventListener('click', closeEmojiOnOutside, { once: true }), 0);
    }
    function insertAtCursor(targetId, text) {
        const el = document.getElementById(targetId);
        if (!el) return;
        const start = el.selectionStart ?? el.value.length;
        const end   = el.selectionEnd   ?? el.value.length;
        el.value = el.value.slice(0, start) + text + el.value.slice(end);
        el.focus();
        const pos = start + text.length;
        el.setSelectionRange(pos, pos);
        if (el.tagName === 'TEXTAREA') autoResize(el);
    }

    // ── Load comments ──
    let _allComments = [];
    async function loadComments(isInitial = false) {
        try {
            const res = await fetch('@Url.Action("Comments", "Bulletin")/' + BULLETIN_ID);
            const data = await res.json();
            renderComments(data.data || [], isInitial);
        } catch (e) {
            document.getElementById('cmtList').innerHTML = '<div class="cmt-empty">' + @DJ("Không tải được bình luận.", "Could not load comments.") + '</div>';
        }
    }

    function ageMinutes(dateStr) {
        return (Date.now() - new Date(dateStr).getTime()) / 60000;
    }

    function commentHtml(c, isReply) {
        // CAN_DELETE đã được server compute (tránh lệch timezone khi JS parse INST_DT)
        const canDelete = !!c.CAN_DELETE;
        const displayName = c.FULL_NAME || c.EMP_CNAME || '';
        const meta = [c.DEPT_NAME, c.LINE_NAME, c.WORK_NAME].filter(Boolean).join(' / ');
        const isMine = c.EMPCD === CURRENT_EMPCD;
        return `
            <div class="cmt-item${isMine ? ' cmt-mine' : ''}" data-id="${c.ID}">
                ${canDelete ? `<button class="cmt-delete" onclick="deleteComment(${c.ID})" title="${LBL.del}"><i class="bi bi-trash"></i></button>` : ''}
                <div class="cmt-header">
                    <span class="cmt-name vni-font">${escapeHtml(displayName)}${isMine ? '<span class="cmt-mine-tag">' + @DJ("Bạn", "You") + '</span>' : ''}</span>
                    <span class="cmt-header-sub">
                        <span class="cmt-empcd">#${escapeHtml(c.EMPCD)}</span>
                        ${meta ? `<span class="cmt-meta">${escapeHtml(meta)}</span>` : ''}
                    </span>
                </div>
                <div class="cmt-content">${escapeHtml(c.CONTENT)}</div>
                <div class="cmt-actions">
                    <span class="cmt-time">${fmtTime(c.INST_DT)}</span>
                    <button class="cmt-action-btn" onclick="openReply(${isReply ? c.PARENT_ID : c.ID}, ${c.ID})">${LBL.reply}</button>
                </div>
            </div>`;
    }

    let _sortedRootIds = null;
    const _expandedThreadIds = new Set();

    function renderComments(items, forceSort = false) {
        _allComments = items;
        renderSortedComments(forceSort);
    }

    function renderSortedComments(forceSort = false) {
        const list = document.getElementById('cmtList');
        document.getElementById('cmtCount').textContent = _allComments.length;
        document.getElementById('cmtJumpCount').textContent = _allComments.length;
        if (_allComments.length === 0) {
            list.innerHTML = '<div class="cmt-empty">' + @DJ("Chưa có bình luận. Hãy là người đầu tiên!", "No comments yet. Be the first!") + '</div>';
            _sortedRootIds = null;
            _expandedThreadIds.clear();
            return;
        }

        if (forceSort) {
            _expandedThreadIds.clear();
        }

        let roots = _allComments.filter(c => !c.PARENT_ID);
        const childrenByRoot = {};
        _allComments.filter(c => c.PARENT_ID).forEach(c => {
            (childrenByRoot[c.PARENT_ID] ||= []).push(c);
        });

        const sortType = document.getElementById('cmtSortSelect')?.value || 'all';

        // Thread "của tôi" = tôi là chủ bình luận gốc HOẶC tôi có trả lời trong thread
        const isMyThread = (root) =>
            root.EMPCD === CURRENT_EMPCD ||
            (childrenByRoot[root.ID] || []).some(r => r.EMPCD === CURRENT_EMPCD);

        if (forceSort || !_sortedRootIds || _sortedRootIds.length === 0) {
            if (sortType === 'newest') {
                roots.sort((a, b) => new Date(b.INST_DT) - new Date(a.INST_DT));
            } else if (sortType === 'interacted') {
                roots.sort((a, b) => {
                    const countA = (childrenByRoot[a.ID] || []).length;
                    const countB = (childrenByRoot[b.ID] || []).length;
                    if (countB !== countA) {
                        return countB - countA;
                    }
                    return new Date(b.INST_DT) - new Date(a.INST_DT);
                });
            } else {
                roots.sort((a, b) => new Date(a.INST_DT) - new Date(b.INST_DT));
            }
            // Ưu tiên thread của mình lên đầu (stable — giữ nguyên thứ tự trong từng nhóm)
            if (CURRENT_EMPCD) {
                roots = [...roots.filter(isMyThread), ...roots.filter(r => !isMyThread(r))];
            }
            _sortedRootIds = roots.map(r => r.ID);
        } else {
            const existingRoots = roots.filter(r => _sortedRootIds.includes(r.ID));
            existingRoots.sort((a, b) => _sortedRootIds.indexOf(a.ID) - _sortedRootIds.indexOf(b.ID));
            const newRoots = roots.filter(r => !_sortedRootIds.includes(r.ID));
            if (sortType === 'newest') {
                roots = [...newRoots, ...existingRoots];
            } else {
                roots = [...existingRoots, ...newRoots];
            }
            _sortedRootIds = roots.map(r => r.ID);
        }

        // Mặc định chỉ hiện 4 thread đầu — bấm "Xem hết" mới bung toàn bộ
        const VISIBLE_THREADS = 4;
        const hiddenCount = roots.length - VISIBLE_THREADS;
        const visibleRoots = _showAllComments ? roots : roots.slice(0, VISIBLE_THREADS);

        list.innerHTML = visibleRoots.map(c => {
            const repliesArray = childrenByRoot[c.ID] || [];
            let repliesHtml = '';
            if (repliesArray.length > 0) {
                const isExpanded = _expandedThreadIds.has(c.ID) || (repliesArray.length <= 2);
                if (isExpanded) {
                    repliesHtml = `
                        <div class="cmt-replies">
                            ${repliesArray.map(r => commentHtml(r, true)).join('')}
                        </div>`;
                } else {
                    repliesHtml = `
                        <div class="cmt-replies">
                            ${repliesArray.slice(0, 2).map(r => commentHtml(r, true)).join('')}
                            <div id="moreReplies-${c.ID}" style="display: none;">
                                ${repliesArray.slice(2).map(r => commentHtml(r, true)).join('')}
                            </div>
                            <div id="moreBtnContainer-${c.ID}" class="more-replies-btn-wrap">
                                <button class="more-replies-btn" onclick="showAllReplies(${c.ID})">
                                    <i class="bi bi-arrow-return-right me-1"></i> ${LBL.moreReplies.replace('{n}', repliesArray.length - 2)}
                                </button>
                            </div>
                        </div>`;
                }
            }
            return `
                <div class="cmt-thread">
                    ${commentHtml(c, false)}
                    ${repliesHtml}
                </div>`;
        }).join('');

        if (!_showAllComments && hiddenCount > 0) {
            list.innerHTML += `
                <div class="cmt-show-all-wrap">
                    <button type="button" class="cmt-show-all-btn" onclick="showAllComments()">
                        <i class="bi bi-chat-dots"></i> ${LBL.moreComments.replace('{n}', hiddenCount)}
                    </button>
                </div>`;
        }
    }

    let _showAllComments = false;
    function showAllComments() {
        _showAllComments = true;
        renderSortedComments();
    }

    function showAllReplies(parentId) {
        _expandedThreadIds.add(parentId);
        const div = document.getElementById('moreReplies-' + parentId);
        const btn = document.getElementById('moreBtnContainer-' + parentId);
        if (div) div.style.display = 'block';
        if (btn) btn.style.display = 'none';
    }

    // ── Reply ──
    // Trả lời dùng chung ô nhập dưới đáy (dễ bấm trên điện thoại hơn ô nhỏ chen giữa danh sách):
    // hiện "Đang trả lời <tên>" phía trên ô nhập, bấm ✕ để quay về bình luận thường.
    // parentId = bình luận gốc của luồng; targetId = bình luận đang được trả lời — gửi lên API để báo
    // đúng người (API tự gom câu trả lời về luồng gốc).
    let _reply = null;
    function openReply(parentId, targetId) {
        const c = _allComments.find(x => x.ID === targetId) || {};
        _reply = { parentId, targetId: targetId || parentId };
        const who = document.getElementById('replyWho');
        who.textContent = c.FULL_NAME || c.EMP_CNAME || c.EMPCD || '';
        who.className = 'vni-font';
        document.getElementById('replyChip').style.display = 'flex';
        const input = document.getElementById('cmtInput');
        input.placeholder = LBL.writeReply;
        input.focus();
    }
    function cancelReply() {
        _reply = null;
        document.getElementById('replyChip').style.display = 'none';
        document.getElementById('cmtInput').placeholder = @DJ("Viết bình luận...", "Write a comment...");
    }
    function jumpToComments() {
        document.getElementById('cmtSection')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    // ── Send comment ──
    async function sendComment() {
        const input = document.getElementById('cmtInput');
        const content = input.value.trim();
        if (!content) return;
        const btn = document.getElementById('cmtSendBtn');
        btn.disabled = true;
        try {
            const fd = new FormData();
            fd.append('bulletinId', BULLETIN_ID);
            fd.append('content', content);
            const replying = _reply;
            if (replying) fd.append('parentId', replying.targetId);
            fd.append('__RequestVerificationToken', token);
            const res = await fetch('@Url.Action("AddComment", "Bulletin")', { method: 'POST', body: fd });
            const data = await res.json();
            if (data.success) {
                input.value = '';
                autoResize(input);
                if (replying) { _expandedThreadIds.add(replying.parentId); cancelReply(); }
                await loadComments();
                // Cuộn tới bình luận vừa gửi để công nhân thấy là đã gửi được
                if (data.id) {
                    if (!replying) { _showAllComments = true; renderSortedComments(); }
                    const el = document.querySelector(`.cmt-item[data-id="${data.id}"]`);
                    if (el) { el.scrollIntoView({ block: 'center', behavior: 'smooth' }); el.classList.add('cmt-focus'); }
                }
            } else {
                showToast(data.message || @DJ("Lỗi gửi bình luận", "Failed to send comment"), 'error');
            }
        } catch (e) {
            showToast('Lỗi kết nối: ' + e.message, 'error');
        } finally {
            btn.disabled = false;
        }
    }

    // ── Delete comment ──
    async function deleteComment(id) {
        showConfirm(@DJ("Xóa bình luận này?", "Delete this comment?"), async () => {
            const fd = new FormData();
            fd.append('id', id);
            fd.append('__RequestVerificationToken', token);
            const res = await fetch('@Url.Action("DeleteComment", "Bulletin")', { method: 'POST', body: fd });
            const data = await res.json();
            if (data.success) {
                await loadComments();
                showToast(@DJ("Đã xóa bình luận", "Comment deleted"), 'success');
            } else {
                showToast(data.message || @DJ("Lỗi xóa", "Delete failed"), 'error');
            }
        }, { okText: LBL.del, okClass: 'btn-danger', icon: 'delete', iconColor: '#dc2626', iconBg: '#fee2e2' });
    }

    // ── React ──
    async function toggleReaction(reaction, btnEl) {
        const fd = new FormData();
        fd.append('bulletinId', BULLETIN_ID);
        fd.append('reaction', reaction);
        fd.append('__RequestVerificationToken', token);
        const res = await fetch('@Url.Action("React", "Bulletin")', { method: 'POST', body: fd });
        const data = await res.json();
        if (!data.success) {
            showToast(data.message || 'Lỗi', 'error');
            return;
        }
        // Update UI inline
        const cntEl = btnEl.querySelector('.cnt');
        let cnt = parseInt(cntEl.textContent) || 0;
        const wasActive = btnEl.classList.contains('active');

        // Bỏ active các nút khác (1 emp = 1 reaction)
        document.querySelectorAll('.reaction-btn').forEach(b => {
            if (b !== btnEl && b.classList.contains('active')) {
                b.classList.remove('active');
                const otherCnt = b.querySelector('.cnt');
                otherCnt.textContent = Math.max(0, parseInt(otherCnt.textContent) - 1);
            }
        });

        if (data.action === 'added' || data.action === 'changed') {
            btnEl.classList.add('active');
            if (!wasActive) cnt++;
            cntEl.textContent = cnt;
        } else if (data.action === 'removed') {
            btnEl.classList.remove('active');
            cntEl.textContent = Math.max(0, cnt - 1);
        }
    }

    // ── Download image (mọi ảnh trong nội dung) ──
    // Trước đây fetch() ảnh → convert blob → URL.createObjectURL() để ép tên file tải về — nhưng
    // Safari/WKWebView hay lỗi "WebKitBlobResource error 1" âm thầm khi click tải blob: URL (giới hạn
    // đã biết của WebKit với blob download, không bắt được bằng try/catch vì lỗi xảy ra ở tầng network
    // nội bộ trình duyệt, không phải JS exception — báo lỗi thật 2026-10-28, Bulletin/Detail/23). Bỏ
    // hẳn bước blob, dùng thẳng <a href download> trỏ URL gốc — để OS/WebView tự xử lý tải file (đã
    // có sẵn WKDownloadDelegate/DownloadListener, không cần JS tự làm lại, đúng NATIVE_HELPER_RULES).
    function downloadImg(src, filename) {
        const a = document.createElement('a');
        a.href = src;
        a.download = filename || ('bulletin-' + BULLETIN_ID + '.jpg');
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
    }

    // Tự động chèn nút tải dưới mỗi ảnh trong nội dung
    document.querySelectorAll('.bd-content img').forEach((img, i) => {
        const btn = document.createElement('a');
        btn.href = '#';
        btn.className = 'img-dl-btn';
        btn.innerHTML = '<i class="bi bi-download"></i> @D("Tải ảnh", "Download image")';
        btn.onclick = (e) => {
            e.preventDefault();
            const url = img.getAttribute('src');
            const name = (url.split('/').pop() || '').split('?')[0] || ('bulletin-' + BULLETIN_ID + '-' + (i+1) + '.jpg');
            downloadImg(url, name);
        };
        img.insertAdjacentElement('afterend', btn);
    });

    // Initial load
    loadComments(true).then(focusCommentFromHash);

    // Mở từ link ".../Detail/{id}#cmt-{commentId}" (vd ô "Bản tin có bình luận mới" ở trang chủ):
    // bung luồng chứa bình luận đó, cuộn tới và tô sáng.
    function focusCommentFromHash() {
        const m = /^#cmt-(\d+)$/.exec(location.hash);
        if (!m) return;
        const id = m[1];
        const c = _allComments.find(x => String(x.ID) === id);
        if (!c) return;
        const rootId = c.PARENT_ID || c.ID;
        _expandedThreadIds.add(rootId);
        _showAllComments = true;
        renderSortedComments();
        const el = document.querySelector(`.cmt-item[data-id="${id}"]`);
        if (!el) return;
        el.scrollIntoView({ block: 'center', behavior: 'smooth' });
        el.classList.add('cmt-focus');
    }

    // Enter to send (Shift+Enter newline)
    document.getElementById('cmtInput').addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            sendComment();
        }
    });
</script>
}
