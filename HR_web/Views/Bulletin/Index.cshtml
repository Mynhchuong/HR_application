@model List<HR_web.Models.Bulletin.BulletinModel>
@{
    ViewData["Title"] = "Bản tin";
    var user = ViewBag.CurrentUser as HR_web.Models.Account.UserInfoModel;
}

@section Styles {
<style>
    /* ─── Feed kiểu Facebook: 1 cột giữa màn hình ─── */
    .fb-feed {
        max-width: 640px;
        margin: 0 auto;
        padding: 12px 10px 40px;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .fb-card {
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 1px 4px rgba(0,0,0,.08);
        overflow: hidden;
        position: relative;
    }
    .fb-card.pinned { border: 2px solid #f59e0b; }

    .fb-pin-badge {
        position: absolute; top: 10px; left: 10px; z-index: 2;
        background: #f59e0b; color: #fff;
        padding: 4px 9px; border-radius: 999px;
        font-size: .72rem; font-weight: 700;
        display: flex; align-items: center; gap: 4px;
        box-shadow: 0 2px 6px rgba(245,158,11,.4);
    }

    .fb-cover {
        width: 100%; aspect-ratio: 16/9;
        object-fit: cover; background: #f3f4f6;
        display: block; cursor: pointer;
    }

    .fb-body { padding: 12px 14px 8px; }
    .fb-title {
        font-size: 1.02rem; font-weight: 700; color: #111827;
        line-height: 1.35; margin-bottom: 4px; cursor: pointer;
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .fb-title:hover { text-decoration: underline; }
    .fb-meta { color: #6b7280; font-size: .75rem; display: flex; gap: 12px; flex-wrap: wrap; }

    /* Hàng đếm reaction / bình luận */
    .fb-counts {
        display: flex; justify-content: space-between; align-items: center;
        padding: 8px 14px; color: #6b7280; font-size: .8rem;
    }
    .fb-counts .rx { display: inline-flex; align-items: center; gap: 4px; }

    /* Hàng nút hành động */
    .fb-actions {
        display: flex; border-top: 1px solid #e5e7eb;
    }
    .fb-action-btn {
        flex: 1; background: none; border: none;
        padding: 9px 4px; cursor: pointer;
        color: #6b7280; font-weight: 700; font-size: .85rem;
        display: inline-flex; align-items: center; justify-content: center; gap: 6px;
        -webkit-tap-highlight-color: transparent;
    }
    .fb-action-btn:active { background: #f3f4f6; }
    .fb-action-btn.liked { color: #f59e0b; }

    /* Khu bình luận inline */
    .fb-cmt-area { border-top: 1px solid #e5e7eb; padding: 10px 14px; display: none; }
    .fb-cmt-area.open { display: block; }
    .fb-cmt-item {
        background: #f3f4f6; border-radius: 12px;
        padding: 7px 11px; margin-bottom: 6px;
    }
    .fb-cmt-item.mine { background: #fffbeb; border-left: 3px solid #f59e0b; }
    .fb-cmt-name { font-weight: 700; font-size: .78rem; color: #111827; }
    .fb-cmt-text { font-size: .85rem; color: #1f2937; white-space: pre-wrap; word-break: break-word; }
    .fb-cmt-more {
        display: inline-block; color: #f59e0b; font-weight: 700;
        font-size: .78rem; margin: 2px 0 8px; text-decoration: none;
    }
    .fb-cmt-more:hover { color: #d97706; text-decoration: underline; }
    .fb-cmt-empty { color: #9ca3af; font-size: .8rem; margin-bottom: 8px; }

    .fb-cmt-input-row { display: flex; gap: 6px; align-items: flex-end; }
    .fb-cmt-input-row textarea {
        flex: 1; resize: none; border: 1.5px solid #d1d5db;
        border-radius: 16px; padding: 7px 12px; font-size: .88rem;
        max-height: 80px; min-height: 34px; line-height: 1.4; outline: none;
    }
    .fb-cmt-input-row textarea:focus { border-color: #f59e0b; box-shadow: 0 0 0 3px rgba(245,158,11,.12); }
    .fb-cmt-input-row button {
        background: #f59e0b; color: #fff; border: none;
        border-radius: 50%; width: 34px; height: 34px;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer; flex-shrink: 0;
    }
    .fb-cmt-input-row button:disabled { background: #d1d5db; }

    .blt-empty { text-align: center; padding: 60px 20px; color: #9ca3af; }

    .blt-page-header {
        background: linear-gradient(120deg,#fef3c7,#fde68a);
        padding: 18px 20px; margin: 0; color: #92400e;
        font-weight: 800; display: flex; align-items: center; gap: 8px;
    }
</style>
}

@Html.AntiForgeryToken()

<div class="blt-page-header">
    <i class="bi bi-megaphone-fill"></i>
    <span>Bản tin nội bộ</span>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-warning mx-3 mt-3">@TempData["ErrorMessage"]</div>
}

@if (!Model.Any())
{
    <div class="blt-empty">
        <img src="@(new Random().Next(2)==0 ? Url.Content("~/assets/img/illustrations/A_nodata.png") : Url.Content("~/assets/img/illustrations/Chi_nodata.png"))" alt="" style="max-width:150px;display:block;margin:0 auto 12px;opacity:.9;" />
        <p>Chưa có bản tin nào.</p>
    </div>
}
else
{
    <div class="fb-feed">
        @foreach (var item in Model)
        {
            var detailUrl = Url.Action("Detail", "Bulletin", new { id = item.ID });
            <div class="fb-card @(item.IS_PINNED == 1 ? "pinned" : "")" data-id="@item.ID">
                @if (item.IS_PINNED == 1)
                {
                    <div class="fb-pin-badge"><i class="bi bi-pin-angle-fill"></i> Ghim</div>
                }
                <img src="@(string.IsNullOrEmpty(item.COVER_IMG)
                            ? Url.Content("~/assets/img/bulletin-default-cover.png")
                            : Url.Action("GetBulletinImage", "Image", new { fileName = item.COVER_IMG }))"
                     class="fb-cover" alt="cover" onclick="location.href='@detailUrl'" />
                <div class="fb-body">
                    <div class="fb-title" onclick="location.href='@detailUrl'">@item.TITLE</div>
                    <div class="fb-meta">
                        <span><i class="bi bi-calendar3 me-1"></i>đến hết @item.PUBLISH_TO.ToString("dd/MM/yyyy")</span>
                        <span><i class="bi bi-eye me-1"></i>@item.VIEW_COUNT</span>
                    </div>
                </div>
                <div class="fb-counts">
                    <span class="rx">👍❤️ <span id="rxCount-@item.ID">@item.REACTION_COUNT</span></span>
                    <span><span id="cmtCount-@item.ID">@item.COMMENT_COUNT</span> bình luận</span>
                </div>
                <div class="fb-actions">
                    <button type="button" class="fb-action-btn @(item.MY_REACTION != null ? "liked" : "")"
                            id="likeBtn-@item.ID" onclick="quickLike(@item.ID)">
                        <i class="bi @(item.MY_REACTION != null ? "bi-hand-thumbs-up-fill" : "bi-hand-thumbs-up")"></i> Thích
                    </button>
                    <button type="button" class="fb-action-btn" onclick="toggleComments(@item.ID)">
                        <i class="bi bi-chat"></i> Bình luận
                    </button>
                    <button type="button" class="fb-action-btn" onclick="location.href='@detailUrl'">
                        <i class="bi bi-book"></i> Xem bài
                    </button>
                </div>
                <div class="fb-cmt-area" id="cmtArea-@item.ID">
                    <div id="cmtPreview-@item.ID"><div class="fb-cmt-empty">Đang tải...</div></div>
                    <div class="fb-cmt-input-row">
                        <textarea id="cmtInput-@item.ID" placeholder="Viết bình luận..." maxlength="1000" rows="1"></textarea>
                        <button type="button" id="cmtSend-@item.ID" onclick="sendFeedComment(@item.ID)" title="Gửi">
                            <i class="bi bi-send-fill"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
<script>
    const CURRENT_EMPCD = '@(user?.EmpCd ?? "")';
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
    const commentsBase = '@Url.Action("Comments", "Bulletin")';
    const addCommentUrl = '@Url.Action("AddComment", "Bulletin")';
    const reactUrl = '@Url.Action("React", "Bulletin")';
    const detailBase = '@Url.Action("Detail", "Bulletin")';

    function esc(s) {
        return (s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // ── Thích nhanh (toggle LIKE) ──
    async function quickLike(id) {
        const fd = new FormData();
        fd.append('bulletinId', id);
        fd.append('reaction', 'LIKE');
        fd.append('__RequestVerificationToken', token);
        try {
            const res = await fetch(reactUrl, { method: 'POST', body: fd });
            const data = await res.json();
            if (!data.success) { showToast(data.message || 'Lỗi', 'error'); return; }
            const btn = document.getElementById('likeBtn-' + id);
            const cntEl = document.getElementById('rxCount-' + id);
            let cnt = parseInt(cntEl.textContent) || 0;
            if (data.action === 'removed') {
                btn.classList.remove('liked');
                btn.querySelector('i').className = 'bi bi-hand-thumbs-up';
                cntEl.textContent = Math.max(0, cnt - 1);
            } else {
                // added hoặc changed (đổi từ reaction khác sang LIKE thì tổng không tăng)
                const wasLiked = btn.classList.contains('liked');
                btn.classList.add('liked');
                btn.querySelector('i').className = 'bi bi-hand-thumbs-up-fill';
                if (data.action === 'added' && !wasLiked) cntEl.textContent = cnt + 1;
            }
        } catch (e) { showToast('Lỗi kết nối', 'error'); }
    }

    // ── Bình luận inline ──
    const _loadedCmt = new Set();
    function toggleComments(id) {
        const area = document.getElementById('cmtArea-' + id);
        const isOpen = area.classList.toggle('open');
        if (isOpen && !_loadedCmt.has(id)) loadFeedComments(id);
        if (isOpen) document.getElementById('cmtInput-' + id)?.focus();
    }

    async function loadFeedComments(id) {
        const wrap = document.getElementById('cmtPreview-' + id);
        try {
            const res = await fetch(commentsBase + '/' + id);
            const data = await res.json();
            const items = data.data || [];
            _loadedCmt.add(id);
            renderFeedComments(id, items);
        } catch (e) {
            wrap.innerHTML = '<div class="fb-cmt-empty">Không tải được bình luận.</div>';
        }
    }

    function renderFeedComments(id, items) {
        const wrap = document.getElementById('cmtPreview-' + id);
        document.getElementById('cmtCount-' + id).textContent = items.length;
        if (items.length === 0) {
            wrap.innerHTML = '<div class="fb-cmt-empty">Chưa có bình luận. Hãy là người đầu tiên!</div>';
            return;
        }
        // Ưu tiên bình luận của mình, sau đó mới nhất — hiện tối đa 3
        const roots = items.filter(c => !c.PARENT_ID);
        roots.sort((a, b) => {
            const am = a.EMPCD === CURRENT_EMPCD ? 0 : 1;
            const bm = b.EMPCD === CURRENT_EMPCD ? 0 : 1;
            if (am !== bm) return am - bm;
            return new Date(b.INST_DT) - new Date(a.INST_DT);
        });
        const top = roots.slice(0, 3);
        let html = top.map(c => {
            const name = c.FULL_NAME || c.EMP_CNAME || c.EMPCD;
            const mine = c.EMPCD === CURRENT_EMPCD;
            return `<div class="fb-cmt-item${mine ? ' mine' : ''}">
                        <div class="fb-cmt-name vni-font">${esc(name)}</div>
                        <div class="fb-cmt-text">${esc(c.CONTENT)}</div>
                    </div>`;
        }).join('');
        if (items.length > top.length) {
            html += `<a class="fb-cmt-more" href="${detailBase}/${id}">Xem tất cả ${items.length} bình luận trong bài viết →</a>`;
        }
        wrap.innerHTML = html;
    }

    async function sendFeedComment(id) {
        const input = document.getElementById('cmtInput-' + id);
        const content = input.value.trim();
        if (!content) return;
        const btn = document.getElementById('cmtSend-' + id);
        btn.disabled = true;
        try {
            const fd = new FormData();
            fd.append('bulletinId', id);
            fd.append('content', content);
            fd.append('__RequestVerificationToken', token);
            const res = await fetch(addCommentUrl, { method: 'POST', body: fd });
            const data = await res.json();
            if (data.success) {
                input.value = '';
                await loadFeedComments(id);
            } else {
                showToast(data.message || 'Lỗi gửi bình luận', 'error');
            }
        } catch (e) {
            showToast('Lỗi kết nối: ' + e.message, 'error');
        } finally {
            btn.disabled = false;
        }
    }

    // Enter để gửi (Shift+Enter xuống dòng)
    document.querySelectorAll('.fb-cmt-input-row textarea').forEach(ta => {
        ta.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                const id = ta.id.replace('cmtInput-', '');
                sendFeedComment(parseInt(id));
            }
        });
    });
</script>
}
