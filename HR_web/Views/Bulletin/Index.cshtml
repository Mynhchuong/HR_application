@model List<HR_web.Models.Bulletin.BulletinModel>
@{
    var user = ViewBag.CurrentUser as HR_web.Models.Account.UserInfoModel;
    // NV nước ngoài đọc tiêu đề/nội dung bản tiếng Anh (xem BulletinModel.TitleFor).
    var bLang = user?.UiLang ?? "vi";
    ViewData["Title"] = HR_web.Helpers.ExpatText.Dual(bLang, "Bản tin", "Bulletin");
    // D(vi, en) cho HTML, DJ(...) cho chuỗi dựng trong <script> — xem Views/Bulletin/Detail.cshtml.
    Func<string, string, string> D = (vi, en) => HR_web.Helpers.ExpatText.Dual(bLang, vi, en);
    Func<string, string, Microsoft.AspNetCore.Html.IHtmlContent> DJ = (vi, en) =>
        new Microsoft.AspNetCore.Html.HtmlString(
            System.Text.Json.JsonSerializer.Serialize(HR_web.Helpers.ExpatText.Dual(bLang, vi, en)));
}

@section Styles {
<style>
    /* ─── Danh sách gọn (2026-11-19): ảnh nhỏ bên trái + tiêu đề, bấm cả thẻ để đọc.
       Ghim KHÔNG ưu tiên ở đây (ghim chỉ cho trang Home); bài chưa xem lên đầu. ─── */
    .bl-wrap { max-width: 720px; margin: 0 auto; padding: 0 12px 40px; }

    .bl-head { padding: 12px 0 8px; }
    .bl-title-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
    .bl-title { font-size: 1.15rem; font-weight: 800; color: #111827; display: flex; align-items: center; gap: 8px; margin: 0; }
    .bl-unread-total { font-size: .78rem; font-weight: 700; color: #2563eb; background: #dbeafe; padding: 3px 10px; border-radius: 999px; }

    .bl-chips { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
    .bl-chips::-webkit-scrollbar { display: none; }
    .bl-chip {
        flex-shrink: 0; border: 1.5px solid #e5e7eb; background: #fff; color: #374151;
        border-radius: 999px; padding: 7px 14px; font-size: .88rem; font-weight: 700;
        display: inline-flex; align-items: center; gap: 6px; cursor: pointer;
        -webkit-tap-highlight-color: transparent;
    }
    .bl-chip .n { font-size: .75rem; color: #6b7280; font-weight: 700; }
    .bl-chip.active { background: #111827; border-color: #111827; color: #fff; }
    .bl-chip.active .n { color: #d1d5db; }

    .bl-list { display: flex; flex-direction: column; gap: 10px; margin-top: 6px; }
    .bl-item {
        display: flex; gap: 12px; align-items: stretch;
        background: #fff; border-radius: 14px; padding: 10px;
        box-shadow: 0 1px 3px rgba(0,0,0,.07); text-decoration: none; color: inherit;
        border: 1.5px solid transparent; position: relative;
        -webkit-tap-highlight-color: transparent; transition: transform .1s;
    }
    .bl-item:active { transform: scale(.985); background: #f9fafb; }
    .bl-item.unread { border-color: #93c5fd; background: #f8fbff; }
    .bl-thumb {
        width: 96px; height: 96px; flex-shrink: 0; border-radius: 10px;
        object-fit: cover; object-position: top; background: #f3f4f6;
    }
    .bl-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
    .bl-tags { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .bl-tag { font-size: .68rem; font-weight: 800; padding: 2px 8px; border-radius: 6px; letter-spacing: .2px; }
    .bl-tag.HR   { background: #fef3c7; color: #92400e; }
    .bl-tag.CSR  { background: #dcfce7; color: #166534; }
    .bl-tag.Lean { background: #ede9fe; color: #5b21b6; }
    .bl-new { font-size: .68rem; font-weight: 800; color: #fff; background: #2563eb; padding: 2px 8px; border-radius: 6px; }
    .bl-date { font-size: .74rem; color: #9ca3af; margin-left: auto; white-space: nowrap; }
    .bl-name {
        font-size: .95rem; font-weight: 600; color: #1f2937; line-height: 1.35;
        display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
    }
    .bl-item.unread .bl-name { font-weight: 800; color: #111827; }
    .bl-stats { margin-top: auto; display: flex; gap: 14px; font-size: .78rem; color: #6b7280; }
    .bl-stats span { display: inline-flex; align-items: center; gap: 4px; }
    .bl-stats .liked { color: #f59e0b; font-weight: 700; }

    .bl-empty { text-align: center; padding: 50px 20px; color: #9ca3af; }
    .bl-filter-empty { display: none; text-align: center; padding: 40px 20px; color: #9ca3af; font-size: .9rem; }

    @@media (min-width: 768px) {
        .bl-thumb { width: 140px; height: 105px; }
        .bl-name { font-size: 1.02rem; -webkit-line-clamp: 2; }
    }
</style>
}

@{
    // Tên phòng đăng bài — CREATED_ROLE do API tính theo role người tạo (HR/CSR/Lean).
    Func<string?, string> RoleLabel = r => r switch
    {
        "CSR"  => "CSR",
        "Lean" => "Lean",
        _      => D("Nhân sự", "HR")
    };
    string RoleKey(HR_web.Models.Bulletin.BulletinModel b) => b.CREATED_ROLE is "CSR" or "Lean" ? b.CREATED_ROLE! : "HR";
    int unreadTotal = Model.Count(x => x.IS_UNREAD == 1);
}

<div class="bl-wrap">
    <div class="bl-head">
        <div class="bl-title-row">
            <h1 class="bl-title"><i class="bi bi-megaphone-fill" style="color:#f59e0b"></i> @D("Bản tin nội bộ", "Internal bulletin")</h1>
            @if (unreadTotal > 0)
            {
                <span class="bl-unread-total">@unreadTotal @D("bài chưa xem", "unread")</span>
            }
        </div>
        @if (Model.Any())
        {
            <div class="bl-chips" id="blChips">
                <button type="button" class="bl-chip active" data-f="all">@D("Tất cả", "All") <span class="n">@Model.Count</span></button>
                <button type="button" class="bl-chip" data-f="unread">@D("Chưa xem", "Unread") <span class="n">@unreadTotal</span></button>
                <button type="button" class="bl-chip" data-f="HR">@D("Nhân sự", "HR") <span class="n">@Model.Count(x => RoleKey(x) == "HR")</span></button>
                <button type="button" class="bl-chip" data-f="CSR">CSR <span class="n">@Model.Count(x => RoleKey(x) == "CSR")</span></button>
                <button type="button" class="bl-chip" data-f="Lean">Lean <span class="n">@Model.Count(x => RoleKey(x) == "Lean")</span></button>
            </div>
        }
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-warning mt-2">@TempData["ErrorMessage"]</div>
    }

    @if (!Model.Any())
    {
        <div class="bl-empty">
            <img src="@(new Random().Next(2)==0 ? Url.Content("~/assets/img/illustrations/A_nodata.png") : Url.Content("~/assets/img/illustrations/Chi_nodata.png"))" alt="" style="max-width:150px;display:block;margin:0 auto 12px;opacity:.9;" />
            <p>@D("Chưa có bản tin nào.", "No bulletins yet.")</p>
        </div>
    }
    else
    {
        <div class="bl-list" id="blList">
            @foreach (var item in Model)
            {
                var rk = RoleKey(item);
                var posted = item.PUBLISHED_DT ?? item.PUBLISH_FROM;
                <a class="bl-item @(item.IS_UNREAD == 1 ? "unread" : "")" href="@Url.Action("Detail", "Bulletin", new { id = item.ID })"
                   data-role="@rk" data-unread="@item.IS_UNREAD">
                    <img class="bl-thumb" loading="lazy" alt="" onerror="this.onerror=null;this.src='@Url.Content("~/assets/img/bulletin-default-cover.png")'"
                         src="@(string.IsNullOrEmpty(item.COVER_IMG)
                                ? Url.Content("~/assets/img/bulletin-default-cover.png")
                                : Url.Action("GetBulletinImage", "Image", new { fileName = item.COVER_IMG }))" />
                    <div class="bl-info">
                        <div class="bl-tags">
                            @if (item.IS_UNREAD == 1)
                            {
                                <span class="bl-new">@D("MỚI", "NEW")</span>
                            }
                            <span class="bl-tag @rk">@RoleLabel(item.CREATED_ROLE)</span>
                            <span class="bl-date">@posted.ToString("dd/MM")</span>
                        </div>
                        <div class="bl-name">@item.TitleFor(bLang)</div>
                        <div class="bl-stats">
                            <span class="@(item.MY_REACTION != null ? "liked" : "")"><i class="bi @(item.MY_REACTION != null ? "bi-hand-thumbs-up-fill" : "bi-hand-thumbs-up") no-ic3d"></i>@item.REACTION_COUNT</span>
                            <span><i class="bi bi-chat no-ic3d"></i>@item.COMMENT_COUNT</span>
                            <span><i class="bi bi-eye no-ic3d"></i>@item.VIEW_COUNT</span>
                        </div>
                    </div>
                </a>
            }
        </div>
        <div class="bl-filter-empty" id="blFilterEmpty">@D("Không có bản tin nào trong mục này.", "No bulletins in this filter.")</div>
    }
</div>

@section Scripts {
<script>
    // Bộ lọc nhanh (Tất cả / Chưa xem / Nhân sự / CSR / Lean) — lọc ngay trên máy, nhớ lựa chọn lần trước.
    (function () {
        const chips = document.querySelectorAll('#blChips .bl-chip');
        if (!chips.length) return;
        const items = document.querySelectorAll('#blList .bl-item');
        const empty = document.getElementById('blFilterEmpty');
        function apply(f) {
            let shown = 0;
            items.forEach(el => {
                const ok = f === 'all' || (f === 'unread' ? el.dataset.unread === '1' : el.dataset.role === f);
                el.style.display = ok ? '' : 'none';
                if (ok) shown++;
            });
            chips.forEach(c => c.classList.toggle('active', c.dataset.f === f));
            empty.style.display = shown ? 'none' : 'block';
            try { localStorage.setItem('blFilter', f); } catch (e) { }
        }
        chips.forEach(c => c.addEventListener('click', () => apply(c.dataset.f)));
        let saved = 'all';
        try { saved = localStorage.getItem('blFilter') || 'all'; } catch (e) { }
        if (![...chips].some(c => c.dataset.f === saved)) saved = 'all';
        apply(saved);
    })();
</script>
}
