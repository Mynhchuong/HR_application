@model List<HR_web.Models.Bulletin.BulletinModel>
@{
    ViewData["Title"] = "Bản tin";
}

@section Styles {
<style>
    .blt-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
        padding: 12px;
        max-width: 1100px;
        margin: 0 auto;
    }
    @@media (min-width: 768px) {
        .blt-grid { grid-template-columns: repeat(2, 1fr); padding: 20px; gap: 20px; }
    }

    .blt-card {
        background: #fff;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 1px 4px rgba(0,0,0,.08);
        transition: transform .15s ease, box-shadow .2s ease;
        position: relative;
        cursor: pointer;
        display: flex;
        flex-direction: column;
    }
    .blt-card:hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgba(0,0,0,.1); }
    .blt-card.pinned { border: 2px solid #f59e0b; }

    .blt-cover {
        width: 100%; aspect-ratio: 16/9;
        object-fit: cover; background: #f3f4f6;
        display: block;
    }
    .blt-cover-empty {
        display: flex; align-items: center; justify-content: center;
        color: #d1d5db; font-size: 48px;
    }

    .blt-pin-badge {
        position: absolute; top: 10px; left: 10px;
        background: #f59e0b; color: #fff;
        padding: 4px 9px; border-radius: 999px;
        font-size: .72rem; font-weight: 700;
        display: flex; align-items: center; gap: 4px;
        box-shadow: 0 2px 6px rgba(245,158,11,.4);
    }

    .blt-body {
        padding: 12px 14px 14px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }
    .blt-title {
        font-size: 1rem; font-weight: 700; color: #111827;
        line-height: 1.35; margin-bottom: 6px;
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .blt-meta {
        color: #6b7280; font-size: .78rem;
        display: flex; gap: 12px; flex-wrap: wrap;
        margin-top: auto;
    }
    .blt-empty {
        text-align: center; padding: 60px 20px; color: #9ca3af;
    }
    .blt-empty i { font-size: 64px; opacity: .3; display: block; margin-bottom: 12px; }

    .blt-page-header {
        background: linear-gradient(120deg,#fef3c7,#fde68a);
        padding: 18px 20px; margin: 0; color: #92400e;
        font-weight: 800; display: flex; align-items: center; gap: 8px;
    }
</style>
}

<div class="blt-page-header">
    <i class="bi bi-megaphone-fill"></i>
    <span>Bản tin nội bộ</span>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-warning mx-3 mt-3">@TempData["ErrorMessage"]</div>
}

@if (!Model.Any())
{
    <div class="blt-empty">
        <i class="bi bi-megaphone"></i>
        <p>Chưa có bản tin nào.</p>
    </div>
}
else
{
    <div class="blt-grid">
        @foreach (var item in Model)
        {
            <div class="blt-card @(item.IS_PINNED == 1 ? "pinned" : "")"
                 onclick="location.href='@Url.Action("Detail", "Bulletin", new { id = item.ID })'">
                @if (item.IS_PINNED == 1)
                {
                    <div class="blt-pin-badge"><i class="bi bi-pin-angle-fill"></i> Ghim</div>
                }
                @if (!string.IsNullOrEmpty(item.COVER_IMG))
                {
                    <img src="@Url.Action("GetBulletinImage", "Image", new { fileName = item.COVER_IMG })"
                         class="blt-cover" alt="cover" />
                }
                else
                {
                    <div class="blt-cover blt-cover-empty"><i class="bi bi-image"></i></div>
                }
                <div class="blt-body">
                    <div class="blt-title">@item.TITLE</div>
                    <div class="blt-meta">
                        <span><i class="bi bi-calendar3 me-1"></i>đến hết @item.PUBLISH_TO.ToString("dd/MM")</span>
                        <span><i class="bi bi-eye me-1"></i>@item.VIEW_COUNT</span>
                        <span><i class="bi bi-chat me-1"></i>@item.COMMENT_COUNT</span>
                    </div>
                </div>
            </div>
        }
    </div>
}
