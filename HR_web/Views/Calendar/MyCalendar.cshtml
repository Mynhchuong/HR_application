@{
    ViewBag.Title = "Lịch cá nhân";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
/* ── Wrap ──────────────────────────────────────────────── */
.pca-wrap { max-width: 960px; margin: 0 auto; }

/* ── Summary cards ─────────────────────────────────────── */
.pca-summary {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    padding: 4px 0 12px;
}
.pca-sum-card {
    background: #fff;
    border-radius: 12px;
    padding: 12px 14px;
    box-shadow: 0 1px 6px rgba(0,0,0,.07);
    display: flex;
    flex-direction: column;
    gap: 2px;
}
.pca-sum-icon { font-size: 1rem; margin-bottom: 2px; }
.pca-sum-val  { font-size: 1.25rem; font-weight: 700; color: #1e293b; line-height: 1.2; }
.pca-sum-lbl  { font-size: .68rem; color: #94a3b8; text-transform: uppercase; letter-spacing: .04em; }

/* ── Month nav ─────────────────────────────────────────── */
.pca-month-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 8px 0;
}
.pca-nav-btn {
    width: 30px; height: 30px;
    border-radius: 50%;
    border: 1px solid #e2e8f0;
    background: #fff;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    color: #64748b;
    transition: background .12s;
}
.pca-nav-btn:hover { background: #f1f5f9; }
.pca-month-lbl {
    font-size: .95rem;
    font-weight: 700;
    color: #1e293b;
    min-width: 140px;
    text-align: center;
}

/* ── Legend ─────────────────────────────────────────────── */
.pca-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding: 4px 2px 6px;
    font-size: .7rem;
    color: #64748b;
}
.pca-legend span { display: flex; align-items: center; gap: 4px; }
.pca-ldot { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }

/* ── Calendar grid ──────────────────────────────────────── */
.pca-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 3px;
}
.pca-hdr {
    text-align: center;
    font-size: .65rem;
    font-weight: 700;
    color: #94a3b8;
    padding: 5px 0 3px;
    text-transform: uppercase;
    letter-spacing: .04em;
}
.pca-hdr.sun { color: #f87171; }

.pca-cell {
    min-height: 86px;
    border-radius: 8px;
    background: #f8fafc;
    border: 1.5px solid transparent;
    padding: 5px 6px 4px;
    cursor: pointer;
    transition: background .1s, border-color .1s;
    overflow: hidden;
    position: relative;
}
.pca-cell:hover:not(.pca-sun):not(.pca-other) { background: #e0f2fe; }
.pca-cell.pca-today    { border-color: #3b82f6; background: #eff6ff; }
.pca-cell.pca-sun      { background: #fafafa; cursor: default; opacity: .4; }
.pca-cell.pca-other    { opacity: .25; cursor: default; }
.pca-cell.pca-past     { opacity: .8; }
.pca-cell.pca-selected { background: #dbeafe !important; border-color: #2563eb !important; box-shadow: 0 0 0 2px #bfdbfe; }
.pca-cell.pca-gray-day { background: #e2e8f0; }

/* day number */
.pca-daynum {
    font-size: .72rem;
    font-weight: 700;
    color: #475569;
    line-height: 1;
}
.pca-cell.pca-today   .pca-daynum { color: #2563eb; }
.pca-cell.pca-sun     .pca-daynum { color: #f87171; }

/* shift */
.pca-shift {
    font-size: .62rem;
    color: #64748b;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-top: 2px;
}

/* times */
.pca-times {
    font-size: .62rem;
    color: #334155;
    margin-top: 1px;
    display: flex;
    align-items: center;
    gap: 2px;
}
.pca-times .arr { color: #94a3b8; font-size: .55rem; }

/* OT badge */
.pca-ot {
    display: inline-block;
    font-size: .58rem;
    font-weight: 700;
    background: #fff7ed;
    color: #c2410c;
    border-radius: 4px;
    padding: 0 4px;
    margin-top: 2px;
    line-height: 1.6;
}

/* dots row */
.pca-dots {
    display: flex;
    gap: 2px;
    margin-top: 3px;
    flex-wrap: wrap;
}
.pca-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }

/* leave bottom bar */
.pca-leave-bar {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 3px;
    border-radius: 0 0 6px 6px;
}

/* ── Detail panel ───────────────────────────────────────── */
.pca-detail {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 2px 12px rgba(0,0,0,.08);
    padding: 16px 18px;
    margin-top: 12px;
}
.pca-detail-title {
    font-size: .85rem;
    font-weight: 700;
    color: #1e293b;
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 12px;
}
.pca-section-lbl {
    font-size: .65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .05em;
    color: #94a3b8;
    margin: 10px 0 5px;
}
.pca-row {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #f8fafc;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: .78rem;
    color: #334155;
    margin-bottom: 4px;
    flex-wrap: wrap;
}
.pca-row .dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
.pca-row .muted { color: #94a3b8; font-size: .7rem; }
.pca-badge {
    font-size: .63rem;
    font-weight: 600;
    padding: 1px 7px;
    border-radius: 10px;
}
.badge-ok  { background: #dcfce7; color: #166534; }
.badge-pnd { background: #fef9c3; color: #854d0e; }
.badge-rej { background: #fee2e2; color: #991b1b; }
.pca-empty { color: #94a3b8; font-size: .78rem; font-style: italic; text-align: center; padding: 16px 0; }

/* ── Attendance detail grid ─────────────────────────────── */
.att-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 6px;
    background: #f8fafc;
    border-radius: 8px;
    padding: 10px 12px;
    margin-bottom: 4px;
}
.att-item label { display: block; font-size: .62rem; color: #94a3b8; text-transform: uppercase; letter-spacing: .04em; }
.att-item span  { font-size: .8rem; font-weight: 600; color: #1e293b; }

/* ── Missed-punch state ─────────────────────────────────── */
.pca-warn-badge {
    display: inline-block; font-size: .58rem; font-weight: 700;
    background: #dc2626; color: #fff;
    border-radius: 4px; padding: 0 4px; line-height: 1.6; margin-top: 2px;
}
.pca-time-warn { color: #f97316 !important; font-weight: 700; }

/* ── Mobile ─────────────────────────────────────────────── */
@@media (max-width: 576px) {
    .pca-summary { grid-template-columns: repeat(3, 1fr); gap: 6px; }
    .pca-sum-card { padding: 10px 12px; }
    .pca-sum-val  { font-size: 1.1rem; }
    .pca-grid { gap: 2px; }
    .pca-cell { min-height: 54px; padding: 3px 4px 3px; border-radius: 6px; }
    .pca-shift, .pca-times, .pca-ot { display: none; }
    .pca-dots { margin-top: 4px; gap: 2px; }
    .pca-daynum { font-size: .68rem; }
    .pca-month-lbl { font-size: .85rem; min-width: 120px; }
    .pca-legend { gap: 8px; font-size: .68rem; }
    .att-grid { grid-template-columns: repeat(2, 1fr); }
}
@@media (max-width: 375px) {
    .pca-cell { min-height: 46px; }
}
</style>

<div class="container-fluid py-3">
<div class="pca-wrap">

    <!-- Summary -->
    <div class="pca-summary" id="pcaSummary">
        <div class="pca-sum-card">
            <div class="pca-sum-icon text-success"><i class="bi bi-calendar-check"></i></div>
            <div class="pca-sum-val" id="sumWork">--</div>
            <div class="pca-sum-lbl">Ngày làm việc</div>
        </div>
        <div class="pca-sum-card">
            <div class="pca-sum-icon text-primary"><i class="bi bi-calendar-x"></i></div>
            <div class="pca-sum-val" id="sumLeave">--</div>
            <div class="pca-sum-lbl">Ngày nghỉ phép</div>
        </div>
        <div class="pca-sum-card">
            <div class="pca-sum-icon text-warning"><i class="bi bi-clock-history"></i></div>
            <div class="pca-sum-val" id="sumOt">--</div>
            <div class="pca-sum-lbl">Tổng tăng ca</div>
        </div>
    </div>

    <!-- Calendar card -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-3">

            <!-- Month nav -->
            <div class="pca-month-nav">
                <button class="pca-nav-btn" onclick="changeMonth(-1)">
                    <i class="bi bi-chevron-left" style="font-size:.7rem;"></i>
                </button>
                <span class="pca-month-lbl" id="pcaMonthLbl"></span>
                <button class="pca-nav-btn" onclick="changeMonth(1)">
                    <i class="bi bi-chevron-right" style="font-size:.7rem;"></i>
                </button>
            </div>

            <!-- Legend -->
            <div class="pca-legend px-1">
                <span><span class="pca-ldot" style="background:#22c55e;"></span>Chấm công</span>
                <span><span class="pca-ldot" style="background:#f97316;"></span>Tăng ca</span>
                <span><span class="pca-ldot" style="background:#3b82f6;"></span>Ra vào cổng</span>
                <span><span class="pca-ldot" style="background:#a78bfa;"></span>Nghỉ phép</span>
                <span><span class="pca-ldot" style="background:#dc2626;"></span>Quên chấm</span>
            </div>

            <!-- Grid -->
            <div id="pcaGrid" class="pca-grid mt-1"></div>

            <!-- Loading -->
            <div id="pcaLoading" class="text-center py-5 d-none">
                <div class="spinner-border spinner-border-sm text-primary"></div>
                <div class="text-muted text-xs mt-2">Đang tải...</div>
            </div>

            <!-- Detail panel -->
            <div id="pcaDetail" class="pca-detail d-none">
                <div class="pca-detail-title">
                    <i class="bi bi-calendar-event text-primary"></i>
                    <span id="pcaDetailDate"></span>
                </div>
                <div id="pcaDetailBody"></div>
            </div>

        </div>
    </div>

</div>
</div>

@section Scripts {
<script>
(function(){
    const VI_MO = ['Tháng 1','Tháng 2','Tháng 3','Tháng 4','Tháng 5','Tháng 6',
                   'Tháng 7','Tháng 8','Tháng 9','Tháng 10','Tháng 11','Tháng 12'];
    const DOW   = ['T2','T3','T4','T5','T6','T7','CN'];

    const LEAVE_LBL = { AL:'Nghỉ phép năm',CL:'Nghỉ bù',SL:'Nghỉ bệnh',NPL:'Không lương',ML:'Thai sản',BL:'Tang lễ' };
    const GP_LBL    = { OUT:'Ra ngoài',IN:'Vào trong',MID:'Giữa ca' };

    let curY = new Date().getFullYear();
    let curM = new Date().getMonth() + 1;
    let calData   = null;
    let selDay    = null;

    /* ── helpers ── */
    function pad(n){ return String(n).padStart(2,'0'); }
    function fmtKey(y,m,d){ return `${y}-${pad(m)}-${pad(d)}`; }

    function parseD(s){
        if(!s) return null;
        const p = s.split('-');
        return new Date(Date.UTC(+p[0],+p[1]-1,+p[2]));
    }

    function viDate(s){
        const d = parseD(s); if(!d) return s;
        return `${d.getUTCDate()}/${d.getUTCMonth()+1}/${d.getUTCFullYear()}`;
    }

    function esc(s){ return (s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

    function badge(st){
        if(!st) return '';
        const m = {APPROVED:['badge-ok','Đã duyệt'],CONFIRMED:['badge-ok','Xác nhận'],
                   PENDING:['badge-pnd','Chờ duyệt'],REJECTED:['badge-rej','Từ chối']};
        const [c,l] = m[st.toUpperCase()]??['badge-pnd',st];
        return `<span class="pca-badge ${c}">${l}</span>`;
    }

    /* ── load ── */
    function loadMonth(y, m){
        calData = null; selDay = null;
        document.getElementById('pcaDetail').classList.add('d-none');
        document.getElementById('pcaLoading').classList.remove('d-none');
        document.getElementById('pcaGrid').innerHTML = '';
        resetSummary();

        $.get('@Url.Action("GetMonthly", "Calendar")', {year:y, month:m})
         .done(function(res){
            document.getElementById('pcaLoading').classList.add('d-none');
            if(res?.success){
                calData = res.data;
                buildSummary(y, m);
                buildCalendar(y, m);
            } else {
                document.getElementById('pcaGrid').innerHTML =
                    `<div class="text-danger text-xs p-3" style="grid-column:1/-1;">${esc(res?.message??'Lỗi tải dữ liệu')}</div>`;
            }
         })
         .fail(function(){
            document.getElementById('pcaLoading').classList.add('d-none');
            document.getElementById('pcaGrid').innerHTML =
                `<div class="text-danger text-xs p-3" style="grid-column:1/-1;">Lỗi kết nối server</div>`;
         });
    }

    /* ── summary ── */
    function resetSummary(){
        ['sumWork','sumLeave','sumOt'].forEach(id => {
            document.getElementById(id).textContent = '--';
        });
    }

    function buildSummary(y, m){
        const att   = calData?.attendance ?? [];
        const leave = calData?.leave ?? [];

        const workDays = att.filter(a => a.timeIn !== null || a.timeOut !== null).length;
        const totalOt  = att.reduce((s,a) => s + (a.tOt||0), 0);

        // count leave days overlapping this month
        const dFrom = new Date(Date.UTC(y,m-1,1));
        const dTo   = new Date(Date.UTC(y,m-1, new Date(Date.UTC(y,m,0)).getUTCDate()));
        let leaveDays = 0;
        leave.forEach(lv => {
            const s = parseD(lv.from), e = parseD(lv.to);
            if(!s||!e) return;
            const os = s < dFrom ? dFrom : s;
            const oe = e > dTo   ? dTo   : e;
            if(os <= oe){
                // count working days (Mon-Sat) in overlap
                let d = new Date(os.getTime());
                while(d <= oe){
                    if(d.getUTCDay() !== 0) leaveDays++;
                    d.setUTCDate(d.getUTCDate()+1);
                }
            }
        });

        document.getElementById('sumWork').textContent  = workDays + ' ngày';
        document.getElementById('sumLeave').textContent = leaveDays + ' ngày';
        document.getElementById('sumOt').textContent    = totalOt.toFixed(1) + 'h';
    }

    /* ── calendar ── */
    function buildCalendar(y, m){
        document.getElementById('pcaMonthLbl').textContent = `${VI_MO[m-1]}, ${y}`;

        const todayStr = fmtKey(new Date().getFullYear(), new Date().getMonth()+1, new Date().getDate());
        const daysInM  = new Date(Date.UTC(y,m,0)).getUTCDate();
        const dPrevM   = new Date(Date.UTC(y,m-1,0)).getUTCDate();
        const firstDow = new Date(Date.UTC(y,m-1,1)).getUTCDay(); // 0=Sun
        const offset   = (firstDow+6)%7; // Mon-based

        // index maps
        const attMap  = {};
        const gpMap   = {};
        const leaveSet = new Set(); // dates covered by any approved leave

        (calData?.attendance??[]).forEach(a => { attMap[a.date] = a; });
        (calData?.gatePass??[]).forEach(g => {
            if(!gpMap[g.date]) gpMap[g.date] = [];
            gpMap[g.date].push(g);
        });
        (calData?.leave??[]).forEach(lv => {
            let d = parseD(lv.from);
            const e = parseD(lv.to);
            while(d && e && d <= e){
                leaveSet.add(fmtKey(d.getUTCFullYear(), d.getUTCMonth()+1, d.getUTCDate()));
                d.setUTCDate(d.getUTCDate()+1);
            }
        });

        let html = '';

        // headers
        DOW.forEach((h,i) => { html += `<div class="pca-hdr${i===6?' sun':''}">${h}</div>`; });

        // prev month fill
        for(let i=0; i<offset; i++){
            html += `<div class="pca-cell pca-other"><div class="pca-daynum">${dPrevM-offset+1+i}</div></div>`;
        }

        // current month
        for(let d=1; d<=daysInM; d++){
            const key  = fmtKey(y,m,d);
            const dow  = new Date(Date.UTC(y,m-1,d)).getUTCDay();
            const isSun  = dow===0;
            const isToday = key===todayStr;
            const isPast  = key<todayStr;
            const isSel   = key===selDay;
            const att     = attMap[key];
            const hasGp   = !!gpMap[key];
            const hasLeave = leaveSet.has(key);

            const isAbsent      = att && att.timeIn === null && att.timeOut === null;
            const isMissedPunch = att && !isAbsent && !isToday && (att.timeIn === null || att.timeOut === null);

            const isGrayDay = isAbsent || hasLeave;

            let cls = 'pca-cell';
            if(isSun)      cls += ' pca-sun';
            if(isToday)    cls += ' pca-today';
            if(isPast)     cls += ' pca-past';
            if(isSel)      cls += ' pca-selected';
            if(isGrayDay)  cls += ' pca-gray-day';

            let inner = `<div class="pca-daynum">${d}</div>`;

            if(!isSun){
                if(isAbsent){
                } else if(att){
                    // one or both times present (missed punch = one is null)
                    const inClass  = att.timeIn  === null ? ' pca-time-warn' : '';
                    const outClass = att.timeOut === null ? ' pca-time-warn' : '';
                    inner += `<div class="pca-times">
                        <span class="${inClass.trim()}">${esc(att.timeIn??'?')}</span>
                        <span class="arr">→</span>
                        <span class="${outClass.trim()}">${esc(att.timeOut??'?')}</span>
                    </div>`;
                    if(isMissedPunch)
                        inner += `<div class="pca-warn-badge">${att.timeIn===null ? 'Quên chấm vào' : 'Quên chấm ra'}</div>`;
                    else if(att.tOt > 0)
                        inner += `<div class="pca-ot">OT +${att.tOt}h</div>`;
                }

                // dots
                let dots = '';
                if(isMissedPunch)       dots += `<span class="pca-dot" style="background:#dc2626;"></span>`;
                else if(att && !isAbsent) dots += `<span class="pca-dot" style="background:#22c55e;"></span>`;
                if(att?.tOt > 0 && !isAbsent) dots += `<span class="pca-dot" style="background:#f97316;"></span>`;
                if(hasGp)              dots += `<span class="pca-dot" style="background:#3b82f6;"></span>`;
                if(hasLeave)           dots += `<span class="pca-dot" style="background:#a78bfa;"></span>`;
                if(dots) inner += `<div class="pca-dots">${dots}</div>`;

                // leave bottom bar
                if(hasLeave) inner += `<div class="pca-leave-bar" style="background:#a78bfa;"></div>`;
            }

            const click = isSun ? '' : `onclick="selectDay('${key}')"`;
            html += `<div class="${cls}" ${click}>${inner}</div>`;
        }

        // next month fill
        const total = offset + daysInM;
        const rem   = total%7===0 ? 0 : 7-(total%7);
        for(let i=1; i<=rem; i++){
            html += `<div class="pca-cell pca-other"><div class="pca-daynum">${i}</div></div>`;
        }

        document.getElementById('pcaGrid').innerHTML = html;
    }

    /* ── day select ── */
    window.selectDay = function(key){
        if(selDay===key){ selDay=null; document.getElementById('pcaDetail').classList.add('d-none'); }
        else { selDay=key; showDetail(key); }
        buildCalendar(curY, curM);
    };

    function showDetail(key){
        const panel = document.getElementById('pcaDetail');
        document.getElementById('pcaDetailDate').textContent = 'Chi tiết: ' + viDate(key);
        panel.classList.remove('d-none');

        const att    = (calData?.attendance??[]).find(a => a.date===key);
        const gpItems= (calData?.gatePass??[]).filter(g => g.date===key);
        const leaveItems = (calData?.leave??[]).filter(lv => {
            const s=parseD(lv.from), e=parseD(lv.to), d=parseD(key);
            return s&&e&&d&&d>=s&&d<=e;
        });

        if(!att && gpItems.length===0 && leaveItems.length===0){
            document.getElementById('pcaDetailBody').innerHTML =
                `<div class="pca-empty">Không có dữ liệu cho ngày này</div>`;
            return;
        }

        let html = '';

        // Chấm công
        if(att){
            const isAbsent      = att.timeIn === null && att.timeOut === null;
            const isMissedPunch = !isAbsent && (att.timeIn === null || att.timeOut === null);

            if(isAbsent){
                html += `<div class="pca-section-lbl"><i class="bi bi-person-x me-1"></i>Chấm công</div>
                <div class="pca-row" style="background:#e2e8f0;">
                    <span class="dot" style="background:#94a3b8;"></span>
                    <span style="color:#475569;font-weight:600;">Không có dữ liệu chấm công</span>
                </div>`;
            } else {
                const inStyle  = att.timeIn  === null ? 'color:#f97316;font-weight:700;' : '';
                const outStyle = att.timeOut === null ? 'color:#f97316;font-weight:700;' : '';
                html += `<div class="pca-section-lbl"><i class="bi bi-person-check me-1"></i>Chấm công</div>
                <div class="att-grid">
                    <div class="att-item"><label>Tăng ca Thực tế</label><span>${att.tOt > 0 ? att.tOt+'h' : '--'}</span></div>
                    <div class="att-item"><label>Giờ vào</label><span style="${inStyle}">${esc(att.timeIn??'Chưa chấm')}</span></div>
                    <div class="att-item"><label>Giờ ra</label><span style="${outStyle}">${esc(att.timeOut??'Chưa chấm')}</span></div>
                </div>`;

                if(isMissedPunch){
                    html += `<div class="pca-row" style="background:#fffbeb;">
                        <span class="dot" style="background:#f59e0b;"></span>
                        <span style="color:#b45309;font-weight:600;">⚠ ${att.timeIn===null ? 'Quên chấm công vào' : 'Quên chấm công ra'}</span>
                    </div>`;
                }
            }

        }

        // Gate pass
        if(gpItems.length > 0){
            html += `<div class="pca-section-lbl"><i class="bi bi-door-open me-1"></i>Ra vào cổng</div>`;
            gpItems.forEach(g => {
                html += `<div class="pca-row">
                    <span class="dot" style="background:#3b82f6;"></span>
                    <span>${esc(GP_LBL[g.type??'']??g.type??'')}</span>
                    ${badge(g.status)}
                </div>`;
            });
        }

        // Leave
        if(leaveItems.length > 0){
            html += `<div class="pca-section-lbl"><i class="bi bi-calendar-x me-1"></i>Nghỉ phép</div>`;
            leaveItems.forEach(lv => {
                const range = lv.from===lv.to ? viDate(lv.from) : `${viDate(lv.from)} – ${viDate(lv.to)}`;
                html += `<div class="pca-row">
                    <span class="dot" style="background:#a78bfa;"></span>
                    <span>${esc(LEAVE_LBL[lv.leaveType??'']??lv.leaveType??'')}</span>
                    <span class="muted">${esc(range)} · ${lv.days} ngày</span>
                    ${badge(lv.status)}
                </div>`;
            });
        }

        document.getElementById('pcaDetailBody').innerHTML = html;

        if(window.innerWidth <= 576)
            panel.scrollIntoView({behavior:'smooth', block:'start'});
    }

    /* ── month nav ── */
    window.changeMonth = function(delta){
        curM += delta;
        if(curM>12){ curM=1; curY++; }
        if(curM<1) { curM=12; curY--; }
        loadMonth(curY, curM);
    };

    /* ── init ── */
    loadMonth(curY, curM);
})();
</script>
}
