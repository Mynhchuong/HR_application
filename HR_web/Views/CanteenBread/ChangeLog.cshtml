@{
    Layout = "_Layout";
    ViewData["Title"] = "Log Đổi Món";
    var curUser = ViewBag.CurrentUser as HR_web.Models.Account.UserInfoModel;
    var role = curUser?.RoleName;
    var isClerk = role == "Clerk";
    // Xoá / đổi món hàng loạt: chỉ Admin/HR (khớp CanBulkEditLog phía Controller).
    var canBulkEdit = curUser.HasAnyRole("Admin", "HR");   // role chính HOẶC role phòng ban
    var colCount = canBulkEdit ? 10 : 9;
}

@section Styles {
<style>
    .food-badge { display:inline-block; padding:.2rem .55rem; border-radius:99px; font-size:.75rem; font-weight:700; }
    .food-M { background:#fff7ed; color:#c2410c; }
    .food-N { background:#f0f9ff; color:#0369a1; }
    .food-C { background:#f0fdf4; color:#15803d; }
    .food-B { background:#fefce8; color:#b45309; }
    .source-badge { font-size:.7rem; color:#64748b; }
    .cl-loading { padding: 3rem 1rem; text-align: center; color: #94a3b8; }
    .pagination .page-link { cursor: pointer; }
    .pagination .page-item.disabled .page-link { cursor: default; }

    /* Đồng bộ style filter/badge với Danh sách nhân viên (Employee/MyTeam) */
    .filter-select { height:34px; font-size:.8rem; border-radius:8px; border:1.5px solid #e2e8f0; padding:0 8px; outline:none; background:#fff; transition:border-color .18s; }
    .filter-select:focus { border-color:#3b82f6; box-shadow:0 0 0 2px rgba(59,130,246,.12); }
    .search-input { height:34px; font-size:.8rem; border-radius:8px; border:1.5px solid #e2e8f0; padding:0 10px 0 30px; outline:none; background:#fff; transition:border-color .18s; width:140px; }
    .search-input:focus { border-color:#3b82f6; box-shadow:0 0 0 2px rgba(59,130,246,.12); }
    .search-wrap { position:relative; display:inline-flex; align-items:center; }
    .search-wrap i { position:absolute; left:8px; font-size:.75rem; color:#94a3b8; pointer-events:none; }
    .total-badge { background:#eff6ff; color:#1d4ed8; font-size:.75rem; font-weight:700; padding:3px 10px; border-radius:20px; }

    /* Tổng hợp số suất (căn tin chốt số lượng nấu) */
    .sum-wrap { margin: 0 1.5rem .75rem; border:1px solid #e2e8f0; border-radius:12px; overflow:hidden; }
    .sum-head { display:flex; align-items:center; justify-content:space-between; gap:.5rem; flex-wrap:wrap;
                padding:.55rem .9rem; background:#f8fafc; border-bottom:1px solid #e2e8f0; }
    .sum-head h6 { margin:0; font-size:.85rem; font-weight:800; color:#0f172a; }
    .sum-note { font-size:.72rem; color:#64748b; }
    .sum-table { width:100%; border-collapse:collapse; font-size:.82rem; }
    .sum-table th { font-size:.68rem; text-transform:uppercase; letter-spacing:.03em; color:#64748b; font-weight:800;
                    padding:.45rem .6rem; text-align:right; background:#fff; border-bottom:1px solid #f1f5f9; white-space:nowrap; }
    .sum-table th:first-child, .sum-table td:first-child { text-align:left; }
    .sum-table td { padding:.45rem .6rem; text-align:right; border-bottom:1px solid #f8fafc; font-variant-numeric:tabular-nums; white-space:nowrap; }
    .sum-table tr:last-child td { border-bottom:none; }
    .sum-table td.tot { font-weight:800; color:#0f172a; }
    .sum-day { font-weight:700; color:#334155; }
    .sum-meal { font-size:.72rem; color:#64748b; display:block; }
    .sum-scroll { overflow-x:auto; }
    .sum-toggle { cursor:pointer; }
    .sum-toggle .sum-caret { display:inline-block; width:1rem; color:#6366f1; transition:transform .15s; }
    .sum-toggle.open .sum-caret { transform:rotate(90deg); }
    .sum-slot td { background:#fafbff; font-size:.78rem; color:#475569; }
    .sum-slot td:first-child { padding-left:2rem; font-weight:600; }
    .sum-slot.none td:first-child { color:#b45309; }
    .cm-row { display:flex; align-items:center; justify-content:space-between; gap:.5rem; padding:.45rem .6rem; border:1px solid #e2e8f0; border-radius:8px; margin-bottom:.35rem; font-size:.85rem; }
    .cm-log td { font-size:.75rem; padding:.3rem .4rem; }

    @@media (max-width:576px) {
        .filter-bar { flex-wrap:wrap !important; }
        .filter-select { min-width:0 !important; flex:1 1 45%; }
        .search-wrap { flex:1 1 100%; }
        .search-input { width:100%; }
    }
</style>
}

<div class="container-fluid py-4">
@if (canBulkEdit) { @Html.AntiForgeryToken() }
<div class="card">
    <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
        <div class="bg-gradient-primary shadow-primary border-radius-lg pt-3 pb-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h6 class="text-white mb-0"><i class="bi bi-clock-history me-1"></i>Log Đổi Món</h6>
        </div>
    </div>

    <div class="card-body px-0 pt-0 pb-2 mt-3">
        <div class="px-4 pb-2 d-flex align-items-center gap-2 flex-wrap filter-bar">
            <input type="date" id="fFrom" class="filter-select" style="min-width:130px;" />
            <input type="date" id="fTo"   class="filter-select" style="min-width:130px;" />
            <div class="search-wrap">
                <i class="bi bi-search"></i>
                <input type="text" id="fEmp" class="search-input" placeholder="Mã NV">
            </div>
            <select id="fDept" class="filter-select" style="min-width:150px;">
                <option value="">-- Tất cả phòng ban --</option>
            </select>
            <select id="fLine" class="filter-select" style="min-width:130px;" disabled>
                <option value="">-- Tất cả chuyền --</option>
            </select>
            <select id="fWork" class="filter-select" style="min-width:140px;" disabled>
                <option value="">-- Tất cả công đoạn --</option>
            </select>
            <select id="fFood" class="filter-select" style="min-width:130px;">
                <option value="">-- Tất cả loại món --</option>
                <option value="M">🍖 Mặn (M)</option>
                <option value="N">🥗 Nhẹ (N)</option>
                <option value="C">🥦 Chay (C)</option>
                <option value="B">🥐 Bánh (B)</option>
            </select>
            <select id="fShift" class="filter-select" style="min-width:130px;">
                <option value="">-- Tất cả ca --</option>
                <option value="LUNCH">🍱 Bữa ca</option>
                <option value="OT">🌙 Tăng ca</option>
            </select>
            <button class="btn btn-sm btn-dark mb-0" onclick="doSearch()"><i class="bi bi-search me-1"></i>Tìm</button>
            <button class="btn btn-sm btn-outline-secondary mb-0" onclick="resetFilter()" title="Xóa filter"><i class="bi bi-x-lg"></i></button>
            <button class="btn btn-sm btn-success mb-0" onclick="exportExcel()" title="Xuất Excel theo filter đang chọn"><i class="bi bi-file-earmark-excel me-1"></i>Xuất Excel</button>
@if (canBulkEdit)
{
            <a href="@Url.Action("ChangeLogImportTemplate", "CanteenBread")" class="btn btn-sm btn-outline-secondary mb-0" download title="Tải file mẫu import"><i class="bi bi-file-earmark-arrow-down me-1"></i>Tải file mẫu</a>
            <button class="btn btn-sm btn-outline-primary mb-0" onclick="document.getElementById('changelogImportFile').click()" title="Import Excel hàng loạt"><i class="bi bi-file-earmark-arrow-up me-1"></i>Import Excel</button>
            <input type="file" id="changelogImportFile" accept=".xlsx,.xls" class="d-none" onchange="submitChangeLogImport(this.files[0])" />
}
            <span id="totalBadge" class="total-badge ms-1" style="display:none;"></span>
        </div>

        <div class="sum-wrap" id="sumWrap">
            <div class="sum-head">
                <h6><i class="bi bi-calculator me-1"></i>Số suất cần nấu <span class="sum-note fw-normal ms-1">· bấm vào ngày để xem theo giờ nghỉ trưa</span></h6>
@if (canBulkEdit)
{
                <button type="button" class="btn btn-sm btn-outline-primary mb-0 py-1" onclick="openCanteenMail()"><i class="bi bi-alarm me-1"></i>Chốt số lượng &amp; email</button>
}
            </div>
            <div class="sum-scroll">
                <table class="sum-table">
                    <thead><tr><th>Ngày</th><th>🍖 Mặn</th><th>🥗 Nhẹ</th><th>🥦 Chay</th><th>🥐 Bánh</th><th>Tổng</th></tr></thead>
                    <tbody id="sumBody"><tr><td colspan="6" class="cl-loading"><div class="spinner-border spinner-border-sm text-primary"></div></td></tr></tbody>
                </table>
            </div>
        </div>

@if (canBulkEdit)
{
        <div id="bulkBar" class="px-4 pb-2" style="display:none;">
            <div class="d-flex align-items-center gap-2 flex-wrap p-2 rounded" style="background:#fff7ed;border:1px solid #fed7aa;">
                <span id="bulkCount" class="fw-bold text-sm" style="color:#c2410c;"></span>
                <button id="bulkAllHintBtn" type="button" class="btn btn-sm btn-dark mb-0" style="display:none;" onclick="enableSelectAllMatching()">
                    <i class="bi bi-check2-all me-1"></i>
                </button>
                <button class="btn btn-sm btn-warning mb-0" onclick="bulkChangeToMan()">
                    <i class="bi bi-arrow-repeat me-1"></i>Đổi thành Mặn
                </button>
                <button class="btn btn-sm btn-danger mb-0" onclick="bulkDelete()">
                    <i class="bi bi-trash me-1"></i>Xoá bản ghi
                </button>
                <button class="btn btn-sm btn-outline-secondary mb-0" onclick="clearSelection()">Bỏ chọn</button>
            </div>
        </div>
}

        <div class="table-responsive px-4">
            <table class="table align-items-center mb-0 w-100 table-hover table-striped">
                <thead class="bg-light">
                    <tr>
                        @if (canBulkEdit)
                        {
                            <th class="px-2" style="width:32px;"><input type="checkbox" id="chkAll" onclick="toggleSelectAllPage(this)" title="Chọn tất cả trên trang này"></th>
                        }
                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Ngày</th>
                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Mã NV</th>
                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Tên NV</th>
                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Phòng ban</th>
                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Ca</th>
                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Món hiện tại</th>
                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Đổi bởi</th>
                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Nguồn</th>
                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Lần cuối</th>
                    </tr>
                </thead>
                <tbody id="logBody">
                    <tr><td colspan="@colCount" class="cl-loading"><div class="spinner-border text-primary" role="status"></div></td></tr>
                </tbody>
            </table>
        </div>
        <div class="d-flex justify-content-between align-items-center px-4 mt-2 mb-2">
            <div id="paginationCount" class="text-sm text-secondary"></div>
            <nav><ul class="pagination pagination-sm mb-0" id="paginationBar"></ul></nav>
        </div>
    </div>
</div>
</div>

@if (canBulkEdit)
{
<div class="modal fade" id="cmModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header py-2">
        <h6 class="modal-title"><i class="bi bi-alarm me-1"></i>Chốt số lượng &amp; gửi email cho căn tin</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
      </div>
      <div class="modal-body">
        <div id="cmBody"><div class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary"></div></div></div>
      </div>
    </div>
  </div>
</div>
}

@section Scripts {
<script>
let currentPage = 1;
let totalRecords = 0;
const PAGE_SIZE = 50;

const foodLabel = { M:'🍖 Mặn', N:'🥗 Nhẹ', C:'🥦 Chay', B:'🥐 Bánh' };
const shiftLabel = { LUNCH:'🍱 Bữa ca', OT:'🌙 Tăng ca' };

// ── Bulk xoá / đổi món (chỉ Admin/HR) ─────────────────────────────────
const CAN_BULK = @(canBulkEdit.ToString().ToLower());
const COL_COUNT = @colCount;
const AF_TOKEN = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
// key = "empcd|dat|typeMeal" → { empcd, dat, typeMeal }
const selectedKeys = new Map();
// true = "chọn tất cả khớp bộ lọc" (áp cho mọi dòng khớp filter, kể cả ngoài trang đang xem)
let selectAllMatching = false;
// filter object của lần tìm gần nhất — dùng khi selectAllMatching
let lastFilter = {};

const IS_CLERK = @(isClerk.ToString().ToLower());
// Clerk: lấy dept/line/work theo đúng phạm vi HR_USERS_DEPT của mình (GetXByScope tự dùng
// user đang đăng nhập). Admin/HR/Canteen/CSR: lấy toàn bộ công ty như cũ.
const DEPT_URL = IS_CLERK ? '@Url.Action("GetDeptByScope", "Dropdown")' : null;
const LINE_URL = IS_CLERK ? '@Url.Action("GetLineByScope", "Dropdown")' : '@Url.Action("GetLine", "Dropdown")';
const WORK_URL = IS_CLERK ? '@Url.Action("GetWorkByScope", "Dropdown")' : '@Url.Action("GetWork", "Dropdown")';

function esc(s) { return (s ?? '').toString().replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

async function loadDeptList() {
    try {
        const sel = document.getElementById('fDept');
        if (IS_CLERK) {
            const res  = await fetch(DEPT_URL);
            const list = await res.json();
            sel.innerHTML = '<option value="">-- Tất cả phòng ban --</option>' +
                (list || []).map(d => `<option value="${esc(d.id)}">${esc(d.text)}</option>`).join('');
        } else {
            const res  = await fetch('GetDeptList');
            const data = await res.json();
            if (!data.success) return;
            sel.innerHTML = '<option value="">-- Tất cả phòng ban --</option>' +
                (data.data || []).map(d => `<option value="${esc(d.deptcd)}">${esc(d.deptName || d.deptcd)}</option>`).join('');
        }
    } catch { /* ignore */ }
}

// Dept → Line → Work cascading. Đổi dept/line ở trên sẽ reset + khoá lại select con.
document.getElementById('fDept').addEventListener('change', () => onDeptChange());
document.getElementById('fLine').addEventListener('change', () => onLineChange());

async function onDeptChange() {
    const deptcd = document.getElementById('fDept').value;
    const fLine  = document.getElementById('fLine');
    const fWork  = document.getElementById('fWork');
    fLine.innerHTML = '<option value="">-- Tất cả chuyền --</option>';
    fWork.innerHTML = '<option value="">-- Tất cả công đoạn --</option>';
    fWork.disabled = true;

    if (!deptcd) { fLine.disabled = true; return; }
    fLine.disabled = false;
    try {
        const res  = await fetch(`${LINE_URL}?deptCd=${encodeURIComponent(deptcd)}`);
        const list = await res.json();
        fLine.innerHTML += (list || []).map(l => `<option value="${esc(l.id)}">${esc(l.text)}</option>`).join('');
    } catch { /* ignore */ }
}

async function onLineChange() {
    const deptcd = document.getElementById('fDept').value;
    const linecd = document.getElementById('fLine').value;
    const fWork  = document.getElementById('fWork');
    fWork.innerHTML = '<option value="">-- Tất cả công đoạn --</option>';

    if (!linecd) { fWork.disabled = true; return; }
    fWork.disabled = false;
    try {
        const res  = await fetch(`${WORK_URL}?lineCd=${encodeURIComponent(linecd)}&deptCd=${encodeURIComponent(deptcd)}`);
        const list = await res.json();
        fWork.innerHTML += (list || []).map(w => `<option value="${esc(w.id)}">${esc(w.text)}</option>`).join('');
    } catch { /* ignore */ }
}

// Ngày theo giờ máy (VN). Không dùng ISO/UTC: trước 7h sáng sẽ ra ngày hôm qua.
function localYmd(d = new Date()) {
    const p = n => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`;
}

let sumSeq = 0;
// "1115-1215" → "11:15 – 12:15"
function slotLabel(v) {
    const m = /^(\d{2})(\d{2})-(\d{2})(\d{2})$/.exec(v || '');
    return m ? `${m[1]}:${m[2]} – ${m[3]}:${m[4]}` : (v === '-' ? 'Chưa xếp ca' : esc(v || ''));
}
function toggleSlots(tr) {
    tr.classList.toggle('open');
    let n = tr.nextElementSibling;
    while (n && n.classList.contains('sum-slot')) { n.classList.toggle('d-none'); n = n.nextElementSibling; }
}
async function loadSummary() {
    const from = document.getElementById('fFrom').value, to = document.getElementById('fTo').value;
    const qs = new URLSearchParams();
    if (from) qs.set('from', from);
    if (to)   qs.set('to', to);
    for (const [k, id] of [['deptcd','fDept'],['linecd','fLine'],['workcd','fWork']]) {
        const v = document.getElementById(id).value; if (v) qs.set(k, v);
    }
    const body = document.getElementById('sumBody');
    body.innerHTML = '<tr><td colspan="6" class="cl-loading"><div class="spinner-border spinner-border-sm text-primary"></div></td></tr>';
    const my = ++sumSeq;   // bỏ kết quả cũ nếu người dùng bấm Tìm liên tục
    try {
        const res = await fetch('GetChangeLogSummary?' + qs.toString());
        const d = await res.json();
        if (my !== sumSeq) return;
        if (!d.success) { body.innerHTML = `<tr><td colspan="6" class="text-center text-danger py-3">${esc(d.message || 'Lỗi')}</td></tr>`; return; }
        if (!d.data || !d.data.length) { body.innerHTML = '<tr><td colspan="6" class="text-center text-secondary py-3">Không có dữ liệu (Chủ nhật, ngày lễ được bỏ qua)</td></tr>'; return; }
        const n = v => (v || 0).toLocaleString('vi-VN');
        const wd = ['CN','T2','T3','T4','T5','T6','T7'];
        const tot = { lunch:{M:0,N:0,C:0,B:0,total:0}, exp:{M:0,N:0,C:0,B:0,total:0} };
        // Chỉ hiện số CẦN NẤU (= dự kiến thực ăn); số theo đăng ký để trong tooltip
        const cell = (e, r, cls) => `<td${cls ? ` class="${cls}"` : ''} title="Theo đăng ký: ${n(r)}">${n(e)}</td>`;
        const cells = (m, e) => { e = e || m; return ['M','N','C','B'].map(k => cell(e[k], m[k])).join('') + cell(e.total, m.total, 'tot'); };

        const single = d.data.length === 1;   // 1 ngày → mở sẵn bảng theo giờ
        let html = '';
        for (const x of d.data) {
            const dt = new Date(+x.dat.slice(0,4), +x.dat.slice(4,6) - 1, +x.dat.slice(6,8));
            const hasSlots = x.slots && x.slots.length;
            html += `<tr class="${hasSlots ? 'sum-toggle' + (single ? ' open' : '') : ''}"${hasSlots ? ' onclick="toggleSlots(this)"' : ''}>
                <td>${hasSlots ? '<span class="sum-caret">▸</span>' : ''}<span class="sum-day">${wd[dt.getDay()]} ${x.dat.slice(6,8)}/${x.dat.slice(4,6)}</span><span class="sum-meal">🍱 Bữa trưa${x.special ? ' · <b class="text-warning" title="Thực đơn có CA 2 ĐẶC BIỆT — đã tính theo số người đi ăn các ngày đặc biệt trước">⭐ Ngày đặc biệt</b>' : ''}</span></td>
                ${cells(x.lunch, x.expected)}</tr>`;
            for (const sl of (x.slots || [])) {
                html += `<tr class="sum-slot${sl.slot === '-' ? ' none' : ''}${single ? '' : ' d-none'}">
                    <td>🕐 ${slotLabel(sl.slot)}</td>${cells(sl.count, sl.expected)}</tr>`;
            }
            for (const k of ['M','N','C','B','total']) { tot.lunch[k] += x.lunch[k]; tot.exp[k] += (x.expected || x.lunch)[k]; }
        }
        if (d.data.length > 1) {
            html += `<tr style="background:#f8fafc"><td><span class="sum-day">Cộng</span><span class="sum-meal">🍱 Bữa trưa</span></td>
                ${cells(tot.lunch, tot.exp)}</tr>`;
        }
        body.innerHTML = html;
    } catch {
        if (my === sumSeq) body.innerHTML = '<tr><td colspan="6" class="text-center text-danger py-3">Lỗi kết nối</td></tr>';
    }
}

@if (canBulkEdit)
{
<text>
// ── Chốt số lượng + email cho căn tin (Admin/HR) ──
const CM_URL = {
    get:  '@Url.Action("GetCanteenMailConfig", "CanteenBread")',
    save: '@Url.Action("SaveCanteenMailConfig", "CanteenBread")',
    add:  '@Url.Action("AddCanteenMailRecipient", "CanteenBread")',
    del:  '@Url.Action("RemoveCanteenMailRecipient", "CanteenBread")',
    test: '@Url.Action("TestCanteenMail", "CanteenBread")'
};
async function cmPost(url, body) {
    const res = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': AF_TOKEN }, body: JSON.stringify(body || {}) });
    return res.json();
}
function cmDate(s, withTime) {
    const d = new Date(s); if (isNaN(d)) return '';
    const p = v => String(v).padStart(2, '0');
    const wd = ['CN','T2','T3','T4','T5','T6','T7'];
    return (withTime ? `${p(d.getHours())}:${p(d.getMinutes())} ` : '') + `${wd[d.getDay()]} ${p(d.getDate())}/${p(d.getMonth() + 1)}`;
}
function openCanteenMail() {
    bootstrap.Modal.getOrCreateInstance(document.getElementById('cmModal')).show();
    cmLoad();
}
async function cmLoad() {
    const box = document.getElementById('cmBody');
    try {
        const d = await (await fetch(CM_URL.get)).json();
        if (!d.success) { box.innerHTML = `<div class="alert alert-warning text-sm mb-0">${esc(d.message || 'Lỗi')}</div>`; return; }
        const st = { OK: '<span class="badge bg-success">Đã gửi</span>', FAIL: '<span class="badge bg-danger">Lỗi</span>', TEST: '<span class="badge bg-secondary">Gửi thử</span>' };
        const n = v => v == null ? '' : v.toLocaleString('vi-VN');
        box.innerHTML = `
            <div class="d-flex align-items-end gap-2 flex-wrap mb-2">
                <div><label class="form-label text-xs mb-1">Giờ chốt hằng ngày</label>
                     <input type="time" id="cmTime" class="form-control form-control-sm" value="${esc(d.sendTime)}" style="width:120px"></div>
                <div><label class="form-label text-xs mb-1">% dự phòng</label>
                     <div class="input-group input-group-sm" style="width:110px"><input type="number" id="cmBuffer" class="form-control" min="0" max="20" step="0.5" value="${d.bufferPct}"><span class="input-group-text">%</span></div></div>
                <div class="form-check form-switch mb-1"><input class="form-check-input" type="checkbox" id="cmActive" ${d.isActive ? 'checked' : ''}>
                     <label class="form-check-label text-sm" for="cmActive">Bật</label></div>
                <button type="button" class="btn btn-sm btn-primary mb-0" onclick="cmSave()">Lưu</button>
            </div>
            <div class="text-xs text-secondary mb-3">
                Tới giờ chốt: gửi email số suất ăn trưa của <b>ngày làm việc kế tiếp</b> (bỏ Chủ nhật, ngày lễ) theo giờ nghỉ trưa,
                và <b>khoá đổi món</b> bữa trưa ngày đó.<br>
                % dự phòng cộng thêm vào số cần nấu để không bị thiếu: 3% = không ngày nào thiếu (đối chiếu 67 ngày, dư trung bình ~190 suất); giảm xuống thì bớt dư nhưng có ngày thiếu.<br>
                ${d.isActive ? `Lần chốt tới: <b>${cmDate(d.nextSend, true)}</b> → số của <b>${cmDate(d.nextTarget)}</b>` : '<span class="text-danger">Đang tắt — không gửi email, không khoá đổi món.</span>'}
            </div>
            <label class="form-label text-xs mb-1">Email nhận (${d.recipients.length}/${d.max})</label>
            <div id="cmList">${d.recipients.map(x => `<div class="cm-row"><span>${esc(x.email)}</span>
                <button type="button" class="btn btn-link text-danger p-0 mb-0" onclick="cmRemove(${x.id})" aria-label="Xoá"><i class="bi bi-trash"></i></button></div>`).join('')
                || '<div class="text-xs text-secondary mb-2">Chưa có email nào — chưa gửi được.</div>'}</div>
            <div class="input-group input-group-sm mb-2">
                <input type="email" id="cmEmail" class="form-control" placeholder="email@esamho.com" onkeydown="if(event.key==='Enter'){event.preventDefault();cmAdd();}">
                <button type="button" class="btn btn-outline-primary mb-0" onclick="cmAdd()">Thêm</button>
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary mb-3" onclick="cmTest(this)" ${d.recipients.length ? '' : 'disabled'}>
                <i class="bi bi-send me-1"></i>Gửi thử ngay (số ${cmDate(d.nextTarget)})</button>
            ${d.logs.length ? `<label class="form-label text-xs mb-1">Lần gửi gần nhất</label>
            <table class="table table-sm cm-log mb-0"><tbody>${d.logs.map(l => `<tr>
                <td>${cmDate(l.sentDt, true)}</td><td>số ${cmDate(l.targetDat)}</td>
                <td>${st[l.status] || esc(l.status)}</td><td class="text-end">${l.totalExp != null ? n(l.totalExp) + ' suất' : ''}</td>
                </tr>${l.err ? `<tr><td colspan="4" class="text-danger">${esc(l.err)}</td></tr>` : ''}`).join('')}</tbody></table>` : ''}`;
    } catch { box.innerHTML = '<div class="alert alert-danger text-sm mb-0">Lỗi kết nối</div>'; }
}
async function cmSave() {
    const buf = parseFloat(document.getElementById('cmBuffer').value);
    if (isNaN(buf) || buf < 0 || buf > 20) { showToast('% dự phòng phải từ 0 đến 20', 'error'); return; }
    const d = await cmPost(CM_URL.save, { sendTime: document.getElementById('cmTime').value, isActive: document.getElementById('cmActive').checked,
                                          bufferPct: buf });
    showToast(d.success ? 'Đã lưu giờ chốt' : (d.message || 'Lưu thất bại'), d.success ? 'success' : 'error');
    if (d.success) cmLoad();
}
async function cmAdd() {
    const email = document.getElementById('cmEmail').value.trim();
    if (!email) return;
    const d = await cmPost(CM_URL.add, { email });
    if (!d.success) { showToast(d.message || 'Thêm thất bại', 'error'); return; }
    cmLoad();
}
async function cmRemove(id) {
    const d = await cmPost(CM_URL.del, { id });
    if (!d.success) { showToast(d.message || 'Xoá thất bại', 'error'); return; }
    cmLoad();
}
async function cmTest(btn) {
    btn.disabled = true;
    const old = btn.innerHTML;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang gửi...';
    try {
        const d = await cmPost(CM_URL.test, {});
        showToast(d.message || (d.success ? 'Đã gửi' : 'Gửi thất bại'), d.success ? 'success' : 'error');
        cmLoad();
    } catch { showToast('Lỗi kết nối', 'error'); btn.disabled = false; btn.innerHTML = old; }
}
</text>
}

async function doSearch(page = 1) {
    if (page === 1) loadSummary();   // đổi bộ lọc → tính lại; chỉ chuyển trang thì giữ nguyên
    currentPage = page;
    const from     = document.getElementById('fFrom').value;
    const to       = document.getElementById('fTo').value;
    const empcd    = document.getElementById('fEmp').value.trim();
    const deptcd   = document.getElementById('fDept').value;
    const linecd   = document.getElementById('fLine').value;
    const workcd   = document.getElementById('fWork').value;
    const foodType = document.getElementById('fFood').value;
    const typeMeal = document.getElementById('fShift').value;

    // Lưu filter cho chế độ "chọn tất cả khớp bộ lọc". Mỗi lần tìm/chuyển trang đều bỏ chọn cũ
    // để tránh key rác từ trang trước.
    lastFilter = { from, to, empcd, deptcd, linecd, workcd, foodType, typeMeal };
    clearSelection();

    const qs = new URLSearchParams();
    if (from)     qs.set('from',     from);
    if (to)       qs.set('to',       to);
    if (empcd)    qs.set('empcd',    empcd);
    if (deptcd)   qs.set('deptcd',   deptcd);
    if (linecd)   qs.set('linecd',   linecd);
    if (workcd)   qs.set('workcd',   workcd);
    if (foodType) qs.set('foodType', foodType);
    if (typeMeal) qs.set('typeMeal', typeMeal);
    qs.set('page', page);
    qs.set('pageSize', PAGE_SIZE);

    document.getElementById('logBody').innerHTML =
        `<tr><td colspan="${COL_COUNT}" class="cl-loading"><div class="spinner-border text-primary" role="status"></div></td></tr>`;

    const res  = await fetch('GetChangeLog?' + qs.toString());
    const data = await res.json();

    const badge = document.getElementById('totalBadge');

    if (!data.success) {
        document.getElementById('logBody').innerHTML =
            `<tr><td colspan="${COL_COUNT}" class="text-center text-danger py-4">${esc(data.message)}</td></tr>`;
        totalRecords = 0;
        badge.style.display = 'none';
        renderPagination();
        return;
    }

    totalRecords = data.total;
    badge.textContent = `${totalRecords} bản ghi`;
    badge.style.display = totalRecords ? '' : 'none';

    const rows = data.data;
    if (!rows.length) {
        document.getElementById('logBody').innerHTML =
            `<tr><td colspan="${COL_COUNT}" class="text-center text-secondary py-5">Không có dữ liệu</td></tr>`;
        renderPagination();
        return;
    }

    document.getElementById('logBody').innerHTML = rows.map(r => {
        const dat = r.dat ? `${r.dat.slice(6,8)}/${r.dat.slice(4,6)}/${r.dat.slice(0,4)}` : '—';
        const food = r.typeOfFood || '—';
        const badgeHtml = `<span class="food-badge food-${esc(food)}">${foodLabel[food] || esc(food)}</span>`;
        const shift = shiftLabel[r.typeMeal] || esc(r.typeMeal);
        const updtDt = r.updtDt ? new Date(r.updtDt).toLocaleString('vi-VN', {hour:'2-digit',minute:'2-digit',day:'2-digit',month:'2-digit',year:'numeric'}) : '—';
        const source = r.isMysamho
            ? '<span class="source-badge">📱 App</span>'
            : `<span class="source-badge">🖥️ ${esc(r.changeFrom || 'HT')}</span>`;

        const chkCell = CAN_BULK
            ? `<td class="px-2"><input type="checkbox" class="row-chk" data-empcd="${esc(r.empcd)}" data-dat="${esc(r.dat)}" data-meal="${esc(r.typeMeal)}" onclick="onRowCheck(this)"></td>`
            : '';

        return `<tr>
            ${chkCell}
            <td class="px-2 text-sm">${dat}</td>
            <td class="px-2 text-sm font-weight-bold">${esc(r.empcd) || '—'}</td>
            <td class="px-2 text-sm vni-font">${esc(r.empName) || '—'}</td>
            <td class="px-2 text-xs">${esc(r.deptName || r.deptcd) || '—'}</td>
            <td class="px-2 text-xs">${shift}</td>
            <td class="px-2">${badgeHtml}</td>
            <td class="px-2 text-xs">${esc(r.changeFrom) || '—'}</td>
            <td class="px-2">${source}</td>
            <td class="px-2 text-xs text-secondary">${updtDt}</td>
        </tr>`;
    }).join('');

    renderPagination();
    syncCheckboxesToState();
}

