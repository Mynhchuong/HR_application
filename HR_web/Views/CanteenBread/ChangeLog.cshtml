@{
    Layout = "_Layout";
    ViewData["Title"] = "Log Đổi Món";
    var role = (ViewBag.CurrentUser as HR_web.Models.Account.UserInfoModel)?.RoleName;
    var isClerk = role == "Clerk";
    // Xoá / đổi món hàng loạt: chỉ Admin/HR (khớp CanBulkEditLog phía Controller).
    var canBulkEdit = role == "Admin" || role == "HR";
    var colCount = canBulkEdit ? 10 : 9;
}

@section Styles {
<style>
    .food-badge { display:inline-block; padding:.2rem .55rem; border-radius:99px; font-size:.75rem; font-weight:700; }
    .food-M { background:#fff7ed; color:#c2410c; }
    .food-N { background:#f0f9ff; color:#0369a1; }
    .food-C { background:#f0fdf4; color:#15803d; }
    .food-B { background:#fefce8; color:#b45309; }
    .source-badge { font-size:.7rem; color:#64748b; }
    .cl-loading { padding: 3rem 1rem; text-align: center; color: #94a3b8; }
    .pagination .page-link { cursor: pointer; }
    .pagination .page-item.disabled .page-link { cursor: default; }

    /* Đồng bộ style filter/badge với Danh sách nhân viên (Employee/MyTeam) */
    .filter-select { height:34px; font-size:.8rem; border-radius:8px; border:1.5px solid #e2e8f0; padding:0 8px; outline:none; background:#fff; transition:border-color .18s; }
    .filter-select:focus { border-color:#3b82f6; box-shadow:0 0 0 2px rgba(59,130,246,.12); }
    .search-input { height:34px; font-size:.8rem; border-radius:8px; border:1.5px solid #e2e8f0; padding:0 10px 0 30px; outline:none; background:#fff; transition:border-color .18s; width:140px; }
    .search-input:focus { border-color:#3b82f6; box-shadow:0 0 0 2px rgba(59,130,246,.12); }
    .search-wrap { position:relative; display:inline-flex; align-items:center; }
    .search-wrap i { position:absolute; left:8px; font-size:.75rem; color:#94a3b8; pointer-events:none; }
    .total-badge { background:#eff6ff; color:#1d4ed8; font-size:.75rem; font-weight:700; padding:3px 10px; border-radius:20px; }

    @@media (max-width:576px) {
        .filter-bar { flex-wrap:wrap !important; }
        .filter-select { min-width:0 !important; flex:1 1 45%; }
        .search-wrap { flex:1 1 100%; }
        .search-input { width:100%; }
    }
</style>
}

<div class="container-fluid py-4">
@if (canBulkEdit) { @Html.AntiForgeryToken() }
<div class="card">
    <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
        <div class="bg-gradient-primary shadow-primary border-radius-lg pt-3 pb-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h6 class="text-white mb-0"><i class="bi bi-clock-history me-1"></i>Log Đổi Món</h6>
        </div>
    </div>

    <div class="card-body px-0 pt-0 pb-2 mt-3">
        <div class="px-4 pb-2 d-flex align-items-center gap-2 flex-wrap filter-bar">
            <input type="date" id="fFrom" class="filter-select" style="min-width:130px;" />
            <input type="date" id="fTo"   class="filter-select" style="min-width:130px;" />
            <div class="search-wrap">
                <i class="bi bi-search"></i>
                <input type="text" id="fEmp" class="search-input" placeholder="Mã NV">
            </div>
            <select id="fDept" class="filter-select" style="min-width:150px;">
                <option value="">-- Tất cả phòng ban --</option>
            </select>
            <select id="fLine" class="filter-select" style="min-width:130px;" disabled>
                <option value="">-- Tất cả chuyền --</option>
            </select>
            <select id="fWork" class="filter-select" style="min-width:140px;" disabled>
                <option value="">-- Tất cả công đoạn --</option>
            </select>
            <select id="fFood" class="filter-select" style="min-width:130px;">
                <option value="">-- Tất cả loại món --</option>
                <option value="M">🍖 Mặn (M)</option>
                <option value="N">🥗 Nhẹ (N)</option>
                <option value="C">🥦 Chay (C)</option>
                <option value="B">🥐 Bánh (B)</option>
            </select>
            <select id="fShift" class="filter-select" style="min-width:130px;">
                <option value="">-- Tất cả ca --</option>
                <option value="LUNCH">🍱 Bữa ca</option>
                <option value="OT">🌙 Tăng ca</option>
            </select>
            <button class="btn btn-sm btn-dark mb-0" onclick="doSearch()"><i class="bi bi-search me-1"></i>Tìm</button>
            <button class="btn btn-sm btn-outline-secondary mb-0" onclick="resetFilter()" title="Xóa filter"><i class="bi bi-x-lg"></i></button>
            <button class="btn btn-sm btn-success mb-0" onclick="exportExcel()" title="Xuất Excel theo filter đang chọn"><i class="bi bi-file-earmark-excel me-1"></i>Xuất Excel</button>
            <span id="totalBadge" class="total-badge ms-1" style="display:none;"></span>
        </div>

@if (canBulkEdit)
{
        <div id="bulkBar" class="px-4 pb-2" style="display:none;">
            <div class="d-flex align-items-center gap-2 flex-wrap p-2 rounded" style="background:#fff7ed;border:1px solid #fed7aa;">
                <span id="bulkCount" class="fw-bold text-sm" style="color:#c2410c;"></span>
                <button class="btn btn-sm btn-warning mb-0" onclick="bulkChangeToMan()">
                    <i class="bi bi-arrow-repeat me-1"></i>Đổi thành Mặn
                </button>
                <button class="btn btn-sm btn-danger mb-0" onclick="bulkDelete()">
                    <i class="bi bi-trash me-1"></i>Xoá bản ghi
                </button>
                <button class="btn btn-sm btn-outline-secondary mb-0" onclick="clearSelection()">Bỏ chọn</button>
                <span id="bulkAllHint" class="text-xs ms-1" style="display:none;color:#9a3412;"></span>
            </div>
        </div>
}

        <div class="table-responsive px-4">
            <table class="table align-items-center mb-0 w-100 table-hover table-striped">
                <thead class="bg-light">
                    <tr>
                        @if (canBulkEdit)
                        {
                            <th class="px-2" style="width:32px;"><input type="checkbox" id="chkAll" onclick="toggleSelectAllPage(this)" title="Chọn tất cả trên trang này"></th>
                        }
                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Ngày</th>
                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Mã NV</th>
                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Tên NV</th>
                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Phòng ban</th>
                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Ca</th>
                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Món hiện tại</th>
                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Đổi bởi</th>
                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Nguồn</th>
                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Lần cuối</th>
                    </tr>
                </thead>
                <tbody id="logBody">
                    <tr><td colspan="@colCount" class="cl-loading"><div class="spinner-border text-primary" role="status"></div></td></tr>
                </tbody>
            </table>
        </div>
        <div class="d-flex justify-content-between align-items-center px-4 mt-2 mb-2">
            <div id="paginationCount" class="text-sm text-secondary"></div>
            <nav><ul class="pagination pagination-sm mb-0" id="paginationBar"></ul></nav>
        </div>
    </div>
</div>
</div>

@section Scripts {
<script>
let currentPage = 1;
let totalRecords = 0;
const PAGE_SIZE = 50;

const foodLabel = { M:'🍖 Mặn', N:'🥗 Nhẹ', C:'🥦 Chay', B:'🥐 Bánh' };
const shiftLabel = { LUNCH:'🍱 Bữa ca', OT:'🌙 Tăng ca' };

// ── Bulk xoá / đổi món (chỉ Admin/HR) ─────────────────────────────────
const CAN_BULK = @(canBulkEdit.ToString().ToLower());
const COL_COUNT = @colCount;
const AF_TOKEN = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
// key = "empcd|dat|typeMeal" → { empcd, dat, typeMeal }
const selectedKeys = new Map();
// true = "chọn tất cả khớp bộ lọc" (áp cho mọi dòng khớp filter, kể cả ngoài trang đang xem)
let selectAllMatching = false;
// filter object của lần tìm gần nhất — dùng khi selectAllMatching
let lastFilter = {};

const IS_CLERK = @(isClerk.ToString().ToLower());
// Clerk: lấy dept/line/work theo đúng phạm vi HR_USERS_DEPT của mình (GetXByScope tự dùng
// user đang đăng nhập). Admin/HR/Canteen/CSR: lấy toàn bộ công ty như cũ.
const DEPT_URL = IS_CLERK ? '@Url.Action("GetDeptByScope", "Dropdown")' : null;
const LINE_URL = IS_CLERK ? '@Url.Action("GetLineByScope", "Dropdown")' : '@Url.Action("GetLine", "Dropdown")';
const WORK_URL = IS_CLERK ? '@Url.Action("GetWorkByScope", "Dropdown")' : '@Url.Action("GetWork", "Dropdown")';

function esc(s) { return (s ?? '').toString().replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

async function loadDeptList() {
    try {
        const sel = document.getElementById('fDept');
        if (IS_CLERK) {
            const res  = await fetch(DEPT_URL);
            const list = await res.json();
            sel.innerHTML = '<option value="">-- Tất cả phòng ban --</option>' +
                (list || []).map(d => `<option value="${esc(d.id)}">${esc(d.text)}</option>`).join('');
        } else {
            const res  = await fetch('GetDeptList');
            const data = await res.json();
            if (!data.success) return;
            sel.innerHTML = '<option value="">-- Tất cả phòng ban --</option>' +
                (data.data || []).map(d => `<option value="${esc(d.deptcd)}">${esc(d.deptName || d.deptcd)}</option>`).join('');
        }
    } catch { /* ignore */ }
}

// Dept → Line → Work cascading. Đổi dept/line ở trên sẽ reset + khoá lại select con.
document.getElementById('fDept').addEventListener('change', () => onDeptChange());
document.getElementById('fLine').addEventListener('change', () => onLineChange());

async function onDeptChange() {
    const deptcd = document.getElementById('fDept').value;
    const fLine  = document.getElementById('fLine');
    const fWork  = document.getElementById('fWork');
    fLine.innerHTML = '<option value="">-- Tất cả chuyền --</option>';
    fWork.innerHTML = '<option value="">-- Tất cả công đoạn --</option>';
    fWork.disabled = true;

    if (!deptcd) { fLine.disabled = true; return; }
    fLine.disabled = false;
    try {
        const res  = await fetch(`${LINE_URL}?deptCd=${encodeURIComponent(deptcd)}`);
        const list = await res.json();
        fLine.innerHTML += (list || []).map(l => `<option value="${esc(l.id)}">${esc(l.text)}</option>`).join('');
    } catch { /* ignore */ }
}

async function onLineChange() {
    const deptcd = document.getElementById('fDept').value;
    const linecd = document.getElementById('fLine').value;
    const fWork  = document.getElementById('fWork');
    fWork.innerHTML = '<option value="">-- Tất cả công đoạn --</option>';

    if (!linecd) { fWork.disabled = true; return; }
    fWork.disabled = false;
    try {
        const res  = await fetch(`${WORK_URL}?lineCd=${encodeURIComponent(linecd)}&deptCd=${encodeURIComponent(deptcd)}`);
        const list = await res.json();
        fWork.innerHTML += (list || []).map(w => `<option value="${esc(w.id)}">${esc(w.text)}</option>`).join('');
    } catch { /* ignore */ }
}

async function doSearch(page = 1) {
    currentPage = page;
    const from     = document.getElementById('fFrom').value;
    const to       = document.getElementById('fTo').value;
    const empcd    = document.getElementById('fEmp').value.trim();
    const deptcd   = document.getElementById('fDept').value;
    const linecd   = document.getElementById('fLine').value;
    const workcd   = document.getElementById('fWork').value;
    const foodType = document.getElementById('fFood').value;
    const typeMeal = document.getElementById('fShift').value;

    // Lưu filter cho chế độ "chọn tất cả khớp bộ lọc". Mỗi lần tìm/chuyển trang đều bỏ chọn cũ
    // để tránh key rác từ trang trước.
    lastFilter = { from, to, empcd, deptcd, linecd, workcd, foodType, typeMeal };
    clearSelection();

    const qs = new URLSearchParams();
    if (from)     qs.set('from',     from);
    if (to)       qs.set('to',       to);
    if (empcd)    qs.set('empcd',    empcd);
    if (deptcd)   qs.set('deptcd',   deptcd);
    if (linecd)   qs.set('linecd',   linecd);
    if (workcd)   qs.set('workcd',   workcd);
    if (foodType) qs.set('foodType', foodType);
    if (typeMeal) qs.set('typeMeal', typeMeal);
    qs.set('page', page);
    qs.set('pageSize', PAGE_SIZE);

    document.getElementById('logBody').innerHTML =
        `<tr><td colspan="${COL_COUNT}" class="cl-loading"><div class="spinner-border text-primary" role="status"></div></td></tr>`;

    const res  = await fetch('GetChangeLog?' + qs.toString());
    const data = await res.json();

    const badge = document.getElementById('totalBadge');

    if (!data.success) {
        document.getElementById('logBody').innerHTML =
            `<tr><td colspan="${COL_COUNT}" class="text-center text-danger py-4">${esc(data.message)}</td></tr>`;
        totalRecords = 0;
        badge.style.display = 'none';
        renderPagination();
        return;
    }

    totalRecords = data.total;
    badge.textContent = `${totalRecords} bản ghi`;
    badge.style.display = totalRecords ? '' : 'none';

    const rows = data.data;
    if (!rows.length) {
        document.getElementById('logBody').innerHTML =
            `<tr><td colspan="${COL_COUNT}" class="text-center text-secondary py-5">Không có dữ liệu</td></tr>`;
        renderPagination();
        return;
    }

    document.getElementById('logBody').innerHTML = rows.map(r => {
        const dat = r.dat ? `${r.dat.slice(6,8)}/${r.dat.slice(4,6)}/${r.dat.slice(0,4)}` : '—';
        const food = r.typeOfFood || '—';
        const badgeHtml = `<span class="food-badge food-${esc(food)}">${foodLabel[food] || esc(food)}</span>`;
        const shift = shiftLabel[r.typeMeal] || esc(r.typeMeal);
        const updtDt = r.updtDt ? new Date(r.updtDt).toLocaleString('vi-VN', {hour:'2-digit',minute:'2-digit',day:'2-digit',month:'2-digit',year:'numeric'}) : '—';
        const source = r.isMysamho
            ? '<span class="source-badge">📱 App</span>'
            : `<span class="source-badge">🖥️ ${esc(r.changeFrom || 'HT')}</span>`;

        const chkCell = CAN_BULK
            ? `<td class="px-2"><input type="checkbox" class="row-chk" data-empcd="${esc(r.empcd)}" data-dat="${esc(r.dat)}" data-meal="${esc(r.typeMeal)}" onclick="onRowCheck(this)"></td>`
            : '';

        return `<tr>
            ${chkCell}
            <td class="px-2 text-sm">${dat}</td>
            <td class="px-2 text-sm font-weight-bold">${esc(r.empcd) || '—'}</td>
            <td class="px-2 text-sm vni-font">${esc(r.empName) || '—'}</td>
            <td class="px-2 text-xs">${esc(r.deptName || r.deptcd) || '—'}</td>
            <td class="px-2 text-xs">${shift}</td>
            <td class="px-2">${badgeHtml}</td>
            <td class="px-2 text-xs">${esc(r.changeFrom) || '—'}</td>
            <td class="px-2">${source}</td>
            <td class="px-2 text-xs text-secondary">${updtDt}</td>
        </tr>`;
    }).join('');

    renderPagination();
    syncCheckboxesToState();
}

function exportExcel() {
    const from     = document.getElementById('fFrom').value;
    const to       = document.getElementById('fTo').value;
    const empcd    = document.getElementById('fEmp').value.trim();
    const deptcd   = document.getElementById('fDept').value;
    const linecd   = document.getElementById('fLine').value;
    const workcd   = document.getElementById('fWork').value;
    const foodType = document.getElementById('fFood').value;
    const typeMeal = document.getElementById('fShift').value;

    const qs = new URLSearchParams();
    if (from)     qs.set('from',     from);
    if (to)       qs.set('to',       to);
    if (empcd)    qs.set('empcd',    empcd);
    if (deptcd)   qs.set('deptcd',   deptcd);
    if (linecd)   qs.set('linecd',   linecd);
    if (workcd)   qs.set('workcd',   workcd);
    if (foodType) qs.set('foodType', foodType);
    if (typeMeal) qs.set('typeMeal', typeMeal);

    window.location.href = 'ExportExcel?' + qs.toString();
}

function renderPagination() {
    const $count = document.getElementById('paginationCount');
    const $bar   = document.getElementById('paginationBar');
    if (!totalRecords) { $count.textContent = ''; $bar.innerHTML = ''; return; }

    const totalPages = Math.max(1, Math.ceil(totalRecords / PAGE_SIZE));
    const start = (currentPage - 1) * PAGE_SIZE + 1;
    const end   = Math.min(currentPage * PAGE_SIZE, totalRecords);
    $count.innerHTML = `${start}–${end} / <strong>${totalRecords}</strong> bản ghi`;

    const mk = (label, p, disabled, active) => {
        const li = document.createElement('li');
        li.className = 'page-item' + (disabled ? ' disabled' : '') + (active ? ' active' : '');
        const a = document.createElement('a');
        a.className = 'page-link';
        a.innerHTML = label;
        if (!disabled && !active) a.addEventListener('click', () => doSearch(p));
        li.appendChild(a);
        return li;
    };

    $bar.innerHTML = '';
    $bar.appendChild(mk('&lsaquo;', currentPage - 1, currentPage <= 1, false));
    const from = Math.max(1, currentPage - 2), to = Math.min(totalPages, currentPage + 2);
    for (let p = from; p <= to; p++) $bar.appendChild(mk(p, p, false, p === currentPage));
    $bar.appendChild(mk('&rsaquo;', currentPage + 1, currentPage >= totalPages, false));
}

function resetFilter() {
    const todayStr = new Date().toISOString().split('T')[0];
    document.getElementById('fFrom').value = todayStr;
    document.getElementById('fTo').value   = todayStr;
    document.getElementById('fEmp').value  = '';
    document.getElementById('fDept').value = '';
    document.getElementById('fLine').innerHTML = '<option value="">-- Tất cả chuyền --</option>';
    document.getElementById('fLine').disabled  = true;
    document.getElementById('fWork').innerHTML = '<option value="">-- Tất cả công đoạn --</option>';
    document.getElementById('fWork').disabled  = true;
    document.getElementById('fFood').value = '';
    document.getElementById('fShift').value = '';
    doSearch(1);
}

// ══════════════════════════════════════════════════════════════════════
// BULK: xoá / đổi món hàng loạt (chỉ Admin/HR — CAN_BULK)
// ══════════════════════════════════════════════════════════════════════
function pageRowChecks() { return Array.from(document.querySelectorAll('#logBody .row-chk')); }

function keyOf(cb) { return `${cb.dataset.empcd}|${cb.dataset.dat}|${cb.dataset.meal}`; }

// Sau khi render lại bảng: tick lại các checkbox theo state đang giữ + cập nhật thanh công cụ.
function syncCheckboxesToState() {
    if (!CAN_BULK) return;
    pageRowChecks().forEach(cb => {
        cb.checked = selectAllMatching || selectedKeys.has(keyOf(cb));
    });
    const chkAll = document.getElementById('chkAll');
    if (chkAll) {
        const all = pageRowChecks();
        chkAll.checked = all.length > 0 && all.every(cb => cb.checked);
        chkAll.indeterminate = !chkAll.checked && all.some(cb => cb.checked);
    }
    updateBulkBar();
}

function onRowCheck(cb) {
    // Người dùng tự chỉnh từng dòng → thoát chế độ "chọn tất cả khớp bộ lọc".
    if (selectAllMatching) {
        selectAllMatching = false;
        // giữ lại những dòng đang hiện trên trang làm lựa chọn thủ công
        pageRowChecks().forEach(c => { if (c.checked) selectedKeys.set(keyOf(c), rowKeyObj(c)); });
    }
    if (cb.checked) selectedKeys.set(keyOf(cb), rowKeyObj(cb));
    else            selectedKeys.delete(keyOf(cb));
    syncCheckboxesToState();
}

function rowKeyObj(cb) { return { empcd: cb.dataset.empcd, dat: cb.dataset.dat, typeMeal: cb.dataset.meal }; }

function toggleSelectAllPage(master) {
    if (selectAllMatching) selectAllMatching = false;
    pageRowChecks().forEach(cb => {
        cb.checked = master.checked;
        if (master.checked) selectedKeys.set(keyOf(cb), rowKeyObj(cb));
        else                selectedKeys.delete(keyOf(cb));
    });
    syncCheckboxesToState();
}

function enableSelectAllMatching() {
    selectAllMatching = true;
    selectedKeys.clear();
    syncCheckboxesToState();
}

function clearSelection() {
    selectedKeys.clear();
    selectAllMatching = false;
    const chkAll = document.getElementById('chkAll');
    if (chkAll) { chkAll.checked = false; chkAll.indeterminate = false; }
    pageRowChecks().forEach(cb => cb.checked = false);
    updateBulkBar();
}

function updateBulkBar() {
    if (!CAN_BULK) return;
    const bar  = document.getElementById('bulkBar');
    const cnt  = document.getElementById('bulkCount');
    const hint = document.getElementById('bulkAllHint');
    const n = selectAllMatching ? totalRecords : selectedKeys.size;

    if (n === 0) { bar.style.display = 'none'; return; }
    bar.style.display = '';

    if (selectAllMatching) {
        cnt.textContent = `Đang chọn TẤT CẢ ${totalRecords} bản ghi khớp bộ lọc`;
        hint.style.display = '';
        hint.innerHTML = `<a href="javascript:void(0)" onclick="clearSelection()">Bỏ chọn</a>`;
    } else {
        cnt.textContent = `Đã chọn ${selectedKeys.size} bản ghi`;
        // Còn bản ghi khớp bộ lọc ngoài trang hiện tại → gợi ý mở rộng chọn hết.
        const pageChecked = pageRowChecks().filter(c => c.checked).length;
        if (pageChecked === pageRowChecks().length && totalRecords > selectedKeys.size) {
            hint.style.display = '';
            hint.innerHTML = `<a href="javascript:void(0)" onclick="enableSelectAllMatching()">Chọn tất cả ${totalRecords} bản ghi khớp bộ lọc</a>`;
        } else {
            hint.style.display = 'none';
        }
    }
}

function buildBulkPayload(extra) {
    const p = extra ? { ...extra } : {};
    if (selectAllMatching) {
        p.filter = { ...lastFilter };
    } else {
        p.keys = Array.from(selectedKeys.values());
    }
    return p;
}

async function postBulk(url, payload) {
    const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': AF_TOKEN },
        body: JSON.stringify(payload)
    });
    return res.json();
}

function bulkChangeToMan() {
    const n = selectAllMatching ? totalRecords : selectedKeys.size;
    if (!n) return;
    showConfirm(
        `Đổi ${n} bản ghi đã chọn về món Mặn? Ghi đè món hiện tại của những NV này, không thể hoàn tác.`,
        async () => {
            try {
                const data = await postBulk('@Url.Action("LogBulkChangeFood", "CanteenBread")', buildBulkPayload({ newFoodType: 'M' }));
                if (!data.success) { showToast(data.message || 'Đổi món thất bại', 'error'); return; }
                showToast(data.message || `Đã đổi ${data.affected} bản ghi`, 'success');
                clearSelection();
                doSearch(currentPage);
            } catch { showToast('Lỗi kết nối', 'error'); }
        },
        { title: 'Đổi thành Mặn', okText: 'Đổi', okClass: 'btn-warning', icon: 'arrow_forward', iconColor: '#d97706', iconBg: '#fef3c7' }
    );
}

function bulkDelete() {
    const n = selectAllMatching ? totalRecords : selectedKeys.size;
    if (!n) return;
    showConfirm(
        `Xoá hẳn ${n} bản ghi log đổi món đã chọn? KHÔNG thể hoàn tác — NV sẽ quay về món mặc định của hệ thống cho ngày đó.`,
        async () => {
            try {
                const data = await postBulk('@Url.Action("LogBulkDelete", "CanteenBread")', buildBulkPayload());
                if (!data.success) { showToast(data.message || 'Xoá thất bại', 'error'); return; }
                showToast(data.message || `Đã xoá ${data.affected} bản ghi`, 'success');
                clearSelection();
                doSearch(currentPage);
            } catch { showToast('Lỗi kết nối', 'error'); }
        },
        { title: 'Xoá bản ghi', okText: 'Xoá', okClass: 'btn-danger', icon: 'delete', iconColor: '#dc2626', iconBg: '#fee2e2' }
    );
}

