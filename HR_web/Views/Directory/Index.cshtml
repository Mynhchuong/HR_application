@model HR_web.Models.Directory.DirectoryPageModel
@{
    Layout = null;
    ViewData["Title"] = "Tra cứu nhân viên";
    var emp = Model.Employee;
    bool hasResult = !string.IsNullOrWhiteSpace(emp.CName);
    // Trang này Layout=null (không có header/sidenav của app) nên luôn cần 1 đường quay lại, dù
    // vào từ đâu (yêu cầu 2026-10-17): đã đăng nhập → về /Home/Index; CHƯA đăng nhập (vào từ nút ở
    // trang Login, hoặc quét QR ẩn danh) → về lại /Account/Login — không được để trống, vì trước
    // đây case chưa login không hiện nút back nào cả, chỉ còn cách bấm back của trình duyệt.
    bool isLoggedIn = ViewBag.CurrentUser != null;
    string backUrl  = isLoggedIn ? Url.Action("Index", "Home")! : Url.Action("Login", "Account")!;
    string backText = isLoggedIn ? "Về Trang chủ / Back to Home" : "Về Đăng nhập / Back to Login";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0, viewport-fit=cover" />
    <title>@ViewData["Title"] | My SAMHO</title>

    <link href="~/lib/googlefonts/inter.css" rel="stylesheet" />
    <link href="~/lib/googlefonts/material-symbols.css" rel="stylesheet" />

    <style>
        @@font-face {
            font-family: 'Vnitbi__';
            src: url('@Url.Content("~/fonts/Vnitbi__.ttf")') format('truetype');
            font-display: block;
        }
        .vni-font, .vni-font * {
            font-family: 'Vnitbi__', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif !important;
        }

        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        html, body {
            margin: 0; padding: 0;
            font-family: 'Inter', system-ui, sans-serif;
            background: #f8fafc;
            overflow-x: hidden;
            -webkit-text-size-adjust: 100%;
        }

        .dir-container {
            max-width: 600px; margin: 0 auto;
            padding: max(1.25rem, env(safe-area-inset-top)) 1rem calc(2.5rem + env(safe-area-inset-bottom));
        }

        .dir-backbar {
            display: flex; align-items: center; gap: 0.5rem;
            margin-bottom: 1rem; text-decoration: none; color: #4f46e5; font-weight: 700; font-size: 0.9rem;
        }
        .dir-backbar .material-symbols-rounded { font-size: 1.3rem; }

        .dir-search {
            display: flex;
            gap: 0.5rem;
            padding: 1rem;
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.04);
            border: 1px solid rgba(0,0,0,0.04);
            margin-bottom: 1.5rem;
        }
        .dir-search input {
            flex: 1;
            min-width: 0;
            min-height: 46px;
            border: 1.5px solid #e2e8f0;
            border-radius: 14px;
            padding: 0.65rem 1rem;
            background: #f8fafc;
            font-size: 16px;
        }
        .dir-search input:focus { border-color: #4f46e5; outline: none; background: #fff; }
        .dir-search button {
            background: #4f46e5;
            color: #fff;
            border: none;
            border-radius: 14px;
            padding: 0.65rem 1.25rem;
            min-height: 46px;
            font-weight: 700;
            font-size: 1rem;
            touch-action: manipulation;
            display: flex; align-items: center; justify-content: center; gap: 4px;
        }
        .dir-search .scan-btn {
            background: #fff;
            color: #4f46e5;
            border: 1.5px solid #e0e7ff;
            border-radius: 14px;
            min-width: 46px; min-height: 46px;
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0;
            touch-action: manipulation;
        }

        .dir-hint {
            display: flex; align-items: flex-start; gap: 0.6rem;
            background: #eff6ff; border: 1px solid #dbeafe; border-radius: 16px;
            padding: 0.75rem 1rem; margin-bottom: 1.25rem;
            color: #1e40af; font-size: 0.82rem; line-height: 1.4;
        }
        .dir-hint .material-symbols-rounded { font-size: 1.2rem; flex-shrink: 0; }

        /* QR scan modal */
        .qr-modal {
            position: fixed; inset: 0; background: rgba(15,23,42,0.92); z-index: 2000;
            display: flex; flex-direction: column; align-items: center; justify-content: center;
        }
        .qr-modal.d-none { display: none; }
        .qr-modal-close {
            position: absolute; top: max(1rem, env(safe-area-inset-top)); right: 1rem;
            width: 40px; height: 40px; border-radius: 50%; background: rgba(255,255,255,0.15);
            color: #fff; display: flex; align-items: center; justify-content: center; border: none;
        }
        #qr-reader { width: min(92vw, 380px); border-radius: 20px; overflow: hidden; background: #000; }
        .qr-modal-hint {
            color: #e2e8f0; font-size: 0.85rem; text-align: center; margin-top: 1rem; padding: 0 1.5rem;
            max-width: 380px; line-height: 1.5;
        }
        .qr-modal-status { color: #fca5a5; font-size: 0.8rem; text-align: center; margin-top: 0.5rem; min-height: 1.2em; }

        .dir-hero { text-align: center; padding: 1.5rem 1rem; }
        .dir-avatar {
            width: 110px; height: 110px; border-radius: 36px; object-fit: cover;
            border: 4px solid #fff; box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }
        .dir-name { font-size: 1.4rem; font-weight: 800; color: #1e293b; margin: 0.75rem 0 0.25rem; text-transform: uppercase; }
        .dir-role { font-size: 0.9rem; color: #64748b; font-weight: 600; }

        .dept-badges { display: flex; justify-content: center; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.6rem; }
        .dept-badge {
            display: inline-flex; align-items: center; gap: 4px;
            background: #f1f5f9; color: #64748b; font-size: 0.75rem; font-weight: 600;
            padding: 0.3rem 0.7rem; border-radius: 999px;
        }
        .dept-badge .material-symbols-rounded { font-size: 0.9rem; }

        .workcd-image-wrap {
            border-radius: 20px; overflow: hidden; margin-bottom: 1rem; background: #fff;
            box-shadow: 0 4px 15px rgba(0,0,0,0.04); border: 1px solid rgba(0,0,0,0.04);
        }
        .workcd-image-caption {
            font-size: 0.75rem; font-weight: 800; text-transform: uppercase; color: #64748b;
            padding: 0.75rem 1.25rem 0.5rem; letter-spacing: 0.05em;
        }
        .workcd-image-wrap img { display: block; width: 100%; max-height: 280px; object-fit: contain; background: #f8fafc; }
        .workcd-image-fallback {
            display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.4rem;
            padding: 2rem 1rem; color: #94a3b8; font-size: 0.85rem; font-weight: 600;
        }

        .dir-pagination {
            display: flex; align-items: center; justify-content: center; gap: 0.75rem;
            margin: 0.75rem 0 1rem; flex-wrap: wrap;
        }
        .dir-page-btn {
            display: inline-block; padding: 0.4rem 0.9rem; border-radius: 10px;
            border: 1px solid #e2e8f0; color: #4f46e5; font-weight: 600; font-size: 0.85rem;
            text-decoration: none; background: #fff;
        }
        .dir-page-btn.is-disabled { color: #cbd5e1; background: #f8fafc; pointer-events: none; }
        .dir-page-current { font-size: 0.8rem; font-weight: 700; color: #64748b; }

        .group-title { font-size: 0.75rem; font-weight: 800; text-transform: uppercase; color: #64748b; padding: 1rem 1.25rem 0.5rem; letter-spacing: 0.05em; }

        .settings-group {
            background: #fff; border-radius: 24px; overflow: hidden;
            margin-bottom: 1rem; box-shadow: 0 4px 15px rgba(0,0,0,0.02);
            border: 1px solid rgba(0,0,0,0.04);
        }
        .setting-item { display: flex; align-items: flex-start; gap: 0.9rem; padding: 0.9rem 1.25rem; border-bottom: 1px solid #f8fafc; }
        .setting-item:last-child { border-bottom: none; }
        .item-icon {
            width: 34px; height: 34px; border-radius: 10px; background: #f1f5f9;
            display: flex; align-items: center; justify-content: center; color: #4f46e5;
            flex-shrink: 0;
        }
        .item-body { flex: 1; min-width: 0; }
        .item-label { font-size: 0.8rem; font-weight: 600; color: #64748b; }
        .item-value { font-size: 0.95rem; font-weight: 700; color: #4f46e5; margin-top: 2px; word-break: break-word; }

        .history-item { padding: 0.9rem 1.25rem; border-bottom: 1px solid #f8fafc; }
        .history-item:last-child { border-bottom: none; }
        .history-date { font-size: 0.75rem; font-weight: 700; color: #94a3b8; margin-bottom: 0.5rem; }
        .history-row { display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; }
        .history-side { flex: 1; min-width: 0; word-break: break-word; }
        .history-side.is-from { color: #94a3b8; }
        .history-side.is-to { color: #334155; }
        .history-side b { display: block; font-weight: 700; margin-bottom: 2px; }
        .history-side.is-from b { color: #94a3b8; }
        .history-side.is-to b { color: #16a34a; }
        .history-tag {
            display: block; width: fit-content; font-size: 0.65rem; font-weight: 800; letter-spacing: 0.05em;
            padding: 2px 8px; border-radius: 999px; margin-bottom: 6px;
        }
        .history-tag.is-from { background: #f1f5f9; color: #64748b; }
        .history-tag.is-to { background: #dcfce7; color: #16a34a; }
        .history-arrow { color: #4f46e5; font-size: 1.1rem; flex-shrink: 0; }

        .dir-empty { text-align: center; color: #94a3b8; padding: 3rem 1rem; }

        .dir-footer {
            font-size: 10.5px; padding: 15px 0 calc(15px + env(safe-area-inset-bottom));
            color: #9aa0a6; text-align: center; opacity: 0.85; background: #f8f9fa;
        }
    </style>
</head>
<body>
    <div class="dir-container">
        <a class="dir-backbar" href="@backUrl">
            <span class="material-symbols-rounded">arrow_back</span>
            @backText
        </a>
        <form class="dir-search" method="get" asp-action="Index">
            <input type="text" name="empCd" value="@emp.EmpCd" placeholder="Nhập mã số NV (VD: 24092522) / Enter employee ID" autocomplete="off" />
            <button type="submit">
                <span class="material-symbols-rounded" style="font-size:1.1rem;vertical-align:middle;">search</span>
                Tìm
            </button>
            <button type="button" class="scan-btn" onclick="startQrScan()" title="Quét mã QR / Scan QR code">
                <span class="material-symbols-rounded">qr_code_scanner</span>
            </button>
        </form>

        <div class="dir-hint">
            <span class="material-symbols-rounded">info</span>
            <span>Bấm vào biểu tượng <b>quét QR</b> rồi đưa camera vào mã QR trên thẻ nhân viên để xem thông tin ngay — hoặc gõ mã số nhân viên vào ô trên rồi bấm <b>Tìm</b>.<br>
            <span style="opacity:.75">Tap the scan icon and point your camera at the QR code on an employee ID badge — or type the employee ID above and press Search.</span></span>
        </div>

        @if (hasResult)
        {
            <div class="dir-hero">
                <img src="@Url.Action("GetEmployeeImage", "Image", new { empCd = emp.EmpCd })" class="dir-avatar" />
                <div class="dir-name vni-font">@emp.CName</div>
                <div class="dir-role vni-font">@emp.DeptName</div>
                <div class="dept-badges">
                    @if (!string.IsNullOrWhiteSpace(emp.LineName))
                    {
                        <span class="dept-badge">
                            <span class="material-symbols-rounded">view_column</span>
                            <span class="vni-font">@emp.LineName</span>
                        </span>
                    }
                    @if (!string.IsNullOrWhiteSpace(emp.WorkName))
                    {
                        <span class="dept-badge">
                            <span class="material-symbols-rounded">work</span>
                            <span class="vni-font">@emp.WorkName</span>
                        </span>
                    }
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(emp.InterestCd))
            {
                <div id="workcd-image-wrap" class="workcd-image-wrap">
                    <div class="workcd-image-caption">Hình ảnh công việc / Work Employee</div>
                    <div id="workcd-image-fallback" class="workcd-image-fallback">
                        <span class="material-symbols-rounded" style="font-size:1.8rem;">image</span>
                        <div>HR chưa cập nhật hình ảnh</div>
                    </div>
                    <img id="workcd-image" style="display:none;"
                         src="@Url.Action("GetWorkCdImage", "Image", new { interestCd = emp.InterestCd })"
                         alt="Work Employee"
                         onload="this.style.display='block';document.getElementById('workcd-image-fallback').style.display='none';"
                         onerror="this.style.display='none';" />
                </div>
            }

            <div class="settings-group">
                <div class="setting-item">
                    <div class="item-icon"><span class="material-symbols-rounded">badge</span></div>
                    <div class="item-body">
                        <div class="item-label">Mã số NV / Employee ID</div>
                        <div class="item-value">@emp.EmpCd</div>
                    </div>
                </div>
                <div class="setting-item">
                    <div class="item-icon"><span class="material-symbols-rounded">category</span></div>
                    <div class="item-body">
                        <div class="item-label">Phòng ban / Line / Tổ — Department / Line / Work</div>
                        <div class="item-value"><span class="vni-font">@emp.LineName</span> · <span class="vni-font">@emp.WorkName</span></div>
                    </div>
                </div>
                <div class="setting-item">
                    <div class="item-icon"><span class="material-symbols-rounded">engineering</span></div>
                    <div class="item-body">
                        <div class="item-label">Tính chất công việc / Work Nature</div>
                        <div class="item-value">@(emp.DirectYn == "Y" ? "Trực tiếp / Direct" : emp.DirectYn == "N" ? "Gián tiếp / Indirect" : "-")</div>
                    </div>
                </div>
                <div class="setting-item">
                    <div class="item-icon"><span class="material-symbols-rounded">construction</span></div>
                    <div class="item-body">
                        <div class="item-label">Công việc / Work</div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(emp.InterestName))
                    {
                        <div class="item-value vni-font">@emp.InterestName</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(emp.InterestCd))
                    {
                        <div class="item-value">@emp.InterestCd</div>
                    }
                    else
                    {
                        <div class="item-value" style="color:#94a3b8;font-weight:600;font-size:0.85rem;">HR chưa cập nhật / Not updated yet</div>
                    }
                </div>
                <div class="setting-item">
                    <div class="item-icon"><span class="material-symbols-rounded">work_history</span></div>
                    <div class="item-body">
                        <div class="item-label">Ngày vào làm / Hire Date</div>
                        <div class="item-value">@(emp.HireDate?.ToString("dd/MM/yyyy") ?? "-")</div>
                    </div>
                </div>
                <div class="setting-item">
                    <div class="item-icon"><span class="material-symbols-rounded">calendar_today</span></div>
                    <div class="item-body">
                        <div class="item-label">Ngày sinh / Date of Birth</div>
                        <div class="item-value">@(emp.BirthDate?.ToString("dd/MM/yyyy") ?? "-")</div>
                    </div>
                </div>
                <div class="setting-item">
                    <div class="item-icon"><span class="material-symbols-rounded">wc</span></div>
                    <div class="item-body">
                        <div class="item-label">Giới tính / Gender</div>
                        <div class="item-value">@(emp.SexGb == "M" ? "Nam / Male" : emp.SexGb == "F" ? "Nữ / Female" : "-")</div>
                    </div>
                </div>
            </div>

            <div class="group-title">Lịch sử thay đổi Phòng/Line/Tổ — Dept / Line / Work Change History</div>
            int historyTotalPages = Model.ChangeHistory.PageSize > 0
                ? (int)Math.Ceiling(Model.ChangeHistory.Total / (double)Model.ChangeHistory.PageSize)
                : 1;
            @if (Model.ChangeHistory.Items.Any())
            {
                <div class="settings-group">
                    @foreach (var h in Model.ChangeHistory.Items)
                    {
                        <div class="history-item">
                            <div class="history-date">@(h.Dat?.ToString("dd/MM/yyyy") ?? "-")</div>
                            <div class="history-row">
                                <div class="history-side is-from">
                                    <span class="history-tag is-from">TRƯỚC / FROM</span>
                                    <b class="vni-font">@(string.IsNullOrWhiteSpace(h.OldDeptName) ? "-" : h.OldDeptName)</b>
                                    <span class="vni-font">@h.OldLineName</span> · <span class="vni-font">@h.OldWorkName</span>
                                </div>
                                <span class="material-symbols-rounded history-arrow">arrow_forward</span>
                                <div class="history-side is-to">
                                    <span class="history-tag is-to">SAU / TO</span>
                                    <b class="vni-font">@(string.IsNullOrWhiteSpace(h.NewDeptName) ? "-" : h.NewDeptName)</b>
                                    <span class="vni-font">@h.NewLineName</span> · <span class="vni-font">@h.NewWorkName</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="settings-group">
                    <div class="dir-empty" style="padding: 2rem 1rem;">
                        <span class="material-symbols-rounded" style="font-size:1.8rem;">history_toggle_off</span>
                        <div class="mt-2" style="font-size:0.85rem;">Chưa có thông tin / No information yet</div>
                    </div>
                </div>
            }

            @if (historyTotalPages > 1)
            {
                bool historyAtFirst = Model.ChangeHistory.Page <= 1;
                bool historyAtLast  = Model.ChangeHistory.Page >= historyTotalPages;
                <div class="dir-pagination">
                    @if (historyAtFirst)
                    {
                        <span class="dir-page-btn is-disabled">‹ Trước</span>
                    }
                    else
                    {
                        <a class="dir-page-btn" href="@Url.Action("Index", new { empCd = emp.EmpCd, historyPage = Model.ChangeHistory.Page - 1 })">‹ Trước</a>
                    }
                    <span class="dir-page-current">Trang @Model.ChangeHistory.Page / @historyTotalPages</span>
                    @if (historyAtLast)
                    {
                        <span class="dir-page-btn is-disabled">Sau ›</span>
                    }
                    else
                    {
                        <a class="dir-page-btn" href="@Url.Action("Index", new { empCd = emp.EmpCd, historyPage = Model.ChangeHistory.Page + 1 })">Sau ›</a>
                    }
                </div>
            }
        }
        else if (!string.IsNullOrWhiteSpace(emp.EmpCd))
        {
            <div class="dir-empty">
                <span class="material-symbols-rounded" style="font-size:2.5rem;">person_search</span>
                <div class="mt-2">Không tìm thấy mã NV "@emp.EmpCd" / Employee not found</div>
            </div>
        }
        else
        {
            <div class="dir-empty">
                <span class="material-symbols-rounded" style="font-size:2.5rem;">badge</span>
                <div class="mt-2">Nhập mã số NV hoặc quét QR trên thẻ để tra cứu<br><span style="opacity:.7">Enter an employee ID or scan a badge QR code to look up information</span></div>
            </div>
        }
    </div>

    <footer class="dir-footer">© 2026 VietNam Samho Co., LTD · Powered by IT Team</footer>

    <!-- QR scan modal — quét mã QR trên thẻ nhân viên để tra cứu nhanh (yêu cầu 2026-10-17) -->
    <div class="qr-modal d-none" id="qrModal">
        <button type="button" class="qr-modal-close" onclick="closeQrScanner()">
            <span class="material-symbols-rounded">close</span>
        </button>
        <div id="qr-reader"></div>
        <div class="qr-modal-hint">Đưa camera vào mã QR trên thẻ nhân viên.<br><span style="opacity:.7">Point the camera at the QR code on an employee ID badge.</span></div>
        <div class="qr-modal-status" id="qrStatus"></div>
    </div>

    <script src="~/lib/html5-qrcode/html5-qrcode.min.js"></script>
    <script src="~/js/native-scanner.js" asp-append-version="true"></script>
    <script>
        var qrScanner = null;
        var qrBusy = false;

        // Quét gốc của app (Android: Google Code Scanner, iOS: VisionKit) — nhanh, tự lấy nét, nhạy
        // hơn hẳn quét trong trang bằng JS, nhất là với QR mật độ dày (thẻ NV thường mã hoá cả URL dài
        // chứ không chỉ mã NV) — qua helper dùng chung native-scanner.js (yêu cầu 2026-10-26: trang
        // mới cần quét chỉ cần gọi NativeScanner.scan(...), không cần sửa code iOS/Android nữa).
        // Không có native -> rơi về quét trong trang (openQrScanner) như cũ.
        function startQrScan() {
            var started = window.NativeScanner.scan({
                onResult: function (code) { handleQrCode(code); },
                onCancel: function () {},
                onError: function (msg) {
                    if (msg === 'camera_denied') {
                        alert('Chưa cấp quyền camera cho ứng dụng. Vào Cài đặt để bật.\nPlease allow camera access in Settings.');
                        return;
                    }
                    openQrScanner();   // rơi về quét trong trang
                }
            });
            if (!started) openQrScanner();
        }

        function openQrScanner() {
            document.getElementById('qrModal').classList.remove('d-none');
            document.getElementById('qrStatus').textContent = '';
            qrBusy = false;
            qrScanner = new Html5Qrcode("qr-reader");
            qrScanner.start(
                { facingMode: "environment" },
                { fps: 10, qrbox: { width: 240, height: 240 } },
                onQrScanSuccess,
                function () { /* decode failure per frame — ignore, keeps scanning */ }
            ).catch(function (err) {
                document.getElementById('qrStatus').textContent =
                    'Không mở được camera / Could not access camera: ' + (err && err.message ? err.message : err);
            });
        }

        function closeQrScanner() {
            document.getElementById('qrModal').classList.add('d-none');
            if (qrScanner) {
                qrScanner.stop().then(function () { qrScanner.clear(); }).catch(function () {});
                qrScanner = null;
            }
        }

        // QR trên thẻ NV là 1 link, mã NV nằm ở cuối (query param hoặc segment cuối) — thử parse
        // như URL trước, fallback lấy nguyên chuỗi số/chữ cuối nếu không phải URL hợp lệ.
        function extractEmpCd(text) {
            text = (text || '').trim();
            try {
                var url = new URL(text);
                var fromQuery = url.searchParams.get('empCd') || url.searchParams.get('empcd');
                if (fromQuery) return fromQuery;
                var segments = url.pathname.split('/').filter(Boolean);
                if (segments.length) return segments[segments.length - 1];
            } catch (e) { /* not a URL — dùng nguyên text */ }
            return text;
        }

        function onQrScanSuccess(decodedText) {
            if (qrBusy) return;
            qrBusy = true;
            handleQrCode(decodedText);
        }

        // Dùng chung cho cả luồng quét trong trang (html5-qrcode) VÀ luồng native (Android/iOS) — xử lý
        // xong thì điều hướng sang trang có kết quả tra cứu NV.
        function handleQrCode(decodedText) {
            var empCd = extractEmpCd(decodedText);
            if (!empCd) {
                var statusEl = document.getElementById('qrStatus');
                if (statusEl) statusEl.textContent = 'Mã QR không chứa mã số nhân viên / QR code did not contain an employee ID.';
                else alert('Mã QR không chứa mã số nhân viên / QR code did not contain an employee ID.');
                qrBusy = false;
                return;
            }
            var statusEl = document.getElementById('qrStatus');
            if (statusEl) statusEl.textContent = 'Đã tìm thấy / Found: ' + empCd + ' — đang tải / loading...';
            var url = new URL(window.location.href);
            url.searchParams.set('empCd', empCd);
            url.searchParams.delete('historyPage');
            window.location.href = url.toString();
        }
    </script>
</body>
</html>
