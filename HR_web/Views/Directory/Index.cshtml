@model HR_web.Models.Directory.DirectoryPageModel
@{
    // ════════════════════════════════════════════════════════════════════════════════
    // BẢN CHƯA ĐĂNG NHẬP — trang đứng một mình, KHÔNG có sidenav/header của app.
    // Vào từ nút ở trang Login hoặc quét QR ẩn danh, lúc đó chưa biết NV là ai nên không
    // dựng được menu -> giữ Layout = null và hiện thanh "Về Đăng nhập".
    // Đã đăng nhập thì DirectoryController trả về IndexInApp.cshtml (có menu) — xem ghi chú
    // ở ViewNameFor() trong controller.
    // Nội dung/CSS/JS nằm ở 3 partial _Directory*.cshtml dùng chung cho cả 2 bản.
    // ════════════════════════════════════════════════════════════════════════════════
    Layout = null;
    ViewData["Title"] = "Tra cứu nhân viên";
    ViewData["DirectoryInApp"] = false;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0, viewport-fit=cover" />
    <title>@ViewData["Title"] | My SAMHO</title>

    <link href="~/lib/googlefonts/inter.css" rel="stylesheet" />
    <link href="~/lib/googlefonts/material-symbols.css" rel="stylesheet" />

    @* Reset chỉ dành cho bản đứng một mình (không có layout app lo giùm). Bản in-app KHÔNG
       dùng khối này — xem ghi chú trong _DirectoryStyles.cshtml. *@
    <style>
        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        html, body {
            margin: 0; padding: 0;
            font-family: 'Inter', system-ui, sans-serif;
            background: #f8fafc;
            overflow-x: hidden;
            -webkit-text-size-adjust: 100%;
        }
    </style>

    <partial name="_DirectoryStyles" />
</head>
<body>
    <partial name="_DirectoryContent" model="Model" />
    <partial name="_DirectoryScripts" />
</body>
</html>
