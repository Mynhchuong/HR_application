@{
    ViewData["Title"] = "Toàn bộ nhân viên công ty";
}

@section Styles {
<style>
    .filter-select { height:34px; font-size:.8rem; border-radius:8px; border:1.5px solid #e2e8f0; padding:0 8px; outline:none; background:#fff; transition:border-color .18s; }
    .filter-select:focus { border-color:#3b82f6; box-shadow:0 0 0 2px rgba(59,130,246,.12); }
    .search-input { height:34px; font-size:.8rem; border-radius:8px; border:1.5px solid #e2e8f0; padding:0 10px 0 30px; outline:none; background:#fff; transition:border-color .18s; width:160px; }
    .search-input:focus { border-color:#3b82f6; box-shadow:0 0 0 2px rgba(59,130,246,.12); }
    .search-wrap { position:relative; display:inline-flex; align-items:center; }
    .search-wrap i { position:absolute; left:8px; font-size:.75rem; color:#94a3b8; pointer-events:none; }
    .total-badge { background:#eff6ff; color:#1d4ed8; font-size:.75rem; font-weight:700; padding:3px 10px; border-radius:20px; }

    /* OT hour chips */
    .ot-chip { display:inline-flex; align-items:center; gap:4px; font-size:.72rem; font-weight:700; padding:3px 9px; border-radius:14px; line-height:1; white-space:nowrap; }
    .ot-chip i { font-size:.7rem; }
    .ot-chip.m { background:#ecfdf5; color:#047857; }
    .ot-chip.y { background:#fef3c7; color:#b45309; }
    .ot-chip.zero { background:#f1f5f9; color:#94a3b8; }

    /* Phép năm còn lại chip */
    .leave-chip { display:inline-flex; align-items:center; gap:4px; font-size:.72rem; font-weight:700; padding:3px 9px; border-radius:14px; line-height:1; white-space:nowrap; }
    .leave-chip i { font-size:.7rem; }
    .leave-chip.ok   { background:#eff6ff; color:#1d4ed8; }
    .leave-chip.low  { background:#fef3c7; color:#b45309; }
    .leave-chip.none { background:#fee2e2; color:#b91c1c; }

    /* Ca làm việc chip */
    .shift-chip { display:inline-flex; align-items:center; gap:4px; font-size:.72rem; font-weight:700; padding:3px 9px; border-radius:14px; line-height:1; white-space:nowrap; }
    .shift-chip i { font-size:.7rem; }
    .shift-chip.day   { background:#fffbeb; color:#b45309; }
    .shift-chip.night { background:#eef2ff; color:#4338ca; }

    /* Chưa đăng nhập lần đầu badge */
    .badge-no-login { display:inline-flex; align-items:center; gap:3px; font-size:.65rem; font-weight:700; padding:2px 7px; border-radius:10px; background:#fef3c7; color:#b45309; margin-left:6px; white-space:nowrap; }

    /* Cột NV gộp mã + tên */
    .emp-name-row { font-weight: 700; color: #1e293b; }
    .emp-meta { font-size:.72rem; color:#94a3b8; font-family: monospace; }

    /* Cột Bộ phận/Line/Nhóm gộp */
    .dept-line { font-size:.75rem; line-height:1.4; }
    .dept-line .lbl { color:#94a3b8; }

    /* Filter toggle chip */
    .filter-toggle { display:inline-flex; align-items:center; gap:5px; font-size:.75rem; font-weight:600; padding:5px 10px; border-radius:16px; border:1.5px solid #e2e8f0; background:#fff; color:#64748b; cursor:pointer; user-select:none; transition:all .18s; }
    .filter-toggle:hover { border-color:#f59e0b; color:#b45309; }
    .filter-toggle.active { background:#fef3c7; border-color:#f59e0b; color:#b45309; }
    .filter-toggle input { display:none; }

    /* Mobile badges row spacing */
    .mt-card .mt-badges-row { display:flex; flex-wrap:wrap; gap:6px; margin-top:6px; }
    .mt-card .mt-badge-item { display:inline-flex; padding:0; background:transparent; }

    /* Combobox tìm kiếm riêng cho "Công việc thực hiện" — chữ VNI (font Vnitbi__) không hiện đúng
       trong option của select gốc trên nhiều trình duyệt (popup native bỏ qua font-family của
       trang), nên phải tự vẽ dropdown bằng div mới áp font được (yêu cầu 2026-10-17). */
    .combo-wrap { position:relative; display:inline-block; }
    .combo-display { height:34px; font-size:.8rem; border-radius:8px; border:1.5px solid #e2e8f0; padding:0 8px; outline:none; background:#fff; cursor:pointer; min-width:170px; }
    .combo-display:focus { border-color:#3b82f6; box-shadow:0 0 0 2px rgba(59,130,246,.12); }
    .combo-panel { position:absolute; top:calc(100% + 4px); left:0; z-index:1050; background:#fff; border:1px solid #e2e8f0; border-radius:10px; box-shadow:0 8px 24px rgba(0,0,0,.12); width:280px; max-height:320px; display:flex; flex-direction:column; }
    .combo-search { width:100%; box-sizing:border-box; padding:8px 10px; border:none; border-bottom:1px solid #f1f5f9; font-size:.8rem; outline:none; border-radius:10px 10px 0 0; }
    .combo-options { overflow-y:auto; }
    .combo-option { padding:7px 12px; font-size:.8rem; cursor:pointer; }
    .combo-option:hover { background:#fef2f2; }
    .combo-option.active { background:#fee2e2; font-weight:700; }
    .combo-option.placeholder { color:#94a3b8; }

    @@media (max-width:576px) {
        .filter-bar { flex-wrap:wrap !important; }
        .search-input { width:120px; }
        .filter-select { min-width:0 !important; flex:1 1 45%; }
        .search-wrap { flex:1 1 100%; }
        .search-input { width:100%; }
    }
</style>
}

<div class="container-fluid py-4">
<div class="card">

    <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
        <div class="bg-gradient-primary shadow-primary border-radius-lg pt-3 pb-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h6 class="text-white mb-0"><i class="bi bi-people-fill me-1"></i> Toàn bộ nhân viên công ty</h6>
            <button class="btn btn-sm btn-white mb-0" onclick="exportExcel()" id="btnExport">
                <i class="bi bi-file-earmark-excel me-1"></i> Xuất Excel
            </button>
        </div>
    </div>

    <div class="card-body px-0 pt-0 pb-2 mt-3">

        <!-- Filter bar -->
        <div class="px-4 pb-2 d-flex align-items-center gap-2 flex-wrap filter-bar">
            <div class="search-wrap">
                <i class="bi bi-search"></i>
                <input type="text" id="searchInput" class="search-input" placeholder="Mã NV / Tên..."
                       oninput="onSearch()">
            </div>
            <select id="deptFilter" class="filter-select" onchange="onDeptChange()" style="min-width:130px;">
                <option value="">-- Bộ phận --</option>
            </select>
            <select id="lineFilter" class="filter-select" onchange="onLineChange()" style="min-width:130px;">
                <option value="">-- Line --</option>
            </select>
            <select id="workFilter" class="filter-select" onchange="onWorkChange()" style="min-width:140px;">
                <option value="">-- Nhóm việc --</option>
            </select>
            <select id="shiftFilter" class="filter-select" onchange="onShiftChange()" style="min-width:140px;">
                <option value="">-- Ca làm việc --</option>
            </select>
            <select id="positionFilter" class="filter-select" onchange="onPositionChange()" style="min-width:140px;">
                <option value="">-- Chức vụ --</option>
            </select>
            <div class="combo-wrap" id="hardworkCombo">
                <input type="text" id="hardworkDisplay" class="combo-display" readonly
                       placeholder="-- Công việc thực hiện --" onclick="toggleHardworkPanel()">
                <input type="hidden" id="hardworkFilter" value="">
                <div class="combo-panel d-none" id="hardworkPanel">
                    <input type="text" id="hardworkSearch" class="combo-search" placeholder="Tìm công việc..." oninput="filterHardworkOptions()">
                    <div class="combo-options" id="hardworkOptionsBox"></div>
                </div>
            </div>
            <label class="filter-toggle" id="noLoginToggleLabel" title="Chỉ hiện nhân viên chưa đăng nhập lần nào">
                <input type="checkbox" id="noLoginToggle" onchange="onNoLoginToggle()">
                <i class="bi bi-person-x"></i> Chưa đăng nhập lần đầu
            </label>
            <button class="btn btn-sm btn-outline-secondary mb-0" onclick="resetFilters()" title="Xóa filter">
                <i class="bi bi-x-lg"></i>
            </button>
            <span id="totalBadge" class="total-badge ms-1" style="display:none;"></span>
        </div>

        <!-- Table -->
        <div class="table-responsive px-4">
            <table class="table align-items-center mb-0 w-100 table-hover table-striped">
                <thead class="bg-light">
                    <tr>
                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2" data-mobile="hidden">#</th>
                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2" data-mobile="primary" data-mobile-slot="name" data-mobile-label="Nhân viên">Nhân viên</th>
                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2" data-mobile="detail" data-mobile-label="Công việc">Công việc</th>
                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2" data-mobile="detail" data-mobile-label="Bộ phận / Line / Nhóm">Bộ phận / Line / Nhóm</th>
                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2" data-mobile="detail" data-mobile-label="SĐT">SĐT</th>
                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2" data-mobile="detail" data-mobile-label="Email">Email</th>
                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2 text-end" data-mobile="primary" data-mobile-label="TC tháng">TC tháng</th>
                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2 text-end" data-mobile="primary" data-mobile-label="TC năm">TC năm</th>
                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2 text-end" data-mobile="detail" data-mobile-label="Phép năm còn lại">Phép năm còn lại</th>
                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2" data-mobile="detail" data-mobile-label="Ca làm việc">Ca làm việc</th>
                    </tr>
                </thead>
                <tbody id="tableBody"></tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center px-4 mt-2 mb-2">
            <div id="pageCount" class="text-sm text-secondary"></div>
            <nav><ul class="pagination pagination-sm mb-0" id="pagination"></ul></nav>
        </div>

    </div>
</div>
</div>

@section Scripts {
<script>
const DATA_URL    = '@Url.Action("GetAllEmployeesData","Employee")';
const FILTERS_URL = '@Url.Action("GetAllEmployeesFilters","Employee")';
const EXPORT_URL  = '@Url.Action("ExportAllEmployeesExcel","Employee")';
const NO_DATA_IMG = '@(new Random().Next(2)==0 ? Url.Content("~/assets/img/illustrations/A_nodata.png") : Url.Content("~/assets/img/illustrations/Chi_nodata.png"))';

let scopeTuples = [];
let shiftOptions = [];
let positionOptions = [];
let hardworkOptions = [];
let page = 1, totalPages = 1, totalRows = 0;
const PAGE_SIZE = 25;
let searchTimer;

function escHtml(s) { return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function fmtH(n) { const v = Number(n)||0; return v.toLocaleString('vi-VN',{minimumFractionDigits:0, maximumFractionDigits:1}); }
function otChipM(n) { const v = Number(n)||0; return `<span class="ot-chip ${v>0?'m':'zero'}" title="Giờ tăng ca trong tháng"><i class="bi bi-calendar3"></i>${fmtH(v)}h</span>`; }
function otChipY(n) { const v = Number(n)||0; return `<span class="ot-chip ${v>0?'y':'zero'}" title="Giờ tăng ca trong năm"><i class="bi bi-calendar-week"></i>${fmtH(v)}h</span>`; }
function leaveChip(n) { const v = Number(n)||0; const cls = v<=0?'none':(v<=3?'low':'ok'); return `<span class="leave-chip ${cls}" title="Số ngày phép năm còn lại"><i class="bi bi-calendar-check"></i>${v} ngày</span>`; }
function shiftChip(d) {
    if (!d.SHIFT_CD) return '<span class="text-secondary text-xs">—</span>';
    const isNight = (d.SHIFT_TIME||'').split('-').length===2 && d.SHIFT_TIME.split('-')[0] > d.SHIFT_TIME.split('-')[1];
    return `<span class="shift-chip ${isNight?'night':'day'}" title="${escHtml(d.SHIFT_TYPE)}"><i class="bi bi-${isNight?'moon-stars':'sun'}"></i>${escHtml(d.SHIFT_CD)} (${d.SHIFT_TIME})</span>`;
}
// Công việc thực hiện (HARDWORK_TEN) + Chức vụ (POSITION_NAME) gộp 1 cột — chức vụ hiện nhỏ, mờ
// hơn trong dấu ngoặc (yêu cầu 2026-10-16: 2 field khác nhau nhưng hiện chung 1 cột cho gọn).
function workCell(d) {
    if (!d.HARDWORK_TEN && !d.POSITION_NAME) return '<span class="text-secondary">—</span>';
    if (!d.HARDWORK_TEN) return escHtml(d.POSITION_NAME);
    const posSuffix = d.POSITION_NAME ? ` <span class="text-secondary" style="font-size:.68rem">(${escHtml(d.POSITION_NAME)})</span>` : '';
    return escHtml(d.HARDWORK_TEN) + posSuffix;
}

// ── Dropdowns (1 lần, dữ liệu nhỏ — không phụ thuộc tổng số NV trong scope) ──
function loadFilters() {
    $.ajax({
        url: FILTERS_URL, type: 'GET',
        success: function(res) {
            if (!res.success) return;
            scopeTuples     = res.data      || [];
            shiftOptions    = res.shifts    || [];
            positionOptions = res.positions || [];
            hardworkOptions = res.hardworks || [];
            buildDropdowns();
            buildShiftDropdown();
            buildPositionDropdown();
            buildHardworkDropdown();
        }
    });
}

function unique(arr, key) {
    const seen = new Set();
    return arr.filter(d => { const v = d[key]; if (seen.has(v)) return false; seen.add(v); return true; });
}

function buildDropdowns() {
    const depts = unique(scopeTuples, 'DEPTCD').sort((a,b) => a.DEPTCD.localeCompare(b.DEPTCD));
    const dSel = document.getElementById('deptFilter');
    dSel.innerHTML = '<option value="">-- Bộ phận --</option>';
    depts.forEach(d => {
        const lbl = d.DEPT_NAME ? `${d.DEPTCD} — ${escHtml(d.DEPT_NAME)}` : d.DEPTCD;
        dSel.innerHTML += `<option value="${escHtml(d.DEPTCD)}">${lbl}</option>`;
    });
    buildLineDropdown('');
}

function buildLineDropdown(deptcd) {
    const src = deptcd ? scopeTuples.filter(d => d.DEPTCD === deptcd) : scopeTuples;
    const lines = unique(src, 'LINECD').sort((a,b) => a.LINECD.localeCompare(b.LINECD));
    const lSel = document.getElementById('lineFilter');
    lSel.innerHTML = '<option value="">-- Line --</option>';
    lines.forEach(d => {
        const lbl = d.LINE_NAME ? `${d.LINECD} — ${escHtml(d.LINE_NAME)}` : d.LINECD;
        lSel.innerHTML += `<option value="${escHtml(d.LINECD)}">${lbl}</option>`;
    });
    buildWorkDropdown(deptcd, '');
}

function buildWorkDropdown(deptcd, linecd) {
    let src = scopeTuples;
    if (deptcd) src = src.filter(d => d.DEPTCD === deptcd);
    if (linecd) src = src.filter(d => d.LINECD === linecd);
    const works = unique(src, 'WORKCD').sort((a,b) => a.WORKCD.localeCompare(b.WORKCD));
    const wSel = document.getElementById('workFilter');
    wSel.innerHTML = '<option value="">-- Nhóm việc --</option>';
    works.forEach(d => {
        const lbl = d.WORK_NAME ? `${d.WORKCD} — ${escHtml(d.WORK_NAME)}` : d.WORKCD;
        wSel.innerHTML += `<option value="${escHtml(d.WORKCD)}">${lbl}</option>`;
    });
}

function buildShiftDropdown() {
    const sSel = document.getElementById('shiftFilter');
    sSel.innerHTML = '<option value="">-- Ca làm việc --</option>';
    shiftOptions.forEach(s => {
        sSel.innerHTML += `<option value="${escHtml(s.SHIFTCD)}">${escHtml(s.SHIFTCD)} (${s.SHIFT_TIME})</option>`;
    });
}

function buildPositionDropdown() {
    const sel = document.getElementById('positionFilter');
    sel.innerHTML = '<option value="">-- Chức vụ --</option>';
    positionOptions.forEach(p => {
        sel.innerHTML += `<option value="${escHtml(p.JIKWICD)}">${escHtml(p.POSITION_NAME || p.JIKWICD)}</option>`;
    });
}

// Combobox "Công việc thực hiện" — tự vẽ (không dùng <select> gốc) vì font Vnitbi__ cho chữ VNI
// không áp được vào <option> trên nhiều trình duyệt (popup native bỏ qua font-family của trang).
function buildHardworkDropdown() {
    renderHardworkOptionsBox(hardworkOptions);
}

function renderHardworkOptionsBox(list) {
    const box = document.getElementById('hardworkOptionsBox');
    const current = document.getElementById('hardworkFilter').value;
    let html = `<div class="combo-option placeholder ${!current?'active':''}" onclick="selectHardwork('','')">-- Công việc thực hiện --</div>`;
    list.forEach(h => {
        const label = h.HARDWORK_TEN || h.INTEREST;
        html += `<div class="combo-option vni-font ${current===h.INTEREST?'active':''}" onclick="selectHardwork('${h.INTEREST.replace(/'/g,"\\'")}', this.textContent)">${escHtml(label)}</div>`;
    });
    box.innerHTML = html;
}

function filterHardworkOptions() {
    const q = (document.getElementById('hardworkSearch').value || '').trim().toUpperCase();
    const list = q ? hardworkOptions.filter(h => (h.HARDWORK_TEN||'').toUpperCase().includes(q) || (h.INTEREST||'').toUpperCase().includes(q)) : hardworkOptions;
    renderHardworkOptionsBox(list);
}

function selectHardwork(interest, label) {
    document.getElementById('hardworkFilter').value = interest;
    document.getElementById('hardworkDisplay').value = label || '';
    document.getElementById('hardworkPanel').classList.add('d-none');
    page = 1; loadData();
}

function toggleHardworkPanel() {
    const panel = document.getElementById('hardworkPanel');
    const opening = panel.classList.contains('d-none');
    panel.classList.toggle('d-none');
    if (opening) {
        document.getElementById('hardworkSearch').value = '';
        renderHardworkOptionsBox(hardworkOptions);
        setTimeout(() => document.getElementById('hardworkSearch').focus(), 0);
    }
}

document.addEventListener('click', function(e) {
    const combo = document.getElementById('hardworkCombo');
    if (combo && !combo.contains(e.target)) document.getElementById('hardworkPanel').classList.add('d-none');
});

function onPositionChange() {
    page = 1; loadData();
}

function onDeptChange() {
    const dept = document.getElementById('deptFilter').value;
    buildLineDropdown(dept);
    page = 1; loadData();
}

function onLineChange() {
    const dept = document.getElementById('deptFilter').value;
    const line = document.getElementById('lineFilter').value;
    buildWorkDropdown(dept, line);
    page = 1; loadData();
}

function onWorkChange() {
    page = 1; loadData();
}

function onShiftChange() {
    page = 1; loadData();
}

function onSearch() {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => { page = 1; loadData(); }, 300);
}

function resetFilters() {
    document.getElementById('searchInput').value = '';
    document.getElementById('deptFilter').value  = '';
    document.getElementById('lineFilter').value  = '';
    document.getElementById('workFilter').value  = '';
    document.getElementById('shiftFilter').value = '';
    document.getElementById('positionFilter').value = '';
    document.getElementById('hardworkFilter').value = '';
    document.getElementById('hardworkDisplay').value = '';
    document.getElementById('noLoginToggle').checked = false;
    document.getElementById('noLoginToggleLabel').classList.remove('active');
    buildLineDropdown('');
    page = 1; loadData();
}

function onNoLoginToggle() {
    const cb  = document.getElementById('noLoginToggle');
    const lbl = document.getElementById('noLoginToggleLabel');
    lbl.classList.toggle('active', cb.checked);
    page = 1; loadData();
}

function currentFilterParams() {
    return {
        search:   (document.getElementById('searchInput').value||'').trim(),
        deptcd:   document.getElementById('deptFilter').value,
        linecd:   document.getElementById('lineFilter').value,
        workcd:   document.getElementById('workFilter').value,
        shiftcd:  document.getElementById('shiftFilter').value,
        jikwicd:  document.getElementById('positionFilter').value,
        interest: document.getElementById('hardworkFilter').value,
        no_login: document.getElementById('noLoginToggle').checked
    };
}

// ── Load trang dữ liệu hiện tại (phân trang ở SQL) ───────────────────────
function loadData() {
    document.getElementById('tableBody').innerHTML =
        `<tr><td colspan="10" class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></td></tr>`;
    MobileTableHelper.refresh('tableBody');

    const f = currentFilterParams();
    $.ajax({
        url: DATA_URL, type: 'GET',
        data: { search: f.search, deptcd: f.deptcd, linecd: f.linecd, workcd: f.workcd, shiftcd: f.shiftcd, jikwicd: f.jikwicd, interest: f.interest, no_login: f.no_login, page, page_size: PAGE_SIZE },
        success: function(res) {
            if (!res.success) {
                document.getElementById('tableBody').innerHTML =
                    `<tr><td colspan="10" class="text-center text-danger py-4">${escHtml(res.message||'Lỗi')}</td></tr>`;
                MobileTableHelper.refresh('tableBody');
                return;
            }
            totalRows   = res.total || 0;
            totalPages  = res.total_pages || 1;
            page        = res.page || page;
            renderTable(res.data || []);
        },
        error: function(xhr) {
            document.getElementById('tableBody').innerHTML =
                `<tr><td colspan="10" class="text-center text-danger py-4">Lỗi kết nối (${xhr.status})</td></tr>`;
            MobileTableHelper.refresh('tableBody');
        }
    });
}

// ── Render ────────────────────────────────────────────────────
function renderTable(pageData) {
    const badge = document.getElementById('totalBadge');
    badge.textContent = `${totalRows} nhân viên`;
    badge.style.display = totalRows ? '' : 'none';

    if (!pageData.length) {
        document.getElementById('tableBody').innerHTML =
            `<tr><td colspan="10" class="text-center py-5">
                <img src="${NO_DATA_IMG}" style="width:120px;opacity:.85;display:block;margin:0 auto 10px;">
                <div class="text-muted text-sm">Không có nhân viên phù hợp</div>
            </td></tr>`;
        document.getElementById('pageCount').textContent = '';
        document.getElementById('pagination').innerHTML = '';
        MobileTableHelper.refresh('tableBody');
        return;
    }

    const start = (page - 1) * PAGE_SIZE;
    document.getElementById('tableBody').innerHTML = pageData.map((d, i) => `<tr>
        <td class="px-2 text-xs text-secondary">${start + i + 1}</td>
        <td class="px-2">
            <div class="emp-name-row"><span class="vni-font" style="text-transform:uppercase;">${escHtml(d.EMP_NAME)}</span>${!d.LAST_LOGIN ? '<span class="badge-no-login" title="Chưa đăng nhập lần đầu lần nào"><i class="bi bi-person-x"></i>Chưa đăng nhập lần đầu</span>' : ''}</div>
            <div class="emp-meta">${escHtml(d.EMPCD)}</div>
        </td>
        <td class="px-2 text-xs vni-font">${workCell(d)}</td>
        <td class="px-2 dept-line">
            <div><span class="lbl">BP:</span> ${d.DEPT_NAME ? `${escHtml(d.DEPTCD)} — ${escHtml(d.DEPT_NAME)}` : escHtml(d.DEPTCD)||'—'}</div>
            <div><span class="lbl">Line:</span> ${d.LINE_NAME ? `${escHtml(d.LINECD)} — ${escHtml(d.LINE_NAME)}` : escHtml(d.LINECD)||'—'}</div>
            <div><span class="lbl">Nhóm:</span> ${d.WORK_NAME ? `${escHtml(d.WORKCD)} — ${escHtml(d.WORK_NAME)}` : escHtml(d.WORKCD)||'—'}</div>
        </td>
        <td class="px-2 text-xs">${d.PHONE ? `<a href="tel:${escHtml(d.PHONE)}" class="text-dark">${escHtml(d.PHONE)}</a>` : '<span class="text-secondary">—</span>'}</td>
        <td class="px-2 text-xs">${d.EMAIL ? `<a href="mailto:${escHtml(d.EMAIL)}" class="text-dark">${escHtml(d.EMAIL)}</a>` : '<span class="text-secondary">—</span>'}</td>
        <td class="px-2 text-end">${otChipM(d.SUM_MONTH)}</td>
        <td class="px-2 text-end">${otChipY(d.SUM_YEAR)}</td>
        <td class="px-2 text-end">${leaveChip(d.LEAVE_LEFT)}</td>
        <td class="px-2">${shiftChip(d)}</td>
    </tr>`).join('');

    const s = start + 1, e = Math.min(start + PAGE_SIZE, totalRows);
    document.getElementById('pageCount').innerHTML =
        `<span class="text-xs">${s}–${e} / <strong>${totalRows}</strong> nhân viên</span>`;

    renderPagination();
    MobileTableHelper.refresh('tableBody');
}

function renderPagination() {
    const $bar = $('#pagination').empty();
    if (totalPages <= 1) return;
    const mk = (label, p, disabled, active) => {
        const li = $('<li class="page-item">').toggleClass('disabled', !!disabled).toggleClass('active', !!active);
        $('<a class="page-link">').html(label).on('click', () => { if (!disabled && !active) { page = p; loadData(); } }).appendTo(li);
        return li;
    };
    $bar.append(mk('&lsaquo;', page - 1, page <= 1));
    const from = Math.max(1, page - 2), to = Math.min(totalPages, page + 2);
    for (let p = from; p <= to; p++) $bar.append(mk(p, p, false, p === page));
    $bar.append(mk('&rsaquo;', page + 1, page >= totalPages));
}

// ── Export ────────────────────────────────────────────────────
function exportExcel() {
    const f = currentFilterParams();
    const params = new URLSearchParams();
    if (f.search)   params.append('search', f.search);
    if (f.deptcd)   params.append('deptcd', f.deptcd);
    if (f.linecd)   params.append('linecd', f.linecd);
    if (f.workcd)   params.append('workcd', f.workcd);
    if (f.shiftcd)  params.append('shiftcd', f.shiftcd);
    if (f.jikwicd)  params.append('jikwicd', f.jikwicd);
    if (f.interest) params.append('interest', f.interest);
    if (f.no_login) params.append('no_login', 'true');
    const a = document.createElement('a');
    a.href = EXPORT_URL + (params.toString() ? '?' + params.toString() : '');
    a.style.display = 'none';
    document.body.appendChild(a);
    a.click();
    setTimeout(() => document.body.removeChild(a), 200);
}

$(document).ready(function() {
    MobileTableHelper.init('tableBody');
    loadFilters();
    loadData();
});
</script>
