@model HR_web.Models.Inquiry.InquiryTopicsResponse
@{
    ViewData["Title"] = "Tạo hội thoại mới";
}

<style>
.create-page { max-width: 600px; margin: 0 auto; padding-bottom: 5rem; }

/* Top back bar */
.top-back-bar { display: flex; align-items: center; gap: .5rem; margin-bottom: 1rem; }
.btn-top-back {
    display: inline-flex; align-items: center; gap: .3rem;
    background: white; border: 1.5px solid #e2e8f0; border-radius: 10px;
    padding: .45rem .8rem; font-size: .85rem; font-weight: 700;
    color: #475569; cursor: pointer; transition: all .15s; text-decoration: none;
}
.btn-top-back:hover { border-color: #4f46e5; color: #4f46e5; }

/* Steps */
.step-header { margin-bottom: 1.25rem; }
.step-label  { font-size: .78rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: .06em; margin-bottom: .3rem; }
.step-title  { font-size: 1.15rem; font-weight: 800; color: #1e293b; }

/* Type selection — mobile-first: mặc định list DỌC (icon trái, chữ phải), kiểu 3 cột ngang bị
   bóp chữ rất khó đọc trên điện thoại thật dù đã thử breakpoint 420px (viewport thực tế của NV
   thường rộng hơn 420px nên không bao giờ khớp) — nay mặc định dọc cho MỌI màn hình, chỉ màn
   rộng (desktop, >=600px) mới chuyển sang lưới 3 cột. */
.type-cards { display: flex; flex-direction: column; gap: .5rem; margin-bottom: 1rem; }
.type-card {
    position: relative;
    display: flex; align-items: center; gap: .75rem; text-align: left;
    background: white;
    border: 2px solid #e2e8f0;
    border-radius: 14px;
    padding: .65rem .85rem;
    cursor: pointer;
    transition: transform .25s cubic-bezier(.34,1.56,.64,1), box-shadow .25s, border-color .25s;
    overflow: hidden;
}
.type-card .tc-icon { width: 46px; height: 46px; margin: 0; flex-shrink: 0; font-size: 1.4rem; }
.type-card .tc-text { flex: 1; min-width: 0; }
.type-card .tc-icon img { width: 32px; height: 32px; }
.type-card.ai .tc-icon { font-size: 1.4rem; }
.type-card .tc-title { font-size: .9rem; }
.type-card .tc-desc  { font-size: .72rem; margin-top: .1rem; line-height: 1.3; }
.type-card .tc-check { width: 20px; height: 20px; top: 8px; right: 8px; }
.type-card .tc-check .material-symbols-rounded { font-size: .8rem; }

@@media (min-width: 600px) {
    .type-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: .7rem; }
    .type-card {
        display: block; text-align: center;
        border-radius: 22px; padding: 1.5rem 1rem 1.25rem;
    }
    .type-card .tc-icon { width: 86px; height: 86px; margin: 0 auto .75rem; font-size: 2.2rem; }
    .type-card .tc-icon img { width: 60px; height: 60px; }
    .type-card .tc-title { font-size: 1.02rem; }
    .type-card .tc-desc  { font-size: .76rem; margin-top: .35rem; line-height: 1.4; }
    .type-card .tc-check { width: 26px; height: 26px; top: 10px; right: 10px; }
    .type-card .tc-check .material-symbols-rounded { font-size: 1rem; }
}
.type-card::before {
    content: ''; position: absolute; inset: 0; opacity: 0;
    background: radial-gradient(circle at top, rgba(255,255,255,.6), transparent 70%);
    transition: opacity .3s;
    pointer-events: none;
}
.type-card:hover  {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(79,70,229,.18);
}
.type-card:hover::before { opacity: 1; }
.type-card.active {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(79,70,229,.25);
}
.type-card.direct.active { border-color: #4f46e5; background: linear-gradient(180deg,#eef2ff 0%,#fff 100%); }
.type-card.anon.active   { border-color: #475569; background: linear-gradient(180deg,#f1f5f9 0%,#fff 100%); }
.type-card.ai.active     { border-color: #7c3aed; background: linear-gradient(180deg,#f5f3ff 0%,#fff 100%); }
.type-card.ai .tc-icon   { background: radial-gradient(circle, #ede9fe 0%, #f5f3ff 100%); box-shadow: inset 0 0 0 2px rgba(124,58,237,.08); font-size: 2.2rem; }

/* Icon halo — kích thước/vị trí (width/height/margin/top/right) đã khai báo riêng ở block mobile-
   first + @@media(min-width:600px) phía trên, ở đây chỉ còn màu sắc/hiệu ứng dùng chung 2 breakpoint */
.type-card .tc-icon {
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    position: relative;
    transition: transform .3s;
}
.type-card.direct .tc-icon { background: radial-gradient(circle, #e0e7ff 0%, #f5f3ff 100%); box-shadow: inset 0 0 0 2px rgba(79,70,229,.08); }
.type-card.anon   .tc-icon { background: radial-gradient(circle, #e2e8f0 0%, #f8fafc 100%); box-shadow: inset 0 0 0 2px rgba(71,85,105,.08); }
.type-card:hover .tc-icon { transform: scale(1.08) rotate(-3deg); }
.type-card .tc-icon img { object-fit: contain; filter: drop-shadow(0 3px 5px rgba(0,0,0,.12)); }

.type-card .tc-title { font-weight: 800; color: #1e293b; letter-spacing: -.01em; }
.type-card .tc-desc  { color: #64748b; }

/* Active checkmark badge — width/height/top/right theo breakpoint ở trên */
.type-card .tc-check {
    position: absolute; border-radius: 50%;
    background: #10b981; color: white;
    display: none; align-items: center; justify-content: center;
    box-shadow: 0 2px 6px rgba(16,185,129,.4);
    animation: popIn .3s cubic-bezier(.34,1.56,.64,1);
}
.type-card.active .tc-check { display: flex; }
@@keyframes popIn { 0% { transform: scale(0); } 100% { transform: scale(1); } }

/* Topic grid */
.topic-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: .6rem; margin-bottom: 1rem; }

/* Ô tìm chủ đề — 22 chủ đề mà xếp card thì điện thoại phải cuộn ~3 màn hình (yêu cầu 2026-11-12).
   Gõ vài chữ là lọc còn 1-2 lựa chọn. */
.topic-search { position: relative; margin-bottom: .6rem; }
.topic-search input {
    width: 100%; height: 42px; border: 1.5px solid #e2e8f0; border-radius: 12px;
    padding: 0 2.2rem 0 2.2rem; font-size: .9rem; background: #f8fafc; outline: none;
}
.topic-search input:focus { border-color: #4f46e5; background: #fff; }
.topic-search .ts-ico { position: absolute; left: .6rem; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 1.1rem; pointer-events: none; }
.topic-search .ts-clear { position: absolute; right: .4rem; top: 50%; transform: translateY(-50%); border: none; background: none; color: #94a3b8; cursor: pointer; display: none; padding: .2rem; }
.topic-empty { text-align: center; color: #94a3b8; font-size: .85rem; padding: 1rem 0; display: none; }

/* ĐIỆN THOẠI: đổi hẳn sang danh sách 1 dòng/chủ đề — thấp hơn card vuông ~60%,
   lướt nhanh hơn nhiều và chữ không bị cắt dòng. */
@@media (max-width: 575.98px) {
    .topic-grid { grid-template-columns: 1fr; gap: .35rem; }
    .topic-card {
        display: flex; align-items: center; gap: .6rem;
        text-align: left !important; padding: .55rem .7rem !important;
    }
    .topic-card .tpc-icon { margin-bottom: 0 !important; font-size: 1.25rem; line-height: 1; }
    .topic-card .tpc-name { font-size: .88rem; }
}
.topic-card {
    background: white; border: 2px solid #e2e8f0; border-radius: 14px;
    padding: .85rem .75rem; cursor: pointer; transition: all .15s; text-align: center;
}
.topic-card:hover  { border-color: #c7d2fe; }
.topic-card.active { border-color: #4f46e5; background: #f0f0ff; }
.topic-card .tpc-icon  { font-size: 1.6rem; margin-bottom: .3rem; }
.topic-card .tpc-name  { font-size: .8rem; font-weight: 700; color: #1e293b; }
.rt-cards { display: flex; gap: .6rem; margin-bottom: 1rem; }
.rt-card { flex: 1; border: 2px solid #e2e8f0; border-radius: 14px; padding: .75rem .8rem; background: #fff; cursor: pointer; transition: all .15s; }
.rt-card:hover { border-color: #c7d2fe; }
.rt-card.active { border-color: #4f46e5; background: #f0f0ff; }
.rt-card .rt-title { font-weight: 800; font-size: .92rem; color: #1e293b; }
.rt-card .rt-desc  { font-size: .72rem; color: #64748b; margin-top: .15rem; line-height: 1.35; }
.topic-hint { display: none; margin: .6rem 0 .2rem; padding: .55rem .8rem; border-radius: 12px; background: #f8fafc; border: 1.5px solid #e2e8f0; font-size: .8rem; color: #334155; }

/* Form */
.form-card { background: white; border-radius: 16px; padding: 1.25rem; box-shadow: 0 1px 4px rgba(0,0,0,.07); margin-bottom: 1rem; }
.form-label-sm { font-size: .8rem; font-weight: 700; color: #475569; margin-bottom: .35rem; }
.input-modern {
    width: 100%; border: 1.5px solid #e2e8f0; border-radius: 12px;
    padding: .65rem .9rem; font-size: .9rem; transition: border-color .15s;
    outline: none; font-family: inherit;
}
.input-modern:focus { border-color: #4f46e5; box-shadow: 0 0 0 3px rgba(79,70,229,.1); }
textarea.input-modern { resize: none; min-height: 120px; }

.char-count { font-size: .72rem; color: #94a3b8; text-align: right; margin-top: .2rem; }

/* File attach */
.file-attach-btn {
    display: inline-flex; align-items: center; gap: .4rem;
    border: 1.5px dashed #cbd5e1; border-radius: 10px;
    padding: .5rem .85rem; font-size: .82rem; font-weight: 700;
    color: #64748b; cursor: pointer; transition: all .15s;
}
.file-attach-btn:hover { border-color: #4f46e5; color: #4f46e5; }

.file-preview-strip { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .75rem; }
.file-chip {
    display: flex; align-items: center; gap: .3rem; background: #f1f5f9;
    border-radius: 8px; padding: .3rem .6rem; font-size: .78rem; font-weight: 600;
}
.file-chip img { width: 32px; height: 32px; border-radius: 6px; object-fit: cover; }
.file-chip .fc-remove { cursor: pointer; color: #ef4444; margin-left: .25rem; font-size: .9rem; }

/* Navigation buttons */
.nav-btns { display: flex; gap: .75rem; }
.btn-back-step {
    flex: 0 0 auto; border: 1.5px solid #e2e8f0; background: white;
    border-radius: 12px; padding: .65rem 1.25rem; font-weight: 700; font-size: .9rem;
    color: #64748b; cursor: pointer; transition: all .15s;
}
.btn-back-step:hover { border-color: #94a3b8; }
.btn-next-step {
    flex: 1; background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
    border: none; border-radius: 12px; padding: .7rem 1.5rem;
    font-weight: 800; font-size: .95rem; color: white; cursor: pointer; transition: all .15s;
}
.btn-next-step:hover   { opacity: .92; transform: translateY(-1px); }
.btn-next-step:active  { transform: none; opacity: .8; }
.btn-next-step:disabled { opacity: .5; cursor: not-allowed; transform: none; }
</style>

<div class="create-page px-2 py-2">
    <div class="top-back-bar">
        <a href="@Url.Action("Index","EmployeeInquiry")" class="btn-top-back">
            <span class="material-symbols-rounded" style="font-size:1.1rem;">arrow_back</span>
            Quay lại
        </a>
    </div>

    <!-- Step 1: Chọn loại -->
    <div id="step1">
        <div class="step-header">
            <div class="step-label">Bước 1 / 2</div>
            <div class="step-title">Chọn hình thức hội thoại</div>
        </div>

        <div style="background:#f0fdf4;border:1.5px solid #86efac;border-radius:12px;padding:.75rem 1rem;margin-bottom:.85rem">
            <div style="display:flex;align-items:flex-start;gap:.6rem">
                <span class="material-symbols-rounded" style="font-size:1.2rem;color:#16a34a;flex-shrink:0;margin-top:.05rem">verified_user</span>
                <div style="font-size:.85rem;color:#14532d;line-height:1.55">
                    Chúng tôi cam kết <strong>bảo mật tuyệt đối</strong> mọi thông tin bạn chia sẻ và <strong>không tiết lộ ra ngoài</strong>.
                    Bạn cứ thoải mái nói lên ý kiến — <strong>chúng tôi luôn lắng nghe</strong>.
                </div>
            </div>
        </div>

        <div class="type-cards">
            <div class="type-card direct" onclick="selectType('DIRECT', this)">
                <div class="tc-check"><span class="material-symbols-rounded" style="font-size:1rem">check</span></div>
                <div class="tc-icon"><img src="~/assets/img/icons/counsel.png" alt="Trực tiếp" /></div>
                <div class="tc-text">
                    <div class="tc-title">Trực tiếp</div>
                    <div class="tc-desc">Với nhân sự, CSR</div>
                </div>
            </div>
            <div class="type-card anon" onclick="selectType('ANON', this)">
                <div class="tc-check"><span class="material-symbols-rounded" style="font-size:1rem">check</span></div>
                <div class="tc-icon"><img src="~/assets/img/icons/anon.png" alt="Ẩn danh" /></div>
                <div class="tc-text">
                    <div class="tc-title">Ẩn danh</div>
                    <div class="tc-desc">Với nhân sự, CSR</div>
                </div>
            </div>
            <div class="type-card ai" id="aiTypeCard" onclick="selectType('AI', this)">
                <div class="tc-icon">🤖</div>
                <div class="tc-text">
                    <div class="tc-title">Chat với AI</div>
                    <div class="tc-desc" style="color:#dc2626;font-weight:700">Không phải người thật trả lời, có thể sai</div>
                </div>
            </div>
        </div>

        <div id="anonNotice" style="display:none;background:#fefce8;border:1.5px solid #fde047;border-radius:12px;padding:.75rem 1rem;margin-bottom:.75rem">
            <div style="display:flex;align-items:flex-start;gap:.6rem">
                <span class="material-symbols-rounded" style="font-size:1.2rem;color:#ca8a04;flex-shrink:0;margin-top:.05rem">warning</span>
                <div>
                    <div style="font-size:.85rem;font-weight:800;color:#92400e;margin-bottom:.2rem">Lưu ý về hội thoại ẩn danh</div>
                    <div style="font-size:.8rem;color:#78350f;line-height:1.5">
                        Tin nhắn ẩn danh <strong>không được lưu trữ lâu dài</strong> và sẽ tự động xóa sau một khoảng thời gian.
                        Nếu cần giữ lại thông tin, hãy chọn hình thức <strong>Trực tiếp</strong>.
                    </div>
                    <div style="font-size:.8rem;color:#78350f;line-height:1.5;margin-top:.45rem;padding-top:.45rem;border-top:1px dashed #fde047">
                        <strong>Hãy nhớ mã tra cứu:</strong> sau khi gửi, hệ thống cho bạn một <strong>mã tra cứu</strong>.
                        Lần sau bạn cần mã này để <strong>xem lại câu trả lời</strong> và chat tiếp ẩn danh. Hãy chép lại, quên mã thì không tra lại được.
                    </div>
                </div>
            </div>
        </div>

        <div class="nav-btns mt-3">
            <button class="btn-next-step w-100" id="btnNext1" onclick="goStep(2)" disabled>Tiếp theo</button>
        </div>
    </div>

    <!-- Step 2: Chọn chủ đề -->
    <div id="step2" style="display:none">
        <div class="step-header">
            <div class="step-label">Bước 2 / 2</div>
            <div class="step-title">Loại báo cáo &amp; chủ đề</div>
        </div>
        <div class="form-label-sm mb-1">Loại báo cáo <span class="text-danger">*</span></div>
        <div class="rt-cards" id="reportTypeCards">
            <div class="rt-card" data-rt="GRIEVANCE" onclick="selectReportType('GRIEVANCE', this)">
                <div class="rt-title">Kiến nghị</div>
                <div class="rt-desc">Phản ánh vấn đề cần được giải quyết</div>
            </div>
            <div class="rt-card" data-rt="OPINION" onclick="selectReportType('OPINION', this)">
                <div class="rt-title">Ý kiến</div>
                <div class="rt-desc">Góp ý, đề xuất cải thiện</div>
            </div>
        </div>
        <div class="form-label-sm mb-1">Chủ đề <span class="text-danger">*</span></div>
        <div class="topic-search">
            <span class="material-symbols-rounded ts-ico">search</span>
            <input type="text" id="topicSearch" placeholder="Tìm chủ đề..." autocomplete="off"
                   autocorrect="off" spellcheck="false" oninput="filterTopics()">
            <button type="button" class="ts-clear" id="topicSearchClear" onclick="clearTopicSearch()" aria-label="Xoá">
                <span class="material-symbols-rounded">close</span>
            </button>
        </div>
        <div class="topic-grid" id="topicGrid">
            @foreach (var t in (Model?.data ?? new()))
            {
                <div class="topic-card" data-topic-cd="@t.TopicCd" onclick="selectTopic('@t.TopicCd', '@(t.TopicName.Replace("'","&#39;"))', this)">
                    <div class="tpc-icon"><span class="material-symbols-rounded" style="color:@(t.Color ?? "#4f46e5")">@(t.Icon ?? "chat")</span></div>
                    <div class="tpc-name">@t.TopicName</div>
                    @* Đã bỏ dòng mức độ + số ngày phản hồi: thông tin nội bộ, công nhân không cần
                       thấy (yêu cầu 2026-11-12). Bỏ đi card cũng thấp hơn, đỡ cuộn trên điện thoại. *@
                </div>
            }
        </div>
        <div class="topic-empty" id="topicEmpty">Không có chủ đề nào khớp</div>
        <div id="topicHint" class="topic-hint"></div>
        <div id="topicWarning" style="display:none;border-radius:12px" class="alert alert-warning py-2 px-3 mt-1 mb-2 small"></div>

        @* Cảnh báo ẩn danh chuyển từ bước 3 cũ lên đây — bước 3 đã bỏ (yêu cầu 2026-11-12). *@
        <div id="anonReminder" style="display:none;background:#fefce8;border:1.5px solid #fde047;border-radius:10px;padding:.6rem .85rem;margin-bottom:.75rem;font-size:.78rem;color:#92400e">
            <span class="material-symbols-rounded" style="font-size:.95rem;vertical-align:middle;color:#ca8a04">warning</span>
            Tin nhắn ẩn danh <strong>sẽ tự xoá sau một thời gian</strong>.
            Gửi xong bạn nhận <strong>mã tra cứu</strong> — hãy chép lại để xem trả lời sau này.
        </div>

        <div class="nav-btns">
            <button class="btn-back-step" onclick="goStep(1)">Quay lại</button>
            <button class="btn-next-step" id="btnNext2" onclick="submitCreate()" disabled>
                <span class="material-symbols-rounded me-1" style="font-size:1rem;vertical-align:middle;">forum</span>
                Bắt đầu trao đổi
            </button>
        </div>
    </div>

</div>

@Html.AntiForgeryToken()

@section Scripts {
<script>
const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

let selectedType  = '';
let selectedTopic = '';
let selectedReportType = '';   // GRIEVANCE | OPINION — bắt buộc chọn ở Bước 2

// ĐÃ BỎ TOPIC_INFO (mức độ / số ngày phản hồi theo chủ đề): từ 2026-11-12 không hiện mức độ
// cho công nhân nữa nên không còn ai đọc, và cũng không nên đẩy phân loại nội bộ xuống client.

// Modal bắt buộc NV xác nhận đã lưu mã tra cứu ẩn danh trước khi tiếp tục — Promise chỉ resolve
// khi bấm "Tôi đã ghi nhớ mã này" (không có nút đóng/tắt khác, tránh NV bỏ qua rồi mất mã).
function showAccessCodeModal(code) {
    return new Promise(resolve => {
        const overlay = document.createElement('div');
        overlay.style.cssText = 'position:fixed;inset:0;background:rgba(15,23,42,.55);z-index:2000;display:flex;align-items:center;justify-content:center;padding:1rem;';
        overlay.innerHTML = `
            <div style="background:#fff;border-radius:18px;padding:1.5rem 1.25rem;max-width:360px;width:100%;text-align:center;box-shadow:0 20px 50px rgba(0,0,0,.3);">
                <span class="material-symbols-rounded" style="font-size:2.2rem;color:#4f46e5;">pin</span>
                <div style="font-weight:800;font-size:1.05rem;color:#1e293b;margin:.5rem 0 .25rem;">Mã tra cứu của bạn</div>
                <div style="font-size:.82rem;color:#64748b;margin-bottom:1rem;line-height:1.5;">
                    <strong style="color:#b91c1c">Hãy nhớ mã này!</strong> Lần sau bạn cần mã này để <strong>xem lại câu trả lời</strong>
                    (nhập ở ô <em>"Nhập mã tra cứu"</em> trong Hộp thư). Quên mã thì <strong>không tra lại được</strong>.
                    <div style="margin-top:.4rem;color:#475569">Khi nhập lại, gõ chữ hoa hay chữ thường đều được.</div>
                </div>
                <div id="accessCodeText" style="font-family:monospace;font-size:1.8rem;font-weight:800;letter-spacing:.1em;color:#4f46e5;background:#eef2ff;border-radius:12px;padding:.6rem;margin-bottom:.5rem;user-select:all;-webkit-user-select:all;">${esc(code)}</div>
                <button type="button" id="accessCodeCopyBtn" style="width:100%;border:1.5px solid #c7d2fe;border-radius:12px;padding:.6rem;background:#fff;color:#4f46e5;font-weight:800;font-size:.9rem;cursor:pointer;margin-bottom:.75rem;display:flex;align-items:center;justify-content:center;gap:.4rem;">
                    <span class="material-symbols-rounded" style="font-size:1.15rem;">content_copy</span><span id="accessCodeCopyLbl">Sao chép mã</span>
                </button>
                <button type="button" id="accessCodeOkBtn" style="width:100%;border:none;border-radius:12px;padding:.75rem;background:linear-gradient(135deg,#4f46e5 0%,#7c3aed 100%);color:#fff;font-weight:800;font-size:.92rem;cursor:pointer;">
                    Tôi đã ghi nhớ mã này
                </button>
            </div>`;
        document.body.appendChild(overlay);
        document.getElementById('accessCodeCopyBtn').onclick = async () => {
            const lbl = document.getElementById('accessCodeCopyLbl');
            if (await copyAccessCode(code)) {
                lbl.textContent = 'Đã sao chép ✓';
            } else {
                // Không sao chép tự động được: chọn sẵn cả mã để NV giữ vào mã rồi chọn Sao chép / Copy
                const el = document.getElementById('accessCodeText');
                const range = document.createRange(); range.selectNodeContents(el);
                const sel = window.getSelection(); sel.removeAllRanges(); sel.addRange(range);
                lbl.textContent = 'Giữ vào mã rồi chọn "Sao chép"';
            }
            setTimeout(() => { if (document.body.contains(overlay)) lbl.textContent = 'Sao chép mã'; }, 3000);
        };
        document.getElementById('accessCodeOkBtn').onclick = () => { overlay.remove(); resolve(); };
    });
}
// Sao chép mã — chạy trên iOS, Android, macOS, Windows (kể cả trong app My Samho/WebView và khi trang mở bằng http thường:
// navigator.clipboard CHỈ có ở https/localhost nên cần cách dự phòng textarea + execCommand('copy'), phải gọi ngay trong
// lúc bấm nút (iOS yêu cầu). Trả false nếu không sao chép được -> hiện hướng dẫn chọn mã bằng tay.
async function copyAccessCode(text) {
    try {
        if (navigator.clipboard && window.isSecureContext) { await navigator.clipboard.writeText(text); return true; }
    } catch (e) { /* rơi xuống cách dự phòng */ }
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.setAttribute('readonly', '');
    ta.style.cssText = 'position:fixed;top:0;left:0;width:1px;height:1px;opacity:0;';
    document.body.appendChild(ta);
    ta.focus(); ta.select(); ta.setSelectionRange(0, text.length);   // iOS Safari/WKWebView cần setSelectionRange
    let ok = false;
    try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
    document.body.removeChild(ta);
    return ok;
}
function esc(s) { return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

// Mỗi hội thoại ẩn danh dùng 1 dấu nhận diện NGẪU NHIÊN riêng, KHÔNG lưu vào trình duyệt: trước đây cả máy dùng chung 1 dấu nên
// mọi hội thoại ẩn danh gửi từ máy đó đều bị nối với nhau và hiện lại trong Hộp thư cho bất kỳ ai dùng chung máy.
function newAnonToken() {
    const a = new Uint8Array(12);
    (window.crypto || window.msCrypto).getRandomValues(a);
    return 'anon-' + Array.from(a, b => b.toString(16).padStart(2, '0')).join('');
}


function goStep(n) {
    [1, 2].forEach(i => document.getElementById(`step${i}`).style.display = i === n ? '' : 'none');
    if (n === 2) { tryAutoSelectTopic(); if (selectedTopic) checkExistingTopic(selectedTopic); }
}

function selectType(type, el) {
    // Chat AI không có chủ đề/nội dung như Trực tiếp/Ẩn danh — nhảy thẳng qua /AiCsr/Chat,
    // bỏ qua Bước 2/3 (yêu cầu 2026-09-16, trước đây là 1 banner riêng phía trên Bước 1).
    if (type === 'AI') {
        window.location.href = '@Url.Action("Chat","AiCsr")';
        return;
    }
    selectedType = type;
    document.querySelectorAll('.type-card').forEach(c => c.classList.remove('active'));
    el.classList.add('active');
    document.getElementById('btnNext1').disabled = false;
    const isAnon = type === 'ANON';
    document.getElementById('anonNotice').style.display   = isAnon ? '' : 'none';
    document.getElementById('anonReminder').style.display = isAnon ? '' : 'none';

}

function updateNext2() {
    document.getElementById('btnNext2').disabled = !(selectedTopic && selectedReportType);
}

function selectReportType(rt, el) {
    selectedReportType = rt;
    document.querySelectorAll('.rt-card').forEach(c => c.classList.remove('active'));
    el.classList.add('active');
    updateNext2();
}

// Bỏ dấu + thường hoá: công nhân gõ "luong"/"nghi phep" phải ra "Lương"/"Nghỉ phép".
function noAccent(str) {
    return (str || '').toLowerCase().normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd');
}
function filterTopics() {
    const q = noAccent(document.getElementById('topicSearch').value.trim());
    document.getElementById('topicSearchClear').style.display = q ? 'block' : 'none';
    let shown = 0;
    document.querySelectorAll('#topicGrid .topic-card').forEach(c => {
        const hit = !q || noAccent(c.querySelector('.tpc-name')?.textContent).includes(q);
        c.style.display = hit ? '' : 'none';
        if (hit) shown++;
    });
    document.getElementById('topicEmpty').style.display = shown ? 'none' : 'block';
}
function clearTopicSearch() {
    const i = document.getElementById('topicSearch');
    i.value = ''; filterTopics(); i.focus();
}

function selectTopic(cd, name, el) {
    selectedTopic = cd;
    document.querySelectorAll('.topic-card').forEach(c => c.classList.remove('active'));
    el.classList.add('active');
    updateNext2();
    checkExistingTopic(cd);
    // Gợi ý mức độ + hạn phản hồi dự kiến của chủ đề đã chọn
    // Luôn ghi rõ ĐÃ CHỌN GÌ: khi đang lọc, card vừa chọn có thể bị ẩn khỏi danh sách
    // nên công nhân sẽ không còn thấy lựa chọn của mình ở đâu cả.
    //
    // KHÔNG hiện mức độ / hạn phản hồi (yêu cầu 2026-11-12): đó là thông tin điều phối nội bộ
    // của CSR. Công nhân thấy chủ đề của mình bị xếp "Thấp" thì dễ tự ái, còn số ngày thì nghe
    // như một lời hứa mà hệ thống không đảm bảo được.
    const hint = document.getElementById('topicHint');
    hint.innerHTML = 'Đã chọn: <strong>' + esc(name) + '</strong>';
    hint.style.display = 'block';
}

// ĐÃ BỎ bước nhập nội dung/đính kèm (2026-11-12): hội thoại tạo rỗng rồi vào thẳng chat,
// công nhân gõ tin và gửi file ngay trong khung chat. Các hàm updateCharCount / handleFiles /
// renderFilePreviews / removeFile theo đó cũng bỏ luôn vì không còn phần tử nào để bám.

let openDirectTopics = {};
let openAnonTopics   = {};

async function loadExistingConversations() {
    try {
        const r1 = await fetch('@Url.Action("GetMyList","EmployeeInquiry")');
        const d1 = await r1.json();
        if (d1.success) {
            openDirectTopics = {};
            (d1.data || []).filter(i => i.status === 'OPEN').forEach(i => {
                openDirectTopics[i.topicCd] = { id: i.id, inquiryNo: i.inquiryNo };
            });
        }
    } catch {}
    // Hội thoại ẩn danh KHÔNG dò theo trình duyệt/thiết bị nữa (chỉ tra cứu bằng mã) — mỗi lần gửi ẩn danh là 1 hội thoại mới.
}

function checkExistingTopic(cd) {
    const warn = document.getElementById('topicWarning');
    if (!warn) return;
    const map = selectedType === 'ANON' ? openAnonTopics : openDirectTopics;
    const existing = map[cd];
    if (existing) {
        const href = `@Url.Action("Chat","EmployeeInquiry")?id=${existing.id}`;   // chỉ có hội thoại TRỰC TIẾP; ẩn danh không dò theo thiết bị
        warn.style.display = '';
        warn.innerHTML = `⚠️ Bạn đang có hội thoại <strong>${existing.inquiryNo}</strong> đang mở về chủ đề này. <a href="${href}" class="fw-bold">Xem hội thoại cũ →</a>`;
    } else {
        warn.style.display = 'none';
    }
}

function tryAutoSelectTopic() {
    const cd = new URLSearchParams(location.search).get('topicCd');
    if (!cd) return;
    const card = document.querySelector(`.topic-card[data-topic-cd="${cd}"]`);
    if (card) card.click();
}

function tryAutoStart() {
    const params = new URLSearchParams(location.search);
    const type   = (params.get('chatType') || '').toUpperCase();
    const cd     = params.get('topicCd');
    if (type !== 'DIRECT' && type !== 'ANON') return;

    const typeCard = document.querySelector(`.type-card.${type.toLowerCase()}`);
    if (!typeCard) return;
    typeCard.click();
    goStep(2);

    // Lối tắt: Hồ sơ ("Mọi thông tin sai vui lòng phản ánh phòng Nhân sự") = Góp ý gửi Nhân sự.
    // Từ trang Phiếu lương: Kiến nghị về Lương (G01, Nhân sự, mức Thấp 3 ngày).
    // Bước 3 đã bỏ (2026-11-12) nên chỉ chọn sẵn rồi DỪNG ở bước 2 — không tự tạo hội thoại,
    // công nhân phải tự bấm "Bắt đầu trao đổi" để xác nhận.
    const QUICK = { COMPLAINT: 'OPINION', G01: 'GRIEVANCE' };
    if (QUICK[cd]) {
        selectedTopic = cd; selectedReportType = QUICK[cd];
        document.querySelector(`.topic-card[data-topic-cd="${cd}"]`)?.classList.add('active');
        document.querySelector(`.rt-card[data-rt="${QUICK[cd]}"]`)?.classList.add('active');
        checkExistingTopic(cd); updateNext2();
        return;
    }

    if (cd) {
        const topicCard = document.querySelector(`.topic-card[data-topic-cd="${cd}"]`);
        if (topicCard) { topicCard.click(); }   // vẫn ở Bước 2: công nhân còn phải chọn Loại báo cáo
    }
}

loadExistingConversations();
tryAutoStart();

// Tạo hội thoại RỖNG rồi vào thẳng khung chat (yêu cầu 2026-11-12: bỏ bước nhập tiêu đề/nội dung).
// Công nhân gõ tin đầu tiên ngay trong chat — bớt 1 bước, và CSR nói không cần tiêu đề.
async function submitCreate() {
    if (!selectedTopic) { showToast('Vui lòng chọn chủ đề', 'warning'); return; }
    if (!selectedReportType) { showToast('Vui lòng chọn Loại báo cáo (Kiến nghị / Ý kiến)', 'warning'); return; }

    const btn = document.getElementById('btnNext2');
    btn.disabled = true; btn.textContent = 'Đang tạo...';

    const anonTok = selectedType === 'ANON' ? newAnonToken() : null;
    const body = {
        chatType:  selectedType,
        topicCd:   selectedTopic,
        reportType: selectedReportType,
        subject:   null,
        anonToken: anonTok,
        content:   null
    };

    try {
        const res  = await fetch('@Url.Action("Create","EmployeeInquiry")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify(body)
        });
        const data = await res.json();
        if (!data.success) { showToast(data.message || 'Tạo thất bại', 'error'); btn.disabled = false; btn.innerHTML = '<span class="material-symbols-rounded me-1" style="font-size:1rem;vertical-align:middle;">send</span>Gửi'; return; }

        // If there are files, send them in a follow-up message via the chat
        // Navigate to chat page
        const chatUrl = selectedType === 'ANON'
            ? `@Url.Action("Chat","EmployeeInquiry")?id=${data.inquiryId}&anonToken=${encodeURIComponent(anonTok)}`
            : `@Url.Action("Chat","EmployeeInquiry")?id=${data.inquiryId}`;

        // Ẩn danh: bắt NV xác nhận đã lưu mã tra cứu trước khi rời trang — mã này là CÁCH DUY NHẤT
        // xem lại hội thoại từ máy/tài khoản khác (yêu cầu khách hàng 2026-11-04). Chặn navigate
        // cho tới khi bấm "Tôi đã ghi nhớ mã này".
        if (selectedType === 'ANON' && data.accessCode) {
            await showAccessCodeModal(data.accessCode);
        }


        window.location.href = chatUrl;
    } catch {
        showToast('Lỗi kết nối', 'error');
        btn.disabled = false;
        btn.innerHTML = '<span class="material-symbols-rounded me-1" style="font-size:1rem;vertical-align:middle;">send</span>Gửi';
    }
}

// HR/CSR có thể tắt tính năng Hỏi AI (yêu cầu 2026-10-19) — tắt thì ẩn hẳn thẻ loại "AI" ở Bước 1.
(async function hideAiCardIfDisabled() {
    try {
        const res = await fetch('@Url.Action("IsEnabled","AiCsr")');
        const cfg = await res.json();
        // Chỉ ẩn khi API trả về THẬT SỰ tắt (success=true, enabled=false) — lỗi kết nối không
        // được coi là "tắt" (bug thật phát hiện lúc review, cùng chỗ với EmployeeInquiry/Index).
        if (cfg.success === true && cfg.enabled === false) {
            const card = document.getElementById('aiTypeCard');
            if (card) card.style.display = 'none';
        }
    } catch { /* lỗi check config -> vẫn hiện bình thường, không khoá nhầm */ }
})();
</script>
}
