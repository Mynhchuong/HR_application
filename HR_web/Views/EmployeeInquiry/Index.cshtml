@{
    ViewData["Title"] = "Hộp thư";
}

<style>
.inq-page { max-width: 680px; margin: 0 auto; padding-bottom: 5rem; }

.inq-hero {
    background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
    border-radius: 18px; padding: 1rem 1.25rem; margin-bottom: .75rem;
    color: #fff; display: flex; align-items: center; justify-content: space-between;
}
.inq-hero h5    { font-size: 1.05rem; font-weight: 800; margin: 0 0 .15rem; color: #fff !important; }
.inq-hero small { font-size: .75rem; opacity: .8; color: #fff !important; }
.inq-hero-icon  { font-size: 2.2rem; line-height: 1; }

.inq-tabs {
    display: flex; background: #f1f5f9; border-radius: 12px;
    padding: 4px; margin-bottom: .75rem; gap: 4px;
}
.tab-btn {
    flex: 1; border: none; background: transparent; border-radius: 9px;
    padding: .45rem .5rem; font-size: .85rem; font-weight: 700;
    color: #64748b; cursor: pointer; transition: all .2s;
}
.tab-btn.active { background: #fff; color: #4f46e5; box-shadow: 0 1px 4px rgba(0,0,0,.1); }

.inq-list { display: flex; flex-direction: column; gap: .5rem; }

.inq-card {
    background: white; border-radius: 14px; padding: .85rem 1rem;
    box-shadow: 0 1px 4px rgba(0,0,0,.06); cursor: pointer;
    display: flex; align-items: center; gap: .85rem;
    transition: all .15s; text-decoration: none; color: inherit;
    border: 1.5px solid transparent;
}
.inq-card:hover  { box-shadow: 0 4px 12px rgba(0,0,0,.1); transform: translateY(-1px); border-color: #e0e7ff; }
.inq-card:active { transform: none; opacity: .85; }

.inq-card-icon {
    width: 46px; height: 46px; border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.4rem; flex-shrink: 0;
}
.inq-card-body { flex: 1; min-width: 0; }
.inq-card-row1 { display: flex; align-items: center; gap: .4rem; margin-bottom: .15rem; }
.inq-card-no   { font-size: .72rem; font-weight: 700; color: #94a3b8; font-family: monospace; }
.inq-card-status {
    font-size: .65rem; font-weight: 800; padding: 1px 7px; border-radius: 20px; text-transform: uppercase;
}
.status-open   { background: #dcfce7; color: #166534; }
.status-closed { background: #f1f5f9; color: #64748b; }

.inq-card-subject { font-size: .88rem; font-weight: 700; color: #1e293b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.inq-card-meta    { display: flex; align-items: center; gap: .5rem; margin-top: .2rem; }
.inq-card-time    { font-size: .72rem; color: #94a3b8; }
.inq-card-topic   { font-size: .72rem; color: #64748b; }
.inq-unread {
    background: #ef4444; color: white; font-size: .65rem; font-weight: 800;
    border-radius: 20px; padding: 1px 6px; min-width: 18px; text-align: center;
}

.inq-fab {
    position: fixed; bottom: 90px; right: 20px; z-index: 200;
    width: 56px; height: 56px; border-radius: 18px;
    background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
    color: white; display: flex; align-items: center; justify-content: center;
    text-decoration: none; box-shadow: 0 4px 16px rgba(79,70,229,.45);
    transition: all .2s;
}
.inq-fab:hover  { transform: scale(1.08); color: white; }
.inq-fab:active { transform: scale(.95); }

.inq-empty { text-align: center; padding: 2.5rem 1rem; color: #94a3b8; }
.inq-empty .ei { font-size: 3rem; display: block; margin-bottom: .5rem; }

.inq-loading { text-align: center; padding: 1.5rem; color: #94a3b8; font-size: .9rem; }
</style>

<div class="inq-page px-2 py-2">
    <div class="inq-hero">
        <div>
            <h5>Hộp thư</h5>
            <small id="heroSub">Đang tải...</small>
        </div>
        <span class="material-symbols-rounded inq-hero-icon">forum</span>
    </div>

    <div class="inq-tabs">
        <button class="tab-btn active" onclick="switchTab('direct', this)">
            <span class="material-symbols-rounded me-1" style="font-size:1rem;vertical-align:middle;">person</span>
            Trực tiếp
        </button>
        <button class="tab-btn" onclick="switchTab('anon', this)">
            <span class="material-symbols-rounded me-1" style="font-size:1rem;vertical-align:middle;">visibility_off</span>
            Ẩn danh
        </button>
    </div>

    <div id="tabDirect">
        <div class="inq-loading">Đang tải...</div>
    </div>
    <div id="tabAnon" style="display:none">
        <div class="inq-loading">Đang tải...</div>
    </div>
</div>

<a href="@Url.Action("Create", "EmployeeInquiry")" class="inq-fab">
    <span class="material-symbols-rounded" style="font-size:1.6rem;">add</span>
</a>

@section Scripts {
<script>
const ANON_KEY = 'anon_chat_token';

function getAnonToken() {
    let t = localStorage.getItem(ANON_KEY);
    if (!t) {
        t = 'anon-' + Date.now() + '-' + Math.random().toString(36).substr(2, 9);
        localStorage.setItem(ANON_KEY, t);
    }
    return t;
}

function switchTab(tab, el) {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    el.classList.add('active');
    document.getElementById('tabDirect').style.display = tab === 'direct' ? '' : 'none';
    document.getElementById('tabAnon').style.display   = tab === 'anon'   ? '' : 'none';
}

function esc(s) {
    return (s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

function fmtTime(ds) {
    if (!ds) return '';
    const d = new Date(ds), diff = Math.floor((Date.now() - d) / 1000);
    if (diff < 60)    return 'Vừa xong';
    if (diff < 3600)  return Math.floor(diff/60) + ' phút trước';
    if (diff < 86400) return Math.floor(diff/3600) + ' giờ trước';
    return d.toLocaleDateString('vi-VN');
}

function renderList(items, containerId, isAnon) {
    const el = document.getElementById(containerId);
    if (!items || items.length === 0) {
        el.innerHTML = `<div class="inq-empty"><span class="material-symbols-rounded ei" style="font-size:3rem;color:#c7d2fe;">forum</span><p>${isAnon ? 'Chưa có hội thoại ẩn danh' : 'Chưa có hội thoại nào'}</p></div>`;
        return;
    }
    el.innerHTML = '<div class="inq-list">' + items.map(i => {
        const unread = i.unreadEmp;
        const statusClass = i.status === 'OPEN' ? 'status-open' : 'status-closed';
        const statusText  = i.status === 'OPEN' ? 'Mở' : 'Đóng';
        const href = isAnon
            ? `@Url.Action("Chat","EmployeeInquiry")?id=${i.id}&anonToken=${encodeURIComponent(getAnonToken())}`
            : `@Url.Action("Chat","EmployeeInquiry")?id=${i.id}`;
        const bg  = i.topicColor  ? `background:${i.topicColor}22;` : 'background:#e0e7ff;';
        const ico = i.topicIcon   ? i.topicIcon : 'chat';
        return `
        <a class="inq-card" href="${esc(href)}">
            <div class="inq-card-icon" style="${bg}">
                <span class="material-symbols-rounded" style="color:#4f46e5">${esc(ico)}</span>
            </div>
            <div class="inq-card-body">
                <div class="inq-card-row1">
                    <span class="inq-card-no">${esc(i.inquiryNo)}</span>
                    <span class="inq-card-status ${statusClass}">${statusText}</span>
                    ${unread > 0 ? `<span class="inq-unread ms-auto">${unread}</span>` : ''}
                </div>
                <div class="inq-card-subject">${esc(i.subject || i.topicName || 'Hội thoại mới')}</div>
                <div class="inq-card-meta">
                    <span class="inq-card-topic">${esc(i.topicName || '')}</span>
                    ${i.lastMsgDt ? `<span class="inq-card-time">· ${fmtTime(i.lastMsgDt)}</span>` : ''}
                </div>
            </div>
        </a>`;
    }).join('') + '</div>';
}

let countDirect = 0, countAnon = 0;
function updateHeroSub() {
    const total = countDirect + countAnon;
    document.getElementById('heroSub').textContent =
        countAnon > 0 ? `${countDirect} trực tiếp · ${countAnon} ẩn danh` : `${total} hội thoại`;
}

async function loadDirect() {
    try {
        const res  = await fetch('@Url.Action("GetMyList","EmployeeInquiry")');
        const data = await res.json();
        renderList(data.data || [], 'tabDirect', false);
        countDirect = (data.data || []).length;
        updateHeroSub();
    } catch {
        document.getElementById('tabDirect').innerHTML = '<div class="inq-empty"><p>Không tải được dữ liệu</p></div>';
    }
}

async function loadAnon() {
    try {
        const tok = getAnonToken();
        const res  = await fetch(`@Url.Action("GetAnonList","EmployeeInquiry")?token=${encodeURIComponent(tok)}`);
        const data = await res.json();
        renderList(data.data || [], 'tabAnon', true);
        countAnon = (data.data || []).length;
        updateHeroSub();
    } catch {
        document.getElementById('tabAnon').innerHTML = '<div class="inq-empty"><p>Không tải được dữ liệu</p></div>';
    }
}

loadDirect();
loadAnon();
</script>
}
