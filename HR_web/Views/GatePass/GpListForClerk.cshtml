@{
    ViewData["Title"] = "Theo Dõi Ra Vào Cổng";
    var filterDate = DateTime.Today.ToString("yyyy-MM-dd");
}

@section Styles {
<style>
    .stats-card .icon { width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; border-radius: 12px; }
    #gpTableBody tr td { vertical-align: middle; }
    .pagination .page-link { cursor: pointer; }
    .txt-clamp { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; max-width:160px; cursor:default; }
    .pagination .page-item.disabled .page-link { cursor: default; }
    .sig-cell      { display:flex; gap:8px; justify-content:center; align-items:flex-start; }
    .sig-cell-item { text-align:center; min-width:80px; }
    .sig-cell-lbl  { font-size:.6rem; font-weight:700; color:#94a3b8; text-transform:uppercase; letter-spacing:.04em; margin-bottom:2px; }
    .sig-cell-img  { display:block; margin:0 auto; max-height:55px; max-width:110px; object-fit:contain; background:#fafafa; border-radius:4px; padding:2px; }
    .sig-cell-name { font-size:.65rem; color:#64748b; margin-top:2px; line-height:1.2; }
</style>
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-6 col-xl-3 mb-3 mb-xl-0">
            <div class="card stats-card" data-filter-status=""><div class="card-body p-3"><div class="row"><div class="col-8"><p class="text-sm mb-0 text-uppercase font-weight-bold text-secondary">Tổng</p><h5 class="font-weight-bolder mb-0" id="summaryTotal">-</h5></div><div class="col-4 text-end"><div class="icon bg-gradient-info text-white shadow-info ms-auto"><i class="bi bi-door-open fs-4"></i></div></div></div></div></div>
        </div>
        <div class="col-6 col-xl-3 mb-3 mb-xl-0">
            <div class="card stats-card" data-filter-status="PENDING"><div class="card-body p-3"><div class="row"><div class="col-8"><p class="text-sm mb-0 text-uppercase font-weight-bold text-warning">Chờ Duyệt</p><h5 class="font-weight-bolder mb-0" id="summaryPending">-</h5></div><div class="col-4 text-end"><div class="icon bg-gradient-warning text-white shadow-warning ms-auto"><i class="bi bi-hourglass-split fs-4"></i></div></div></div></div></div>
        </div>
        <div class="col-6 col-xl-3 mb-3 mb-xl-0">
            <div class="card stats-card" data-filter-status="APPROVED"><div class="card-body p-3"><div class="row"><div class="col-8"><p class="text-sm mb-0 text-uppercase font-weight-bold text-success">Đã Duyệt</p><h5 class="font-weight-bolder mb-0" id="summaryApproved">-</h5></div><div class="col-4 text-end"><div class="icon bg-gradient-success text-white shadow-success ms-auto"><i class="bi bi-check-circle-fill fs-4"></i></div></div></div></div></div>
        </div>
        <div class="col-6 col-xl-3 mb-3 mb-xl-0">
            <div class="card stats-card" data-filter-status="REJECTED"><div class="card-body p-3"><div class="row"><div class="col-8"><p class="text-sm mb-0 text-uppercase font-weight-bold text-danger">Từ Chối</p><h5 class="font-weight-bolder mb-0" id="summaryRejected">-</h5></div><div class="col-4 text-end"><div class="icon bg-gradient-danger text-white shadow-danger ms-auto"><i class="bi bi-x-circle-fill fs-4"></i></div></div></div></div></div>
        </div>
    </div>

    <div class="card my-4">
        <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
           <div class="bg-gradient-info shadow-info border-radius-lg pt-3 pb-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h6 class="text-white mb-0"><i class="bi bi-clipboard-data me-1"></i> Theo Dõi Ra Vào Cổng Bộ Phận</h6>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <button type="button" id="exportExcelBtn" class="btn btn-sm btn-success mb-0 text-nowrap d-flex align-items-center" style="height:36px;">
                        <i class="bi bi-file-earmark-excel me-1 fs-6"></i> Xuất Excel
                    </button>
                    <div class="d-flex align-items-center bg-white border-radius-md px-2 shadow-sm" style="height:34px;gap:4px;">
                        <i class="bi bi-calendar3 text-info"></i>
                        <input type="date" id="filterDate" class="form-control form-control-sm border-0 bg-transparent text-dark p-0" style="width:120px;" value="@filterDate" onchange="loadData(1)" />
                    </div>
                </div>
            </div>
        </div>

        @await Html.PartialAsync("_GPFilterBar", new HR_web.Models.GatePass.GpFilterBarModel
        {
            DeptUrl = Url.Action("GetDeptByScope", "Dropdown")!,
            LineUrl = Url.Action("GetLineByScope", "Dropdown")!,
            WorkUrl = Url.Action("GetWorkByScope", "Dropdown")!
        })

        <div class="card-body px-0 pt-0 pb-2 mt-1">
            <div class="table-responsive p-0 px-4">
                <table class="table align-items-center mb-0 w-100 table-hover table-striped">
                    <thead class="bg-light">
                        <tr>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2" data-mobile="hidden">#</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2" data-mobile="primary" data-mobile-slot="code" data-mobile-label="Mã NV">Mã NV</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2" data-mobile="primary" data-mobile-slot="name" data-mobile-label="Họ &amp; Tên">Họ &amp; Tên</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2" data-mobile="primary" data-mobile-label="Loại GP">Loại GP</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2" data-mobile="primary" data-mobile-label="Ngày">Ngày</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2" data-mobile="detail" data-mobile-label="Giờ Ra">Giờ Ra</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2" data-mobile="detail" data-mobile-label="Giờ Vào">Giờ Vào</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2" data-mobile="detail" data-mobile-label="Lý Do">Lý Do</th>
                            <th class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-9" data-mobile="primary" data-mobile-label="Tình Trạng">Tình Trạng</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2" data-mobile="detail" data-mobile-label="Người Ký">Người Ký</th>
                            <th class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-9" data-mobile="detail" data-mobile-label="Chữ Ký">Chữ Ký</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2" data-mobile="detail" data-mobile-label="Ghi Chú">Ghi Chú</th>
                        </tr>
                    </thead>
                    <tbody id="gpTableBody"></tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center px-4 mt-3 mb-2">
                <div id="paginationCount" class="text-sm text-secondary"></div>
                <nav><ul class="pagination pagination-sm mb-0" id="paginationBar"></ul></nav>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/vendor/xlsx.full.min.js" asp-append-version="true"></script>
<script src="~/js/xlsx-export-helper.js" asp-append-version="true"></script>
<script>
const PAGE_URL = '@Url.Action("GetClerkPage", "GatePass")';
const SIG_URL  = '@Url.Action("GetSignature", "Image")';
let currentPage = 1, totalPages = 1, totalRecords = 0, pageSize = 50;

const GP_TYPE_LABEL = { IN: 'Đến trễ', OUT: 'Về sớm', MID: 'Ra/Vào trong giờ làm' };

function buildRow(item, idx) {
    const dateStr    = formatDate(item.OUT_TIME || item.IN_TIME);
    const outStr     = item.OUT_TIME ? formatTime(item.OUT_TIME) : '-';
    const inStr      = item.IN_TIME  ? formatTime(item.IN_TIME)  : '-';
    const gpLabel    = GP_TYPE_LABEL[item.GP_TYPE] || item.GP_TYPE || '-';
    const approver   = escHtml(item.APPROVER_NAME || item.FINAL_APPROVER || '-');
    const signTime   = item.FINAL_DATE ? formatDateTime(item.FINAL_DATE) : '-';
    const remark     = escHtml(item.REMARK || '-');

    let statusHtml = `<span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Chờ duyệt</span>`;
    if (item.STATUS === 'APPROVED') statusHtml = `<span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Đã duyệt</span>`;
    if (item.STATUS === 'REJECTED') statusHtml = `<span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Từ chối</span>`;

    const deptLine = [item.DEPT_NAME, item.LINE_NAME].filter(Boolean).join(' • ');

    const reqSig = item.EMPCD
        ? `<div class="sig-cell-item">
               <div class="sig-cell-lbl">Người ký</div>
               <img src="${SIG_URL}?empCd=${encodeURIComponent(item.EMPCD)}" class="sig-cell-img" onerror="this.remove()" alt="Chữ ký"/>
           </div>` : '';
    const apSig = (item.STATUS !== 'PENDING' && item.FINAL_APPROVER)
        ? `<div class="sig-cell-item">
               <div class="sig-cell-lbl">Người duyệt</div>
               <img src="${SIG_URL}?empCd=${encodeURIComponent(item.FINAL_APPROVER)}" class="sig-cell-img" onerror="this.remove()" alt="Chữ ký"/>
               ${item.APPROVER_NAME ? `<div class="sig-cell-name vni-font">${escHtml(item.APPROVER_NAME)}</div>` : ''}
           </div>` : '';
    const sigCell = `<div class="sig-cell">${reqSig}${apSig}</div>`;

    return `<tr>
        <td class="px-2 text-xs text-secondary">${idx}</td>
        <td class="px-2 text-sm">${escHtml(item.EMPCD||'')}</td>
        <td class="px-2">
            <div class="emp-name vni-font" style="text-transform:uppercase;font-size:.9rem;">${escHtml(item.EMP_NAME||'')}</div>
            ${deptLine ? `<div class="text-xxs text-secondary">${escHtml(deptLine)}</div>` : ''}
        </td>
        <td class="px-2 text-sm"><span class="badge bg-info">${gpLabel}</span></td>
        <td class="px-2 text-sm">${dateStr}</td>
        <td class="px-2 text-sm">${outStr}</td>
        <td class="px-2 text-sm">${inStr}</td>
        <td class="px-2 text-sm"><div class="txt-clamp" title="${escHtml(item.REASON||'')}">${escHtml(item.REASON||'-')}</div></td>
        <td class="text-center">${statusHtml}</td>
        <td class="px-2">
            <div class="emp-name vni-font" style="text-transform:uppercase;font-size:.9rem;">${approver}</div>
            ${signTime !== '-' ? `<div class="text-xxs text-secondary">${signTime}</div>` : ''}
        </td>
        <td class="text-center">${sigCell}</td>
        <td class="px-2 text-sm"><div class="txt-clamp" title="${escHtml(item.REMARK||'')}">${remark}</div></td>
    </tr>`;
}

function getParams(page) {
    return {
        status:    $('#filterStatus').val(),
        search:    $('#searchInput').val(),
        dept_id:   $('#filterDept').val(),
        line_id:   $('#filterLine').val(),
        work_id:   $('#filterWork').val(),
        date_from: $('#filterDate').val(),
        date_to:   $('#filterDate').val(),
        page,
        page_size: pageSize
    };
}

function loadData(page = 1) {
    currentPage = page;
    $('#gpTableBody').html(`<tr><td colspan="12" class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></td></tr>`);
    MobileTableHelper.refresh('gpTableBody');
    $.ajax({
        url: PAGE_URL, type: 'GET', data: getParams(page),
        success: function(res) {
            if (!res.success) {
                $('#gpTableBody').html(`<tr><td colspan="12" class="text-center text-danger py-4">Lỗi: ${res.message||''}</td></tr>`);
                return;
            }
            const s = res.summary || {};
            $('#summaryTotal').text((s.TOTAL||0).toLocaleString());
            $('#summaryPending').text((s.PENDING||0).toLocaleString());
            $('#summaryApproved').text((s.APPROVED||0).toLocaleString());
            $('#summaryRejected').text((s.REJECTED||0).toLocaleString());
            totalRecords = res.total || 0;
            totalPages   = res.total_pages || 0;
            const data   = res.data || [];
            if (!data.length) {
                $('#gpTableBody').html(`<tr><td colspan="12" class="text-center text-muted py-4"><img src="@(new Random().Next(2)==0 ? Url.Content("~/assets/img/illustrations/A_nodata.png") : Url.Content("~/assets/img/illustrations/Chi_nodata.png"))" alt="" style="max-width:140px;display:block;margin:0 auto .5rem;opacity:.9;" />Không có dữ liệu</td></tr>`);
            } else {
                $('#gpTableBody').html(data.map((item,i) => buildRow(item,(page-1)*pageSize+i+1)).join(''));
            }
            renderPagination();
        },
        error: function(xhr) {
            $('#gpTableBody').html(`<tr><td colspan="12" class="text-center text-danger py-4">Lỗi kết nối (${xhr.status})</td></tr>`);
        },
        complete: function() { MobileTableHelper.refresh('gpTableBody'); }
    });
}

function renderPagination() {
    if (!totalRecords) { $('#paginationCount').text(''); $('#paginationBar').empty(); return; }
    const s=(currentPage-1)*pageSize+1,e=Math.min(currentPage*pageSize,totalRecords);
    $('#paginationCount').html(`Trang <strong>${currentPage}</strong> / ${totalPages} &nbsp;|&nbsp; ${s}-${e} / ${totalRecords}`);
    const $bar=$('#paginationBar').empty();
    const mk=(label,p,disabled,active)=>{const li=$('<li class="page-item">').toggleClass('disabled',!!disabled).toggleClass('active',!!active);$('<a class="page-link">').html(label).on('click',()=>{if(!disabled&&!active)loadData(p);}).appendTo(li);return li;};
    $bar.append(mk('&lsaquo;',currentPage-1,currentPage<=1));
    let from=Math.max(1,currentPage-2),to=Math.min(totalPages,currentPage+2);
    for(let p=from;p<=to;p++) $bar.append(mk(p,p,false,p===currentPage));
    $bar.append(mk('&rsaquo;',currentPage+1,currentPage>=totalPages));
}

$('#filterDept').on('change', function() { $('#filterLine, #filterWork').val(null).trigger('change.select2'); loadData(1); });
$('#filterLine').on('change', function() { $('#filterWork').val(null).trigger('change.select2'); loadData(1); });
$('#filterStatus, #filterGpType, #filterWork').on('change', () => loadData(1));
$('#searchInput').on('input', debounce(() => loadData(1), 400));
$('#pageSizeSelect').on('change', function() { pageSize = parseInt($(this).val()); loadData(1); });

$('#exportExcelBtn').on('click', async function() {
    const $btn=$(this), originalHtml=$btn.html();
    $btn.prop('disabled',true).html('<span class="spinner-border spinner-border-sm me-1"></span> Đang xuất...');
    try {
        let exportRows=[], pg=1, pgTotal=1;
        do {
            const p = getParams(pg); p.page_size = 1000;
            const res = await $.getJSON(PAGE_URL, p);
            if (!res || !res.success) break;
            pgTotal = res.total_pages; exportRows = exportRows.concat(res.data||[]);
            pg++;
        } while (pg <= pgTotal);
        if (!exportRows.length) { showToast('Không có dữ liệu để xuất', 'warning'); return; }
        const headers = ['STT','Mã NV','Họ Tên','Bộ Phận','Line','Loại GP','Ngày','Giờ Ra','Giờ Vào','Lý Do','Tình Trạng','Người Ký','Giờ Ký','Ghi Chú'];
        let html = '<html><head><meta charset="utf-8"/></head><body><table border="1"><thead><tr>';
        html += headers.map(h=>`<th style="background:#cfe2ff;font-weight:bold">${h}</th>`).join('') + '</tr></thead><tbody>';
        exportRows.forEach((r,i) => {
            const s = r.STATUS==='APPROVED'?'Đã duyệt':(r.STATUS==='REJECTED'?'Từ chối':'Chờ duyệt');
            const gp = GP_TYPE_LABEL[r.GP_TYPE]||r.GP_TYPE||'';
            const approver = escHtml(r.APPROVER_NAME || r.FINAL_APPROVER || '');
            const signTime = r.FINAL_DATE ? formatDateTime(r.FINAL_DATE) : '';
            const remark   = escHtml(r.REMARK || '');
            html += `<tr><td>${i+1}</td><td data-t="s">${escHtml(r.EMPCD||'')}</td><td>${escHtml(r.EMP_NAME||'')}</td><td>${escHtml(r.DEPT_NAME||'')}</td><td>${escHtml(r.LINE_NAME||'')}</td><td>${gp}</td><td>${formatDate(r.OUT_TIME||r.IN_TIME)}</td><td>${r.OUT_TIME?formatTime(r.OUT_TIME):''}</td><td>${r.IN_TIME?formatTime(r.IN_TIME):''}</td><td>${escHtml(r.REASON||'')}</td><td>${s}</td><td>${approver}</td><td>${signTime}</td><td>${remark}</td></tr>`;
        });
        html += '</tbody></table></body></html>';
        exportHtmlTableToXlsx(html, `GatePass_Export_${$('#filterDate').val()}.xlsx`);
    } catch(err) { showToast('Lỗi xuất file: '+err.message, 'error'); }
    finally { $btn.prop('disabled',false).html(originalHtml); }
});

function formatTime(s){ const d=new Date(s); if(isNaN(d)) return''; return('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2); }
function formatDate(s){ if(!s) return '-'; const d=new Date(s); if(isNaN(d)) return ''; return('0'+d.getDate()).slice(-2)+'/'+('0'+(d.getMonth()+1)).slice(-2)+'/'+d.getFullYear(); }
function formatDateTime(s){ if(!s) return ''; const d=new Date(s); if(isNaN(d)) return ''; return formatDate(s)+' '+formatTime(s); }
function escHtml(str){ return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function debounce(fn,d){ let t; return function(){ clearTimeout(t); t=setTimeout(fn,d); }; }

$(document).ready(function() {
    if (typeof Select2Helper !== 'undefined') Select2Helper.init();
    MobileTableHelper.init('gpTableBody');
    loadData(1);
});
</script>
}
