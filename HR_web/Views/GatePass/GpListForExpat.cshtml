@{
    ViewData["Title"] = "Gate Pass Approval";
    var filterDate = DateTime.Today.ToString("yyyy-MM-dd");
}

@section Styles {
<style>
    .stats-card .icon { width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; border-radius: 12px; }
    #gpTableBody tr td { vertical-align: middle; }
    .pagination .page-link { cursor: pointer; }
    .txt-clamp { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; max-width:160px; cursor:default; }
    .sig-cell      { display:flex; gap:8px; justify-content:center; align-items:flex-start; }
    .sig-cell-item { text-align:center; min-width:80px; }
    .sig-cell-lbl  { font-size:.6rem; font-weight:700; color:#94a3b8; text-transform:uppercase; letter-spacing:.04em; margin-bottom:2px; }
    .sig-cell-img  { display:block; margin:0 auto; max-height:55px; max-width:110px; object-fit:contain; background:#fafafa; border-radius:4px; padding:2px; }
    .sig-cell-name { font-size:.65rem; color:#64748b; margin-top:2px; line-height:1.2; }
    .pagination .page-item.disabled .page-link { cursor: default; }
    @@media (max-width: 767px) {
        .container-fluid { padding-left: 8px !important; padding-right: 8px !important; }
        .card-header .bg-gradient-primary { flex-direction: column; align-items: flex-start !important; gap: 8px; }
        .stats-card .icon { width: 38px; height: 38px; }
        .pagination .page-link { padding: .25rem .45rem; font-size: .75rem; }
    }
</style>
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-6 col-xl-3 mb-xl-0 mb-3">
            <div class="card stats-card"><div class="card-body p-3"><div class="row"><div class="col-8"><p class="text-sm mb-0 text-uppercase font-weight-bold text-secondary">Total</p><h5 class="font-weight-bolder mb-0" id="summaryTotal">-</h5></div><div class="col-4 text-end"><div class="icon bg-gradient-info text-white shadow-info ms-auto"><i class="bi bi-door-open fs-4"></i></div></div></div></div></div>
        </div>
        <div class="col-6 col-xl-3 mb-xl-0 mb-3">
            <div class="card stats-card"><div class="card-body p-3"><div class="row"><div class="col-8"><p class="text-sm mb-0 text-uppercase font-weight-bold text-warning">Pending</p><h5 class="font-weight-bolder mb-0" id="summaryPending">-</h5></div><div class="col-4 text-end"><div class="icon bg-gradient-warning text-white shadow-warning ms-auto"><i class="bi bi-hourglass-split fs-4"></i></div></div></div></div></div>
        </div>
        <div class="col-6 col-xl-3 mb-xl-0 mb-3">
            <div class="card stats-card"><div class="card-body p-3"><div class="row"><div class="col-8"><p class="text-sm mb-0 text-uppercase font-weight-bold text-success">Approved</p><h5 class="font-weight-bolder mb-0" id="summaryApproved">-</h5></div><div class="col-4 text-end"><div class="icon bg-gradient-success text-white shadow-success ms-auto"><i class="bi bi-check-circle-fill fs-4"></i></div></div></div></div></div>
        </div>
        <div class="col-6 col-xl-3 mb-xl-0 mb-3">
            <div class="card stats-card"><div class="card-body p-3"><div class="row"><div class="col-8"><p class="text-sm mb-0 text-uppercase font-weight-bold text-danger">Rejected</p><h5 class="font-weight-bolder mb-0" id="summaryRejected">-</h5></div><div class="col-4 text-end"><div class="icon bg-gradient-danger text-white shadow-danger ms-auto"><i class="bi bi-x-circle-fill fs-4"></i></div></div></div></div></div>
        </div>
    </div>

    <div class="card my-4">
        <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
            <div class="bg-gradient-primary shadow-primary border-radius-lg pt-3 pb-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h6 class="text-white mb-0"><i class="bi bi-shield-check me-1"></i> Gate Pass Approval</h6>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <div class="d-flex align-items-center bg-white border-radius-md px-2 shadow-sm" style="height:34px;gap:4px;">
                        <i class="bi bi-calendar3 text-primary"></i>
                        <input type="date" id="filterDate" class="form-control form-control-sm border-0 bg-transparent text-dark p-0" style="width:120px;" value="@filterDate" onchange="loadData(1)" />
                    </div>
                </div>
            </div>
        </div>

        @await Html.PartialAsync("_GPFilterBar", new HR_web.Models.GatePass.GpFilterBarModel
        {
            DeptUrl = Url.Action("GetDeptByScope", "Dropdown")!,
            LineUrl = Url.Action("GetLineByScope", "Dropdown")!,
            WorkUrl = Url.Action("GetWorkByScope", "Dropdown")!,
            Lang    = "en"
        })

        <div class="card-body px-0 pt-0 pb-2 mt-1">
            <div class="table-responsive p-0 px-4">
                <table class="table align-items-center mb-0 w-100 table-hover table-striped">
                    <thead class="bg-light">
                        <tr>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                data-mobile="hidden">#</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                data-mobile="primary" data-mobile-slot="code" data-mobile-label="Emp Code">Emp Code</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                data-mobile="primary" data-mobile-slot="name" data-mobile-label="Full Name">Full Name</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2 d-none d-md-table-cell"
                                data-mobile="detail" data-mobile-label="Dept / Line">Dept / Line</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                data-mobile="primary" data-mobile-slot="badge" data-mobile-label="Type">Type</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                data-mobile="primary" data-mobile-slot="badge" data-mobile-label="Date">Date</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2 d-none d-md-table-cell"
                                data-mobile="detail" data-mobile-label="Out Time">Out Time</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2 d-none d-md-table-cell"
                                data-mobile="detail" data-mobile-label="In Time">In Time</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2 d-none d-md-table-cell"
                                data-mobile="detail" data-mobile-label="Reason">Reason</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2 d-none d-md-table-cell"
                                data-mobile="detail" data-mobile-label="Remark">Remark</th>
                            <th class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-9"
                                data-mobile="primary" data-mobile-slot="badge" data-mobile-label="Status">Status</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2 d-none d-md-table-cell"
                                data-mobile="detail" data-mobile-label="Approved By">Approved By</th>
                            <th class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-9"
                                data-mobile="detail" data-mobile-label="Signature">Signature</th>
                            <th class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-9"
                                data-mobile="primary" data-mobile-slot="badge" data-mobile-label="Action">Action</th>
                        </tr>
                    </thead>
                    <tbody id="gpTableBody"></tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center px-4 mt-3 mb-2">
                <div id="paginationCount" class="text-sm text-secondary"></div>
                <nav><ul class="pagination pagination-sm mb-0" id="paginationBar"></ul></nav>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="actionModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header" id="actionModalHeader">
                <h6 class="modal-title mb-0" id="actionModalTitle"></h6>
            </div>
            <div class="modal-body">
                <input type="hidden" id="actionRequestId" />
                <input type="hidden" id="actionType" />
                <div class="mb-2">
                    <label class="form-label small fw-bold">Remark (optional)</label>
                    <textarea id="actionComment" class="form-control form-control-sm" rows="2" maxlength="200" oninput="$('#commentCount').text(this.value.length+'/200')"></textarea>
                    <div class="text-end text-xxs text-secondary mt-1"><span id="commentCount">0/200</span></div>
                </div>
                <div id="actionError" class="alert alert-danger d-none py-1 px-2 text-sm"></div>
            </div>
            <div class="modal-footer py-2">
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-sm text-white" id="confirmActionBtn" onclick="submitAction()">Confirm</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
const PAGE_URL      = '@Url.Action("GetSupervisorPage",  "GatePass")';
const APPROVE_URL   = '@Url.Action("ApproveRequest",     "GatePass")';
const REJECT_URL    = '@Url.Action("RejectRequest",      "GatePass")';
const SIG_URL       = '@Url.Action("GetSignature",       "Image")';
const CURRENT_EMPCD = '@ViewBag.CurrentEmpCd';
const CURRENT_ROLE  = '@ViewBag.CurrentRole';
const CAN_APPROVE   = ['Expat', 'Admin'].includes(CURRENT_ROLE);

// Role hierarchy — mirrors RoleHierarchyHelper
// Worker/Clerk/HR(1) → Supervisor(2) → DeputyManager(3) → Manager(4) → Expat(5) → Admin(99)
const ROLE_LEVELS = { Admin:99, Expat:5, Manager:4, DeputyManager:3, Supervisor:2, HR:1, Clerk:1, Worker:1 };
const MY_LEVEL    = ROLE_LEVELS[CURRENT_ROLE] || 1;
function canApproveRole(requesterRole) {
    return CAN_APPROVE && (ROLE_LEVELS[requesterRole] || 1) < MY_LEVEL;
}

let currentPage = 1, totalPages = 1, totalRecords = 0, pageSize = 50;

const GP_TYPE_LABEL = { IN: 'Late Arrival', OUT: 'Early Leave', MID: 'Out & In During Work' };

function buildRow(item, idx) {
    const dateStr = formatDate(item.OUT_TIME || item.IN_TIME);
    const outStr  = item.OUT_TIME ? formatTime(item.OUT_TIME) : '-';
    const inStr   = item.IN_TIME  ? formatTime(item.IN_TIME)  : '-';
    const gpLabel = GP_TYPE_LABEL[item.GP_TYPE] || item.GP_TYPE || '-';

    let statusHtml = `<span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Pending</span>`;
    if (item.STATUS === 'APPROVED') statusHtml = `<span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Approved</span>`;
    if (item.STATUS === 'REJECTED') statusHtml = `<span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Rejected</span>`;

    let remarkHtml = '<span class="text-muted text-xs">-</span>';
    if (item.REMARK && item.STATUS !== 'PENDING') {
        const isRejected = item.STATUS === 'REJECTED';
        const rkStyle = isRejected
            ? 'background:#fff0f0;border-left:3px solid #dc3545;color:#842029;'
            : 'background:#e8f4fd;border-left:3px solid #0d6efd;color:#084298;';
        remarkHtml = `<div class="px-2 py-1 rounded-end text-xs" style="${rkStyle}"><i class="bi bi-chat-left-text me-1"></i>${escHtml(item.REMARK)}</div>`;
    } else if (item.REMARK) {
        remarkHtml = `<div class="txt-clamp" title="${escHtml(item.REMARK)}">${escHtml(item.REMARK)}</div>`;
    }

    let approverHtml = '<span class="text-muted text-xs">-</span>';
    if (item.STATUS !== 'PENDING') {
        const approver = escHtml(item.APPROVER_NAME || item.FINAL_APPROVER || '');
        if (approver) {
            approverHtml = `<div class="emp-name vni-font" style="text-transform:uppercase;font-size:.85rem;">${approver}</div>`;
            if (item.FINAL_DATE) approverHtml += `<div class="text-xxs text-secondary">${formatDateTime(item.FINAL_DATE)}</div>`;
        }
    }

    const isSelf    = item.EMPCD === CURRENT_EMPCD;
    const approveOk = !isSelf && canApproveRole(item.REQUESTER_ROLE);
    const actions = item.STATUS !== 'PENDING'
        ? '<span class="text-muted text-xs">-</span>'
        : approveOk
            ? `<button class="btn btn-xs btn-success me-1" onclick="event.stopPropagation();openAction('${item.REQUEST_ID}','approve')"><i class="bi bi-check-lg"></i></button>
               <button class="btn btn-xs btn-danger"  onclick="event.stopPropagation();openAction('${item.REQUEST_ID}','reject')"><i class="bi bi-x-lg"></i></button>`
            : `<span class="text-warning text-xxs d-inline-block lh-sm" title="Please contact a higher-level manager for approval"><i class="bi bi-exclamation-triangle-fill me-1"></i>Need senior<br>approval</span>`;

    const reqSig = item.EMPCD
        ? `<div class="sig-cell-item">
               <div class="sig-cell-lbl">Requester</div>
               <img src="${SIG_URL}?empCd=${encodeURIComponent(item.EMPCD)}" class="sig-cell-img" onerror="this.remove()" alt="Signature"/>
           </div>` : '';
    const apSig = (item.STATUS !== 'PENDING' && item.FINAL_APPROVER)
        ? `<div class="sig-cell-item">
               <div class="sig-cell-lbl">Approver</div>
               <img src="${SIG_URL}?empCd=${encodeURIComponent(item.FINAL_APPROVER)}" class="sig-cell-img" onerror="this.remove()" alt="Signature"/>
               ${item.APPROVER_NAME ? `<div class="sig-cell-name vni-font">${escHtml(item.APPROVER_NAME)}</div>` : ''}
           </div>` : '';
    const sigCell = `<div class="sig-cell">${reqSig}${apSig}</div>`;

    return `<tr>
        <td class="px-2 text-xs text-secondary">${idx}</td>
        <td class="px-2 text-sm">${escHtml(item.EMPCD||'')}</td>
        <td class="px-2 text-sm emp-name vni-font" style="text-transform:uppercase;">${escHtml(item.EMP_NAME||'')}</td>
        <td class="px-2 text-sm d-none d-md-table-cell">${escHtml(item.DEPT_NAME||'')} / ${escHtml(item.LINE_NAME||'')}</td>
        <td class="px-2 text-sm"><span class="badge bg-info">${gpLabel}</span></td>
        <td class="px-2 text-sm">${dateStr}</td>
        <td class="px-2 text-sm d-none d-md-table-cell">${outStr}</td>
        <td class="px-2 text-sm d-none d-md-table-cell">${inStr}</td>
        <td class="px-2 text-sm d-none d-md-table-cell"><div class="txt-clamp" title="${escHtml(item.REASON||'')}">${escHtml(item.REASON||'-')}</div></td>
        <td class="px-2 text-sm d-none d-md-table-cell">${remarkHtml}</td>
        <td class="text-center">${statusHtml}</td>
        <td class="px-2 d-none d-md-table-cell">${approverHtml}</td>
        <td class="text-center">${sigCell}</td>
        <td class="text-center">${actions}</td>
    </tr>`;
}

function getParams(page) {
    return {
        status:    $('#filterStatus').val(),
        search:    $('#searchInput').val(),
        dept_id:   $('#filterDept').val(),
        line_id:   $('#filterLine').val(),
        work_id:   $('#filterWork').val(),
        date_from: $('#filterDate').val(),
        date_to:   $('#filterDate').val(),
        page,
        page_size: pageSize
    };
}

function loadData(page = 1) {
    currentPage = page;
    $('#gpTableBody').html(`<tr><td colspan="14" class="text-center py-5"><div class="spinner-border text-primary" role="status"></div><div class="mt-2 text-sm text-secondary">Loading...</div></td></tr>`);
    MobileTableHelper.refresh('gpTableBody');
    $.ajax({
        url: PAGE_URL, type: 'GET', data: getParams(page),
        success: function(res) {
            if (!res.success) {
                $('#gpTableBody').html(`<tr><td colspan="14" class="text-center text-danger py-4">Error: ${res.message||''}</td></tr>`);
                MobileTableHelper.refresh('gpTableBody');
                return;
            }
            const s = res.summary || {};
            $('#summaryTotal').text((s.TOTAL||0).toLocaleString());
            $('#summaryPending').text((s.PENDING||0).toLocaleString());
            $('#summaryApproved').text((s.APPROVED||0).toLocaleString());
            $('#summaryRejected').text((s.REJECTED||0).toLocaleString());
            totalRecords = res.total || 0;
            totalPages   = res.total_pages || 0;
            const data   = res.data || [];
            if (!data.length) {
                $('#gpTableBody').html(`<tr><td colspan="14" class="text-center text-muted py-4"><img src="@(new Random().Next(2)==0 ? Url.Content("~/assets/img/illustrations/A_nodata.png") : Url.Content("~/assets/img/illustrations/Chi_nodata.png"))" alt="" style="max-width:140px;display:block;margin:0 auto .5rem;opacity:.9;" />No data found</td></tr>`);
            } else {
                $('#gpTableBody').html(data.map((item,i) => buildRow(item,(page-1)*pageSize+i+1)).join(''));
            }
            renderPagination();
            MobileTableHelper.refresh('gpTableBody');
        },
        error: function(xhr) {
            $('#gpTableBody').html(`<tr><td colspan="14" class="text-center text-danger py-4">Connection error (${xhr.status})</td></tr>`);
            MobileTableHelper.refresh('gpTableBody');
        }
    });
}

function renderPagination() {
    if (!totalRecords) { $('#paginationCount').text(''); $('#paginationBar').empty(); return; }
    const s=(currentPage-1)*pageSize+1, e=Math.min(currentPage*pageSize,totalRecords);
    $('#paginationCount').html(`<span class="text-xs">${s}–${e} / <strong>${totalRecords}</strong> requests</span>`);
    const $bar=$('#paginationBar').empty();
    const mk=(label,p,disabled,active)=>{const li=$('<li class="page-item">').toggleClass('disabled',!!disabled).toggleClass('active',!!active);$('<a class="page-link">').html(label).on('click',()=>{if(!disabled&&!active)loadData(p);}).appendTo(li);return li;};
    $bar.append(mk('&lsaquo;',currentPage-1,currentPage<=1));
    let from=Math.max(1,currentPage-2),to=Math.min(totalPages,currentPage+2);
    for(let p=from;p<=to;p++) $bar.append(mk(p,p,false,p===currentPage));
    $bar.append(mk('&rsaquo;',currentPage+1,currentPage>=totalPages));
}

function openAction(id, type) {
    $('#actionRequestId').val(id); $('#actionType').val(type); $('#actionComment').val(''); $('#actionError').addClass('d-none').text('');
    const isApprove = type === 'approve';
    $('#actionModalHeader').removeClass('bg-success bg-danger').addClass(isApprove ? 'bg-success text-white' : 'bg-danger text-white');
    $('#actionModalTitle').text(isApprove ? 'Approve Gate Pass' : 'Reject Gate Pass');
    $('#confirmActionBtn').removeClass('btn-success btn-danger').addClass(isApprove ? 'btn-success' : 'btn-danger');
    new bootstrap.Modal('#actionModal').show();
}

async function submitAction() {
    const id      = $('#actionRequestId').val();
    const type    = $('#actionType').val();
    const comment = $('#actionComment').val();
    const url     = type === 'approve' ? APPROVE_URL : REJECT_URL;
    const $btn    = $('#confirmActionBtn').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>...');
    try {
        const res = await $.ajax({ url, type: 'POST', data: { request_id: id, comment } });
        if (res.success) {
            bootstrap.Modal.getInstance('#actionModal').hide();
            showToast(type === 'approve' ? 'Gate pass approved successfully' : 'Gate pass rejected', type === 'approve' ? 'success' : 'warning');
            loadData(currentPage);
        } else {
            $('#actionError').removeClass('d-none').text(res.message || 'Processing error');
        }
    } catch { $('#actionError').removeClass('d-none').text('Connection error'); }
    finally  { $btn.prop('disabled', false).text('Confirm'); }
}

$('#filterDept').on('change', function() { $('#filterLine, #filterWork').val(null).trigger('change.select2'); loadData(1); });
$('#filterLine').on('change', function() { $('#filterWork').val(null).trigger('change.select2'); loadData(1); });
$('#filterStatus, #filterGpType, #filterWork').on('change', () => loadData(1));
$('#searchInput').on('input', debounce(() => loadData(1), 400));
$('#pageSizeSelect').on('change', function() { pageSize = parseInt($(this).val()); loadData(1); });

function formatTime(s){ const d=new Date(s); if(isNaN(d)) return''; return('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2); }
function formatDate(s){ if(!s) return '-'; const d=new Date(s); if(isNaN(d)) return ''; return('0'+d.getDate()).slice(-2)+'/'+('0'+(d.getMonth()+1)).slice(-2)+'/'+d.getFullYear(); }
function formatDateTime(s){ if(!s) return ''; const d=new Date(s); if(isNaN(d)) return ''; return formatDate(s)+' '+formatTime(s); }
function escHtml(str){ return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function debounce(fn,d){ let t; return function(){ clearTimeout(t); t=setTimeout(fn,d); }; }

$(document).ready(function() {
    MobileTableHelper.init('gpTableBody');
    if (typeof Select2Helper !== 'undefined') Select2Helper.init();
    loadData(1);
});
</script>
}
