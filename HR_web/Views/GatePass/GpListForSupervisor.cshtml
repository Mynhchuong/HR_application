@{
    ViewData["Title"] = "Duyệt Phiếu Ra Vào";
    var dateFrom = ViewBag.DateFrom as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    var dateTo   = ViewBag.DateTo   as string ?? DateTime.Today.ToString("yyyy-MM-dd");
}

@section Styles {
<style>
    .stats-card .icon { width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; border-radius: 12px; }
    #gpTableBody tr td { vertical-align: middle; }
    .pagination .page-link { cursor: pointer; }
    .pagination .page-item.disabled .page-link { cursor: default; }
    @@media (max-width: 767px) {
        .container-fluid { padding-left: 8px !important; padding-right: 8px !important; }
        .card-header .bg-gradient-primary { flex-direction: column; align-items: flex-start !important; gap: 8px; }
        .stats-card .icon { width: 38px; height: 38px; }
        .pagination .page-link { padding: .25rem .45rem; font-size: .75rem; }
    }
</style>
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-6 col-xl-3 mb-xl-0 mb-3">
            <div class="card stats-card"><div class="card-body p-3"><div class="row"><div class="col-8"><p class="text-sm mb-0 text-uppercase font-weight-bold text-secondary">Tổng</p><h5 class="font-weight-bolder mb-0" id="summaryTotal">-</h5></div><div class="col-4 text-end"><div class="icon bg-gradient-info text-white shadow-info ms-auto"><i class="bi bi-door-open fs-4"></i></div></div></div></div></div>
        </div>
        <div class="col-6 col-xl-3 mb-xl-0 mb-3">
            <div class="card stats-card"><div class="card-body p-3"><div class="row"><div class="col-8"><p class="text-sm mb-0 text-uppercase font-weight-bold text-warning">Chờ Duyệt</p><h5 class="font-weight-bolder mb-0" id="summaryPending">-</h5></div><div class="col-4 text-end"><div class="icon bg-gradient-warning text-white shadow-warning ms-auto"><i class="bi bi-hourglass-split fs-4"></i></div></div></div></div></div>
        </div>
        <div class="col-6 col-xl-3 mb-xl-0 mb-3">
            <div class="card stats-card"><div class="card-body p-3"><div class="row"><div class="col-8"><p class="text-sm mb-0 text-uppercase font-weight-bold text-success">Đã Duyệt</p><h5 class="font-weight-bolder mb-0" id="summaryApproved">-</h5></div><div class="col-4 text-end"><div class="icon bg-gradient-success text-white shadow-success ms-auto"><i class="bi bi-check-circle-fill fs-4"></i></div></div></div></div></div>
        </div>
        <div class="col-6 col-xl-3 mb-xl-0 mb-3">
            <div class="card stats-card"><div class="card-body p-3"><div class="row"><div class="col-8"><p class="text-sm mb-0 text-uppercase font-weight-bold text-danger">Từ Chối</p><h5 class="font-weight-bolder mb-0" id="summaryRejected">-</h5></div><div class="col-4 text-end"><div class="icon bg-gradient-danger text-white shadow-danger ms-auto"><i class="bi bi-x-circle-fill fs-4"></i></div></div></div></div></div>
        </div>
    </div>

    <div class="card my-4">
        <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
            <div class="bg-gradient-primary shadow-primary border-radius-lg pt-3 pb-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h6 class="text-white mb-0"><i class="bi bi-shield-check me-1"></i> Duyệt Phiếu Ra Vào Nhân Viên</h6>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <div class="input-group input-group-sm bg-white border-radius-md px-2 py-1 align-items-center shadow-sm" style="height:36px;">
                        <label class="mb-0 text-dark fw-bold me-2 text-nowrap"><i class="bi bi-calendar3 text-primary me-1"></i> Từ:</label>
                        <input type="date" id="dateFrom" class="form-control form-control-sm border-0 bg-transparent text-dark p-0" style="width:120px;" value="@dateFrom" />
                        <label class="mb-0 text-dark fw-bold mx-2 text-nowrap">Đến:</label>
                        <input type="date" id="dateTo" class="form-control form-control-sm border-0 bg-transparent text-dark p-0" style="width:120px;" value="@dateTo" />
                        <button class="btn btn-sm btn-primary ms-2 py-0 px-2" onclick="loadData(1)"><i class="bi bi-search"></i></button>
                    </div>
                </div>
            </div>
        </div>

        @await Html.PartialAsync("_GPFilterBar", new HR_web.Models.GatePass.GpFilterBarModel
        {
            DeptUrl = Url.Action("GetDeptByScope", "Dropdown")!,
            LineUrl = Url.Action("GetLineByScope", "Dropdown")!,
            WorkUrl = Url.Action("GetWorkByScope", "Dropdown")!
        })

        <div class="card-body px-0 pt-0 pb-2 mt-1">
            <div class="table-responsive p-0 px-4">
                <table class="table align-items-center mb-0 w-100 table-hover table-striped">
                    <thead class="bg-light">
                        <tr>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                data-mobile="hidden">#</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                data-mobile="primary" data-mobile-slot="code" data-mobile-label="Mã NV">Mã NV</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                data-mobile="primary" data-mobile-slot="name" data-mobile-label="Họ & Tên">Họ &amp; Tên</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2 d-none d-md-table-cell"
                                data-mobile="detail" data-mobile-label="Bộ Phận / Line">Bộ Phận / Line</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                data-mobile="primary" data-mobile-slot="badge" data-mobile-label="Loại">Loại</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                data-mobile="primary" data-mobile-slot="badge" data-mobile-label="Ngày">Ngày</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2 d-none d-md-table-cell"
                                data-mobile="detail" data-mobile-label="Giờ Ra">Giờ Ra</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2 d-none d-md-table-cell"
                                data-mobile="detail" data-mobile-label="Giờ Vào">Giờ Vào</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2 d-none d-md-table-cell"
                                data-mobile="detail" data-mobile-label="Lý Do">Lý Do</th>
                            <th class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-9"
                                data-mobile="primary" data-mobile-slot="badge" data-mobile-label="Tình Trạng">Tình Trạng</th>
                            <th class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-9"
                                data-mobile="primary" data-mobile-slot="badge" data-mobile-label="Thao Tác">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody id="gpTableBody"></tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center px-4 mt-3 mb-2">
                <div id="paginationCount" class="text-sm text-secondary"></div>
                <nav><ul class="pagination pagination-sm mb-0" id="paginationBar"></ul></nav>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="actionModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header" id="actionModalHeader">
                <h6 class="modal-title mb-0" id="actionModalTitle"></h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="actionRequestId" />
                <input type="hidden" id="actionType" />
                <div class="mb-2">
                    <label class="form-label small fw-bold">Ghi Chú (không bắt buộc)</label>
                    <textarea id="actionComment" class="form-control form-control-sm" rows="2" maxlength="500"></textarea>
                </div>
                <div id="actionError" class="alert alert-danger d-none py-1 px-2 text-sm"></div>
            </div>
            <div class="modal-footer py-2">
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Huỷ</button>
                <button class="btn btn-sm text-white" id="confirmActionBtn" onclick="submitAction()">Xác Nhận</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
const PAGE_URL    = '@Url.Action("GetSupervisorPage",  "GatePass")';
const APPROVE_URL = '@Url.Action("ApproveRequest",     "GatePass")';
const REJECT_URL  = '@Url.Action("RejectRequest",      "GatePass")';

let currentPage = 1, totalPages = 1, totalRecords = 0, pageSize = 50;

const GP_TYPE_LABEL = { LATE_IN: 'Đến trễ', EARLY_OUT: 'Về sớm', OUT_IN: 'Ra/Vào trong giờ' };

function buildRow(item, idx) {
    const dateStr = formatDate(item.OUT_TIME || item.IN_TIME);
    const outStr  = item.OUT_TIME ? formatTime(item.OUT_TIME) : '-';
    const inStr   = item.IN_TIME  ? formatTime(item.IN_TIME)  : '-';
    const gpLabel = GP_TYPE_LABEL[item.GP_TYPE] || item.GP_TYPE || '-';

    let statusHtml = `<span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Chờ duyệt</span>`;
    if (item.STATUS === 'APPROVED') statusHtml = `<span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Đã duyệt</span>`;
    if (item.STATUS === 'REJECTED') statusHtml = `<span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Từ chối</span>`;

    const actions = item.STATUS === 'PENDING'
        ? `<button class="btn btn-xs btn-success me-1" onclick="openAction('${item.REQUEST_ID}','approve')"><i class="bi bi-check-lg"></i></button>
           <button class="btn btn-xs btn-danger"  onclick="openAction('${item.REQUEST_ID}','reject')"><i class="bi bi-x-lg"></i></button>`
        : '<span class="text-muted text-xs">-</span>';

    return `<tr>
        <td class="px-2 text-xs text-secondary">${idx}</td>
        <td class="px-2 text-sm">${escHtml(item.EMPCD||'')}</td>
        <td class="px-2 text-sm emp-name vni-font" style="text-transform:uppercase;">${escHtml(item.EMP_NAME||'')}</td>
        <td class="px-2 text-sm d-none d-md-table-cell">${escHtml(item.DEPT_NAME||'')} / ${escHtml(item.LINE_NAME||'')}</td>
        <td class="px-2 text-sm"><span class="badge bg-info">${gpLabel}</span></td>
        <td class="px-2 text-sm">${dateStr}</td>
        <td class="px-2 text-sm d-none d-md-table-cell">${outStr}</td>
        <td class="px-2 text-sm d-none d-md-table-cell">${inStr}</td>
        <td class="px-2 text-sm d-none d-md-table-cell" style="max-width:140px;white-space:normal;">${escHtml(item.REASON||'-')}</td>
        <td class="text-center">${statusHtml}</td>
        <td class="text-center">${actions}</td>
    </tr>`;
}

function getParams(page) {
    return {
        status:    $('#filterStatus').val(),
        search:    $('#searchInput').val(),
        dept_id:   $('#filterDept').val(),
        line_id:   $('#filterLine').val(),
        work_id:   $('#filterWork').val(),
        date_from: $('#dateFrom').val(),
        date_to:   $('#dateTo').val(),
        page,
        page_size: pageSize
    };
}

function loadData(page = 1) {
    currentPage = page;
    $('#gpTableBody').html(`<tr><td colspan="11" class="text-center py-5"><div class="spinner-border text-primary" role="status"></div><div class="mt-2 text-sm text-secondary">Đang tải...</div></td></tr>`);
    MobileTableHelper.refresh('gpTableBody');
    $.ajax({
        url: PAGE_URL, type: 'GET', data: getParams(page),
        success: function(res) {
            if (!res.success) {
                $('#gpTableBody').html(`<tr><td colspan="11" class="text-center text-danger py-4">Lỗi: ${res.message||''}</td></tr>`);
                MobileTableHelper.refresh('gpTableBody');
                return;
            }
            const s = res.summary || {};
            $('#summaryTotal').text((s.TOTAL||0).toLocaleString());
            $('#summaryPending').text((s.PENDING||0).toLocaleString());
            $('#summaryApproved').text((s.APPROVED||0).toLocaleString());
            $('#summaryRejected').text((s.REJECTED||0).toLocaleString());
            totalRecords = res.total || 0;
            totalPages   = res.total_pages || 0;
            const data   = res.data || [];
            if (!data.length) {
                $('#gpTableBody').html(`<tr><td colspan="11" class="text-center text-muted py-4">Không có dữ liệu</td></tr>`);
            } else {
                $('#gpTableBody').html(data.map((item,i) => buildRow(item,(page-1)*pageSize+i+1)).join(''));
            }
            renderPagination();
            MobileTableHelper.refresh('gpTableBody');
        },
        error: function(xhr) {
            $('#gpTableBody').html(`<tr><td colspan="11" class="text-center text-danger py-4">Lỗi kết nối (${xhr.status})</td></tr>`);
            MobileTableHelper.refresh('gpTableBody');
        }
    });
}

function renderPagination() {
    if (!totalRecords) { $('#paginationCount').text(''); $('#paginationBar').empty(); return; }
    const s=(currentPage-1)*pageSize+1, e=Math.min(currentPage*pageSize,totalRecords);
    $('#paginationCount').html(`<span class="text-xs">${s}-${e} / <strong>${totalRecords}</strong> phiếu</span>`);
    const $bar=$('#paginationBar').empty();
    const mk=(label,p,disabled,active)=>{const li=$('<li class="page-item">').toggleClass('disabled',!!disabled).toggleClass('active',!!active);$('<a class="page-link">').html(label).on('click',()=>{if(!disabled&&!active)loadData(p);}).appendTo(li);return li;};
    $bar.append(mk('&lsaquo;',currentPage-1,currentPage<=1));
    let from=Math.max(1,currentPage-2),to=Math.min(totalPages,currentPage+2);
    for(let p=from;p<=to;p++) $bar.append(mk(p,p,false,p===currentPage));
    $bar.append(mk('&rsaquo;',currentPage+1,currentPage>=totalPages));
}

function openAction(id, type) {
    $('#actionRequestId').val(id); $('#actionType').val(type); $('#actionComment').val(''); $('#actionError').addClass('d-none').text('');
    const isApprove = type === 'approve';
    $('#actionModalHeader').removeClass('bg-success bg-danger').addClass(isApprove ? 'bg-success text-white' : 'bg-danger text-white');
    $('#actionModalTitle').text(isApprove ? 'Duyệt Phiếu Ra Vào' : 'Từ Chối Phiếu Ra Vào');
    $('#confirmActionBtn').removeClass('btn-success btn-danger').addClass(isApprove ? 'btn-success' : 'btn-danger');
    new bootstrap.Modal('#actionModal').show();
}

async function submitAction() {
    const id      = $('#actionRequestId').val();
    const type    = $('#actionType').val();
    const comment = $('#actionComment').val();
    const url     = type === 'approve' ? APPROVE_URL : REJECT_URL;
    const $btn    = $('#confirmActionBtn').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>...');
    try {
        const res = await $.ajax({ url, type: 'POST', data: { request_id: id, comment } });
        if (res.success) {
            bootstrap.Modal.getInstance('#actionModal').hide();
            showToast(type === 'approve' ? 'Đã duyệt phiếu thành công' : 'Đã từ chối phiếu', type === 'approve' ? 'success' : 'warning');
            loadData(currentPage);
        } else {
            $('#actionError').removeClass('d-none').text(res.message || 'Lỗi xử lý');
        }
    } catch { $('#actionError').removeClass('d-none').text('Lỗi kết nối'); }
    finally  { $btn.prop('disabled', false).text('Xác Nhận'); }
}

$('#filterStatus, #filterGpType, #filterDept, #filterLine, #filterWork').on('change', () => loadData(1));
$('#searchInput').on('input', debounce(() => loadData(1), 400));
$('#pageSizeSelect').on('change', function() { pageSize = parseInt($(this).val()); loadData(1); });

function formatTime(s){ const d=new Date(s); if(isNaN(d)) return''; return('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2); }
function formatDate(s){ if(!s) return '-'; const d=new Date(s); if(isNaN(d)) return ''; return('0'+d.getDate()).slice(-2)+'/'+('0'+(d.getMonth()+1)).slice(-2)+'/'+d.getFullYear(); }
function escHtml(str){ return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function debounce(fn,d){ let t; return function(){ clearTimeout(t); t=setTimeout(fn,d); }; }

$(document).ready(function() {
    MobileTableHelper.init('gpTableBody');
    if (typeof Select2Helper !== 'undefined') Select2Helper.init();
    loadData(1);
});
</script>
}
