@{
    ViewData["Title"] = "Đăng Ký Ra Vào Cổng";
    var today     = DateTime.Today.ToString("yyyy-MM-dd");
    var yesterday = DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd");
    var tomorrow  = DateTime.Today.AddDays(1).ToString("yyyy-MM-dd");
}

@section Styles {
<style>
    #formCard { max-width: 560px; margin: 0 auto; }

    .gp-label { font-size: 1rem; font-weight: 700; color: #374151; margin-bottom: 6px; }
    .gp-input { font-size: 1.05rem; padding: 0.65rem 0.85rem; border-radius: 10px; border: 1.5px solid #d1d5db; }
    .gp-input:focus { border-color: #f59e0b; box-shadow: 0 0 0 3px rgba(245,158,11,0.15); }
    .gp-select { font-size: 1.05rem; padding: 0.65rem 0.85rem; border-radius: 10px; border: 1.5px solid #d1d5db; }
    .gp-select:focus { border-color: #f59e0b; box-shadow: 0 0 0 3px rgba(245,158,11,0.15); }
    .gp-textarea { font-size: 1rem; padding: 0.65rem 0.85rem; border-radius: 10px; border: 1.5px solid #d1d5db; }
    .gp-textarea:focus { border-color: #f59e0b; box-shadow: 0 0 0 3px rgba(245,158,11,0.15); }

    .date-radio-card { border: 2px solid #e5e7eb; border-radius: 12px; padding: 12px 16px; cursor: pointer; transition: all .2s; display: flex; align-items: center; gap: 10px; }
    .date-radio-card:hover { border-color: #f59e0b; background: #fffbeb; }
    .date-radio-card.selected { border-color: #f59e0b; background: #fffbeb; }
    .date-radio-card .date-label { font-size: 1rem; font-weight: 600; color: #374151; }
    .date-radio-card .date-sub { font-size: 0.85rem; color: #6b7280; }
    .date-radio-card input[type=radio] { width: 18px; height: 18px; accent-color: #f59e0b; flex-shrink: 0; }

    .auto-time { background: #f0f4ff !important; color: #3a5fcf; font-weight: 600; border-color: #93c5fd !important; }
    .time-field { transition: all .25s; }
    .time-hint { font-size: 0.82rem; color: #6b7280; margin-top: 4px; }
    .time-picker { display: flex; align-items: center; gap: 8px; }
    .time-picker select { width: 90px; font-size: 1.3rem; font-weight: 700; text-align: center; padding: 0.55rem 0.4rem; border-radius: 10px; border: 1.5px solid #d1d5db; cursor: pointer; }
    .time-picker select.hour-select { width: 158px; font-size: 1.05rem; text-align: left; padding-left: 0.6rem; }
    .time-picker select:focus { border-color: #f59e0b; box-shadow: 0 0 0 3px rgba(245,158,11,0.15); outline: none; }
    .time-picker select.auto-time { background: #f0f4ff; color: #3a5fcf; border-color: #93c5fd; }
    .time-colon { font-size: 1.8rem; font-weight: 900; color: #374151; line-height: 1; }
    .time-label-hint { font-size: 0.78rem; color: #9ca3af; margin-top: 2px; text-align: center; }

    .gp-type-option { border: 2px solid #e5e7eb; border-radius: 12px; padding: 14px 16px; cursor: pointer; margin-bottom: 10px; transition: all .2s; display: flex; align-items: center; gap: 12px; }
    .gp-type-option:hover { border-color: #f59e0b; background: #fffbeb; }
    .gp-type-option.selected { border-color: #f59e0b; background: #fffbeb; }
    .gp-type-option input[type=radio] { width: 18px; height: 18px; accent-color: #f59e0b; flex-shrink: 0; }
    .gp-type-option .type-icon { font-size: 1.4rem; width: 36px; text-align: center; }
    .gp-type-option .type-title { font-size: 1rem; font-weight: 700; color: #1f2937; }
    .gp-type-option .type-desc { font-size: 0.82rem; color: #6b7280; }

    .btn-submit { font-size: 1.1rem; padding: 0.75rem; border-radius: 12px; font-weight: 700; }
    .btn-back   { font-size: 1rem;   padding: 0.65rem; border-radius: 12px; }
</style>
}

<div class="container-fluid py-3">
    <div id="formCard">

        <div class="card">
            <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                <div class="bg-gradient-warning shadow-warning border-radius-lg pt-3 pb-2 px-3">
                    <h6 class="text-white mb-0"><i class="bi bi-door-open me-1"></i> Đăng Ký Ra Vào Cổng</h6>
                </div>
            </div>
            <div class="card-body pt-4 pb-4 px-3">
                <form method="post" action="@Url.Action("GpRequestForm", "GatePass")" id="gpForm">
                    @Html.AntiForgeryToken()

                    <div class="mb-4">
                        <div class="gp-label mb-2">
                            Ngày Đăng Ký
                            <span id="shiftLoadingBadge" class="badge bg-secondary text-white ms-1" style="font-size:.72rem;display:none;"><span class="spinner-border spinner-border-sm me-1" style="width:.65rem;height:.65rem;"></span>Đang xác định ca...</span>
                            <span id="shiftInfoBadge" class="badge bg-info text-white ms-1" style="font-size:.72rem;display:none;"></span>
                        </div>
                        <div class="d-flex gap-2">
                            <label class="date-radio-card selected flex-fill" id="cardDate1">
                                <input class="form-check-input" type="radio" name="reg_date" id="rdDate1" value="@today" checked onchange="onDateCardChange(this.value)" />
                                <div>
                                    <div class="date-label" id="labelDate1">Hôm nay</div>
                                    <div class="date-sub"   id="subDate1">@DateTime.Today.ToString("dd/MM/yyyy")</div>
                                </div>
                            </label>
                            <label class="date-radio-card flex-fill" id="cardDate2">
                                <input class="form-check-input" type="radio" name="reg_date" id="rdDate2" value="@tomorrow" onchange="onDateCardChange(this.value)" />
                                <div>
                                    <div class="date-label" id="labelDate2">Ngày mai</div>
                                    <div class="date-sub"   id="subDate2">@DateTime.Today.AddDays(1).ToString("dd/MM/yyyy")</div>
                                </div>
                            </label>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="gp-label mb-2">Loại Gate Pass <span class="text-danger">*</span></div>

                        <label class="gp-type-option" id="opt_IN" onclick="selectType('IN')">
                            <input type="radio" name="gp_type" value="IN" id="rd_IN" />
                            <span class="type-icon">🕐</span>
                            <div>
                                <div class="type-title">Đến trễ</div>
                                <div class="type-desc">Nhân viên đến muộn hơn giờ ca</div>
                            </div>
                        </label>

                        <label class="gp-type-option" id="opt_OUT" onclick="selectType('OUT')">
                            <input type="radio" name="gp_type" value="OUT" id="rd_OUT" />
                            <span class="type-icon">🚪</span>
                            <div>
                                <div class="type-title">Về sớm</div>
                                <div class="type-desc">Nhân viên ra về trước giờ tan ca</div>
                            </div>
                        </label>

                        <label class="gp-type-option" id="opt_MID" onclick="selectType('MID')">
                            <input type="radio" name="gp_type" value="MID" id="rd_MID" />
                            <span class="type-icon">🔄</span>
                            <div>
                                <div class="type-title">Ra/Vào trong giờ làm</div>
                                <div class="type-desc">Ra ngoài rồi vào lại trong ca</div>
                            </div>
                        </label>
                    </div>

                    <div class="time-field mb-4" id="outTimeWrap" style="display:none;">
                        <label class="gp-label" id="outTimeLabel">Giờ Ra</label>
                        <div class="time-picker">
                            <div>
                                <select id="outHour" class="hour-select" onchange="onHourChange('out')"></select>
                                <div class="time-label-hint">Giờ</div>
                            </div>
                            <span class="time-colon">:</span>
                            <div>
                                <select id="outMin" onchange="syncTime('out')"></select>
                                <div class="time-label-hint">Phút</div>
                            </div>
                        </div>
                        <input type="hidden" name="out_time" id="outTime" />
                        <div class="time-hint" id="outTimeHint"></div>
                    </div>

                    <div class="time-field mb-4" id="inTimeWrap" style="display:none;">
                        <label class="gp-label" id="inTimeLabel">Giờ Vào</label>
                        <div class="time-picker">
                            <div>
                                <select id="inHour" class="hour-select" onchange="onHourChange('in')"></select>
                                <div class="time-label-hint">Giờ</div>
                            </div>
                            <span class="time-colon">:</span>
                            <div>
                                <select id="inMin" onchange="syncTime('in')"></select>
                                <div class="time-label-hint">Phút</div>
                            </div>
                        </div>
                        <input type="hidden" name="in_time" id="inTime" />
                        <div class="time-hint" id="inTimeHint"></div>
                    </div>

                    <div class="mb-4">
                        <label class="gp-label">Lý Do</label>
                        <textarea name="reason" id="reason" class="form-control gp-textarea" rows="3" maxlength="500" placeholder="Nhập lý do... (bắt buộc)"></textarea>
                    </div>

                    @{
                        string? myEmpCd = ViewBag.CurrentEmpCd as string;
                    }
                    <div class="mb-4">
                        <label class="gp-label">Chữ Ký Xác Nhận</label>
                        <div style="background:#fff;border:1px dashed #d1d5db;border-radius:12px;padding:.5rem;text-align:center;min-height:120px;display:flex;align-items:center;justify-content:center;">
                            <img src="@Url.Action("GetSignature", "Image", new { empCd = myEmpCd })"
                                 alt="Chữ ký @myEmpCd"
                                 style="max-height:110px;max-width:100%;object-fit:contain;" />
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-3">
                        <button type="submit" class="btn btn-primary btn-submit" id="submitBtn">
                            <i class="bi bi-send me-1"></i> Gửi Đăng Ký
                        </button>
                        <a href="@Url.Action("GpMyRequests", "GatePass")" class="btn btn-outline-secondary btn-back">
                            <i class="bi bi-list-ul me-1"></i> Xem Lịch Sử
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
const SHIFT_URL = '@Url.Action("GetShiftInfo", "GatePass")';
let shiftStart = '', shiftEnd = '', shiftCd = '', currentDate = '@today', currentType = '';

function isNightShift() {
    if (!shiftStart || !shiftEnd) return false;
    return shiftEnd < shiftStart; // ví dụ 06:00 < 22:00
}

function updateShiftBadge() {
    const el = document.getElementById('shiftInfoBadge');
    if (!el) return;
    if (shiftStart && shiftEnd) {
        const night = isNightShift();
        el.innerHTML = `<i class="bi bi-clock me-1"></i>${shiftCd ? shiftCd + ': ' : ''}${shiftStart} – ${shiftEnd}${night ? ' <span class="text-warning">(ca đêm)</span>' : ''}`;
        el.style.display = 'inline-block';
    } else {
        el.style.display = 'none';
    }
}

// Khoảng giờ hợp lệ theo ca hiện tại (null nếu chưa xác định được ca)
function getShiftRange() {
    if (!shiftStart || !shiftEnd) return null;
    const [sh, sm] = shiftStart.split(':').map(Number);
    const [eh, em] = shiftEnd.split(':').map(Number);
    return { sh, sm, eh, em, wrap: isNightShift() };
}

function hourInRange(h, range) {
    if (!range) return true;
    return range.wrap ? (h >= range.sh || h <= range.eh) : (h >= range.sh && h <= range.eh);
}

function rangeLabel(range) {
    if (!range) return '';
    const s = String(range.sh).padStart(2, '0') + ':' + String(range.sm).padStart(2, '0');
    const e = String(range.eh).padStart(2, '0') + ':' + String(range.em).padStart(2, '0');
    return `Chỉ chọn trong ca: ${s} – ${e}${range.wrap ? ' (qua đêm)' : ''}`;
}

function showRangeHint(prefix, range) {
    $('#' + prefix + 'TimeHint').text(rangeLabel(range));
}

// Icon + chữ + màu theo buổi trong ngày — giúp công nhân nhìn phát hiểu ngay, đỡ lúng túng
function hourBand(h) {
    if (h <= 4)  return { icon: '🌙', label: 'Đêm',   color: '#4c1d95' }; // 00-04
    if (h <= 10) return { icon: '🌅', label: 'Sáng',  color: '#c2410c' }; // 05-10
    if (h <= 12) return { icon: '☀️', label: 'Trưa',  color: '#b45309' }; // 11-12
    if (h <= 17) return { icon: '🌤️', label: 'Chiều', color: '#0369a1' }; // 13-17
    return             { icon: '🌆', label: 'Tối',   color: '#1e293b' }; // 18-23
}

function makeHourOption(h) {
    const band = hourBand(h);
    const o = document.createElement('option');
    o.value = String(h).padStart(2, '0');
    o.text  = `${band.icon} ${String(h).padStart(2, '0')}h ${band.label}`;
    o.style.color = band.color;
    return o;
}

// Lọc dropdown giờ chỉ còn các giờ nằm trong ca — tránh công nhân chọn giờ ngoài ca
function populateHourOptions(prefix, range) {
    const sel = document.getElementById(prefix + 'Hour');
    const prevVal = sel.value;
    sel.innerHTML = '';
    for (let h = 0; h < 24; h++) {
        if (!hourInRange(h, range)) continue;
        sel.appendChild(makeHourOption(h));
    }
    if (!sel.options.length) { // an toàn: ca lỗi dữ liệu thì không khoá chết dropdown
        for (let h = 0; h < 24; h++) sel.appendChild(makeHourOption(h));
    }
    sel.value = [...sel.options].some(o => o.value === prevVal) ? prevVal : sel.options[0].value;
}

// Lọc dropdown phút theo giờ biên đầu/cuối ca (giờ giữa ca thì đủ 12 mốc như cũ)
function populateMinuteOptions(prefix, range) {
    const hourSel = document.getElementById(prefix + 'Hour');
    const minSel  = document.getElementById(prefix + 'Min');
    const h = parseInt(hourSel.value, 10);
    const prevVal = minSel.value;
    let minM = 0, maxM = 55;
    if (range) {
        if (h === range.sh) minM = Math.ceil(range.sm / 5) * 5;
        if (h === range.eh) maxM = Math.floor(range.em / 5) * 5;
    }
    minSel.innerHTML = '';
    for (let m = 0; m < 60; m += 5) {
        if (m < minM || m > maxM) continue;
        const o = document.createElement('option');
        o.value = String(m).padStart(2, '0');
        o.text  = String(m).padStart(2, '0');
        minSel.appendChild(o);
    }
    if (!minSel.options.length) {
        for (let m = 0; m < 60; m += 5) {
            const o = document.createElement('option');
            o.value = String(m).padStart(2, '0');
            o.text  = String(m).padStart(2, '0');
            minSel.appendChild(o);
        }
    }
    minSel.value = [...minSel.options].some(o => o.value === prevVal) ? prevVal : minSel.options[0].value;
}

function onHourChange(prefix) {
    populateMinuteOptions(prefix, getShiftRange());
    syncTime(prefix);
}

function fmtDate(isoStr) {
    if (!isoStr) return '';
    const [y, m, d] = isoStr.split('-');
    return `${d}/${m}/${y}`;
}

function setDateCards(date1Val, date1Label, date2Val, date2Label) {
    document.getElementById('rdDate1').value = date1Val;
    document.getElementById('labelDate1').textContent = date1Label;
    document.getElementById('subDate1').textContent = fmtDate(date1Val);
    document.getElementById('cardDate1').onclick = () => selectDate(document.getElementById('cardDate1'), date1Val);

    document.getElementById('rdDate2').value = date2Val;
    document.getElementById('labelDate2').textContent = date2Label;
    document.getElementById('subDate2').textContent = fmtDate(date2Val);
    document.getElementById('cardDate2').onclick = () => selectDate(document.getElementById('cardDate2'), date2Val);
}

function selectDateCard(val) {
    if (document.getElementById('rdDate1').value === val) {
        document.getElementById('rdDate1').checked = true;
        document.getElementById('cardDate1').classList.add('selected');
        document.getElementById('cardDate2').classList.remove('selected');
    } else {
        document.getElementById('rdDate2').checked = true;
        document.getElementById('cardDate2').classList.add('selected');
        document.getElementById('cardDate1').classList.remove('selected');
    }
    currentDate = val;
}

// Khởi tạo dropdown giờ (00-23) và phút (00-59)
function initTimePickers() {
    ['outHour', 'inHour'].forEach(id => {
        const sel = document.getElementById(id);
        for (let h = 0; h < 24; h++) sel.appendChild(makeHourOption(h));
    });
    ['outMin', 'inMin'].forEach(id => {
        const sel = document.getElementById(id);
        for (let m = 0; m < 60; m += 5) {
            const o = document.createElement('option');
            o.value = String(m).padStart(2, '0');
            o.text  = String(m).padStart(2, '0');
            sel.appendChild(o);
        }
    });
}

function syncTime(prefix) {
    const h = document.getElementById(prefix + 'Hour').value;
    const m = document.getElementById(prefix + 'Min').value;
    document.getElementById(prefix + 'Time').value = h + ':' + m;
}

function setTimePicker(prefix, hhmm, locked) {
    const parts = (hhmm || '').split(':');
    const h = parts[0] || '00', m = parts[1] || '00';
    const selH = document.getElementById(prefix + 'Hour');
    const selM = document.getElementById(prefix + 'Min');
    selH.value = h; selM.value = m;
    selH.disabled = !!locked; selM.disabled = !!locked;
    selH.classList.toggle('auto-time', !!locked);
    selM.classList.toggle('auto-time', !!locked);
    syncTime(prefix);
}

function resetTimePicker(prefix) {
    const selH = document.getElementById(prefix + 'Hour');
    const selM = document.getElementById(prefix + 'Min');
    selH.value = '00'; selM.value = '00';
    selH.disabled = false; selM.disabled = false;
    selH.classList.remove('auto-time'); selM.classList.remove('auto-time');
    document.getElementById(prefix + 'Time').value = '';
}

function onDateCardChange(date) {
    selectDate(date === document.getElementById('rdDate1').value
        ? document.getElementById('cardDate1')
        : document.getElementById('cardDate2'), date);
}

function selectDate(el, date) {
    document.querySelectorAll('.date-radio-card').forEach(c => c.classList.remove('selected'));
    el.classList.add('selected');
    currentDate = date;
    fetchShift(date);
}

function selectType(type) {
    document.querySelectorAll('.gp-type-option').forEach(c => c.classList.remove('selected'));
    document.getElementById('opt_' + type).classList.add('selected');
    document.getElementById('rd_' + type).checked = true;
    currentType = type;
    onTypeChange(type);
}

async function fetchShift(date) {
    const isAutoDetect = !date;
    if (isAutoDetect) $('#shiftLoadingBadge').show();
    try {
        const params = isAutoDetect ? {} : { reg_date: date };
        const res = await $.getJSON(SHIFT_URL, params);
        if (res.success && res.data) {
            shiftStart = formatShift(res.data.STIME);
            shiftEnd   = formatShift(res.data.ETIME);
            shiftCd    = res.data.SHIFTCD || '';
            updateShiftBadge();

            if (isAutoDetect && res.data.WORK_DATE) {
                const wd  = res.data.WORK_DATE;
                const wd2 = res.data.WORK_DATE_TOMORROW || '';
                const today = '@today';

                // Xác định nhãn tùy ngày ca
                const label1 = wd < today ? 'Hôm qua (ca đêm)' : 'Hôm nay';
                const label2 = wd2 === today ? 'Hôm nay' : 'Ngày mai';

                setDateCards(wd, label1, wd2, label2);
                selectDateCard(wd);
            }
        } else {
            shiftStart = shiftEnd = shiftCd = '';
            updateShiftBadge();
        }
    } catch { shiftStart = shiftEnd = ''; }
    if (isAutoDetect) $('#shiftLoadingBadge').hide();
    if (currentType) onTypeChange(currentType);
}

function formatShift(t) {
    if (!t || t.length < 4) return '';
    return t.substring(0, 2) + ':' + t.substring(2, 4);
}

function onTypeChange(type) {
    $('#outTimeWrap').hide(); $('#inTimeWrap').hide();
    resetTimePicker('out'); resetTimePicker('in');
    $('#outTimeHint').text(''); $('#inTimeHint').text('');

    const range = getShiftRange();

    if (type === 'IN') {
        $('#inTimeWrap').show();
        $('#inTimeLabel').text('Giờ Đến Thực Tế ✱');
        populateHourOptions('in', range);
        showRangeHint('in', range);

        const now = new Date();
        let nowH = now.getHours();
        let nowM = Math.floor(now.getMinutes() / 5) * 5;
        if (range && !hourInRange(nowH, range)) { // chưa tới ca -> mặc định về đầu ca
            nowH = range.sh; nowM = Math.ceil(range.sm / 5) * 5;
        }
        // Set giờ trước rồi mới build lại dropdown phút theo đúng giờ đó (tránh lệch biên ca)
        document.getElementById('inHour').value = String(nowH).padStart(2, '0');
        populateMinuteOptions('in', range);
        setTimePicker('in', String(nowH).padStart(2,'0') + ':' + String(nowM).padStart(2,'0'), false);

    } else if (type === 'OUT') {
        $('#outTimeWrap').show();
        $('#outTimeLabel').text('Giờ Về Sớm ✱');
        populateHourOptions('out', range);
        populateMinuteOptions('out', range);
        showRangeHint('out', range);

    } else if (type === 'MID') {
        $('#outTimeWrap').show(); $('#inTimeWrap').show();
        $('#outTimeLabel').text('Giờ Ra Ngoài ✱');
        $('#inTimeLabel').text('Giờ Vào Lại ✱');
        populateHourOptions('out', range); populateMinuteOptions('out', range);
        populateHourOptions('in', range);  populateMinuteOptions('in', range);
        showRangeHint('out', range); showRangeHint('in', range);
    }
}

$('#gpForm').on('submit', function(e) {
    const type = $('input[name="gp_type"]:checked').val();
    if (!type) { e.preventDefault(); showToast('Vui lòng chọn loại phiếu ra vào', 'warning'); return; }
    if (type === 'IN'  && !$('#inTime').val())  { e.preventDefault(); showToast('Vui lòng nhập giờ đến thực tế', 'warning'); return; }
    if (type === 'OUT' && !$('#outTime').val()) { e.preventDefault(); showToast('Vui lòng nhập giờ về sớm', 'warning'); return; }
    if (type === 'MID') {
        if (!$('#outTime').val() || !$('#inTime').val()) {
            e.preventDefault(); showToast('Vui lòng nhập đầy đủ giờ ra và giờ vào', 'warning'); return;
        }
        const outVal = $('#outTime').val(), inVal = $('#inTime').val();
        // Ca đêm (ETIME < STIME): cho phép giờ ra > giờ vào nếu qua nửa đêm
        const midnightCross = isNightShift() && outVal > inVal;
        if (!midnightCross && outVal >= inVal) {
            e.preventDefault(); showToast('Giờ ra ngoài phải nhỏ hơn giờ vào lại', 'warning'); return;
        }
    }
    if (!$('#reason').val().trim()) { e.preventDefault(); showToast('Vui lòng nhập lý do', 'warning'); return; }
    $('#submitBtn').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Đang gửi...');
});

$(document).ready(function() {
    initTimePickers();
    fetchShift(); // auto-detect ca đêm
});
</script>
}
