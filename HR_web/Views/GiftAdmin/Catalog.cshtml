@{
    ViewData["Title"] = "Danh mục Quà";
}

@section Styles {
<style>
    .gc-combo-row { display: flex; gap: 6px; margin-bottom: 6px; }
    .gc-combo-row input { flex: 1; }
    .gc-item-thumb { width: 32px; height: 32px; border-radius: 6px; object-fit: cover; }
    .gc-cat-row { display: flex; justify-content: space-between; align-items: center; padding: 8px 10px; border-radius: 8px; cursor: pointer; margin-bottom: 2px; gap: 6px; }
    .gc-cat-row:hover { background: #fdf2f8; }
    .gc-cat-row.active { background: #fce7f3; }
    .gc-cat-row.active .gc-cat-name { color: #831843; font-weight: 700; }
    .gc-cat-count { font-size: .72rem; padding: 2px 8px; border-radius: 999px; background: #f1f5f9; color: #64748b; font-weight: 600; }
    .gc-cat-row.active .gc-cat-count { background: #db2777; color: #fff; }
    .gc-cat-name { flex: 1; min-width: 0; overflow-wrap: break-word; }
    .gc-cat-actions { display: flex; gap: 2px; flex-shrink: 0; }
    .gc-cat-actions .btn { padding: 1px 6px; font-size: .75rem; }
    @@media (max-width: 767px) {
        .container-fluid { padding-left: 8px !important; padding-right: 8px !important; }
    }
</style>
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-lg-4 mb-4">
            <div class="card">
                <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                    <div class="bg-gradient-danger shadow-danger border-radius-lg pt-3 pb-2 px-3">
                        <h6 class="text-white mb-0"><i class="bi bi-tags-fill me-1"></i> Phân loại quà</h6>
                    </div>
                </div>
                <div class="card-body">
                    <p class="text-xxs text-secondary mb-2"><i class="bi bi-info-circle"></i> Bấm vào 1 phân loại để lọc danh sách quà bên phải.</p>
                    <div class="d-flex flex-wrap align-items-end gap-2 mb-2 filter-bar">
                        <div style="flex:1 1 auto;">
                            <input type="text" id="catSearch" class="form-control form-control-sm" placeholder="🔍 Tìm phân loại..." />
                        </div>
                        <div class="ms-auto"></div>
                    </div>
                    <div id="catList" class="mb-2"></div>
                    <nav class="mb-3"><ul class="pagination pagination-sm justify-content-center mb-0" id="catPaginationBar"></ul></nav>
                    <div class="input-group input-group-sm">
                        <input type="text" id="newCatName" class="form-control" placeholder="Tên phân loại mới..." />
                        <button class="btn btn-sm btn-outline-danger" onclick="addCategory()"><i class="bi bi-plus-lg"></i></button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card">
                <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                    <div class="bg-gradient-danger shadow-danger border-radius-lg pt-3 pb-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <h6 class="text-white mb-0"><i class="bi bi-gift-fill me-1"></i> Danh mục quà <span id="itemCountBadge" class="badge bg-light text-dark ms-1"></span></h6>
                        <button type="button" class="btn btn-sm mb-0" style="background:#fff;color:#831843;font-weight:600;" onclick="openItemModal()">
                            <i class="bi bi-plus-lg me-1"></i> Thêm quà
                        </button>
                    </div>
                </div>

                <div class="px-3 pt-3 pb-2 d-flex flex-wrap align-items-end gap-2 filter-bar" style="background:#f8fafc;border-bottom:1px solid #e9ecef;">
                    <div style="min-width:200px;flex:2 1 200px;">
                        <label class="form-label small fw-bold mb-1 text-primary">Tìm theo tên quà</label>
                        <input type="text" id="itemSearch" class="form-control form-control-sm" placeholder="🔍 Nhập tên quà..." />
                    </div>
                    <div style="min-width:160px;flex:1 1 160px;max-width:220px;">
                        <label class="form-label small fw-bold mb-1 text-primary">Hình thức</label>
                        <select id="typeFilter" class="form-select form-select-sm">
                            <option value="">Tất cả</option>
                            <option value="SINGLE">Đơn lẻ</option>
                            <option value="COMBO">Combo</option>
                        </select>
                    </div>
                    <div class="ms-auto"></div>
                </div>

                <div id="activeCatChip" class="px-3 pt-2" style="display:none;">
                    <span class="badge bg-danger-subtle text-danger-emphasis" style="font-size:.78rem;">
                        Đang lọc: <strong id="activeCatName"></strong>
                        <i class="bi bi-x-circle ms-1" style="cursor:pointer;" onclick="setActiveCategory(null)"></i>
                    </span>
                </div>

                <div class="card-body px-0">
                    <div class="table-responsive px-3">
                        <table class="table table-sm align-items-center mb-0">
                            <thead>
                                <tr>
                                    <th class="text-xs text-secondary" style="width:48px;">Ảnh</th>
                                    <th class="text-xs text-secondary">Tên quà</th>
                                    <th class="text-xs text-secondary">Phân loại</th>
                                    <th class="text-xs text-secondary">Loại</th>
                                    <th class="text-xs text-secondary">Thành phần combo</th>
                                    <th class="text-xs text-secondary text-center">Sửa</th>
                                </tr>
                            </thead>
                            <tbody id="itemTableBody"></tbody>
                        </table>
                    </div>
                    <div class="d-flex justify-content-between align-items-center px-4 mt-3 mb-2">
                        <div id="itemPaginationCount" class="text-sm text-secondary"></div>
                        <nav><ul class="pagination pagination-sm mb-0" id="itemPaginationBar"></ul></nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal sửa phân loại -->
<div class="modal fade" id="catModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title mb-0">Sửa phân loại</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="catId" />
                <div class="mb-2">
                    <label class="form-label small fw-bold">Tên phân loại</label>
                    <input type="text" id="catName" class="form-control form-control-sm" />
                </div>
                <div class="mb-2">
                    <label class="form-label small fw-bold">Thứ tự hiển thị</label>
                    <input type="number" id="catOrder" class="form-control form-control-sm" value="0" />
                </div>
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="catActive" checked>
                    <label class="form-check-label small fw-bold" for="catActive">Đang sử dụng</label>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-success" onclick="saveCategoryEdit()"><i class="bi bi-check-lg me-1"></i>Lưu</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal thêm/sửa quà -->
<div class="modal fade" id="itemModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title mb-0" id="itemModalTitle">Thêm quà</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="itemId" />
                <div id="itemImageArea" class="mb-3 text-center" style="display:none;">
                    <img id="itemImagePreview" src="" style="max-width:120px;max-height:120px;border-radius:10px;object-fit:cover;display:none;" />
                    <div>
                        <label class="btn btn-sm btn-outline-secondary mt-1 mb-0">
                            <i class="bi bi-camera me-1"></i> Chọn/đổi ảnh quà
                            <input type="file" id="itemImageFile" accept="image/*" style="display:none;" onchange="uploadItemImage()" />
                        </label>
                    </div>
                </div>
                <div id="itemImageHint" class="text-xxs text-secondary mb-2" style="display:none;">
                    <i class="bi bi-info-circle"></i> Lưu quà trước, sau đó bấm Sửa để thêm ảnh.
                </div>
                <div class="mb-2">
                    <label class="form-label small fw-bold">Phân loại</label>
                    <select id="itemCategory" class="form-select form-select-sm"></select>
                </div>
                <div class="mb-2">
                    <label class="form-label small fw-bold">Tên quà</label>
                    <input type="text" id="itemName" class="form-control form-control-sm" />
                </div>
                <div class="mb-2">
                    <label class="form-label small fw-bold">Hình thức</label>
                    <select id="itemType" class="form-select form-select-sm" onchange="toggleComboArea()">
                        <option value="SINGLE">Quà đơn lẻ</option>
                        <option value="COMBO">Combo (nhiều thành phần)</option>
                    </select>
                </div>
                <div id="comboArea" style="display:none;">
                    <label class="form-label small fw-bold">Thành phần combo</label>
                    <div id="comboRows"></div>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="addComboRow('')"><i class="bi bi-plus-lg"></i> Thêm thành phần</button>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-success" onclick="saveItem()"><i class="bi bi-check-lg me-1"></i>Lưu</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
const CAT_URL         = '@Url.Action("GetCategories")';
const CAT_SAVE_URL    = '@Url.Action("SaveCategory")';
const CAT_DELETE_URL  = '@Url.Action("DeleteCategory")';
const CATALOG_URL   = '@Url.Action("GetCatalog")';
const ITEM_SAVE_URL = '@Url.Action("SaveCatalogItem")';
const GIFT_IMG_URL    = '@Url.Action("GetGiftImage", "Image")';
const GIFT_IMG_UP_URL = '@Url.Action("UploadGiftImage", "Image")';

let categories = [];
let allItems = [];
let activeCategoryId = null;
let catPage = 1, catPageSize = 8;
let itemPage = 1, itemPageSize = 10;
const CSRF_TOKEN = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

function escHtml(str) { return String(str==null?'':str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

function renderPaginationBar($bar, currentPage, totalPages, onGoto) {
    $bar.empty();
    if (totalPages <= 1) return;
    const mk = (label, p, disabled, active) => {
        const li = $('<li class="page-item">').toggleClass('disabled', !!disabled).toggleClass('active', !!active);
        $('<a class="page-link">').html(label).on('click', () => { if (!disabled && !active) onGoto(p); }).appendTo(li);
        return li;
    };
    $bar.append(mk('&lsaquo;', currentPage-1, currentPage<=1));
    let from = Math.max(1, currentPage-2), to = Math.min(totalPages, currentPage+2);
    for (let p=from; p<=to; p++) $bar.append(mk(p, p, false, p===currentPage));
    $bar.append(mk('&rsaquo;', currentPage+1, currentPage>=totalPages));
}

function renderCategoryList() {
    const search = ($('#catSearch').val() || '').trim().toUpperCase();
    const filtered = search ? categories.filter(c => c.NAME.toUpperCase().includes(search)) : categories;

    const totalPages = Math.max(1, Math.ceil(filtered.length / catPageSize));
    if (catPage > totalPages) catPage = totalPages;
    const start = (catPage-1)*catPageSize;
    const pageCats = filtered.slice(start, start+catPageSize);

    $('#catList').html(pageCats.map(c => {
        const count = allItems.filter(i => i.CATEGORY_ID === c.ID).length;
        const isActive = activeCategoryId === c.ID;
        return `<div class="gc-cat-row ${isActive ? 'active' : ''}" onclick="setActiveCategory(${isActive ? 'null' : c.ID})">
            <span class="gc-cat-name text-sm">${escHtml(c.NAME)}${c.IS_ACTIVE ? '' : ' <span class=\"badge bg-secondary\">Ẩn</span>'}</span>
            <span class="gc-cat-count">${count}</span>
            <span class="gc-cat-actions">
                <button type="button" class="btn btn-outline-secondary" title="Sửa" onclick="event.stopPropagation(); openCatModal(${c.ID})"><i class="bi bi-pencil"></i></button>
                <button type="button" class="btn btn-outline-danger" title="Xóa" onclick="event.stopPropagation(); deleteCategory(${c.ID})"><i class="bi bi-trash"></i></button>
            </span>
        </div>`;
    }).join('') || `<div class="text-secondary text-sm">${search ? 'Không tìm thấy phân loại nào khớp' : 'Chưa có phân loại nào'}</div>`);

    renderPaginationBar($('#catPaginationBar'), catPage, totalPages, p => { catPage = p; renderCategoryList(); });
}

function openCatModal(catId) {
    const cat = categories.find(c => c.ID === catId);
    if (!cat) return;
    $('#catId').val(cat.ID);
    $('#catName').val(cat.NAME);
    $('#catOrder').val(cat.DISPLAY_ORDER || 0);
    $('#catActive').prop('checked', !!cat.IS_ACTIVE);
    new bootstrap.Modal(document.getElementById('catModal')).show();
}

async function saveCategoryEdit() {
    const name = $('#catName').val().trim();
    if (!name) { showToast ? showToast('Vui lòng nhập tên phân loại', 'error') : alert('Vui lòng nhập tên phân loại'); return; }
    const payload = {
        ID: parseInt($('#catId').val()),
        NAME: name,
        DISPLAY_ORDER: parseInt($('#catOrder').val()) || 0,
        IS_ACTIVE: $('#catActive').is(':checked')
    };
    const res = await $.ajax({ url: CAT_SAVE_URL, type: 'POST', contentType: 'application/json', headers: { 'RequestVerificationToken': CSRF_TOKEN }, data: JSON.stringify(payload) });
    if (res.OK) {
        bootstrap.Modal.getInstance(document.getElementById('catModal'))?.hide();
        showToast ? showToast(res.MESSAGE || 'Đã lưu', 'success') : null;
        await loadCategories();
        await loadCatalog();
    } else {
        showToast ? showToast(res.MESSAGE || 'Lỗi', 'error') : alert(res.MESSAGE || 'Lỗi');
    }
}

async function deleteCategory(catId) {
    const cat = categories.find(c => c.ID === catId);
    if (!cat) return;
    if (!confirm(`Xóa phân loại "${cat.NAME}"?`)) return;
    const res = await $.ajax({ url: CAT_DELETE_URL + '?id=' + catId, type: 'POST', headers: { 'RequestVerificationToken': CSRF_TOKEN } });
    if (res.OK) {
        showToast ? showToast(res.MESSAGE || 'Đã xóa', 'success') : null;
        if (activeCategoryId === catId) activeCategoryId = null;
        await loadCategories();
        await loadCatalog();
    } else {
        showToast ? showToast(res.MESSAGE || 'Lỗi', 'error') : alert(res.MESSAGE || 'Lỗi');
    }
}

async function loadCategories() {
    const res = await $.getJSON(CAT_URL);
    categories = (res && res.data) || [];
    const $sel = $('#itemCategory').empty();
    categories.forEach(c => $sel.append(`<option value="${c.ID}">${escHtml(c.NAME)}</option>`));
}

async function addCategory() {
    const name = $('#newCatName').val().trim();
    if (!name) return;
    await $.ajax({ url: CAT_SAVE_URL, type: 'POST', contentType: 'application/json', headers: { 'RequestVerificationToken': CSRF_TOKEN }, data: JSON.stringify({ NAME: name, IS_ACTIVE: true }) });
    $('#newCatName').val('');
    await loadCategories();
    renderCategoryList();
}

function setActiveCategory(catId) {
    activeCategoryId = catId;
    itemPage = 1;
    renderCategoryList();
    renderItemTable();
}

function renderComboBadges(details) {
    if (!details || !details.length) return '-';
    return details.map(d => `<span class="badge bg-light text-dark border me-1 mb-1">${escHtml(d.COMPONENT_NAME)}</span>`).join('');
}

function renderItemTable() {
    const search = ($('#itemSearch').val() || '').trim().toUpperCase();
    const typeFilter = $('#typeFilter').val();

    $('#activeCatChip').toggle(activeCategoryId !== null);
    if (activeCategoryId !== null) {
        const cat = categories.find(c => c.ID === activeCategoryId);
        $('#activeCatName').text(cat ? cat.NAME : '');
    }

    const rows = allItems.filter(item => {
        if (activeCategoryId !== null && item.CATEGORY_ID !== activeCategoryId) return false;
        if (typeFilter && item.ITEM_TYPE !== typeFilter) return false;
        if (search && !item.ITEM_NAME.toUpperCase().includes(search)) return false;
        return true;
    });

    $('#itemCountBadge').text(rows.length + ' quà');

    const totalPages = Math.max(1, Math.ceil(rows.length / itemPageSize));
    if (itemPage > totalPages) itemPage = totalPages;
    const start = (itemPage-1)*itemPageSize;
    const pageRows = rows.slice(start, start+itemPageSize);

    $('#itemTableBody').html(pageRows.map(item => `
        <tr>
            <td><img src="${GIFT_IMG_URL}?itemId=${item.ID}" class="gc-item-thumb" onerror="this.style.display='none'" /></td>
            <td class="text-sm">${escHtml(item.ITEM_NAME)}</td>
            <td class="text-xs text-secondary">${escHtml(item.CATEGORY_NAME)}</td>
            <td class="text-xs"><span class="badge ${item.ITEM_TYPE === 'COMBO' ? 'bg-warning text-dark' : 'bg-info text-dark'}">${item.ITEM_TYPE === 'COMBO' ? 'Combo' : 'Đơn lẻ'}</span></td>
            <td class="text-xs">${renderComboBadges(item.COMBO_DETAILS)}</td>
            <td class="text-center"><button class="btn btn-sm btn-outline-secondary" onclick='openItemModal(${JSON.stringify(item).replace(/'/g,"&apos;")})'><i class="bi bi-pencil"></i></button></td>
        </tr>`).join('') || '<tr><td colspan="6" class="text-center text-secondary py-3">Không có quà nào khớp bộ lọc</td></tr>');

    if (rows.length) {
        const s = start+1, e = Math.min(start+itemPageSize, rows.length);
        $('#itemPaginationCount').html(`<span class="text-xs">${s}-${e} / <strong>${rows.length}</strong> quà</span>`);
    } else {
        $('#itemPaginationCount').text('');
    }
    renderPaginationBar($('#itemPaginationBar'), itemPage, totalPages, p => { itemPage = p; renderItemTable(); });
}

async function loadCatalog() {
    const res = await $.getJSON(CATALOG_URL);
    allItems = (res && res.data) || [];
    renderCategoryList();
    renderItemTable();
}

function addComboRow(value) {
    const row = $(`<div class="gc-combo-row">
        <input type="text" class="form-control form-control-sm combo-comp" value="${escHtml(value)}" placeholder="Vd: Chén, Tô, Muối..." />
        <button type="button" class="btn btn-sm btn-outline-danger" onclick="$(this).parent().remove()"><i class="bi bi-x"></i></button>
    </div>`);
    $('#comboRows').append(row);
}

function toggleComboArea() {
    $('#comboArea').toggle($('#itemType').val() === 'COMBO');
}

function openItemModal(item) {
    $('#comboRows').empty();
    $('#itemImageFile').val('');
    if (item) {
        $('#itemModalTitle').text('Sửa quà');
        $('#itemId').val(item.ID);
        $('#itemCategory').val(item.CATEGORY_ID);
        $('#itemName').val(item.ITEM_NAME);
        $('#itemType').val(item.ITEM_TYPE);
        (item.COMBO_DETAILS || []).forEach(d => addComboRow(d.COMPONENT_NAME));

        $('#itemImageHint').hide();
        $('#itemImageArea').show();
        const $preview = $('#itemImagePreview').attr('src', GIFT_IMG_URL + '?itemId=' + item.ID + '&t=' + Date.now());
        $preview.off('error').on('error', function () { $(this).hide(); }).show();
    } else {
        $('#itemModalTitle').text('Thêm quà');
        $('#itemId').val('');
        $('#itemCategory').val(activeCategoryId || ($('#itemCategory option').first().val() || ''));
        $('#itemName').val('');
        $('#itemType').val('SINGLE');

        $('#itemImageArea').hide();
        $('#itemImageHint').show();
    }
    toggleComboArea();
    new bootstrap.Modal(document.getElementById('itemModal')).show();
}

async function uploadItemImage() {
    const itemId = parseInt($('#itemId').val());
    const fileInput = document.getElementById('itemImageFile');
    if (!itemId || !fileInput.files.length) return;

    const formData = new FormData();
    formData.append('itemId', itemId);
    formData.append('file', fileInput.files[0]);
    try {
        const res = await $.ajax({ url: GIFT_IMG_UP_URL, type: 'POST', data: formData, contentType: false, processData: false });
        if (res.success) {
            showToast ? showToast('Đã cập nhật ảnh', 'success') : null;
            $('#itemImagePreview').attr('src', GIFT_IMG_URL + '?itemId=' + itemId + '&t=' + Date.now()).show();
            await loadCatalog();
        } else {
            showToast ? showToast(res.message || 'Lỗi upload ảnh', 'error') : alert(res.message || 'Lỗi upload ảnh');
        }
    } catch (e) {
        showToast ? showToast('Lỗi upload ảnh', 'error') : null;
    } finally {
        fileInput.value = '';
    }
}

async function saveItem() {
    const name = $('#itemName').val().trim();
    if (!name) { showToast ? showToast('Vui lòng nhập tên quà', 'error') : alert('Vui lòng nhập tên quà'); return; }

    const components = $('.combo-comp').map((_, el) => $(el).val().trim()).get().filter(Boolean);
    const payload = {
        ID: parseInt($('#itemId').val()) || 0,
        CATEGORY_ID: parseInt($('#itemCategory').val()),
        ITEM_NAME: name,
        ITEM_TYPE: $('#itemType').val(),
        COMBO_COMPONENTS: components
    };
    const res = await $.ajax({ url: ITEM_SAVE_URL, type: 'POST', contentType: 'application/json', headers: { 'RequestVerificationToken': CSRF_TOKEN }, data: JSON.stringify(payload) });
    if (res.OK) {
        bootstrap.Modal.getInstance(document.getElementById('itemModal'))?.hide();
        showToast ? showToast(res.MESSAGE || 'Đã lưu', 'success') : null;
        await loadCatalog();
    } else {
        showToast ? showToast(res.MESSAGE || 'Lỗi', 'error') : alert(res.MESSAGE || 'Lỗi');
    }
}

let itemSearchTimeout;
$('#itemSearch').on('input', function () { clearTimeout(itemSearchTimeout); itemPage = 1; itemSearchTimeout = setTimeout(renderItemTable, 250); });
$('#typeFilter').on('change', function () { itemPage = 1; renderItemTable(); });

let catSearchTimeout;
$('#catSearch').on('input', function () { clearTimeout(catSearchTimeout); catPage = 1; catSearchTimeout = setTimeout(renderCategoryList, 250); });

// Filter client-side (không phân trang server) — alias để nút "Xóa lọc" tự chèn bởi
// list-page-helper.js (global, có 2 .filter-bar trên trang này) gọi đúng hàm render lại cả 2 khối
// sau khi reset input.
window.loadData = function () { itemPage = 1; catPage = 1; renderCategoryList(); renderItemTable(); };

$(async function () {
    await loadCategories();
    await loadCatalog();
});
</script>
}
