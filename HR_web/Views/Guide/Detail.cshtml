@model HR_web.Models.Guide.GuideModel
@{
    ViewData["Title"] = Model.TITLE;
    bool isEmbed = Context.Request.Query["embed"] == "1";
    Layout = isEmbed ? "~/Views/Shared/_LayoutEmbed.cshtml" : "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --guide-primary: #0ea5e9;
        --guide-dark:    #0284c7;
        --guide-bg:      #f0f9ff;
        --guide-border:  #e0f2fe;
    }

    .detail-page {
        max-width: 680px;
        margin: 0 auto;
        padding-bottom: 5rem;
    }

    /* ── Back bar ─────────────────────────────── */
    .detail-back {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--guide-dark);
        font-size: 0.88rem;
        font-weight: 700;
        text-decoration: none;
        padding: 8px 14px 8px 8px;
        border-radius: 12px;
        margin-bottom: 1rem;
        -webkit-tap-highlight-color: transparent;
        transition: background .15s;
    }
    .detail-back:hover { background: var(--guide-bg); color: var(--guide-dark); }
    .detail-back i { font-size: 1.1rem; }

    /* ── Header card ──────────────────────────── */
    .detail-header {
        background: linear-gradient(135deg, #0284c7 0%, #38bdf8 100%);
        border-radius: 20px;
        padding: 1.25rem 1.4rem;
        color: #fff;
        margin-bottom: 1.25rem;
    }
    .detail-cat {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        opacity: .85;
        margin-bottom: 0.3rem;
    }
    .detail-title {
        font-size: 1.15rem;
        font-weight: 800;
        line-height: 1.3;
        margin: 0;
    }

    /* ── Content card ─────────────────────────── */
    .detail-content-card {
        background: #fff;
        border: 1px solid var(--guide-border);
        border-radius: 18px;
        padding: 1.25rem 1.25rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        margin-bottom: 1rem;
    }

    .guide-content {
        font-size: 0.9rem;
        color: #374151;
        line-height: 1.8;
    }
    .guide-content p  { margin-bottom: 0.6rem; }
    .guide-content ul,
    .guide-content ol { padding-left: 1.4rem; margin-bottom: 0.6rem; }
    .guide-content h1 { font-size: 1.3rem; font-weight: 700; margin: .75rem 0 .3rem; }
    .guide-content h2 { font-size: 1.1rem; font-weight: 700; margin: .6rem 0 .25rem; }
    .guide-content h3 { font-size: 0.95rem; font-weight: 700; margin: .5rem 0 .2rem; }
    .guide-content a  { color: var(--guide-dark); text-decoration: underline; }
    .guide-content mark { border-radius: 3px; padding: 0 2px; }
    .guide-content-table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; margin: .5rem 0; border-radius: 8px; }
    .guide-content table { width: 100%; border-collapse: collapse; font-size: 0.83rem; min-width: 280px; }
    .guide-content table td,
    .guide-content table th { border: 1px solid var(--guide-border); padding: 6px 10px; }
    .guide-content table th { background: var(--guide-bg); font-weight: 700; color: var(--guide-dark); }

    /* ── Video ────────────────────────────────── */
    .detail-video-card {
        background: #000;
        border-radius: 18px;
        overflow: hidden;
        aspect-ratio: 16 / 9;
        box-shadow: 0 4px 16px rgba(0,0,0,.2);
        margin-bottom: 1rem;
    }
    .detail-video-card video {
        width: 100%; height: 100%; display: block;
    }
    .video-section-label {
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--guide-dark);
        display: flex;
        align-items: center;
        gap: 5px;
        margin-bottom: 0.5rem;
    }

    .no-content {
        text-align: center;
        color: #94a3b8;
        padding: 1.5rem 0;
        font-size: 0.88rem;
    }

    /* ── Prev / Next nav ── */
    .detail-nav {
        display: flex; justify-content: space-between; gap: .75rem;
        margin-bottom: 1rem;
    }
    .nav-btn {
        flex: 1; display: flex; align-items: center; gap: .5rem;
        background: #fff; border: 1.5px solid var(--guide-border);
        border-radius: 16px; padding: .75rem .9rem;
        text-decoration: none !important; color: #1e293b !important;
        box-shadow: 0 2px 8px rgba(0,0,0,.04);
        transition: border-color .2s, box-shadow .2s;
        min-width: 0;
        -webkit-tap-highlight-color: transparent;
    }
    .nav-btn:active { background: var(--guide-bg); }
    @@media (hover: hover) {
        .nav-btn:hover { border-color: var(--guide-primary); box-shadow: 0 4px 14px rgba(14,165,233,.15); }
    }
    .nav-btn i { font-size: 1rem; color: var(--guide-primary); flex-shrink: 0; }
    .nav-btn-text { display: flex; flex-direction: column; min-width: 0; overflow: hidden; }
    .nav-label { font-size: .68rem; font-weight: 700; text-transform: uppercase;
                 letter-spacing: .06em; color: var(--guide-primary); }
    .nav-title { font-size: .78rem; font-weight: 600; color: #1e293b;
                 white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .nav-next { justify-content: flex-end; }
    .nav-next .nav-btn-text { align-items: flex-end; text-align: right; }
</style>

<div class="detail-page px-2">

    <!-- Back -->
    @if (!isEmbed)
    {
        <a href="@Url.Action("Index", "Guide")" class="detail-back">
            <i class="bi bi-arrow-left-circle-fill"></i>
            Danh sách hướng dẫn
        </a>
    }

    <!-- Header -->
    <div class="detail-header">
        @if (!string.IsNullOrEmpty(Model.CATEGORY))
        {
            <div class="detail-cat">
                <i class="bi bi-folder2-open me-1"></i>@Model.CATEGORY
            </div>
        }
        <div class="detail-title">@Model.TITLE</div>
    </div>

    <!-- Video (nếu có — hiện trước) -->
    @if (Model.IS_VIDEO == "Y")
    {
        <div class="video-section-label">
            <i class="bi bi-play-circle-fill"></i> Video hướng dẫn
        </div>
        <div class="detail-video-card">
            <video controls preload="metadata" playsinline controlsList="nodownload" data-fullscreen="auto">
                <source src="@Url.Action("Stream", "Video", new { folder = "GUIDE_VIDEO", id = Model.ID })" />
                Trình duyệt không hỗ trợ phát video.
            </video>
        </div>
    }

    <!-- Nội dung text -->
    @if (!string.IsNullOrEmpty(Model.CONTENT))
    {
        <div class="detail-content-card">
            <div class="guide-content" id="guideContent">
                @Html.Raw(Model.CONTENT)
            </div>
        </div>
    }
    else if (Model.IS_VIDEO != "Y")
    {
        <div class="no-content">
            <i class="bi bi-inbox" style="font-size:2rem;display:block;margin-bottom:.5rem;opacity:.3;"></i>
            Chưa có nội dung cho mục này.
        </div>
    }

    <!-- Prev / Next navigation -->
    @if (!isEmbed && (ViewBag.PrevId != null || ViewBag.NextId != null))
    {
        <div class="detail-nav">
            @if (ViewBag.PrevId != null)
            {
                <a href="@Url.Action("Detail", "Guide", new { id = (int)ViewBag.PrevId })" class="nav-btn nav-prev">
                    <i class="bi bi-chevron-left"></i>
                    <div class="nav-btn-text">
                        <span class="nav-label">Trước</span>
                        <span class="nav-title">@ViewBag.PrevTitle</span>
                    </div>
                </a>
            }
            else { <div style="flex:1"></div> }
            @if (ViewBag.NextId != null)
            {
                <a href="@Url.Action("Detail", "Guide", new { id = (int)ViewBag.NextId })" class="nav-btn nav-next">
                    <div class="nav-btn-text">
                        <span class="nav-label">Tiếp theo</span>
                        <span class="nav-title">@ViewBag.NextTitle</span>
                    </div>
                    <i class="bi bi-chevron-right"></i>
                </a>
            }
        </div>
    }

    <!-- Back bottom -->
    <div class="text-center mt-2">
        <a href="@Url.Action("Index", "Guide")" class="btn btn-outline-secondary btn-sm mb-0" style="border-radius:10px;">
            <i class="bi bi-grid me-1"></i>Xem tất cả hướng dẫn
        </a>
    </div>
</div>

@section Scripts {
<script>
    // Wrap table để scroll ngang trên mobile
    document.querySelectorAll('#guideContent table').forEach(tbl => {
        const wrap = document.createElement('div');
        wrap.className = 'guide-content-table-wrap';
        tbl.parentNode.insertBefore(wrap, tbl);
        wrap.appendChild(tbl);
    });
</script>
}
