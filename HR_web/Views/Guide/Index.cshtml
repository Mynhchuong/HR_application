@model List<HR_web.Models.Guide.GuideModel>
@{
    ViewData["Title"] = "Hướng dẫn sử dụng";
    if (!User.Identity!.IsAuthenticated)
    {
        Layout = "~/Views/Shared/_LayoutPublic.cshtml";
    }
    var grouped = Model.GroupBy(g => g.CATEGORY ?? "Chung").OrderBy(g => g.Key).ToList();
}

<style>
    :root {
        --guide-primary: #0ea5e9;
        --guide-dark:    #0284c7;
        --guide-bg:      #f0f9ff;
        --guide-border:  #e0f2fe;
    }

    .guide-page {
        max-width: 680px;
        margin: 0 auto;
        padding-bottom: 5rem;
    }

    /* ── Hero ─────────────────────────────────── */
    .guide-hero {
        background: linear-gradient(135deg, #8b0000 0%, #c00000 100%);
        border-radius: 20px;
        padding: 1.25rem 1.25rem 1.25rem 1.4rem;
        margin-bottom: 1.5rem;
        color: #fff;
        position: relative;
        overflow: hidden;
    }
    .guide-hero h5   { font-size: 1.1rem; font-weight: 800; margin: 0 0 0.2rem; color: #fff !important; }
    .guide-hero small{ font-size: 0.78rem; opacity: 0.85; color: #fff !important; }
    .guide-hero-img  {
        position: absolute; right: 0; bottom: -4px;
        height: 90px; pointer-events: none; user-select: none;
    }

    /* ── Section label ────────────────────────── */
    .guide-section-label {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: .07em;
        text-transform: uppercase;
        color: #64748b;
        padding: 0 4px;
        margin: 1.25rem 0 0.6rem;
    }

    /* ── Feature card ─────────────────────────── */
    .guide-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.75rem;
    }
    @@media (min-width: 540px) {
        .guide-grid { grid-template-columns: repeat(3, 1fr); }
    }

    .guide-card {
        background: #fff;
        border: 1.5px solid var(--guide-border);
        border-radius: 18px;
        padding: 1.1rem 0.9rem 1rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        text-decoration: none !important;
        color: inherit !important;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        transition: transform .2s, box-shadow .2s, border-color .2s;
        -webkit-tap-highlight-color: transparent;
        cursor: pointer;
    }
    .guide-card:active {
        transform: scale(0.95);
        background: var(--guide-bg);
    }
    @@media (hover: hover) {
        .guide-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 20px rgba(14,165,233,.15);
            border-color: var(--guide-primary);
        }
    }

    .guide-card-icon {
        width: 52px; height: 52px;
        border-radius: 14px;
        background: var(--guide-bg);
        display: flex; align-items: center; justify-content: center;
        margin-bottom: 0.65rem;
        font-size: 1.5rem;
        color: var(--guide-dark);
        transition: transform .2s;
    }
    .guide-card:hover .guide-card-icon { transform: rotate(5deg) scale(1.1); }

    .guide-card-title {
        font-size: 0.82rem;
        font-weight: 700;
        color: #1e293b;
        line-height: 1.3;
    }
    .guide-card-cat {
        font-size: 0.7rem;
        color: #64748b;
        margin-top: 3px;
    }
    .guide-card-video {
        margin-top: 5px;
        font-size: 0.65rem;
        font-weight: 700;
        color: var(--guide-dark);
        background: var(--guide-bg);
        border-radius: 20px;
        padding: 1px 8px;
        display: inline-flex;
        align-items: center;
        gap: 3px;
    }

    /* ── Empty ────────────────────────────────── */
    .guide-empty {
        text-align: center;
        padding: 3rem 1rem;
        color: #94a3b8;
    }
    .guide-empty i { font-size: 3rem; opacity: .25; display: block; margin-bottom: .75rem; }

    /* ── App link card ────────────────────────── */
    .applink-card {
        background: #fff;
        border: 1.5px solid var(--guide-border);
        border-radius: 20px;
        padding: 1.25rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 2px 10px rgba(0,0,0,.05);
    }
    .applink-head {
        display: flex; align-items: center; gap: .8rem; margin-bottom: 1.1rem;
    }
    .applink-icon {
        width: 48px; height: 48px; border-radius: 14px; flex-shrink: 0;
        background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
        display: flex; align-items: center; justify-content: center;
        box-shadow: 0 6px 14px rgba(30,41,59,.25);
    }
    .applink-icon i { font-size: 1.4rem; color: #fff; }
    .applink-head-text h6 { font-size: .92rem; font-weight: 800; color: #1e293b; margin: 0; line-height: 1.3; }
    .applink-head-text small { font-size: .74rem; color: #64748b; }

    .applink-input-row { display: flex; gap: 8px; }
    .applink-input-row input {
        flex: 1; border: 1.5px solid var(--guide-border); border-radius: 14px;
        padding: 12px 16px; font-size: .9rem; outline: none; background: var(--guide-bg);
        transition: border-color .15s, background .15s;
    }
    .applink-input-row input:focus { border-color: var(--guide-primary); background: #fff; }
    .applink-input-row button {
        border: none; border-radius: 14px; padding: 0 20px;
        background: linear-gradient(135deg, var(--guide-primary) 0%, var(--guide-dark) 100%);
        color: #fff; font-weight: 700; font-size: .85rem;
        box-shadow: 0 4px 12px rgba(14,165,233,.3);
        white-space: nowrap;
        transition: transform .15s;
    }
    .applink-input-row button:active { transform: scale(.96); }
    .applink-input-row button:disabled { opacity: .55; box-shadow: none; }

    .applink-result { margin-top: 1rem; }
    .applink-msg {
        border-radius: 14px; font-size: .82rem; padding: .7rem .9rem;
        display: flex; align-items: center; gap: 8px;
    }
    .applink-msg .material-symbols-rounded { font-size: 1.15rem; flex-shrink: 0; }
    .applink-msg.info    { background: var(--guide-bg); color: var(--guide-dark); }
    .applink-msg.warning { background: #fffbeb; color: #92400e; }
    .applink-msg.danger  { background: #fef2f2; color: #991b1b; }

    .applink-link-card {
        background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%);
        border: 1.5px solid #bbf7d0; border-radius: 16px; padding: 1rem;
    }
    .applink-link-card .applink-link-label {
        font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em;
        color: #15803d; margin-bottom: .35rem; display: flex; align-items: center; gap: 5px;
    }
    .applink-link-url {
        font-size: .78rem; color: #166534; word-break: break-all; margin-bottom: .8rem;
    }
    .applink-btn-row { display: flex; gap: 8px; }
    .applink-btn-row .applink-btn-primary,
    .applink-btn-row .applink-btn-ghost {
        flex: 1; border-radius: 12px; padding: .65rem; font-size: .8rem; font-weight: 700;
        text-align: center; text-decoration: none !important;
        display: flex; align-items: center; justify-content: center; gap: 5px;
        border: none; transition: transform .15s;
    }
    .applink-btn-row .applink-btn-primary {
        background: #16a34a; color: #fff !important; box-shadow: 0 4px 12px rgba(22,163,74,.3);
    }
    .applink-btn-row .applink-btn-ghost {
        background: #fff; color: #166534 !important; border: 1.5px solid #bbf7d0;
    }
    .applink-btn-row button:active, .applink-btn-row a:active { transform: scale(.96); }

    .applink-choice-card {
        background: var(--guide-bg); border: 1.5px solid var(--guide-border);
        border-radius: 16px; padding: 1rem;
    }
    .applink-choice-card > p { font-size: .82rem; color: #334155; margin: 0 0 .8rem; }
    .applink-choice-btns { display: flex; gap: 8px; }
    .applink-choice-btns a, .applink-choice-btns button {
        flex: 1; border-radius: 12px; padding: .7rem .5rem; font-size: .78rem; font-weight: 700;
        border: 1.5px solid var(--guide-border); background: #fff; color: #1e293b;
        text-align: center; text-decoration: none !important;
        display: flex; flex-direction: column; align-items: center; gap: 4px;
        transition: transform .15s;
    }
    .applink-choice-btns a:active, .applink-choice-btns button:active { transform: scale(.96); }
    .applink-choice-btns .material-symbols-rounded { font-size: 1.3rem; }
    .applink-choice-btns .btn-update { color: var(--guide-dark); border-color: var(--guide-primary); background: #fff; }
    .applink-choice-btns .btn-newphone { color: #7c3aed; border-color: #ddd6fe; background: #faf5ff; }

    /* ── Back to login ────────────────────────── */
    .btn-back-login {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        height: 52px;
        background: #1e293b;
        color: #fff !important;
        font-size: 1rem;
        font-weight: 700;
        border-radius: 16px;
        text-decoration: none !important;
        margin-top: 1.5rem;
        transition: background .2s;
        -webkit-tap-highlight-color: transparent;
    }
    .btn-back-login:active { background: #0f172a; }
</style>

<div class="guide-page px-2">

    <!-- Hero -->
    @{
        var guideHeroImgs = new[] { "A-alo.png", "Sayhii.png" };
        var guideHeroImg  = guideHeroImgs[new Random().Next(guideHeroImgs.Length)];
    }
    <div class="guide-hero">
        <h5><i class="bi bi-book-half me-2"></i>Hướng Dẫn Sử Dụng</h5>
        <small>Chọn chức năng bạn muốn xem hướng dẫn</small>
        <img src="@Url.Content("~/assets/img/illustrations/" + guideHeroImg)" class="guide-hero-img" alt="" />
    </div>

    <!-- Nhận link cài đặt app iOS -->
    <div class="applink-card">
        <div class="applink-head">
            <div class="applink-icon"><i class="bi bi-apple"></i></div>
            <div class="applink-head-text">
                <h6>Nhận link cài đặt app</h6>
                <small>Dành cho iPhone — nhập mã thẻ để lấy link cài đặt</small>
            </div>
        </div>
        @Html.AntiForgeryToken()
        <div class="applink-input-row">
            <input type="text" id="applinkEmpcd" placeholder="Nhập mã thẻ của bạn" autocomplete="off"
                   onkeydown="if(event.key==='Enter') requestAppLink()" />
            <button type="button" id="applinkBtn" onclick="requestAppLink()">Nhận link</button>
        </div>
        <div class="applink-result" id="applinkResult"></div>
    </div>

    @if (!Model.Any())
    {
        <div class="guide-empty">
            <i class="bi bi-book"></i>
            <p>Chưa có hướng dẫn nào.<br>Vui lòng liên hệ Admin để được hỗ trợ.</p>
        </div>
    }
    else
    {
        @foreach (var group in grouped)
        {
            <div class="guide-section-label">
                <i class="bi bi-folder2 me-1"></i>@group.Key
            </div>
            <div class="guide-grid">
                @foreach (var item in group.OrderBy(i => i.DISPLAY_ORDER).ThenBy(i => i.ID))
                {
                    <a href="@Url.Action("Detail", "Guide", new { id = item.ID })" class="guide-card">
                        <div class="guide-card-icon">
                            <span class="material-symbols-rounded">menu_book</span>
                        </div>
                        <div class="guide-card-title">@item.TITLE</div>
                        @if (item.IS_VIDEO == "Y")
                        {
                            <div class="guide-card-video">
                                <i class="bi bi-play-circle-fill"></i> Video
                            </div>
                        }
                    </a>
                }
            </div>
        }
    }

    @if (!User.Identity!.IsAuthenticated)
    {
        <a href="@Url.Action("Login", "Account")" class="btn-back-login">
            <span class="material-symbols-rounded">login</span>
            Quay lại đăng nhập
        </a>
    }
</div>

@section Scripts {
<script>
    const APPLINK_REQUEST_URL  = '@Url.Action("RequestAppLink", "Guide")';
    const APPLINK_REASSIGN_URL = '@Url.Action("ReassignAppLink", "Guide")';
    const APPLINK_UPDATE_URL   = '@Url.Action("Detail", "Guide", new { id = 11 })';
    const APPLINK_CSRF = document.querySelector('.applink-card input[name="__RequestVerificationToken"]')?.value ?? '';

    async function postApplink(url, empcd) {
        const res = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': APPLINK_CSRF },
            body: 'empcd=' + encodeURIComponent(empcd)
        });
        return res.json();
    }

    const APPLINK_ICONS = { info: 'info', warning: 'warning', danger: 'error' };

    function renderApplinkAlert(message, type) {
        const icon = APPLINK_ICONS[type] || 'info';
        document.getElementById('applinkResult').innerHTML =
            `<div class="applink-msg ${type}"><span class="material-symbols-rounded">${icon}</span>${message}</div>`;
    }

    function renderApplinkLink(linkUrl) {
        document.getElementById('applinkResult').innerHTML = `
            <div class="applink-link-card">
                <div class="applink-link-label"><span class="material-symbols-rounded" style="font-size:1rem;">check_circle</span>Link cài đặt của bạn</div>
                <div class="applink-link-url">${linkUrl}</div>
                <div class="applink-btn-row">
                    <a href="${linkUrl}" target="_blank" class="applink-btn-primary"><span class="material-symbols-rounded" style="font-size:1.05rem;">open_in_new</span>Mở link cài đặt</a>
                    <button type="button" class="applink-btn-ghost" onclick="copyApplink('${linkUrl}')"><span class="material-symbols-rounded" style="font-size:1.05rem;">content_copy</span>Sao chép</button>
                </div>
            </div>`;
    }

    function copyApplink(link) {
        navigator.clipboard?.writeText(link);
        if (typeof showToast === 'function') showToast('Đã sao chép link', 'success');
        else alert('Đã sao chép link');
    }

    async function requestAppLink() {
        const empcd = document.getElementById('applinkEmpcd').value.trim();
        if (!empcd) { renderApplinkAlert('Vui lòng nhập mã thẻ', 'warning'); return; }

        const btn = document.getElementById('applinkBtn');
        btn.disabled = true;
        renderApplinkAlert('Đang kiểm tra...', 'info');

        try {
            const data = await postApplink(APPLINK_REQUEST_URL, empcd);
            if (!data.success) {
                renderApplinkAlert(data.message || 'Có lỗi xảy ra', 'danger');
            } else if (data.alreadyAssigned) {
                document.getElementById('applinkResult').innerHTML = `
                    <div class="applink-choice-card">
                        <p>Mã thẻ này đã nhận link trước đó rồi. Bạn muốn:</p>
                        <div class="applink-choice-btns">
                            <a href="${APPLINK_UPDATE_URL}" class="btn-update"><span class="material-symbols-rounded">system_update</span>Cập nhật app</a>
                            <button type="button" class="btn-newphone" onclick="reassignAppLink('${empcd.replace(/'/g, "\\'")}')"><span class="material-symbols-rounded">phone_iphone</span>Đổi máy mới</button>
                        </div>
                    </div>`;
            } else {
                renderApplinkLink(data.linkUrl);
            }
        } catch {
            renderApplinkAlert('Không kết nối được máy chủ, vui lòng thử lại', 'danger');
        } finally {
            btn.disabled = false;
        }
    }

    async function reassignAppLink(empcd) {
        renderApplinkAlert('Đang cấp link mới...', 'info');
        try {
            const data = await postApplink(APPLINK_REASSIGN_URL, empcd);
            if (data.success) renderApplinkLink(data.linkUrl);
            else renderApplinkAlert(data.message || 'Có lỗi xảy ra', 'danger');
        } catch {
            renderApplinkAlert('Không kết nối được máy chủ, vui lòng thử lại', 'danger');
        }
    }
</script>
}
