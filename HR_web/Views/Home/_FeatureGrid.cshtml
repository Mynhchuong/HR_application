@model HR_web.ViewModels.Home.HomeIndexViewModel

@{
    var isEn = Model.Lang == "en";
    var role = Model.RoleName;
    var isManagerLike = role is "Supervisor" or "DeputyManager" or "Manager" or "Assistant";
    var isExpat       = role == "Expat";
    var isHrAdmin     = role is "HR" or "Admin";

    string L(string vi, string en) => isEn ? en : vi;

    // Route "Duyệt phép" — Expat có endpoint riêng
    string approveLeaveUrl = isExpat
        ? Url.Action("LeaveApprovalForExpat", "Leave")!
        : Url.Action("LeaveApprovalList",     "Leave")!;

    // Route "Duyệt GP" — GatePass phân theo scope tuple, dùng chung cho Sup/Manager
    string approveGpUrl = Url.Action("GpListForSupervisor", "GatePass")!;
    if (isExpat)   approveGpUrl = Url.Action("GpListForExpat", "GatePass")!;
    if (isHrAdmin) approveGpUrl = Url.Action("GpListForHR",    "GatePass")!;

    // Route "Danh sách OT" — role-specific
    string otListUrl = Url.Action("OtConfirmForm", "OT")!;
    if (isManagerLike)      otListUrl = Url.Action("OtListForSupervisor", "OT")!;
    else if (isExpat)       otListUrl = Url.Action("OtListForExpat",      "OT")!;
    else if (isHrAdmin)     otListUrl = Url.Action("OtListForHR",         "OT")!;

    string notiUrl = isExpat
        ? Url.Action("IndexForExpat", "Notification")!
        : Url.Action("Index",         "Notification")!;
}

<section class="home-feature-grid">
    <div class="home-feature-heading">🚀 @L("Chức năng", "Features")</div>
    <div class="home-feature-tiles">
        <a href="@Url.Action("LeaveMyRequests", "Leave")" class="home-tile"><span class="home-tile-icon">📅</span><span class="home-tile-label">@L("Nghỉ phép", "Leave")</span></a>
        <a href="@Url.Action("GpRequestForm", "GatePass")" class="home-tile"><span class="home-tile-icon">🚪</span><span class="home-tile-label">@L("Ra cổng", "Gate Pass")</span></a>
        @* Expat KHÔNG có: Overtime, Payslip, Menu *@
        @* Hỏi đáp HR + Thông báo đã có ở bottom nav — bỏ khỏi grid *@
        @if (!isExpat)
        {
            <a href="@Url.Action("OtConfirmForm", "OT")" class="home-tile"><span class="home-tile-icon">⏰</span><span class="home-tile-label">@L("Tăng ca", "Overtime")</span></a>
            <a href="@Url.Action("Index", "Payslip")" class="home-tile"><span class="home-tile-icon">💰</span><span class="home-tile-label">@L("Phiếu lương", "Payslip")</span></a>
            <a href="@Url.Action("Today", "Menu")" class="home-tile"><span class="home-tile-icon">🍱</span><span class="home-tile-label">@L("Thực đơn", "Menu")</span></a>
        }
        <a href="@Url.Action("Index", "Policy")" class="home-tile"><span class="home-tile-icon">📖</span><span class="home-tile-label">@L("Nội quy", "Policy")</span></a>
        <a href="@Url.Action("Index", "Guide")" class="home-tile"><span class="home-tile-icon">❓</span><span class="home-tile-label">@L("Hướng dẫn", "Guide")</span></a>

        @* HR/Admin KHÔNG hiện các tile duyệt — họ có HR Tools section riêng ở dưới *@
        @if (isManagerLike || isExpat)
        {
            <a href="@approveLeaveUrl" class="home-tile home-tile-manager"><span class="home-tile-icon">✅</span><span class="home-tile-label">@L("Duyệt phép", "Approve Leave")</span></a>
            <a href="@approveGpUrl" class="home-tile home-tile-manager"><span class="home-tile-icon">🛂</span><span class="home-tile-label">@L("Duyệt GP", "Approve GP")</span></a>
            <a href="@otListUrl" class="home-tile home-tile-manager"><span class="home-tile-icon">📊</span><span class="home-tile-label">@L("DS tăng ca", "OT List")</span></a>
        }
    </div>

    @if (isHrAdmin)
    {
        <div class="home-feature-heading home-feature-heading-hr">🏢 @L("HR Tools", "HR Tools")</div>
        <div class="home-feature-tiles">
            <a href="@Url.Action("Manage", "BulletinAdmin")" class="home-tile home-tile-hr"><span class="home-tile-icon">📢</span><span class="home-tile-label">@L("Quản lý bản tin", "Manage Bulletin")</span></a>
            <a href="@Url.Action("Index", "HrInquiry")" class="home-tile home-tile-hr"><span class="home-tile-icon">💼</span><span class="home-tile-label">@L("Inquiry HR", "HR Inquiry")</span></a>
            <a href="@Url.Action("Index", "SundayLeave")" class="home-tile home-tile-hr"><span class="home-tile-icon">🗓️</span><span class="home-tile-label">@L("Nghỉ CN", "Sunday Leave")</span></a>
            <a href="@Url.Action("Index", "NotiTemplate")" class="home-tile home-tile-hr"><span class="home-tile-icon">🔔</span><span class="home-tile-label">@L("Mẫu thông báo", "Noti Template")</span></a>
            <a href="@Url.Action("Index", "AdminNoti")" class="home-tile home-tile-hr"><span class="home-tile-icon">📣</span><span class="home-tile-label">@L("Gửi thông báo", "Send Noti")</span></a>
            <a href="@Url.Action("UserManager", "User")" class="home-tile home-tile-hr"><span class="home-tile-icon">👥</span><span class="home-tile-label">@L("Quản lý user", "Users")</span></a>
            @* HR + Admin đều truy cập /HomeAdmin — HR chỉ thấy 2 tab Banner+Greeting, Admin thấy full *@
            <a href="@Url.Action("Index", "HomeAdmin")" class="home-tile home-tile-hr"><span class="home-tile-icon">🎨</span><span class="home-tile-label">@L("Cấu hình Home", "Home Config")</span></a>
        </div>
    }
</section>
