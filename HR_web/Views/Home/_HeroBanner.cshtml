@model HR_web.ViewModels.Home.HomeIndexViewModel

@{
    var b = Model.Banner;
    // Không có banner → không render popup
    if (b == null || string.IsNullOrEmpty(b.ImageUrl)) { return; }

    var overlayText = b.OverlayText;
    var overlayPos  = (b.OverlayPos ?? "BL").ToLower();
    var hasLink     = !string.IsNullOrEmpty(b.LinkUrl);
    var linkUrl     = b.LinkUrl ?? "#";
    var linkTarget  = b.LinkTarget ?? "_self";
    var isVideo     = b.IsVideo;

    var dayKey  = DateTime.Today.ToString("yyyyMMdd");
    var isVi    = Model.Lang != "en";
    var closeAria = isVi ? "Đóng" : "Close";
    var replayText = isVi ? "Xem lại" : "Replay";
    var closeText  = isVi ? "Đóng"    : "Close";
}

<div id="homeHeroPopup"
     class="home-hero-popup@(isVideo ? " home-hero-popup-video" : "")"
     data-day="@dayKey"
     data-media="@(isVideo ? "video" : "image")"
     hidden>
    <div class="home-hero-popup-backdrop" data-close="hero-popup"></div>
    <div class="home-hero-popup-panel" role="dialog" aria-modal="true">
        <button type="button"
                class="home-hero-popup-close"
                aria-label="@closeAria"
                data-close="hero-popup">×</button>

        @if (isVideo)
        {
            <video id="homeHeroVideo"
                   class="home-hero-popup-video-el"
                   src="@b.ImageUrl"
                   playsinline
                   muted
                   autoplay
                   preload="auto"
                   controls>
            </video>

            @* Overlay hiện sau khi video kết thúc *@
            <div id="homeHeroVideoEnded" class="home-hero-video-ended" hidden>
                <button type="button" class="home-hero-video-btn home-hero-video-btn-replay" data-hero-replay>
                    <span aria-hidden="true">↻</span> @replayText
                </button>
                <button type="button" class="home-hero-video-btn home-hero-video-btn-close" data-close="hero-popup">
                    <span aria-hidden="true">×</span> @closeText
                </button>
            </div>

            @if (!string.IsNullOrEmpty(overlayText))
            {
                <span class="home-hero-popup-overlay home-banner-pos-@overlayPos">@overlayText</span>
            }
        }
        else if (hasLink)
        {
            <a href="@linkUrl"
               target="@linkTarget"
               class="home-hero-popup-link"
               rel="@(linkTarget == "_blank" ? "noopener noreferrer" : null)">
                <img src="@b.ImageUrl" alt="Home banner" class="home-hero-popup-image" loading="eager"
                     onerror="var p=document.getElementById('homeHeroPopup');if(p){p.hidden=true;document.body.classList.remove('home-hero-popup-open');}" />
                @if (!string.IsNullOrEmpty(overlayText))
                {
                    <span class="home-hero-popup-overlay home-banner-pos-@overlayPos">@overlayText</span>
                }
            </a>
        }
        else
        {
            <img src="@b.ImageUrl" alt="Home banner" class="home-hero-popup-image" loading="eager"
                     onerror="var p=document.getElementById('homeHeroPopup');if(p){p.hidden=true;document.body.classList.remove('home-hero-popup-open');}" />
            @if (!string.IsNullOrEmpty(overlayText))
            {
                <span class="home-hero-popup-overlay home-banner-pos-@overlayPos">@overlayText</span>
            }
        }
    </div>
</div>
