@model HR_web.ViewModels.Home.HomeIndexViewModel

<div id="homeMealLockBanner" class="home-meallock-banner" style="display: none;">
    <div class="home-meallock-header">
        <div class="home-meallock-title">
            <span class="home-meallock-icon-badge">⏰</span>
            <span>Lịch chốt suất ăn tuần này</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="@Url.Action("Today", "Menu")" class="home-meallock-btn">
                <span>Đổi món ngay</span>
                <i class="bi bi-arrow-right-short ms-1"></i>
            </a>
            <button type="button" class="home-meallock-close" onclick="dismissHomeMealLock()" aria-label="Đóng">×</button>
        </div>
    </div>

    <div id="homeMealLockContent" class="home-meallock-content"></div>
</div>

<script>
(function loadHomeMealLocks() {
    if (sessionStorage.getItem('home_meallock_dismissed') === '1') return;

    function getWeekRangeIso() {
        const d = new Date();
        const day = d.getDay(); // 0=Sun, 1=Mon...
        const diffToMon = (day === 0 ? -6 : 1 - day);
        const mon = new Date(d); mon.setDate(d.getDate() + diffToMon);
        const sat = new Date(mon); sat.setDate(mon.getDate() + 6);
        return {
            mon: mon.toISOString().slice(0, 10),
            sat: sat.toISOString().slice(0, 10)
        };
    }

    const w = getWeekRangeIso();
    const listUrl = '@Url.Action("List", "MealLock")';

    fetch(`${listUrl}?from=${w.mon}&to=${w.sat}`)
        .then(r => r.json())
        .then(d => {
            if (!d || !d.success || !Array.isArray(d.data)) return;

            const today0 = new Date(); today0.setHours(0, 0, 0, 0);
            const upcoming = d.data
                .filter(r => r.isActive && (r.lockLunch || r.lockOt))
                .filter(r => new Date(r.lockDate) >= today0)
                .sort((a, b) => new Date(a.lockDate) - new Date(b.lockDate));

            if (upcoming.length === 0) return;

            const dayFullNames = ['Chủ nhật', 'Thứ 2', 'Thứ 3', 'Thứ 4', 'Thứ 5', 'Thứ 6', 'Thứ 7'];
            const fmtShortDate = (dStr) => {
                const dt = new Date(dStr);
                const dd = String(dt.getDate()).padStart(2, '0');
                const mo = String(dt.getMonth() + 1).padStart(2, '0');
                return `${dd}/${mo}`;
            };

            const escTxt = (str) => {
                if (!str) return '';
                return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
            };

            // Cùng 1 ngày có thể có nhiều lần khoá (vd thêm 1 mốc khoá đặc biệt riêng) — gộp chung
            // 1 khối theo NGÀY thay vì lặp lại tiêu đề "Ăn Trưa Thứ 7 (26/09)" nhiều lần cho gọn.
            const groupsByDate = new Map();
            upcoming.forEach(r => {
                if (!groupsByDate.has(r.lockDate)) groupsByDate.set(r.lockDate, []);
                groupsByDate.get(r.lockDate).push(r);
            });

            const itemHtmls = Array.from(groupsByDate.entries()).map(([lockDate, rows]) => {
                const dMeal = new Date(lockDate);
                const mealDayStr = `${dayFullNames[dMeal.getDay()]} (${fmtShortDate(lockDate)})`;

                const anyLunch = rows.some(r => r.lockLunch);
                const anyOt = rows.some(r => r.lockOt);
                let mealType = '';
                if (anyLunch && anyOt) mealType = 'Ăn Trưa & Tăng Ca';
                else if (anyLunch) mealType = 'Ăn Trưa';
                else if (anyOt) mealType = 'Suất Tăng Ca';
                else mealType = 'Suất Ăn';

                const subRowsHtml = rows.map(r => {
                    let cutLine = '';
                    if (r.cutoffDt) {
                        const dCut = new Date(r.cutoffDt);
                        const cutDow = dayFullNames[dCut.getDay()];
                        const hh = String(dCut.getHours()).padStart(2, '0');
                        const mm = String(dCut.getMinutes()).padStart(2, '0');
                        const cutDateStr = fmtShortDate(r.cutoffDt);
                        cutLine = `Khóa lúc <strong style="color:#c2410c;">${hh}:${mm} ${cutDow} (${cutDateStr})</strong>`;
                    } else {
                        cutLine = `<strong style="color:#dc2626;">Khoá cả ngày</strong>`;
                    }
                    const noteLine = r.note ? `<div class="home-meallock-note">📝 ${escTxt(r.note)}</div>` : '';
                    return `<div class="home-meallock-subitem">${cutLine}${noteLine}</div>`;
                }).join('');

                return `<div class="home-meallock-item">
                    <div class="home-meallock-item-head"><strong>${mealType} ${mealDayStr}</strong></div>
                    ${subRowsHtml}
                </div>`;
            });

            // Nhiều hơn 2 lịch khoá là danh sách dài, xấu trên mobile — chỉ hiện 2 lịch gần nhất,
            // các lịch còn lại gói gọn sau nút "Xem thêm" để bấm ra khi cần.
            const MAX_VISIBLE = 2;
            const visibleHtml = itemHtmls.slice(0, MAX_VISIBLE).join('');
            const extraCount = itemHtmls.length - MAX_VISIBLE;
            const hiddenHtml = extraCount > 0 ? itemHtmls.slice(MAX_VISIBLE).join('') : '';
            const moreBtnHtml = extraCount > 0
                ? `<button type="button" id="homeMealLockMoreBtn" class="home-meallock-more" data-count="${extraCount}" onclick="toggleHomeMealLockMore(this)">
                       <span>Xem thêm ${extraCount} lịch khác</span> <i class="bi bi-chevron-down"></i>
                   </button>`
                : '';

            const banner = document.getElementById('homeMealLockBanner');
            const contentEl = document.getElementById('homeMealLockContent');
            if (banner && contentEl) {
                contentEl.innerHTML = visibleHtml
                    + (extraCount > 0 ? `<div id="homeMealLockExtra" style="display:none;">${hiddenHtml}</div>${moreBtnHtml}` : '');
                banner.style.display = 'flex';
            }
        })
        .catch(() => {});
})();

function toggleHomeMealLockMore(btn) {
    const extra = document.getElementById('homeMealLockExtra');
    if (!extra) return;
    const expanded = extra.style.display !== 'none';
    extra.style.display = expanded ? 'none' : 'block';
    const count = btn.dataset.count;
    btn.innerHTML = expanded
        ? `<span>Xem thêm ${count} lịch khác</span> <i class="bi bi-chevron-down"></i>`
        : `<span>Thu gọn</span> <i class="bi bi-chevron-up"></i>`;
}

function dismissHomeMealLock() {
    sessionStorage.setItem('home_meallock_dismissed', '1');
    const banner = document.getElementById('homeMealLockBanner');
    if (banner) banner.style.display = 'none';
}
</script>
