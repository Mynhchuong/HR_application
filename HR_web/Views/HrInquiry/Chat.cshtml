@using HR_web.Models.Inquiry
@using HR_web.Helpers
@model InquiryMessagesResponse
@{
    ViewData["Title"] = "Chat - HR";
    var inq        = Model.inquiry!;
    bool isClosed  = inq.Status == "CLOSED";
    string myEmpCd = ViewBag.CurrentEmpCd as string ?? "";
    bool isMyConv  = inq.AssignedTo == myEmpCd;
    bool isLocked  = !string.IsNullOrEmpty(inq.AssignedTo) && !isMyConv;
    bool canClose  = !isClosed && isMyConv;

    string Cls(string st)    => st == "SYS" ? "sys" : (st == "HR" ? "mine" : "theirs");
    string AvCls(string st)  => st == "HR" ? "av-mine" : "av-theirs";
}

<link href="~/css/inquiry-chat.css" rel="stylesheet" asp-append-version="true" />
<style>
    .chat-wrap { --chat-accent: #2563eb; --chat-accent-2: #3b82f6; }
</style>

<div class="chat-wrap">
    <!-- Header -->
    <div class="chat-header">
        <a class="chat-header-back" href="@Url.Action("Index","HrInquiry")">
            <span class="material-symbols-rounded">arrow_back</span>
        </a>
        <div class="chat-header-info">
            <div class="chat-header-no">@inq.InquiryNo</div>
            <div class="chat-header-subj">@(inq.Subject ?? inq.TopicName ?? "Hội thoại")</div>
            <div class="chat-header-meta">
                <span class="status-pill @(isClosed?"closed":"open")">@(isClosed?"Đã đóng":"Đang mở")</span>
                @if (inq.ChatType == "ANON") { <span class="anon-pill"><span class="material-symbols-rounded" style="font-size:.7rem;vertical-align:middle">visibility_off</span> Ẩn danh</span> }
                @if (inq.ChatType == "DIRECT" && !string.IsNullOrEmpty(inq.EmpName)) { <span style="font-size:.72rem;color:#64748b" class="vni-font">@inq.EmpName</span> }
            </div>
        </div>
        @if (canClose)
        {
            <button class="btn btn-sm btn-outline-danger" style="border-radius:10px;font-size:.78rem;font-weight:700" onclick="InquiryChat.confirmClose()">
                <span class="material-symbols-rounded me-1" style="font-size:.85rem;vertical-align:middle">close</span>Đóng hội thoại
            </button>
        }
    </div>

    <!-- Lock/assigned banner -->
    @if (isLocked)
    {
        <div class="lock-banner">
            <span class="material-symbols-rounded">lock</span>
            Đang phụ trách bởi <strong class="ms-1 vni-font">@inq.AssignedName</strong> — Bạn chỉ có thể đọc.
        </div>
    }
    else if (isMyConv)
    {
        <div class="my-banner">
            <span class="material-symbols-rounded">assignment_ind</span>
            Bạn đang phụ trách hội thoại này.
        </div>
    }
    else if (!isClosed)
    {
        <div class="my-banner" style="background:#f0fdf4;border-color:#bbf7d0;color:#166534">
            <span class="material-symbols-rounded">info</span>
            Hội thoại chưa có người phụ trách. Gửi phản hồi đầu tiên để nhận hội thoại.
        </div>
    }

    <!-- Messages -->
    <div class="chat-msgs" id="chatMsgs">
        @foreach (var msg in Model.messages)
        {
            bool isMine = msg.SenderType == "HR" && msg.SenderCd == myEmpCd;
            string cls = Cls(msg.SenderType);
            string displayName = msg.SenderName ?? (msg.SenderType == "EMP" ? (inq.EmpName ?? "Nhân viên") : "HR");
            bool canRecall = isMine && !msg.IsDeleted && !msg.IsReadEmp;
            <div class="msg-row @cls" data-msg-id="@msg.Id" data-sender-cd="@msg.SenderCd" data-sender-type="@msg.SenderType"
                 data-is-mine="@(isMine ? "1" : "0")"
                 data-is-read-hr="@(msg.IsReadHr ? "1" : "0")"
                 data-is-read-emp="@(msg.IsReadEmp ? "1" : "0")">
                @if (msg.SenderType != "SYS") { <div class="msg-avatar @AvCls(msg.SenderType)">@(!string.IsNullOrEmpty(msg.SenderName) ? msg.SenderName[0].ToString().ToUpper() : (msg.SenderType == "EMP" ? "E" : "H"))</div> }
                <div>
                    @if (msg.SenderType != "SYS")
                    {
                        <div class="msg-sender-name vni-font">@displayName</div>
                    }
                    @if (msg.SenderType == "SYS")
                    {
                        <div class="msg-bubble @(msg.IsDeleted ? "deleted" : "")">
                            @if (msg.IsDeleted) { <span>Tin nhắn đã thu hồi</span> }
                            else if (!string.IsNullOrEmpty(msg.Content)) { <div class="msg-content">@Html.Raw(ChatHtmlHelper.Sanitize(msg.Content))</div> }
                            <div class="msg-time">@msg.SentDt.ToString("HH:mm")</div>
                        </div>
                    }
                    else
                    {
                        <div class="msg-bubble-row">
                            <div class="msg-bubble @(msg.IsDeleted ? "deleted" : "")">
                                @if (msg.IsDeleted)
                                {
                                    <span>Tin nhắn đã thu hồi</span>
                                }
                                else
                                {
                                    @if (!string.IsNullOrEmpty(msg.Content)) { <div class="msg-content">@Html.Raw(ChatHtmlHelper.Sanitize(msg.Content))</div> }
                                    @if (msg.Attachments.Count > 0)
                                    {
                                        <div class="msg-attachments">
                                            @foreach (var a in msg.Attachments)
                                            {
                                                if (a.FileType == "IMAGE")
                                                {
                                                    <a href="@Url.Action("GetFile","HrInquiry")?path=@Uri.EscapeDataString(a.FilePath)" target="_blank">
                                                        <img class="attach-img" src="@Url.Action("GetFile","HrInquiry")?path=@Uri.EscapeDataString(a.ThumbPath ?? a.FilePath)" alt="@a.FileName">
                                                    </a>
                                                }
                                                else if (a.FileType == "VIDEO")
                                                {
                                                    <video class="attach-video" controls preload="metadata" playsinline controlsList="nodownload" src="@Url.Action("GetFile","HrInquiry")?path=@Uri.EscapeDataString(a.FilePath)"></video>
                                                }
                                                else
                                                {
                                                    <a class="attach-file" href="@Url.Action("GetFile","HrInquiry")?path=@Uri.EscapeDataString(a.FilePath)" target="_blank" download="@a.FileName">
                                                        <span class="material-symbols-rounded" style="font-size:1.1rem">description</span>@a.FileName
                                                    </a>
                                                }
                                            }
                                        </div>
                                    }
                                    @if (msg.Refs.Count > 0)
                                    {
                                        <div class="msg-refs">
                                            @foreach (var r in msg.Refs)
                                            {
                                                string refUrl   = r.RefType == "POLICY"
                                                    ? Url.Action("Detail", "Policy", new { ids = r.RefId })!
                                                    : Url.Action("Detail", "Guide",  new { id  = r.RefId })!;
                                                string refIcon  = r.RefType == "POLICY" ? "gavel" : "play_circle";
                                                string refLabel = r.RefType == "POLICY" ? "Quy định" : "Hướng dẫn";
                                                <a class="msg-ref-card" href="@refUrl" target="_blank">
                                                    <div class="mrc-icon"><span class="material-symbols-rounded" style="font-size:1.1rem">@refIcon</span></div>
                                                    <div class="mrc-info">
                                                        <div class="mrc-label">@refLabel</div>
                                                        <div class="mrc-title">@(r.RefTitle ?? $"#{r.RefId}")</div>
                                                    </div>
                                                    <span class="material-symbols-rounded mrc-arrow">chevron_right</span>
                                                </a>
                                            }
                                        </div>
                                    }
                                }
                                <div class="msg-time">@msg.SentDt.ToString("HH:mm")</div>
                            </div>
                            @if (canRecall)
                            {
                                <button class="msg-recall-btn" onclick="InquiryChat.recallMsg(@msg.Id)" title="Thu hồi"><span class="material-symbols-rounded">undo</span></button>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Input or Closed bar or Locked bar -->
    @if (isClosed)
    {
        <div class="chat-closed-bar">
            <span class="material-symbols-rounded text-secondary" style="font-size:1rem;vertical-align:middle">lock</span>
            Hội thoại đã đóng · @(inq.ClosedDt?.ToString("dd/MM/yyyy HH:mm") ?? "") bởi @(inq.ClosedByName ?? "")
            @if (!string.IsNullOrEmpty(inq.CloseNote)) { <span class="text-muted"> — @inq.CloseNote</span> }
            @if (inq.Rating != null)
            {
                <div class="mt-1 text-warning small fw-bold">@string.Concat(Enumerable.Repeat("★", (int)inq.Rating)) Nhân viên đánh giá @inq.Rating/5 @(inq.RatingNote != null ? $"— {inq.RatingNote}" : "")</div>
            }
        </div>
    }
    else if (isLocked)
    {
        <div class="chat-locked-bar">
            <span class="material-symbols-rounded" style="font-size:.9rem;vertical-align:middle">lock</span>
            Hội thoại đang được phụ trách bởi <strong>@inq.AssignedName</strong> — Bạn không thể gửi tin nhắn.
        </div>
    }
    else
    {
        <div class="chat-input-wrap">
            <div class="file-preview-strip" id="filePreviewStrip"></div>
            <div class="chat-input-row">
                <button class="btn-attach" onclick="document.getElementById('fileInput').click()">
                    <span class="material-symbols-rounded" style="font-size:1.2rem">attach_file</span>
                </button>
                <div class="editor-wrap">
                    <div class="editor-toolbar">
                        <button type="button" id="ed-bold"      class="ed-btn" title="Đậm (Ctrl+B)"><strong>B</strong></button>
                        <button type="button" id="ed-italic"    class="ed-btn" title="Nghiêng (Ctrl+I)"><em>I</em></button>
                        <button type="button" id="ed-underline" class="ed-btn" title="Gạch chân (Ctrl+U)"><u>U</u></button>
                        <button type="button" id="ed-strike"    class="ed-btn" title="Gạch ngang"><s>S</s></button>
                        <div class="ed-sep"></div>
                        <input type="color" id="ed-color" class="ed-color-pick" value="#1e293b" title="Màu chữ">
                        <button type="button" id="ed-highlight" class="ed-btn" title="Highlight"><span class="material-symbols-rounded">format_ink_highlighter</span></button>
                        <div class="ed-sep"></div>
                        <button type="button" id="ed-ul" class="ed-btn" title="Danh sách"><span class="material-symbols-rounded">format_list_bulleted</span></button>
                        <button type="button" id="ed-ol" class="ed-btn" title="Đánh số"><span class="material-symbols-rounded">format_list_numbered</span></button>
                        <div class="ed-sep"></div>
                        <button type="button" id="ed-link"   class="ed-btn" title="Chèn link"><span class="material-symbols-rounded">link</span></button>
                        <button type="button" id="ed-unlink" class="ed-btn" title="Bỏ link"><span class="material-symbols-rounded">link_off</span></button>
                        <button type="button" id="ed-clear-fmt" class="ed-btn" title="Xóa định dạng"><span class="material-symbols-rounded">format_clear</span></button>
                        <div class="ed-sep"></div>
                        <button type="button" class="ed-btn" title="Trích dẫn Quy định / Hướng dẫn" onclick="InquiryChat.openRefPicker()"><span class="material-symbols-rounded">menu_book</span></button>
                    </div>
                    <div id="refChipsStrip" class="ref-chips-strip"></div>
                    <div id="msgEditor"></div>
                    <div class="editor-footer">
                        <span id="charCounter" class="char-counter">0/2000</span>
                    </div>
                </div>
                <button class="btn-send" id="btnSend" onclick="InquiryChat.sendMessage()">
                    <span class="material-symbols-rounded" style="font-size:1.2rem">send</span>
                </button>
            </div>
        </div>
        <input type="file" id="fileInput" style="display:none" multiple accept="image/*,video/*,.pdf,.doc,.docx,.xls,.xlsx" onchange="InquiryChat.handleFiles(this.files)">
    }
</div>

@Html.AntiForgeryToken()

@section Scripts {
<script src="~/js/inquiry-chat.js" asp-append-version="true"></script>
@if (!isClosed && !isLocked)
{
    <script type="module" src="~/js/inquiry-chat-editor.js" asp-append-version="true"></script>
}
<script>
InquiryChat.init({
    inquiryId: @inq.Id,
    inquiryNo: '@inq.InquiryNo',
    mySide: 'HR',
    myEmpCd: '@myEmpCd',
    isClosed: @(isClosed ? "true" : "false"),
    pollIntervalMs: 5000,
    reloadOnLock: true,
    recallableIfUnreadBy: 'EMP',
    defaultTheirsName: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(inq.EmpName ?? "Nhân viên")),
    urls: {
        getMessages: '@Url.Action("GetMessages","HrInquiry")',
        send:        '@Url.Action("Send","HrInquiry")',
        recall:      '@Url.Action("Recall","HrInquiry")',
        close:       '@Url.Action("Close","HrInquiry")',
        getFile:     '@Url.Action("GetFile","HrInquiry")',
        uploadFile:  '@Url.Action("UploadFile","HrInquiry")',
        searchRefs:  '@Url.Action("SearchRefs","HrInquiry")',
        policyDetail:'@Url.Action("Detail","Policy")',
        guideDetail: '@Url.Action("Detail","Guide")'
    }
});
</script>
}
