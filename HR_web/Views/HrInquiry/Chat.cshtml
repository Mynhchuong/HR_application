@using HR_web.Models.Inquiry
@model InquiryMessagesResponse
@{
    ViewData["Title"] = "Chat - HR";
    var inq        = Model.inquiry!;
    bool isClosed  = inq.Status == "CLOSED";
    string myEmpCd = ViewBag.CurrentEmpCd as string ?? "";
    string myName  = ViewBag.CurrentName  as string ?? "";
    bool isMyConv  = inq.AssignedTo == myEmpCd;
    bool isLocked  = !string.IsNullOrEmpty(inq.AssignedTo) && !isMyConv;
    // HR can close only if assigned to me and not closed
    bool canClose  = !isClosed && isMyConv;
}

<style>
html, body { height: 100%; }
.chat-wrap { display: flex; flex-direction: column; height: calc(100vh - 74px); max-width: 760px; margin: 0 auto; }
@@media (max-width: 991.98px) { .chat-wrap { height: calc(100vh - 56px - 68px); } }

.chat-header {
    padding: .75rem 1rem; background: white;
    border-bottom: 1px solid #f1f5f9; flex-shrink: 0;
    display: flex; align-items: center; gap: .75rem;
}
.chat-header-back { color: #64748b; display: flex; align-items: center; text-decoration: none; }
.chat-header-back:hover { color: #3b82f6; }
.chat-header-info { flex: 1; min-width: 0; }
.chat-header-no   { font-size: .78rem; font-weight: 700; color: #94a3b8; font-family: monospace; }
.chat-header-subj { font-size: .92rem; font-weight: 800; color: #1e293b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.chat-header-meta { display: flex; align-items: center; gap: .4rem; margin-top: .1rem; flex-wrap: wrap; }
.status-pill { font-size: .65rem; font-weight: 800; padding: 1px 8px; border-radius: 20px; text-transform: uppercase; }
.status-pill.open   { background: #dcfce7; color: #166534; }
.status-pill.closed { background: #f1f5f9; color: #64748b; }
.anon-pill { font-size: .65rem; font-weight: 700; background: #f1f5f9; color: #64748b; padding: 1px 8px; border-radius: 20px; }

.lock-banner {
    background: #fef3c7; border-bottom: 1px solid #fde68a;
    padding: .5rem 1rem; font-size: .82rem; color: #92400e;
    display: flex; align-items: center; gap: .5rem; flex-shrink: 0;
}
.my-banner {
    background: #eff6ff; border-bottom: 1px solid #bfdbfe;
    padding: .5rem 1rem; font-size: .8rem; color: #1d4ed8; flex-shrink: 0;
    display: flex; align-items: center; gap: .5rem;
}

.chat-msgs {
    flex: 1; overflow-y: auto; padding: 1rem;
    display: flex; flex-direction: column; gap: .6rem; background: #f8fafc;
}

.msg-row { display: flex; align-items: flex-end; gap: .5rem; }
.msg-row.emp { flex-direction: row; }
.msg-row.hr  { flex-direction: row-reverse; }
.msg-row.sys { justify-content: center; }

.msg-avatar {
    width: 30px; height: 30px; border-radius: 50%; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    font-size: .75rem; font-weight: 800; color: white;
}
.msg-avatar.av-hr  { background: linear-gradient(135deg, #3b82f6, #1d4ed8); }
.msg-avatar.av-emp { background: linear-gradient(135deg, #64748b, #334155); }

.msg-bubble {
    max-width: 70%; padding: .6rem .9rem; border-radius: 16px;
    font-size: .88rem; line-height: 1.5; word-break: break-word;
}
.msg-row.emp .msg-bubble { background: white; color: #1e293b; border-bottom-left-radius: 4px; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
.msg-row.hr  .msg-bubble { background: linear-gradient(135deg, #2563eb, #3b82f6); color: white; border-bottom-right-radius: 4px; }
.msg-row.sys .msg-bubble { background: transparent; color: #64748b; font-size: .78rem; font-style: italic; }
.msg-bubble.deleted { opacity: .5; font-style: italic; }
.msg-time { font-size: .68rem; margin-top: .3rem; opacity: .7; }
.msg-row.emp .msg-time { color: #94a3b8; }
.msg-row.hr  .msg-time { color: rgba(255,255,255,.8); text-align: right; }

.msg-recall-btn { background: none; border: none; padding: 0; cursor: pointer; font-size: .72rem; color: #ef4444; margin-top: .2rem; display: none; }
.msg-row.hr:hover .msg-recall-btn { display: block; }

.msg-attachments { margin-top: .4rem; display: flex; flex-wrap: wrap; gap: .4rem; }
.attach-img { width: 100px; height: 100px; border-radius: 8px; object-fit: cover; cursor: pointer; }
.attach-file { display: flex; align-items: center; gap: .4rem; border-radius: 8px; padding: .3rem .6rem; font-size: .78rem; text-decoration: none; }
.msg-row.emp .attach-file { background: #f1f5f9; color: #1e293b; }
.msg-row.hr  .attach-file { background: rgba(255,255,255,.2); color: white; }

.chat-input-wrap { background: white; border-top: 1px solid #f1f5f9; padding: .75rem 1rem; flex-shrink: 0; }
.file-preview-strip { display: flex; flex-wrap: wrap; gap: .4rem; margin-bottom: .5rem; }
.file-chip { display: flex; align-items: center; gap: .3rem; background: #f1f5f9; border-radius: 8px; padding: .25rem .5rem; font-size: .78rem; }
.file-chip img { width: 28px; height: 28px; border-radius: 4px; object-fit: cover; }
.fc-remove { cursor: pointer; color: #ef4444; margin-left: .2rem; }
.chat-input-row { display: flex; align-items: flex-end; gap: .5rem; }
.btn-attach { width: 40px; height: 40px; border-radius: 12px; border: 1.5px solid #e2e8f0; background: white; color: #64748b; cursor: pointer; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
.btn-attach:hover { border-color: #3b82f6; color: #3b82f6; }
#msgInput { flex: 1; border: 1.5px solid #e2e8f0; border-radius: 12px; padding: .6rem .85rem; font-size: .9rem; resize: none; outline: none; font-family: inherit; max-height: 120px; overflow-y: auto; }
#msgInput:focus { border-color: #3b82f6; }
.btn-send { width: 40px; height: 40px; border-radius: 12px; border: none; background: linear-gradient(135deg, #2563eb, #3b82f6); color: white; cursor: pointer; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
.btn-send:hover { opacity: .88; }
.btn-send:disabled { opacity: .4; cursor: not-allowed; }

.chat-closed-bar { background: #f8fafc; border-top: 1px solid #f1f5f9; padding: .75rem 1rem; text-align: center; flex-shrink: 0; }
.chat-locked-bar { background: #fef3c7; border-top: 1px solid #fde68a; padding: .65rem 1rem; text-align: center; font-size: .82rem; color: #92400e; flex-shrink: 0; }
</style>

<div class="chat-wrap">
    <!-- Header -->
    <div class="chat-header">
        <a class="chat-header-back" href="@Url.Action("Index","HrInquiry")">
            <span class="material-symbols-rounded">arrow_back</span>
        </a>
        <div class="chat-header-info">
            <div class="chat-header-no">@inq.InquiryNo</div>
            <div class="chat-header-subj">@(inq.Subject ?? inq.TopicName ?? "Hội thoại")</div>
            <div class="chat-header-meta">
                <span class="status-pill @(isClosed?"closed":"open")">@(isClosed?"Đã đóng":"Đang mở")</span>
                @if (inq.ChatType == "ANON") { <span class="anon-pill"><span class="material-symbols-rounded" style="font-size:.7rem;vertical-align:middle">visibility_off</span> Ẩn danh</span> }
                @if (inq.ChatType == "DIRECT" && !string.IsNullOrEmpty(inq.EmpName)) { <span style="font-size:.72rem;color:#64748b" class="vni-font">@inq.EmpName</span> }
            </div>
        </div>
        @if (canClose)
        {
            <button class="btn btn-sm btn-outline-danger" style="border-radius:10px;font-size:.78rem;font-weight:700" onclick="confirmClose()">
                <span class="material-symbols-rounded me-1" style="font-size:.85rem;vertical-align:middle">close</span>Đóng
            </button>
        }
    </div>

    <!-- Lock/assigned banner -->
    @if (isLocked)
    {
        <div class="lock-banner">
            <span class="material-symbols-rounded">lock</span>
            Đang phụ trách bởi <strong class="ms-1 vni-font">@inq.AssignedName</strong> — Bạn chỉ có thể đọc.
        </div>
    }
    else if (isMyConv)
    {
        <div class="my-banner">
            <span class="material-symbols-rounded">assignment_ind</span>
            Bạn đang phụ trách hội thoại này.
        </div>
    }
    else if (!isClosed)
    {
        <div class="my-banner" style="background:#f0fdf4;border-color:#bbf7d0;color:#166534">
            <span class="material-symbols-rounded">info</span>
            Hội thoại chưa có người phụ trách. Gửi phản hồi đầu tiên để nhận hội thoại.
        </div>
    }

    <!-- Messages -->
    <div class="chat-msgs" id="chatMsgs">
        @foreach (var msg in Model.messages)
        {
            bool isMine = msg.SenderType == "HR" && msg.SenderCd == myEmpCd;
            string rowCls = msg.SenderType == "EMP" ? "emp" : msg.SenderType == "SYS" ? "sys" : "hr";
            string avCls  = msg.SenderType == "EMP" ? "av-emp" : "av-hr";
            string initial = msg.SenderName != null ? msg.SenderName[0].ToString().ToUpper() : (msg.SenderType == "EMP" ? "E" : "H");
            <div class="msg-row @rowCls" data-msg-id="@msg.Id" data-sender-cd="@msg.SenderCd" data-sender-type="@msg.SenderType">
                @if (msg.SenderType != "SYS") { <div class="msg-avatar @avCls">@initial</div> }
                <div>
                    @if (msg.SenderType != "SYS")
                    {
                        <div style="font-size:.72rem;color:#94a3b8;margin-bottom:.1rem;@(msg.SenderType == "HR" ? "text-align:right;padding-right:.5rem" : "padding-left:.5rem")" class="vni-font">
                            @(msg.SenderName ?? (msg.SenderType == "EMP" ? (inq.EmpName ?? "Nhân viên") : "HR"))
                        </div>
                    }
                    <div class="msg-bubble @(msg.IsDeleted ? "deleted" : "")">
                        @if (msg.IsDeleted)
                        {
                            <span>Tin nhắn đã thu hồi</span>
                        }
                        else
                        {
                            @if (!string.IsNullOrEmpty(msg.Content)) { <span>@msg.Content</span> }
                            @if (msg.Attachments.Count > 0)
                            {
                                <div class="msg-attachments">
                                    @foreach (var a in msg.Attachments)
                                    {
                                        if (a.FileType == "IMAGE")
                                        {
                                            <a href="@Url.Action("GetFile","HrInquiry")?path=@Uri.EscapeDataString(a.FilePath)" target="_blank">
                                                <img class="attach-img" src="@Url.Action("GetFile","HrInquiry")?path=@Uri.EscapeDataString(a.ThumbPath ?? a.FilePath)" alt="@a.FileName">
                                            </a>
                                        }
                                        else
                                        {
                                            <a class="attach-file" href="@Url.Action("GetFile","HrInquiry")?path=@Uri.EscapeDataString(a.FilePath)" target="_blank" download="@a.FileName">
                                                <span class="material-symbols-rounded" style="font-size:1.1rem">description</span>@a.FileName
                                            </a>
                                        }
                                    }
                                </div>
                            }
                        }
                        <div class="msg-time">@msg.SentDt.ToString("HH:mm") · @(msg.SenderName ?? "")</div>
                    </div>
                    @if (isMine && !msg.IsDeleted && !msg.IsReadEmp)
                    {
                        <button class="msg-recall-btn" onclick="recallMsg(@msg.Id)">Thu hồi</button>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Input or Closed bar or Locked bar -->
    @if (isClosed)
    {
        <div class="chat-closed-bar">
            <span class="material-symbols-rounded text-secondary" style="font-size:1rem;vertical-align:middle">lock</span>
            Hội thoại đã đóng · @(inq.ClosedDt?.ToString("dd/MM/yyyy HH:mm") ?? "") bởi @(inq.ClosedByName ?? "")
            @if (!string.IsNullOrEmpty(inq.CloseNote)) { <span class="text-muted"> — @inq.CloseNote</span> }
            @if (inq.Rating != null)
            {
                <div class="mt-1 text-warning small fw-bold">@string.Concat(Enumerable.Repeat("★", (int)inq.Rating)) Nhân viên đánh giá @inq.Rating/5 @(inq.RatingNote != null ? $"— {inq.RatingNote}" : "")</div>
            }
        </div>
    }
    else if (isLocked)
    {
        <div class="chat-locked-bar">
            <span class="material-symbols-rounded" style="font-size:.9rem;vertical-align:middle">lock</span>
            Hội thoại đang được phụ trách bởi <strong>@inq.AssignedName</strong> — Bạn không thể gửi tin nhắn.
        </div>
    }
    else
    {
        <div class="chat-input-wrap">
            <div class="file-preview-strip" id="filePreviewStrip"></div>
            <div class="chat-input-row">
                <button class="btn-attach" onclick="document.getElementById('fileInput').click()">
                    <span class="material-symbols-rounded" style="font-size:1.2rem">attach_file</span>
                </button>
                <textarea id="msgInput" rows="1" placeholder="Nhập tin nhắn..." maxlength="4000"
                          oninput="autoResize(this)" onkeydown="handleKeyDown(event)"></textarea>
                <button class="btn-send" id="btnSend" onclick="sendMessage()">
                    <span class="material-symbols-rounded" style="font-size:1.2rem">send</span>
                </button>
            </div>
        </div>
        <input type="file" id="fileInput" style="display:none" multiple accept=".jpg,.jpeg,.png,.gif,.webp,.pdf,.doc,.docx,.xls,.xlsx" onchange="handleFiles(this.files)">
    }
</div>

@Html.AntiForgeryToken()

@section Scripts {
<script>
const TOKEN      = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
const INQUIRY_ID = @inq.Id;
const INQUIRY_NO = '@inq.InquiryNo';
let lastMsgId    = @(Model.messages.Count > 0 ? Model.messages.Max(m => m.Id) : 0);
let uploadedFiles = [];

const chatMsgs = document.getElementById('chatMsgs');
function scrollBottom(force) {
    const atBottom = chatMsgs.scrollHeight - chatMsgs.scrollTop - chatMsgs.clientHeight < 100;
    if (force || atBottom) chatMsgs.scrollTop = chatMsgs.scrollHeight;
}
scrollBottom(true);

// Poll for new messages every 30s
@if (!isClosed) {
<text>setInterval(() => refreshMessages(), 30000);</text>
}

function esc(s) { return (s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

function appendMsg(m) {
    if (document.querySelector(`[data-msg-id="${m.id}"]`)) return;
    if (m.id > lastMsgId) lastMsgId = m.id;

    const myEmpCd = '@myEmpCd';
    const isMine  = m.senderType === 'HR' && m.senderCd === myEmpCd;
    const cls     = m.senderType === 'EMP' ? 'emp' : m.senderType === 'SYS' ? 'sys' : 'hr';
    const avClass = m.senderType === 'EMP' ? 'av-emp' : 'av-hr';
    const initial = m.senderName ? m.senderName[0].toUpperCase() : (m.senderType === 'EMP' ? 'E' : 'H');
    const t = new Date(m.sentDt).toLocaleTimeString('vi-VN',{hour:'2-digit',minute:'2-digit',hour12:false});

    let attachHtml = '';
    if (m.attachments?.length > 0) {
        attachHtml = '<div class="msg-attachments">' + m.attachments.map(a => {
            if (a.fileType === 'IMAGE') {
                const t2 = `@Url.Action("GetFile","HrInquiry")?path=${encodeURIComponent(a.thumbPath||a.filePath)}`;
                const f2 = `@Url.Action("GetFile","HrInquiry")?path=${encodeURIComponent(a.filePath)}`;
                return `<a href="${f2}" target="_blank"><img class="attach-img" src="${t2}" alt="${esc(a.fileName)}"></a>`;
            }
            const f2 = `@Url.Action("GetFile","HrInquiry")?path=${encodeURIComponent(a.filePath)}`;
            return `<a class="attach-file" href="${f2}" target="_blank" download="${esc(a.fileName)}"><span class="material-symbols-rounded" style="font-size:1.1rem">description</span>${esc(a.fileName)}</a>`;
        }).join('') + '</div>';
    }

    const content = m.isDeleted ? '<span>Tin nhắn đã thu hồi</span>'
        : (m.content ? `<span>${esc(m.content)}</span>` : '') + attachHtml;
    const nameAlign = cls === 'hr' ? 'text-align:right;padding-right:.5rem' : 'padding-left:.5rem';
    const nameRow   = cls !== 'sys' ? `<div style="font-size:.72rem;color:#94a3b8;margin-bottom:.1rem;${nameAlign}" class="vni-font">${esc(m.senderName||'')}</div>` : '';
    const recallBtn = isMine && !m.isDeleted && !m.isReadEmp ? `<button class="msg-recall-btn" onclick="recallMsg(${m.id})">Thu hồi</button>` : '';
    const avatar    = cls !== 'sys' ? `<div class="msg-avatar ${avClass}">${initial}</div>` : '';

    const div = document.createElement('div');
    div.className = `msg-row ${cls}`;
    div.dataset.msgId = m.id; div.dataset.senderCd = m.senderCd||''; div.dataset.senderType = m.senderType;
    div.innerHTML = `${avatar}<div>${nameRow}<div class="msg-bubble ${m.isDeleted?'deleted':''}">${content}<div class="msg-time">${t}</div></div>${recallBtn}</div>`;
    chatMsgs.appendChild(div);
}

function autoResize(el) { el.style.height='auto'; el.style.height=Math.min(el.scrollHeight,120)+'px'; }
function handleKeyDown(e) { if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();sendMessage();} }

async function handleFiles(fileList) {
    if (uploadedFiles.length + fileList.length > 5) { showToast('Tối đa 5 file','error'); return; }
    for (const file of fileList) {
        if (file.size > 10*1024*1024) { showToast(`"${file.name}" vượt 10MB`,'error'); continue; }
        const fd = new FormData(); fd.append('file', file);
        try {
            const res = await fetch('@Url.Action("UploadFile","HrInquiry")', {method:'POST',headers:{'RequestVerificationToken':TOKEN},body:fd});
            const d   = await res.json();
            if (!d.success) { showToast(d.message||'Upload thất bại','error'); continue; }
            uploadedFiles.push(d); renderFilePreviews();
        } catch { showToast('Lỗi upload','error'); }
    }
    document.getElementById('fileInput').value = '';
}

function renderFilePreviews() {
    const strip = document.getElementById('filePreviewStrip');
    if (!strip) return;
    strip.innerHTML = uploadedFiles.map((f,i) => {
        const thumb = f.thumbPath
            ? `<img src="@Url.Action("GetFile","HrInquiry")?path=${encodeURIComponent(f.thumbPath)}" alt="">`
            : `<span class="material-symbols-rounded" style="font-size:1.2rem;color:#64748b">description</span>`;
        return `<div class="file-chip">${thumb}<span>${f.fileName.length>15?f.fileName.substr(0,12)+'...':f.fileName}</span><span class="fc-remove" onclick="removeFile(${i})">✕</span></div>`;
    }).join('');
}

function removeFile(i) { uploadedFiles.splice(i,1); renderFilePreviews(); }

async function sendMessage() {
    const content = (document.getElementById('msgInput')?.value??'').trim();
    if (!content && uploadedFiles.length === 0) return;
    const btn = document.getElementById('btnSend');
    if (btn) btn.disabled = true;
    const body = { inquiryId:INQUIRY_ID, inquiryNo:INQUIRY_NO, content:content||null, files:uploadedFiles.length>0?uploadedFiles:null };
    try {
        const res  = await fetch('@Url.Action("Send","HrInquiry")', {method:'POST',headers:{'Content-Type':'application/json','RequestVerificationToken':TOKEN},body:JSON.stringify(body)});
        const data = await res.json();
        if (!data.success) { showToast(data.message||'Gửi thất bại','error'); }
        else {
            document.getElementById('msgInput').value=''; uploadedFiles=[]; renderFilePreviews(); autoResize(document.getElementById('msgInput'));
            await refreshMessages();
            // Reload to update lock banner if this send just claimed the conversation
            if (data.justLocked) location.reload();
        }
    } catch { showToast('Lỗi kết nối','error'); }
    finally { if (btn) btn.disabled=false; }
}

async function refreshMessages() {
    try {
        const res  = await fetch(`@Url.Action("GetMessages","HrInquiry")?id=${INQUIRY_ID}&afterMsgId=${lastMsgId}`);
        const data = await res.json();
        if (data.success && data.messages?.length>0) { data.messages.forEach(m=>appendMsg(m)); scrollBottom(true); }
    } catch {}
}

async function recallMsg(msgId) {
    if (!confirm('Thu hồi tin nhắn này?')) return;
    const res  = await fetch('@Url.Action("Recall","HrInquiry")', {method:'POST',headers:{'Content-Type':'application/json','RequestVerificationToken':TOKEN},body:JSON.stringify({id:msgId})});
    const data = await res.json();
    if (!data.success) { showToast(data.message||'Không thể thu hồi','error'); return; }
    const row = document.querySelector(`[data-msg-id="${msgId}"]`);
    if (row) {
        const bubble = row.querySelector('.msg-bubble');
        if (bubble) { bubble.innerHTML='<span>Tin nhắn đã thu hồi</span><div class="msg-time">'+(bubble.querySelector('.msg-time')?.innerHTML??'')+`</div>`; bubble.classList.add('deleted'); }
        const btn = row.querySelector('.msg-recall-btn'); if (btn) btn.style.display='none';
    }
}

function confirmClose() {
    showConfirm('Đóng hội thoại này?', async () => {
        const body = { inquiryId:INQUIRY_ID, closeNote:null };
        const res  = await fetch('@Url.Action("Close","HrInquiry")', {method:'POST',headers:{'Content-Type':'application/json','RequestVerificationToken':TOKEN},body:JSON.stringify(body)});
        const data = await res.json();
        if (!data.success) { showToast(data.message||'Không thể đóng','error'); return; }
        showToast('Đã đóng hội thoại','success');
        setTimeout(()=>location.reload(),800);
    }, {title:'Đóng hội thoại',okText:'Đóng',okClass:'btn-warning',icon:'close',iconColor:'#d97706',iconBg:'#fef3c7'});
}
</script>
}
