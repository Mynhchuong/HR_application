@using HR_web.Models.Inquiry
@using HR_web.Helpers
@model InquiryMessagesResponse
@{
    ViewData["Title"] = "Chat - HR";
    var inq        = Model.inquiry!;
    bool isClosed  = inq.Status == "CLOSED";
    string myEmpCd = ViewBag.CurrentEmpCd as string ?? "";
    bool isMyConv  = inq.AssignedTo == myEmpCd;
    bool isLocked  = !string.IsNullOrEmpty(inq.AssignedTo) && !isMyConv;
    bool canClose  = !isClosed && isMyConv;
    // "AI SAMHO - CSR" (HR_AI_CHAT) dùng CHUNG trang chat này (yêu cầu 2026-10-01) nhưng không có
    // đính kèm file/trích dẫn thật (bảng gốc không lưu) — ẩn 2 nút đó, và Send/Close/GetMessages
    // phải trỏ qua endpoint Ai* riêng (xem cuối trang) thay vì endpoint Inquiry thường.
    bool isAiSource = ViewBag.IsAiSource is true;
    bool canClassify = ViewBag.CanClassify is true && !isAiSource;
    // GA không gửi thẳng cho công nhân mà soạn BẢN NHÁP chờ CSR duyệt (2026-11-06; HR được gửi thẳng từ 2026-11-12) → luật "đang có người phụ trách"
    // chỉ chặn ô soạn của CSR / chat AI; HR/GA vẫn soạn được (CSR duyệt mới là cổng gửi thật).
    bool isCsrView   = ViewBag.IsCsr is true;
    // CSR là cổng duyệt nên KHÔNG bị khóa ô soạn khi chat đang do người soạn (HR/GA) phụ trách: CSR vẫn phải sửa được bản nháp.
    // Gửi tin trực tiếp (không qua bản nháp) khi chat đang do người khác giữ vẫn bị API từ chối như cũ.
    bool lockedForMe = isLocked && isAiSource;
    bool canSendDirect = ViewBag.CanSendDirect is true;   // CSR + HR gửi thẳng; GA soạn nháp
    bool draftMode   = !canSendDirect && !isAiSource;

    string Cls(string st)    => st == "SYS" ? "sys" : (st == "HR" ? "mine" : "theirs");
    string AvCls(string st)  => st == "HR" ? "av-mine" : "av-theirs";
}

<link href="~/css/inquiry-chat.css" rel="stylesheet" asp-append-version="true" />
<style>
    .chat-wrap { --chat-accent: #2563eb; --chat-accent-2: #3b82f6; }
    /* Bản nháp trả lời chờ CSR duyệt */
    .dr-panel { border-top: 1px solid #e2e8f0; background: #fffbeb; padding: .6rem .9rem; max-height: 38vh; overflow: auto; }
    .dr-title { font-weight: 800; font-size: .8rem; color: #92400e; display: flex; align-items: center; gap: .3rem; margin-bottom: .4rem; }
    .dr-title .material-symbols-rounded { font-size: 1.05rem; }
    .dr-card { background: #fff; border: 1px solid #fde68a; border-radius: 12px; padding: .6rem .75rem; margin-bottom: .5rem; }
    .dr-card.returned { border-color: #fecaca; background: #fff7f7; }
    .dr-head { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; font-size: .75rem; color: #64748b; margin-bottom: .3rem; }
    .dr-by b { color: #1e293b; }
    .dr-time { margin-left: auto; }
    .dr-badge { font-weight: 800; border-radius: 999px; padding: .05rem .55rem; font-size: .68rem; }
    .dr-badge.p { background: #fef3c7; color: #92400e; }
    .dr-badge.r { background: #fee2e2; color: #b91c1c; }
    .dr-body { font-size: .88rem; color: #1e293b; word-break: break-word; }
    .dr-chips { display: flex; flex-wrap: wrap; gap: .3rem; margin-top: .35rem; }
    .dr-chip { display: inline-flex; align-items: center; gap: .2rem; background: #f1f5f9; border-radius: 8px; padding: .1rem .5rem; font-size: .72rem; color: #475569; }
    .dr-chip .material-symbols-rounded { font-size: .85rem; }
    .dr-note { margin-top: .4rem; font-size: .8rem; color: #b91c1c; background: #fef2f2; border-radius: 8px; padding: .35rem .55rem; }
    .dr-actions { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .5rem; }
    .dr-btn { border: 1px solid #cbd5e1; background: #fff; color: #334155; border-radius: 9px; padding: .25rem .7rem; font-size: .76rem; font-weight: 700; cursor: pointer; }
    .dr-btn.ok { background: #16a34a; border-color: #16a34a; color: #fff; }
    .dr-btn.warn { color: #b91c1c; border-color: #fecaca; }
    .dr-return { margin-top: .45rem; display: flex; flex-wrap: wrap; gap: .4rem; align-items: flex-start; }
    .dr-return textarea { flex: 1 1 100%; border: 1.5px solid #e2e8f0; border-radius: 10px; padding: .4rem .6rem; font-size: .85rem; }
    .dr-edit-banner { background: #eff6ff; border-top: 1px solid #bfdbfe; color: #1d4ed8; font-size: .8rem; padding: .4rem .9rem; display: flex; align-items: center; gap: .4rem; flex-wrap: wrap; }
    .dr-edit-banner .material-symbols-rounded { font-size: 1rem; }
    .dr-edit-banner button { margin-left: auto; border: 0; background: #dbeafe; color: #1d4ed8; border-radius: 8px; padding: .15rem .6rem; font-weight: 700; font-size: .75rem; }
</style>

<div class="chat-wrap">
    <!-- Header -->
    <div class="chat-header">
        <a class="chat-header-back" href="@Url.Action("Index","HrInquiry")">
            <span class="material-symbols-rounded">arrow_back</span>
        </a>
        <div class="chat-header-info">
            <div class="chat-header-no">@inq.InquiryNo</div>
            <div class="chat-header-subj">@(inq.Subject ?? inq.TopicName ?? "Hội thoại")</div>
            <div class="chat-header-meta">
                <span class="status-pill @(isClosed?"closed":"open")">@(isClosed?"Đã đóng":"Đang mở")</span>
                @if (inq.ChatType == "ANON") { <span class="anon-pill"><span class="material-symbols-rounded" style="font-size:.7rem;vertical-align:middle">visibility_off</span> Ẩn danh</span> }
                @if ((inq.ChatType == "DIRECT" || inq.ChatType == "AI") && !string.IsNullOrEmpty(inq.EmpName))
                {
                    var deptMeta = string.Join(" / ", new[] { inq.DeptName, inq.LineName, inq.WorkName }.Where(s => !string.IsNullOrEmpty(s)));
                    <span style="font-size:.72rem;color:#64748b" class="vni-font">@inq.EmpName</span>
                    @if (!string.IsNullOrEmpty(inq.EmpCd)) { <span style="font-size:.72rem;color:#64748b">#@inq.EmpCd</span> }
                    @if (!string.IsNullOrEmpty(deptMeta)) { <span style="font-size:.72rem;color:#64748b">— @deptMeta</span> }
                }
            </div>
        </div>
        @if (canClassify)
        {
            <button type="button" class="btn btn-sm btn-outline-secondary" style="border-radius:10px;font-size:.78rem;font-weight:700" onclick="CaseClassify.open()" title="Phân loại case">
                <span class="material-symbols-rounded me-1" style="font-size:.85rem;vertical-align:middle">tune</span>Phân loại
            </button>
        }
        @if (canClose)
        {
            <button class="btn btn-sm btn-outline-danger" style="border-radius:10px;font-size:.78rem;font-weight:700" onclick="InquiryChat.confirmClose()">
                <span class="material-symbols-rounded me-1" style="font-size:.85rem;vertical-align:middle">close</span>Đóng hội thoại
            </button>
        }
    </div>

    <!-- Lock/assigned banner -->
    @if (isLocked)
    {
        <div class="lock-banner">
            <span class="material-symbols-rounded">lock</span>
            Đang phụ trách bởi <strong class="ms-1 vni-font">@inq.AssignedName</strong> —
            @if (isAiSource) { <text>Bạn chỉ có thể đọc.</text> }
            else if (canSendDirect && !isCsrView) { <text>nhắn trực tiếp cần người phụ trách nhả quyền.</text> }
            else if (isCsrView) { <text>bạn vẫn duyệt/sửa được bản nháp; nhắn trực tiếp cần người phụ trách nhả quyền.</text> }
            else { <text>tin bạn soạn sẽ thành bản nháp chờ CSR duyệt.</text> }
        </div>
    }
    else if (isMyConv)
    {
        <div class="my-banner">
            <span class="material-symbols-rounded">assignment_ind</span>
            Bạn đang phụ trách hội thoại này.
        </div>
    }
    else if (!isClosed)
    {
        <div class="my-banner" style="background:#f0fdf4;border-color:#bbf7d0;color:#166534">
            <span class="material-symbols-rounded">info</span>
            Hội thoại chưa có người phụ trách. Gửi phản hồi đầu tiên để nhận hội thoại.
        </div>
    }

    <!-- Messages -->
    <div class="chat-msgs" id="chatMsgs">
        @foreach (var msg in Model.messages)
        {
            bool isMine = msg.SenderType == "HR" && msg.SenderCd == myEmpCd;
            string cls = Cls(msg.SenderType);
            string displayName = msg.SenderName ?? (msg.SenderType == "EMP" ? (inq.EmpName ?? "Nhân viên") : "HR");
            bool canRecall = isMine && !msg.IsDeleted && !msg.IsReadEmp;
            <div class="msg-row @cls" data-msg-id="@msg.Id" data-sender-cd="@msg.SenderCd" data-sender-type="@msg.SenderType"
                 data-is-mine="@(isMine ? "1" : "0")"
                 data-is-read-hr="@(msg.IsReadHr ? "1" : "0")"
                 data-is-read-emp="@(msg.IsReadEmp ? "1" : "0")">
                @if (msg.SenderType != "SYS") { <div class="msg-avatar @AvCls(msg.SenderType)">@(!string.IsNullOrEmpty(msg.SenderName) ? msg.SenderName[0].ToString().ToUpper() : (msg.SenderType == "EMP" ? "E" : "H"))</div> }
                <div>
                    @if (msg.SenderType != "SYS")
                    {
                        <div class="msg-sender-name vni-font">@displayName</div>
                    }
                    @if (msg.SenderType == "SYS")
                    {
                        <div class="msg-bubble @(msg.IsDeleted ? "deleted" : "")">
                            @if (msg.IsDeleted) { <span>Tin nhắn đã thu hồi</span> }
                            else if (!string.IsNullOrEmpty(msg.Content)) { <div class="msg-content">@Html.Raw(ChatHtmlHelper.Sanitize(msg.Content))</div> }
                            <div class="msg-time">@msg.SentDt.ToString("HH:mm")</div>
                        </div>
                    }
                    else
                    {
                        <div class="msg-bubble-row">
                            <div class="msg-bubble @(msg.IsDeleted ? "deleted" : "")">
                                @if (msg.IsDeleted)
                                {
                                    <span>Tin nhắn đã thu hồi</span>
                                }
                                else
                                {
                                    @if (!string.IsNullOrEmpty(msg.Content)) { <div class="msg-content">@Html.Raw(ChatHtmlHelper.Sanitize(msg.Content))</div> }
                                    @if (msg.Attachments.Count > 0)
                                    {
                                        <div class="msg-attachments">
                                            @foreach (var a in msg.Attachments)
                                            {
                                                if (a.FileType == "IMAGE")
                                                {
                                                    <a class="no-loading" href="@Url.Action("GetFile","HrInquiry")?path=@Uri.EscapeDataString(a.FilePath)">
                                                        <img class="attach-img" src="@Url.Action("GetFile","HrInquiry")?path=@Uri.EscapeDataString(a.ThumbPath ?? a.FilePath)" alt="@a.FileName">
                                                    </a>
                                                }
                                                else if (a.FileType == "VIDEO")
                                                {
                                                    <div class="attach-video-thumb" data-video-url="@Url.Action("GetFile","HrInquiry")?path=@Uri.EscapeDataString(a.FilePath)" role="button" aria-label="Xem video">
                                                        <span class="material-symbols-rounded">play_arrow</span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <a class="attach-file" href="@Url.Action("GetFile","HrInquiry")?path=@Uri.EscapeDataString(a.FilePath)" download="@a.FileName">
                                                        <span class="material-symbols-rounded" style="font-size:1.1rem">description</span>@a.FileName
                                                    </a>
                                                }
                                            }
                                        </div>
                                    }
                                    @if (msg.Refs.Count > 0)
                                    {
                                        <div class="msg-refs">
                                            @foreach (var r in msg.Refs)
                                            {
                                                var refUrl = ChatHtmlHelper.RefTypeUrl(Url, r.RefType, r.RefId);
                                                var (refIcon, refLabel) = ChatHtmlHelper.RefTypeMeta(r.RefType);
                                                <a class="msg-ref-card" href="@refUrl">
                                                    <div class="mrc-icon"><span class="material-symbols-rounded" style="font-size:1.1rem">@refIcon</span></div>
                                                    <div class="mrc-info">
                                                        <div class="mrc-label">@refLabel</div>
                                                        <div class="mrc-title">@(r.RefTitle ?? $"#{r.RefId}")</div>
                                                    </div>
                                                    <span class="material-symbols-rounded mrc-arrow">chevron_right</span>
                                                </a>
                                            }
                                        </div>
                                    }
                                }
                                <div class="msg-time">@msg.SentDt.ToString("HH:mm")</div>
                            </div>
                            @if (canRecall)
                            {
                                <button class="msg-recall-btn" onclick="InquiryChat.recallMsg(@msg.Id)" title="Thu hồi"><span class="material-symbols-rounded">undo</span></button>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Bản nháp trả lời HR/GA chờ CSR duyệt (luôn hiện khi hội thoại còn mở, kể cả CSR bị khóa ô soạn) -->
    @if (!isClosed && !isAiSource)
    {
        <div id="draftPanel" class="dr-panel" style="display:none"></div>
        <div id="draftEditBanner" class="dr-edit-banner" style="display:none">
            <span class="material-symbols-rounded">edit</span>
            Đang sửa bản nháp của <b class="who vni-font"></b> — bấm <b>Gửi</b> để duyệt &amp; gửi bản đã sửa cho công nhân.
            <button type="button" onclick="InquiryDrafts.cancelEdit()">Hủy sửa</button>
        </div>
    }

    <!-- Input or Closed bar or Locked bar -->
    @if (isClosed)
    {
        <div class="chat-closed-bar">
            <span class="material-symbols-rounded text-secondary" style="font-size:1rem;vertical-align:middle">lock</span>
            Hội thoại đã đóng · @(inq.ClosedDt?.ToString("dd/MM/yyyy HH:mm") ?? "") bởi @(inq.ClosedByName ?? "")
            @if (!string.IsNullOrEmpty(inq.CloseNote)) { <span class="text-muted"> — @inq.CloseNote</span> }
            @if (inq.Rating != null)
            {
                <div class="mt-1 small fw-bold" style="color:#d97706">@string.Concat(Enumerable.Repeat("★", (int)inq.Rating)) Nhân viên đánh giá @inq.Rating/5 · <span style="color:@InquiryRatingHelper.Color(inq.Rating)">@InquiryRatingHelper.Label(inq.Rating)</span> @(inq.RatingNote != null ? $"— {inq.RatingNote}" : "")</div>
            }
        </div>
    }
    else if (lockedForMe)
    {
        <div class="chat-locked-bar">
            <span class="material-symbols-rounded" style="font-size:.9rem;vertical-align:middle">lock</span>
            Hội thoại đang được phụ trách bởi <strong>@inq.AssignedName</strong> — Bạn không thể gửi tin nhắn.
        </div>
    }
    else
    {
        <div class="chat-input-wrap">
            <div class="file-preview-strip" id="filePreviewStrip"></div>
            <div class="chat-input-row">
                @if (!isAiSource)
                {
                    <button class="btn-attach" onclick="document.getElementById('fileInput').click()">
                        <span class="material-symbols-rounded" style="font-size:1.2rem">attach_file</span>
                    </button>
                }
                <div class="editor-wrap">
                    <div class="editor-toolbar">
                        <button type="button" id="ed-bold"      class="ed-btn" title="Đậm (Ctrl+B)"><strong>B</strong></button>
                        <button type="button" id="ed-italic"    class="ed-btn" title="Nghiêng (Ctrl+I)"><em>I</em></button>
                        <button type="button" id="ed-underline" class="ed-btn" title="Gạch chân (Ctrl+U)"><u>U</u></button>
                        <button type="button" id="ed-strike"    class="ed-btn" title="Gạch ngang"><s>S</s></button>
                        <div class="ed-sep"></div>
                        <input type="color" id="ed-color" class="ed-color-pick" value="#1e293b" title="Màu chữ">
                        <button type="button" id="ed-highlight" class="ed-btn" title="Highlight"><span class="material-symbols-rounded">format_ink_highlighter</span></button>
                        <div class="ed-sep"></div>
                        <button type="button" id="ed-ul" class="ed-btn" title="Danh sách"><span class="material-symbols-rounded">format_list_bulleted</span></button>
                        <button type="button" id="ed-ol" class="ed-btn" title="Đánh số"><span class="material-symbols-rounded">format_list_numbered</span></button>
                        <div class="ed-sep"></div>
                        <button type="button" id="ed-link"   class="ed-btn" title="Chèn link"><span class="material-symbols-rounded">link</span></button>
                        <button type="button" id="ed-unlink" class="ed-btn" title="Bỏ link"><span class="material-symbols-rounded">link_off</span></button>
                        <button type="button" id="ed-clear-fmt" class="ed-btn" title="Xóa định dạng"><span class="material-symbols-rounded">format_clear</span></button>
                        <div class="ed-sep"></div>
                        @if (!isAiSource)
                        {
                            <button type="button" class="ed-btn" title="Trích dẫn Quy định / Hướng dẫn / Bản tin" onclick="InquiryChat.openRefPicker()"><span class="material-symbols-rounded">menu_book</span></button>
                        }
                        <button type="button" class="ed-btn" title="Chèn câu trả lời mẫu" onclick="InquiryChat.openCannedPicker()"><span class="material-symbols-rounded">quickreply</span></button>
                    </div>
                    <div id="refChipsStrip" class="ref-chips-strip"></div>
                    <div id="msgEditor"></div>
                    <div class="editor-footer">
                        <span id="charCounter" class="char-counter">0/2000</span>
                    </div>
                </div>
                <button class="btn-send" id="btnSend" onclick="InquiryChat.sendMessage()" title="@(draftMode ? "Gửi CSR duyệt" : "Gửi")">
                    <span class="material-symbols-rounded" style="font-size:1.2rem">send</span>
                </button>
            </div>
        </div>
        <input type="file" id="fileInput" style="display:none" multiple accept="image/*,video/*,.pdf,.doc,.docx,.xls,.xlsx" onchange="InquiryChat.handleFiles(this.files)">
    }
</div>

@Html.AntiForgeryToken()
@if (canClassify)
{
    <partial name="_CaseClassifyModal" model="inq.Id" />
}

@section Scripts {
<script src="~/js/media-viewer.js" asp-append-version="true"></script>
<script src="~/js/inquiry-chat.js" asp-append-version="true"></script>
@if (!isAiSource)
{
    <script src="~/js/inquiry-drafts.js" asp-append-version="true"></script>
}
@if (!isClosed && !lockedForMe)
{
    <script type="module" src="~/js/inquiry-chat-editor.js" asp-append-version="true"></script>
}
<script>
InquiryChat.init({
    inquiryId: @inq.Id,
    inquiryNo: '@inq.InquiryNo',
    mySide: 'HR',
    myEmpCd: '@myEmpCd',
    isClosed: @(isClosed ? "true" : "false"),
    pollIntervalMs: 5000,
    reloadOnLock: true,
    recallableIfUnreadBy: 'EMP',
    defaultTheirsName: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(inq.EmpName ?? "Nhân viên")),
    urls: {
        getMessages: '@(isAiSource ? Url.Action("AiGetMessages","HrInquiry") : Url.Action("GetMessages","HrInquiry"))',
        send:        '@(isAiSource ? Url.Action("AiSend","HrInquiry") : Url.Action("Send","HrInquiry"))',
        recall:      '@(isAiSource ? Url.Action("AiRecall","HrInquiry") : Url.Action("Recall","HrInquiry"))',
        close:       '@(isAiSource ? Url.Action("AiClose","HrInquiry") : Url.Action("Close","HrInquiry"))',
        getFile:     '@Url.Action("GetFile","HrInquiry")',
        uploadFile:  '@Url.Action("UploadFile","HrInquiry")',
        searchRefs:  '@Url.Action("SearchRefs","HrInquiry")',
        policyDetail:'@Url.Action("Detail","Policy")',
        guideDetail: '@Url.Action("Detail","Guide")',
        bulletinDetail: '@Url.Action("Detail","Bulletin")',
        cannedReplies: '@Url.Action("GetCannedRepliesForPicker","HrInquiry")'
    }
});
@if (!isAiSource)
{
<text>
if (window.InquiryDrafts) InquiryDrafts.init({
    inquiryId: @inq.Id,
    urls: {
        list:    '@Url.Action("Drafts","HrInquiry")',
        approve: '@Url.Action("ApproveDraft","HrInquiry")',
        ret:     '@Url.Action("ReturnDraft","HrInquiry")',
        dismiss: '@Url.Action("DismissDraft","HrInquiry")'
    }
});
</text>
}
</script>
}
