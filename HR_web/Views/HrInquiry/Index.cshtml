@using HR_web.Helpers
@{
    ViewData["Title"] = "Quản lý hội thoại";
    var me = AuthHelper.GetCurrentUser(User);
}

@section Styles {
<style>
    .skeleton { background: linear-gradient(90deg,#f0f0f0 25%,#e0e0e0 50%,#f0f0f0 75%); background-size:200% 100%; animation:shimmer 1.2s infinite; border-radius:4px; height:14px; }
    @@keyframes shimmer { 0%{background-position:200% 0} 100%{background-position:-200% 0} }
    #inqTableBody tr { cursor: pointer; }
    #inqTableBody tr td { vertical-align: middle; }
    .inq-no   { font-family: monospace; font-size: .78rem; font-weight: 700; color: #94a3b8; }
    .inq-subj { font-weight: 700; color: #1e293b; max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display:block; }
    .status-pill { font-size: .65rem; font-weight: 800; padding: 2px 9px; border-radius: 20px; text-transform: uppercase; white-space: nowrap; }
    .status-pill.open   { background: #dcfce7; color: #166534; }
    .status-pill.closed { background: #f1f5f9; color: #64748b; }
    .unread-badge { background: #ef4444; color: white; font-size: .65rem; font-weight: 800; border-radius: 20px; padding: 1px 7px; min-width: 18px; text-align: center; display:inline-block; }
    .assigned-chip { font-size: .75rem; background: #eff6ff; color: #2563eb; border-radius: 20px; padding: 2px 8px; font-weight: 700; }
    .anon-chip { font-size: .72rem; background: #f1f5f9; color: #64748b; border-radius: 20px; padding: 1px 7px; }
    .topic-chip { font-size: .72rem; border-radius: 20px; padding: 1px 7px; font-weight: 600; }
    .pagination .page-link { cursor: pointer; }
    .pagination .page-item.disabled .page-link { cursor: default; }
    .emp-name-row { font-weight: 700; color: #1e293b; font-size: .85rem; }
    .emp-meta { font-size: .72rem; color: #64748b; line-height: 1.3; margin-top: 1px; }
    .emp-meta .empcd { font-family: monospace; color: #94a3b8; font-weight: 700; }
    .row-close-btn { background: #fef2f2; border: 1px solid #fecaca; color: #dc2626; border-radius: 8px; padding: .25rem .5rem; font-size: .72rem; font-weight: 700; cursor: pointer; transition: all .12s; }
    .row-close-btn:hover { background: #dc2626; color: white; border-color: #dc2626; }
    .row-close-btn:disabled { opacity: .4; cursor: not-allowed; }
</style>
}

<div class="container-fluid py-4">

    <!-- Stats -->
    <div class="row mb-4">
        <div class="col-xl-3 col-sm-6 mb-xl-0 mb-4">
            <div class="card"><div class="card-body p-3"><div class="row"><div class="col-8">
                <p class="text-sm mb-0 text-uppercase font-weight-bold text-secondary">Tổng hội thoại</p>
                <h5 class="font-weight-bolder mb-0" id="statTotal">-</h5>
            </div><div class="col-4 text-end"><div class="icon bg-gradient-info text-white shadow-info ms-auto" style="width:48px;height:48px;display:flex;align-items:center;justify-content:center;border-radius:12px;">
                <span class="material-symbols-rounded">forum</span>
            </div></div></div></div></div>
        </div>
        <div class="col-xl-3 col-sm-6 mb-xl-0 mb-4">
            <div class="card"><div class="card-body p-3"><div class="row"><div class="col-8">
                <p class="text-sm mb-0 text-uppercase font-weight-bold text-success">Đang mở</p>
                <h5 class="font-weight-bolder mb-0" id="statOpen">-</h5>
            </div><div class="col-4 text-end"><div class="icon bg-gradient-success text-white shadow-success ms-auto" style="width:48px;height:48px;display:flex;align-items:center;justify-content:center;border-radius:12px;">
                <span class="material-symbols-rounded">chat_bubble</span>
            </div></div></div></div></div>
        </div>
        <div class="col-xl-3 col-sm-6 mb-xl-0 mb-4">
            <div class="card"><div class="card-body p-3"><div class="row"><div class="col-8">
                <p class="text-sm mb-0 text-uppercase font-weight-bold text-danger">Chưa đọc</p>
                <h5 class="font-weight-bolder mb-0" id="statUnread">-</h5>
            </div><div class="col-4 text-end"><div class="icon bg-gradient-danger text-white shadow-danger ms-auto" style="width:48px;height:48px;display:flex;align-items:center;justify-content:center;border-radius:12px;">
                <span class="material-symbols-rounded">mark_unread_chat_alt</span>
            </div></div></div></div></div>
        </div>
        <div class="col-xl-3 col-sm-6 mb-xl-0 mb-4">
            <div class="card"><div class="card-body p-3"><div class="row"><div class="col-8">
                <p class="text-sm mb-0 text-uppercase font-weight-bold text-secondary">Đã đóng</p>
                <h5 class="font-weight-bolder mb-0" id="statClosed">-</h5>
            </div><div class="col-4 text-end"><div class="icon bg-gradient-secondary text-white shadow ms-auto" style="width:48px;height:48px;display:flex;align-items:center;justify-content:center;border-radius:12px;">
                <span class="material-symbols-rounded">check_circle</span>
            </div></div></div></div></div>
        </div>
    </div>

    <!-- Main card -->
    <div class="card my-4">
        <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
            <div class="bg-gradient-info shadow-info border-radius-lg pt-3 pb-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h6 class="text-white text-capitalize mb-0">
                    <span class="material-symbols-rounded me-1" style="font-size:1.1rem;vertical-align:middle">manage_accounts</span>
                    Danh sách hội thoại
                </h6>
            </div>
        </div>

        <!-- Filter bar -->
        <div class="px-4 pt-3 pb-2 d-flex flex-wrap gap-2 align-items-center">
            <select class="form-select form-select-sm" id="fStatus" style="width:auto" onchange="loadData(1)">
                <option value="">Tất cả trạng thái</option>
                <option value="OPEN">Đang mở</option>
                <option value="CLOSED">Đã đóng</option>
            </select>
            <select class="form-select form-select-sm" id="fChatType" style="width:auto" onchange="loadData(1)">
                <option value="">Trực tiếp &amp; Ẩn danh</option>
                <option value="DIRECT">Trực tiếp</option>
                <option value="ANON">Ẩn danh</option>
            </select>
            <select class="form-select form-select-sm" id="fTopic" style="width:auto;min-width:130px" onchange="loadData(1)">
                <option value="">Tất cả chủ đề</option>
            </select>
            <select class="form-select form-select-sm" id="fAssigned" style="width:auto" onchange="loadData(1)">
                <option value="">Tất cả phụ trách</option>
                <option value="@(me?.EmpCd ?? "")">Của tôi</option>
                <option value="UNASSIGNED">Chưa phụ trách</option>
            </select>
            <select class="form-select form-select-sm" id="fSort" style="width:auto" onchange="loadData(1)">
                <option value="newest">Mới nhất trước</option>
                <option value="oldest">Cũ nhất trước</option>
            </select>
            <div class="input-group input-group-sm" style="min-width:200px;flex:1">
                <span class="input-group-text"><span class="material-symbols-rounded" style="font-size:.9rem">search</span></span>
                <input type="text" class="form-control" id="fSearch" placeholder="Mã NV, tên, INQ-NO, chủ đề..."
                       oninput="debounceLoad()">
            </div>
            <select class="form-select form-select-sm" id="fPageSize" style="width:auto" onchange="changePageSize(this.value)">
                <option value="10">10 / trang</option>
                <option value="30" selected>30 / trang</option>
                <option value="50">50 / trang</option>
                <option value="100">100 / trang</option>
            </select>
        </div>

        <div class="card-body px-0 pt-0 pb-2">
            <div class="table-responsive p-0 px-4">
                <table class="table align-items-center mb-0 w-100 table-hover table-striped">
                    <thead class="bg-light">
                        <tr>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Mã / Chủ đề</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Nhân viên</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2 d-none d-md-table-cell">Phụ trách</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2 text-center">Trạng thái</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2 text-center">Chưa đọc</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2 d-none d-lg-table-cell">Tin nhắn cuối</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2 text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="inqTableBody">
                        <tr><td colspan="7" class="text-center py-5"><div class="spinner-border text-info" role="status"></div></td></tr>
                    </tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center px-4 mt-3 mb-2">
                <div id="pageCount" class="text-sm text-secondary"></div>
                <nav><ul class="pagination pagination-sm mb-0" id="paginationBar"></ul></nav>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
<script>
const LIST_URL  = '@Url.Action("GetList","HrInquiry")';
const CHAT_URL  = '@Url.Action("Chat","HrInquiry")';
const CLOSE_URL = '@Url.Action("Close","HrInquiry")';
const TOKEN     = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
const MY_EMPCD  = '@(me?.EmpCd ?? "")';
let pageSize    = 30;
let currentPage = 1, totalPages = 1, totalRecords = 0, isLoading = false;

function changePageSize(v) { pageSize = parseInt(v,10) || 30; loadData(1); }

function esc(s) { return (s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function fmtDt(ds) {
    if (!ds) return '—';
    const d = new Date(ds), diff = Math.floor((Date.now()-d)/1000);
    if (diff < 3600)  return Math.floor(diff/60) + 'p trước';
    if (diff < 86400) return Math.floor(diff/3600) + 'h trước';
    return d.toLocaleDateString('vi-VN');
}

let _debTimer;
function debounceLoad() { clearTimeout(_debTimer); _debTimer = setTimeout(() => loadData(1), 400); }

function buildUrl(page) {
    const s    = document.getElementById('fStatus').value;
    const ct   = document.getElementById('fChatType').value;
    const t    = document.getElementById('fTopic').value;
    const a    = document.getElementById('fAssigned').value;
    const q    = document.getElementById('fSearch').value.trim();
    const sort = document.getElementById('fSort')?.value || 'newest';
    let url = `${LIST_URL}?page=${page}&pageSize=${pageSize}&sort=${encodeURIComponent(sort)}`;
    if (s)  url += `&status=${encodeURIComponent(s)}`;
    if (ct) url += `&chatType=${encodeURIComponent(ct)}`;
    if (t)  url += `&topicCd=${encodeURIComponent(t)}`;
    if (a === 'UNASSIGNED') url += '&assignedTo=UNASSIGNED';
    else if (a) url += `&assignedTo=${encodeURIComponent(a)}`;
    if (q)  url += `&search=${encodeURIComponent(q)}`;
    return url;
}

async function loadData(page = 1) {
    if (isLoading) return;
    isLoading = true; currentPage = page;
    document.getElementById('inqTableBody').innerHTML =
        '<tr><td colspan="7" class="text-center py-5"><div class="spinner-border text-info" role="status"></div><div class="mt-2 text-sm text-secondary">Đang tải...</div></td></tr>';

    try {
        const res  = await fetch(buildUrl(page));
        const data = await res.json();
        if (!data.success) { showToast(data.message || 'Lỗi tải dữ liệu', 'error'); return; }

        // Update stats
        totalRecords = data.total       ?? 0;
        totalPages   = data.totalPages  ?? 1;
        document.getElementById('statTotal').textContent  = (data.total        ?? 0).toLocaleString();
        document.getElementById('statOpen').textContent   = (data.cntOpen      ?? 0).toLocaleString();
        document.getElementById('statUnread').textContent = (data.totalUnread  ?? 0).toLocaleString();
        document.getElementById('statClosed').textContent = (data.cntClosed    ?? 0).toLocaleString();

        const items = data.data || [];
        const tbody = document.getElementById('inqTableBody');
        if (!items.length) {
            tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-5"><span class="material-symbols-rounded" style="font-size:2.5rem;color:#c7d2fe;display:block">forum</span>Không có hội thoại nào</td></tr>';
        } else {
            tbody.innerHTML = items.map(i => {
                const statusCls = i.status === 'OPEN' ? 'open' : 'closed';
                const statusTxt = i.status === 'OPEN' ? 'Mở' : 'Đóng';
                let empDisplay;
                if (i.chatType === 'ANON') {
                    empDisplay = `<span class="anon-chip"><span class="material-symbols-rounded" style="font-size:.7rem;vertical-align:middle">visibility_off</span> ${esc(i.anonDisplay||'Ẩn danh')}</span>`;
                } else {
                    const name = i.empName || '—';
                    const meta = [i.deptName, i.lineName, i.workName].filter(Boolean).join(' · ');
                    empDisplay = `<div class="emp-name-row vni-font">${esc(name)}</div>`
                               + `<div class="emp-meta">${i.empCd ? `<span class="empcd">${esc(i.empCd)}</span>${meta ? ' · ' : ''}` : ''}${meta ? `<span class="vni-font">${esc(meta)}</span>` : ''}</div>`;
                }
                const assigned = i.assignedName
                    ? `<span class="assigned-chip vni-font">${esc(i.assignedName)}</span>`
                    : '<span class="text-muted" style="font-size:.78rem">Chưa có</span>';
                const topicStyle = i.topicColor ? `background:${i.topicColor}22;color:${i.topicColor}` : 'background:#e0e7ff;color:#4f46e5';
                const canClose = i.status === 'OPEN' && i.assignedTo === MY_EMPCD;
                const actionCell = canClose
                    ? `<button class="row-close-btn" onclick="event.stopPropagation();closeRow(${i.id})" title="Đóng hội thoại"><span class="material-symbols-rounded" style="font-size:.85rem;vertical-align:middle">close</span> Đóng</button>`
                    : '<span class="text-muted" style="font-size:.78rem">—</span>';
                return `<tr onclick="window.location.href='${CHAT_URL}?id=${i.id}'">
                    <td class="px-2">
                        <div class="inq-no">${esc(i.inquiryNo)}</div>
                        <span class="inq-subj">${esc(i.subject||i.topicName||'Hội thoại')}</span>
                        ${i.topicName ? `<span class="topic-chip" style="${topicStyle}">${esc(i.topicName)}</span>` : ''}
                    </td>
                    <td class="px-2 text-sm">${empDisplay}</td>
                    <td class="px-2 d-none d-md-table-cell">${assigned}</td>
                    <td class="px-2 text-center"><span class="status-pill ${statusCls}">${statusTxt}</span></td>
                    <td class="px-2 text-center">${i.unreadHr > 0 ? `<span class="unread-badge">${i.unreadHr}</span>` : '<span class="text-muted">—</span>'}</td>
                    <td class="px-2 d-none d-lg-table-cell text-secondary text-sm">${fmtDt(i.lastMsgDt)}</td>
                    <td class="px-2 text-center">${actionCell}</td>
                </tr>`;
            }).join('');
        }
        renderPagination();
    } catch { showToast('Lỗi kết nối', 'error'); }
    finally { isLoading = false; }
}

function closeRow(id) {
    showConfirm('Đóng hội thoại này?', async () => {
        try {
            const res = await fetch(CLOSE_URL, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN },
                body: JSON.stringify({ inquiryId: id, closeNote: null })
            });
            const data = await res.json();
            if (!data.success) { showToast(data.message || 'Không thể đóng', 'error'); return; }
            showToast('Đã đóng hội thoại', 'success');
            loadData(currentPage);
        } catch { showToast('Lỗi kết nối', 'error'); }
    }, { title: 'Đóng hội thoại', okText: 'Đóng', okClass: 'btn-warning', icon: 'close', iconColor: '#d97706', iconBg: '#fef3c7' });
}

function renderPagination() {
    const start = (currentPage-1)*pageSize+1, end = Math.min(currentPage*pageSize, totalRecords);
    document.getElementById('pageCount').innerHTML =
        totalRecords > 0 ? `Trang <strong>${currentPage}</strong> / ${totalPages} &nbsp;·&nbsp; ${start.toLocaleString()}–${end.toLocaleString()} / ${totalRecords.toLocaleString()}` : '';

    const bar = document.getElementById('paginationBar');
    bar.innerHTML = '';
    if (totalPages <= 1) return;

    const mk = (label, p, disabled, active) => {
        const li = document.createElement('li');
        li.className = 'page-item' + (disabled?' disabled':'') + (active?' active':'');
        const a = document.createElement('a');
        a.className = 'page-link'; a.innerHTML = label;
        if (!disabled && !active) a.onclick = () => loadData(p);
        li.appendChild(a); return li;
    };
    bar.appendChild(mk('&laquo;', 1, currentPage<=1));
    bar.appendChild(mk('&lsaquo;', currentPage-1, currentPage<=1));
    let from = Math.max(1,currentPage-2), to = Math.min(totalPages,currentPage+2);
    if (from > 1) { bar.appendChild(mk('1',1)); if(from>2) bar.insertAdjacentHTML('beforeend','<li class="page-item disabled"><a class="page-link">…</a></li>'); }
    for (let p=from; p<=to; p++) bar.appendChild(mk(p, p, false, p===currentPage));
    if (to < totalPages) { bar.insertAdjacentHTML('beforeend','<li class="page-item disabled"><a class="page-link">…</a></li>'); bar.appendChild(mk(totalPages,totalPages)); }
    bar.appendChild(mk('&rsaquo;', currentPage+1, currentPage>=totalPages));
    bar.appendChild(mk('&raquo;', totalPages, currentPage>=totalPages));
}

async function loadTopics() {
    try {
        const res  = await fetch('@Url.Action("GetTopics","HrInquiry")');
        const data = await res.json();
        const sel  = document.getElementById('fTopic');
        (data.data || []).forEach(t => {
            const opt = document.createElement('option');
            opt.value = t.topicCd; opt.textContent = t.topicName;
            sel.appendChild(opt);
        });
    } catch {}
}

loadTopics();
loadData(1);
</script>
}
