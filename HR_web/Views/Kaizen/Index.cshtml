    .kz-reward-highlight-text span { font-size: .72rem; color: #b45309; }
    .kz-reward-highlight .chevron { margin-left: auto; transition: transform .2s ease; color: #b45309; flex-shrink: 0; }
    .kz-reward-highlight[aria-expanded="true"] .chevron { transform: rotate(180deg); }
    .kz-reward-body { margin-top: .8rem; }
    .kz-reward-group + .kz-reward-group { margin-top: .9rem; }
    .kz-reward-group-title {
        font-size: .72rem; font-weight: 800; text-transform: uppercase; letter-spacing: .4px;
        color: #047857; margin-bottom: .4rem; display: flex; align-items: center; gap: 5px;
    }
    .kz-reward-group-title .dot { width: 6px; height: 6px; border-radius: 50%; background: #10b981; flex-shrink: 0; }
    .kz-prize-row {
        display: flex; align-items: center; gap: .6rem; padding: .55rem 0;
        border-bottom: 1px dashed #e2e8f0;
    }
    .kz-prize-row:last-child { border-bottom: none; }
    .kz-prize-badge {
        flex-shrink: 0; width: 30px; height: 30px; border-radius: 9px; display: flex; align-items: center;
        justify-content: center; font-size: .68rem; font-weight: 800; color: #fff; background: #10b981;
