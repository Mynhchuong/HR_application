@{
    ViewData["Title"] = "Quản lý đăng ký Kaizen";
}

<div class="container-fluid py-4">
    <div class="card my-4">
        <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
            <div class="bg-gradient-dark shadow-dark border-radius-lg pt-3 pb-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h6 class="text-white mb-0"><i class="bi bi-lightbulb me-1"></i> Đăng ký Kaizen (toàn công ty)</h6>
                <a id="exportBtn" href="#" class="btn btn-sm btn-white mb-0"><i class="bi bi-file-earmark-excel me-1"></i> Xuất Excel</a>
            </div>
        </div>

        <div class="card-body px-3 pt-0 pb-2 mt-3">
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger py-2">@TempData["ErrorMessage"]</div>
            }
            <div id="kzNotReady" class="alert alert-warning py-2" style="display:none;">
                Chức năng Kaizen chưa được bật trên hệ thống (chưa tạo bảng dữ liệu). Vui lòng liên hệ IT.
            </div>

            <!-- Email nhận file Excel tự động mỗi thứ Sáu 08:00 -->
            <div class="card border mb-3" id="mailCard" style="display:none;">
                <div class="card-body p-3">
                    <div class="fw-bold text-sm mb-1"><i class="bi bi-envelope-paper me-1"></i>Email nhận báo cáo Excel tự động</div>
                    <div class="text-xs text-secondary mb-2" id="mailSchedule"></div>
                    <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                        <input type="email" id="mailInput" class="form-control form-control-sm" style="max-width:320px;" placeholder="Nhập email rồi nhấn Thêm" autocomplete="off" />
                        <button type="button" class="btn btn-sm btn-primary mb-0" onclick="addMail()"><i class="bi bi-plus-lg me-1"></i>Thêm</button>
                    </div>
                    <div id="mailList" class="d-flex flex-column gap-1"></div>
                    <div id="mailMsg" class="text-xs mt-2"></div>
                    <div id="mailLast" class="text-xs text-secondary mt-1"></div>
                </div>
            </div>

            <div class="row g-2 mb-3 filter-bar">
                <div class="col-6 col-md-2">
                    <select id="fMonth" class="form-select form-select-sm"><option value="">Tất cả tháng</option></select>
                </div>
                <div class="col-6 col-md-3">
                    <select id="fDept" class="form-select form-select-sm"><option value="">Tất cả bộ phận (Dept)</option></select>
                </div>
                <div class="col-12 col-md-4">
                    <input type="text" id="fSearch" class="form-control form-control-sm" placeholder="Tìm mã NV, SĐT, nội dung ý tưởng..." autocomplete="off" />
                </div>
            </div>

            <div class="table-responsive p-0">
                <table class="table align-items-center mb-0 table-hover">
                    <thead class="bg-light">
                        <tr class="text-uppercase text-secondary text-xxs font-weight-bolder">
                            <th class="px-2" style="width:120px;">Ngày nộp</th>
                            <th class="px-2" style="width:80px;">Tháng</th>
                            <th class="px-2" style="width:150px;">Nhân viên</th>
                            <th class="px-2" style="width:200px;">Dept / Line / Work</th>
                            <th class="px-2" style="width:120px;">SĐT / Zalo</th>
                            <th class="px-2">Ý tưởng</th>
                        </tr>
                    </thead>
                    <tbody id="kzBody"><tr><td colspan="6" class="text-center py-5"><div class="spinner-border text-dark"></div></td></tr></tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
                <div id="pgCount" class="text-xs"></div>
                <ul class="pagination pagination-sm mb-0" id="pgBar"></ul>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
<script>
const KZA_TOKEN = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
const MAIL_URLS = { list: '@Url.Action("MailList", "KaizenAdmin")', add: '@Url.Action("MailAdd", "KaizenAdmin")',
                    remove: '@Url.Action("MailRemove", "KaizenAdmin")', test: '@Url.Action("MailTest", "KaizenAdmin")' };

function mailMsg(text, ok) {
    const el = document.getElementById('mailMsg');
    el.className = 'text-xs mt-2 ' + (ok ? 'text-success' : 'text-danger');
    el.textContent = text || '';
}
async function mailPost(url, body) {
    const res = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': KZA_TOKEN }, body: JSON.stringify(body) });
    return res.json();
}
function loadMail() {
    fetch(MAIL_URLS.list).then(r => r.json()).then(d => {
        if (d.available === false || !d.success) { document.getElementById('mailCard').style.display = d.available === false ? 'none' : 'block'; if (d.success === false && d.available !== false) mailMsg(d.message || 'Lỗi', false); return; }
        document.getElementById('mailCard').style.display = 'block';
        document.getElementById('mailSchedule').textContent = 'Gửi tự động: ' + d.schedule + ' (đăng ký mới kể từ lần gửi trước). Tối đa ' + d.max + ' email.';
        const list = document.getElementById('mailList');
        list.innerHTML = (d.recipients || []).length ? d.recipients.map(x => `
            <div class="d-flex align-items-center gap-2">
                <span class="text-sm">${esc(x.email)}</span>
                <button type="button" class="btn btn-sm btn-outline-secondary py-0 mb-0" data-email="${esc(x.email)}" onclick="testMail(this)"><i class="bi bi-send me-1"></i>Gửi thử</button>
                <button type="button" class="btn btn-sm btn-outline-danger py-0 mb-0" data-id="${x.id}" onclick="removeMail(this)"><i class="bi bi-trash"></i></button>
            </div>`).join('') : '<div class="text-xs text-secondary">Chưa có email nào — thêm email để bắt đầu nhận báo cáo.</div>';
        const l = d.last;
        document.getElementById('mailLast').textContent = l
            ? ('Lần gửi tự động gần nhất: ' + fmtDt(l.sentDt) + ' — ' + (l.status === 'OK' ? 'thành công (' + l.rows + ' đăng ký)' : 'THẤT BẠI: ' + (l.err || '')))
            : 'Chưa có lần gửi tự động nào.';
    }).catch(() => mailMsg('Không tải được danh sách email', false));
}
async function addMail() {
    const inp = document.getElementById('mailInput');
    const email = inp.value.trim();
    if (!email) return;
    mailMsg('', true);
    const d = await mailPost(MAIL_URLS.add, { email });
    if (d.success) { inp.value = ''; loadMail(); } else mailMsg(d.message || 'Không thêm được', false);
}
async function removeMail(btn) {
    if (!confirm('Xóa email này khỏi danh sách nhận báo cáo?')) return;
    const d = await mailPost(MAIL_URLS.remove, { id: parseInt(btn.dataset.id, 10) });
    if (d.success) loadMail(); else mailMsg(d.message || 'Không xóa được', false);
}
async function testMail(btn) {
    btn.disabled = true; mailMsg('Đang gửi thử...', true);
    try { const d = await mailPost(MAIL_URLS.test, { email: btn.dataset.email }); mailMsg(d.message || '', !!d.success); }
    catch (e) { mailMsg('Không kết nối được máy chủ', false); }
    finally { btn.disabled = false; }
}
document.getElementById('mailInput').addEventListener('keydown', e => { if (e.key === 'Enter') addMail(); });

const LIST_URL = '@Url.Action("GetList", "KaizenAdmin")';
const EXPORT_URL = '@Url.Action("Export", "KaizenAdmin")';
const PAGE_SIZE = 50;
let curPage = 1, totalPages = 0, totalRows = 0, filtersLoaded = false;

function esc(s) { return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function fmtMonth(m) { const p = (m || '').split('-'); return p.length === 2 ? p[1] + '/' + p[0] : (m || ''); }
function fmtDt(s) {
    const d = new Date(s); if (isNaN(d)) return '';
    const p = n => String(n).padStart(2, '0');
    return p(d.getDate()) + '/' + p(d.getMonth() + 1) + '/' + d.getFullYear() + ' ' + p(d.getHours()) + ':' + p(d.getMinutes());
}
function filters() {
    return { month: document.getElementById('fMonth').value, deptcd: document.getElementById('fDept').value,
             search: document.getElementById('fSearch').value.trim() };
}
function updateExport() {
    const f = filters();
    const qs = new URLSearchParams(); Object.keys(f).forEach(k => { if (f[k]) qs.set(k, f[k]); });
    document.getElementById('exportBtn').href = EXPORT_URL + (qs.toString() ? '?' + qs.toString() : '');
}

function load(page) {
    curPage = page || 1;
    const f = filters();
    const qs = new URLSearchParams({ page: curPage, page_size: PAGE_SIZE });
    Object.keys(f).forEach(k => { if (f[k]) qs.set(k, f[k]); });
    updateExport();
    document.getElementById('kzBody').innerHTML = '<tr><td colspan="6" class="text-center py-5"><div class="spinner-border text-dark"></div></td></tr>';
    fetch(LIST_URL + '?' + qs.toString())
        .then(r => r.json())
        .then(d => {
            if (d.available === false) {
                document.getElementById('kzNotReady').style.display = 'block';
                document.getElementById('kzBody').innerHTML = '';
                return;
            }
            if (!d.success) {
                document.getElementById('kzBody').innerHTML = '<tr><td colspan="6" class="text-center text-danger py-4">Lỗi: ' + esc(d.message || '') + '</td></tr>';
                return;
            }
            if (!filtersLoaded) {
                filtersLoaded = true;
                const m = document.getElementById('fMonth');
                (d.months || []).forEach(x => m.insertAdjacentHTML('beforeend', '<option value="' + esc(x) + '">' + esc(fmtMonth(x)) + '</option>'));
                const dp = document.getElementById('fDept');
                (d.depts || []).forEach(x => dp.insertAdjacentHTML('beforeend', '<option value="' + esc(x.code) + '">' + esc(x.code) + ' - ' + esc(x.name || '') + '</option>'));
            }
            totalRows = d.total || 0; totalPages = d.total_pages || 0;
            const rows = d.data || [];
            document.getElementById('kzBody').innerHTML = rows.length ? rows.map(x => `
                <tr>
                    <td class="text-xs">${esc(fmtDt(x.submitDt))}</td>
                    <td class="text-xs">${esc(fmtMonth(x.month))}</td>
                    <td class="text-xs"><strong>${esc(x.empcd)}</strong><br><span class="vni-font">${esc(x.empName || '')}</span></td>
                    <td class="text-xs"><span class="vni-font">${esc(x.deptName || x.deptcd || '')}<br>${esc(x.lineName || x.linecd || '')}<br>${esc(x.workName || x.workcd || '')}</span></td>
                    <td class="text-xs">${esc(x.phone)}</td>
                    <td class="text-xs" style="white-space:pre-wrap;word-break:break-word;min-width:260px;">${esc(x.idea)}</td>
                </tr>`).join('')
                : '<tr><td colspan="6" class="text-center text-secondary py-4">Chưa có đăng ký nào khớp bộ lọc</td></tr>';
            renderPaging();
        })
        .catch(() => { document.getElementById('kzBody').innerHTML = '<tr><td colspan="6" class="text-center text-danger py-4">Lỗi kết nối</td></tr>'; });
}

function renderPaging() {
    const bar = document.getElementById('pgBar'); bar.innerHTML = '';
    const cnt = document.getElementById('pgCount');
    if (!totalRows) { cnt.textContent = ''; return; }
    const s = (curPage - 1) * PAGE_SIZE + 1, e = Math.min(curPage * PAGE_SIZE, totalRows);
    cnt.innerHTML = `${s}-${e} / <strong>${totalRows}</strong> đăng ký`;
    const mk = (label, p, disabled, active) => {
        const li = document.createElement('li'); li.className = 'page-item' + (disabled ? ' disabled' : '') + (active ? ' active' : '');
        const a = document.createElement('a'); a.className = 'page-link'; a.href = 'javascript:;'; a.innerHTML = label;
        a.onclick = () => { if (!disabled && !active) load(p); };
        li.appendChild(a); bar.appendChild(li);
    };
    mk('&lsaquo;', curPage - 1, curPage <= 1);
    for (let p = Math.max(1, curPage - 2); p <= Math.min(totalPages, curPage + 2); p++) mk(p, p, false, p === curPage);
    mk('&rsaquo;', curPage + 1, curPage >= totalPages);
}

document.getElementById('fMonth').addEventListener('change', () => load(1));
document.getElementById('fDept').addEventListener('change', () => load(1));
let st; document.getElementById('fSearch').addEventListener('input', () => { clearTimeout(st); st = setTimeout(() => load(1), 400); });
load(1);
loadMail();
</script>
}
