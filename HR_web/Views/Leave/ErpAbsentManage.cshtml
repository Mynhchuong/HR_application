@{
    ViewData["Title"] = "Sửa Absent Code ERP";
    var dateFrom = (string)(ViewBag.DateFrom ?? DateTime.Today.ToString("yyyy-MM-dd"));
    var dateTo   = (string)(ViewBag.DateTo   ?? DateTime.Today.ToString("yyyy-MM-dd"));
}

@section Styles {
<style>
    #erpTableBody tr td { vertical-align: middle; }
    .pagination .page-link { cursor: pointer; border-radius: 8px !important; margin: 0 2px; }
    .pagination .page-item.disabled .page-link { cursor: default; }
    .erp-code-select { min-width: 130px; }
    .erp-row-dirty { background: #fffbeb; }
    .erp-save-chk, #selectAllChk { transform: scale(1.15); cursor: pointer; }
    @@media (max-width: 767px) {
        .container-fluid { padding-left: 8px !important; padding-right: 8px !important; }
    }
</style>
}

<div class="container-fluid py-4">
    <div class="card my-4">
        <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
            <div class="bg-gradient-success shadow-success border-radius-lg pt-3 pb-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h6 class="text-white mb-0"><i class="bi bi-pencil-square me-1"></i> Sửa Absent Code ERP</h6>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" id="saveAllBtn" class="btn btn-sm mb-0" style="background:#fff;color:#166534;font-weight:600;height:34px;" disabled>
                        <i class="bi bi-save me-1"></i> Lưu tất cả<span id="dirtyCountBadge" class="badge bg-danger ms-1" style="display:none;">0</span>
                    </button>
                    <button type="button" id="exportBtn" class="btn btn-sm mb-0" style="background:#fff;color:#344767;font-weight:600;height:34px;">
                        <i class="bi bi-file-earmark-excel me-1"></i> Xuất Excel
                    </button>
                    <div class="d-flex align-items-center bg-white border-radius-md px-2 shadow-sm" style="height:34px;gap:4px;">
                        <i class="bi bi-calendar3 text-success"></i>
                        <input type="date" id="filterDateFrom" class="form-control form-control-sm border-0 bg-transparent text-dark p-0" style="width:115px;" value="@dateFrom" onchange="loadData(1)" />
                    </div>
                    <span class="text-white small">→</span>
                    <div class="d-flex align-items-center bg-white border-radius-md px-2 shadow-sm" style="height:34px;gap:4px;">
                        <i class="bi bi-calendar3 text-success"></i>
                        <input type="date" id="filterDateTo" class="form-control form-control-sm border-0 bg-transparent text-dark p-0" style="width:115px;" value="@dateTo" onchange="loadData(1)" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter bar -->
        <div class="px-3 pt-3 pb-2 d-flex flex-wrap align-items-end gap-2 filter-bar" style="background:#f8fafc;border-bottom:1px solid #e9ecef;">
            <div style="min-width:140px;flex:1 1 140px;max-width:180px;">
                <label class="form-label small fw-bold mb-1 text-primary">Mã NV</label>
                <input type="text" id="searchEmpcd" class="form-control form-control-sm" placeholder="🔍 Tìm mã NV..." />
            </div>
            <div style="min-width:150px;flex:2 1 150px;max-width:220px;">
                <label class="form-label small fw-bold mb-1 text-primary">Bộ Phận</label>
                <select id="filterDept" class="select2 form-control"
                        data-url="@Url.Action("GetDept", "Dropdown")"
                        data-placeholder="Tất cả"></select>
            </div>
            <div style="min-width:140px;flex:2 1 140px;max-width:200px;">
                <label class="form-label small fw-bold mb-1 text-primary">Line</label>
                <select id="filterLine" class="select2 form-control"
                        data-url="@Url.Action("GetLine", "Dropdown")"
                        data-parent="#filterDept"
                        data-placeholder="Tất cả"></select>
            </div>
            <div style="min-width:140px;flex:2 1 140px;max-width:200px;">
                <label class="form-label small fw-bold mb-1 text-primary">Nhóm Việc</label>
                <select id="filterWork" class="select2 form-control"
                        data-url="@Url.Action("GetWork", "Dropdown")"
                        data-parent="#filterLine"
                        data-parent-key="lineCd"
                        data-parent2="#filterDept"
                        data-parent2-key="deptCd"
                        data-placeholder="Tất cả"></select>
            </div>
            <div style="min-width:130px;flex:1 1 130px;max-width:170px;">
                <label class="form-label small fw-bold mb-1 text-primary">Mã nghỉ</label>
                <select id="filterLeavecd" class="form-select form-select-sm">
                    <option value="">Tất cả</option>
                </select>
            </div>
            <div style="min-width:170px;flex:1 1 170px;max-width:210px;">
                <label class="form-label small fw-bold mb-1 text-primary">MySamho</label>
                <select id="filterMsStatus" class="form-select form-select-sm">
                    <option value="">Tất cả</option>
                    <option value="APPROVED">Đã duyệt trên MySamho</option>
                    <option value="NOT_APPROVED">Chưa duyệt trên MySamho</option>
                </select>
            </div>
            <div style="min-width:150px;flex:1 1 150px;max-width:180px;">
                <label class="form-label small fw-bold mb-1 text-primary">Loại nghỉ MySamho</label>
                <select id="filterMsLeaveType" class="form-select form-select-sm">
                    <option value="">Tất cả</option>
                    <option value="AL">Phép năm</option>
                    <option value="NL">Không lương</option>
                    <option value="SI">Bệnh có giấy</option>
                    <option value="DT">Đám tang</option>
                    <option value="DC">Đám cưới</option>
                    <option value="CT">Công tác</option>
                    <option value="VS">Vợ sanh</option>
                    <option value="DS">Dưỡng sức</option>
                    <option value="KT">Khám thai</option>
                </select>
            </div>
            <div class="d-flex align-items-end gap-2 ms-auto">
                <div>
                    <label class="form-label small fw-bold mb-1 text-secondary">Hiển thị</label>
                    <select id="pageSizeSelect" class="form-select form-select-sm" style="width:80px;">
                        <option value="50" selected>50</option>
                        <option value="100">100</option>
                        <option value="500">500</option>
                    </select>
                </div>
                <button type="button" id="clearFilterBtn" class="btn btn-outline-secondary btn-sm" title="Xóa bộ lọc"><i class="bi bi-x-circle"></i></button>
            </div>
        </div>

        <div class="card-body px-0 pb-2">
            <div class="table-responsive px-3">
                <table class="table table-sm align-items-center mb-0">
                    <thead>
                        <tr>
                            <th class="text-center" style="width:36px;"><input type="checkbox" id="selectAllChk" title="Chọn tất cả trang này"></th>
                            <th class="text-xs text-secondary">#</th>
                            <th class="text-xs text-secondary">Mã NV / Tên</th>
                            <th class="text-xs text-secondary">Ngày</th>
                            <th class="text-xs text-secondary">Bộ phận / Chuyền / Nhóm việc</th>
                            <th class="text-xs text-secondary">Mã nghỉ</th>
                            <th class="text-xs text-secondary">Remark</th>
                            <th class="text-xs text-secondary">Người duyệt</th>
                            <th class="text-xs text-secondary text-center">MySamho</th>
                        </tr>
                    </thead>
                    <tbody id="erpTableBody"></tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center px-4 mt-3 mb-2">
                <div id="paginationCount" class="text-sm text-secondary"></div>
                <nav><ul class="pagination pagination-sm mb-0" id="paginationBar"></ul></nav>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/vendor/xlsx.full.min.js" asp-append-version="true"></script>
<script src="~/js/xlsx-export-helper.js" asp-append-version="true"></script>
<script>
const PAGE_URL       = '@Url.Action("GetErpAbsentList", "Leave")';
const CODE_LIST_URL  = '@Url.Action("GetAbsentCodeList", "Leave")';
const UPDATE_URL     = '@Url.Action("ErpAbsentUpdate", "Leave")';

let currentPage = 1, totalPages = 1, totalRecords = 0, pageSize = 50;
let ABSENT_CODES = []; // [{Code, Name, Pay}]

// Cột MySamho hiện MỌI loại nghỉ có trên MySamho (không riêng 6 loại cần giấy tờ) — cần đủ tên cả 9 loại.
const MS_LEAVE_LABEL = { AL:'Phép năm', NL:'Không lương', SI:'Bệnh có giấy', DT:'Đám tang', DC:'Đám cưới', CT:'Công tác', VS:'Vợ sanh', DS:'Dưỡng sức', KT:'Khám thai' };
// 6 loại cần giấy tờ mỗi loại 1 màu riêng cho dễ phân biệt (yêu cầu 2026-09-10) — AL/NL/CT dùng
// chung 1 màu trung tính vì không phải trọng tâm của trang này.
const MS_LEAVE_COLOR  = { SI:'#ef4444', DT:'#64748b', DC:'#ec4899', VS:'#06b6d4', DS:'#f59e0b', KT:'#8b5cf6', AL:'#3b82f6', NL:'#94a3b8', CT:'#10b981' };
const MS_DOC_LABEL   = { SUBMITTED:'Đã nộp', PARTIALLY_SUBMITTED:'Nộp 1 phần', RESUBMIT_REQUESTED:'Yêu cầu nộp lại' };
const MS_DOC_COLOR   = { SUBMITTED:'success', PARTIALLY_SUBMITTED:'info', RESUBMIT_REQUESTED:'warning' };

function escHtml(str) { return String(str==null?'':str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function formatDate(s) { if(!s) return '-'; const d=new Date(s); if(isNaN(d)) return '-'; return('0'+d.getDate()).slice(-2)+'/'+('0'+(d.getMonth()+1)).slice(-2)+'/'+d.getFullYear(); }

async function loadAbsentCodes() {
    try {
        const res = await $.get(CODE_LIST_URL);
        if (!res.success) return;
        ABSENT_CODES = res.data || [];
        // class vni-font phải đặt thẳng lên <option> (không lồng <span> bên trong) mới có tác dụng —
        // trình duyệt vẽ text trong option bằng font riêng của chính thẻ option, bỏ qua font của
        // thẻ con lồng bên trong (HR báo hiện chữ lỗi phông trong dropdown 2026-09-10).
        const filterOpts = ABSENT_CODES.map(c => `<option value="${escHtml(c.Code)}" class="vni-font">${escHtml(c.Code)} - ${escHtml(c.Name)}</option>`).join('');
        $('#filterLeavecd').append(filterOpts);
    } catch (e) { /* im lặng, dropdown mã vẫn dùng được rỗng */ }
}

function codeSelectHtml(currentCode) {
    let html = '';
    ABSENT_CODES.forEach(c => {
        html += `<option value="${escHtml(c.Code)}" ${c.Code === currentCode ? 'selected' : ''}>${escHtml(c.Code)}</option>`;
    });
    if (currentCode && !ABSENT_CODES.some(c => c.Code === currentCode)) {
        html += `<option value="${escHtml(currentCode)}" selected>${escHtml(currentCode)} (?)</option>`;
    }
    return html;
}

const MS_DOC_REQUIRED_TYPES = ['SI', 'DT', 'DC', 'VS', 'DS', 'KT'];

function msCellHtml(item) {
    if (!item.MsRequestId) return '<span class="text-muted text-xxs fst-italic">Chưa có trên MySamho</span>';
    const lbl = MS_LEAVE_LABEL[item.MsLeaveType] || item.MsLeaveType || '-';
    const typeColor = MS_LEAVE_COLOR[item.MsLeaveType] || '#94a3b8';
    // Quản lý/Admin sắp lịch (STATUS=ASSIGNED) tính như đã chốt y như Đã duyệt — chỉ cảnh báo
    // "chưa duyệt" khi thật sự KHÔNG thuộc 2 trạng thái này (VD còn PENDING/REJECTED).
    const isAssigned = item.MsStatus === 'ASSIGNED';
    const notEditable = item.MsStatus !== 'APPROVED' && !isAssigned;
    const needsDoc = MS_DOC_REQUIRED_TYPES.includes(item.MsLeaveType);
    const docBadge = needsDoc
        ? (item.MsDocStatus
            ? `<span class="badge bg-${MS_DOC_COLOR[item.MsDocStatus] || 'secondary'}">${MS_DOC_LABEL[item.MsDocStatus] || item.MsDocStatus}</span>`
            : `<span class="badge bg-secondary">Chưa nộp</span>`)
        : '';
    const assignedBadge = isAssigned ? `<span class="badge bg-info text-dark">Sắp lịch nghỉ</span>` : '';
    return `<div class="text-xs"><span class="badge" style="background:${typeColor};color:#fff;">${escHtml(lbl)}</span> ${assignedBadge} ${docBadge}</div>
        ${item.MsReason ? `<div class="text-xxs text-secondary mt-1">${escHtml(item.MsReason)}</div>` : ''}
        ${notEditable ? `<div class="text-xxs text-warning mt-1"><i class="bi bi-exclamation-triangle-fill"></i> Đơn chưa duyệt trên MySamho — lưu sẽ KHÔNG tự map</div>` : ''}`;
}

function buildRow(item, idx) {
    const rowKey = `${item.Empcd}__${item.FrDate}`;
    const deptLine = [item.DeptNm, item.TeamNm, item.WorkNm].filter(Boolean).map(escHtml).join('<br>');
    return `<tr data-row-key="${escHtml(rowKey)}" data-empcd="${escHtml(item.Empcd)}" data-frdate="${escHtml(item.FrDate)}">
        <td class="text-center"><input type="checkbox" class="erp-save-chk" title="Chọn để lưu dù không sửa gì (ERP đã đúng sẵn)" onchange="toggleRowSelect(this)"></td>
        <td class="text-xs text-secondary">${idx}</td>
        <td>
            <div class="text-xs text-secondary">${escHtml(item.Empcd)}</div>
            <div class="text-sm vni-font fw-bold" style="text-transform:uppercase;">${escHtml(item.EmpName)}</div>
        </td>
        <td class="text-sm text-nowrap">${formatDate(item.FrDate)}</td>
        <td class="text-xxs vni-font text-secondary" style="max-width:170px;line-height:1.3;">${deptLine}</td>
        <td>
            <select class="form-select form-select-sm erp-code-select vni-font" onchange="markDirty(this)">${codeSelectHtml(item.Leavecd)}</select>
        </td>
        <td>
            <input type="text" class="form-control form-control-sm erp-remark-input" style="min-width:160px;" value="${escHtml(item.Remark || '')}" oninput="markDirty(this)">
        </td>
        <td class="text-xs">
            ${item.ApprovedBy ? `<div class="text-xxs text-secondary">${escHtml(item.ApprovedBy)}</div><div class="vni-font">${escHtml(item.ApprovedByName || '')}</div>` : '-'}
        </td>
        <td class="text-center">${msCellHtml(item)}</td>
    </tr>`;
}

// Sửa ô nào (chọn Mã nghỉ hoặc gõ Remark) thì highlight cả dòng đó lên — không lưu ngay, gom lại
// bấm "Lưu tất cả" 1 lần cho mọi dòng đã sửa (yêu cầu HR 2026-09-12, bỏ lưu từng dòng riêng lẻ).
function markDirty(el) {
    const $tr = $(el).closest('tr');
    $tr.addClass('erp-row-dirty');
    $tr.find('.erp-save-chk').prop('checked', true);
    updateDirtyCount();
}

// Checkbox chọn lưu thủ công — dùng khi ERP đã đúng sẵn, không cần sửa Mã nghỉ/Remark gì cả,
// nhưng vẫn muốn bấm "Lưu tất cả" để chạy lại map + cập nhật DOC_STATUS bên MySamho (yêu cầu HR).
function toggleRowSelect(el) {
    $(el).closest('tr').toggleClass('erp-row-dirty', el.checked);
    updateDirtyCount();
}

function updateDirtyCount() {
    const n = $('#erpTableBody tr.erp-row-dirty').length;
    $('#saveAllBtn').prop('disabled', n === 0);
    $('#dirtyCountBadge').toggle(n > 0).text(n);
}

async function saveAll() {
    const $rows = $('#erpTableBody tr.erp-row-dirty');
    if (!$rows.length) return;

    // Chặn thiếu Mã nghỉ trước khi gửi bất kỳ request nào, tránh lưu dở dang nửa chừng.
    const missingCode = $rows.filter((_, tr) => !$(tr).find('.erp-code-select').val());
    if (missingCode.length) {
        missingCode.each((_, tr) => $(tr).find('.erp-code-select').addClass('is-invalid'));
        showToast(`Còn ${missingCode.length} dòng chưa chọn Mã nghỉ`, 'warning');
        return;
    }

    const $btn = $('#saveAllBtn').prop('disabled', true);
    const oldHtml = $btn.html();
    let ok = 0, fail = 0;
    const total = $rows.length;

    for (const tr of $rows.get()) {
        const $tr = $(tr);
        $btn.html(`<span class="spinner-border spinner-border-sm me-1"></span> Đang lưu ${ok + fail + 1}/${total}...`);
        const empcd   = $tr.data('empcd');
        const frdate  = $tr.data('frdate');
        const leavecd = $tr.find('.erp-code-select').val();
        const remark  = $tr.find('.erp-remark-input').val();
        try {
            const res = await $.ajax({
                url: UPDATE_URL, type: 'POST', contentType: 'application/json',
                data: JSON.stringify({ Empcd: empcd, FrDate: frdate, Leavecd: leavecd, Remark: remark })
            });
            if (res.success) { $tr.removeClass('erp-row-dirty'); $tr.find('.erp-save-chk').prop('checked', false); ok++; }
            else { fail++; }
        } catch (e) { fail++; }
    }

    updateDirtyCount();
    $btn.html(oldHtml);
    if (fail === 0) showToast(`Đã lưu ${ok} dòng`, 'success');
    else showToast(`Đã lưu ${ok} dòng, ${fail} dòng lỗi (còn highlight vàng — thử lưu lại)`, fail === total ? 'error' : 'warning');
}
$('#saveAllBtn').on('click', saveAll);

$('#selectAllChk').on('change', function () {
    const checked = this.checked;
    $('#erpTableBody .erp-save-chk').each(function () {
        if (this.checked !== checked) $(this).prop('checked', checked).trigger('change');
    });
});

// Cảnh báo rời trang khi còn dòng chưa lưu — trước đây lưu ngay từng dòng nên không cần, giờ gom
// nhiều dòng lại mới lưu nên dễ mất việc đang làm nếu lỡ tay đóng tab/điều hướng đi chỗ khác.
window.addEventListener('beforeunload', function (e) {
    if ($('#erpTableBody tr.erp-row-dirty').length > 0) { e.preventDefault(); e.returnValue = ''; }
});

function getParams(page) {
    return {
        date_from: $('#filterDateFrom').val(),
        date_to:   $('#filterDateTo').val(),
        empcd:     ($('#searchEmpcd').val() || '').trim(),
        deptcd:    $('#filterDept').val(),
        linecd:    $('#filterLine').val(),
        workcd:    $('#filterWork').val(),
        leavecd:   $('#filterLeavecd').val(),
        ms_status: $('#filterMsStatus').val(),
        ms_leave_type: $('#filterMsLeaveType').val(),
        page, page_size: pageSize
    };
}

function loadData(page = 1) {
    if (!$('#filterDateFrom').val() || !$('#filterDateTo').val()) return;
    currentPage = page;
    $('#erpTableBody').html(`<tr><td colspan="9" class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></td></tr>`);
    $.ajax({
        url: PAGE_URL, type: 'GET', data: getParams(page),
        success: function (res) {
            if (!res.success) {
                $('#erpTableBody').html(`<tr><td colspan="9" class="text-center text-danger py-4">Lỗi: ${escHtml(res.message||'')}</td></tr>`);
                return;
            }
            totalRecords = res.total || 0;
            totalPages   = res.total_pages || 0;
            const rows   = res.data || [];
            if (!rows.length) {
                $('#erpTableBody').html(`<tr><td colspan="9" class="text-center text-secondary py-4">Không có dữ liệu</td></tr>`);
            } else {
                $('#erpTableBody').html(rows.map((r,i) => buildRow(r,(page-1)*pageSize+i+1)).join(''));
            }
            renderPagination();
        },
        error: function (xhr) {
            $('#erpTableBody').html(`<tr><td colspan="9" class="text-center text-danger py-4">Lỗi kết nối (${xhr.status})</td></tr>`);
        }
    });
}

function renderPagination() {
    if (!totalRecords) { $('#paginationCount').text(''); $('#paginationBar').empty(); return; }
    const s = (currentPage-1)*pageSize+1, e = Math.min(currentPage*pageSize, totalRecords);
    $('#paginationCount').html(`<span class="text-xs">${s}-${e} / <strong>${totalRecords}</strong> dòng</span>`);
    const $bar = $('#paginationBar').empty();
    const mk = (label,p,disabled,active) => {
        const li = $('<li class="page-item">').toggleClass('disabled', !!disabled).toggleClass('active', !!active);
        $('<a class="page-link">').html(label).on('click', () => { if (!disabled && !active) loadData(p); }).appendTo(li);
        return li;
    };
    $bar.append(mk('&lsaquo;', currentPage-1, currentPage<=1));
    let from = Math.max(1, currentPage-2), to = Math.min(totalPages, currentPage+2);
    for (let p=from; p<=to; p++) $bar.append(mk(p, p, false, p===currentPage));
    $bar.append(mk('&rsaquo;', currentPage+1, currentPage>=totalPages));
}

$('#pageSizeSelect').on('change', function () { pageSize = parseInt(this.value) || 50; loadData(1); });
$('#filterDept').on('change', function () { $('#filterLine, #filterWork').val(null).trigger('change.select2'); loadData(1); });
$('#filterLine').on('change', function () { $('#filterWork').val(null).trigger('change.select2'); loadData(1); });
$('#filterWork, #filterLeavecd, #filterMsStatus, #filterMsLeaveType').on('change', () => loadData(1));
let searchTimeout;
$('#searchEmpcd').on('input', function () { clearTimeout(searchTimeout); searchTimeout = setTimeout(() => loadData(1), 400); });
$('#clearFilterBtn').on('click', function () {
    $('#searchEmpcd').val('');
    $('#filterDept, #filterLine, #filterWork').val(null).trigger('change.select2');
    $('#filterLeavecd').val('');
    $('#filterMsStatus').val('');
    $('#filterMsLeaveType').val('');
    loadData(1);
});

$('#exportBtn').on('click', async function () {
    const $btn = $(this), orig = $btn.html();
    $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Đang xuất...');
    try {
        let rows = [], pg = 1, pgTotal = 1;
        do {
            const p = getParams(pg); p.page_size = 1000;
            const res = await $.getJSON(PAGE_URL, p);
            if (!res || !res.success) break;
            pgTotal = res.total_pages; rows = rows.concat(res.data || []);
            pg++;
        } while (pg <= pgTotal);
        if (!rows.length) { showToast('Không có dữ liệu để xuất', 'warning'); return; }
        const headers = ['STT', 'Mã NV', 'Họ Tên', 'Ngày', 'Bộ phận', 'Chuyền', 'Nhóm việc', 'Mã nghỉ', 'Remark', 'Người duyệt (mã)', 'Người duyệt (tên)', 'MySamho - Loại nghỉ', 'MySamho - Trạng thái', 'MySamho - Nộp giấy', 'MySamho - Lý do'];
        let html = '<html><head><meta charset="utf-8"/></head><body><table border="1"><thead><tr>';
        html += headers.map(h => `<th style="background:#bbf7d0;font-weight:bold">${h}</th>`).join('') + '</tr></thead><tbody>';
        rows.forEach((r, i) => {
            const needsDoc = MS_DOC_REQUIRED_TYPES.includes(r.MsLeaveType);
            const msLbl    = MS_LEAVE_LABEL[r.MsLeaveType] || r.MsLeaveType || '';
            const msStatusTxt = !r.MsRequestId ? 'Chưa có trên MySamho' : (r.MsStatus === 'APPROVED' ? 'Đã duyệt' : (r.MsStatus === 'ASSIGNED' ? 'Sắp lịch nghỉ' : (r.MsStatus || '')));
            const msDocTxt = needsDoc ? (MS_DOC_LABEL[r.MsDocStatus] || 'Chưa nộp') : '-';
            html += `<tr><td>${i + 1}</td><td data-t="s">${escHtml(r.Empcd || '')}</td><td>${escHtml(r.EmpName || '')}</td><td>${formatDate(r.FrDate)}</td><td>${escHtml(r.DeptNm || '')}</td><td>${escHtml(r.TeamNm || '')}</td><td>${escHtml(r.WorkNm || '')}</td><td>${escHtml(r.Leavecd || '')}</td><td>${escHtml(r.Remark || '')}</td><td data-t="s">${escHtml(r.ApprovedBy || '')}</td><td>${escHtml(r.ApprovedByName || '')}</td><td>${escHtml(msLbl)}</td><td>${escHtml(msStatusTxt)}</td><td>${escHtml(msDocTxt)}</td><td>${escHtml(r.MsReason || '')}</td></tr>`;
        });
        html += '</tbody></table></body></html>';
        exportHtmlTableToXlsx(html, `ErpAbsent_${$('#filterDateFrom').val()}_${$('#filterDateTo').val()}.xlsx`);
    } catch (err) { showToast('Lỗi xuất file: ' + err.message, 'error'); }
    finally { $btn.prop('disabled', false).html(orig); }
});

$(async function () {
    if (typeof Select2Helper !== 'undefined') Select2Helper.init();
    await loadAbsentCodes();
    loadData(1);
});
</script>
}
