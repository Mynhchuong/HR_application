@{
    ViewData["Title"] = "Leave Approval";
    var currentMonth = DateTime.Today.ToString("yyyy-MM");
}

@section Styles {
<style>
    .stats-card .icon { width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; border-radius: 12px; }
    #lvTableBody tr td { vertical-align: middle; }
    .pagination .page-link { cursor: pointer; }
    .pagination .page-item.disabled .page-link { cursor: default; }
    .txt-clamp { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; max-width:160px; cursor:default; }
    .pending-age {
        display: inline-block; margin-top: 4px; padding: 2px 8px;
        border-radius: 999px; font-size: .7rem; font-weight: 700;
        background: #fef3c7; color: #92400e; border: 1px solid #fbbf24;
    }
    .pending-age.stale {
        background: #fee2e2; color: #991b1b; border-color: #dc2626;
        animation: pulse-red 1.6s infinite ease-in-out;
    }
    @@keyframes pulse-red {
        0%,100% { box-shadow: 0 0 0 0 rgba(220,38,38,.5); }
        50%     { box-shadow: 0 0 0 6px rgba(220,38,38,0); }
    }
    tr.row-stale-pending { background: linear-gradient(90deg, #fff1f2 0%, transparent 30%) !important; border-left: 4px solid #dc2626 !important; }
    tr.row-stale-pending td { background: transparent !important; }
    .sig-cell      { display:flex; gap:8px; justify-content:center; align-items:flex-start; }
    .sig-cell-item { text-align:center; min-width:80px; }
    .sig-cell-lbl  { font-size:.6rem; font-weight:700; color:#94a3b8; text-transform:uppercase; letter-spacing:.04em; margin-bottom:2px; }
    .sig-cell-img  { display:block; margin:0 auto; max-height:55px; max-width:110px; object-fit:contain; background:#fafafa; border-radius:4px; padding:2px; }
    .sig-cell-name { font-size:.65rem; color:#64748b; margin-top:2px; line-height:1.2; }
    @@media (max-width: 767px) {
        .container-fluid { padding-left: 8px !important; padding-right: 8px !important; }
        .pagination .page-link { padding: .25rem .45rem; font-size: .75rem; }
    }
</style>
}

<div class="container-fluid py-4">
    <!-- Stats cards -->
    <div class="row mb-4">
        <div class="col-6 col-xl-3 mb-xl-0 mb-3">
            <div class="card stats-card" data-filter-status=""><div class="card-body p-3"><div class="row"><div class="col-8"><p class="text-sm mb-0 text-uppercase font-weight-bold text-secondary">Total</p><h5 class="font-weight-bolder mb-0" id="summaryTotal">-</h5></div><div class="col-4 text-end"><div class="icon bg-gradient-info text-white shadow-info ms-auto"><i class="bi bi-calendar-check fs-4"></i></div></div></div></div></div>
        </div>
        <div class="col-6 col-xl-3 mb-xl-0 mb-3">
            <div class="card stats-card" data-filter-status="PENDING"><div class="card-body p-3"><div class="row"><div class="col-8"><p class="text-sm mb-0 text-uppercase font-weight-bold text-warning">Pending</p><h5 class="font-weight-bolder mb-0" id="summaryPending">-</h5></div><div class="col-4 text-end"><div class="icon bg-gradient-warning text-white shadow-warning ms-auto"><i class="bi bi-hourglass-split fs-4"></i></div></div></div></div></div>
        </div>
        <div class="col-6 col-xl-3 mb-xl-0 mb-3">
            <div class="card stats-card" data-filter-status="APPROVED"><div class="card-body p-3"><div class="row"><div class="col-8"><p class="text-sm mb-0 text-uppercase font-weight-bold text-success">Approved</p><h5 class="font-weight-bolder mb-0" id="summaryApproved">-</h5></div><div class="col-4 text-end"><div class="icon bg-gradient-success text-white shadow-success ms-auto"><i class="bi bi-check-circle-fill fs-4"></i></div></div></div></div></div>
        </div>
        <div class="col-6 col-xl-3 mb-xl-0 mb-3">
            <div class="card stats-card" data-filter-status="REJECTED"><div class="card-body p-3"><div class="row"><div class="col-8"><p class="text-sm mb-0 text-uppercase font-weight-bold text-danger">Rejected</p><h5 class="font-weight-bolder mb-0" id="summaryRejected">-</h5></div><div class="col-4 text-end"><div class="icon bg-gradient-danger text-white shadow-danger ms-auto"><i class="bi bi-x-circle-fill fs-4"></i></div></div></div></div></div>
        </div>
    </div>

    <div class="card my-4">
        <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
            <div class="bg-gradient-primary shadow-primary border-radius-lg pt-3 pb-2 px-3 d-flex justify-content-between align-items-center gap-2">
                <h6 class="text-white mb-0"><i class="bi bi-shield-check me-1"></i> Leave Approval</h6>
                <div class="d-flex align-items-center bg-white border-radius-md px-2 shadow-sm" style="height:34px;gap:4px;">
                    <i class="bi bi-calendar3 text-primary"></i>
                    <input type="month" id="filterMonth" class="form-control form-control-sm border-0 bg-transparent text-dark p-0"
                           style="width:130px;" value="@currentMonth" onchange="loadData(1)" />
                </div>
            </div>
        </div>

        <!-- Filter bar -->
        <div class="px-3 pt-3 pb-2 d-flex flex-wrap align-items-end gap-2 filter-bar" style="background:#f8fafc;border-bottom:1px solid #e9ecef;">
            <div style="min-width:140px;flex:1 1 140px;max-width:180px;">
                <label class="form-label small fw-bold mb-1 text-primary">Employee ID</label>
                <input type="text" id="searchInput" class="form-control form-control-sm" placeholder="🔍 Search emp ID..." />
            </div>
            <div style="min-width:130px;flex:1 1 130px;max-width:170px;">
                <label class="form-label small fw-bold mb-1 text-primary">Status</label>
                <select id="filterStatus" class="form-select form-select-sm">
                    <option value="">All</option>
                    <option value="PENDING">Pending</option>
                    <option value="APPROVED">Approved</option>
                    <option value="REJECTED">Rejected</option>
                </select>
            </div>
            <div style="min-width:150px;flex:1 1 150px;max-width:200px;">
                <label class="form-label small fw-bold mb-1 text-primary">Leave Type</label>
                <select id="filterLeaveType" class="form-select form-select-sm">
                    <option value="">All</option>
                    <option value="AL">Annual (AL)</option>
                    <option value="DT">Funeral (DT)</option>
                    <option value="DC">Wedding (DC)</option>
                    <option value="CT">Business trip (CT)</option>
                    <option value="VS">Childbirth (VS)</option>
                    <option value="KT">Prenatal checkup (KT)</option>
                </select>
            </div>
            <div style="min-width:150px;flex:2 1 150px;max-width:220px;">
                <label class="form-label small fw-bold mb-1 text-primary">Department</label>
                <select id="filterDept" class="select2 form-control"
                        data-url="@Url.Action("GetDeptByScope", "Dropdown")"
                        data-placeholder="All"></select>
            </div>
            <div style="min-width:140px;flex:2 1 140px;max-width:200px;">
                <label class="form-label small fw-bold mb-1 text-primary">Line</label>
                <select id="filterLine" class="select2 form-control"
                        data-url="@Url.Action("GetLineByScope", "Dropdown")"
                        data-parent="#filterDept"
                        data-placeholder="All"></select>
            </div>
            <div style="min-width:140px;flex:2 1 140px;max-width:200px;">
                <label class="form-label small fw-bold mb-1 text-primary">Work Group</label>
                <select id="filterWork" class="select2 form-control"
                        data-url="@Url.Action("GetWorkByScope", "Dropdown")"
                        data-parent="#filterLine"
                        data-parent-key="lineCd"
                        data-parent2="#filterDept"
                        data-parent2-key="deptCd"
                        data-placeholder="All"></select>
            </div>
            <div class="d-flex align-items-end ms-auto">
                <div>
                    <label class="form-label small fw-bold mb-1 text-secondary">Show</label>
                    <select id="pageSizeSelect" class="form-select form-select-sm" style="width:80px;">
                        <option value="50" selected>50</option>
                        <option value="100">100</option>
                        <option value="500">500</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="card-body px-0 pt-0 pb-2 mt-1">
            <div class="table-responsive p-0 px-4">
                <table class="table align-items-center mb-0 w-100 table-hover table-striped">
                    <thead class="bg-light">
                        <tr>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                data-mobile="hidden">#</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                data-mobile="primary" data-mobile-slot="name" data-mobile-label="Employee Info">Employee Info</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                data-mobile="primary" data-mobile-slot="badge" data-mobile-label="Leave Type">Leave Type</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                data-mobile="primary" data-mobile-slot="badge" data-mobile-label="From">From</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                data-mobile="detail" data-mobile-label="To">To</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                data-mobile="primary" data-mobile-slot="badge" data-mobile-label="Days">Days</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2 d-none d-md-table-cell"
                                data-mobile="detail" data-mobile-label="Reason">Reason</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2 d-none d-md-table-cell"
                                data-mobile="detail" data-mobile-label="Created">Created</th>
                            <th class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-9"
                                data-mobile="primary" data-mobile-slot="badge" data-mobile-label="Status">Status</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2 d-none d-md-table-cell"
                                data-mobile="detail" data-mobile-label="Approved By">Approved By</th>
                            <th class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-9"
                                data-mobile="detail" data-mobile-label="Signature">Signature</th>
                            <th class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-9"
                                data-mobile="primary" data-mobile-slot="badge" data-mobile-label="Action">Action</th>
                        </tr>
                    </thead>
                    <tbody id="lvTableBody"></tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center px-4 mt-3 mb-2">
                <div id="paginationCount" class="text-sm text-secondary"></div>
                <nav><ul class="pagination pagination-sm mb-0" id="paginationBar"></ul></nav>
            </div>
        </div>
    </div>
</div>

<!-- Action Modal -->
<div class="modal fade" id="actionModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header" id="actionModalHeader">
                <h6 class="modal-title mb-0" id="actionModalTitle"></h6>
            </div>
            <div class="modal-body">
                <input type="hidden" id="actionRequestId" />
                <input type="hidden" id="actionType" />
                <div class="mb-2">
                    <label class="form-label small fw-bold">Note (optional)</label>
                    <textarea id="actionComment" class="form-control form-control-sm" rows="2" maxlength="200"
                              oninput="$('#commentCount').text(this.value.length+'/200')"></textarea>
                    <div class="text-end text-xxs text-secondary mt-1"><span id="commentCount">0/200</span></div>
                </div>
                <div id="actionError" class="alert alert-danger d-none py-1 px-2 text-sm"></div>
            </div>
            <div class="modal-footer py-2">
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-sm text-white" id="confirmActionBtn" onclick="submitAction()">Confirm</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
const PAGE_URL      = '@Url.Action("GetApprovalListPage", "Leave")';
const APPROVE_URL   = '@Url.Action("ApproveRequest",      "Leave")';
const REJECT_URL    = '@Url.Action("RejectRequest",       "Leave")';
const SIG_URL       = '@Url.Action("GetSignature", "Image")';
const CURRENT_EMPCD = '@ViewBag.CurrentEmpCd';
const CURRENT_ROLE  = '@ViewBag.CurrentRole';
const CAN_APPROVE   = ['Supervisor', 'DeputyManager', 'Manager', 'Expat', 'Admin'].includes(CURRENT_ROLE);
const ROLE_LEVELS   = { Admin:99, Expat:5, Manager:4, DeputyManager:3, Supervisor:2, HR:1, Clerk:1, Worker:1 };
const MY_LEVEL      = ROLE_LEVELS[CURRENT_ROLE] || 1;

function canApproveRole(requesterRole) {
    return CAN_APPROVE && (ROLE_LEVELS[requesterRole] || 1) < MY_LEVEL;
}

let currentPage = 1, totalPages = 1, totalRecords = 0, pageSize = 50;

const LEAVE_LABEL = { AL:'Annual', CL:'Social Ins.', SL:'Sick', NPL:'Unpaid', OTH:'Other', DT:'Funeral', DC:'Wedding', CT:'Business trip', VS:'Childbirth', KT:'Prenatal checkup' };
const LEAVE_COLOR = { AL:'primary', CL:'info', SL:'danger', NPL:'secondary', OTH:'warning', DT:'dark', DC:'danger', CT:'info', VS:'primary', KT:'warning' };

function getMonthRange(ym) {
    if (!ym) { const d = new Date(); ym = d.getFullYear()+'-'+('0'+(d.getMonth()+1)).slice(-2); }
    const [y, m] = ym.split('-').map(Number);
    const last = new Date(y, m, 0).getDate();
    return { from: `${ym}-01`, to: `${ym}-${('0'+last).slice(-2)}` };
}

function buildRow(item, idx) {
    const ltLabel = LEAVE_LABEL[item.LEAVE_TYPE] || item.LEAVE_TYPE || '-';
    const ltColor = LEAVE_COLOR[item.LEAVE_TYPE] || 'secondary';

    let pendingDays = 0, isStale = false;
    if (item.STATUS === 'PENDING' && item.CREATED_DATE) {
        pendingDays = Math.floor((Date.now() - new Date(item.CREATED_DATE)) / 86400000);
        isStale = pendingDays >= 15;
    }

    let statusHtml = `<span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Pending</span>`;
    if (item.STATUS === 'PENDING' && pendingDays > 0) {
        statusHtml += `<div class="pending-age ${isStale ? 'stale' : ''}"><i class="bi bi-alarm me-1"></i>Waiting ${pendingDays} days</div>`;
    }
    if (item.STATUS === 'APPROVED') statusHtml = `<span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Approved</span>`;
    if (item.STATUS === 'REJECTED') statusHtml = `<span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Rejected</span>`;

    let remarkDiv = '';
    if (item.STATUS !== 'PENDING' && item.REMARK) {
        const isRejected = item.STATUS === 'REJECTED';
        const rkStyle = isRejected
            ? 'background:#fff0f0;border-left:3px solid #dc3545;color:#842029;'
            : 'background:#e8f4fd;border-left:3px solid #0d6efd;color:#084298;';
        remarkDiv = `<div class="mt-1 px-2 py-1 rounded-end text-xs" style="${rkStyle}"><i class="bi bi-chat-left-text me-1"></i>${escHtml(item.REMARK)}</div>`;
    }

    let approverHtml = '<span class="text-muted text-xs">-</span>';
    if (item.STATUS !== 'PENDING') {
        const approver = escHtml(item.APPROVER_NAME || item.FINAL_APPROVER || '');
        if (approver) {
            approverHtml = `<div class="emp-name vni-font" style="text-transform:uppercase;font-size:.85rem;">${approver}</div>`;
            if (item.FINAL_DATE) approverHtml += `<div class="text-xxs text-secondary">${formatDateTime(item.FINAL_DATE)}</div>`;
        }
    }

    const isSelf    = item.EMPCD === CURRENT_EMPCD;
    const approveOk = !isSelf && canApproveRole(item.REQUESTER_ROLE);
    const actions   = item.STATUS !== 'PENDING'
        ? '<span class="text-muted text-xs">-</span>'
        : approveOk
            ? `<button class="btn btn-xs btn-success me-1" onclick="event.stopPropagation();openAction('${item.REQUEST_ID}','approve')"><i class="bi bi-check-lg"></i></button>
               <button class="btn btn-xs btn-danger"  onclick="event.stopPropagation();openAction('${item.REQUEST_ID}','reject')"><i class="bi bi-x-lg"></i></button>`
            : `<span class="text-warning text-xxs d-inline-block lh-sm"><i class="bi bi-exclamation-triangle-fill me-1"></i>Higher level<br>required</span>`;

    const reqSig = item.EMPCD
        ? `<div class="sig-cell-item">
               <div class="sig-cell-lbl">Requester</div>
               <img src="${SIG_URL}?empCd=${encodeURIComponent(item.EMPCD)}" class="sig-cell-img" onerror="this.remove()" alt="Signature"/>
           </div>` : '';
    const apSig = (item.STATUS !== 'PENDING' && item.FINAL_APPROVER)
        ? `<div class="sig-cell-item">
               <div class="sig-cell-lbl">Approver</div>
               <img src="${SIG_URL}?empCd=${encodeURIComponent(item.FINAL_APPROVER)}" class="sig-cell-img" onerror="this.remove()" alt="Signature"/>
               ${item.APPROVER_NAME ? `<div class="sig-cell-name vni-font">${escHtml(item.APPROVER_NAME)}</div>` : ''}
           </div>` : '';
    const sigCell = `<div class="sig-cell">${reqSig}${apSig}</div>`;
    const deptLineWork = [item.DEPT_NAME, item.LINE_NAME, item.WORK_NAME].filter(Boolean).map(escHtml).join(' / ') || '-';

    return `<tr class="${isStale ? 'row-stale-pending' : ''}">
        <td class="px-2 text-xs text-secondary">${idx}</td>
        <td class="px-2 text-sm">
            <div class="d-flex align-items-center flex-wrap gap-1">
                <span class="badge bg-light text-dark border px-2 py-1">${escHtml(item.EMPCD||'')}</span>
                <span class="emp-name vni-font fw-bold" style="text-transform:uppercase;font-size:.85rem;">${escHtml(item.EMP_NAME||'')}</span>
            </div>
            <div class="text-xxs text-secondary mt-1">
                <i class="bi bi-diagram-3 text-primary me-1"></i>${deptLineWork}
            </div>
        </td>
        <td class="px-2"><span class="badge bg-${ltColor}">${ltLabel}</span></td>
        <td class="px-2 text-sm text-nowrap">${formatDate(item.FROM_DATE)}</td>
        <td class="px-2 text-sm text-nowrap">${formatDate(item.TO_DATE)}</td>
        <td class="px-2 text-sm fw-bold">${item.TOTAL_DAYS ?? '-'}</td>
        <td class="px-2 text-sm d-none d-md-table-cell"><div class="txt-clamp" title="${escHtml(item.REASON||'')}">${escHtml(item.REASON||'-')}</div></td>
        <td class="px-2 text-xs text-nowrap d-none d-md-table-cell text-secondary">${item.CREATED_DATE ? formatDateTime(item.CREATED_DATE) : '-'}</td>
        <td class="text-center">${statusHtml}${remarkDiv}</td>
        <td class="px-2 d-none d-md-table-cell">${approverHtml}</td>
        <td class="text-center">${sigCell}</td>
        <td class="text-center">${actions}</td>
    </tr>`;
}

function getParams(page) {
    const { from, to } = getMonthRange($('#filterMonth').val());
    return {
        status:     $('#filterStatus').val(),
        leave_type: $('#filterLeaveType').val(),
        search:    $('#searchInput').val(),
        dept_id:   $('#filterDept').val(),
        line_id:   $('#filterLine').val(),
        work_id:   $('#filterWork').val(),
        date_from: from,
        date_to:   to,
        page,
        page_size: pageSize
    };
}

function loadData(page = 1) {
    currentPage = page;
    $('#lvTableBody').html(`<tr><td colspan="12" class="text-center py-5"><div class="spinner-border text-primary" role="status"></div><div class="mt-2 text-sm text-secondary">Loading...</div></td></tr>`);
    MobileTableHelper.refresh('lvTableBody');
    $.ajax({
        url: PAGE_URL, type: 'GET', data: getParams(page),
        success: function(res) {
            if (!res.success) {
                $('#lvTableBody').html(`<tr><td colspan="12" class="text-center text-danger py-4">Error: ${res.message||''}</td></tr>`);
                MobileTableHelper.refresh('lvTableBody');
                return;
            }
            const s = res.summary || {};
            $('#summaryTotal').text((s.TOTAL||0).toLocaleString());
            $('#summaryPending').text((s.PENDING||0).toLocaleString());
            $('#summaryApproved').text((s.APPROVED||0).toLocaleString());
            $('#summaryRejected').text((s.REJECTED||0).toLocaleString());
            totalRecords = res.total || 0;
            totalPages   = res.total_pages || 0;
            const data   = res.data || [];
            if (!data.length) {
                $('#lvTableBody').html(`<tr><td colspan="12" class="text-center text-muted py-4">No records found</td></tr>`);
            } else {
                $('#lvTableBody').html(data.map((item,i) => buildRow(item,(page-1)*pageSize+i+1)).join(''));
            }
            renderPagination();
            MobileTableHelper.refresh('lvTableBody');
        },
        error: function(xhr) {
            $('#lvTableBody').html(`<tr><td colspan="12" class="text-center text-danger py-4">Connection error (${xhr.status})</td></tr>`);
            MobileTableHelper.refresh('lvTableBody');
        }
    });
}

function renderPagination() {
    if (!totalRecords) { $('#paginationCount').text(''); $('#paginationBar').empty(); return; }
    const s=(currentPage-1)*pageSize+1, e=Math.min(currentPage*pageSize,totalRecords);
    $('#paginationCount').html(`<span class="text-xs">${s}-${e} / <strong>${totalRecords}</strong> records</span>`);
    const $bar=$('#paginationBar').empty();
    const mk=(label,p,disabled,active)=>{const li=$('<li class="page-item">').toggleClass('disabled',!!disabled).toggleClass('active',!!active);$('<a class="page-link">').html(label).on('click',()=>{if(!disabled&&!active)loadData(p);}).appendTo(li);return li;};
    $bar.append(mk('&lsaquo;',currentPage-1,currentPage<=1));
    let from=Math.max(1,currentPage-2),to=Math.min(totalPages,currentPage+2);
    for(let p=from;p<=to;p++) $bar.append(mk(p,p,false,p===currentPage));
    $bar.append(mk('&rsaquo;',currentPage+1,currentPage>=totalPages));
}

function openAction(id, type) {
    $('#actionRequestId').val(id); $('#actionType').val(type);
    $('#actionComment').val(''); $('#actionError').addClass('d-none').text('');
    $('#commentCount').text('0/200');
    const isApprove = type === 'approve';
    $('#actionModalHeader').removeClass('bg-success bg-danger').addClass(isApprove ? 'bg-success text-white' : 'bg-danger text-white');
    $('#actionModalTitle').text(isApprove ? 'Approve Leave Request' : 'Reject Leave Request');
    $('#confirmActionBtn').removeClass('btn-success btn-danger').addClass(isApprove ? 'btn-success' : 'btn-danger');
    new bootstrap.Modal('#actionModal').show();
}

async function submitAction() {
    const id      = $('#actionRequestId').val();
    const type    = $('#actionType').val();
    const comment = $('#actionComment').val();
    const url     = type === 'approve' ? APPROVE_URL : REJECT_URL;
    const $btn    = $('#confirmActionBtn').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>...');
    try {
        const res = await $.ajax({ url, type: 'POST', data: { request_id: id, comment } });
        if (res.success) {
            bootstrap.Modal.getInstance('#actionModal').hide();
            showToast(type === 'approve' ? 'Leave request approved' : 'Leave request rejected', type === 'approve' ? 'success' : 'warning');
            loadData(currentPage);
        } else {
            $('#actionError').removeClass('d-none').text(res.message || 'Processing error');
        }
    } catch { $('#actionError').removeClass('d-none').text('Connection error'); }
    finally  { $btn.prop('disabled', false).text('Confirm'); }
}

