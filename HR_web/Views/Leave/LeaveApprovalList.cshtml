@{
    ViewData["Title"] = "Duyệt Đơn Nghỉ Phép";
    int initMonth = DateTime.Today.Month;
    int initYear  = DateTime.Today.Year;
}

@section Styles {
<style>
    .stats-card .icon { width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; border-radius: 12px; }
    #lvTableBody tr td { vertical-align: middle; }
    .pagination .page-link { cursor: pointer; }
    .txt-clamp { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; max-width:160px; cursor:default; }
    .pagination .page-item.disabled .page-link { cursor: default; }
    .month-nav { display:flex; align-items:center; gap:6px; }
    .month-nav button { border:none; background:rgba(255,255,255,.22); color:#fff; border-radius:6px; width:28px; height:28px; display:flex; align-items:center; justify-content:center; font-size:.95rem; cursor:pointer; }
    .month-nav button:hover { background:rgba(255,255,255,.38); }
    .month-nav span { font-weight:700; font-size:.9rem; color:#fff; min-width:130px; text-align:center; }
    @@media (max-width: 767px) {
        .container-fluid { padding-left: 8px !important; padding-right: 8px !important; }
        .stats-card .icon { width: 38px; height: 38px; }
        .stats-card .card-body { padding: .75rem !important; }
        .stats-card h5 { font-size: 1.1rem; }
        .pagination .page-link { padding: .25rem .45rem; font-size: .75rem; }
    }
    @@media (max-width: 576px) {
        .filter-wrap { display:grid !important; grid-template-columns:1fr 1fr; gap:6px !important; align-items:end; }
        .filter-wrap > div { min-width:0 !important; max-width:none !important; flex:none !important; }
        .filter-wrap .filter-full { grid-column:1 / -1; }
    }
</style>
}

<div class="container-fluid py-4">
    <!-- Stats cards -->
    <div class="row mb-4">
        <div class="col-6 col-xl-3 mb-xl-0 mb-3">
            <div class="card stats-card"><div class="card-body p-3"><div class="row"><div class="col-8"><p class="text-sm mb-0 text-uppercase font-weight-bold text-secondary">Tổng</p><h5 class="font-weight-bolder mb-0" id="summaryTotal">-</h5></div><div class="col-4 text-end"><div class="icon bg-gradient-info text-white shadow-info ms-auto"><i class="bi bi-calendar-check fs-4"></i></div></div></div></div></div>
        </div>
        <div class="col-6 col-xl-3 mb-xl-0 mb-3">
            <div class="card stats-card"><div class="card-body p-3"><div class="row"><div class="col-8"><p class="text-sm mb-0 text-uppercase font-weight-bold text-warning">Chờ Duyệt</p><h5 class="font-weight-bolder mb-0" id="summaryPending">-</h5></div><div class="col-4 text-end"><div class="icon bg-gradient-warning text-white shadow-warning ms-auto"><i class="bi bi-hourglass-split fs-4"></i></div></div></div></div></div>
        </div>
        <div class="col-6 col-xl-3 mb-xl-0 mb-3">
            <div class="card stats-card"><div class="card-body p-3"><div class="row"><div class="col-8"><p class="text-sm mb-0 text-uppercase font-weight-bold text-success">Đã Duyệt</p><h5 class="font-weight-bolder mb-0" id="summaryApproved">-</h5></div><div class="col-4 text-end"><div class="icon bg-gradient-success text-white shadow-success ms-auto"><i class="bi bi-check-circle-fill fs-4"></i></div></div></div></div></div>
        </div>
        <div class="col-6 col-xl-3 mb-xl-0 mb-3">
            <div class="card stats-card"><div class="card-body p-3"><div class="row"><div class="col-8"><p class="text-sm mb-0 text-uppercase font-weight-bold text-danger">Từ Chối</p><h5 class="font-weight-bolder mb-0" id="summaryRejected">-</h5></div><div class="col-4 text-end"><div class="icon bg-gradient-danger text-white shadow-danger ms-auto"><i class="bi bi-x-circle-fill fs-4"></i></div></div></div></div></div>
        </div>
    </div>

    <div class="card my-4">
        <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
            <div class="bg-gradient-primary shadow-primary border-radius-lg pt-3 pb-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h6 class="text-white mb-0"><i class="bi bi-shield-check me-1"></i> Duyệt Đơn Nghỉ Phép Nhân Viên</h6>
                <div class="month-nav">
                    <button onclick="changeMonth(-1)" title="Tháng trước"><i class="bi bi-chevron-left"></i></button>
                    <span id="monthLabel"></span>
                    <button onclick="changeMonth(1)" title="Tháng sau"><i class="bi bi-chevron-right"></i></button>
                </div>
            </div>
        </div>

        <!-- Filter bar -->
        <div class="px-3 pt-3 pb-2 d-flex flex-wrap align-items-end gap-2 filter-wrap" style="background:#f8fafc;border-bottom:1px solid #e9ecef;">
            <div style="min-width:120px;flex:1 1 120px;max-width:170px;">
                <label class="form-label small fw-bold mb-1 text-primary">Mã NV</label>
                <input type="text" id="searchInput" class="form-control form-control-sm" placeholder="🔍 Tìm mã NV..." />
            </div>
            <div style="min-width:120px;flex:1 1 120px;max-width:160px;">
                <label class="form-label small fw-bold mb-1 text-primary">Tình Trạng</label>
                <select id="filterStatus" class="form-select form-select-sm">
                    <option value="">Tất cả</option>
                    <option value="PENDING">Chờ duyệt</option>
                    <option value="APPROVED">Đã duyệt</option>
                    <option value="REJECTED">Từ chối</option>
                </select>
            </div>
            <div style="min-width:120px;flex:1 1 120px;max-width:160px;">
                <label class="form-label small fw-bold mb-1 text-primary">Loại nghỉ</label>
                <select id="filterLeaveType" class="form-select form-select-sm">
                    <option value="">Tất cả</option>
                    <option value="AL">Phép năm</option>
                    <option value="CL">BHXH</option>
                    <option value="SL">Bệnh</option>
                    <option value="NPL">Không lương</option>
                    <option value="OTH">Khác</option>
                </select>
            </div>
            <div class="filter-full" style="min-width:150px;flex:2 1 150px;max-width:220px;">
                <label class="form-label small fw-bold mb-1 text-primary">Bộ Phận</label>
                <select id="filterDept" class="select2 form-control"
                        data-url="@Url.Action("GetDeptByScope", "Dropdown")"
                        data-placeholder="Tất cả"></select>
            </div>
            <div class="filter-full" style="min-width:140px;flex:2 1 140px;max-width:200px;">
                <label class="form-label small fw-bold mb-1 text-primary">Line</label>
                <select id="filterLine" class="select2 form-control"
                        data-url="@Url.Action("GetLineByScope", "Dropdown")"
                        data-parent="#filterDept"
                        data-placeholder="Tất cả"></select>
            </div>
            <div class="filter-full" style="min-width:140px;flex:2 1 140px;max-width:200px;">
                <label class="form-label small fw-bold mb-1 text-primary">Nhóm Việc</label>
                <select id="filterWork" class="select2 form-control"
                        data-url="@Url.Action("GetWorkByScope", "Dropdown")"
                        data-parent="#filterLine"
                        data-parent-key="lineCd"
                        data-placeholder="Tất cả"></select>
            </div>
            <div style="flex:0 0 auto;">
                <label class="form-label small fw-bold mb-1 text-secondary">Hiển thị</label>
                <select id="pageSizeSelect" class="form-select form-select-sm" style="width:80px;">
                    <option value="50" selected>50</option>
                    <option value="100">100</option>
                    <option value="500">500</option>
                </select>
            </div>
        </div>

        <div class="card-body px-0 pt-0 pb-2 mt-1">
            <div class="table-responsive p-0 px-4">
                <table class="table align-items-center mb-0 w-100 table-hover table-striped">
                    <thead class="bg-light">
                        <tr>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                data-mobile="hidden">#</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                data-mobile="primary" data-mobile-slot="code" data-mobile-label="Mã NV">Mã NV</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                data-mobile="primary" data-mobile-slot="name" data-mobile-label="Họ & Tên">Họ &amp; Tên</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2 d-none d-md-table-cell"
                                data-mobile="detail" data-mobile-label="Bộ Phận / Line">Bộ Phận / Line</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                data-mobile="primary" data-mobile-slot="badge" data-mobile-label="Loại nghỉ">Loại nghỉ</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                data-mobile="primary" data-mobile-slot="badge" data-mobile-label="Từ ngày">Từ ngày</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                data-mobile="detail" data-mobile-label="Đến ngày">Đến ngày</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                data-mobile="primary" data-mobile-slot="badge" data-mobile-label="Số ngày">Số ngày</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2 d-none d-md-table-cell"
                                data-mobile="detail" data-mobile-label="Lý do">Lý do</th>
                            <th class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-9"
                                data-mobile="primary" data-mobile-slot="badge" data-mobile-label="Tình Trạng">Tình Trạng</th>
                            <th class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-9"
                                data-mobile="primary" data-mobile-slot="badge" data-mobile-label="Thao Tác">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody id="lvTableBody"></tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center px-4 mt-3 mb-2">
                <div id="paginationCount" class="text-sm text-secondary"></div>
                <nav><ul class="pagination pagination-sm mb-0" id="paginationBar"></ul></nav>
            </div>
        </div>
    </div>
</div>

<!-- Action Modal -->
<div class="modal fade" id="actionModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header" id="actionModalHeader">
                <h6 class="modal-title mb-0" id="actionModalTitle"></h6>
            </div>
            <div class="modal-body">
                <input type="hidden" id="actionRequestId" />
                <input type="hidden" id="actionType" />
                <div class="mb-2">
                    <label class="form-label small fw-bold">Ghi Chú (không bắt buộc)</label>
                    <textarea id="actionComment" class="form-control form-control-sm" rows="2" maxlength="200"
                              oninput="$('#commentCount').text(this.value.length+'/200')"></textarea>
                    <div class="text-end text-xxs text-secondary mt-1"><span id="commentCount">0/200</span></div>
                </div>
                <div id="actionError" class="alert alert-danger d-none py-1 px-2 text-sm"></div>
            </div>
            <div class="modal-footer py-2">
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Huỷ</button>
                <button class="btn btn-sm text-white" id="confirmActionBtn" onclick="submitAction()">Xác Nhận</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
const PAGE_URL      = '@Url.Action("GetApprovalListPage", "Leave")';
const APPROVE_URL   = '@Url.Action("ApproveRequest",      "Leave")';
const REJECT_URL    = '@Url.Action("RejectRequest",       "Leave")';
const CURRENT_EMPCD = '@ViewBag.CurrentEmpCd';
const CURRENT_ROLE  = '@ViewBag.CurrentRole';
const CAN_APPROVE   = ['Supervisor', 'DeputyManager', 'Manager', 'Expat', 'Admin'].includes(CURRENT_ROLE);
const ROLE_LEVELS   = { Admin:99, Expat:5, Manager:4, DeputyManager:3, Supervisor:2, HR:1, Clerk:1, Worker:1 };
const MY_LEVEL      = ROLE_LEVELS[CURRENT_ROLE] || 1;

function canApproveRole(requesterRole) {
    return CAN_APPROVE && (ROLE_LEVELS[requesterRole] || 1) < MY_LEVEL;
}

let currentPage = 1, totalPages = 1, totalRecords = 0, pageSize = 50;
let curMonth = @initMonth, curYear = @initYear;

const MONTHS_VI = ['Tháng 1','Tháng 2','Tháng 3','Tháng 4','Tháng 5','Tháng 6',
                   'Tháng 7','Tháng 8','Tháng 9','Tháng 10','Tháng 11','Tháng 12'];

function updateMonthLabel() {
    $('#monthLabel').text(MONTHS_VI[curMonth-1] + ' / ' + curYear);
}
function changeMonth(delta) {
    curMonth += delta;
    if (curMonth > 12) { curMonth = 1;  curYear++; }
    if (curMonth < 1)  { curMonth = 12; curYear--; }
    updateMonthLabel();
    loadData(1);
}
function getMonthRange() {
    const firstDay = new Date(curYear, curMonth - 1, 1);
    const lastDay  = new Date(curYear, curMonth, 0);
    const fmt = d => d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
    return { from: fmt(firstDay), to: fmt(lastDay) };
}

const LEAVE_LABEL = { AL:'Phép năm', CL:'BHXH', SL:'Bệnh', NPL:'Không lương', OTH:'Khác' };
const LEAVE_COLOR = { AL:'primary', CL:'info', SL:'danger', NPL:'secondary', OTH:'warning' };

function buildRow(item, idx) {
    const ltLabel = LEAVE_LABEL[item.LEAVE_TYPE] || item.LEAVE_TYPE || '-';
    const ltColor = LEAVE_COLOR[item.LEAVE_TYPE] || 'secondary';

    let statusHtml = `<span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Chờ duyệt</span>`;
    if (item.STATUS === 'APPROVED') statusHtml = `<span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Đã duyệt</span>`;
    if (item.STATUS === 'REJECTED') statusHtml = `<span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Từ chối</span>`;

    let signInfo = '';
    if (item.STATUS !== 'PENDING') {
        const signTime = item.FINAL_DATE ? `<div class="text-xxs text-secondary mt-1">${formatDateTime(item.FINAL_DATE)}</div>` : '';
        let remarkDiv = '';
        if (item.REMARK) {
            const isRejected = item.STATUS === 'REJECTED';
            const rkStyle = isRejected
                ? 'background:#fff0f0;border-left:3px solid #dc3545;color:#842029;'
                : 'background:#e8f4fd;border-left:3px solid #0d6efd;color:#084298;';
            remarkDiv = `<div class="mt-1 px-2 py-1 rounded-end text-xs" style="${rkStyle}"><i class="bi bi-chat-left-text me-1"></i>${escHtml(item.REMARK)}</div>`;
        }
        signInfo = `${signTime}${remarkDiv}`;
    }

    const isSelf    = item.EMPCD === CURRENT_EMPCD;
    const approveOk = !isSelf && canApproveRole(item.REQUESTER_ROLE);
    const actions   = item.STATUS !== 'PENDING'
        ? '<span class="text-muted text-xs">-</span>'
        : approveOk
            ? `<button class="btn btn-xs btn-success me-1" onclick="event.stopPropagation();openAction('${item.REQUEST_ID}','approve')"><i class="bi bi-check-lg"></i></button>
               <button class="btn btn-xs btn-danger"  onclick="event.stopPropagation();openAction('${item.REQUEST_ID}','reject')"><i class="bi bi-x-lg"></i></button>`
            : `<span class="text-warning text-xxs d-inline-block lh-sm"><i class="bi bi-exclamation-triangle-fill me-1"></i>Cần cấp cao<br>hơn duyệt</span>`;

    return `<tr>
        <td class="px-2 text-xs text-secondary">${idx}</td>
        <td class="px-2 text-sm">${escHtml(item.EMPCD||'')}</td>
        <td class="px-2 text-sm emp-name vni-font" style="text-transform:uppercase;">${escHtml(item.EMP_NAME||'')}</td>
        <td class="px-2 text-sm d-none d-md-table-cell">${escHtml(item.DEPT_NAME||'')} / ${escHtml(item.LINE_NAME||'')}</td>
        <td class="px-2"><span class="badge bg-${ltColor}">${ltLabel}</span></td>
        <td class="px-2 text-sm text-nowrap">${formatDate(item.FROM_DATE)}</td>
        <td class="px-2 text-sm text-nowrap">${formatDate(item.TO_DATE)}</td>
        <td class="px-2 text-sm fw-bold">${item.TOTAL_DAYS != null ? item.TOTAL_DAYS + ' ngày' : '-'}</td>
        <td class="px-2 text-sm d-none d-md-table-cell"><div class="txt-clamp" title="${escHtml(item.REASON||'')}">${escHtml(item.REASON||'-')}</div></td>
        <td class="text-center">${statusHtml}${signInfo}</td>
        <td class="text-center">${actions}</td>
    </tr>`;
}

function getParams(page) {
    const range = getMonthRange();
    return {
        status:     $('#filterStatus').val(),
        leave_type: $('#filterLeaveType').val(),
        search:     $('#searchInput').val(),
        dept_id:    $('#filterDept').val(),
        line_id:    $('#filterLine').val(),
        work_id:    $('#filterWork').val(),
        date_from:  range.from,
        date_to:    range.to,
        page,
        page_size:  pageSize
    };
}

function loadData(page = 1) {
    currentPage = page;
    $('#lvTableBody').html(`<tr><td colspan="11" class="text-center py-5"><div class="spinner-border text-primary" role="status"></div><div class="mt-2 text-sm text-secondary">Đang tải...</div></td></tr>`);
    MobileTableHelper.refresh('lvTableBody');
    $.ajax({
        url: PAGE_URL, type: 'GET', data: getParams(page),
        success: function(res) {
            if (!res.success) {
                $('#lvTableBody').html(`<tr><td colspan="11" class="text-center text-danger py-4">Lỗi: ${res.message||''}</td></tr>`);
                MobileTableHelper.refresh('lvTableBody');
                return;
            }
            const s = res.summary || {};
            $('#summaryTotal').text((s.TOTAL||0).toLocaleString());
            $('#summaryPending').text((s.PENDING||0).toLocaleString());
            $('#summaryApproved').text((s.APPROVED||0).toLocaleString());
            $('#summaryRejected').text((s.REJECTED||0).toLocaleString());
            totalRecords = res.total || 0;
            totalPages   = res.total_pages || 0;
            const data   = res.data || [];
            if (!data.length) {
                $('#lvTableBody').html(`<tr><td colspan="11" class="text-center text-muted py-4">Không có dữ liệu</td></tr>`);
            } else {
                $('#lvTableBody').html(data.map((item,i) => buildRow(item,(page-1)*pageSize+i+1)).join(''));
            }
            renderPagination();
            MobileTableHelper.refresh('lvTableBody');
        },
        error: function(xhr) {
            $('#lvTableBody').html(`<tr><td colspan="11" class="text-center text-danger py-4">Lỗi kết nối (${xhr.status})</td></tr>`);
            MobileTableHelper.refresh('lvTableBody');
        }
    });
}

function renderPagination() {
    if (!totalRecords) { $('#paginationCount').text(''); $('#paginationBar').empty(); return; }
    const s=(currentPage-1)*pageSize+1, e=Math.min(currentPage*pageSize,totalRecords);
    $('#paginationCount').html(`<span class="text-xs">${s}-${e} / <strong>${totalRecords}</strong> phiếu</span>`);
    const $bar=$('#paginationBar').empty();
    const mk=(label,p,disabled,active)=>{const li=$('<li class="page-item">').toggleClass('disabled',!!disabled).toggleClass('active',!!active);$('<a class="page-link">').html(label).on('click',()=>{if(!disabled&&!active)loadData(p);}).appendTo(li);return li;};
    $bar.append(mk('&lsaquo;',currentPage-1,currentPage<=1));
    let from=Math.max(1,currentPage-2),to=Math.min(totalPages,currentPage+2);
    for(let p=from;p<=to;p++) $bar.append(mk(p,p,false,p===currentPage));
    $bar.append(mk('&rsaquo;',currentPage+1,currentPage>=totalPages));
}

function openAction(id, type) {
    $('#actionRequestId').val(id); $('#actionType').val(type);
    $('#actionComment').val(''); $('#actionError').addClass('d-none').text('');
    $('#commentCount').text('0/200');
    const isApprove = type === 'approve';
    $('#actionModalHeader').removeClass('bg-success bg-danger').addClass(isApprove ? 'bg-success text-white' : 'bg-danger text-white');
    $('#actionModalTitle').text(isApprove ? 'Duyệt Đơn Nghỉ Phép' : 'Từ Chối Đơn Nghỉ Phép');
    $('#confirmActionBtn').removeClass('btn-success btn-danger').addClass(isApprove ? 'btn-success' : 'btn-danger');
    new bootstrap.Modal('#actionModal').show();
}

async function submitAction() {
    const id      = $('#actionRequestId').val();
    const type    = $('#actionType').val();
    const comment = $('#actionComment').val();
    const url     = type === 'approve' ? APPROVE_URL : REJECT_URL;
    const $btn    = $('#confirmActionBtn').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>...');
    try {
        const res = await $.ajax({ url, type: 'POST', data: { request_id: id, comment } });
        if (res.success) {
            bootstrap.Modal.getInstance('#actionModal').hide();
            showToast(type === 'approve' ? 'Đã duyệt đơn nghỉ thành công' : 'Đã từ chối đơn nghỉ', type === 'approve' ? 'success' : 'warning');
            loadData(currentPage);
        } else {
            $('#actionError').removeClass('d-none').text(res.message || 'Lỗi xử lý');
        }
    } catch { $('#actionError').removeClass('d-none').text('Lỗi kết nối'); }
    finally  { $btn.prop('disabled', false).text('Xác Nhận'); }
}

$('#filterDept').on('change', function() { $('#filterLine, #filterWork').val(null).trigger('change.select2'); loadData(1); });
$('#filterLine').on('change', function() { $('#filterWork').val(null).trigger('change.select2'); loadData(1); });
$('#filterStatus, #filterLeaveType, #filterWork').on('change', () => loadData(1));
$('#searchInput').on('input', debounce(() => loadData(1), 400));
$('#pageSizeSelect').on('change', function() { pageSize = parseInt($(this).val()); loadData(1); });

function formatDate(s) { if(!s) return '-'; const d=new Date(s); if(isNaN(d)) return '-'; return('0'+d.getDate()).slice(-2)+'/'+('0'+(d.getMonth()+1)).slice(-2)+'/'+d.getFullYear(); }
function formatTime(s) { const d=new Date(s); if(isNaN(d)) return''; return('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2); }
function formatDateTime(s) { if(!s) return ''; return formatDate(s)+' '+formatTime(s); }
function escHtml(str) { return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function debounce(fn,d) { let t; return function(){ clearTimeout(t); t=setTimeout(fn,d); }; }

$(document).ready(function() {
    MobileTableHelper.init('lvTableBody');
    if (typeof Select2Helper !== 'undefined') Select2Helper.init();
    updateMonthLabel();
    loadData(1);
});
</script>
}
