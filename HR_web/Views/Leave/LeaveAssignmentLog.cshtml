@{
    ViewData["Title"] = "Log Sắp Lịch Nghỉ";
    var dateFrom = (string)(ViewBag.DateFrom ?? DateTime.Today.AddMonths(-3).ToString("yyyy-MM-dd"));
    var dateTo   = (string)(ViewBag.DateTo   ?? DateTime.Today.AddMonths(3).ToString("yyyy-MM-dd"));
}

@section Styles {
<style>
    .pagination .page-link { cursor:pointer; border-radius:8px !important; margin:0 2px; }
    .pagination .page-item.disabled .page-link { cursor:default; }
    .pagination .page-item.active .page-link { background:#3b82f6; border-color:#3b82f6; }
    .txt-clamp { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; max-width:160px; cursor:default; }
    .stats-card .icon { width:48px; height:48px; display:flex; align-items:center; justify-content:center; border-radius:12px; }
</style>
}

<div class="container-fluid py-4">

    <div class="card my-4">
        <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
            <div class="bg-gradient-primary shadow-primary border-radius-lg pt-3 pb-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h6 class="text-white mb-0"><i class="bi bi-journal-text me-1"></i> Log Sắp Lịch Nghỉ Phép</h6>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <button type="button" id="exportBtn" class="btn btn-sm mb-0" style="background:#fff;color:#344767;font-weight:600;height:36px;">
                        <i class="bi bi-file-earmark-excel me-1"></i> Xuất Excel
                    </button>
                    <div class="d-flex align-items-center bg-white border-radius-md px-2 shadow-sm" style="height:34px;gap:4px;">
                        <i class="bi bi-calendar3 text-dark"></i>
                        <input type="date" id="filterDateFrom" class="form-control form-control-sm border-0 bg-transparent text-dark p-0" style="width:115px;" value="@dateFrom" onchange="loadData(1)" />
                    </div>
                    <span class="text-white small">→</span>
                    <div class="d-flex align-items-center bg-white border-radius-md px-2 shadow-sm" style="height:34px;gap:4px;">
                        <i class="bi bi-calendar3 text-dark"></i>
                        <input type="date" id="filterDateTo" class="form-control form-control-sm border-0 bg-transparent text-dark p-0" style="width:115px;" value="@dateTo" onchange="loadData(1)" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter bar -->
        <div class="px-3 pt-3 pb-2 d-flex flex-wrap align-items-end gap-2 filter-bar" style="background:#f8fafc;border-bottom:1px solid #e9ecef;">
            <div style="min-width:130px;flex:1 1 130px;max-width:170px;">
                <label class="form-label small fw-bold mb-1 text-primary">Mã NV (nghỉ)</label>
                <input type="text" id="searchInput" class="form-control form-control-sm" placeholder="🔍 Mã NV..." />
            </div>
            <div style="min-width:130px;flex:1 1 130px;max-width:170px;">
                <label class="form-label small fw-bold mb-1 text-primary">Mã người sắp</label>
                <input type="text" id="assignerInput" class="form-control form-control-sm" placeholder="🔍 Mã NV sắp..." />
            </div>
            <div style="min-width:120px;flex:1 1 120px;max-width:160px;">
                <label class="form-label small fw-bold mb-1 text-primary">Tình Trạng</label>
                <select id="filterStatus" class="form-select form-select-sm">
                    <option value="">Tất cả</option>
                    <option value="ASSIGNED">Chưa tiếp nhận thông tin</option>
                    <option value="CONFIRMED">Đã tiếp nhận thông tin</option>
                    <option value="WORKER_REJECTED">Không đồng ý</option>
                </select>
            </div>
            <div style="min-width:150px;flex:2 1 150px;max-width:220px;">
                <label class="form-label small fw-bold mb-1 text-primary">Bộ Phận</label>
                <select id="filterDept" class="select2 form-control"
                        data-url="@Url.Action("GetDept", "Dropdown")"
                        data-placeholder="Tất cả"></select>
            </div>
            <div style="min-width:140px;flex:2 1 140px;max-width:200px;">
                <label class="form-label small fw-bold mb-1 text-primary">Line</label>
                <select id="filterLine" class="select2 form-control"
                        data-url="@Url.Action("GetLine", "Dropdown")"
                        data-parent="#filterDept"
                        data-placeholder="Tất cả"></select>
            </div>
            <div style="min-width:140px;flex:2 1 140px;max-width:200px;">
                <label class="form-label small fw-bold mb-1 text-primary">Nhóm Việc</label>
                <select id="filterWork" class="select2 form-control"
                        data-url="@Url.Action("GetWork", "Dropdown")"
                        data-parent="#filterLine"
                        data-parent-key="lineCd"
                        data-parent2="#filterDept"
                        data-parent2-key="deptCd"
                        data-placeholder="Tất cả"></select>
            </div>
            <div class="d-flex align-items-end gap-2 ms-auto">
                <div>
                    <label class="form-label small fw-bold mb-1 text-secondary">Hiển thị</label>
                    <select id="pageSizeSelect" class="form-select form-select-sm" style="width:80px;">
                        <option value="50" selected>50</option>
                        <option value="100">100</option>
                        <option value="500">500</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="card-body px-0 pt-0 pb-2 mt-1">
            <!-- Count summary bar -->
            <div class="px-4 pt-2 pb-1 d-flex flex-wrap gap-3 align-items-center" id="summaryBar" style="border-bottom:1px solid #f1f5f9;background:#f8fafc;">
                <span class="text-sm"><i class="bi bi-list-ul me-1 text-secondary"></i> Tổng: <strong id="sumTotal">-</strong></span>
                <span class="text-sm text-warning"><i class="bi bi-hourglass-split me-1"></i> Chưa tiếp nhận: <strong id="sumPending">-</strong></span>
                <span class="text-sm text-success"><i class="bi bi-check-circle me-1"></i> Đã tiếp nhận: <strong id="sumConfirmed">-</strong></span>
                <span class="text-sm text-danger"><i class="bi bi-x-circle me-1"></i> Không đồng ý: <strong id="sumRejected">-</strong></span>
            </div>
            <div class="table-responsive p-0 px-4 mt-2">
                <table class="table align-items-center mb-0 w-100 table-hover table-striped">
                    <thead class="bg-light">
                        <tr>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">#</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Mã NV</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Họ &amp; Tên</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Bộ phận / Line</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Loại</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Từ ngày</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Đến ngày</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Số ngày</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Người sắp</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Ngày sắp</th>
                            <th class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-9">Trạng thái</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Ngày tiếp nhận</th>
                        </tr>
                    </thead>
                    <tbody id="logTableBody"></tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center px-4 mt-3 mb-2">
                <div id="paginationCount" class="text-sm text-secondary"></div>
                <nav><ul class="pagination pagination-sm mb-0" id="paginationBar"></ul></nav>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
const PAGE_URL = '@Url.Action("GetAssignmentLogPage", "Leave")';
let currentPage = 1, totalPages = 1, totalRecords = 0, pageSize = 50;
let pendingTotal = 0, confirmedTotal = 0, rejectedTotal = 0;

const LEAVE_LABEL = { AL:'Phép năm', CL:'BHXH', SL:'Bệnh', NPL:'Không lương', OTH:'Khác' };
const LEAVE_COLOR = { AL:'primary', CL:'info', SL:'danger', NPL:'secondary', OTH:'warning' };

function statusBadge(status) {
    if (status === 'CONFIRMED')       return `<span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Đã tiếp nhận thông tin</span>`;
    if (status === 'WORKER_REJECTED') return `<span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Không đồng ý</span>`;
    return `<span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Chưa tiếp nhận thông tin</span>`;
}

function buildRow(item, idx) {
    const lt = LEAVE_LABEL[item.LEAVE_TYPE] || item.LEAVE_TYPE || '-';
    const lc = LEAVE_COLOR[item.LEAVE_TYPE] || 'secondary';
    const dept = escHtml(item.DEPT_NAME||'');
    const line = item.LINE_NAME ? ' / ' + escHtml(item.LINE_NAME) : '';
    const assignerName = item.ASSIGNER_NAME ? escHtml(item.ASSIGNER_NAME).toUpperCase() : '';
    return `<tr>
        <td class="px-2 text-xs text-secondary">${idx}</td>
        <td class="px-2 text-sm font-monospace">${escHtml(item.EMPCD||'')}</td>
        <td class="px-2">
            <div class="vni-font" style="text-transform:uppercase;font-size:.9rem;">${escHtml(item.EMP_NAME||'')}</div>
        </td>
        <td class="px-2 text-xs text-secondary">${dept}${line}</td>
        <td class="px-2"><span class="badge bg-${lc}">${lt}</span></td>
        <td class="px-2 text-sm text-nowrap">${formatDate(item.FROM_DATE)}</td>
        <td class="px-2 text-sm text-nowrap">${formatDate(item.TO_DATE)}</td>
        <td class="px-2 text-sm fw-bold">${item.TOTAL_DAYS ?? '-'}</td>
        <td class="px-2">
            <div class="text-sm font-monospace">${escHtml(item.ASSIGNED_BY||'')}</div>
            <div class="text-xxs text-secondary vni-font">${assignerName}</div>
        </td>
        <td class="px-2 text-sm text-nowrap text-secondary">${formatDate(item.ASSIGN_DATE)}</td>
        <td class="text-center">${statusBadge(item.CONFIRM_STATUS)}</td>
        <td class="px-2 text-sm text-nowrap text-secondary">${item.CONFIRM_DATE ? formatDate(item.CONFIRM_DATE) : '<span class="text-muted">-</span>'}</td>
    </tr>`;
}

function getParams(page) {
    return {
        assigner_cd: $('#assignerInput').val().trim(),
        search:      $('#searchInput').val().trim(),
        status:      $('#filterStatus').val(),
        dept_id:     $('#filterDept').val(),
        line_id:     $('#filterLine').val(),
        work_id:     $('#filterWork').val(),
        date_from:   $('#filterDateFrom').val(),
        date_to:     $('#filterDateTo').val(),
        page,
        page_size:   pageSize
    };
}

function loadData(page = 1) {
    currentPage = page;
    $('#logTableBody').html(`<tr><td colspan="12" class="text-center py-5"><div class="spinner-border text-dark" role="status"></div></td></tr>`);
    $.ajax({
        url: PAGE_URL, type: 'GET', data: getParams(page),
        success: function(res) {
            if (!res.success) {
                $('#logTableBody').html(`<tr><td colspan="12" class="text-center text-danger py-4">Lỗi: ${res.message||''}</td></tr>`);
                return;
            }
            totalRecords = res.total      || 0;
            totalPages   = res.total_pages || 0;
            const data   = res.data || [];

            // compute inline summary from current page data (full summary would need extra API call)
            $('#sumTotal').text(totalRecords.toLocaleString());

            if (!data.length) {
                $('#logTableBody').html(`<tr><td colspan="12" class="text-center text-muted py-5">
                    <img src="@(new Random().Next(2)==0 ? Url.Content("~/assets/img/illustrations/A_nodata.png") : Url.Content("~/assets/img/illustrations/Chi_nodata.png"))" alt="" style="max-width:140px;display:block;margin:0 auto .5rem;opacity:.9;" />Không có dữ liệu</td></tr>`);
            } else {
                $('#logTableBody').html(data.map((item,i) => buildRow(item,(page-1)*pageSize+i+1)).join(''));
            }
            renderPagination();
        },
        error: function(xhr) {
            $('#logTableBody').html(`<tr><td colspan="12" class="text-center text-danger py-4">Lỗi kết nối (${xhr.status})</td></tr>`);
        }
    });
    // load summary counts separately with big page_size
    loadSummaryCounts();
}

function loadSummaryCounts() {
    ['ASSIGNED','CONFIRMED','WORKER_REJECTED'].forEach(st => {
        const p = getParams(1); p.status = st; p.page_size = 1;
        $.getJSON(PAGE_URL, p, function(res) {
            if (!res.success) return;
            if (st === 'ASSIGNED')        $('#sumPending').text((res.total||0).toLocaleString());
            if (st === 'CONFIRMED')       $('#sumConfirmed').text((res.total||0).toLocaleString());
            if (st === 'WORKER_REJECTED') $('#sumRejected').text((res.total||0).toLocaleString());
        });
    });
}

function renderPagination() {
    if (!totalRecords) { $('#paginationCount').text(''); $('#paginationBar').empty(); return; }
    const s=(currentPage-1)*pageSize+1, e=Math.min(currentPage*pageSize,totalRecords);
    $('#paginationCount').html(`<span class="text-xs">${s}-${e} / <strong>${totalRecords}</strong> bản ghi</span>`);
    const $bar=$('#paginationBar').empty();
    const mk=(label,p,disabled,active)=>{const li=$('<li class="page-item">').toggleClass('disabled',!!disabled).toggleClass('active',!!active);$('<a class="page-link">').html(label).on('click',()=>{if(!disabled&&!active)loadData(p);}).appendTo(li);return li;};
    $bar.append(mk('&lsaquo;',currentPage-1,currentPage<=1));
    let from=Math.max(1,currentPage-2),to=Math.min(totalPages,currentPage+2);
    for(let p=from;p<=to;p++) $bar.append(mk(p,p,false,p===currentPage));
    $bar.append(mk('&rsaquo;',currentPage+1,currentPage>=totalPages));
}

$('#filterDept').on('change', function() { $('#filterLine, #filterWork').val(null).trigger('change.select2'); loadData(1); });
$('#filterLine').on('change', function() { $('#filterWork').val(null).trigger('change.select2'); loadData(1); });
$('#filterStatus, #filterWork').on('change', () => loadData(1));
$('#searchInput, #assignerInput').on('input', debounce(() => loadData(1), 400));
$('#pageSizeSelect').on('change', function() { pageSize = parseInt($(this).val()); loadData(1); });

$('#exportBtn').on('click', async function() {
    const $btn = $(this), orig = $btn.html();
    $btn.prop('disabled',true).html('<span class="spinner-border spinner-border-sm me-1"></span> Đang xuất...');
    try {
        let rows=[], pg=1, pgTotal=1;
        do {
            const p = getParams(pg); p.page_size = 1000;
            const res = await $.getJSON(PAGE_URL, p);
            if (!res || !res.success) break;
            pgTotal = res.total_pages; rows = rows.concat(res.data||[]);
            pg++;
        } while (pg <= pgTotal);
        if (!rows.length) { showToast('Không có dữ liệu để xuất', 'warning'); return; }
        const headers = ['STT','Mã NV','Họ Tên','Bộ Phận','Line','Nhóm Việc','Loại','Từ ngày','Đến ngày','Số ngày','Người sắp lịch','Mã người sắp','Ngày sắp lịch','Trạng thái','Ngày xác nhận','Lý do'];
        let html = '<html><head><meta charset="utf-8"/></head><body><table border="1"><thead><tr>';
        html += headers.map(h=>`<th style="background:#e2e8f0;font-weight:bold">${h}</th>`).join('') + '</tr></thead><tbody>';
        rows.forEach((r,i) => {
            const lt = LEAVE_LABEL[r.LEAVE_TYPE]||r.LEAVE_TYPE||'';
            let st = r.STATUS||'';
            if (st==='ASSIGNED') st='Chưa tiếp nhận thông tin';
            else if (st==='CONFIRMED') st='Đã tiếp nhận thông tin';
            else if (st==='WORKER_REJECTED') st='Không đồng ý';
            html += `<tr>
                <td>${i+1}</td>
                <td style="mso-number-format:'@@'">${escHtml(r.EMPCD||'')}</td>
                <td>${escHtml(r.EMP_NAME||'')}</td>
                <td>${escHtml(r.DEPT_NAME||'')}</td>
                <td>${escHtml(r.LINE_NAME||'')}</td>
                <td>${escHtml(r.WORK_NAME||'')}</td>
                <td>${lt}</td>
                <td>${formatDate(r.FROM_DATE)}</td>
                <td>${formatDate(r.TO_DATE)}</td>
                <td>${r.TOTAL_DAYS??''}</td>
                <td>${escHtml(r.ASSIGNER_NAME||'')}</td>
                <td style="mso-number-format:'@@'">${escHtml(r.ASSIGNED_BY||'')}</td>
                <td>${formatDate(r.ASSIGN_DATE)}</td>
                <td>${st}</td>
                <td>${r.CONFIRM_DATE ? formatDate(r.CONFIRM_DATE) : ''}</td>
                <td>${escHtml(r.REASON||'')}</td>
            </tr>`;
        });
        html += '</tbody></table></body></html>';
        const blob=new Blob([html],{type:'application/vnd.ms-excel;charset=utf-8;'});
        const link=document.createElement('a'); link.href=URL.createObjectURL(blob);
        link.download=`LogSapLich_${$('#filterDateFrom').val()}_${$('#filterDateTo').val()}.xls`;
        link.click();
    } catch(err) { showToast('Lỗi xuất file: '+err.message, 'error'); }
    finally { $btn.prop('disabled',false).html(orig); }
});

function formatDate(s) { if(!s) return '-'; const d=new Date(s); if(isNaN(d)) return '-'; return('0'+d.getDate()).slice(-2)+'/'+('0'+(d.getMonth()+1)).slice(-2)+'/'+d.getFullYear(); }
function escHtml(str) { return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function debounce(fn,d) { let t; return function(){ clearTimeout(t); t=setTimeout(fn,d); }; }

$(document).ready(function() {
    if (typeof Select2Helper !== 'undefined') Select2Helper.init();
    loadData(1);
});
</script>
}
