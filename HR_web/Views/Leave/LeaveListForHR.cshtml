@{
    ViewData["Title"] = "Danh Sách Nghỉ Phép Toàn Công Ty";
    var dateFrom = (string)(ViewBag.DateFrom ?? DateTime.Today.AddMonths(-1).ToString("yyyy-MM-dd"));
    var dateTo   = (string)(ViewBag.DateTo   ?? DateTime.Today.AddMonths(2).ToString("yyyy-MM-dd"));
}

@section Styles {
<style>
    .stats-card .icon { width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; border-radius: 12px; }
    #lvTableBody tr td { vertical-align: middle; }
    .pagination .page-link { cursor: pointer; border-radius: 8px !important; margin: 0 2px; }
    .txt-clamp { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; max-width:160px; cursor:default; }
    .pagination .page-item.disabled .page-link { cursor: default; }
    @@media (max-width: 767px) {
        .container-fluid { padding-left: 8px !important; padding-right: 8px !important; }
    }
</style>
}

<div class="container-fluid py-4">
    <!-- Stats cards -->
    <div class="row mb-4">
        <div class="col-6 col-md-4 col-xl-2 mb-3 mb-xl-0">
            <div class="card stats-card" data-filter-status=""><div class="card-body p-3"><div class="row"><div class="col-8"><p class="text-sm mb-0 text-uppercase font-weight-bold text-secondary">Tổng</p><h5 class="font-weight-bolder mb-0" id="summaryTotal">-</h5></div><div class="col-4 text-end"><div class="icon bg-gradient-info text-white shadow-info ms-auto"><i class="bi bi-calendar-check fs-4"></i></div></div></div></div></div>
        </div>
        <div class="col-6 col-md-4 col-xl-2 mb-3 mb-xl-0">
            <div class="card stats-card" data-filter-status="PENDING"><div class="card-body p-3"><div class="row"><div class="col-8"><p class="text-sm mb-0 text-uppercase font-weight-bold text-warning">Chờ Duyệt</p><h5 class="font-weight-bolder mb-0" id="summaryPending">-</h5></div><div class="col-4 text-end"><div class="icon bg-gradient-warning text-white shadow-warning ms-auto"><i class="bi bi-hourglass-split fs-4"></i></div></div></div></div></div>
        </div>
        <div class="col-6 col-md-4 col-xl-2 mb-3 mb-xl-0">
            <div class="card stats-card" data-filter-status="APPROVED"><div class="card-body p-3"><div class="row"><div class="col-8"><p class="text-sm mb-0 text-uppercase font-weight-bold text-success">Đã Duyệt</p><h5 class="font-weight-bolder mb-0" id="summaryApproved">-</h5></div><div class="col-4 text-end"><div class="icon bg-gradient-success text-white shadow-success ms-auto"><i class="bi bi-check-circle-fill fs-4"></i></div></div></div></div></div>
        </div>
        <div class="col-6 col-md-4 col-xl-2 mb-3 mb-xl-0">
            <div class="card stats-card" data-filter-status="REJECTED"><div class="card-body p-3"><div class="row"><div class="col-8"><p class="text-sm mb-0 text-uppercase font-weight-bold text-danger">Từ Chối</p><h5 class="font-weight-bolder mb-0" id="summaryRejected">-</h5></div><div class="col-4 text-end"><div class="icon bg-gradient-danger text-white shadow-danger ms-auto"><i class="bi bi-x-circle-fill fs-4"></i></div></div></div></div></div>
        </div>
        <div class="col-6 col-md-4 col-xl-2 mb-3 mb-xl-0">
            <div class="card stats-card" data-filter-status="ASSIGNED"><div class="card-body p-3"><div class="row"><div class="col-8"><p class="text-sm mb-0 text-uppercase font-weight-bold text-secondary">Chờ Ký</p><h5 class="font-weight-bolder mb-0" id="summaryAssignedPending">-</h5><p class="text-xs text-muted mb-0">Sắp lịch</p></div><div class="col-4 text-end"><div class="icon bg-gradient-secondary text-white ms-auto"><i class="bi bi-pen fs-4"></i></div></div></div></div></div>
        </div>
        <div class="col-6 col-md-4 col-xl-2 mb-3 mb-xl-0">
            <!-- Không có data-filter-status: chưa có option "Đã ký/sắp lịch" riêng trong #filterStatus (cần thêm hỗ trợ backend) -->
            <div class="card stats-card"><div class="card-body p-3"><div class="row"><div class="col-8"><p class="text-sm mb-0 text-uppercase font-weight-bold text-success">Đã Ký</p><h5 class="font-weight-bolder mb-0" id="summaryAssignedConfirmed">-</h5><p class="text-xs text-muted mb-0">Sắp lịch</p></div><div class="col-4 text-end"><div class="icon bg-gradient-success text-white shadow-success ms-auto"><i class="bi bi-patch-check-fill fs-4"></i></div></div></div></div></div>
        </div>
    </div>

    <div class="card my-4">
        <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
            <div class="bg-gradient-success shadow-success border-radius-lg pt-3 pb-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h6 class="text-white mb-0"><i class="bi bi-building me-1"></i> Nghỉ Phép Toàn Công Ty</h6>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" id="exportBtn" class="btn btn-sm mb-0" style="background:#fff;color:#344767;font-weight:600;height:36px;">
                        <i class="bi bi-file-earmark-excel me-1"></i> Xuất Excel
                    </button>
                    <div class="d-flex align-items-center bg-white border-radius-md px-2 shadow-sm" style="height:34px;gap:4px;">
                        <i class="bi bi-calendar3 text-success"></i>
                        <input type="date" id="filterDateFrom" class="form-control form-control-sm border-0 bg-transparent text-dark p-0" style="width:115px;" value="@dateFrom" onchange="loadData(1)" />
                    </div>
                    <span class="text-white small">→</span>
                    <div class="d-flex align-items-center bg-white border-radius-md px-2 shadow-sm" style="height:34px;gap:4px;">
                        <i class="bi bi-calendar3 text-success"></i>
                        <input type="date" id="filterDateTo" class="form-control form-control-sm border-0 bg-transparent text-dark p-0" style="width:115px;" value="@dateTo" onchange="loadData(1)" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter bar -->
        <div class="px-3 pt-3 pb-2 d-flex flex-wrap align-items-end gap-2 filter-bar" style="background:#f8fafc;border-bottom:1px solid #e9ecef;">
            <div style="min-width:140px;flex:1 1 140px;max-width:180px;">
                <label class="form-label small fw-bold mb-1 text-primary">Mã NV</label>
                <input type="text" id="searchInput" class="form-control form-control-sm" placeholder="🔍 Tìm mã NV..." />
            </div>
            <div style="min-width:120px;flex:1 1 120px;max-width:160px;">
                <label class="form-label small fw-bold mb-1 text-primary">Tình Trạng</label>
                <select id="filterStatus" class="form-select form-select-sm">
                    <option value="">Tất cả</option>
                    <option value="PENDING">Chờ duyệt</option>
                    <option value="APPROVED">Đã duyệt</option>
                    <option value="REJECTED">Từ chối</option>
                    <option value="ASSIGNED">Sắp lịch</option>
                </select>
            </div>
            <div style="min-width:120px;flex:1 1 120px;max-width:160px;">
                <label class="form-label small fw-bold mb-1 text-primary">Nguồn</label>
                <select id="filterSource" class="form-select form-select-sm">
                    <option value="">Tất cả</option>
                    <option value="SELF">Tự nộp</option>
                    <option value="ASSIGNED">Sắp lịch</option>
                </select>
            </div>
            <div style="min-width:130px;flex:1 1 130px;max-width:170px;">
                <label class="form-label small fw-bold mb-1 text-primary">Loại nghỉ</label>
                <select id="filterLeaveType" class="form-select form-select-sm">
                    <option value="">Tất cả</option>
                    <option value="AL">Phép năm (AL)</option>
                    <option value="NL">Không lương (NL)</option>
                    <option value="SI">Bệnh có giấy (SI)</option>
                    <option value="DT">Đám tang (DT)</option>
                    <option value="DC">Đám cưới (DC)</option>
                    <option value="CT">Công tác (CT)</option>
                    <option value="VS">Vợ sanh (VS)</option>
                    <option value="DS">Dưỡng sức (DS)</option>
                    <option value="KT">Khám thai (KT)</option>
                </select>
            </div>
            <div style="min-width:150px;flex:2 1 150px;max-width:220px;">
                <label class="form-label small fw-bold mb-1 text-primary">Bộ Phận</label>
                <select id="filterDept" class="select2 form-control"
                        data-url="@Url.Action("GetDept", "Dropdown")"
                        data-placeholder="Tất cả"></select>
            </div>
            <div style="min-width:140px;flex:2 1 140px;max-width:200px;">
                <label class="form-label small fw-bold mb-1 text-primary">Line</label>
                <select id="filterLine" class="select2 form-control"
                        data-url="@Url.Action("GetLine", "Dropdown")"
                        data-parent="#filterDept"
                        data-placeholder="Tất cả"></select>
            </div>
            <div style="min-width:140px;flex:2 1 140px;max-width:200px;">
                <label class="form-label small fw-bold mb-1 text-primary">Nhóm Việc</label>
                <select id="filterWork" class="select2 form-control"
                        data-url="@Url.Action("GetWork", "Dropdown")"
                        data-parent="#filterLine"
                        data-parent-key="lineCd"
                        data-parent2="#filterDept"
                        data-parent2-key="deptCd"
                        data-placeholder="Tất cả"></select>
            </div>
            <div class="d-flex align-items-end gap-2 ms-auto">
                <div>
                    <label class="form-label small fw-bold mb-1 text-secondary">Hiển thị</label>
                    <select id="pageSizeSelect" class="form-select form-select-sm" style="width:80px;">
                        <option value="50" selected>50</option>
                        <option value="100">100</option>
                        <option value="500">500</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="card-body px-0 pt-0 pb-2 mt-1">
            <div class="table-responsive p-0 px-4">
                <table class="table align-items-center mb-0 w-100 table-hover table-striped">
                    <thead class="bg-light">
                        <tr>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">#</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Mã NV</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Họ &amp; Tên</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Loại nghỉ</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Nguồn</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Từ ngày</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Đến ngày</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Số ngày</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Lý do</th>
                            <th class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-9">Tình Trạng</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Người duyệt / Người sắp</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Ghi chú</th>
                            <th class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Giấy tờ</th>
                        </tr>
                    </thead>
                    <tbody id="lvTableBody"></tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center px-4 mt-3 mb-2">
                <div id="paginationCount" class="text-sm text-secondary"></div>
                <nav><ul class="pagination pagination-sm mb-0" id="paginationBar"></ul></nav>
            </div>
        </div>
    </div>
</div>

<!-- Xác nhận đã nộp giấy tờ -->
<div class="modal fade" id="docConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title mb-0"><i class="bi bi-check-circle text-success me-1"></i> Xác nhận đã nộp giấy tờ</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0" style="font-size:.85rem;">Xác nhận đã nhận giấy tờ của nhân viên này?</p>
            </div>
            <div class="modal-footer py-2">
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Huỷ</button>
                <button class="btn btn-success btn-sm" id="docConfirmOkBtn">Xác nhận</button>
            </div>
        </div>
    </div>
</div>

<!-- Yêu cầu nộp lại giấy tờ -->
<div class="modal fade" id="docResubmitModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title mb-0"><i class="bi bi-arrow-repeat text-warning me-1"></i> Yêu cầu nộp lại giấy tờ</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <label class="form-label small fw-bold mb-1">Lý do</label>
                <textarea id="docResubmitRemark" class="form-control form-control-sm" rows="3" maxlength="200" placeholder="Nhập lý do yêu cầu nộp lại..."></textarea>
            </div>
            <div class="modal-footer py-2">
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Huỷ</button>
                <button class="btn btn-warning btn-sm" id="docResubmitOkBtn">Gửi yêu cầu</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/vendor/xlsx.full.min.js" asp-append-version="true"></script>
<script src="~/js/xlsx-export-helper.js" asp-append-version="true"></script>
<script>
const PAGE_URL = '@Url.Action("GetHRListPage", "Leave")';
let currentPage = 1, totalPages = 1, totalRecords = 0, pageSize = 50;

const LEAVE_LABEL = { AL:'Phép năm', CL:'BHXH', SL:'Bệnh', NPL:'Không lương', OTH:'Khác', NL:'Không lương', SI:'Bệnh có giấy', DT:'Đám tang', DC:'Đám cưới', CT:'Công tác', VS:'Vợ sanh', DS:'Dưỡng sức', KT:'Khám thai' };
const LEAVE_COLOR = { AL:'primary', CL:'info', SL:'danger', NPL:'secondary', OTH:'warning', NL:'secondary', SI:'danger', DT:'dark', DC:'danger', CT:'info', VS:'primary', DS:'warning', KT:'warning' };
const DOC_REQUIRED_TYPES = ['SI', 'DT', 'DC', 'VS', 'DS', 'KT'];
const DOC_STATUS_LABEL   = { SUBMITTED: 'Đã nộp', RESUBMIT_REQUESTED: 'Yêu cầu nộp lại' };
const DOC_STATUS_COLOR   = { SUBMITTED: 'success', RESUBMIT_REQUESTED: 'warning' };

function docCell(item) {
    if (!DOC_REQUIRED_TYPES.includes(item.LEAVE_TYPE)) return '<span class="text-muted">-</span>';
    const st    = item.DOC_STATUS || null;
    const badge = `<span class="badge bg-${DOC_STATUS_COLOR[st] || 'secondary'}">${DOC_STATUS_LABEL[st] || 'Chưa nộp'}</span>`;
    const btns  = st === 'SUBMITTED'
        ? `<button class="btn btn-outline-warning btn-sm py-0 px-1 mt-1" style="font-size:.68rem;" onclick="requestDocResubmit('${item.REQUEST_ID}')">Yêu cầu nộp lại</button>`
        : `<button class="btn btn-outline-success btn-sm py-0 px-1 mt-1" style="font-size:.68rem;" onclick="markDocSubmitted('${item.REQUEST_ID}')">Cập nhật đã nộp</button>`;
    return `<div class="d-flex flex-column align-items-center gap-1">${badge}${btns}</div>`;
}

let _docPendingRequestId = null;
const docConfirmModal  = new bootstrap.Modal(document.getElementById('docConfirmModal'));
const docResubmitModal = new bootstrap.Modal(document.getElementById('docResubmitModal'));

function markDocSubmitted(requestId) {
    _docPendingRequestId = requestId;
    docConfirmModal.show();
}
document.getElementById('docConfirmOkBtn').addEventListener('click', async () => {
    docConfirmModal.hide();
    const res = await $.post('@Url.Action("MarkDocSubmitted", "Leave")', { requestId: _docPendingRequestId });
    showToast(res.message || (res.success ? 'Đã cập nhật' : 'Có lỗi'), res.success ? 'success' : 'error');
    if (res.success) loadData(currentPage);
});

function requestDocResubmit(requestId) {
    _docPendingRequestId = requestId;
    document.getElementById('docResubmitRemark').value = '';
    docResubmitModal.show();
}
document.getElementById('docResubmitOkBtn').addEventListener('click', async () => {
    const remark = document.getElementById('docResubmitRemark').value.trim();
    docResubmitModal.hide();
    const res = await $.post('@Url.Action("RequestDocResubmit", "Leave")', { requestId: _docPendingRequestId, remark });
    showToast(res.message || (res.success ? 'Đã gửi yêu cầu' : 'Có lỗi'), res.success ? 'success' : 'error');
    if (res.success) loadData(currentPage);
});

function statusBadge(item) {
    const s = item.STATUS, src = item.SOURCE, cs = item.CONFIRM_STATUS;
    if (src === 'ASSIGNED') {
        if (cs === 'CONFIRMED')       return `<span class="badge bg-success">Đã xác nhận</span>`;
        if (cs === 'WORKER_REJECTED') return `<span class="badge bg-danger">CN từ chối</span>`;
        return `<span class="badge bg-info text-dark">Chờ xác nhận</span>`;
    }
    if (s === 'PENDING')  return `<span class="badge bg-warning text-dark">Chờ duyệt</span>`;
    if (s === 'APPROVED') return `<span class="badge bg-success">Đã duyệt</span>`;
    if (s === 'REJECTED') return `<span class="badge bg-danger">Từ chối</span>`;
    return `<span class="badge bg-secondary">${escHtml(s||'-')}</span>`;
}

function buildRow(item, idx) {
    const ltLabel   = LEAVE_LABEL[item.LEAVE_TYPE] || item.LEAVE_TYPE || '-';
    const ltColor   = LEAVE_COLOR[item.LEAVE_TYPE] || 'secondary';
    const isAssigned = item.SOURCE === 'ASSIGNED';
    const approver  = isAssigned
        ? escHtml(item.ASSIGNED_BY || '-')
        : escHtml(item.FINAL_APPROVER || '-');
    const approverLbl = isAssigned ? 'Người sắp: ' : '';
    const signDate  = isAssigned ? item.CREATED_DATE : item.FINAL_DATE;
    const signLbl   = isAssigned ? 'Ngày sắp: ' : '';
    const signTime  = signDate ? `<div class="text-xxs text-secondary">${signLbl}${formatDate(signDate)}</div>` : '';
    const srcBadge  = item.SOURCE === 'ASSIGNED'
        ? `<span class="badge" style="background:#e0f2fe;color:#0369a1;">Sắp lịch</span>`
        : `<span class="badge bg-light text-dark border">Tự nộp</span>`;
    return `<tr>
        <td class="px-2 text-xs text-secondary">${idx}</td>
        <td class="px-2 text-sm">${escHtml(item.EMPCD||'')}</td>
        <td class="px-2">
            <div class="emp-name vni-font" style="text-transform:uppercase;font-size:.9rem;">${escHtml(item.EMP_NAME||'')}</div>
            <div class="text-xxs text-secondary">${escHtml(item.DEPT_NAME||'')}${item.LINE_NAME ? ' · '+escHtml(item.LINE_NAME) : ''}</div>
        </td>
        <td class="px-2"><span class="badge bg-${ltColor}">${ltLabel}</span></td>
        <td class="px-2">${srcBadge}</td>
        <td class="px-2 text-sm text-nowrap">${formatDate(item.FROM_DATE)}</td>
        <td class="px-2 text-sm text-nowrap">${formatDate(item.TO_DATE)}</td>
        <td class="px-2 text-sm fw-bold">${item.TOTAL_DAYS ?? '-'}</td>
        <td class="px-2 text-sm"><div class="txt-clamp" title="${escHtml(item.REASON||'')}">${escHtml(item.REASON||'-')}</div></td>
        <td class="text-center">${statusBadge(item)}</td>
        <td class="px-2">
            <div class="emp-name vni-font" style="text-transform:uppercase;font-size:.9rem;">${approverLbl ? `<span class="text-xxs text-secondary text-lowercase vni-font" style="text-transform:none;">${approverLbl}</span>` : ''}${approver}</div>
            ${signTime}
        </td>
        <td class="px-2 text-sm"><div class="txt-clamp" title="${escHtml(item.REMARK||'')}">${escHtml(item.REMARK||'-')}</div></td>
        <td class="text-center px-2">${docCell(item)}</td>
    </tr>`;
}

function getParams(page) {
    return {
        status:     $('#filterStatus').val(),
        source:     $('#filterSource').val(),
        leave_type: $('#filterLeaveType').val(),
        search:    $('#searchInput').val(),
        dept_id:   $('#filterDept').val(),
        line_id:   $('#filterLine').val(),
        work_id:   $('#filterWork').val(),
        date_from: $('#filterDateFrom').val(),
        date_to:   $('#filterDateTo').val(),
        page,
        page_size: pageSize
    };
}

function loadData(page = 1) {
    currentPage = page;
    $('#lvTableBody').html(`<tr><td colspan="13" class="text-center py-5"><div class="spinner-border text-success" role="status"></div></td></tr>`);
    $.ajax({
        url: PAGE_URL, type: 'GET', data: getParams(page),
        success: function(res) {
            if (!res.success) {
                $('#lvTableBody').html(`<tr><td colspan="13" class="text-center text-danger py-4">Lỗi: ${res.message||''}</td></tr>`);
                return;
            }
            const s = res.summary || {};
            $('#summaryTotal').text((s.TOTAL||0).toLocaleString());
            $('#summaryPending').text((s.PENDING||0).toLocaleString());
            $('#summaryApproved').text((s.APPROVED||0).toLocaleString());
            $('#summaryRejected').text((s.REJECTED||0).toLocaleString());
            $('#summaryAssignedPending').text((s.ASSIGNED_PENDING||0).toLocaleString());
            $('#summaryAssignedConfirmed').text((s.ASSIGNED_CONFIRMED||0).toLocaleString());
            totalRecords = res.total || 0;
            totalPages   = res.total_pages || 0;
            const data   = res.data || [];
            if (!data.length) {
                $('#lvTableBody').html(`<tr><td colspan="13" class="text-center text-muted py-4"><img src="@(new Random().Next(2)==0 ? Url.Content("~/assets/img/illustrations/A_nodata.png") : Url.Content("~/assets/img/illustrations/Chi_nodata.png"))" alt="" style="max-width:140px;display:block;margin:0 auto .5rem;opacity:.9;" />Không có dữ liệu</td></tr>`);
            } else {
                $('#lvTableBody').html(data.map((item,i) => buildRow(item,(page-1)*pageSize+i+1)).join(''));
            }
            renderPagination();
        },
        error: function(xhr) {
            $('#lvTableBody').html(`<tr><td colspan="13" class="text-center text-danger py-4">Lỗi kết nối (${xhr.status})</td></tr>`);
        }
    });
}

function renderPagination() {
    if (!totalRecords) { $('#paginationCount').text(''); $('#paginationBar').empty(); return; }
    const s=(currentPage-1)*pageSize+1, e=Math.min(currentPage*pageSize,totalRecords);
    $('#paginationCount').html(`<span class="text-xs">${s}-${e} / <strong>${totalRecords}</strong> phiếu</span>`);
    const $bar=$('#paginationBar').empty();
    const mk=(label,p,disabled,active)=>{const li=$('<li class="page-item">').toggleClass('disabled',!!disabled).toggleClass('active',!!active);$('<a class="page-link">').html(label).on('click',()=>{if(!disabled&&!active)loadData(p);}).appendTo(li);return li;};
    $bar.append(mk('&lsaquo;',currentPage-1,currentPage<=1));
    let from=Math.max(1,currentPage-2),to=Math.min(totalPages,currentPage+2);
    for(let p=from;p<=to;p++) $bar.append(mk(p,p,false,p===currentPage));
    $bar.append(mk('&rsaquo;',currentPage+1,currentPage>=totalPages));
}

$('#filterDept').on('change', function() { $('#filterLine, #filterWork').val(null).trigger('change.select2'); loadData(1); });
$('#filterLine').on('change', function() { $('#filterWork').val(null).trigger('change.select2'); loadData(1); });
$('#filterStatus, #filterSource, #filterLeaveType, #filterWork').on('change', () => loadData(1));
$('#searchInput').on('input', debounce(() => loadData(1), 400));
$('#pageSizeSelect').on('change', function() { pageSize = parseInt($(this).val()); loadData(1); });

$('#exportBtn').on('click', async function() {
    const $btn = $(this), orig = $btn.html();
    $btn.prop('disabled',true).html('<span class="spinner-border spinner-border-sm me-1"></span> Đang xuất...');
    try {
        let rows=[], pg=1, pgTotal=1;
        do {
            const p = getParams(pg); p.page_size = 1000;
            const res = await $.getJSON(PAGE_URL, p);
            if (!res || !res.success) break;
            pgTotal = res.total_pages; rows = rows.concat(res.data||[]);
            pg++;
        } while (pg <= pgTotal);
        if (!rows.length) { showToast('Không có dữ liệu để xuất', 'warning'); return; }
        const headers = ['STT','Mã NV','Họ Tên','Bộ Phận','Line','Loại','Nguồn','Từ ngày','Đến ngày','Số ngày','Lý do','Tình trạng','Người duyệt / Người sắp','Ngày duyệt / Ngày sắp','Ghi chú','Giấy tờ'];
        let html = '<html><head><meta charset="utf-8"/></head><body><table border="1"><thead><tr>';
        html += headers.map(h=>`<th style="background:#bbf7d0;font-weight:bold">${h}</th>`).join('') + '</tr></thead><tbody>';
        rows.forEach((r,i) => {
            const lt  = LEAVE_LABEL[r.LEAVE_TYPE]||r.LEAVE_TYPE||'';
            const src = r.SOURCE==='ASSIGNED'?'Sắp lịch':'Tự nộp';
            let st = r.STATUS||'';
            if (r.SOURCE==='ASSIGNED') {
                if (st==='ASSIGNED') st='Chờ xác nhận';
                else if (st==='CONFIRMED') st='Đã xác nhận';
                else if (st==='WORKER_REJECTED') st='CN từ chối';
            } else {
                if (st==='PENDING') st='Chờ duyệt';
                else if (st==='APPROVED') st='Đã duyệt';
                else if (st==='REJECTED') st='Từ chối';
            }
            const signerName = r.SOURCE==='ASSIGNED' ? (r.ASSIGNED_BY||'') : (r.FINAL_APPROVER||'');
            const signerDate = r.SOURCE==='ASSIGNED' ? r.CREATED_DATE : r.FINAL_DATE;
            const docTxt = DOC_REQUIRED_TYPES.includes(r.LEAVE_TYPE) ? (DOC_STATUS_LABEL[r.DOC_STATUS] || 'Chưa nộp') : '-';
            html += `<tr><td>${i+1}</td><td data-t="s">${escHtml(r.EMPCD||'')}</td><td>${escHtml(r.EMP_NAME||'')}</td><td>${escHtml(r.DEPT_NAME||'')}</td><td>${escHtml(r.LINE_NAME||'')}</td><td>${lt}</td><td>${src}</td><td>${formatDate(r.FROM_DATE)}</td><td>${formatDate(r.TO_DATE)}</td><td>${r.TOTAL_DAYS??''}</td><td>${escHtml(r.REASON||'')}</td><td>${st}</td><td>${escHtml(signerName)}</td><td>${formatDate(signerDate)}</td><td>${escHtml(r.REMARK||'')}</td><td>${docTxt}</td></tr>`;
        });
        html += '</tbody></table></body></html>';
        exportHtmlTableToXlsx(html, `NghiPhep_${$('#filterDateFrom').val()}_${$('#filterDateTo').val()}.xlsx`);
    } catch(err) { showToast('Lỗi xuất file: '+err.message, 'error'); }
    finally { $btn.prop('disabled',false).html(orig); }
});

function formatDate(s) { if(!s) return '-'; const d=new Date(s); if(isNaN(d)) return '-'; return('0'+d.getDate()).slice(-2)+'/'+('0'+(d.getMonth()+1)).slice(-2)+'/'+d.getFullYear(); }
function escHtml(str) { return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function debounce(fn,d) { let t; return function(){ clearTimeout(t); t=setTimeout(fn,d); }; }

$(document).ready(function() {
    if (typeof Select2Helper !== 'undefined') Select2Helper.init();
    loadData(1);
});
