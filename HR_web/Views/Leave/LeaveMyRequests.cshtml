function setSource(src) {
    currentSource = src;
    ['all','self','assigned'].forEach(k => document.getElementById('tab-'+k).classList.remove('active'));
    const key = src === '' ? 'all' : src.toLowerCase();
    document.getElementById('tab-'+key).classList.add('active');
    loadData(1);
}

function loadData(page = 1) {
    currentPage = page;
    const spinner = `<tr><td colspan="10" class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></td></tr>`;
    $('#lvTableBody').html(spinner);
    $('#lvCardList').html('<div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>');
    const range = getMonthRange();
    const data = { page, page_size: pageSize, date_from: range.from, date_to: range.to };
    if (currentSource) data.source = currentSource;
    $.ajax({
        url: PAGE_URL, type: 'GET', data,
        success: function(res) {
            if (!res.success) {
                $('#lvTableBody').html(`<tr><td colspan="10" class="text-center text-danger py-4">Lỗi: ${res.message||''}</td></tr>`);
                $('#lvCardList').html(`<div class="text-center text-danger py-4">Lỗi: ${escHtml(res.message||'')}</div>`);
                return;
            }
            totalRecords = res.total || 0;
            totalPages   = res.total_pages || 0;
            const rows   = res.data || [];
            if (!rows.length) {
                $('#lvTableBody').html(emptyRow('Không có đơn nghỉ nào trong tháng này'));
                $('#lvCardList').html(emptyDiv('Không có đơn nghỉ nào trong tháng này'));
            } else {
                $('#lvTableBody').html(rows.map((r,i) => buildRow(r,(page-1)*pageSize+i+1)).join(''));
                $('#lvCardList').html(rows.map((r,i) => buildCard(r,(page-1)*pageSize+i+1)).join(''));
            }
            renderPagination();
        },
        error: function(xhr) {
            const err = `Lỗi kết nối (${xhr.status})`;
            $('#lvTableBody').html(`<tr><td colspan="10" class="text-center text-danger py-4">${err}</td></tr>`);
            $('#lvCardList').html(`<div class="text-center text-danger py-4">${err}</div>`);
        }
    });
}

function renderPagination() {
    if (!totalRecords) { $('#paginationCount').text(''); $('#paginationBar').empty(); return; }
    const s=(currentPage-1)*pageSize+1, e=Math.min(currentPage*pageSize,totalRecords);
    $('#paginationCount').html(`<span class="text-xs">${s}-${e} / <strong>${totalRecords}</strong> phiếu</span>`);
    const $bar=$('#paginationBar').empty();
    const mk=(label,p,disabled,active)=>{const li=$('<li class="page-item">').toggleClass('disabled',!!disabled).toggleClass('active',!!active);$('<a class="page-link">').html(label).on('click',()=>{if(!disabled&&!active)loadData(p);}).appendTo(li);return li;};
    $bar.append(mk('&lsaquo;',currentPage-1,currentPage<=1));
    let from=Math.max(1,currentPage-2),to=Math.min(totalPages,currentPage+2);
    for(let p=from;p<=to;p++) $bar.append(mk(p,p,false,p===currentPage));
    $bar.append(mk('&rsaquo;',currentPage+1,currentPage>=totalPages));
}

function addDaysStr(dateStr, n) {
    const p = dateStr.split('-');
    const d = new Date(Date.UTC(+p[0], +p[1]-1, +p[2]));
    d.setUTCDate(d.getUTCDate() + n);
    return d.toISOString().slice(0, 10);
}

// Min ngày được chọn PHỤ THUỘC loại nghỉ đang chọn — gọi lại mỗi khi đổi loại nghỉ, KHÔNG áp
// dụng cứng deadline của AL cho mọi loại (bug cũ: chọn NL/SI/DT... sau khi mở modal vẫn bị khoá
// min = ngày mai do lần check AL lúc mở modal, dù các loại này được phép chọn hôm nay).
//   - AL: theo giờ ca làm hôm nay (deadline -6h), có thể bị đẩy sang ngày mai.
//   - DC/DS: tối thiểu hôm nay + 3 ngày.
//   - NL: trước giờ vào ca hôm nay — ca đã bắt đầu thì dời sang ngày mai (bug thật đã báo:
//     UI vẫn cho chọn hôm nay dù ca đã bắt đầu lúc 7h30, server chặn nhưng UI không báo trước).
//   - DT/VS/KT: trước giờ hết ca hôm nay — hết ca thì dời sang ngày mai.
//   - SI/CT: cho chọn ngay hôm nay, không giới hạn giờ.
const SAME_DAY_DEADLINE_TYPES = ['NL', 'DT', 'VS', 'KT'];
async function updateCreateDateMin() {
    const createLT = $('#createLeaveType').val() || 'AL';
    const today = localDateStr();
    let minDate = today;

    if (createLT === 'AL') {
        try {
            const dl = await $.ajax({ url: '@Url.Action("AlDeadline", "Leave")', type: 'GET', data: { from_date: today } });
            // NV đổi loại nghỉ trong lúc đang chờ AJAX (đổi sang NL/SI...) → bỏ qua kết quả trễ
            // này, tránh nó ghi đè nhầm lại min=ngày mai lên loại vừa đổi.
            if ($('#createLeaveType').val() !== createLT) return;
            if (dl && dl.success !== false && dl.allowed === false) minDate = addDaysStr(today, 1);
        } catch (e) { /* silent — server-side sẽ chặn lại nếu client miss */ }
    } else if (createLT === 'DC' || createLT === 'DS') {
        minDate = addDaysStr(today, 3);
    } else if (SAME_DAY_DEADLINE_TYPES.includes(createLT)) {
        try {
            const dl = await $.ajax({ url: '@Url.Action("SameDayDeadline", "Leave")', type: 'GET', data: { leave_type: createLT, from_date: today } });
            if ($('#createLeaveType').val() !== createLT) return; // đổi loại trong lúc chờ AJAX
            if (dl && dl.success !== false && dl.allowed === false) minDate = addDaysStr(today, 1);
        } catch (e) { /* silent — server-side sẽ chặn lại nếu client miss */ }
    }

    $('#createFromDate').attr('min', minDate);
    if ($('#createFromDate').val() < minDate) $('#createFromDate').val(minDate);
    $('#createToDate').attr('min', minDate);
    if ($('#createToDate').val() < minDate) $('#createToDate').val(minDate);
    calcCreateDays();
}
document.getElementById('createLeaveType')?.addEventListener('change', updateCreateDateMin);

async function openCreateModal() {
    const today = localDateStr();
    $('#createFromDate').val(today);
    $('#createToDate').val(today);
    $('#createTotalDays').val(1);
    $('#createReason').val('').trigger('input');
    $('#createError').addClass('d-none').text('');
    $('#createLeaveType').val('AL').trigger('change'); // trigger 'change' tự gọi updateCreateDateMin
    new bootstrap.Modal('#createModal').show();
}

function datesOverlap(f1, t1, f2, t2) { return f1 <= t2 && t1 >= f2; }

const canTakeSundayLeave = @(ViewBag.CanTakeSundayLeave == true ? "true" : "false");

function isSunday(dateStr) {
    if (!dateStr) return false;
    const p = dateStr.split('-');
    return new Date(Date.UTC(+p[0], +p[1]-1, +p[2])).getUTCDay() === 0;
}
function countDaysNoSunday(fromStr, toStr) {
    const p1 = fromStr.split('-'), p2 = toStr.split('-');
    let cur = new Date(Date.UTC(+p1[0], +p1[1]-1, +p1[2]));
    const end = new Date(Date.UTC(+p2[0], +p2[1]-1, +p2[2]));
    let count = 0;
    while (cur <= end) {
        if (canTakeSundayLeave || cur.getUTCDay() !== 0) count++;
        cur.setUTCDate(cur.getUTCDate() + 1);
    }
    return count;
}
function showDateError(errId, msg, focusId) {
    $('#'+errId).removeClass('d-none').text(msg);
    if (focusId) setTimeout(() => $('#'+focusId).focus(), 50);
}

function calcCreateDays() {
    const f = $('#createFromDate').val(), t = $('#createToDate').val();
    if (!canTakeSundayLeave && f && isSunday(f)) {
        $('#createFromDate').val('');
        showDateError('createError', 'Từ ngày không được là Chủ Nhật (công ty làm T2–T7)', 'createFromDate');
        return;
    }
    if (!canTakeSundayLeave && t && isSunday(t)) {
        $('#createToDate').val('');
        showDateError('createError', 'Đến ngày không được là Chủ Nhật (công ty làm T2–T7)', 'createToDate');
        return;
    }
    $('#createError').addClass('d-none').text('');
    if (f) $('#createToDate').attr('min', f);
    if (f && t) {
        if (t < f) { $('#createToDate').val(f); }
        const tFinal = $('#createToDate').val();
        const diff = countDaysNoSunday(f, tFinal);
        if (diff > 0) $('#createTotalDays').val(diff);
    }
}

// Popup xác nhận trước khi gửi đơn cho mọi loại nghỉ TRỪ AL và CT — mục đích tránh công nhân
// chọn nhầm loại nghỉ mà không biết hậu quả. Dùng LẠI đúng phân loại ALWAYS_LOSE_TYPES/
// COND_LOSE_TYPES (đã dùng cho note bên dưới dropdown) để 2 chỗ luôn khớp nhau:
//   - NL: mất chuyên cần + 1 ngày lương.
//   - SI/DS (ALWAYS_LOSE_TYPES trừ NL): mất chuyên cần + mất ngày công, KHÔNG PHỤ THUỘC có
//     nộp giấy tờ hay không (SI có giấy bệnh vẫn mất, DS luôn mất).
//   - DT/DC/VS/KT (COND_LOSE_TYPES): chỉ mất chuyên cần NẾU không nộp giấy tờ đúng hạn.
function confirmLeaveWarning(leaveType) {
    return new Promise(resolve => {
        const $text = $('#leaveWarnText');
        const askLine = 'Bạn chắc chắn nộp phép loại phép này (<strong>KHÔNG PHẢI PHÉP NĂM</strong>) chứ?';
        if (leaveType === 'NL') {
            $text.html(askLine + '<br>Loại nghỉ này sẽ <strong class="text-danger">mất chuyên cần và 1 ngày lương</strong>.');
        } else if (ALWAYS_LOSE_TYPES.includes(leaveType)) {
            $text.html(askLine + '<br>Loại nghỉ này sẽ <strong class="text-danger">mất chuyên cần và mất ngày công</strong>, dù bạn có nộp giấy tờ chứng minh hay không.');
        } else {
            $text.html(askLine + '<br>Nghỉ phép này sẽ <strong class="text-danger">mất chuyên cần</strong> nếu bạn không nộp giấy tờ chứng minh cho phòng Nhân sự.');
        }
        const modalEl = document.getElementById('leaveWarnModal');
        const modal = new bootstrap.Modal(modalEl);
        const $ok = $('#leaveWarnOkBtn'), $cancel = $('#leaveWarnCancelBtn');
        const cleanup = () => { $ok.off('click'); $cancel.off('click'); };
        $ok.one('click', () => { cleanup(); modal.hide(); resolve(true); });
        $cancel.one('click', () => { cleanup(); modal.hide(); resolve(false); });
        modal.show();
    });
}

async function saveCreate() {
    const today  = localDateStr();
    const from   = $('#createFromDate').val();
    const to     = $('#createToDate').val();
    const days   = parseFloat($('#createTotalDays').val());
    const reason = $('#createReason').val().trim();
    if (!from || !to)       { $('#createError').removeClass('d-none').text('Vui lòng chọn ngày'); return; }
    if (from < today)       { $('#createError').removeClass('d-none').text('Không được chọn ngày trong quá khứ'); $('#createFromDate').focus(); return; }
    if (!canTakeSundayLeave && isSunday(from)) { $('#createError').removeClass('d-none').text('Từ ngày không được là Chủ Nhật (công ty làm T2–T7)'); $('#createFromDate').focus(); return; }
    if (!canTakeSundayLeave && isSunday(to))   { $('#createError').removeClass('d-none').text('Đến ngày không được là Chủ Nhật (công ty làm T2–T7)'); $('#createToDate').focus(); return; }
    if (to < from)          { $('#createError').removeClass('d-none').text('Đến ngày phải lớn hơn hoặc bằng Từ ngày'); $('#createToDate').focus(); return; }
    if (!days || days <= 0) { $('#createError').removeClass('d-none').text('Số ngày nghỉ không hợp lệ'); return; }

    const createLT = $('#createLeaveType').val() || 'AL';
    if (createLT !== 'AL' && !reason) { $('#createError').removeClass('d-none').text('Vui lòng nhập lý do nghỉ phép'); $('#createReason').focus(); return; }

    // AL deadline: STIME ca ngày FROM_DATE - 7.5h (fair cho ca đêm).
    // Server sẽ check lại — client chỉ để UX sớm.
    if (createLT === 'AL') {
        try {
            const dl = await $.ajax({ url: '@Url.Action("AlDeadline", "Leave")', type: 'GET', data: { from_date: from } });
            if (dl.success === false || dl.allowed === false) {
                const msg = dl.message || 'Đã qua giờ đăng ký phép năm cho ngày này';
                $('#createError').removeClass('d-none').text(msg);
                $('#createFromDate').focus(); return;
            }
        } catch (e) {
            // network fail → fallback: chặn xin cho hôm nay/quá khứ (giữ luật cũ)
            if (from <= today) {
                $('#createError').removeClass('d-none').text('Phép năm phải đăng ký trước ít nhất 1 ngày');
                $('#createFromDate').focus(); return;
            }
        }
    } else if (createLT === 'DC' || createLT === 'DS') {
        const d = new Date(); d.setDate(d.getDate() + 3);
        const minDcStr = d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2);
        if (from < minDcStr) {
            $('#createError').removeClass('d-none').text('Loại nghỉ này phải đăng ký trước ít nhất 3 ngày');
            $('#createFromDate').focus(); return;
        }
    }
    if (createLT === 'AL' && myBalance != null) {
        const left = myBalance.LEFT_NUM ?? 0;
        if (days > left) {
            $('#createError').removeClass('d-none').html(
                `Bạn chỉ còn <strong>${left} ngày</strong> phép năm, không đủ để nghỉ <strong>${days} ngày</strong>.<br>` +
                `<small class="text-muted">Vui lòng điều chỉnh số ngày hoặc chọn loại nghỉ khác.</small>`
            );
            return;
        }
    }

    // Xác nhận hậu quả trước khi gửi — mọi loại trừ AL và CT (CT không mất chuyên cần/lương).
    if (createLT !== 'AL' && createLT !== 'CT') {
        const ok = await confirmLeaveWarning(createLT);
        if (!ok) return;
    }

    const $btn = $('#saveCreateBtn').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Đang kiểm tra...');
    $('#createError').addClass('d-none').text('');
    try {
        // Check overlap with existing requests for the selected date range
        const checkRes = await $.ajax({ url: PAGE_URL, type: 'GET', data: { page: 1, page_size: 100, date_from: from, date_to: to } });
        if (checkRes.success && checkRes.data?.length) {
            const conflict = checkRes.data.find(r => {
                const rFrom = (r.FROM_DATE || '').slice(0, 10);
                const rTo   = (r.TO_DATE   || '').slice(0, 10);
                if (!rFrom || !rTo || !datesOverlap(from, to, rFrom, rTo)) return false;
                return (r.SOURCE !== 'ASSIGNED' && (r.STATUS === 'PENDING' || r.STATUS === 'APPROVED')) ||
                       (r.SOURCE === 'ASSIGNED' && r.CONFIRM_STATUS === 'CONFIRMED');
            });
            if (conflict) {
                const st = conflict.STATUS === 'APPROVED' ? 'đã được duyệt'
                         : conflict.STATUS === 'PENDING'  ? 'đang chờ duyệt'
                         : 'đã xác nhận';
                $('#createError').removeClass('d-none').html(
                    `Bạn đã có đơn nghỉ <strong>${st}</strong> trùng khoảng ngày này ` +
                    `(${formatDate(conflict.FROM_DATE)} – ${formatDate(conflict.TO_DATE)}).<br>` +
                    `<small class="text-muted">Chỉ có thể tạo lại nếu đơn cũ bị từ chối.</small>`
                );
                return;
            }
        }

        $btn.html('<span class="spinner-border spinner-border-sm me-1"></span>Đang gửi...');
        const payload = {
            EMPCD:      '',
            LEAVE_TYPE: createLT,
            FROM_DATE:  from,
            TO_DATE:    to,
            TOTAL_DAYS: days,
            REASON:     reason
        };
        const res = await $.ajax({ url: CREATE_URL, type: 'POST', contentType: 'application/json', data: JSON.stringify(payload) });
        if (res.success) {
            bootstrap.Modal.getInstance('#createModal').hide();
            showToast('Đã gửi đơn nghỉ phép thành công', 'success');
            loadData(1);
        } else {
            $('#createError').removeClass('d-none').text(res.message || 'Lỗi tạo đơn');
        }
    } catch { $('#createError').removeClass('d-none').text('Lỗi kết nối'); }
    finally  { $btn.prop('disabled', false).html('<i class="bi bi-send me-1"></i> Gửi đơn'); }
}

function calcDays() {
    const f = $('#editFromDate').val(), t = $('#editToDate').val();
    if (!canTakeSundayLeave && f && isSunday(f)) {
        $('#editFromDate').val('');
        showDateError('editError', 'Từ ngày không được là Chủ Nhật (công ty làm T2–T7)', 'editFromDate');
        return;
    }
    if (!canTakeSundayLeave && t && isSunday(t)) {
        $('#editToDate').val('');
        showDateError('editError', 'Đến ngày không được là Chủ Nhật (công ty làm T2–T7)', 'editToDate');
        return;
    }
    $('#editError').addClass('d-none').text('');
    if (f) $('#editToDate').attr('min', f);
    if (f && t) {
        if (t < f) { $('#editToDate').val(f); }
        const tFinal = $('#editToDate').val();
        const diff = countDaysNoSunday(f, tFinal);
        if (diff > 0) $('#editTotalDays').val(diff);
    }
}

function openEditBtn(btn) {
    const $b    = $(btn);
    const today = localDateStr();
    $('#editRequestId').val($b.data('id'));
    $('#editLeaveType').val($b.data('type') || 'AL');
    updateLTNote('edit');
    const fromStr = $b.data('from') ? localDateStr($b.data('from')) : '';
    const toStr   = $b.data('to')   ? localDateStr($b.data('to'))   : '';
    $('#editFromDate').attr('min', today).val(fromStr);
    $('#editToDate').attr('min', fromStr || today).val(toStr);
    $('#editTotalDays').val($b.data('days'));
    $('#editReason').val($b.data('reason') || '');
    $('#editLeaveType').trigger('change');
    $('#editError').addClass('d-none').text('');
    new bootstrap.Modal('#editModal').show();
}

async function saveEdit() {
    const today = localDateStr();
    const from  = $('#editFromDate').val();
    const to    = $('#editToDate').val();
    if (from < today)   { $('#editError').removeClass('d-none').text('Không được chọn ngày trong quá khứ'); $('#editFromDate').focus(); return; }
    if (!canTakeSundayLeave && isSunday(from)) { $('#editError').removeClass('d-none').text('Từ ngày không được là Chủ Nhật (công ty làm T2–T7)'); $('#editFromDate').focus(); return; }
    if (!canTakeSundayLeave && isSunday(to))   { $('#editError').removeClass('d-none').text('Đến ngày không được là Chủ Nhật (công ty làm T2–T7)'); $('#editToDate').focus(); return; }
    if (to < from)      { $('#editError').removeClass('d-none').text('Đến ngày phải lớn hơn hoặc bằng Từ ngày'); $('#editToDate').focus(); return; }

    const editLT   = $('#editLeaveType').val() || 'AL';
    const editDays = parseFloat($('#editTotalDays').val()) || 1;
    if (editLT !== 'AL' && !$('#editReason').val().trim()) {
        $('#editError').removeClass('d-none').text('Vui lòng nhập lý do nghỉ'); $('#editReason').focus(); return;
    }
    if (editLT === 'DC' || editLT === 'DS') {
        const d = new Date(); d.setDate(d.getDate() + 3);
        const minDcStr = d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2);
        if (from < minDcStr) {
            $('#editError').removeClass('d-none').text('Loại nghỉ này phải đăng ký trước ít nhất 3 ngày');
            $('#editFromDate').focus(); return;
        }
    }
    if (editLT === 'AL' && myBalance != null) {
        const left = myBalance.LEFT_NUM ?? 0;
        if (editDays > left) {
            $('#editError').removeClass('d-none').html(
                `Bạn chỉ còn <strong>${left} ngày</strong> phép năm, không đủ để nghỉ <strong>${editDays} ngày</strong>.<br>` +
                `<small class="text-muted">Vui lòng điều chỉnh số ngày hoặc chọn loại nghỉ khác.</small>`
            );
            return;
        }
    }

    const $btn = $('#saveEditBtn').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Đang lưu...');
    try {
        const payload = {
            REQUEST_ID: $('#editRequestId').val(),
            EMPCD: '',
            LEAVE_TYPE: editLT,
            FROM_DATE:  from,
            TO_DATE:    to,
            TOTAL_DAYS: parseFloat($('#editTotalDays').val()) || 1,
            REASON:     $('#editReason').val() || null
        };
        const res = await $.ajax({ url: UPDATE_URL, type: 'POST', contentType: 'application/json', data: JSON.stringify(payload) });
        if (res.success) {
            bootstrap.Modal.getInstance('#editModal').hide();
            showToast('Cập nhật đơn nghỉ phép thành công', 'success');
            loadData(currentPage);
        } else {
            $('#editError').removeClass('d-none').text(res.message || 'Lỗi cập nhật');
        }
    } catch { $('#editError').removeClass('d-none').text('Lỗi kết nối'); }
    finally  { $btn.prop('disabled', false).html('<i class="bi bi-check-lg me-1"></i> Lưu'); }
}

function confirmDelete(id) {
    showConfirm('Bạn có chắc muốn xoá đơn nghỉ này?', async function() {
        try {
            const res = await $.ajax({ url: DELETE_URL, type: 'POST', data: { request_id: id } });
            if (res.success) { showToast('Đã xoá đơn nghỉ', 'success'); loadData(currentPage); }
            else showToast(res.message || 'Lỗi xoá', 'error');
        } catch { showToast('Lỗi kết nối', 'error'); }
    }, { title: 'Xoá Đơn Nghỉ', okText: 'Xoá', okClass: 'btn-danger' });
}

function confirmLeave(id) {
    showConfirm('Tiếp nhận thông tin lịch nghỉ phép này?', async function() {
        try {
            const res = await $.ajax({ url: CONFIRM_URL, type: 'POST', data: { request_id: id } });
            if (res.success) { showToast('Đã tiếp nhận thông tin lịch nghỉ', 'success'); loadData(currentPage); }
            else showToast(res.message || 'Lỗi tiếp nhận', 'error');
        } catch { showToast('Lỗi kết nối', 'error'); }
    }, { title: 'Tiếp Nhận Thông Tin', okText: 'Tiếp Nhận', okClass: 'btn-success',
         icon: 'event_available', iconColor: '#16a34a', iconBg: '#dcfce7' });
}

function workerReject(id) {
    showConfirm('Từ chối lịch nghỉ phép này?', async function() {
        try {
            const res = await $.ajax({ url: WK_REJECT_URL, type: 'POST', data: { request_id: id } });
            if (res.success) { showToast('Đã từ chối lịch nghỉ', 'warning'); loadData(currentPage); }
            else showToast(res.message || 'Lỗi từ chối', 'error');
        } catch { showToast('Lỗi kết nối', 'error'); }
    }, { title: 'Từ Chối Lịch Nghỉ', okText: 'Từ Chối', okClass: 'btn-danger',
         icon: 'cancel', iconColor: '#dc2626', iconBg: '#fee2e2' });
}

function formatDate(s) { if(!s) return '-'; const d=new Date(s); if(isNaN(d)) return '-'; return('0'+d.getDate()).slice(-2)+'/'+('0'+(d.getMonth()+1)).slice(-2)+'/'+d.getFullYear(); }
function escHtml(str) { return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

$(document).ready(function() {
    updateMonthLabel(); loadData(1); loadBalance();
    // Auto-open modal khi URL có ?openCreate=1 (từ Home mini calendar)
    try {
        const p = new URLSearchParams(window.location.search);
        if (p.get('openCreate') === '1') {
            setTimeout(() => openCreateModal(), 250);
        }
    } catch (e) {}
});
