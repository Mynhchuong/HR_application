               </div>`
            : `<div class="d-flex align-items-center gap-1 mb-2 px-2 py-1 rounded" style="background:#fef3c7;border-left:3px solid #f59e0b;">
                   <i class="bi bi-bell-fill text-warning" style="font-size:.8rem;"></i>
                   <span class="text-xs fw-bold" style="color:#92400e;">Bạn đã được sắp lịch, vui lòng tiếp nhận thông tin ngay!</span>
               </div>`
        : '';
    const expiredStyle = expired ? ' style="background:#f1f5f9;opacity:.75;"' : '';
    return `<div class="lv-card${isAssigned ? ' lv-pending-confirm' : ''}"${expiredStyle}>
        ${alertBanner}
