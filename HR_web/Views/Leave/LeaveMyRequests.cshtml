        <td class="px-2 text-sm text-nowrap">${formatDate(item.TO_DATE)}</td>
        <td class="px-2 text-sm fw-bold">${item.TOTAL_DAYS ?? '-'}</td>
        <td class="px-2 text-sm d-none d-md-table-cell"><div class="txt-clamp" title="${escHtml(item.REASON||'')}">${escHtml(item.REASON||'-')}</div></td>
        <td class="text-center">${statusBadge(item)}${remarkHtml(item)}${needsDocWarning(item) ? '<div class="badge bg-danger mt-1"><i class="bi bi-exclamation-triangle-fill me-1"></i>Chưa nộp giấy tờ</div>' : ''}</td>
        <td class="text-center">${sigCell}</td>
        <td class="text-center">${actionBtns(item)}</td>
    </tr>`;
}

function buildCard(item, idx) {
    const remark = remarkHtml(item);
    const isAssigned = item.SOURCE === 'ASSIGNED' && item.STATUS === 'ASSIGNED' && !item.CONFIRM_STATUS;
    const isPast     = isAssigned && isPastDate(item.FROM_DATE);
    const expired    = isExpiredPending(item);
    const alertBanner = isAssigned
        ? isPast
