@{
    ViewData["Title"] = "Đơn Nghỉ Phép Của Tôi";
    int initMonth = DateTime.Today.Month;
    int initYear  = DateTime.Today.Year;
    string todayMin = DateTime.Today.ToString("yyyy-MM-dd");
}

@section Styles {
<style>
    .pagination .page-link { cursor: pointer; border-radius: 8px !important; margin: 0 2px; }
    .pagination .page-item.disabled .page-link { cursor: default; }
    .pagination .page-item.active .page-link { background: #3b82f6; border-color: #3b82f6; }
    .txt-clamp { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; max-width:180px; cursor:default; }
    .sig-panel { display:flex; gap:12px; justify-content:space-around; margin:8px 0; padding:8px; border-top:1px dashed #e5e7eb; }
    .sig-col   { flex:1; text-align:center; min-width:0; }
    .sig-lbl   { font-size:.65rem; font-weight:700; color:#94a3b8; text-transform:uppercase; letter-spacing:.05em; margin-bottom:2px; }
    .sig-img   { max-height:50px; max-width:130px; object-fit:contain; }
    .sig-name  { font-size:.7rem; color:#64748b; margin-top:2px; }
    .sig-cell      { display:flex; gap:6px; justify-content:center; align-items:flex-start; flex-wrap:wrap; }
    .sig-cell-item { text-align:center; min-width:80px; }
    .sig-cell-lbl  { font-size:.6rem; font-weight:700; color:#94a3b8; text-transform:uppercase; letter-spacing:.04em; margin-bottom:2px; }
    .sig-cell-img  { display:block; margin:0 auto; max-height:55px; max-width:110px; object-fit:contain; background:#fafafa; border-radius:4px; padding:2px; }
    .sig-cell-name { font-size:.65rem; color:#64748b; margin-top:2px; line-height:1.2; }
    .source-tab { cursor: pointer; padding: 6px 14px; border-radius: 20px; font-size: .8rem; font-weight: 600; border: 1.5px solid transparent; transition: all .2s; }
    .source-tab.active { background: #3b82f6; color: #fff; border-color: #3b82f6; }
    .source-tab:not(.active) { background: #f1f5f9; color: #64748b; border-color: #e2e8f0; }
    .source-tab:not(.active):hover { background: #e2e8f0; }

    .lt-note { margin-top:8px; padding:8px 10px; border-radius:8px; background:#f0f9ff; border-left:3px solid #0ea5e9; font-size:.78rem; color:#0c4a6e; line-height:1.45; }

    .month-nav { display:flex; align-items:center; gap:6px; }
    .month-nav button { border:none; background:rgba(255,255,255,.22); color:#fff; border-radius:6px; width:28px; height:28px; display:flex; align-items:center; justify-content:center; font-size:.95rem; cursor:pointer; }
    .month-nav button:hover { background:rgba(255,255,255,.38); }
    .month-nav span { font-weight:700; font-size:.9rem; color:#fff; min-width:130px; text-align:center; }

    /* Mobile card layout */
    @@media (max-width: 768px) {
        .lv-table-wrap { display: none; }
        .lv-card-list  { display: block; }
    }
    @@media (min-width: 769px) {
        .lv-table-wrap { display: block; }
        .lv-card-list  { display: none; }
    }
    .lv-card { border:1px solid #e5e7eb; border-radius:14px; padding:14px 16px; margin-bottom:12px; background:#fff; box-shadow:0 1px 4px rgba(0,0,0,.06); }
    .lv-card.lv-pending-confirm { border:2px solid #f59e0b; background:#fffbeb; box-shadow:0 2px 12px rgba(245,158,11,.18); }
    .lv-card.lv-pending-confirm::before { content:''; display:block; width:4px; border-radius:4px 0 0 4px; background:#f59e0b; position:absolute; top:0; left:0; bottom:0; }
    .lv-card { position:relative; overflow:hidden; }
    tr.tr-pending-confirm td { background:#fffbeb !important; border-left:none; }
    tr.tr-pending-confirm td:first-child { border-left:4px solid #f59e0b; }
    .lv-card .lv-row { display:flex; justify-content:space-between; align-items:center; margin-bottom:7px; }
    .lv-card .lv-lbl { font-size:.76rem; color:#9ca3af; font-weight:600; text-transform:uppercase; }
    .lv-card .lv-val { font-size:.92rem; color:#1f2937; }
    .lv-card .lv-foot { display:flex; justify-content:space-between; align-items:center; padding-top:10px; margin-top:8px; border-top:1px solid #f3f4f6; }
    /* Header filter mobile */
    @@media (max-width: 576px) {
        .header-filter-row { flex-direction: column !important; align-items: stretch !important; gap: 6px !important; }
        .header-filter-row > div { width: 100%; }
        .source-tab { padding: 5px 10px; font-size: .75rem; }
    }
    tr.tr-expired-pending td { background:#f1f5f9 !important; color:#9ca3af !important; }
    tr.tr-expired-pending .badge { opacity:.55; }
</style>
}

<div class="container-fluid py-4">
    <div class="card my-4">
        <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
            <div class="bg-gradient-primary shadow-primary border-radius-lg pt-3 pb-2 px-3">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h6 class="text-white mb-0"><i class="bi bi-calendar-check me-1"></i> Đơn Nghỉ Phép Của Tôi</h6>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <div class="month-nav">
                            <button onclick="changeMonth(-1)" title="Tháng trước"><i class="bi bi-chevron-left"></i></button>
                            <span id="monthLabel"></span>
                            <button onclick="changeMonth(1)"  title="Tháng sau"><i class="bi bi-chevron-right"></i></button>
                        </div>
                        <button class="btn btn-sm btn-light text-primary fw-bold shadow-sm" onclick="openCreateModal()" style="height:32px;">
                            <i class="bi bi-plus-lg me-1"></i>Tạo đơn
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-body px-0 pt-0 pb-2 mt-3">
            <!-- Annual leave balance bar -->
            <div class="px-4 py-2 d-flex align-items-center gap-3 flex-wrap" id="balanceBar" style="border-bottom:1px solid #e9ecef; background:#f8fafc;">
                <span class="text-xs fw-bold text-secondary"><i class="bi bi-calendar-heart me-1"></i>Phép năm:</span>
                <span class="text-xs text-secondary">Được cấp: <strong id="balReceive" class="text-dark">-</strong> ngày</span>
                <span class="text-xs text-secondary">Đã dùng: <strong id="balUsed" class="text-dark">-</strong> ngày</span>
                <span class="text-xs fw-bold" id="balLeftWrap">Còn lại: <strong id="balLeft">-</strong> ngày</span>
            </div>

            <!-- Source filter tabs -->
            <div class="px-4 pb-2 pt-1 d-flex align-items-center gap-2 flex-wrap" style="border-bottom:1px solid #f1f5f9;">
                <span class="source-tab active" onclick="setSource('')"  id="tab-all">Tất cả</span>
                <span class="source-tab" onclick="setSource('SELF')"     id="tab-self"><i class="bi bi-person-fill me-1"></i>Tự nộp</span>
                <span class="source-tab" onclick="setSource('ASSIGNED')" id="tab-assigned"><i class="bi bi-calendar2-plus me-1"></i>Được sắp lịch</span>
            </div>

            <!-- Desktop table -->
            <div class="lv-table-wrap table-responsive p-0 px-4 mt-2">
                <table class="table align-items-center mb-0 w-100 table-hover table-striped">
                    <thead class="bg-light">
                        <tr>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">#</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Nguồn</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Loại nghỉ</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Từ ngày</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Đến ngày</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Số ngày</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2 d-none d-md-table-cell">Lý do</th>
                            <th class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-9">Tình trạng</th>
                            <th class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-9">Chữ ký</th>
                            <th class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-9">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="lvTableBody"></tbody>
                </table>
            </div>

            <!-- Mobile cards -->
            <div class="lv-card-list px-3 mt-2" id="lvCardList"></div>

            <div class="d-flex justify-content-between align-items-center px-4 mt-3 mb-2">
                <div id="paginationCount" class="text-sm text-secondary"></div>
                <nav><ul class="pagination pagination-sm mb-0" id="paginationBar"></ul></nav>
            </div>
        </div>
    </div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h6 class="modal-title mb-0"><i class="bi bi-calendar-plus me-1"></i> Tạo Đơn Nghỉ Phép</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-bold mb-2">Loại nghỉ <span class="text-danger">*</span></label>
                    <select id="createLeaveType" class="form-select">
                        <option value="AL" selected>Phép năm (AL)</option>
                        <option value="NL">Không lương (NL)</option>
                        <option value="SI">Bệnh có giấy (SI)</option>
                        <option value="DT">Đám tang (DT)</option>
                        <option value="DC">Đám cưới (DC)</option>
                        <option value="CT">Công tác (CT)</option>
                        <option value="VS">Vợ sanh (VS)</option>
                        <option value="DS">Dưỡng sức (DS)</option>
                        <option value="KT">Khám thai (KT)</option>
                    </select>
                    <div id="createLTNote" class="lt-note d-none"></div>
                </div>
                <div class="row">
                    <div class="col-6 mb-3">
                        <label class="form-label fw-bold">Từ ngày <span class="text-danger">*</span></label>
                        <input type="date" id="createFromDate" class="form-control" min="@todayMin" onkeydown="return false" onchange="calcCreateDays()" />
                    </div>
                    <div class="col-6 mb-3">
                        <label class="form-label fw-bold">Đến ngày <span class="text-danger">*</span></label>
                        <input type="date" id="createToDate" class="form-control" min="@todayMin" onkeydown="return false" onchange="calcCreateDays()" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Số ngày nghỉ <span class="text-danger">*</span></label>
                    <input type="number" id="createTotalDays" class="form-control bg-light" min="0.5" step="0.5" placeholder="Tự động tính" readonly />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Lý do <span class="text-danger">*</span></label>
                    <textarea id="createReason" class="form-control" rows="2" maxlength="500" placeholder="Nhập lý do nghỉ phép..."></textarea>
                    <div id="createReasonCounter" class="text-xs text-muted mt-1 d-none"></div>
                </div>
                <div id="createError" class="alert alert-danger d-none py-2"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Huỷ</button>
                <button class="btn btn-success btn-sm" id="saveCreateBtn" onclick="saveCreate()">
                    <i class="bi bi-send me-1"></i> Gửi đơn
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Leave Warning Confirm Modal (mọi loại trừ AL/CT) -->
<div class="modal fade" id="leaveWarnModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h6 class="modal-title mb-0"><i class="bi bi-exclamation-triangle-fill me-1"></i> Lưu ý trước khi gửi đơn</h6>
            </div>
            <div class="modal-body">
                <p id="leaveWarnText" class="mb-0" style="font-size:.95rem; line-height:1.6;"></p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary btn-sm" id="leaveWarnCancelBtn">Huỷ</button>
                <button class="btn btn-warning btn-sm fw-bold" id="leaveWarnOkBtn">OK, tôi hiểu</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h6 class="modal-title mb-0"><i class="bi bi-pencil-square me-1"></i> Sửa Đơn Nghỉ Phép</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editRequestId" />
                <div class="mb-3">
                    <label class="form-label fw-bold mb-2">Loại nghỉ <span class="text-danger">*</span></label>
                    <select id="editLeaveType" class="form-select">
                        <option value="AL">Phép năm (AL)</option>
                        <option value="NL">Không lương (NL)</option>
                        <option value="SI">Bệnh có giấy (SI)</option>
                        <option value="DT">Đám tang (DT)</option>
                        <option value="DC">Đám cưới (DC)</option>
                        <option value="CT">Công tác (CT)</option>
                        <option value="VS">Vợ sanh (VS)</option>
                        <option value="DS">Dưỡng sức (DS)</option>
                        <option value="KT">Khám thai (KT)</option>
                    </select>
                    <div id="editLTNote" class="lt-note d-none"></div>
                </div>
                <div class="row">
                    <div class="col-6 mb-3">
                        <label class="form-label fw-bold">Từ ngày <span class="text-danger">*</span></label>
                        <input type="date" id="editFromDate" class="form-control" min="@todayMin" onkeydown="return false" onchange="calcDays()" />
                    </div>
                    <div class="col-6 mb-3">
                        <label class="form-label fw-bold">Đến ngày <span class="text-danger">*</span></label>
                        <input type="date" id="editToDate" class="form-control" min="@todayMin" onkeydown="return false" onchange="calcDays()" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Số ngày nghỉ <span class="text-danger">*</span></label>
                    <input type="number" id="editTotalDays" class="form-control bg-light" min="0.5" step="0.5" readonly />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Lý do</label>
                    <textarea id="editReason" class="form-control" rows="2" maxlength="500"></textarea>
                    <div id="editReasonCounter" class="text-xs text-muted mt-1 d-none"></div>
                </div>
                <div id="editError" class="alert alert-danger d-none py-2"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Huỷ</button>
                <button class="btn btn-primary btn-sm" id="saveEditBtn" onclick="saveEdit()">
                    <i class="bi bi-check-lg me-1"></i> Lưu
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
const NO_DATA_IMG = '@(new Random().Next(2)==0 ? Url.Content("~/assets/img/illustrations/A_nodata.png") : Url.Content("~/assets/img/illustrations/Chi_nodata.png"))';
const PAGE_URL         = '@Url.Action("GetMyRequestsPage", "Leave")';
const CREATE_URL       = '@Url.Action("CreateRequest",    "Leave")';
const UPDATE_URL       = '@Url.Action("UpdateRequest",    "Leave")';
const DELETE_URL       = '@Url.Action("DeleteRequest",    "Leave")';
const CONFIRM_URL      = '@Url.Action("ConfirmLeave",     "Leave")';
const WK_REJECT_URL    = '@Url.Action("WorkerRejectLeave","Leave")';
const BALANCE_URL      = '@Url.Action("GetMyBalance",     "Leave")';
const SIG_URL          = '@Url.Action("GetSignature",     "Image")';
const CURRENT_EMPCD    = '@ViewBag.CurrentEmpCd';

let myBalance = null; // { RECEIVE_NUM, USED_NUM, LEFT_NUM }

function loadBalance() {
    $.get(BALANCE_URL, function(res) {
        if (res && res.success && res.data) {
            myBalance = res.data;
            const left = myBalance.LEFT_NUM ?? 0;
            $('#balReceive').text(myBalance.RECEIVE_NUM ?? 0);
            $('#balUsed').text(myBalance.USED_NUM ?? 0);
            $('#balLeft').text(left);
            const $w = $('#balLeftWrap');
            if      (left <= 0) $w.css('color','#b91c1c');
            else if (left <= 3) $w.css('color','#92400e');
            else                $w.css('color','#166534');
        }
    });
}

function emptyRow(msg, cols=9) {
    return `<tr><td colspan="${cols}" class="text-center py-5">
        <img src="${NO_DATA_IMG}" style="width:130px;opacity:.85;margin-bottom:12px;display:block;margin-left:auto;margin-right:auto;">
        <div class="text-muted text-sm">${msg}</div>
    </td></tr>`;
}
function emptyDiv(msg) {
    return `<div class="text-center py-5">
        <img src="${NO_DATA_IMG}" style="width:130px;opacity:.85;margin-bottom:12px;">
        <div class="text-muted text-sm">${msg}</div>
    </div>`;
}

let currentPage = 1, totalPages = 1, totalRecords = 0, pageSize = 20;
let currentSource = '';
let curMonth = @initMonth, curYear = @initYear;

const MONTHS_VI = ['Tháng 1','Tháng 2','Tháng 3','Tháng 4','Tháng 5','Tháng 6',
                   'Tháng 7','Tháng 8','Tháng 9','Tháng 10','Tháng 11','Tháng 12'];

function updateMonthLabel() {
    $('#monthLabel').text(MONTHS_VI[curMonth-1] + ' / ' + curYear);
}

function changeMonth(delta) {
    curMonth += delta;
    if (curMonth > 12) { curMonth = 1;  curYear++; }
    if (curMonth < 1)  { curMonth = 12; curYear--; }
    updateMonthLabel();
    loadData(1);
}

function getMonthRange() {
    const firstDay = new Date(curYear, curMonth - 1, 1);
    const lastDay  = new Date(curYear, curMonth, 0);
    const fmt = d => d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
    return { from: fmt(firstDay), to: fmt(lastDay) };
}

const LEAVE_LABEL = { AL:'Phép năm', CL:'Chế độ BHXH', SL:'Nghỉ bệnh', NPL:'Không lương', OTH:'Khác', NL:'Không lương', SI:'Bệnh có giấy', DT:'Đám tang', DC:'Đám cưới', CT:'Công tác', VS:'Vợ sanh', DS:'Dưỡng sức', KT:'Khám thai' };
const LEAVE_COLOR = { AL:'primary', CL:'info', SL:'danger', NPL:'secondary', OTH:'warning', NL:'secondary', SI:'danger', DT:'dark', DC:'danger', CT:'info', VS:'primary', DS:'warning', KT:'warning' };

function leaveBadge(t) {
    return `<span class="badge bg-${LEAVE_COLOR[t]||'secondary'}">${LEAVE_LABEL[t]||t||'-'}</span>`;
}

// Loại bắt buộc nộp giấy tờ chứng minh (nhắc sau 3 ngày) — khớp DocRequiredTypes phía API. CT KHÔNG cần nộp giấy tờ.
const DOC_REQUIRED_TYPES = ['SI', 'DT', 'DC', 'VS', 'DS', 'KT'];
// NL/SI/DS: cảnh báo mất chuyên cần + ngày công LUÔN LUÔN (không phụ thuộc có nộp giấy hay không — NL không có
// cơ chế nộp giấy, SI/DS có nộp giấy nhưng vẫn mất ngày công theo bảng HR).
const ALWAYS_LOSE_TYPES = ['NL', 'SI', 'DS'];
// DT/DC/VS/KT: chỉ mất chuyên cần NẾU không bổ sung giấy tờ đúng hạn (không mất ngày công).
const COND_LOSE_TYPES = ['DT', 'DC', 'VS', 'KT'];

// Ghi chú tham khảo cho NV tự chọn số ngày đúng theo quan hệ — CHỈ hiển thị, không ràng buộc logic/validate.
const LT_POLICY_NOTE = {
    DC: 'ℹ️ Tham khảo:<br>' +
        '• <b>3 ngày</b> nếu là đám cưới của bản thân (báo trước 5 ngày).<br>' +
        '• <b>1 ngày</b> nếu là cha/mẹ tái hôn, con ruột/nuôi kết hôn, hoặc anh/chị/em ruột kết hôn (báo trước 2 ngày).',
    DT: 'ℹ️ Tham khảo:<br>' +
        '• <b>4 ngày</b> nếu là bố mẹ ruột/nuôi (hai bên), vợ/chồng, hoặc con ruột/nuôi mất.<br>' +
        '• <b>1 ngày</b> nếu là ông bà (nội/ngoại) hoặc anh/chị/em ruột/nuôi mất.',
    VS: 'ℹ️ Tham khảo:<br>' +
        '• <b>7 ngày</b> nếu vợ sanh thường.<br>' +
        '• <b>9 ngày</b> nếu vợ sanh mổ.<br>' +
        '• <b>12 ngày</b> nếu vợ sanh đôi hoặc sanh con thứ 2 trở đi.'
};
const DOC_WARNING_NOTE_ALWAYS = '⚠️ <b>Lưu ý:</b> Nghỉ loại này sẽ bị tính <b>mất chuyên cần</b> và <b>mất ngày công</b>, dù có nộp giấy tờ chứng minh hay không.';
const DOC_WARNING_NOTE_COND = '⚠️ <b>Lưu ý:</b> Phải nộp giấy tờ chứng minh cho phòng Nhân sự trong tháng này. ' +
    'Nếu không nộp sẽ bị <b>mất chuyên cần</b>.';
function updateLTNote(prefix) {
    const val   = document.getElementById(prefix + 'LeaveType')?.value;
    const noteEl = document.getElementById(prefix + 'LTNote');
    if (!noteEl) return;
    let html = LT_POLICY_NOTE[val] || '';
    if (ALWAYS_LOSE_TYPES.includes(val)) html += (html ? '<br>' : '') + DOC_WARNING_NOTE_ALWAYS;
    else if (COND_LOSE_TYPES.includes(val)) html += (html ? '<br>' : '') + DOC_WARNING_NOTE_COND;
    if (html) { noteEl.innerHTML = html; noteEl.classList.remove('d-none'); }
    else { noteEl.innerHTML = ''; noteEl.classList.add('d-none'); }
}
document.getElementById('createLeaveType')?.addEventListener('change', () => updateLTNote('create'));
document.getElementById('editLeaveType')?.addEventListener('change', () => updateLTNote('edit'));

// ERP remark tối đa 30 byte, gồm tiền tố "XX " (mã loại + dấu cách = 3 byte) + lý do NV gõ.
// Chỉ áp dụng cho các loại ghi thẳng lý do vào remark ERP (AL và NL dùng "VR"/"ASSIGNED" cố định,
// không kèm lý do trong remark — lý do NV gõ vẫn lưu đầy đủ trong app, chỉ không giới hạn byte).
const ERP_REMARK_TYPES = ['SI', 'DT', 'DC', 'CT', 'VS', 'DS', 'KT'];
const ERP_REASON_MAX_BYTES = 27;

function utf8ByteLength(s) {
    return new Blob([s || '']).size;
}
function truncateUtf8(s, maxBytes) {
    s = s || '';
    while (utf8ByteLength(s) > maxBytes) s = s.slice(0, -1);
    return s;
}
function setupReasonByteLimit(prefix) {
    const typeEl = document.getElementById(prefix + 'LeaveType');
    const reasonEl = document.getElementById(prefix + 'Reason');
    const counterEl = document.getElementById(prefix + 'ReasonCounter');
    if (!typeEl || !reasonEl || !counterEl) return;

    // showCounter: chỉ hiện số byte đã dùng, KHÔNG cắt (dùng khi mở modal edit — reason cũ có thể dài hơn
    // giới hạn hiện tại vì nó là do lịch sử, không nên tự ý cắt mất dữ liệu người dùng chưa đụng tới).
    function showCounter() {
        const limited = ERP_REMARK_TYPES.includes(typeEl.value);
        if (!limited) { counterEl.classList.add('d-none'); return; }
        const used = utf8ByteLength(reasonEl.value);
        counterEl.textContent = `${used}/${ERP_REASON_MAX_BYTES} byte (do lý do được ghi thẳng vào hệ ERP, có dấu tiếng Việt sẽ chiếm nhiều byte hơn số ký tự)`;
        counterEl.classList.remove('d-none');
        counterEl.classList.toggle('text-danger', used >= ERP_REASON_MAX_BYTES);
    }
    // enforceLimit: cắt bớt nếu vượt giới hạn — chỉ áp dụng khi NGƯỜI DÙNG đang gõ.
    function enforceLimit() {
        if (ERP_REMARK_TYPES.includes(typeEl.value) && utf8ByteLength(reasonEl.value) > ERP_REASON_MAX_BYTES) {
            reasonEl.value = truncateUtf8(reasonEl.value, ERP_REASON_MAX_BYTES);
        }
        showCounter();
    }
    typeEl.addEventListener('change', showCounter);
    reasonEl.addEventListener('input', enforceLimit);
    showCounter();
}
setupReasonByteLimit('create');
setupReasonByteLimit('edit');

function needsDocWarning(item) {
    return DOC_REQUIRED_TYPES.includes(item.LEAVE_TYPE)
        && (item.STATUS === 'APPROVED' || item.STATUS === 'ASSIGNED')
        && item.CONFIRM_STATUS !== 'WORKER_REJECTED'
        && item.DOC_STATUS !== 'SUBMITTED';
}
function docWarningHtml(item) {
    if (!needsDocWarning(item)) return '';
    return `<div class="d-flex align-items-center gap-1 mb-2 px-2 py-1 rounded" style="background:#fde8e8;border-left:3px solid #ef4444;">
        <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size:.8rem;"></i>
        <span class="text-xs fw-bold" style="color:#7f1d1d;">Chưa nộp giấy tờ cho phòng Nhân sự</span>
    </div>`;
}

function statusBadge(item) {
    const s = item.STATUS, cs = item.CONFIRM_STATUS, src = item.SOURCE;
    if (src === 'ASSIGNED') {
        if (s === 'WORKER_REJECTED') return `<span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Đã từ chối</span>`;
        if (cs === 'CONFIRMED')      return `<span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Đã tiếp nhận thông tin</span>`;
        return `<span class="badge bg-info text-dark"><i class="bi bi-hourglass-split me-1"></i>Chưa tiếp nhận thông tin</span>`;
    }
    if (s === 'PENDING')  return `<span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Chờ duyệt</span>`;
    if (s === 'APPROVED') return `<span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Đã duyệt</span>`;
    if (s === 'REJECTED') return `<span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Từ chối</span>`;
    return `<span class="badge bg-secondary">${escHtml(s||'-')}</span>`;
}

function sourceBadge(src) {
    if (src === 'SELF')     return `<span class="badge bg-light text-dark border"><i class="bi bi-person-fill me-1"></i>Tự nộp</span>`;
    if (src === 'ASSIGNED') return `<span class="badge" style="background:#e0f2fe;color:#0369a1;"><i class="bi bi-calendar2-plus me-1"></i>Được sắp</span>`;
    return '';
}

function remarkHtml(item) {
    if (!item.REMARK) return '';
    const isRejected = item.STATUS === 'REJECTED' || item.STATUS === 'WORKER_REJECTED';
    const style = isRejected
        ? 'background:#fff0f0;border-left:3px solid #dc3545;color:#842029;'
        : 'background:#e8f4fd;border-left:3px solid #0d6efd;color:#084298;';
    return `<div class="mt-1 px-2 py-1 rounded-end text-xs" style="${style}"><i class="bi bi-chat-left-text me-1"></i>${escHtml(item.REMARK)}</div>`;
}

function localDateStr(d) {
    const dt = d ? new Date(d) : new Date();
    return dt.getFullYear() + '-'
        + String(dt.getMonth() + 1).padStart(2, '0') + '-'
        + String(dt.getDate()).padStart(2, '0');
}

function isPastDate(dateStr) {
    if (!dateStr) return false;
    return dateStr.slice(0, 10) <= localDateStr();
}

function isExpiredPending(item) {
    if (!item.FROM_DATE) return false;
    return item.FROM_DATE.slice(0, 10) < localDateStr() && item.STATUS === 'PENDING';
}

function actionBtns(item) {
    const s = item.STATUS;
    if (item.SOURCE === 'ASSIGNED' && s === 'ASSIGNED') {
        if (item.CONFIRM_STATUS === 'CONFIRMED') return '<span class="text-muted text-xs">-</span>';
        // Sắp lịch là bắt buộc nghỉ (HR rule) — "Xác nhận" chỉ là đã xem thông báo,
        // không phải phê duyệt/từ chối, nên KHÔNG giới hạn theo thời gian FROM_DATE.
        return `<button class="btn btn-xs btn-success" title="Tiếp nhận thông tin" onclick="confirmLeave('${item.REQUEST_ID}')"><i class="bi bi-check-lg me-1"></i>Đã nhận lịch nghỉ sắp xếp</button>`;
    }
    if (item.IS_EDITABLE && !isExpiredPending(item)) {
        return `<button class="btn btn-xs btn-outline-primary me-1" title="Sửa"
                    data-id="${item.REQUEST_ID}" data-type="${escHtml(item.LEAVE_TYPE||'AL')}"
                    data-from="${item.FROM_DATE||''}" data-to="${item.TO_DATE||''}"
                    data-days="${item.TOTAL_DAYS||1}" data-reason="${escHtml(item.REASON||'')}"
                    onclick="openEditBtn(this)"><i class="bi bi-pencil"></i></button>
                <button class="btn btn-xs btn-outline-danger" title="Xoá" onclick="confirmDelete('${item.REQUEST_ID}')"><i class="bi bi-trash"></i></button>`;
    }
    return '<span class="text-muted text-xs">-</span>';
}

function sigBlock(item) {
    const isAssigned = item.SOURCE === 'ASSIGNED';
    const mySig = (!isAssigned && CURRENT_EMPCD)
        ? `<div class="sig-col">
               <div class="sig-lbl">Người ký</div>
               <img src="${SIG_URL}?empCd=${encodeURIComponent(CURRENT_EMPCD)}" class="sig-img" onerror="this.remove()" alt="Chữ ký"/>
           </div>` : '';
    const asSig = (isAssigned && item.ASSIGNED_BY)
        ? `<div class="sig-col">
               <div class="sig-lbl">Người sắp lịch</div>
               <img src="${SIG_URL}?empCd=${encodeURIComponent(item.ASSIGNED_BY)}" class="sig-img" onerror="this.remove()" alt="Chữ ký"/>
               ${item.ASSIGNER_NAME ? `<div class="sig-name vni-font">${escHtml(item.ASSIGNER_NAME)}</div>` : ''}
           </div>` : '';
    const apSig = item.FINAL_APPROVER
        ? `<div class="sig-col">
               <div class="sig-lbl">Người duyệt</div>
               <img src="${SIG_URL}?empCd=${encodeURIComponent(item.FINAL_APPROVER)}" class="sig-img" onerror="this.remove()" alt="Chữ ký"/>
               ${item.APPROVER_NAME ? `<div class="sig-name vni-font">${escHtml(item.APPROVER_NAME)}</div>` : ''}
           </div>` : '';
    if (!mySig && !asSig && !apSig) return '';
    return `<div class="sig-panel">${mySig}${asSig}${apSig}</div>`;
}

function buildRow(item, idx) {
    const isAssigned  = item.SOURCE === 'ASSIGNED' && item.STATUS === 'ASSIGNED' && !item.CONFIRM_STATUS;
    const needsAction = isAssigned && !isPastDate(item.TO_DATE);
    const expired     = isExpiredPending(item);

    const reqSig = (item.SOURCE !== 'ASSIGNED' && CURRENT_EMPCD)
        ? `<div class="sig-cell-item">
               <div class="sig-cell-lbl">Người ký</div>
               <img src="${SIG_URL}?empCd=${encodeURIComponent(CURRENT_EMPCD)}" class="sig-cell-img" onerror="this.remove()" alt="Chữ ký"/>
           </div>` : '';
    const asSig = (item.SOURCE === 'ASSIGNED' && item.ASSIGNED_BY)
        ? `<div class="sig-cell-item">
               <div class="sig-cell-lbl">Người sắp lịch</div>
               <img src="${SIG_URL}?empCd=${encodeURIComponent(item.ASSIGNED_BY)}" class="sig-cell-img" onerror="this.remove()" alt="Chữ ký"/>
               ${item.ASSIGNER_NAME ? `<div class="sig-cell-name vni-font">${escHtml(item.ASSIGNER_NAME)}</div>` : ''}
           </div>` : '';
    const apSig = item.FINAL_APPROVER
        ? `<div class="sig-cell-item">
               <div class="sig-cell-lbl">Người duyệt</div>
               <img src="${SIG_URL}?empCd=${encodeURIComponent(item.FINAL_APPROVER)}" class="sig-cell-img" onerror="this.remove()" alt="Chữ ký"/>
               ${item.APPROVER_NAME ? `<div class="sig-cell-name vni-font">${escHtml(item.APPROVER_NAME)}</div>` : ''}
           </div>` : '';
    const sigCell = `<div class="sig-cell">${reqSig}${asSig}${apSig}</div>`;

    return `<tr class="${needsDocWarning(item) ? 'tr-expired-pending' : needsAction ? 'tr-pending-confirm' : expired ? 'tr-expired-pending' : ''}">
        <td class="px-2 text-xs text-secondary">${idx}</td>
        <td class="px-2">${sourceBadge(item.SOURCE)}</td>
        <td class="px-2">${leaveBadge(item.LEAVE_TYPE)}</td>
