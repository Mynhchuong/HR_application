@{
    ViewData["Title"] = "Lịch Nghỉ Team";
    int curMonth = (int)(ViewBag.CurrentMonth ?? DateTime.Today.Month);
    int curYear  = (int)(ViewBag.CurrentYear  ?? DateTime.Today.Year);
    string todayMin = DateTime.Today.AddDays(1).ToString("yyyy-MM-dd");
}
@*
    Thiết kế lại 2026-11-21 (quản lý than trang này dùng trên điện thoại khó quá):
      - Tab Duyệt: điện thoại = thẻ rõ ràng (ảnh/tên, loại + ngày, lý do, 2 nút Từ chối / Duyệt to), web = bảng.
        Hộp xác nhận nói rõ đang duyệt đơn của ai; trên điện thoại trượt từ dưới lên.
      - Tab Sắp lịch: danh sách NV cuộn theo trang (bỏ khung cuộn lồng 200px), thanh đáy luôn thấy số NV đã chọn
        + nút đi tiếp; NV đã chọn hiện thành thẻ nhỏ ở phần điền ngày. Giữ lựa chọn khi tìm/lọc (trước đây mất hết).
      - Tab Đã sắp: số liệu gọn 1 hàng.
    API / quy tắc duyệt KHÔNG đổi.
*@

@section Styles {
<style>
    .ts-page { max-width: 1180px; margin: 0 auto; }
    /* ── 3 tab dạng thẻ (2026-11-21: tab cũ chữ xám trên nền xám, khó thấy) ──
       Theme Material tự tô gradient cho .nav-link.active → phải !important để giữ đúng màu ở đây. */
    .ts-tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin: 0 0 14px; padding: 0; list-style: none; }
    .ts-tabs .nav-link {
        width: 100%; height: 100%; margin: 0 !important; display: flex; align-items: center; gap: 12px; text-align: left;
        padding: 12px 14px; border-radius: 16px !important; border: 1.5px solid #e2e8f0 !important;
        background: #fff !important; background-image: none !important; color: #0f172a !important;
        box-shadow: 0 1px 3px rgba(15,23,42,.06) !important; transition: transform .12s, box-shadow .15s, border-color .15s;
    }
    .ts-tabs .nav-item { min-width: 0; }
    .ts-tabs .nav-link:hover { border-color: #93c5fd !important; }
    .ts-tabs .nav-link:active { transform: scale(.98); }
    .ts-tab-ic { width: 44px; height: 44px; border-radius: 13px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 1.35rem; }
    .ts-tab-ic .ic3d { width: 28px; height: 28px; }
    .ts-tab-ic.c1 { background: #dbeafe; } .ts-tab-ic.c2 { background: #fef3c7; } .ts-tab-ic.c3 { background: #dcfce7; }
    .ts-tab-txt { min-width: 0; display: flex; flex-direction: column; }
    .ts-tab-label { display: inline-flex; align-items: center; gap: 6px; font-size: 1.02rem; font-weight: 800; line-height: 1.2; }
    .ts-tab-sub { font-size: .76rem; font-weight: 600; color: #64748b; margin-top: 2px; }
    .ts-tab-badge { background: #ef4444; color: #fff; border-radius: 999px; font-size: .72rem; font-weight: 800; padding: 1px 8px; line-height: 1.5; }
    .ts-tabs .nav-link.active {
        background: #1d4ed8 !important; border-color: #1d4ed8 !important; color: #fff !important;
        box-shadow: 0 6px 16px rgba(29,78,216,.28) !important;
    }
    .ts-tabs .nav-link.active .ts-tab-sub { color: rgba(255,255,255,.85); }
    .ts-tabs .nav-link.active .ts-tab-ic { background: rgba(255,255,255,.2); }
    .ts-tabs .nav-link.active .ts-tab-badge { background: #fff; color: #dc2626; }

    .ts-card { background: #fff; border-radius: 18px; box-shadow: 0 1px 3px rgba(15,23,42,.06), 0 0 0 1px rgba(15,23,42,.04); margin-bottom: 14px; }
    .ts-card-pad { padding: 14px 16px; }
    .ts-sec { display: flex; align-items: center; gap: 8px; font-weight: 800; color: #0f172a; font-size: 1rem; margin-bottom: 10px; }
    .ts-sec .ts-step { width: 26px; height: 26px; border-radius: 50%; background: #dbeafe; color: #1d4ed8; display: inline-flex; align-items: center; justify-content: center; font-size: .85rem; }

    /* ── Thanh công cụ: tháng + tìm ── */
    .ts-toolbar { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; padding: 14px 16px 8px; }
    .ts-month { display: flex; align-items: center; background: #f1f5f9; border-radius: 12px; padding: 3px; }
    .ts-month button { width: 38px; height: 38px; border: 0; border-radius: 10px; background: transparent; color: #334155; font-size: 1.1rem; }
    .ts-month button:active { background: #e2e8f0; }
    .ts-month span { min-width: 128px; text-align: center; font-weight: 800; color: #0f172a; font-size: .95rem; }
    .ts-search { position: relative; flex: 1; min-width: 180px; }
    .ts-search i { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #94a3b8; }
    .ts-search input { width: 100%; height: 44px; border: 1.5px solid #e2e8f0; border-radius: 12px; padding: 0 12px 0 36px; font-size: .95rem; outline: none; background: #fff; }
    .ts-search input:focus { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,.15); }

    /* ── Chip lọc trạng thái (cuộn ngang trên điện thoại) ── */
    .ts-chips { display: flex; gap: 8px; overflow-x: auto; padding: 4px 16px 12px; scrollbar-width: none; }
    .ts-chips::-webkit-scrollbar { display: none; }
    .apv-tab { flex-shrink: 0; cursor: pointer; padding: 8px 14px; border-radius: 999px; font-size: .85rem; font-weight: 700; white-space: nowrap;
               background: #f1f5f9; color: #475569; border: 1.5px solid #e2e8f0; user-select: none; }
    .apv-tab.active { background: #1d4ed8; color: #fff; border-color: #1d4ed8; }
    .ts-chip-n { margin-left: 6px; font-size: .75rem; opacity: .75; }
    .ts-chip-n:empty { display: none; }
    #apv-pending .ts-chip-n:not(:empty) { opacity: 1; background: #ef4444; color: #fff; border-radius: 999px; padding: 0 6px; }

    /* ── Bảng (web) ── */
    .ts-table th { font-size: .7rem; text-transform: uppercase; color: #64748b; font-weight: 800; letter-spacing: .03em; background: #f8fafc; }
    .ts-table td { vertical-align: middle; }
    .ts-table th, .ts-table td { padding-left: .5rem !important; padding-right: .5rem !important; }
    tr.row-stale-pending { background: linear-gradient(90deg, #fff1f2 0%, transparent 30%) !important; border-left: 4px solid #dc2626 !important; }
    tr.row-stale-pending td { background: transparent !important; }
    .ts-time-chip { display: inline-flex; align-items: center; background: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe; border-radius: 8px; padding: 2px 8px; font-size: .78rem; white-space: nowrap; }
    .ts-time-created { font-size: .7rem; color: #94a3b8; margin-top: 2px; }
    .pending-age { display: inline-block; margin-top: 4px; padding: 2px 8px; border-radius: 999px; font-size: .7rem; font-weight: 700; background: #fef3c7; color: #92400e; border: 1px solid #fbbf24; }
    .pending-age.stale { background: #fee2e2; color: #991b1b; border-color: #dc2626; animation: pulse-red 1.6s infinite ease-in-out; }
    @@keyframes pulse-red { 0%,100% { box-shadow: 0 0 0 0 rgba(220,38,38,.5); } 50% { box-shadow: 0 0 0 6px rgba(220,38,38,0); } }
    .sig-cell      { display: flex; gap: 8px; justify-content: center; align-items: flex-start; }
    .sig-cell-item { text-align: center; min-width: 80px; }
    .sig-cell-lbl  { font-size: .6rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: .04em; margin-bottom: 2px; }
    .sig-cell-img  { display: block; margin: 0 auto; max-height: 55px; max-width: 110px; object-fit: contain; background: #fafafa; border-radius: 4px; padding: 2px; }
    .sig-cell-name { font-size: .65rem; color: #64748b; margin-top: 2px; line-height: 1.2; }
    .ts-act { display: inline-flex; flex-direction: column; gap: 6px; min-width: 92px; }
    .ts-act .btn { padding: 6px 10px; text-transform: none; }
    .ts-dept1 { line-height: 1.2; max-width: 160px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ts-time-chip { white-space: nowrap; }
    .ts-sig-td .sig-cell-item { min-width: 64px; }
    .ts-sig-td .sig-cell-img  { max-height: 38px; max-width: 80px; }
    .ts-act .btn { margin: 0; font-weight: 700; }

    /* ── Thẻ đơn (điện thoại) ── */
    .ts-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 10px; padding: 0 12px 4px; align-items: start; }
    .ts-item { border-radius: 16px; background: #fff; border: 1px solid #e8edf3; padding: 12px; box-shadow: 0 1px 2px rgba(15,23,42,.04); }
    .ts-item.stale { border-color: #fca5a5; box-shadow: inset 4px 0 0 #dc2626; }
    .ts-item-top { display: flex; align-items: flex-start; gap: 10px; }
    .ts-who { flex: 1; min-width: 0; }
    .ts-name { font-weight: 800; color: #0f172a; font-size: 1rem; line-height: 1.25; text-transform: uppercase; word-break: break-word; }
    .ts-sub  { font-size: .78rem; color: #64748b; margin-top: 2px; line-height: 1.3; }
    .ts-sub .ts-dept { display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
    .ts-st { flex-shrink: 0; font-size: .75rem; font-weight: 800; padding: 4px 10px; border-radius: 999px; white-space: nowrap; }
    .ts-st.pending  { background: #fef3c7; color: #92400e; }
    .ts-st.approved { background: #dcfce7; color: #166534; }
    .ts-st.rejected { background: #fee2e2; color: #991b1b; }
    .ts-item-mid { display: flex; align-items: center; flex-wrap: wrap; gap: 6px 8px; margin-top: 10px; }
    .ts-item-mid .badge { font-size: .75rem; }
    .ts-date { font-size: .92rem; font-weight: 700; color: #1e293b; }
    .ts-days { font-size: .8rem; font-weight: 800; color: #1d4ed8; background: #eff6ff; border-radius: 8px; padding: 2px 8px; }
    .ts-reason { margin-top: 8px; font-size: .88rem; color: #334155; background: #f8fafc; border-radius: 10px; padding: 8px 10px; line-height: 1.4; word-break: break-word; }
    .ts-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 6px 10px; margin-top: 8px; font-size: .75rem; color: #94a3b8; }
    .ts-meta .pending-age { margin-top: 0; }
    .ts-link { border: 0; background: none; padding: 0; color: #2563eb; font-weight: 700; font-size: .78rem; }
    .ts-sig { display: none; margin-top: 8px; padding-top: 8px; border-top: 1px dashed #e2e8f0; }
    .ts-sig.open { display: block; }
    .ts-btns { display: grid; grid-template-columns: 1fr 1.4fr; gap: 8px; margin-top: 12px; }
    .ts-btns .btn { margin: 0; height: 48px; border-radius: 12px; font-size: 1rem; font-weight: 800; display: flex; align-items: center; justify-content: center; gap: 6px; text-transform: none; }
    .ts-btns .btn-reject { background: #fff; color: #dc2626; border: 1.5px solid #fca5a5; }
    .ts-btns .btn-approve { background: #16a34a; color: #fff; border: 0; box-shadow: 0 4px 10px rgba(22,163,74,.25); }
    .ts-note { margin-top: 10px; font-size: .82rem; font-weight: 600; color: #b45309; background: #fffbeb; border-radius: 10px; padding: 8px 10px; }
    .ts-note.muted { color: #64748b; background: #f1f5f9; }

    .ts-foot { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 10px 16px 14px; flex-wrap: wrap; }
    .pagination .page-link { cursor: pointer; border-radius: 10px !important; margin: 0 2px; min-width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; }
    .pagination .page-item.disabled .page-link { cursor: default; }
    .pagination .page-item.active .page-link { background: #1d4ed8; border-color: #1d4ed8; }
    .ts-empty { text-align: center; padding: 36px 12px; color: #94a3b8; font-size: .9rem; }
    .ts-empty img { width: 120px; opacity: .85; display: block; margin: 0 auto 10px; }

    /* ── Sắp lịch ── */
    .ts-filter-row { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 8px; }
    .ts-filter-row select { flex: 1; min-width: 120px; height: 42px; border-radius: 10px; }
    .ts-filter-toggle { display: none; }
    .ts-quick { display: flex; align-items: center; gap: 12px; margin: 6px 0 8px; font-size: .85rem; }
    .ts-quick button { border: 0; background: none; padding: 0; color: #2563eb; font-weight: 700; }
    .ts-legend { margin-left: auto; display: flex; gap: 8px; font-size: .72rem; color: #64748b; }
    .ts-legend i { display: inline-block; width: 9px; height: 9px; border-radius: 3px; margin-right: 3px; vertical-align: 0; }
    .emp-list-wrap { max-height: 460px; overflow-y: auto; border: 1px solid #e2e8f0; border-radius: 14px; background: #fff; }
    .emp-item { display: flex; align-items: center; gap: 10px; padding: 10px 12px; min-height: 60px; border-bottom: 1px solid #f1f5f9; cursor: pointer; margin: 0; }
    .emp-item:last-child { border-bottom: none; }
    .emp-item.checked { background: #eff6ff; }
    .emp-item input[type=checkbox] { width: 22px; height: 22px; accent-color: #1d4ed8; flex-shrink: 0; cursor: pointer; }
    .emp-item .emp-info { display: flex; flex-direction: column; min-width: 0; flex: 1; }
    .emp-item .emp-name { font-size: .92rem; font-weight: 700; color: #1e293b; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .emp-item .emp-dept { font-size: .75rem; color: #64748b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .emp-item .emp-code { font-size: .75rem; color: #94a3b8; font-family: monospace; }
    .emp-item .ep-av { margin: 0; }
    .leave-badge { font-size: .72rem; font-weight: 800; padding: 3px 8px; border-radius: 999px; flex-shrink: 0; white-space: nowrap; }
    .lb-empty { background: #fee2e2; color: #b91c1c; }
    .lb-low   { background: #fef3c7; color: #92400e; }
    .lb-ok    { background: #dcfce7; color: #166534; }
    #assignForm, #assignResults, #scheduleTab { scroll-margin-top: 84px; }   /* cuộn tới không bị thanh đầu trang che */
    .ts-form label { font-size: .82rem; font-weight: 700; color: #334155; margin-bottom: 4px; }
    .ts-form .form-control, .ts-form .form-select { height: 46px; border-radius: 12px; font-size: .95rem; }
    .ts-form .form-control[readonly] { background: #f8fafc; font-weight: 800; color: #1d4ed8; }
    .ts-picked { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
    .ts-picked:empty::before { content: attr(data-empty); font-size: .85rem; color: #94a3b8; }
    .ts-pick { display: inline-flex; align-items: center; gap: 4px; background: #eff6ff; color: #1e3a8a; border: 1px solid #bfdbfe; border-radius: 999px; padding: 3px 4px 3px 10px; font-size: .8rem; font-weight: 700; max-width: 100%; }
    .ts-pick span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ts-pick button { border: 0; background: #dbeafe; color: #1e3a8a; width: 22px; height: 22px; border-radius: 50%; line-height: 1; flex-shrink: 0; }
    .ts-submit { height: 52px; border-radius: 14px; font-size: 1.02rem; font-weight: 800; text-transform: none; }
    .result-item { padding: 8px 10px; border-radius: 10px; margin-bottom: 6px; font-size: .85rem; }
    .result-item.ok  { background: #ecfdf5; border-left: 3px solid #10b981; color: #065f46; }
    .result-item.err { background: #fff0f0; border-left: 3px solid #ef4444; color: #7f1d1d; }
    /* Thanh đáy của tab Sắp lịch (điện thoại/tablet: nằm ngay trên menu dưới) */
    .ts-bar { position: fixed; left: 0; right: 0; bottom: 68px; z-index: 1019; display: none; align-items: center; gap: 10px;
              padding: 10px 14px; background: #fff; box-shadow: 0 -1px 0 rgba(15,23,42,.08), 0 -8px 20px rgba(15,23,42,.06); }
    .ts-bar-count { flex: 1; font-size: .85rem; color: #475569; line-height: 1.25; }
    .ts-bar-count b { display: block; font-size: 1.05rem; color: #0f172a; }
    .ts-bar .btn { margin: 0; height: 48px; border-radius: 12px; padding: 0 18px; font-weight: 800; font-size: .98rem; text-transform: none; }
    body.kb-open .ts-bar { display: none !important; }
    .ts-bar #tsBarBack { padding: 0 14px; background: #f1f5f9; color: #334155; border: 0; }
    /* Thanh bước (điện thoại/tablet): 1 Chọn NV → 2 Ngày nghỉ */
    .ts-stepper { display: flex; align-items: center; gap: 6px; margin-bottom: 12px; }
    .ts-stepper > i { color: #cbd5e1; }
    .ts-stp { flex: 1; display: flex; align-items: center; gap: 8px; border: 0; background: #fff; border-radius: 14px; padding: 10px 12px;
              font-weight: 800; color: #94a3b8; font-size: .9rem; box-shadow: 0 0 0 1px rgba(15,23,42,.06); text-align: left; }
    .ts-stp span { width: 26px; height: 26px; border-radius: 50%; background: #e2e8f0; color: #64748b; flex-shrink: 0;
                   display: inline-flex; align-items: center; justify-content: center; font-size: .82rem; }
    .ts-stp.on { color: #1d4ed8; box-shadow: 0 0 0 2px #93c5fd; }
    .ts-stp.on span { background: #1d4ed8; color: #fff; }
    .ts-stp.done { color: #15803d; }
    .ts-stp.done span { background: #16a34a; color: #fff; }
    .ts-step2-hint { background: #eff6ff; color: #1e3a8a; border-radius: 12px; padding: 10px 12px; font-size: .9rem; margin-bottom: 10px; line-height: 1.4; }
    .ts-emp-pager { display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 10px; font-size: .8rem; color: #64748b; }

    /* ── Đã sắp: số liệu 1 hàng ── */
    .ts-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-bottom: 12px; }
    .ts-stat { background: #fff; border-radius: 14px; padding: 10px 12px; box-shadow: 0 0 0 1px rgba(15,23,42,.05); }
    .ts-stat div { font-size: .72rem; font-weight: 700; color: #64748b; }
    .ts-stat b { font-size: 1.35rem; color: #0f172a; }
    .ts-stat.warn b { color: #d97706; } .ts-stat.ok b { color: #16a34a; }
    .ts-toolbar select { height: 44px; border-radius: 12px; max-width: 220px; }

    /* ── Hộp xác nhận duyệt ── */
    #tsActionModal .modal-content { border: 0; border-radius: 20px; overflow: hidden; }
    .ts-act-who { background: #f8fafc; border-radius: 12px; padding: 10px 12px; margin-bottom: 12px; font-size: .88rem; color: #334155; }
    .ts-act-who b { color: #0f172a; text-transform: uppercase; }
    #tsActionModal .modal-footer .btn { height: 48px; border-radius: 12px; font-weight: 800; flex: 1; margin: 0; text-transform: none; }

    @@media (max-width: 991.98px) {
        .ts-bar.on-tab { display: flex; }
        #tab-assign { padding-bottom: 80px; }
        .emp-list-wrap { max-height: none; overflow: visible; }
        #tab-assign:not(.step-2) #assignColForm { display: none; }
        #tab-assign.step-2 #assignColList { display: none; }
        #assignBtn { display: none; }
    }
    @@media (max-width: 767.98px) {
        .container-fluid.ts-page { padding-left: 10px !important; padding-right: 10px !important; }
        .ts-tabs { gap: 8px; }
        .ts-tabs .nav-link { flex-direction: column; justify-content: center; gap: 6px; padding: 10px 4px; text-align: center; }
        .ts-tabs .ts-tab-txt { align-items: center; }
        .ts-tab-ic { width: 40px; height: 40px; }
        .ts-tab-label { font-size: .9rem; }
        .ts-tab-sub { display: none; }
        .ts-toolbar { padding: 12px 12px 6px; }
        .ts-month { width: 100%; justify-content: space-between; }
        .ts-toolbar .ts-search { min-width: 100%; }
        .ts-card-pad .ts-search { min-width: 0; }
        .ts-chips { padding: 4px 12px 10px; }
        .ts-cards { grid-template-columns: 1fr; }
        .ts-filter-toggle { display: inline-flex; }
        .ts-filter-row { display: none; }
        .ts-filter-row.open { display: flex; }
        .ts-filter-row select { min-width: 100%; }
        .ts-legend { display: none; }
        .ts-card-pad { padding: 12px; }
        .ts-stat b { font-size: 1.15rem; }
        /* Hộp xác nhận: trượt từ dưới lên */
        #tsActionModal .modal-dialog { position: fixed; left: 0; right: 0; bottom: 0; margin: 0; max-width: none !important; min-height: 0; transform: translateY(100%); transition: transform .28s cubic-bezier(.32,.72,0,1); }
        #tsActionModal.show .modal-dialog { transform: none; }
        #tsActionModal .modal-content { border-radius: 22px 22px 0 0; padding-bottom: env(safe-area-inset-bottom); }
    }
</style>
}

<div class="container-fluid py-3 ts-page">

    <ul class="nav ts-tabs" id="scheduleTab" role="tablist">
        <li class="nav-item" role="presentation" id="tabApproveLi">
            <button class="nav-link active" id="tab-approve-btn" data-bs-toggle="pill" data-bs-target="#tab-approve" type="button">
                <span class="ts-tab-ic c1"><i class="bi bi-shield-check"></i></span>
                <span class="ts-tab-txt">
                    <span class="ts-tab-label">Duyệt <span id="pendingBadge" class="ts-tab-badge d-none"></span></span>
                    <span class="ts-tab-sub">Đơn nghỉ của nhân viên</span>
                </span>
            </button>
        </li>
