@section Scripts {
<script>
const NO_DATA_IMG = '@(new Random().Next(2)==0 ? Url.Content("~/assets/img/illustrations/A_nodata.png") : Url.Content("~/assets/img/illustrations/Chi_nodata.png"))';
function emptyHtml(msg) { return `<div class="ts-empty"><img src="${NO_DATA_IMG}" alt="">${msg}</div>`; }
function emptyRow(msg, cols=9) { return `<tr><td colspan="${cols}">${emptyHtml(msg)}</td></tr>`; }

const MY_ASSIGN_URL  = '@Url.Action("GetMyAssignmentsPage",   "Leave")';
const ASSIGN_URL     = '@Url.Action("AssignLeave",            "Leave")';
const APPROVE_URL    = '@Url.Action("ApproveRequest",         "Leave")';
const REJECT_URL     = '@Url.Action("RejectRequest",          "Leave")';
const PAGE_URL       = '@Url.Action("GetApprovalListPage",    "Leave")';
const SIG_URL        = '@Url.Action("GetSignature",           "Image")';
const EMP_PAGE_URL    = '@Url.Action("GetAssignEmps",       "Leave")';
const EMP_FILTERS_URL = '@Url.Action("GetAssignEmpFilters", "Leave")';
const CURRENT_ROLE  = '@ViewBag.CurrentRole';
const CURRENT_EMPCD = '@ViewBag.CurrentEmpCd';
const CAN_ASSIGN    = ['Supervisor','DeputyManager','Manager','Admin'].includes(CURRENT_ROLE);
const CAN_APPROVE   = ['Supervisor','DeputyManager','Manager','Admin'].includes(CURRENT_ROLE);
const ROLE_LEVELS   = { Admin:99, Expat:5, Manager:4, DeputyManager:3, Supervisor:2, HR:1, Clerk:1, Worker:1 };
const MY_LEVEL      = ROLE_LEVELS[CURRENT_ROLE] || 1;

let curMonth = @curMonth, curYear = @curYear;
let empLoaded     = false;
let maLoaded      = false;
const selected    = new Map();      // NV đã chọn: mã → { name, left } — giữ nguyên khi chuyển trang / tìm / lọc
let apvStatus = '', apvPage = 1, apvTotal = 0, apvTotalPages = 0, apvPageSize = 20;
let apvItems  = {};                 // REQUEST_ID -> đơn (để hộp xác nhận nói rõ đơn của ai)
let maPage = 1, maTotal = 0, maTotalPages = 0, maPageSize = 20;
let apvEmpTimeout, maEmpTimeout;

const MONTHS_VI  = ['Tháng 1','Tháng 2','Tháng 3','Tháng 4','Tháng 5','Tháng 6',
                    'Tháng 7','Tháng 8','Tháng 9','Tháng 10','Tháng 11','Tháng 12'];
const LEAVE_LABEL = { AL:'Phép năm', CL:'BHXH', SL:'Bệnh', NPL:'Không lương', OTH:'Khác', NL:'Không lương', SI:'Bệnh có giấy', DT:'Đám tang', DC:'Đám cưới', CT:'Công tác', VS:'Vợ sanh', DS:'Dưỡng sức', KT:'Khám thai' };
const LEAVE_COLOR = { AL:'primary', CL:'info', SL:'danger', NPL:'secondary', OTH:'warning', NL:'secondary', SI:'danger', DT:'dark', DC:'success', CT:'primary', VS:'info', DS:'warning', KT:'info' };
// Loại bắt buộc nộp giấy tờ chứng minh — để quản lý xem NV mình đã nộp giấy đủ chưa.
const DOC_REQUIRED_TYPES = ['SI', 'DT', 'DC', 'VS', 'KT'];

function docDetailBtnHtml(item, asLink) {
    if (!DOC_REQUIRED_TYPES.includes(item.LEAVE_TYPE)) return '';
    return asLink
        ? `<button type="button" class="ts-link" onclick="viewDocDetail('${item.REQUEST_ID}')"><i class="bi bi-file-earmark-check me-1"></i>Đã nộp giấy?</button>`
        : `<button class="btn btn-outline-secondary btn-sm py-0 px-1 mt-1" style="font-size:.68rem;" onclick="event.stopPropagation();viewDocDetail('${item.REQUEST_ID}')"><i class="bi bi-eye"></i> Đã nộp giấy?</button>`;
}
const docDetailModal = new bootstrap.Modal(document.getElementById('docDetailModal'));
async function viewDocDetail(requestId) {
    document.getElementById('docDetailListWrap').innerHTML = '<div class="text-center py-3 text-muted"><div class="spinner-border spinner-border-sm"></div></div>';
    docDetailModal.show();
    try {
        const res = await $.get('@Url.Action("GetDocDayList", "Leave")', { requestId });
        if (!res.success) {
            document.getElementById('docDetailListWrap').innerHTML = `<div class="text-danger text-sm">${escHtml(res.message || 'Lỗi tải dữ liệu')}</div>`;
            return;
        }
        const DOW = ['CN','T2','T3','T4','T5','T6','T7'];
        document.getElementById('docDetailListWrap').innerHTML = (res.days || []).map(d => {
            const dt = new Date(d.date);
            const label = `${('0'+dt.getDate()).slice(-2)}/${('0'+(dt.getMonth()+1)).slice(-2)} (${DOW[dt.getDay()]})`;
            const statusHtml = d.confirmed ? `<span class="badge bg-success">Đã nộp</span>` : `<span class="badge bg-secondary">Chưa nộp</span>`;
            return `<div class="d-flex align-items-center gap-2 py-1" style="border-bottom:1px solid #f1f5f9;">
                <div style="width:90px;" class="text-sm text-nowrap">${label}</div>
                <div style="width:90px;">${statusHtml}</div>
                <div class="text-sm" style="width:90px;">${d.leavecd ? `<span class="badge bg-light text-dark border">${escHtml(d.leavecd)}</span>` : '<span class="text-muted">-</span>'}</div>
                <div class="text-sm flex-grow-1 text-secondary">${escHtml(d.remark || '-')}</div>
            </div>`;
        }).join('') || '<div class="text-muted text-sm">Không có dữ liệu</div>';
    } catch (e) {
        document.getElementById('docDetailListWrap').innerHTML = '<div class="text-danger text-sm">Lỗi kết nối</div>';
    }
}

function getMonthRange() {
    const firstDay = new Date(curYear, curMonth - 1, 1);
    const lastDay  = new Date(curYear, curMonth, 0);
    const fmt = d => d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
    return { from: fmt(firstDay), to: fmt(lastDay) };
}

function updateMonthLabel() {
    $('.month-label-display').text(MONTHS_VI[curMonth-1] + ' / ' + curYear);
}

// ─── Sắp lịch ────────────────────────────────────────────────────
// Danh sách NV PHÂN TRANG BẰNG SQL (Leave/GetAssignEmps): mỗi lần chỉ tải 1 trang 30 NV + phép còn lại của
// đúng 30 NV đó. Trước đây tải 1 lần toàn bộ phạm vi (vài trăm NV) + phép năm của tất cả → mở tab chậm.
// NV đã chọn giữ trong `selected` (mã → tên + phép còn lại) nên chuyển trang / đổi lọc không mất.
const EMP_PAGE_SIZE = 30;
let empPage = 1, empTotal = 0, empPages = 0, empReq = 0, empSearchTimer;
let filterRows = [];

function empQuery() {
    return {
        search: ($('#empSearch').val() || '').trim(),
        dept:   $('#filterEmpDept').val() || '',
        line:   $('#filterEmpLine').val() || '',
        work:   $('#filterEmpWork').val() || ''
    };
}

function loadEmps() {
    if (empLoaded) return;
    empLoaded = true;
    $.get(EMP_FILTERS_URL).done(function (res) {
        filterRows = (res && res.data) || [];
        buildDeptOptions();
    });
    loadEmpPage(1);
}

function loadEmpPage(page) {
    empPage = page;
    const my = ++empReq;                       // gõ tìm nhanh: chỉ nhận kết quả của lần gọi mới nhất
    $('#empList').html('<div class="ts-empty"><div class="spinner-border spinner-border-sm me-2" role="status"></div> Đang tải...</div>');
    $.get(EMP_PAGE_URL, Object.assign(empQuery(), { page, page_size: EMP_PAGE_SIZE }))
        .done(function (res) {
            if (my !== empReq) return;
            if (!res || !res.success) {
                empLoaded = false;
                $('#empList').html(`<div class="ts-empty text-danger"><i class="bi bi-exclamation-triangle me-1"></i>${escHtml((res && res.message) || 'Lỗi tải danh sách nhân viên')}</div>`);
                $('#empPager').empty();
                return;
            }
            empTotal = res.total || 0;
            empPages = res.total_pages || 0;
            renderEmpList(res.data || []);
            renderEmpPager();
            $('#btnSelectAll').html(`<i class="bi bi-check2-all me-1"></i>Chọn tất cả${empTotal ? ' (' + empTotal + ')' : ''}`);
        })
        .fail(function () {
            if (my !== empReq) return;
            empLoaded = false;
            $('#empList').html('<div class="ts-empty text-danger"><i class="bi bi-exclamation-triangle me-1"></i>Lỗi kết nối — thử lại</div>');
        });
}

function empLeaveBadge(left) {
    if (left == null) return '';
    if (left <= 0)  return `<span class="leave-badge lb-empty">Hết phép</span>`;
    if (left <= 3)  return `<span class="leave-badge lb-low">${left} ngày</span>`;
    return `<span class="leave-badge lb-ok">${left} ngày</span>`;
}

let pageEmps = {};                 // mã → NV của trang đang xem (để lưu tên/phép khi bấm chọn)
function renderEmpList(emps) {
    pageEmps = {};
    emps.forEach(e => { pageEmps[e.empcd] = e; });
    if (!emps.length) {
        $('#empList').html('<div class="ts-empty"><i class="bi bi-people fs-4 d-block mb-2"></i>Không có nhân viên phù hợp</div>');
        return;
    }
    $('#empList').html(emps.map(e => {
        const cd = e.empcd || '';
        const on = selected.has(cd);
        return `<label class="emp-item ${on ? 'checked' : ''}" data-empcd="${escHtml(cd)}">
            <input type="checkbox" class="emp-chk" value="${escHtml(cd)}" ${on ? 'checked' : ''} onchange="toggleEmp(this)" />
            <span data-emp-photo="${escHtml(cd)}" data-emp-name="${escHtml(e.name||'')}"></span>
            <div class="emp-info">
                <div class="emp-name vni-font">${escHtml(e.name||'')}</div>
                <div class="emp-dept"><span class="emp-code">${escHtml(cd)}</span>${e.dept_name ? ' · ' + escHtml(e.dept_name) : ''}${e.line_name ? ' / ' + escHtml(e.line_name) : ''}</div>
            </div>
            ${empLeaveBadge(e.LEFT_NUM)}
        </label>`;
    }).join(''));
}
// Đánh dấu lại ô tick theo `selected` mà không tải lại trang
function syncEmpChecks() {
    document.querySelectorAll('#empList .emp-chk').forEach(c => {
        c.checked = selected.has(c.value);
        c.closest('.emp-item')?.classList.toggle('checked', c.checked);
    });
}

function renderEmpPager() {
    if (!empTotal) { $('#empPager').empty(); return; }
    const s = (empPage - 1) * EMP_PAGE_SIZE + 1, e = Math.min(empPage * EMP_PAGE_SIZE, empTotal);
    const $info = $('<span>').html(`${s}–${e} / <strong>${empTotal}</strong> nhân viên`);
    const $ul = $('<ul class="pagination pagination-sm mb-0">');
    const mk = (label, p, disabled, active) => {
        const li = $('<li class="page-item">').toggleClass('disabled', !!disabled).toggleClass('active', !!active);
        $('<a class="page-link">').html(label).on('click', () => { if (!disabled && !active) goEmpPage(p); }).appendTo(li);
        return li;
    };
    if (empPages > 1) {
        $ul.append(mk('&lsaquo;', empPage - 1, empPage <= 1));
        const from = Math.max(1, empPage - 2), to = Math.min(empPages, empPage + 2);
        for (let p = from; p <= to; p++) $ul.append(mk(p, p, false, p === empPage));
        $ul.append(mk('&rsaquo;', empPage + 1, empPage >= empPages));
    }
    $('#empPager').empty().append($info, $('<nav>').append($ul));
}
function goEmpPage(p) {
    loadEmpPage(p);
    document.getElementById('empList').scrollTop = 0;
    document.getElementById('assignColList').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

// 3 ô lọc bộ phận → line → nhóm (lọc theo MÃ, danh sách lấy 1 lần từ Leave/GetAssignEmpFilters)
function fillSelect(id, label, rows, codeKey, nameKey) {
    const seen = new Set(), $s = $('#' + id).empty().append(`<option value="">${label}</option>`);
    rows.forEach(r => {
        const c = r[codeKey]; if (!c || seen.has(c)) return; seen.add(c);
        $s.append(`<option value="${escHtml(c)}">${escHtml(r[nameKey] || c)}</option>`);
    });
    $s.prop('disabled', seen.size === 0);
}
function buildDeptOptions() {
    fillSelect('filterEmpDept', 'Tất cả bộ phận', filterRows, 'dept', 'dept_name');
    buildLineOptions('');
    buildWorkOptions('', '');
}
function buildLineOptions(dept) {
    fillSelect('filterEmpLine', 'Tất cả line', filterRows.filter(r => !dept || r.dept === dept), 'line', 'line_name');
}
function buildWorkOptions(dept, line) {
    fillSelect('filterEmpWork', 'Tất cả nhóm việc',
        filterRows.filter(r => (!dept || r.dept === dept) && (!line || r.line === line)), 'work', 'work_name');
}
function onDeptFilter() {
    buildLineOptions($('#filterEmpDept').val());
    buildWorkOptions($('#filterEmpDept').val(), '');
    loadEmpPage(1);
}
function onLineFilter() {
    buildWorkOptions($('#filterEmpDept').val(), $('#filterEmpLine').val());
    loadEmpPage(1);
}
// Ô tìm gọi qua đây (chờ gõ xong 350ms); ô "nhóm việc" cũng gọi filterEmps
function filterEmps() {
    clearTimeout(empSearchTimer);
    empSearchTimer = setTimeout(() => loadEmpPage(1), 350);
}

function toggleEmp(chk) {
    if (chk.checked) {
        const e = pageEmps[chk.value] || {};
        selected.set(chk.value, { name: e.name || chk.value, left: e.LEFT_NUM ?? null });
    } else selected.delete(chk.value);
    chk.closest('.emp-item')?.classList.toggle('checked', chk.checked);
    updateSelCount();
}
// "Chọn tất cả" = MỌI NV khớp tìm/lọc hiện tại, ở TẤT CẢ các trang (hỏi server danh sách mã, không phải chỉ trang đang xem)
async function selectAllEmps() {
    const $b = $('#btnSelectAll').prop('disabled', true);
    try {
        const res = await $.get(EMP_PAGE_URL, Object.assign(empQuery(), { all: true }));
        if (!res || !res.success) { showToast((res && res.message) || 'Không lấy được danh sách', 'error'); return; }
        let added = 0;
        (res.data || []).forEach(e => {
            if (!e.empcd || selected.has(e.empcd)) return;
            selected.set(e.empcd, { name: e.name || e.empcd, left: e.LEFT_NUM ?? null });
            added++;
        });
        syncEmpChecks();
        updateSelCount();
        showToast(added ? `Đã chọn thêm ${added} nhân viên (tổng ${selected.size})` : 'Tất cả nhân viên đang lọc đã được chọn', 'success');
    } catch { showToast('Lỗi kết nối', 'error'); }
    finally { $b.prop('disabled', false); }
}
function clearAllEmps()   { selected.clear(); syncEmpChecks(); updateSelCount(); }
function unpickEmp(cd)    { selected.delete(cd); syncEmpChecks(); updateSelCount(); }
function getSelectedEmpcds() { return [...selected.keys()]; }
function updateSelCount() {
    const n = selected.size;
    $('#selCount').text(n + ' NV');
    $('#step2Hint').html(n
        ? `Sắp lịch nghỉ cho <b>${n} nhân viên</b> dưới đây. Bấm <b>×</b> để bỏ bớt, rồi chọn ngày nghỉ.`
        : 'Chưa chọn nhân viên nào — bấm <b>← Chọn nhân viên</b> ở dưới để quay lại bước 1.');
    $('#selPicked').html([...selected].map(([cd, info]) => {
        return `<span class="ts-pick"><span class="vni-font">${escHtml(info.name || cd)}</span><button type="button" onclick="unpickEmp('${escHtml(cd)}')" aria-label="Bỏ">×</button></span>`;
    }).join(''));
    updateAssignBar();
}

// Điện thoại/tablet: 2 bước tách hẳn (Bước 1 chọn NV → Bước 2 chọn ngày), thanh đáy dẫn đường.
// Máy tính: 2 cột cạnh nhau như cũ, assignStep không ảnh hưởng gì.
let assignStep = 1;
function goStep(n) {
    if (n === 2 && !selected.size) { showToast('Chọn ít nhất 1 nhân viên trước đã', 'warning'); return; }
    assignStep = n;
    document.getElementById('tab-assign').classList.toggle('step-2', n === 2);
    $('#tsStp1').toggleClass('on', n === 1).toggleClass('done', n === 2);
    $('#tsStp1 span').text(n === 2 ? '✓' : '1');
    $('#tsStp2').toggleClass('on', n === 2);
    updateAssignBar();
    if (window.innerWidth < 992) window.scrollTo({ top: 0, behavior: 'smooth' });
}
function updateAssignBar() {
    const n = selected.size;
    const ready = n > 0 && $('#assignFromDate').val() && $('#assignToDate').val();
    $('#tsBarNum').text(n + ' nhân viên');
    $('#tsBarBack').toggleClass('d-none', assignStep !== 2);
    let hint, btn, cls = 'btn-primary';
    if (assignStep === 1) {
        hint = n ? 'đã chọn' : 'bấm vào tên để chọn';
        btn  = 'Tiếp tục <i class="bi bi-arrow-right ms-1"></i>';
    } else if (!n) {
        hint = 'chưa chọn ai';
        btn  = '<i class="bi bi-arrow-left me-1"></i>Chọn nhân viên';
    } else {
        hint = ready ? 'sẵn sàng sắp lịch' : 'chọn Từ ngày – Đến ngày';
        btn  = '<i class="bi bi-send me-1"></i>Sắp lịch';
        cls  = ready ? 'btn-success' : 'btn-secondary';
    }
    $('#tsBarHint').text(hint);
    $('#tsBarBtn').html(btn).removeClass('btn-primary btn-success btn-secondary').addClass(cls);
}
function assignBarGo() {
    if (assignStep === 1) { goStep(2); return; }
    if (!selected.size) { goStep(1); return; }
    if (!$('#assignFromDate').val() || !$('#assignToDate').val()) {
        showToast('Chọn Từ ngày và Đến ngày nghỉ', 'warning');
        document.getElementById('assignFromDate').focus();
        return;
    }
    submitAssign();
}

function isSunday(dateStr) {
    if (!dateStr) return false;
    const p = dateStr.split('-');
    return new Date(Date.UTC(+p[0], +p[1]-1, +p[2])).getUTCDay() === 0;
}

function calcAssignDays() {
    const f = $('#assignFromDate').val(), t = $('#assignToDate').val();
    if (f && isSunday(f)) {
        $('#assignFromDate').val('');
        showToast('Từ ngày không được là Chủ Nhật (công ty làm T2–T7)', 'warning');
        updateAssignBar();
        return;
    }
    if (t && isSunday(t)) {
        $('#assignToDate').val('');
        showToast('Đến ngày không được là Chủ Nhật (công ty làm T2–T7)', 'warning');
        updateAssignBar();
        return;
    }
    // Chọn "Từ ngày" mà chưa có "Đến ngày" (hoặc đến < từ) → đặt luôn bằng từ ngày (nghỉ 1 ngày) cho đỡ 1 bước
    if (f && (!t || t < f)) $('#assignToDate').val(f);
    $('#assignToDate').attr('min', f || '@todayMin');
    const t2 = $('#assignToDate').val();
    if (f && t2) {
        const pf = f.split('-'), pt = t2.split('-');
        const d1 = Date.UTC(+pf[0], +pf[1]-1, +pf[2]);
        const d2 = Date.UTC(+pt[0], +pt[1]-1, +pt[2]);
        if (d2 >= d1) {
            let count = 0;
            for (let d = d1; d <= d2; d += 86400000) {
                if (new Date(d).getUTCDay() !== 0) count++;
            }
            $('#assignTotalDays').val(count);
        }
    }
    updateAssignBar();
}

async function submitAssign() {
    const empList   = getSelectedEmpcds();
    const leaveType = $('#assignLeaveType').val();
    const from      = $('#assignFromDate').val();
    const to        = $('#assignToDate').val();
    const days      = parseFloat($('#assignTotalDays').val());
    const reason    = $('#assignReason').val().trim() || null;
    if (!empList.length)    { showToast('Chọn ít nhất 1 nhân viên', 'warning'); return; }
    if (!from || !to)       { showToast('Vui lòng chọn ngày', 'warning'); return; }
    const _today = new Date(); _today.setHours(0,0,0,0);
    if (new Date(from) <= _today) { showToast('Chỉ được sắp lịch từ ngày mai trở đi', 'warning'); return; }
    if (isSunday(from))     { showToast('Từ ngày không được là Chủ Nhật (công ty làm T2–T7)', 'warning'); return; }
    if (isSunday(to))       { showToast('Đến ngày không được là Chủ Nhật (công ty làm T2–T7)', 'warning'); return; }
    if (!days || days <= 0) { showToast('Số ngày nghỉ không hợp lệ', 'warning'); return; }
    if (leaveType !== 'AL' && !reason) { showToast('Vui lòng nhập lý do nghỉ', 'warning'); return; }

    const showResults = () => document.getElementById('assignResults').scrollIntoView({ behavior: 'smooth', block: 'center' });

    // Cảnh báo nhân viên không đủ phép năm nếu chọn loại AL
    if (leaveType === 'AL') {
        const notEnough = empList.filter(cd => {
            const left = selected.get(cd)?.left;
            return left != null && left < days;
        });
        if (notEnough.length > 0) {
            const names = notEnough.map(cd => {
                const info = selected.get(cd);
                return `<strong>${cd}</strong> <span class="vni-font">${escHtml(info?.name || '')}</span> (còn ${info?.left ?? 0} ngày)`;
            }).join('<br>');
            $('#assignResults').html(`<div class="alert alert-warning py-2 px-3 mb-0" style="font-size:.85rem;">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                <strong>Lưu ý:</strong> ${notEnough.length} nhân viên không đủ phép năm cho ${days} ngày:<br>${names}<br>
                <small class="text-muted">Vui lòng đổi loại nghỉ hoặc điều chỉnh số ngày cho phù hợp.</small>
            </div>`);
            showResults();
            return;
        }
    }

    const $btn = $('#assignBtn, #tsBarBtn').prop('disabled', true);
    $('#assignBtn').html('<span class="spinner-border spinner-border-sm me-1"></span>Đang kiểm tra...');
    $('#assignResults').empty();
    try {
        // Kiểm tra overlap: NV đã có đơn PENDING hoặc APPROVED trong khoảng ngày này
        const checkRes = await $.ajax({
            url: PAGE_URL, type: 'GET',
            data: { page: 1, page_size: 200, date_from: from, date_to: to }
        });
        if (checkRes.success && checkRes.data?.length) {
            const empSet = new Set(empList);
            const conflicts = checkRes.data.filter(r => {
                if (!empSet.has(r.EMPCD)) return false;
                const rFrom = (r.FROM_DATE || '').slice(0, 10);
                const rTo   = (r.TO_DATE   || '').slice(0, 10);
                return rFrom && rTo && from <= rTo && to >= rFrom &&
                       (r.STATUS === 'PENDING' || r.STATUS === 'APPROVED');
            });
            if (conflicts.length > 0) {
                const rows = conflicts.map(r => {
                    const st = r.STATUS === 'APPROVED'
                        ? '<span class="badge bg-success">Đã duyệt</span>'
                        : '<span class="badge bg-warning text-dark">Chờ duyệt</span>';
                    const info = selected.get(r.EMPCD);
                    const name = info ? `<span class="vni-font ms-1">${escHtml(info.name)}</span>` : '';
                    return `<div class="result-item err d-flex align-items-center gap-2 flex-wrap">
                        <strong>${escHtml(r.EMPCD)}</strong>${name} ${st}
                        <span class="text-muted" style="font-size:.75rem;">${formatDate(r.FROM_DATE)} – ${formatDate(r.TO_DATE)}</span>
                    </div>`;
                }).join('');
                $('#assignResults').html(`
                    <div class="alert alert-danger py-2 px-3 mb-2" style="font-size:.85rem;">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        <strong>${conflicts.length} nhân viên</strong> đã có đơn nghỉ phép trùng khoảng ngày này — vui lòng kiểm tra và phối hợp nội bộ:
                    </div>${rows}`);
                showResults();
                return;
            }
        }

        $('#assignBtn').html('<span class="spinner-border spinner-border-sm me-1"></span>Đang xử lý...');
        const res = await $.ajax({ url: ASSIGN_URL, type: 'POST', contentType: 'application/json',
            data: JSON.stringify({ ASSIGNER_EMPCD: '', TARGET_EMPCDS: empList, LEAVE_TYPE: leaveType, FROM_DATE: from, TO_DATE: to, TOTAL_DAYS: days, REASON: reason }) });
        if (res.results?.length) {
            $('#assignResults').html(res.results.map(r => {
                const cls = r.success ? 'ok' : 'err';
                const ico = r.success ? '<i class="bi bi-check-circle me-1"></i>' : '<i class="bi bi-x-circle me-1"></i>';
                return `<div class="result-item ${cls}">${ico}<strong>${escHtml(r.empcd||'')}</strong>: ${escHtml(r.message||'')}</div>`;
            }).join(''));
            showResults();
        }
        if (res.success) { showToast(res.message || 'Đã sắp lịch thành công', 'success'); clearAllEmps(); maLoaded = false; }
        else showToast(res.message || 'Có lỗi xảy ra', 'error');
    } catch { showToast('Lỗi kết nối', 'error'); }
    finally  {
        $btn.prop('disabled', false);
        $('#assignBtn').html('<i class="bi bi-send me-1"></i> Sắp Lịch Nghỉ');
        updateAssignBar();
    }
}

// ─── Duyệt ───────────────────────────────────────────────────────
function changeApprovalMonth(delta) {
    curMonth += delta;
    if (curMonth > 12) { curMonth = 1; curYear++; }
    if (curMonth < 1)  { curMonth = 12; curYear--; }
    updateMonthLabel();
    loadApproval(1);
    loadPendingBadge();
}

function setApvStatus(s) {
    apvStatus = s;
    ['all','pending','approved','rejected'].forEach(k => document.getElementById('apv-'+k).classList.remove('active'));
    document.getElementById('apv-' + (s||'all').toLowerCase()).classList.add('active');
    loadApproval(1);
}

function onApvEmpInput() {
    clearTimeout(apvEmpTimeout);
    apvEmpTimeout = setTimeout(() => loadApproval(1), 400);
}

// Tính sẵn mọi thứ hiển thị của 1 đơn — dùng chung cho bảng (web) và thẻ (điện thoại)
function apvView(item) {
    const v = {};
    v.ltLabel = LEAVE_LABEL[item.LEAVE_TYPE] || item.LEAVE_TYPE || '-';
    v.ltColor = LEAVE_COLOR[item.LEAVE_TYPE] || 'secondary';
    v.pendingDays = 0; v.isStale = false;
    if (item.STATUS === 'PENDING' && item.CREATED_DATE) {
        v.pendingDays = Math.floor((Date.now() - new Date(item.CREATED_DATE)) / 86400000);
        v.isStale = v.pendingDays >= 15;
    }
    v.ageHtml = item.STATUS === 'PENDING' && v.pendingDays > 0
        ? `<span class="pending-age ${v.isStale ? 'stale' : ''}"><i class="bi bi-alarm me-1"></i>Đã ${v.pendingDays} ngày chờ</span>` : '';
    const isSelf = item.EMPCD === CURRENT_EMPCD;
    v.canAct = !isSelf && CAN_APPROVE && (ROLE_LEVELS[item.REQUESTER_ROLE]||1) < MY_LEVEL;
    v.expired = isFromDateExpired(item.FROM_DATE);
    // 'act' = được bấm Duyệt/Từ chối; còn lại là lý do không bấm được
    v.state = item.STATUS !== 'PENDING' ? 'done' : !v.canAct ? 'higher' : v.expired ? 'expired' : 'act';
    // 1 ngày: "23/11/2026"; khoảng ngày cùng năm: "21/11 → 23/11/2026" (gọn, không xuống dòng lung tung)
    const fD = formatDate(item.FROM_DATE), tD = formatDate(item.TO_DATE);
    v.dateStr = !item.TO_DATE || fD === tD ? fD
              : (fD.slice(6) === tD.slice(6) ? fD.slice(0, 5) : fD) + ' → ' + tD;
    v.dept = [item.DEPT_NAME, item.LINE_NAME, item.WORK_NAME].filter(Boolean).map(escHtml).join(' / ');
    const reqSig = item.EMPCD
        ? `<div class="sig-cell-item"><div class="sig-cell-lbl">Người ký</div>
               <img src="${SIG_URL}?empCd=${encodeURIComponent(item.EMPCD)}" class="sig-cell-img" loading="lazy" onerror="this.remove()" alt="Chữ ký"/></div>` : '';
    const apSig = (item.STATUS !== 'PENDING' && item.FINAL_APPROVER)
        ? `<div class="sig-cell-item"><div class="sig-cell-lbl">Người duyệt</div>
               <img src="${SIG_URL}?empCd=${encodeURIComponent(item.FINAL_APPROVER)}" class="sig-cell-img" loading="lazy" onerror="this.remove()" alt="Chữ ký"/>
               ${item.APPROVER_NAME ? `<div class="sig-cell-name vni-font">${escHtml(item.APPROVER_NAME)}</div>` : ''}</div>` : '';
    v.sigCell = `<div class="sig-cell">${reqSig}${apSig}</div>`;
    return v;
}

function buildApprovalRow(item, idx) {
    const v = apvView(item);
    let statusHtml = `<span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Chờ duyệt</span>`;
    if (v.ageHtml) statusHtml += `<div>${v.ageHtml}</div>`;
    if (item.STATUS === 'APPROVED') statusHtml = `<span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Đã duyệt</span>`;
    if (item.STATUS === 'REJECTED') statusHtml = `<span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Từ chối</span>`;
    const actions = v.state === 'done' ? '<span class="text-muted text-xs">-</span>'
        : v.state === 'higher'  ? `<span class="text-warning text-xxs"><i class="bi bi-exclamation-triangle-fill me-1"></i>Cần cấp cao hơn</span>`
        : v.state === 'expired' ? `<span class="text-muted text-xs"><i class="bi bi-clock-history me-1"></i>Đã quá hạn</span>`
        : `<div class="ts-act">
               <button class="btn btn-sm btn-success" onclick="openApvAction('${item.REQUEST_ID}','approve','${item.FROM_DATE||''}')"><i class="bi bi-check-lg me-1"></i>Duyệt</button>
               <button class="btn btn-sm btn-outline-danger" onclick="openApvAction('${item.REQUEST_ID}','reject','${item.FROM_DATE||''}')">Từ chối</button>
           </div>`;
    const empCell = `<div class="d-flex align-items-center" data-emp-photo="${escHtml(item.EMPCD||'')}" data-emp-name="${escHtml(item.EMP_NAME||'')}"><div style="min-width:0">
        <div class="text-xs text-secondary">${escHtml(item.EMPCD||'')}</div>
        <div class="text-sm vni-font fw-bold" style="text-transform:uppercase;line-height:1.2;">${escHtml(item.EMP_NAME||'')}</div>
        ${v.dept ? `<div class="text-xs text-secondary ts-dept1" title="${v.dept}">${v.dept}</div>` : ''}
    </div></div>`;
    const timeCell = `<div class="ts-time-chip"><i class="bi bi-calendar-event me-1"></i>${v.dateStr}</div>
        ${item.TOTAL_DAYS != null ? `<div class="text-xs fw-bold text-primary mt-1">${item.TOTAL_DAYS} ngày</div>` : ''}
        ${item.CREATED_DATE ? `<div class="ts-time-created">Tạo: ${formatDateTime(item.CREATED_DATE)}</div>` : ''}`;

    return `<tr class="${v.isStale ? 'row-stale-pending' : ''}">
        <td class="px-2 text-xs text-secondary">${idx}</td>
        <td class="px-2">${empCell}</td>
        <td class="px-2"><span class="badge bg-${v.ltColor}">${v.ltLabel}</span></td>
        <td class="px-2">${timeCell}</td>
        <td class="px-2 text-sm" style="min-width:110px;max-width:240px;white-space:normal;color:#475569;">${item.REASON ? escHtml(item.REASON) : '<span class="text-muted">-</span>'}</td>
        <td class="text-center" style="max-width:150px;">${statusHtml}${docDetailBtnHtml(item, false)}
            <div class="mt-1"><button type="button" class="ts-link" onclick="document.getElementById('sigd${item.REQUEST_ID}').classList.toggle('open')"><i class="bi bi-pen me-1"></i>Chữ ký</button>
            <div class="ts-sig ts-sig-td" id="sigd${item.REQUEST_ID}">${v.sigCell}</div></div></td>
        <td class="text-center text-nowrap">${actions}</td>
    </tr>`;
}

function buildApprovalCard(item) {
    const v = apvView(item);
    const st = item.STATUS === 'APPROVED' ? '<span class="ts-st approved">Đã duyệt</span>'
             : item.STATUS === 'REJECTED' ? '<span class="ts-st rejected">Từ chối</span>'
             : '<span class="ts-st pending">Chờ duyệt</span>';
    const photo = window.HrEmpPhoto && HrEmpPhoto.enabled() ? HrEmpPhoto.avatarHtml(item.EMPCD, item.EMP_NAME, 'ep-av--card') : '';
    const foot = v.state === 'act'
        ? `<div class="ts-btns">
               <button type="button" class="btn btn-reject" onclick="openApvAction('${item.REQUEST_ID}','reject','${item.FROM_DATE||''}')"><i class="bi bi-x-lg"></i>Từ chối</button>
               <button type="button" class="btn btn-approve" onclick="openApvAction('${item.REQUEST_ID}','approve','${item.FROM_DATE||''}')"><i class="bi bi-check-lg"></i>Duyệt</button>
           </div>`
        : v.state === 'higher'  ? `<div class="ts-note"><i class="bi bi-exclamation-triangle-fill me-1"></i>Đơn này cần cấp cao hơn duyệt</div>`
        : v.state === 'expired' ? `<div class="ts-note muted"><i class="bi bi-clock-history me-1"></i>Đã quá ngày nghỉ — không duyệt được nữa</div>`
        : '';
    const sigId = 'sig' + item.REQUEST_ID;
    return `<div class="ts-item ${v.isStale ? 'stale' : ''}">
        <div class="ts-item-top">
            ${photo}
            <div class="ts-who">
                <div class="ts-name vni-font">${escHtml(item.EMP_NAME||'')}</div>
                <div class="ts-sub"><b>${escHtml(item.EMPCD||'')}</b>${v.dept ? `<span class="ts-dept">${v.dept}</span>` : ''}</div>
            </div>
            ${st}
        </div>
        <div class="ts-item-mid">
            <span class="badge bg-${v.ltColor}">${v.ltLabel}</span>
            <span class="ts-date"><i class="bi bi-calendar-event me-1 text-secondary"></i>${v.dateStr}</span>
            ${item.TOTAL_DAYS != null ? `<span class="ts-days">${item.TOTAL_DAYS} ngày</span>` : ''}
        </div>
        ${item.REASON ? `<div class="ts-reason">${escHtml(item.REASON)}</div>` : ''}
        <div class="ts-meta">
            ${v.ageHtml}
            ${item.CREATED_DATE ? `<span>Tạo ${formatDateTime(item.CREATED_DATE)}</span>` : ''}
            ${docDetailBtnHtml(item, true)}
            <button type="button" class="ts-link" onclick="document.getElementById('${sigId}').classList.toggle('open')"><i class="bi bi-pen me-1"></i>Chữ ký</button>
        </div>
        <div class="ts-sig" id="${sigId}">${v.sigCell}</div>
        ${foot}
    </div>`;
}

function loadApproval(page = 1) {
    apvPage = page;
    const spin = '<div class="ts-empty"><div class="spinner-border text-primary" role="status"></div></div>';
    $('#approvalBody').html(`<tr><td colspan="8">${spin}</td></tr>`);
    $('#apvCards').html(spin);
    const range = getMonthRange();
    $.ajax({
        url: PAGE_URL, type: 'GET',
        data: { status: apvStatus, search: ($('#apvEmpFilter').val()||'').trim(), date_from: range.from, date_to: range.to, page, page_size: apvPageSize },
        success: function(res) {
            if (!res.success) {
                const err = `<div class="ts-empty text-danger">Lỗi: ${escHtml(res.message||'')}</div>`;
                $('#approvalBody').html(`<tr><td colspan="8">${err}</td></tr>`);
                $('#apvCards').html(err);
                return;
            }
            // API: "total" = TỔNG mọi trạng thái (không theo bộ lọc), số theo từng trạng thái nằm ở "summary"
            // → lọc "Chờ duyệt" mà lấy total thì phân trang ra 122 đơn / 7 trang dù chỉ có 1 đơn.
            const sm = res.summary || {};
            apvTotal = apvStatus ? (sm[apvStatus] ?? res.total ?? 0) : (res.total || 0);
            apvTotalPages = Math.ceil(apvTotal / apvPageSize);
            setChipCount('apv-all', sm.TOTAL); setChipCount('apv-pending', sm.PENDING);
            setChipCount('apv-approved', sm.APPROVED); setChipCount('apv-rejected', sm.REJECTED);
            const data = res.data || [];
            apvItems = {};
            data.forEach(it => { apvItems[it.REQUEST_ID] = it; });
            if (!data.length) {
                $('#approvalBody').html(emptyRow('Không có đơn nghỉ nào', 8));
                $('#apvCards').html(emptyHtml('Không có đơn nghỉ nào'));
            } else {
                $('#approvalBody').html(data.map((item,i) => buildApprovalRow(item,(page-1)*apvPageSize+i+1)).join(''));
                $('#apvCards').html(data.map(buildApprovalCard).join(''));
            }
            renderApvPagination();
        },
        error: function(xhr) {
            const err = `<div class="ts-empty text-danger">Lỗi kết nối (${xhr.status})</div>`;
            $('#approvalBody').html(`<tr><td colspan="8">${err}</td></tr>`);
            $('#apvCards').html(err);
        }
    });
}

function setChipCount(id, n) {
    const el = document.getElementById(id); if (!el) return;
    let c = el.querySelector('.ts-chip-n');
    if (!c) { c = document.createElement('span'); c.className = 'ts-chip-n'; el.appendChild(c); }
    c.textContent = n != null ? n : '';
}

function renderApvPagination() {
    if (!apvTotal) { $('#apvCount').text(''); $('#apvPagination').empty(); return; }
    const s=(apvPage-1)*apvPageSize+1, e=Math.min(apvPage*apvPageSize,apvTotal);
    $('#apvCount').html(`<span class="text-xs">${s}-${e} / <strong>${apvTotal}</strong> đơn</span>`);
    const $bar=$('#apvPagination').empty();
    const mk=(label,p,disabled,active)=>{const li=$('<li class="page-item">').toggleClass('disabled',!!disabled).toggleClass('active',!!active);$('<a class="page-link">').html(label).on('click',()=>{if(!disabled&&!active){loadApproval(p);document.getElementById('scheduleTab').scrollIntoView({behavior:'smooth'});}}).appendTo(li);return li;};
    $bar.append(mk('&lsaquo;',apvPage-1,apvPage<=1));
    let from=Math.max(1,apvPage-2),to=Math.min(apvTotalPages,apvPage+2);
    for(let p=from;p<=to;p++) $bar.append(mk(p,p,false,p===apvPage));
    $bar.append(mk('&rsaquo;',apvPage+1,apvPage>=apvTotalPages));
}

function isFromDateExpired(fromDate) {
    if (!fromDate) return false;
    const today = new Date(); today.setHours(0, 0, 0, 0);
    const fd = new Date(fromDate); fd.setHours(0, 0, 0, 0);
    return fd < today;
}

function openApvAction(id, type, fromDate) {
    if (isFromDateExpired(fromDate)) {
        showToast('Không thể xử lý đơn nghỉ đã bắt đầu hoặc quá hạn', 'error');
        return;
    }
    $('#tsActionId').val(id); $('#tsActionType').val(type);
    $('#tsActionComment').val(''); $('#tsActionError').addClass('d-none').text('');
    const isApprove = type === 'approve';
    const it = apvItems[id];
    $('#tsActionWho').html(it
        ? `<b class="vni-font">${escHtml(it.EMP_NAME||'')}</b> · ${escHtml(it.EMPCD||'')}<br>
           ${escHtml(LEAVE_LABEL[it.LEAVE_TYPE] || it.LEAVE_TYPE || '')}: ${formatDate(it.FROM_DATE)}${it.TO_DATE && it.TO_DATE !== it.FROM_DATE ? ' → ' + formatDate(it.TO_DATE) : ''}${it.TOTAL_DAYS != null ? ' (' + it.TOTAL_DAYS + ' ngày)' : ''}`
        : '');
    $('#tsActionHeader').removeClass('bg-success bg-danger text-white').addClass(isApprove ? 'bg-success text-white' : 'bg-danger text-white');
    $('#tsActionTitle').text(isApprove ? 'Duyệt đơn nghỉ phép' : 'Từ chối đơn nghỉ phép');
    $('#tsActionConfirm').removeClass('btn-success btn-danger').addClass(isApprove ? 'btn-success' : 'btn-danger')
                         .text(isApprove ? 'Duyệt' : 'Từ chối');
    bootstrap.Modal.getOrCreateInstance('#tsActionModal').show();
}

async function submitApprovalAction() {
    const id      = $('#tsActionId').val();
    const type    = $('#tsActionType').val();
    const comment = $('#tsActionComment').val();
    const url     = type === 'approve' ? APPROVE_URL : REJECT_URL;
    const label   = type === 'approve' ? 'Duyệt' : 'Từ chối';
    const $btn    = $('#tsActionConfirm').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>...');
    try {
        const res = await $.ajax({ url, type: 'POST', data: { request_id: id, comment } });
        if (res.success) {
            bootstrap.Modal.getInstance('#tsActionModal').hide();
            showToast(type === 'approve' ? 'Đã duyệt đơn nghỉ' : 'Đã từ chối đơn nghỉ', type === 'approve' ? 'success' : 'warning');
            loadApproval(apvPage);
            loadPendingBadge();
        } else {
            $('#tsActionError').removeClass('d-none').text(res.message || 'Lỗi xử lý');
        }
    } catch { $('#tsActionError').removeClass('d-none').text('Lỗi kết nối'); }
    finally  { $btn.prop('disabled', false).text(label); }
}

// ─── Lịch tôi đã sắp ─────────────────────────────────────────────
function onMaEmpInput() {
    clearTimeout(maEmpTimeout);
    maEmpTimeout = setTimeout(() => loadMyAssign(1), 400);
}

function buildMyAssignRow(item, idx) {
    const lt = LEAVE_LABEL[item.LEAVE_TYPE] || item.LEAVE_TYPE || '-';
    const lc = LEAVE_COLOR[item.LEAVE_TYPE] || 'secondary';
    const statusHtml = item.CONFIRM_STATUS === 'CONFIRMED'
        ? `<span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Đã tiếp nhận</span>`
        : `<span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Chưa tiếp nhận</span>`;
    return `<tr>
        <td class="px-2 text-xs text-secondary">${idx}</td>
        <td class="px-2 text-sm text-nowrap" data-emp-photo="${escHtml(item.EMPCD||'')}" data-emp-name="${escHtml(item.EMP_NAME||'')}">${escHtml(item.EMPCD||'')}</td>
        <td class="px-2 text-sm vni-font" style="text-transform:uppercase;">${escHtml(item.EMP_NAME||'')}</td>
        <td class="px-2"><span class="badge bg-${lc}">${lt}</span></td>
        <td class="px-2 text-sm text-nowrap">${formatDate(item.FROM_DATE)}</td>
        <td class="px-2 text-sm text-nowrap">${formatDate(item.TO_DATE)}</td>
        <td class="px-2 text-sm fw-bold">${item.TOTAL_DAYS != null ? item.TOTAL_DAYS + ' ngày' : '-'}</td>
        <td class="px-2 text-sm text-nowrap text-secondary">${formatDate(item.ASSIGN_DATE)}</td>
        <td class="text-center">${statusHtml}</td>
    </tr>`;
}

function loadMyAssign(page = 1) {
    maPage = page;
    $('#myAssignBody').html(`<tr><td colspan="9"><div class="ts-empty"><div class="spinner-border text-primary" role="status"></div></div></td></tr>`);
    MobileTableHelper.refresh('myAssignBody');
    $.ajax({
        url: MY_ASSIGN_URL, type: 'GET',
        data: {
            status: $('#maStatusFilter').val(),
            search: ($('#maEmpFilter').val()||'').trim(),
            page, page_size: maPageSize
        },
        success: function(res) {
            if (!res.success) {
                $('#myAssignBody').html(`<tr><td colspan="9" class="text-center text-danger py-4">Lỗi: ${escHtml(res.message||'')}</td></tr>`);
                MobileTableHelper.refresh('myAssignBody');
                return;
            }
            const s = res.summary || {};
            $('#maTotal').text((s.TOTAL||0).toLocaleString());
            $('#maPending').text((s.PENDING_CONFIRM||0).toLocaleString());
            $('#maConfirmed').text((s.CONFIRMED||0).toLocaleString());
            maTotal      = res.total      || 0;
            maTotalPages = res.total_pages || 0;
            const data   = res.data || [];
            if (!data.length) {
                $('#myAssignBody').html(emptyRow('Chưa sắp lịch cho ai', 9));
            } else {
                $('#myAssignBody').html(data.map((item,i) => buildMyAssignRow(item,(page-1)*maPageSize+i+1)).join(''));
            }
            renderMaPagination();
            MobileTableHelper.refresh('myAssignBody');
        },
        error: function(xhr) {
            $('#myAssignBody').html(`<tr><td colspan="9" class="text-center text-danger py-4">Lỗi kết nối (${xhr.status})</td></tr>`);
            MobileTableHelper.refresh('myAssignBody');
        }
    });
}

function renderMaPagination() {
    if (!maTotal) { $('#maCount').text(''); $('#maPagination').empty(); return; }
    const s=(maPage-1)*maPageSize+1, e=Math.min(maPage*maPageSize,maTotal);
    $('#maCount').html(`<span class="text-xs">${s}-${e} / <strong>${maTotal}</strong> lịch sắp</span>`);
    const $bar=$('#maPagination').empty();
    const mk=(label,p,disabled,active)=>{const li=$('<li class="page-item">').toggleClass('disabled',!!disabled).toggleClass('active',!!active);$('<a class="page-link">').html(label).on('click',()=>{if(!disabled&&!active)loadMyAssign(p);}).appendTo(li);return li;};
    $bar.append(mk('&lsaquo;',maPage-1,maPage<=1));
    let from=Math.max(1,maPage-2),to=Math.min(maTotalPages,maPage+2);
    for(let p=from;p<=to;p++) $bar.append(mk(p,p,false,p===maPage));
    $bar.append(mk('&rsaquo;',maPage+1,maPage>=maTotalPages));
}

