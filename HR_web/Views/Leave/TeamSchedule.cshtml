});
document.getElementById('tab-myassign-btn')?.addEventListener('shown.bs.tab', function() {
    if (!maLoaded) { maLoaded = true; loadMyAssign(1); }
});

function formatDate(s) { if(!s) return '-'; const d=new Date(s); if(isNaN(d)) return '-'; return('0'+d.getDate()).slice(-2)+'/'+('0'+(d.getMonth()+1)).slice(-2)+'/'+d.getFullYear(); }
function formatDateTime(s) { if(!s) return '-'; const d=new Date(s); if(isNaN(d)) return '-'; return formatDate(s)+' '+('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2); }
function escHtml(str)  { return String(str ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); }

function loadPendingBadge() {
    if (!CAN_APPROVE) return;
    const range = getMonthRange();
    $.get(PAGE_URL, { page: 1, page_size: 1, status: 'PENDING', date_from: range.from, date_to: range.to }, function(res) {
        const n = res.success ? (res.summary?.PENDING ?? 0) : 0;   // total = mọi trạng thái, xem loadApproval
        const $b = $('#pendingBadge');
        if (n > 0) $b.text(n > 99 ? '99+' : n).removeClass('d-none');
        else $b.addClass('d-none');
    });
}

$(document).ready(function() {
    MobileTableHelper.init('myAssignBody');
    updateMonthLabel();
    loadPendingBadge();
    if (CAN_APPROVE) loadApproval(1);
});
