function formatDate(s) { if(!s) return '-'; const d=new Date(s); if(isNaN(d)) return '-'; return('0'+d.getDate()).slice(-2)+'/'+('0'+(d.getMonth()+1)).slice(-2)+'/'+d.getFullYear(); }
function escHtml(str)  { return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

function loadPendingBadge() {
    if (!CAN_APPROVE) return;
    const range = getMonthRange();
    $.get(PAGE_URL, { page: 1, page_size: 1, status: 'PENDING', date_from: range.from, date_to: range.to }, function(res) {
        const n = res.success ? (res.total || 0) : 0;
        const $b = $('#pendingBadge');
        if (n > 0) $b.text(n > 99 ? '99+' : n).removeClass('d-none');
        else $b.addClass('d-none');
    });
}

