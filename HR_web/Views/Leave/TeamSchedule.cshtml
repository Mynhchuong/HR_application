    </div><!-- /tab-content -->
</div>

<!-- Calendar hover box -->
<div id="calHoverBox" style="display:none;position:fixed;background:#1e293b;color:#fff;border-radius:10px;padding:8px 12px;font-size:.78rem;z-index:9999;max-width:230px;box-shadow:0 4px 16px rgba(0,0,0,.25);pointer-events:none;line-height:1.6;">
    <div id="calHoverContent"></div>
</div>

<!-- Action Modal (Tab 3) -->
<div class="modal fade" id="tsActionModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header" id="tsActionHeader">
                <h6 class="modal-title mb-0" id="tsActionTitle"></h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="tsActionId" />
                <input type="hidden" id="tsActionType" />
                <div class="mb-2">
                    <label class="form-label small fw-bold">Ghi chú (không bắt buộc)</label>
                    <textarea id="tsActionComment" class="form-control form-control-sm" rows="2" maxlength="200"></textarea>
                </div>
                <div id="tsActionError" class="alert alert-danger d-none py-1 px-2 text-sm"></div>
            </div>
            <div class="modal-footer py-2">
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Huỷ</button>
                <button class="btn btn-sm text-white" id="tsActionConfirm" onclick="submitApprovalAction()">Xác Nhận</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
const NO_DATA_IMG = '@(new Random().Next(2)==0 ? Url.Content("~/assets/img/illustrations/A_nodata.png") : Url.Content("~/assets/img/illustrations/Chi_nodata.png"))';
function emptyRow(msg, cols=9) {
    return `<tr><td colspan="${cols}" class="text-center py-5">
        <img src="${NO_DATA_IMG}" style="width:130px;opacity:.85;margin-bottom:12px;display:block;margin-left:auto;margin-right:auto;">
        <div class="text-muted text-sm">${msg}</div>
    </td></tr>`;
}

const MY_ASSIGN_URL  = '@Url.Action("GetMyAssignmentsPage",   "Leave")';
const SCHEDULE_URL   = '@Url.Action("GetTeamSchedulePage",    "Leave")';
const ASSIGN_URL     = '@Url.Action("AssignLeave",            "Leave")';
const APPROVE_URL    = '@Url.Action("ApproveRequest",         "Leave")';
const REJECT_URL     = '@Url.Action("RejectRequest",          "Leave")';
const PAGE_URL       = '@Url.Action("GetApprovalListPage",    "Leave")';
const EMP_SCOPE_URL  = '@Url.Action("GetEmpByScope",          "Dropdown")';
const BALANCE_URL    = '@Url.Action("GetAnnualLeaveBalance",  "Leave")';
const CURRENT_ROLE  = '@ViewBag.CurrentRole';
const CURRENT_EMPCD = '@ViewBag.CurrentEmpCd';
const CAN_ASSIGN    = ['Supervisor','DeputyManager','Manager','Admin'].includes(CURRENT_ROLE);
const CAN_APPROVE   = ['Supervisor','DeputyManager','Manager','Admin'].includes(CURRENT_ROLE);
const ROLE_LEVELS   = { Admin:99, Expat:5, Manager:4, DeputyManager:3, Supervisor:2, HR:1, Clerk:1, Worker:1 };
const MY_LEVEL      = ROLE_LEVELS[CURRENT_ROLE] || 1;

let curMonth = @curMonth, curYear = @curYear;
let allEmps       = [];
let scheduleData  = [];
let empBalanceMap = {};   // empcd → { receive_num, used_num, left_num }
let empLoaded     = false;
let apvLoaded    = false;
let maLoaded     = false;
let schPage = 1, schPageSize = 20;
let apvStatus = '', apvPage = 1, apvTotal = 0, apvTotalPages = 0, apvPageSize = 20;
let maPage = 1, maTotal = 0, maTotalPages = 0, maPageSize = 20;
let apvEmpTimeout, maEmpTimeout;

const MONTHS_VI  = ['Tháng 1','Tháng 2','Tháng 3','Tháng 4','Tháng 5','Tháng 6',
                    'Tháng 7','Tháng 8','Tháng 9','Tháng 10','Tháng 11','Tháng 12'];
const LEAVE_LABEL = { AL:'Phép năm', CL:'BHXH', SL:'Bệnh', NPL:'Không lương', OTH:'Khác' };
const LEAVE_COLOR = { AL:'primary', CL:'info', SL:'danger', NPL:'secondary', OTH:'warning' };

function getMonthRange() {
    const firstDay = new Date(curYear, curMonth - 1, 1);
    const lastDay  = new Date(curYear, curMonth, 0);
    const fmt = d => d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
    return { from: fmt(firstDay), to: fmt(lastDay) };
}

function updateMonthLabel() {
    $('.month-label-display').text(MONTHS_VI[curMonth-1] + ' / ' + curYear);
}

// ─── Tab 1 ───────────────────────────────────────────────────────
function changeMonth(delta) {
    curMonth += delta;
    if (curMonth > 12) { curMonth = 1; curYear++; }
    if (curMonth < 1)  { curMonth = 12; curYear--; }
    schPage = 1;
    updateMonthLabel();
    loadSchedule();
}

function buildScheduleRow(item, idx, today) {
    const ltLabel  = LEAVE_LABEL[item.LEAVE_TYPE] || item.LEAVE_TYPE || '-';
    const ltColor  = LEAVE_COLOR[item.LEAVE_TYPE] || 'secondary';
    const srcBadge = item.SOURCE === 'ASSIGNED'
        ? `<span class="badge" style="background:#e0f2fe;color:#0369a1;font-size:.7rem;">Sắp lịch</span>`
        : `<span class="badge bg-light text-dark border" style="font-size:.7rem;">Tự nộp</span>`;
    const from = item.FROM_DATE ? new Date(item.FROM_DATE) : null;
    const to   = item.TO_DATE   ? new Date(item.TO_DATE)   : null;
    const isPast   = to   && to   < today;
    const isActive = from && to && from <= today && to >= today;
    const rowClass = isPast ? 'sch-past' : isActive ? 'sch-active' : '';
    const activeBadge = isActive ? `<i class="bi bi-circle-fill text-success ms-1" style="font-size:.5rem;vertical-align:middle;" title="Đang nghỉ"></i>` : '';
    return `<tr class="${rowClass}">
        <td class="px-2 text-xs text-secondary">${idx}</td>
        <td class="px-2 text-sm">${escHtml(item.EMPCD||'')}</td>
        <td class="px-2 text-sm emp-name vni-font" style="text-transform:uppercase;">${escHtml(item.EMP_NAME||'')}${activeBadge}</td>
        <td class="px-2"><span class="badge bg-${ltColor}">${ltLabel}</span></td>
        <td class="px-2">${srcBadge}</td>
        <td class="px-2 text-sm text-nowrap">${formatDate(item.FROM_DATE)}</td>
        <td class="px-2 text-sm text-nowrap">${formatDate(item.TO_DATE)}</td>
        <td class="px-2 text-sm fw-bold">${item.TOTAL_DAYS != null ? item.TOTAL_DAYS + ' ngày' : '-'}</td>
    </tr>`;
}

let calVisible    = true;
let selectedCalDay = null;

function toggleCalendar() {
    calVisible = !calVisible;
    $('#calWrapInner').toggle(calVisible);
    $('#calToggleBtn').html(calVisible
        ? '<i class="bi bi-chevron-up"></i> Thu gọn'
        : '<i class="bi bi-chevron-down"></i> Mở rộng');
}

function selectCalDay(key) {
    selectedCalDay = (selectedCalDay === key) ? null : key;
    schPage = 1;
    buildCalendar(scheduleData);
    renderSchedule();
    // On touch devices: show hover info briefly after selecting a day
    if (selectedCalDay && window.matchMedia('(hover:none)').matches) {
        const sel = document.querySelector('#calGrid .cal-cell.cal-selected');
        if (sel) {
            showCalHover(sel, selectedCalDay);
            setTimeout(hideCalHover, 2800);
        }
    }
}

function clearCalDay() {
    selectedCalDay = null;
    schPage = 1;
    buildCalendar(scheduleData);
    renderSchedule();
}

let calDayNames = {};

function showCalHover(el, key) {
    const names = calDayNames[key];
    if (!names || !names.length) return;
    const html = `<div style="font-weight:700;margin-bottom:4px;border-bottom:1px solid rgba(255,255,255,.2);padding-bottom:4px;">${names.length} người nghỉ</div>`
               + names.map(n => `<span class="vni-font">${escHtml(n)}</span>`).join('<br>');
    const box  = document.getElementById('calHoverBox');
    document.getElementById('calHoverContent').innerHTML = html;
    box.style.visibility = 'hidden';
    box.style.display    = 'block';
    const rect  = el.getBoundingClientRect();
    const bw    = box.offsetWidth  || 210;
    const bh    = box.offsetHeight || 80;
    let left    = rect.left + (rect.width - bw) / 2;
    left = Math.max(8, Math.min(left, window.innerWidth - bw - 8));
    const spaceBelow = window.innerHeight - rect.bottom;
    const top = spaceBelow > bh + 12 ? rect.bottom + 6 : rect.top - bh - 6;
    box.style.left       = left + 'px';
    box.style.top        = top  + 'px';
    box.style.visibility = 'visible';
}
function hideCalHover() {
    document.getElementById('calHoverBox').style.display = 'none';
}

function buildCalendar(data) {
    const today = new Date(); today.setHours(0,0,0,0);
    const dayMap = {};
    calDayNames  = {};
    data.forEach(item => {
        if (!item.FROM_DATE || !item.TO_DATE) return;
        let d = new Date(item.FROM_DATE); d.setHours(0,0,0,0);
        const endD = new Date(item.TO_DATE); endD.setHours(0,0,0,0);
        while (d <= endD) {
            if (d.getMonth()+1 === curMonth && d.getFullYear() === curYear) {
                const key = d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
                dayMap[key] = (dayMap[key]||0) + 1;
                if (!calDayNames[key]) calDayNames[key] = [];
                calDayNames[key].push(item.EMP_NAME||item.EMPCD||'');
            }
            d.setDate(d.getDate()+1);
        }
    });
    const firstDay    = new Date(curYear, curMonth-1, 1);
    const daysInMonth = new Date(curYear, curMonth, 0).getDate();
    const startDow    = (firstDay.getDay() + 6) % 7;
    const hdrs = ['T2','T3','T4','T5','T6','T7','CN'].map(h => `<div class="cal-hdr">${h}</div>`).join('');
    let cells = '';
    for (let i = 0; i < startDow; i++) cells += `<div class="cal-cell cal-empty"></div>`;
    for (let day = 1; day <= daysInMonth; day++) {
        const key   = curYear+'-'+String(curMonth).padStart(2,'0')+'-'+String(day).padStart(2,'0');
        const count = dayMap[key] || 0;
        const d     = new Date(curYear, curMonth-1, day); d.setHours(0,0,0,0);
        const isToday    = d.getTime() === today.getTime();
        const isPast     = d < today && !isToday;
        const isSelected = selectedCalDay === key;
        let countBadge = '';
        if (count > 0) {
            const bg = count >= 8 ? '#dc2626' : count >= 4 ? '#d97706' : '#2563eb';
            countBadge = `<span class="cal-count" style="background:${bg};">${count}</span>`;
        }
        const cls = ['cal-cell',
            isToday    ? 'cal-today'    : '',
            isPast     ? 'cal-past'     : '',
            count > 0  ? 'cal-has'      : '',
            isSelected ? 'cal-selected' : ''
        ].filter(Boolean).join(' ');
        const interactAttrs = count > 0
            ? ` onmouseenter="showCalHover(this,'${key}')" onmouseleave="hideCalHover()" onclick="selectCalDay('${key}')"`
            : '';
        cells += `<div class="${cls}"${interactAttrs}><span class="cal-daynum">${day}</span>${countBadge}</div>`;
    }
    $('#calGrid').html(hdrs + cells);
}

function loadSchedule() {
    selectedCalDay = null;
    $('#scheduleBody').html(`<tr><td colspan="8" class="text-center py-5"><div class="spinner-border text-info" role="status"></div></td></tr>`);
    MobileTableHelper.refresh('scheduleBody');
    $('#scheduleCount').text('');
    $('#scheduleEmpFilter').val('');
    $.ajax({
        url: SCHEDULE_URL, type: 'GET', data: { month: curMonth, year: curYear },
        success: function(res) {
            if (!res.success) {
                $('#scheduleBody').html(`<tr><td colspan="8" class="text-center text-danger py-4">Lỗi: ${res.message||''}</td></tr>`);
                MobileTableHelper.refresh('scheduleBody');
                return;
            }
            scheduleData = res.data || [];
            buildCalendar(scheduleData);
            renderSchedule();
        },
        error: function(xhr) {
            $('#scheduleBody').html(`<tr><td colspan="8" class="text-center text-danger py-4">Lỗi kết nối (${xhr.status})</td></tr>`);
            MobileTableHelper.refresh('scheduleBody');
        }
    });
}

function renderSchedule() {
    const today = new Date(); today.setHours(0,0,0,0);
    const q     = ($('#scheduleEmpFilter').val() || '').trim().toUpperCase();
    let filtered = q ? scheduleData.filter(d => (d.EMPCD||'').toUpperCase().includes(q) || (d.EMP_NAME||'').toUpperCase().includes(q)) : [...scheduleData];

    // Filter by selected calendar day
    if (selectedCalDay) {
        const selDate = new Date(selectedCalDay); selDate.setHours(0,0,0,0);
        filtered = filtered.filter(item => {
            if (!item.FROM_DATE || !item.TO_DATE) return false;
            const from = new Date(item.FROM_DATE); from.setHours(0,0,0,0);
            const to   = new Date(item.TO_DATE);   to.setHours(0,0,0,0);
            return from <= selDate && to >= selDate;
        });
        const [y, m, d] = selectedCalDay.split('-');
        $('#calDayBadge').removeClass('d-none');
        $('#calDayBadgeText').text(`Ngày ${d}/${m}/${y} · ${filtered.length} người`);
        $('#viewAllBtn').removeClass('d-none');
    } else {
        $('#calDayBadge').addClass('d-none');
        $('#viewAllBtn').addClass('d-none');
    }

    // Sort: currently on leave → upcoming → past
    const priority = item => {
        if (!item.FROM_DATE || !item.TO_DATE) return 1;
        const from = new Date(item.FROM_DATE); from.setHours(0,0,0,0);
        const to   = new Date(item.TO_DATE);   to.setHours(0,0,0,0);
        if (from <= today && to >= today) return 0;
        if (from > today) return 1;
        return 2;
    };
    filtered.sort((a, b) => {
        const pa = priority(a), pb = priority(b);
        if (pa !== pb) return pa - pb;
        return new Date(a.FROM_DATE) - new Date(b.FROM_DATE);
    });

    const total      = filtered.length;
    const totalPages = Math.max(1, Math.ceil(total / schPageSize));
    if (schPage > totalPages) schPage = totalPages;
    const start    = (schPage - 1) * schPageSize;
    const pageData = filtered.slice(start, start + schPageSize);

    if (!pageData.length) {
        const msg = q ? `Không tìm thấy "<strong>${q}</strong>"` : 'Không có lịch nghỉ đã duyệt trong tháng này';
        $('#scheduleBody').html(emptyRow(msg, 8));
    } else {
        $('#scheduleBody').html(pageData.map((item,i) => buildScheduleRow(item, start+i+1, today)).join(''));
    }

    if (total > 0) {
        const s = start + 1, e = Math.min(start + schPageSize, total);
        const extra = q ? ` (lọc từ ${scheduleData.length})` : '';
        $('#scheduleCount').html(`<span class="text-xs">${s}-${e} / <strong>${total}</strong> lịch nghỉ${extra}</span>`);
    } else {
        $('#scheduleCount').text('');
    }

    const $bar = $('#schedulePagination').empty();
    if (totalPages > 1) {
        const mk = (label, p, disabled, active) => {
            const li = $('<li class="page-item">').toggleClass('disabled', !!disabled).toggleClass('active', !!active);
            $('<a class="page-link">').html(label).on('click', () => { if (!disabled && !active) { schPage = p; renderSchedule(); } }).appendTo(li);
            return li;
        };
        $bar.append(mk('&lsaquo;', schPage-1, schPage<=1));
        let from = Math.max(1, schPage-2), to = Math.min(totalPages, schPage+2);
        for (let p = from; p <= to; p++) $bar.append(mk(p, p, false, p === schPage));
        $bar.append(mk('&rsaquo;', schPage+1, schPage>=totalPages));
    }

    MobileTableHelper.refresh('scheduleBody');
}

// ─── Tab 2 ───────────────────────────────────────────────────────
function loadEmps() {
    if (empLoaded) return;
    empLoaded = true;
    $.when(
        $.get(EMP_SCOPE_URL),
        $.get(BALANCE_URL)
    ).done(function(empRes, balRes) {
        allEmps = empRes[0] || [];
        const balData = (balRes[0]?.data) || [];
        empBalanceMap = {};
        balData.forEach(b => { empBalanceMap[b.EMPCD] = b; });
        renderEmpList(allEmps);
    }).fail(function() {
        $('#empList').html('<div class="text-center py-3 text-danger text-sm"><i class="bi bi-exclamation-triangle me-1"></i>Lỗi tải danh sách nhân viên</div>');
    });
}

function empLeaveBadge(empcd) {
    const b = empBalanceMap[empcd];
    if (!b) return '';
    const left = b.LEFT_NUM ?? 0;
    if (left <= 0)  return `<span class="leave-badge" style="background:#fee2e2;color:#b91c1c;">Hết phép</span>`;
    if (left <= 3)  return `<span class="leave-badge" style="background:#fef3c7;color:#92400e;">${left} ngày</span>`;
    return `<span class="leave-badge" style="background:#dcfce7;color:#166534;">${left} ngày</span>`;
}
function empLeaveClass(empcd) {
    const b = empBalanceMap[empcd];
    if (!b) return '';
    const left = b.LEFT_NUM ?? 0;
    if (left <= 0) return 'leave-empty';
    if (left <= 3) return 'leave-low';
    return 'leave-ok';
}

function renderEmpList(emps) {
    if (!emps.length) {
        $('#empList').html('<div class="text-center py-4 text-muted text-sm"><i class="bi bi-people fs-4 d-block mb-2"></i>Không có nhân viên trong phạm vi</div>');
        return;
    }
    $('#empList').html(emps.map(e => `
        <label class="emp-item ${empLeaveClass(e.empcd||'')}" data-empcd="${escHtml(e.empcd||'')}" data-name="${escHtml(e.name||'')}">
            <input type="checkbox" class="emp-chk" value="${escHtml(e.empcd||'')}" onchange="updateSelCount()" />
            <div class="emp-info flex-grow-1 min-width-0">
                <div class="emp-name vni-font">${escHtml(e.name||'')}</div>
                <div class="emp-dept">${escHtml(e.dept_name||'')}${e.line_name ? ' / ' + escHtml(e.line_name) : ''}</div>
            </div>
            <span class="emp-code">${escHtml(e.empcd||'')}</span>
            ${empLeaveBadge(e.empcd||'')}
        </label>`).join(''));
    updateSelCount();
}

function filterEmps() {
    const q = ($('#empSearch').val() || '').trim().toUpperCase();
    if (!q) { renderEmpList(allEmps); return; }
    renderEmpList(allEmps.filter(e => (e.empcd||'').toUpperCase().includes(q)));
}
function selectAllEmps()  { $('#empList .emp-chk:visible').prop('checked', true); updateSelCount(); }
function clearAllEmps()   { $('#empList .emp-chk').prop('checked', false); updateSelCount(); }
function updateSelCount() { $('#selCount').text($('#empList .emp-chk:checked').length + ' NV được chọn'); }
function getSelectedEmpcds() { return $('#empList .emp-chk:checked').map(function() { return $(this).val(); }).get(); }

function isSunday(dateStr) {
    if (!dateStr) return false;
    const p = dateStr.split('-');
    return new Date(Date.UTC(+p[0], +p[1]-1, +p[2])).getUTCDay() === 0;
}

function calcAssignDays() {
    const f = $('#assignFromDate').val(), t = $('#assignToDate').val();
    if (f && isSunday(f)) {
        $('#assignFromDate').val('');
        showToast('Từ ngày không được là Chủ Nhật (công ty làm T2–T7)', 'warning');
        return;
    }
    if (t && isSunday(t)) {
        $('#assignToDate').val('');
        showToast('Đến ngày không được là Chủ Nhật (công ty làm T2–T7)', 'warning');
        return;
    }
    if (f && t) { const diff = (new Date(t)-new Date(f))/86400000+1; if(diff>0) $('#assignTotalDays').val(diff); }
}

async function submitAssign() {
    const empList   = getSelectedEmpcds();
    const leaveType = $('#assignLeaveType').val();
    const from      = $('#assignFromDate').val();
    const to        = $('#assignToDate').val();
    const days      = parseFloat($('#assignTotalDays').val());
    const reason    = $('#assignReason').val().trim() || null;
    if (!empList.length)    { showToast('Chọn ít nhất 1 nhân viên', 'warning'); return; }
    if (!from || !to)       { showToast('Vui lòng chọn ngày', 'warning'); return; }
    if (isSunday(from))     { showToast('Từ ngày không được là Chủ Nhật (công ty làm T2–T7)', 'warning'); return; }
    if (isSunday(to))       { showToast('Đến ngày không được là Chủ Nhật (công ty làm T2–T7)', 'warning'); return; }
    if (!days || days <= 0) { showToast('Số ngày nghỉ không hợp lệ', 'warning'); return; }

    // Cảnh báo nhân viên không đủ phép năm nếu chọn loại AL
    if (leaveType === 'AL') {
        const notEnough = empList.filter(cd => {
            const b = empBalanceMap[cd];
            return b != null && (b.LEFT_NUM ?? 0) < days;
        });
        if (notEnough.length > 0) {
            const names = notEnough.map(cd => {
                const emp = allEmps.find(e => e.empcd === cd);
                const left = empBalanceMap[cd]?.LEFT_NUM ?? 0;
                return `<strong>${cd}</strong> ${emp ? `<span class="vni-font">${escHtml(emp.name)}</span>` : ''} (còn ${left} ngày)`;
            }).join('<br>');
            $('#assignResults').html(`<div class="alert alert-warning py-2 px-3 mb-0" style="font-size:.82rem;">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                <strong>Lưu ý:</strong> ${notEnough.length} nhân viên không đủ phép năm cho ${days} ngày:<br>${names}<br>
                <small class="text-muted">Vui lòng đổi loại nghỉ hoặc điều chỉnh số ngày cho phù hợp.</small>
            </div>`);
            return;
        }
    }

    const $btn = $('#assignBtn').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Đang xử lý...');
    $('#assignResults').empty();
    try {
        const res = await $.ajax({ url: ASSIGN_URL, type: 'POST', contentType: 'application/json',
            data: JSON.stringify({ ASSIGNER_EMPCD: '', TARGET_EMPCDS: empList, LEAVE_TYPE: leaveType, FROM_DATE: from, TO_DATE: to, TOTAL_DAYS: days, REASON: reason }) });
        if (res.results?.length) {
            $('#assignResults').html(res.results.map(r => {
                const cls = r.success ? 'ok' : 'err';
                const ico = r.success ? '<i class="bi bi-check-circle me-1"></i>' : '<i class="bi bi-x-circle me-1"></i>';
                return `<div class="result-item ${cls}">${ico}<strong>${escHtml(r.empcd||'')}</strong>: ${escHtml(r.message||'')}</div>`;
            }).join(''));
        }
        if (res.success) { showToast(res.message || 'Đã sắp lịch thành công', 'success'); clearAllEmps(); loadSchedule(); }
        else showToast(res.message || 'Có lỗi xảy ra', 'error');
    } catch { showToast('Lỗi kết nối', 'error'); }
    finally  { $btn.prop('disabled', false).html('<i class="bi bi-send me-1"></i> Sắp Lịch Nghỉ'); }
}

