@{
    ViewData["Title"] = "Lịch Nghỉ Team";
    int curMonth = (int)(ViewBag.CurrentMonth ?? DateTime.Today.Month);
    int curYear  = (int)(ViewBag.CurrentYear  ?? DateTime.Today.Year);
    string todayMin = DateTime.Today.AddDays(1).ToString("yyyy-MM-dd");
}

@section Styles {
<style>
    .pagination .page-link { cursor:pointer; border-radius:8px !important; margin:0 2px; }
    .pagination .page-item.disabled .page-link { cursor:default; }
    .pagination .page-item.active .page-link { background:#3b82f6; border-color:#3b82f6; }
    .month-nav { display:flex; align-items:center; gap:8px; }
    .month-nav button { border:none; background:rgba(255,255,255,.2); color:#fff; border-radius:6px; width:30px; height:30px; display:flex; align-items:center; justify-content:center; font-size:1rem; cursor:pointer; }
    .month-nav button:hover { background:rgba(255,255,255,.35); }
    .month-nav span { font-weight:700; font-size:1rem; color:#fff; min-width:120px; text-align:center; }
    .result-item { padding:6px 10px; border-radius:6px; margin-bottom:4px; font-size:.82rem; }
    .result-item.ok  { background:#ecfdf5; border-left:3px solid #10b981; color:#065f46; }
    .result-item.err { background:#fff0f0; border-left:3px solid #ef4444; color:#7f1d1d; }
    /* Emp checklist */
    .emp-list-wrap { max-height:340px; overflow-y:auto; border:1px solid #e2e8f0; border-radius:8px; background:#fafafa; }
    .emp-item { display:flex; align-items:center; gap:10px; padding:8px 12px; border-bottom:1px solid #f1f5f9; cursor:pointer; transition:background .15s; }
    .emp-item:last-child { border-bottom:none; }
    .emp-item:hover { background:#f0f7ff; }
    .emp-item.leave-empty  { background:#fff5f5; }
    .emp-item.leave-empty:hover { background:#fed7d7; }
    .emp-item.leave-low    { background:#fffbeb; }
    .emp-item.leave-low:hover { background:#fde68a; }
    .emp-item.leave-ok     { background:#f0fdf4; }
    .emp-item.leave-ok:hover { background:#bbf7d0; }
    .emp-item input[type=checkbox] { width:16px; height:16px; accent-color:#6366f1; flex-shrink:0; cursor:pointer; }
    .emp-item .emp-info { display:flex; flex-direction:column; min-width:0; }
    .emp-item .emp-name { font-size:.83rem; font-weight:600; color:#1e293b; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .emp-item .emp-dept { font-size:.73rem; color:#64748b; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .emp-item .emp-code { font-size:.75rem; color:#94a3b8; font-family:monospace; flex-shrink:0; }
    .leave-badge { font-size:.68rem; font-weight:700; padding:2px 6px; border-radius:10px; flex-shrink:0; white-space:nowrap; }
    .sel-count { font-size:.8rem; color:#6366f1; font-weight:600; }
    /* Approval status pills */
    .apv-tab { cursor:pointer; padding:5px 13px; border-radius:20px; font-size:.78rem; font-weight:600; border:1.5px solid transparent; transition:all .18s; }
    .apv-tab.active { background:#3b82f6; color:#fff; border-color:#3b82f6; }
    .apv-tab:not(.active) { background:#f1f5f9; color:#64748b; border-color:#e2e8f0; }
    .apv-tab:not(.active):hover { background:#e2e8f0; }
    /* Empcd filter input */
    .empcd-filter { width:110px; font-size:.8rem; height:30px; border-radius:8px; border:1.5px solid #e2e8f0; padding:0 8px 0 26px; outline:none; background:#fff; transition:border-color .18s; }
    .empcd-filter:focus { border-color:#6366f1; box-shadow:0 0 0 2px rgba(99,102,241,.14); }
    .empcd-wrap { position:relative; display:inline-flex; align-items:center; }
    .empcd-wrap i { position:absolute; left:7px; font-size:.75rem; color:#94a3b8; pointer-events:none; }
    /* Calendar */
    .cal-wrap { padding:0 1rem 1rem; }
    .cal-grid { display:grid; grid-template-columns:repeat(7,1fr); gap:3px; }
    .cal-hdr  { text-align:center; font-size:.65rem; font-weight:700; color:#94a3b8; padding:2px 0; }
    .cal-cell { border-radius:6px; padding:5px 2px 4px; text-align:center; min-height:42px; display:flex; flex-direction:column; align-items:center; justify-content:flex-start; gap:2px; background:#f8fafc; border:1px solid #e9ecef; cursor:default; transition:background .12s; }
    .cal-cell.cal-today  { background:#eff6ff; border-color:#3b82f6 !important; }
    .cal-cell.cal-past   { opacity:.55; }
    .cal-cell.cal-has    { border-color:#bfdbfe; background:#f0f9ff; cursor:pointer; }
    .cal-cell.cal-today.cal-has { background:#dbeafe; }
    .cal-cell.cal-has:hover { background:#e0f2fe; }
    .cal-cell.cal-selected { background:#3b82f6 !important; border-color:#1d4ed8 !important; }
    .cal-cell.cal-selected .cal-daynum { color:#fff !important; }
    .cal-cell.cal-selected .cal-count  { background:#fff !important; color:#1d4ed8 !important; }
    .cal-daynum { font-size:.73rem; font-weight:600; color:#374151; line-height:1; }
    .cal-cell.cal-past  .cal-daynum { color:#9ca3af; }
    .cal-cell.cal-today .cal-daynum { color:#1d4ed8; font-weight:800; }
    .cal-count { font-size:.58rem; padding:1px 5px; border-radius:8px; font-weight:700; color:#fff; line-height:1.3; }
    .cal-empty { opacity:0; pointer-events:none; }
    /* Row state in schedule table */
    tr.sch-past   td { color:#9ca3af !important; }
    tr.sch-past   .badge { opacity:.5; }
    tr.sch-active { background:#f0fdf4 !important; }
    /* Tab segmented control */
    #scheduleTab { background:#f1f5f9; border-radius:12px; padding:4px !important; gap:0 !important; margin-bottom:1rem !important; }
    #scheduleTab .nav-item { flex:1; }
    #scheduleTab .nav-link { width:100%; text-align:center; border-radius:9px; font-size:.85rem; font-weight:600; color:#64748b; padding:8px 12px; transition:all .2s; }
    #scheduleTab .nav-link.active { background:#fff; color:#3b82f6; box-shadow:0 1px 4px rgba(0,0,0,.12); }
    #scheduleTab .nav-link:not(.active):hover { color:#3b82f6; background:rgba(255,255,255,.5); }
    @@media (max-width:576px) {
        /* General */
        .container-fluid { padding-left:8px !important; padding-right:8px !important; }
        /* Tab nav */
        #scheduleTab { border-radius:10px; }
        #scheduleTab .nav-link { font-size:.7rem; padding:7px 2px; }
        #scheduleTab .nav-link .tab-text-full  { display:none; }
        #scheduleTab .nav-link .tab-text-short { display:inline; }
        #scheduleTab .nav-link i { font-size:.85rem; }
        /* Month nav */
        .month-nav span { min-width:76px; font-size:.82rem; }
        .month-nav button { width:26px; height:26px; }
        /* Calendar */
        .cal-wrap { padding:0 .3rem .55rem; }
        .cal-grid { gap:2px; }
        .cal-cell { min-height:38px; padding:3px 1px 2px; border-radius:4px; }
        .cal-daynum { font-size:.6rem; }
        .cal-count  { font-size:.5rem; padding:1px 3px; border-radius:5px; }
        .cal-hdr    { font-size:.54rem; padding:1px 0; }
        #calLegend  { font-size:.7rem !important; gap:8px !important; }
        /* Tables — reduce side padding */
        #tab-view    .table-responsive { padding-left:.35rem !important; padding-right:.35rem !important; }
        #tab-approve .table-responsive { padding-left:.35rem !important; padding-right:.35rem !important; }
        #tab-myassign .table-responsive { padding-left:.35rem !important; padding-right:.35rem !important; }
        /* Filter + count bars reduce padding */
        #tab-view .card-body .d-flex { padding-left:.6rem !important; padding-right:.6rem !important; }
        /* Approval filter: horizontal scroll, no wrap */
        #apvFilterBar { overflow-x:auto; flex-wrap:nowrap !important; -webkit-overflow-scrolling:touch; scrollbar-width:none; padding-bottom:6px; }
        #apvFilterBar::-webkit-scrollbar { display:none; }
        #apvFilterBar .apv-tab    { flex-shrink:0; font-size:.72rem; padding:4px 9px; }
        #apvFilterBar .empcd-wrap { flex-shrink:0; }
        /* Emp list */
        .emp-list-wrap { max-height:200px; }
        /* Pagination */
        .pagination-sm .page-link { padding:.2rem .38rem; font-size:.72rem; }
        /* py-4 container */
        .py-4 { padding-top:1rem !important; padding-bottom:1rem !important; }
        /* Summary cards (Tab 4) */
        #myAssignSummary .card { padding-top:.75rem !important; padding-bottom:.75rem !important; }
        #myAssignSummary .h4   { font-size:1.2rem; }
    }
    @@media (min-width:577px) {
        #scheduleTab .nav-link .tab-text-short { display:none; }
        #scheduleTab .nav-link .tab-text-full  { display:inline; }
    }
</style>
}

<div class="container-fluid py-4">

    <!-- Nav tabs -->
    <ul class="nav nav-pills d-flex" id="scheduleTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tab-view-btn" data-bs-toggle="pill" data-bs-target="#tab-view" type="button">
                <i class="bi bi-calendar3-range me-1"></i>
                <span class="tab-text-full">Xem lịch Team</span>
                <span class="tab-text-short">Xem lịch</span>
            </button>
        </li>
        <li class="nav-item" role="presentation" id="tabAssignLi">
            <button class="nav-link" id="tab-assign-btn" data-bs-toggle="pill" data-bs-target="#tab-assign" type="button">
                <i class="bi bi-calendar2-plus me-1"></i>
                <span class="tab-text-full">Sắp lịch nghỉ</span>
                <span class="tab-text-short">Sắp lịch</span>
            </button>
        </li>
        <li class="nav-item" role="presentation" id="tabApproveLi">
            <button class="nav-link" id="tab-approve-btn" data-bs-toggle="pill" data-bs-target="#tab-approve" type="button">
                <i class="bi bi-shield-check me-1"></i>
                <span class="tab-text-full">Duyệt nghỉ phép</span>
                <span class="tab-text-short">Duyệt</span>
                <span id="pendingBadge" class="badge rounded-pill ms-1 d-none" style="background:#ef4444;font-size:.65rem;padding:2px 6px;"></span>
            </button>
        </li>
        <li class="nav-item" role="presentation" id="tabMyAssignLi">
            <button class="nav-link" id="tab-myassign-btn" data-bs-toggle="pill" data-bs-target="#tab-myassign" type="button">
                <i class="bi bi-person-check me-1"></i>
                <span class="tab-text-full">Lịch tôi sắp</span>
                <span class="tab-text-short">Tôi sắp</span>
            </button>
        </li>
    </ul>

    <div class="tab-content">

        <!-- ══════════════════ TAB 1: XEM LỊCH ══════════════════ -->
        <div class="tab-pane fade show active" id="tab-view" role="tabpanel">
            <div class="card">
                <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                    <div class="bg-gradient-primary shadow-primary border-radius-lg pt-3 pb-2 px-3 d-flex justify-content-between align-items-center">
                        <h6 class="text-white mb-0"><i class="bi bi-calendar3-range me-1"></i> Lịch Nghỉ Team</h6>
                        <div class="month-nav">
                            <button onclick="changeMonth(-1)" title="Tháng trước"><i class="bi bi-chevron-left"></i></button>
                            <span class="month-label-display"></span>
                            <button onclick="changeMonth(1)" title="Tháng sau"><i class="bi bi-chevron-right"></i></button>
                        </div>
                    </div>
                </div>
                <div class="card-body px-0 pt-0 pb-2 mt-3">
                    <!-- Calendar -->
                    <div class="cal-wrap">
                        <div class="d-flex align-items-center justify-content-between mb-2 px-2">
                            <span class="text-xs text-uppercase text-secondary fw-bold" style="letter-spacing:.05em;">
                                <i class="bi bi-calendar3 me-1"></i>Số người nghỉ theo ngày
                            </span>
                            <button class="btn btn-link btn-sm p-0 text-secondary text-xs" id="calToggleBtn" onclick="toggleCalendar()">
                                <i class="bi bi-chevron-up" id="calToggleIcon"></i> Thu gọn
                            </button>
                        </div>
                        <div id="calWrapInner">
                            <div class="cal-grid" id="calGrid"></div>
                            <div class="text-xs text-muted mt-1 px-1" id="calLegend" style="display:flex;gap:10px;">
                                <span><span class="cal-count" style="background:#2563eb;">1-3</span> ít</span>
                                <span><span class="cal-count" style="background:#d97706;">4-7</span> vừa</span>
                                <span><span class="cal-count" style="background:#dc2626;">8+</span> nhiều</span>
                            </div>
                        </div>
                    </div>
                    <hr class="my-0 mx-3">
                    <div class="px-4 pt-2 pb-2 d-flex align-items-center gap-2 flex-wrap">
                        <div class="empcd-wrap">
                            <i class="bi bi-search"></i>
                            <input type="text" id="scheduleEmpFilter" class="empcd-filter" placeholder="Mã NV..." oninput="schPage=1;renderSchedule()">
                        </div>
                        <span id="calDayBadge" class="d-none badge d-inline-flex align-items-center gap-1" style="background:#e0f2fe;color:#0369a1;font-size:.78rem;padding:4px 8px;border-radius:20px;">
                            <i class="bi bi-calendar3" style="font-size:.75rem;"></i>
                            <span id="calDayBadgeText"></span>
                        </span>
                        <button id="viewAllBtn" class="btn btn-outline-secondary btn-sm d-none" style="font-size:.78rem;height:30px;border-radius:20px;" onclick="clearCalDay()">
                            <i class="bi bi-grid3x3 me-1"></i>Xem hết
                        </button>
                        <span class="text-xs text-muted ms-auto" id="scheduleFilterHint"></span>
                    </div>
                    <div class="table-responsive px-4">
                        <table class="table align-items-center mb-0 w-100 table-hover table-striped">
                            <thead class="bg-light">
                                <tr>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                        data-mobile="hidden">#</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                        data-mobile="primary" data-mobile-slot="code" data-mobile-label="Mã NV">Mã NV</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                        data-mobile="primary" data-mobile-slot="name" data-mobile-label="Họ & Tên">Họ &amp; Tên</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                        data-mobile="primary" data-mobile-slot="badge" data-mobile-label="Loại">Loại</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                        data-mobile="detail" data-mobile-label="Nguồn">Nguồn</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                        data-mobile="primary" data-mobile-slot="badge" data-mobile-label="Từ ngày">Từ ngày</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                        data-mobile="detail" data-mobile-label="Đến ngày">Đến ngày</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                        data-mobile="primary" data-mobile-slot="badge" data-mobile-label="Số ngày">Số ngày</th>
                                </tr>
                            </thead>
                            <tbody id="scheduleBody"></tbody>
                        </table>
                    </div>
                    <div class="d-flex justify-content-between align-items-center px-4 mt-2 mb-2">
                        <div id="scheduleCount" class="text-sm text-secondary"></div>
                        <nav><ul class="pagination pagination-sm mb-0" id="schedulePagination"></ul></nav>
                    </div>
                </div>
            </div>
        </div>

        <!-- ══════════════════ TAB 2: SẮP LỊCH ══════════════════ -->
        <div class="tab-pane fade" id="tab-assign" role="tabpanel">
            <div class="card">
                <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                    <div class="bg-gradient-primary shadow-primary border-radius-lg pt-3 pb-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h6 class="text-white mb-0"><i class="bi bi-calendar2-plus me-1"></i> Sắp Lịch Nghỉ Phép</h6>
                            <p class="text-white text-xs mt-1 mb-0 opacity-8">Chọn nhân viên → Điền ngày → Gửi</p>
                        </div>
                        <span class="badge bg-white text-warning sel-count" id="selCount">0 NV được chọn</span>
                    </div>
                </div>
                <div class="card-body mt-3">
                    <div class="row g-3">
                        <!-- LEFT: emp list -->
                        <div class="col-lg-6">
                            <label class="form-label small fw-bold mb-1">Nhân viên <span class="text-danger">*</span></label>
                            <div class="d-flex gap-2 mb-2">
                                <div class="flex-grow-1 position-relative">
                                    <i class="bi bi-search position-absolute" style="left:9px;top:50%;transform:translateY(-50%);color:#94a3b8;font-size:.8rem;"></i>
                                    <input type="text" id="empSearch" class="form-control form-control-sm ps-4" placeholder="Nhập mã NV..." oninput="filterEmps()" />
                                </div>
                                <button class="btn btn-outline-secondary btn-sm text-nowrap" onclick="selectAllEmps()">Chọn tất cả</button>
                                <button class="btn btn-outline-secondary btn-sm text-nowrap" onclick="clearAllEmps()">Bỏ chọn</button>
                            </div>
                            <div class="emp-list-wrap" id="empList">
                                <div class="text-center py-4 text-secondary text-sm">
                                    <div class="spinner-border spinner-border-sm me-2" role="status"></div> Đang tải...
                                </div>
                            </div>
                        </div>
                        <!-- RIGHT: date + submit -->
                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label class="form-label small fw-bold mb-1">Loại nghỉ <span class="text-danger">*</span></label>
                                <select id="assignLeaveType" class="form-select form-select-sm">
                                    <option value="AL">Phép năm (AL)</option>
                                    <option value="CL">Bảo hiểm xã hội (CL)</option>
                                    <option value="SL">Nghỉ bệnh (SL)</option>
                                    <option value="NPL">Không lương (NPL)</option>
                                    <option value="OTH">Khác (OTH)</option>
                                </select>
                            </div>
                            <div class="row mb-3">
                                <div class="col-6">
                                    <label class="form-label small fw-bold mb-1">Từ ngày <span class="text-danger">*</span></label>
                                    <input type="date" id="assignFromDate" class="form-control form-control-sm" min="@todayMin" onkeydown="return false" onchange="calcAssignDays()" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-bold mb-1">Đến ngày <span class="text-danger">*</span></label>
                                    <input type="date" id="assignToDate" class="form-control form-control-sm" min="@todayMin" onkeydown="return false" onchange="calcAssignDays()" />
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold mb-1">Số ngày nghỉ <span class="text-danger">*</span></label>
                                <input type="number" id="assignTotalDays" class="form-control form-control-sm" min="0.5" step="0.5" placeholder="VD: 3" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold mb-1">Lý do / Ghi chú</label>
                                <input type="text" id="assignReason" class="form-control form-control-sm" maxlength="300" placeholder="Nghỉ phép năm..." />
                            </div>
                            <button class="btn btn-warning text-white w-100" id="assignBtn" onclick="submitAssign()">
                                <i class="bi bi-send me-1"></i> Sắp Lịch Nghỉ
                            </button>
                            <div id="assignResults" class="mt-3"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ══════════════════ TAB 3: DUYỆT NGHỈ PHÉP ══════════════════ -->
        <div class="tab-pane fade" id="tab-approve" role="tabpanel">
            <div class="card">
                <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                    <div class="bg-gradient-primary shadow-primary border-radius-lg pt-3 pb-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <h6 class="text-white mb-0"><i class="bi bi-shield-check me-1"></i> Duyệt Đơn Nghỉ Phép</h6>
                        <div class="month-nav">
                            <button onclick="changeApprovalMonth(-1)" title="Tháng trước"><i class="bi bi-chevron-left"></i></button>
                            <span class="month-label-display"></span>
                            <button onclick="changeApprovalMonth(1)" title="Tháng sau"><i class="bi bi-chevron-right"></i></button>
                        </div>
                    </div>
                </div>
                <!-- Status filter -->
                <div id="apvFilterBar" class="px-3 pt-3 pb-2 d-flex align-items-center gap-2 flex-wrap" style="border-bottom:1px solid #f1f5f9;">
                    <span class="apv-tab active" id="apv-all"     onclick="setApvStatus('')">Tất cả</span>
                    <span class="apv-tab"        id="apv-pending" onclick="setApvStatus('PENDING')"><i class="bi bi-hourglass-split me-1"></i>Chờ duyệt</span>
                    <span class="apv-tab"        id="apv-approved"onclick="setApvStatus('APPROVED')"><i class="bi bi-check-circle me-1"></i>Đã duyệt</span>
                    <span class="apv-tab"        id="apv-rejected"onclick="setApvStatus('REJECTED')"><i class="bi bi-x-circle me-1"></i>Từ chối</span>
                    <div class="empcd-wrap ms-auto">
                        <i class="bi bi-search"></i>
                        <input type="text" id="apvEmpFilter" class="empcd-filter" placeholder="Mã NV..." oninput="onApvEmpInput()">
                    </div>
                </div>
                <div class="card-body px-0 pt-0 pb-2 mt-1">
                    <div class="table-responsive px-4 mt-2">
                        <table class="table align-items-center mb-0 w-100 table-hover table-striped">
                            <thead class="bg-light">
                                <tr>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                        data-mobile="hidden">#</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                        data-mobile="primary" data-mobile-slot="code" data-mobile-label="Mã NV">Mã NV</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                        data-mobile="primary" data-mobile-slot="name" data-mobile-label="Họ & Tên">Họ &amp; Tên</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
