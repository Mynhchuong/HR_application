function changeApprovalMonth(delta) {
    curMonth += delta;
    if (curMonth > 12) { curMonth = 1; curYear++; }
    if (curMonth < 1)  { curMonth = 12; curYear--; }
    updateMonthLabel();
    loadApproval(1);
}

function setApvStatus(s) {
    apvStatus = s;
    ['all','pending','approved','rejected'].forEach(k => document.getElementById('apv-'+k).classList.remove('active'));
    document.getElementById('apv-' + (s||'all').toLowerCase()).classList.add('active');
    loadApproval(1);
}

function onApvEmpInput() {
    clearTimeout(apvEmpTimeout);
    apvEmpTimeout = setTimeout(() => loadApproval(1), 400);
}

function buildApprovalRow(item, idx) {
    const ltLabel = LEAVE_LABEL[item.LEAVE_TYPE] || item.LEAVE_TYPE || '-';
    const ltColor = LEAVE_COLOR[item.LEAVE_TYPE] || 'secondary';
    let statusHtml = `<span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Chờ duyệt</span>`;
    if (item.STATUS === 'APPROVED') statusHtml = `<span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Đã duyệt</span>`;
    if (item.STATUS === 'REJECTED') statusHtml = `<span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Từ chối</span>`;
    const isSelf    = item.EMPCD === CURRENT_EMPCD;
    const canAct    = !isSelf && CAN_APPROVE && (ROLE_LEVELS[item.REQUESTER_ROLE]||1) < MY_LEVEL;
    const fromExpired = isFromDateExpired(item.FROM_DATE);
    const actions   = item.STATUS !== 'PENDING'
        ? '<span class="text-muted text-xs">-</span>'
        : canAct
            ? fromExpired
                ? `<span class="text-muted text-xs"><i class="bi bi-clock-history me-1"></i>Đã quá hạn</span>`
                : `<button class="btn btn-xs btn-success me-1" onclick="event.stopPropagation();openApvAction('${item.REQUEST_ID}','approve','${item.FROM_DATE||''}')"><i class="bi bi-check-lg"></i></button>
               <button class="btn btn-xs btn-danger"       onclick="event.stopPropagation();openApvAction('${item.REQUEST_ID}','reject','${item.FROM_DATE||''}')"><i class="bi bi-x-lg"></i></button>`
            : `<span class="text-warning text-xxs"><i class="bi bi-exclamation-triangle-fill me-1"></i>Cần cấp cao hơn</span>`;
    return `<tr>
        <td class="px-2 text-xs text-secondary">${idx}</td>
        <td class="px-2 text-sm">${escHtml(item.EMPCD||'')}</td>
        <td class="px-2 text-sm vni-font" style="text-transform:uppercase;">${escHtml(item.EMP_NAME||'')}</td>
        <td class="px-2"><span class="badge bg-${ltColor}">${ltLabel}</span></td>
        <td class="px-2 text-sm text-nowrap">${formatDate(item.FROM_DATE)}</td>
        <td class="px-2 text-sm text-nowrap">${formatDate(item.TO_DATE)}</td>
        <td class="px-2 text-sm fw-bold">${item.TOTAL_DAYS != null ? item.TOTAL_DAYS + ' ngày' : '-'}</td>
        <td class="text-center">${statusHtml}</td>
        <td class="text-center">${actions}</td>
    </tr>`;
}

function loadApproval(page = 1) {
    apvPage = page;
    $('#approvalBody').html(`<tr><td colspan="9" class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></td></tr>`);
    MobileTableHelper.refresh('approvalBody');
    const range = getMonthRange();
    $.ajax({
        url: PAGE_URL, type: 'GET',
        data: { status: apvStatus, search: ($('#apvEmpFilter').val()||'').trim(), date_from: range.from, date_to: range.to, page, page_size: apvPageSize },
        success: function(res) {
            if (!res.success) {
                $('#approvalBody').html(`<tr><td colspan="9" class="text-center text-danger py-4">Lỗi: ${res.message||''}</td></tr>`);
                MobileTableHelper.refresh('approvalBody');
                return;
            }
            apvTotal = res.total || 0;
            apvTotalPages = res.total_pages || 0;
            const data = res.data || [];
            if (!data.length) {
                $('#approvalBody').html(emptyRow('Không có đơn nghỉ nào'));
            } else {
                $('#approvalBody').html(data.map((item,i) => buildApprovalRow(item,(page-1)*apvPageSize+i+1)).join(''));
            }
            renderApvPagination();
            MobileTableHelper.refresh('approvalBody');
        },
        error: function(xhr) {
            $('#approvalBody').html(`<tr><td colspan="9" class="text-center text-danger py-4">Lỗi kết nối (${xhr.status})</td></tr>`);
            MobileTableHelper.refresh('approvalBody');
        }
    });
}

function renderApvPagination() {
    if (!apvTotal) { $('#apvCount').text(''); $('#apvPagination').empty(); return; }
    const s=(apvPage-1)*apvPageSize+1, e=Math.min(apvPage*apvPageSize,apvTotal);
    $('#apvCount').html(`<span class="text-xs">${s}-${e} / <strong>${apvTotal}</strong> phiếu</span>`);
    const $bar=$('#apvPagination').empty();
    const mk=(label,p,disabled,active)=>{const li=$('<li class="page-item">').toggleClass('disabled',!!disabled).toggleClass('active',!!active);$('<a class="page-link">').html(label).on('click',()=>{if(!disabled&&!active)loadApproval(p);}).appendTo(li);return li;};
    $bar.append(mk('&lsaquo;',apvPage-1,apvPage<=1));
    let from=Math.max(1,apvPage-2),to=Math.min(apvTotalPages,apvPage+2);
    for(let p=from;p<=to;p++) $bar.append(mk(p,p,false,p===apvPage));
    $bar.append(mk('&rsaquo;',apvPage+1,apvPage>=apvTotalPages));
}

function isFromDateExpired(fromDate) {
    if (!fromDate) return false;
    const today = new Date(); today.setHours(0, 0, 0, 0);
    const fd = new Date(fromDate); fd.setHours(0, 0, 0, 0);
    return fd <= today;
}

function openApvAction(id, type, fromDate) {
    if (isFromDateExpired(fromDate)) {
        showToast('Không thể xử lý đơn nghỉ đã bắt đầu hoặc quá hạn', 'error');
        return;
    }
    $('#tsActionId').val(id); $('#tsActionType').val(type);
    $('#tsActionComment').val(''); $('#tsActionError').addClass('d-none').text('');
    const isApprove = type === 'approve';
    $('#tsActionHeader').removeClass('bg-success bg-danger text-white').addClass(isApprove ? 'bg-success text-white' : 'bg-danger text-white');
    $('#tsActionTitle').text(isApprove ? 'Duyệt Đơn Nghỉ Phép' : 'Từ Chối Đơn Nghỉ Phép');
    $('#tsActionConfirm').removeClass('btn-success btn-danger').addClass(isApprove ? 'btn-success' : 'btn-danger');
    new bootstrap.Modal('#tsActionModal').show();
}

async function submitApprovalAction() {
    const id      = $('#tsActionId').val();
    const type    = $('#tsActionType').val();
    const comment = $('#tsActionComment').val();
    const url     = type === 'approve' ? APPROVE_URL : REJECT_URL;
    const $btn    = $('#tsActionConfirm').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>...');
    try {
        const res = await $.ajax({ url, type: 'POST', data: { request_id: id, comment } });
        if (res.success) {
            bootstrap.Modal.getInstance('#tsActionModal').hide();
            showToast(type === 'approve' ? 'Đã duyệt đơn nghỉ' : 'Đã từ chối đơn nghỉ', type === 'approve' ? 'success' : 'warning');
            loadApproval(apvPage);
            loadPendingBadge();
        } else {
            $('#tsActionError').removeClass('d-none').text(res.message || 'Lỗi xử lý');
        }
    } catch { $('#tsActionError').removeClass('d-none').text('Lỗi kết nối'); }
    finally  { $btn.prop('disabled', false).text('Xác Nhận'); }
}

