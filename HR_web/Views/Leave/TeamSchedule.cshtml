@{
    ViewData["Title"] = "Lịch Nghỉ Team";
    int curMonth = (int)(ViewBag.CurrentMonth ?? DateTime.Today.Month);
    int curYear  = (int)(ViewBag.CurrentYear  ?? DateTime.Today.Year);
    string todayMin = DateTime.Today.AddDays(1).ToString("yyyy-MM-dd");
}

@section Styles {
<style>
    .pagination .page-link { cursor:pointer; border-radius:8px !important; margin:0 2px; }
    .pagination .page-item.disabled .page-link { cursor:default; }
    .pagination .page-item.active .page-link { background:#3b82f6; border-color:#3b82f6; }
    .pending-age {
        display: inline-block; margin-top: 4px; padding: 2px 8px;
        border-radius: 999px; font-size: .7rem; font-weight: 700;
        background: #fef3c7; color: #92400e; border: 1px solid #fbbf24;
    }
    .pending-age.stale {
        background: #fee2e2; color: #991b1b; border-color: #dc2626;
        animation: pulse-red 1.6s infinite ease-in-out;
    }
    @@keyframes pulse-red {
        0%,100% { box-shadow: 0 0 0 0 rgba(220,38,38,.5); }
        50%     { box-shadow: 0 0 0 6px rgba(220,38,38,0); }
    }
    tr.row-stale-pending { background: linear-gradient(90deg, #fff1f2 0%, transparent 30%) !important; border-left: 4px solid #dc2626 !important; }
    tr.row-stale-pending td { background: transparent !important; }
    .sig-cell      { display:flex; gap:8px; justify-content:center; align-items:flex-start; }
    .sig-cell-item { text-align:center; min-width:80px; }
    .sig-cell-lbl  { font-size:.6rem; font-weight:700; color:#94a3b8; text-transform:uppercase; letter-spacing:.04em; margin-bottom:2px; }
    .sig-cell-img  { display:block; margin:0 auto; max-height:55px; max-width:110px; object-fit:contain; background:#fafafa; border-radius:4px; padding:2px; }
    .sig-cell-name { font-size:.65rem; color:#64748b; margin-top:2px; line-height:1.2; }
    .month-nav { display:flex; align-items:center; gap:8px; }
    .month-nav button { border:none; background:rgba(255,255,255,.2); color:#fff; border-radius:6px; width:30px; height:30px; display:flex; align-items:center; justify-content:center; font-size:1rem; cursor:pointer; }
    .month-nav button:hover { background:rgba(255,255,255,.35); }
    .month-nav span { font-weight:700; font-size:1rem; color:#fff; min-width:120px; text-align:center; }
    .result-item { padding:6px 10px; border-radius:6px; margin-bottom:4px; font-size:.82rem; }
    .result-item.ok  { background:#ecfdf5; border-left:3px solid #10b981; color:#065f46; }
    .result-item.err { background:#fff0f0; border-left:3px solid #ef4444; color:#7f1d1d; }
    /* Emp checklist */
    .emp-list-wrap { max-height:340px; overflow-y:auto; border:1px solid #e2e8f0; border-radius:8px; background:#fafafa; }
    .emp-item { display:flex; align-items:center; gap:10px; padding:8px 12px; border-bottom:1px solid #f1f5f9; cursor:pointer; transition:background .15s; }
    .emp-item:last-child { border-bottom:none; }
    .emp-item:hover { background:#f0f7ff; }
    .emp-item.leave-empty  { background:#fff5f5; }
    .emp-item.leave-empty:hover { background:#fed7d7; }
    .emp-item.leave-low    { background:#fffbeb; }
    .emp-item.leave-low:hover { background:#fde68a; }
    .emp-item.leave-ok     { background:#f0fdf4; }
    .emp-item.leave-ok:hover { background:#bbf7d0; }
    .emp-item input[type=checkbox] { width:16px; height:16px; accent-color:#6366f1; flex-shrink:0; cursor:pointer; }
    .emp-item .emp-info { display:flex; flex-direction:column; min-width:0; }
    .emp-item .emp-name { font-size:.83rem; font-weight:600; color:#1e293b; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .emp-item .emp-dept { font-size:.73rem; color:#64748b; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .emp-item .emp-code { font-size:.75rem; color:#94a3b8; font-family:monospace; flex-shrink:0; }
    .leave-badge { font-size:.68rem; font-weight:700; padding:2px 6px; border-radius:10px; flex-shrink:0; white-space:nowrap; }
    .sel-count { font-size:.8rem; color:#6366f1; font-weight:600; }
    /* Approval status pills */
    .apv-tab { cursor:pointer; padding:5px 13px; border-radius:20px; font-size:.78rem; font-weight:600; border:1.5px solid transparent; transition:all .18s; }
    .apv-tab.active { background:#3b82f6; color:#fff; border-color:#3b82f6; }
    .apv-tab:not(.active) { background:#f1f5f9; color:#64748b; border-color:#e2e8f0; }
    .apv-tab:not(.active):hover { background:#e2e8f0; }
    /* Empcd filter input */
    .empcd-filter { width:110px; font-size:.8rem; height:30px; border-radius:8px; border:1.5px solid #e2e8f0; padding:0 8px 0 26px; outline:none; background:#fff; transition:border-color .18s; }
    .empcd-filter:focus { border-color:#6366f1; box-shadow:0 0 0 2px rgba(99,102,241,.14); }
    .empcd-wrap { position:relative; display:inline-flex; align-items:center; }
    .empcd-wrap i { position:absolute; left:7px; font-size:.75rem; color:#94a3b8; pointer-events:none; }
    /* Tab segmented control */
    #scheduleTab { background:#f1f5f9; border-radius:12px; padding:4px !important; gap:0 !important; margin-bottom:1rem !important; }
    #scheduleTab .nav-item { flex:1; }
    #scheduleTab .nav-link { width:100%; text-align:center; border-radius:9px; font-size:.85rem; font-weight:600; color:#64748b; padding:8px 12px; transition:all .2s; }
    #scheduleTab .nav-link.active { background:#fff; color:#3b82f6; box-shadow:0 1px 4px rgba(0,0,0,.12); }
    #scheduleTab .nav-link:not(.active):hover { color:#3b82f6; background:rgba(255,255,255,.5); }
    @@media (max-width:576px) {
        /* General */
        .container-fluid { padding-left:8px !important; padding-right:8px !important; }
        /* Tab nav */
        #scheduleTab { border-radius:10px; }
        #scheduleTab .nav-link { font-size:.7rem; padding:7px 2px; }
        #scheduleTab .nav-link .tab-text-full  { display:none; }
        #scheduleTab .nav-link .tab-text-short { display:inline; }
        #scheduleTab .nav-link i { font-size:.85rem; }
        /* Month nav */
        .month-nav span { min-width:76px; font-size:.82rem; }
        .month-nav button { width:26px; height:26px; }
        /* Tables — reduce side padding */
        #tab-approve .table-responsive { padding-left:.35rem !important; padding-right:.35rem !important; }
        #tab-myassign .table-responsive { padding-left:.35rem !important; padding-right:.35rem !important; }
        /* Approval filter: horizontal scroll, no wrap */
        #apvFilterBar { overflow-x:auto; flex-wrap:nowrap !important; -webkit-overflow-scrolling:touch; scrollbar-width:none; padding-bottom:6px; }
        #apvFilterBar::-webkit-scrollbar { display:none; }
        #apvFilterBar .apv-tab    { flex-shrink:0; font-size:.72rem; padding:4px 9px; }
        #apvFilterBar .empcd-wrap { flex-shrink:0; }
        /* Emp list */
        .emp-list-wrap { max-height:200px; }
        /* Pagination */
        .pagination-sm .page-link { padding:.2rem .38rem; font-size:.72rem; }
        /* py-4 container */
        .py-4 { padding-top:1rem !important; padding-bottom:1rem !important; }
        /* Summary cards (Tab 4) */
        #myAssignSummary .card { padding-top:.75rem !important; padding-bottom:.75rem !important; }
        #myAssignSummary .h4   { font-size:1.2rem; }
    }
    @@media (min-width:577px) {
        #scheduleTab .nav-link .tab-text-short { display:none; }
        #scheduleTab .nav-link .tab-text-full  { display:inline; }
    }
</style>
}

<div class="container-fluid py-4">

    <!-- Nav tabs -->
    <ul class="nav nav-pills d-flex" id="scheduleTab" role="tablist">
        <li class="nav-item" role="presentation" id="tabAssignLi">
            <button class="nav-link" id="tab-assign-btn" data-bs-toggle="pill" data-bs-target="#tab-assign" type="button">
                <i class="bi bi-calendar2-plus me-1"></i>
                <span class="tab-text-full">Sắp lịch nghỉ</span>
                <span class="tab-text-short">Sắp lịch</span>
            </button>
        </li>
        <li class="nav-item" role="presentation" id="tabApproveLi">
            <button class="nav-link active" id="tab-approve-btn" data-bs-toggle="pill" data-bs-target="#tab-approve" type="button">
                <i class="bi bi-shield-check me-1"></i>
                <span class="tab-text-full">Duyệt nghỉ phép</span>
                <span class="tab-text-short">Duyệt</span>
                <span id="pendingBadge" class="badge rounded-pill ms-1 d-none" style="background:#ef4444;font-size:.65rem;padding:2px 6px;"></span>
            </button>
        </li>
        <li class="nav-item" role="presentation" id="tabMyAssignLi">
            <button class="nav-link" id="tab-myassign-btn" data-bs-toggle="pill" data-bs-target="#tab-myassign" type="button">
                <i class="bi bi-person-check me-1"></i>
                <span class="tab-text-full">Lịch tôi sắp</span>
                <span class="tab-text-short">Tôi sắp</span>
            </button>
        </li>
    </ul>

    <div class="tab-content">

        <!-- ══════════════════ TAB 2: SẮP LỊCH ══════════════════ -->
        <div class="tab-pane fade" id="tab-assign" role="tabpanel">
            <div class="card">
                <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                    <div class="bg-gradient-primary shadow-primary border-radius-lg pt-3 pb-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h6 class="text-white mb-0"><i class="bi bi-calendar2-plus me-1"></i> Sắp Lịch Nghỉ Phép</h6>
                            <p class="text-white text-xs mt-1 mb-0 opacity-8">Chọn nhân viên → Điền ngày → Gửi</p>
                        </div>
                        <span class="badge bg-white text-warning sel-count" id="selCount">0 NV được chọn</span>
                    </div>
                </div>
                <div class="card-body mt-3">
                    <div class="row g-3">
                        <!-- LEFT: emp list -->
                        <div class="col-lg-6">
                            <label class="form-label small fw-bold mb-1">Nhân viên <span class="text-danger">*</span></label>
                            <div class="d-flex gap-2 mb-2 flex-wrap">
                                <select id="filterEmpDept" class="form-select form-select-sm" style="min-width:120px;flex:1;" onchange="onDeptFilter()">
                                    <option value="">Tất cả bộ phận</option>
                                </select>
                                <select id="filterEmpLine" class="form-select form-select-sm" style="min-width:100px;flex:1;" onchange="onLineFilter()">
                                    <option value="">Tất cả line</option>
                                </select>
                                <select id="filterEmpWork" class="form-select form-select-sm" style="min-width:110px;flex:1;" onchange="filterEmps()">
                                    <option value="">Tất cả nhóm việc</option>
                                </select>
                            </div>
                            <div class="d-flex gap-2 mb-2">
                                <div class="flex-grow-1 position-relative">
                                    <i class="bi bi-search position-absolute" style="left:9px;top:50%;transform:translateY(-50%);color:#94a3b8;font-size:.8rem;"></i>
                                    <input type="text" id="empSearch" class="form-control form-control-sm ps-4" placeholder="Mã NV hoặc tên..." oninput="filterEmps()" />
                                </div>
                                <button class="btn btn-outline-secondary btn-sm text-nowrap" onclick="selectAllEmps()">Chọn tất cả</button>
                                <button class="btn btn-outline-secondary btn-sm text-nowrap" onclick="clearAllEmps()">Bỏ chọn</button>
                            </div>
                            <div class="emp-list-wrap" id="empList">
                                <div class="text-center py-4 text-secondary text-sm">
                                    <div class="spinner-border spinner-border-sm me-2" role="status"></div> Đang tải...
                                </div>
                            </div>
                        </div>
                        <!-- RIGHT: date + submit -->
                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label class="form-label small fw-bold mb-1">Loại nghỉ <span class="text-danger">*</span></label>
                                <select id="assignLeaveType" class="form-select form-select-sm">
                                    <option value="AL" selected>Phép năm (AL)</option>
                                    @* Tạm ẩn các loại còn lại — sẽ mở lại sau
                                    <option value="CL">Bảo hiểm xã hội (CL)</option>
                                    <option value="SL">Nghỉ bệnh (SL)</option>
                                    <option value="NPL">Không lương (NPL)</option>
                                    <option value="OTH">Khác (OTH)</option>
                                    *@
                                </select>
                            </div>
                            <div class="row mb-3">
                                <div class="col-6">
                                    <label class="form-label small fw-bold mb-1">Từ ngày <span class="text-danger">*</span></label>
                                    <input type="date" id="assignFromDate" class="form-control form-control-sm" min="@todayMin" onkeydown="return false" onchange="calcAssignDays()" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-bold mb-1">Đến ngày <span class="text-danger">*</span></label>
                                    <input type="date" id="assignToDate" class="form-control form-control-sm" min="@todayMin" onkeydown="return false" onchange="calcAssignDays()" />
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold mb-1">Số ngày nghỉ <span class="text-danger">*</span></label>
                                <input type="number" id="assignTotalDays" class="form-control form-control-sm bg-light" min="0.5" step="0.5" placeholder="Tự động tính" readonly />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold mb-1">Lý do / Ghi chú</label>
                                <input type="text" id="assignReason" class="form-control form-control-sm" maxlength="300" placeholder="Nghỉ phép năm..." />
                            </div>
                            <button class="btn btn-warning text-white w-100" id="assignBtn" onclick="submitAssign()">
                                <i class="bi bi-send me-1"></i> Sắp Lịch Nghỉ
                            </button>
                            <div id="assignResults" class="mt-3"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ══════════════════ TAB 3: DUYỆT NGHỈ PHÉP ══════════════════ -->
        <div class="tab-pane fade show active" id="tab-approve" role="tabpanel">
            <div class="card">
                <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                    <div class="bg-gradient-primary shadow-primary border-radius-lg pt-3 pb-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <h6 class="text-white mb-0"><i class="bi bi-shield-check me-1"></i> Duyệt Đơn Nghỉ Phép</h6>
                        <div class="month-nav">
                            <button onclick="changeApprovalMonth(-1)" title="Tháng trước"><i class="bi bi-chevron-left"></i></button>
                            <span class="month-label-display"></span>
                            <button onclick="changeApprovalMonth(1)" title="Tháng sau"><i class="bi bi-chevron-right"></i></button>
                        </div>
                    </div>
                </div>
                <!-- Status filter -->
                <div id="apvFilterBar" class="px-3 pt-3 pb-2 d-flex align-items-center gap-2 flex-wrap" style="border-bottom:1px solid #f1f5f9;">
                    <span class="apv-tab active" id="apv-all"     onclick="setApvStatus('')">Tất cả</span>
                    <span class="apv-tab"        id="apv-pending" onclick="setApvStatus('PENDING')"><i class="bi bi-hourglass-split me-1"></i>Chờ duyệt</span>
                    <span class="apv-tab"        id="apv-approved"onclick="setApvStatus('APPROVED')"><i class="bi bi-check-circle me-1"></i>Đã duyệt</span>
                    <span class="apv-tab"        id="apv-rejected"onclick="setApvStatus('REJECTED')"><i class="bi bi-x-circle me-1"></i>Từ chối</span>
                    <div class="empcd-wrap ms-auto">
                        <i class="bi bi-search"></i>
                        <input type="text" id="apvEmpFilter" class="empcd-filter" placeholder="Mã NV..." oninput="onApvEmpInput()">
                    </div>
                </div>
                <div class="card-body px-0 pt-0 pb-2 mt-1">
                    <div class="table-responsive px-4 mt-2">
                        <table class="table align-items-center mb-0 w-100 table-hover table-striped">
                            <thead class="bg-light">
                                <tr>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                        data-mobile="hidden">#</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                        data-mobile="primary" data-mobile-slot="code" data-mobile-label="Mã NV">Mã NV</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                        data-mobile="primary" data-mobile-slot="name" data-mobile-label="Họ & Tên">Họ &amp; Tên</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                        data-mobile="primary" data-mobile-slot="badge" data-mobile-label="Loại nghỉ">Loại nghỉ</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                        data-mobile="primary" data-mobile-slot="badge" data-mobile-label="Từ ngày">Từ ngày</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                        data-mobile="detail" data-mobile-label="Đến ngày">Đến ngày</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                        data-mobile="primary" data-mobile-slot="badge" data-mobile-label="Số ngày">Số ngày</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                        data-mobile="detail" data-mobile-label="Lý do">Lý do</th>
                                    <th class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-9"
                                        data-mobile="primary" data-mobile-slot="badge" data-mobile-label="Tình trạng">Tình trạng</th>
                                    <th class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-9"
                                        data-mobile="detail" data-mobile-label="Chữ ký">Chữ ký</th>
                                    <th class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-9"
                                        data-mobile="primary" data-mobile-slot="badge" data-mobile-label="Thao tác">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody id="approvalBody"></tbody>
                        </table>
                    </div>
                    <div class="d-flex justify-content-between align-items-center px-4 mt-3 mb-2">
                        <div id="apvCount" class="text-sm text-secondary"></div>
                        <nav><ul class="pagination pagination-sm mb-0" id="apvPagination"></ul></nav>
                    </div>
                </div>
            </div>
        </div>

        <!-- ══════════════════ TAB 4: LỊCH TÔI SẮP ══════════════════ -->
        <div class="tab-pane fade" id="tab-myassign" role="tabpanel">
            <!-- Summary cards -->
            <div class="row mb-3" id="myAssignSummary">
                <div class="col-6 col-xl-3 mb-3">
                    <div class="card text-center py-3 h-100">
                        <div class="text-xs text-uppercase text-secondary fw-bold mb-1">Tổng sắp lịch</div>
                        <div class="h4 fw-bold mb-0" id="maTotal">-</div>
                    </div>
                </div>
                <div class="col-6 col-xl-3 mb-3">
                    <div class="card text-center py-3 h-100" style="border-left:4px solid #f59e0b;">
                        <div class="text-xs text-uppercase fw-bold mb-1" style="color:#b45309;">Chưa tiếp nhận</div>
                        <div class="h4 fw-bold mb-0 text-warning" id="maPending">-</div>
                    </div>
                </div>
                <div class="col-6 col-xl-3 mb-3">
                    <div class="card text-center py-3 h-100" style="border-left:4px solid #10b981;">
                        <div class="text-xs text-uppercase fw-bold mb-1 text-success">Đã tiếp nhận</div>
                        <div class="h4 fw-bold mb-0 text-success" id="maConfirmed">-</div>
                    </div>
                </div>
            </div>
            <div class="card">
                <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                    <div class="bg-gradient-primary shadow-primary border-radius-lg pt-3 pb-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <h6 class="text-white mb-0"><i class="bi bi-person-check me-1"></i> Lịch Nghỉ Tôi Đã Sắp</h6>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <select id="maStatusFilter" class="form-select form-select-sm" style="width:150px;height:30px;font-size:.8rem;" onchange="loadMyAssign(1)">
                                <option value="">Tất cả</option>
                                <option value="ASSIGNED">Chưa tiếp nhận thông tin</option>
                                <option value="CONFIRMED">Đã tiếp nhận thông tin</option>
                            </select>
                            <div class="empcd-wrap">
                                <i class="bi bi-search"></i>
                                <input type="text" id="maEmpFilter" class="empcd-filter" placeholder="Mã NV..." oninput="onMaEmpInput()">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-body px-0 pt-0 pb-2 mt-3">
                    <div class="table-responsive px-4">
                        <table class="table align-items-center mb-0 w-100 table-hover table-striped">
                            <thead class="bg-light">
                                <tr>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                        data-mobile="hidden">#</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                        data-mobile="primary" data-mobile-slot="code" data-mobile-label="Mã NV">Mã NV</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                        data-mobile="primary" data-mobile-slot="name" data-mobile-label="Họ & Tên">Họ &amp; Tên</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                        data-mobile="primary" data-mobile-slot="badge" data-mobile-label="Loại">Loại</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                        data-mobile="primary" data-mobile-slot="badge" data-mobile-label="Từ ngày">Từ ngày</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                        data-mobile="detail" data-mobile-label="Đến ngày">Đến ngày</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                        data-mobile="detail" data-mobile-label="Số ngày">Số ngày</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"
                                        data-mobile="detail" data-mobile-label="Ngày sắp">Ngày sắp</th>
                                    <th class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-9"
                                        data-mobile="primary" data-mobile-slot="badge" data-mobile-label="Trạng thái">Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody id="myAssignBody"></tbody>
                        </table>
                    </div>
                    <div class="d-flex justify-content-between align-items-center px-4 mt-2 mb-2">
                        <div id="maCount" class="text-sm text-secondary"></div>
                        <nav><ul class="pagination pagination-sm mb-0" id="maPagination"></ul></nav>
                    </div>
                </div>
            </div>
        </div>

    </div><!-- /tab-content -->
</div>

<!-- Action Modal (Tab 3) -->
<div class="modal fade" id="tsActionModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header" id="tsActionHeader">
                <h6 class="modal-title mb-0" id="tsActionTitle"></h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="tsActionId" />
                <input type="hidden" id="tsActionType" />
                <div class="mb-2">
                    <label class="form-label small fw-bold">Ghi chú (không bắt buộc)</label>
                    <textarea id="tsActionComment" class="form-control form-control-sm" rows="2" maxlength="200"></textarea>
                </div>
                <div id="tsActionError" class="alert alert-danger d-none py-1 px-2 text-sm"></div>
            </div>
            <div class="modal-footer py-2">
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Huỷ</button>
                <button class="btn btn-sm text-white" id="tsActionConfirm" onclick="submitApprovalAction()">Xác Nhận</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
const NO_DATA_IMG = '@(new Random().Next(2)==0 ? Url.Content("~/assets/img/illustrations/A_nodata.png") : Url.Content("~/assets/img/illustrations/Chi_nodata.png"))';
function emptyRow(msg, cols=9) {
    return `<tr><td colspan="${cols}" class="text-center py-5">
        <img src="${NO_DATA_IMG}" style="width:130px;opacity:.85;margin-bottom:12px;display:block;margin-left:auto;margin-right:auto;">
        <div class="text-muted text-sm">${msg}</div>
    </td></tr>`;
}

const MY_ASSIGN_URL  = '@Url.Action("GetMyAssignmentsPage",   "Leave")';
const ASSIGN_URL     = '@Url.Action("AssignLeave",            "Leave")';
const APPROVE_URL    = '@Url.Action("ApproveRequest",         "Leave")';
const REJECT_URL     = '@Url.Action("RejectRequest",          "Leave")';
const PAGE_URL       = '@Url.Action("GetApprovalListPage",    "Leave")';
const SIG_URL        = '@Url.Action("GetSignature",           "Image")';
const EMP_SCOPE_URL  = '@Url.Action("GetEmpByScope",          "Dropdown")';
const BALANCE_URL    = '@Url.Action("GetAnnualLeaveBalance",  "Leave")';
const CURRENT_ROLE  = '@ViewBag.CurrentRole';
const CURRENT_EMPCD = '@ViewBag.CurrentEmpCd';
const CAN_ASSIGN    = ['Supervisor','DeputyManager','Manager','Admin'].includes(CURRENT_ROLE);
const CAN_APPROVE   = ['Supervisor','DeputyManager','Manager','Admin'].includes(CURRENT_ROLE);
const ROLE_LEVELS   = { Admin:99, Expat:5, Manager:4, DeputyManager:3, Supervisor:2, HR:1, Clerk:1, Worker:1 };
const MY_LEVEL      = ROLE_LEVELS[CURRENT_ROLE] || 1;

let curMonth = @curMonth, curYear = @curYear;
let allEmps       = [];
let empBalanceMap = {};
let empLoaded     = false;
let apvLoaded    = false;
let maLoaded     = false;
let apvStatus = '', apvPage = 1, apvTotal = 0, apvTotalPages = 0, apvPageSize = 20;
let maPage = 1, maTotal = 0, maTotalPages = 0, maPageSize = 20;
let apvEmpTimeout, maEmpTimeout;

const MONTHS_VI  = ['Tháng 1','Tháng 2','Tháng 3','Tháng 4','Tháng 5','Tháng 6',
                    'Tháng 7','Tháng 8','Tháng 9','Tháng 10','Tháng 11','Tháng 12'];
const LEAVE_LABEL = { AL:'Phép năm', CL:'BHXH', SL:'Bệnh', NPL:'Không lương', OTH:'Khác' };
const LEAVE_COLOR = { AL:'primary', CL:'info', SL:'danger', NPL:'secondary', OTH:'warning' };

function getMonthRange() {
    const firstDay = new Date(curYear, curMonth - 1, 1);
    const lastDay  = new Date(curYear, curMonth, 0);
    const fmt = d => d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
    return { from: fmt(firstDay), to: fmt(lastDay) };
}

function updateMonthLabel() {
    $('.month-label-display').text(MONTHS_VI[curMonth-1] + ' / ' + curYear);
}

// ─── Tab 2 ───────────────────────────────────────────────────────
function loadEmps() {
    if (empLoaded) return;
    empLoaded = true;
    $.when(
        $.get(EMP_SCOPE_URL),
        $.get(BALANCE_URL)
    ).done(function(empRes, balRes) {
        allEmps = empRes[0] || [];
        const balData = (balRes[0]?.data) || [];
        empBalanceMap = {};
        balData.forEach(b => { empBalanceMap[b.EMPCD] = b; });
        buildDeptOptions();
        renderEmpList(allEmps);
    }).fail(function() {
        $('#empList').html('<div class="text-center py-3 text-danger text-sm"><i class="bi bi-exclamation-triangle me-1"></i>Lỗi tải danh sách nhân viên</div>');
    });
}

function empLeaveBadge(empcd) {
    const b = empBalanceMap[empcd];
    if (!b) return '';
    const left = b.LEFT_NUM ?? 0;
    if (left <= 0)  return `<span class="leave-badge" style="background:#fee2e2;color:#b91c1c;">Hết phép</span>`;
    if (left <= 3)  return `<span class="leave-badge" style="background:#fef3c7;color:#92400e;">${left} ngày</span>`;
    return `<span class="leave-badge" style="background:#dcfce7;color:#166534;">${left} ngày</span>`;
}
function empLeaveClass(empcd) {
    const b = empBalanceMap[empcd];
    if (!b) return '';
    const left = b.LEFT_NUM ?? 0;
    if (left <= 0) return 'leave-empty';
    if (left <= 3) return 'leave-low';
    return 'leave-ok';
}

function renderEmpList(emps) {
    if (!emps.length) {
        $('#empList').html('<div class="text-center py-4 text-muted text-sm"><i class="bi bi-people fs-4 d-block mb-2"></i>Không có nhân viên trong phạm vi</div>');
        return;
    }
    $('#empList').html(emps.map(e => `
        <label class="emp-item ${empLeaveClass(e.empcd||'')}" data-empcd="${escHtml(e.empcd||'')}" data-name="${escHtml(e.name||'')}">
            <input type="checkbox" class="emp-chk" value="${escHtml(e.empcd||'')}" onchange="updateSelCount()" />
            <div class="emp-info flex-grow-1 min-width-0">
                <div class="emp-name vni-font">${escHtml(e.name||'')}</div>
                <div class="emp-dept">${escHtml(e.dept_name||'')}${e.line_name ? ' / ' + escHtml(e.line_name) : ''}</div>
            </div>
            <span class="emp-code">${escHtml(e.empcd||'')}</span>
            ${empLeaveBadge(e.empcd||'')}
        </label>`).join(''));
    updateSelCount();
}

function buildDeptOptions() {
    const depts = [...new Set(allEmps.map(e => e.dept_name||'').filter(Boolean))].sort();
    const $d = $('#filterEmpDept').empty().append('<option value="">Tất cả bộ phận</option>');
    depts.forEach(d => $d.append(`<option value="${escHtml(d)}">${escHtml(d)}</option>`));
    buildLineOptions('');
    buildWorkOptions('', '');
}

function buildLineOptions(dept) {
    const src = dept ? allEmps.filter(e => (e.dept_name||'') === dept) : allEmps;
    const lines = [...new Set(src.map(e => e.line_name||'').filter(Boolean))].sort();
    const $l = $('#filterEmpLine').empty().append('<option value="">Tất cả line</option>');
    lines.forEach(l => $l.append(`<option value="${escHtml(l)}">${escHtml(l)}</option>`));
    $l.prop('disabled', !lines.length);
}

function buildWorkOptions(dept, line) {
    let src = allEmps;
    if (dept) src = src.filter(e => (e.dept_name||'') === dept);
    if (line) src = src.filter(e => (e.line_name||'') === line);
    const works = [...new Set(src.map(e => e.work_name||'').filter(Boolean))].sort();
    const $w = $('#filterEmpWork').empty().append('<option value="">Tất cả nhóm việc</option>');
    works.forEach(w => $w.append(`<option value="${escHtml(w)}">${escHtml(w)}</option>`));
    $w.prop('disabled', !works.length);
}

function onDeptFilter() {
    buildLineOptions($('#filterEmpDept').val());
    buildWorkOptions($('#filterEmpDept').val(), '');
    filterEmps();
}

function onLineFilter() {
    buildWorkOptions($('#filterEmpDept').val(), $('#filterEmpLine').val());
    filterEmps();
}

function filterEmps() {
    const q    = ($('#empSearch').val() || '').trim().toUpperCase();
    const dept = $('#filterEmpDept').val() || '';
    const line = $('#filterEmpLine').val() || '';
    const work = $('#filterEmpWork').val() || '';
    let list = allEmps;
    if (dept) list = list.filter(e => (e.dept_name||'') === dept);
    if (line) list = list.filter(e => (e.line_name||'') === line);
    if (work) list = list.filter(e => (e.work_name||'') === work);
    if (q)    list = list.filter(e => (e.empcd||'').toUpperCase().includes(q) || (e.name||'').toUpperCase().includes(q));
    renderEmpList(list);
}
function selectAllEmps()  { $('#empList .emp-chk:visible').prop('checked', true); updateSelCount(); }
function clearAllEmps()   { $('#empList .emp-chk').prop('checked', false); updateSelCount(); }
function updateSelCount() { $('#selCount').text($('#empList .emp-chk:checked').length + ' NV được chọn'); }
function getSelectedEmpcds() { return $('#empList .emp-chk:checked').map(function() { return $(this).val(); }).get(); }

function isSunday(dateStr) {
    if (!dateStr) return false;
    const p = dateStr.split('-');
    return new Date(Date.UTC(+p[0], +p[1]-1, +p[2])).getUTCDay() === 0;
}

function calcAssignDays() {
    const f = $('#assignFromDate').val(), t = $('#assignToDate').val();
    if (f && isSunday(f)) {
        $('#assignFromDate').val('');
        showToast('Từ ngày không được là Chủ Nhật (công ty làm T2–T7)', 'warning');
        return;
    }
    if (t && isSunday(t)) {
        $('#assignToDate').val('');
        showToast('Đến ngày không được là Chủ Nhật (công ty làm T2–T7)', 'warning');
        return;
    }
    if (f && t) {
        const pf = f.split('-'), pt = t.split('-');
        const d1 = Date.UTC(+pf[0], +pf[1]-1, +pf[2]);
        const d2 = Date.UTC(+pt[0], +pt[1]-1, +pt[2]);
        if (d2 >= d1) {
            let count = 0;
            for (let d = d1; d <= d2; d += 86400000) {
                if (new Date(d).getUTCDay() !== 0) count++;
            }
            $('#assignTotalDays').val(count);
        }
    }
}

async function submitAssign() {
    const empList   = getSelectedEmpcds();
    const leaveType = $('#assignLeaveType').val();
    const from      = $('#assignFromDate').val();
    const to        = $('#assignToDate').val();
    const days      = parseFloat($('#assignTotalDays').val());
    const reason    = $('#assignReason').val().trim() || null;
    if (!empList.length)    { showToast('Chọn ít nhất 1 nhân viên', 'warning'); return; }
    if (!from || !to)       { showToast('Vui lòng chọn ngày', 'warning'); return; }
    const _today = new Date(); _today.setHours(0,0,0,0);
    if (new Date(from) <= _today) { showToast('Chỉ được sắp lịch từ ngày mai trở đi', 'warning'); return; }
    if (isSunday(from))     { showToast('Từ ngày không được là Chủ Nhật (công ty làm T2–T7)', 'warning'); return; }
    if (isSunday(to))       { showToast('Đến ngày không được là Chủ Nhật (công ty làm T2–T7)', 'warning'); return; }
    if (!days || days <= 0) { showToast('Số ngày nghỉ không hợp lệ', 'warning'); return; }

    // Cảnh báo nhân viên không đủ phép năm nếu chọn loại AL
    if (leaveType === 'AL') {
        const notEnough = empList.filter(cd => {
            const b = empBalanceMap[cd];
            return b != null && (b.LEFT_NUM ?? 0) < days;
        });
        if (notEnough.length > 0) {
            const names = notEnough.map(cd => {
                const emp = allEmps.find(e => e.empcd === cd);
                const left = empBalanceMap[cd]?.LEFT_NUM ?? 0;
                return `<strong>${cd}</strong> ${emp ? `<span class="vni-font">${escHtml(emp.name)}</span>` : ''} (còn ${left} ngày)`;
            }).join('<br>');
            $('#assignResults').html(`<div class="alert alert-warning py-2 px-3 mb-0" style="font-size:.82rem;">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                <strong>Lưu ý:</strong> ${notEnough.length} nhân viên không đủ phép năm cho ${days} ngày:<br>${names}<br>
                <small class="text-muted">Vui lòng đổi loại nghỉ hoặc điều chỉnh số ngày cho phù hợp.</small>
            </div>`);
            return;
        }
    }

    const $btn = $('#assignBtn').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Đang kiểm tra...');
    $('#assignResults').empty();
    try {
        // Kiểm tra overlap: NV đã có đơn PENDING hoặc APPROVED trong khoảng ngày này
        const checkRes = await $.ajax({
            url: PAGE_URL, type: 'GET',
            data: { page: 1, page_size: 200, date_from: from, date_to: to }
        });
        if (checkRes.success && checkRes.data?.length) {
            const empSet = new Set(empList);
            const conflicts = checkRes.data.filter(r => {
                if (!empSet.has(r.EMPCD)) return false;
                const rFrom = (r.FROM_DATE || '').slice(0, 10);
                const rTo   = (r.TO_DATE   || '').slice(0, 10);
                return rFrom && rTo && from <= rTo && to >= rFrom &&
                       (r.STATUS === 'PENDING' || r.STATUS === 'APPROVED');
            });
            if (conflicts.length > 0) {
                const rows = conflicts.map(r => {
                    const st = r.STATUS === 'APPROVED'
                        ? '<span class="badge bg-success">Đã duyệt</span>'
                        : '<span class="badge bg-warning text-dark">Chờ duyệt</span>';
                    const emp  = allEmps.find(e => e.empcd === r.EMPCD);
                    const name = emp ? `<span class="vni-font ms-1">${escHtml(emp.name)}</span>` : '';
                    return `<div class="result-item err d-flex align-items-center gap-2 flex-wrap">
                        <strong>${escHtml(r.EMPCD)}</strong>${name} ${st}
                        <span class="text-muted" style="font-size:.75rem;">${formatDate(r.FROM_DATE)} – ${formatDate(r.TO_DATE)}</span>
                    </div>`;
                }).join('');
                $('#assignResults').html(`
                    <div class="alert alert-danger py-2 px-3 mb-2" style="font-size:.82rem;">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        <strong>${conflicts.length} nhân viên</strong> đã có đơn nghỉ phép trùng khoảng ngày này — vui lòng kiểm tra và phối hợp nội bộ:
                    </div>${rows}`);
                return;
            }
        }

        $btn.html('<span class="spinner-border spinner-border-sm me-1"></span>Đang xử lý...');
        const res = await $.ajax({ url: ASSIGN_URL, type: 'POST', contentType: 'application/json',
            data: JSON.stringify({ ASSIGNER_EMPCD: '', TARGET_EMPCDS: empList, LEAVE_TYPE: leaveType, FROM_DATE: from, TO_DATE: to, TOTAL_DAYS: days, REASON: reason }) });
        if (res.results?.length) {
            $('#assignResults').html(res.results.map(r => {
                const cls = r.success ? 'ok' : 'err';
                const ico = r.success ? '<i class="bi bi-check-circle me-1"></i>' : '<i class="bi bi-x-circle me-1"></i>';
                return `<div class="result-item ${cls}">${ico}<strong>${escHtml(r.empcd||'')}</strong>: ${escHtml(r.message||'')}</div>`;
            }).join(''));
        }
        if (res.success) { showToast(res.message || 'Đã sắp lịch thành công', 'success'); clearAllEmps(); }
        else showToast(res.message || 'Có lỗi xảy ra', 'error');
    } catch { showToast('Lỗi kết nối', 'error'); }
    finally  { $btn.prop('disabled', false).html('<i class="bi bi-send me-1"></i> Sắp Lịch Nghỉ'); }
}

// ─── Tab 3 ───────────────────────────────────────────────────────
function changeApprovalMonth(delta) {
    curMonth += delta;
    if (curMonth > 12) { curMonth = 1; curYear++; }
    if (curMonth < 1)  { curMonth = 12; curYear--; }
    updateMonthLabel();
    loadApproval(1);
}

function setApvStatus(s) {
    apvStatus = s;
    ['all','pending','approved','rejected'].forEach(k => document.getElementById('apv-'+k).classList.remove('active'));
    document.getElementById('apv-' + (s||'all').toLowerCase()).classList.add('active');
    loadApproval(1);
}

function onApvEmpInput() {
    clearTimeout(apvEmpTimeout);
    apvEmpTimeout = setTimeout(() => loadApproval(1), 400);
}

function buildApprovalRow(item, idx) {
    const ltLabel = LEAVE_LABEL[item.LEAVE_TYPE] || item.LEAVE_TYPE || '-';
    const ltColor = LEAVE_COLOR[item.LEAVE_TYPE] || 'secondary';

    let pendingDays = 0, isStale = false;
    if (item.STATUS === 'PENDING' && item.CREATED_DATE) {
        pendingDays = Math.floor((Date.now() - new Date(item.CREATED_DATE)) / 86400000);
        isStale = pendingDays >= 15;
    }

    let statusHtml = `<span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Chờ duyệt</span>`;
    if (item.STATUS === 'PENDING' && pendingDays > 0) {
        statusHtml += `<div class="pending-age ${isStale ? 'stale' : ''}"><i class="bi bi-alarm me-1"></i>Đã ${pendingDays} ngày chờ</div>`;
    }
    if (item.STATUS === 'APPROVED') statusHtml = `<span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Đã duyệt</span>`;
    if (item.STATUS === 'REJECTED') statusHtml = `<span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Từ chối</span>`;
    const isSelf    = item.EMPCD === CURRENT_EMPCD;
    const canAct    = !isSelf && CAN_APPROVE && (ROLE_LEVELS[item.REQUESTER_ROLE]||1) < MY_LEVEL;
    const fromExpired = isFromDateExpired(item.FROM_DATE);
    const actions   = item.STATUS !== 'PENDING'
        ? '<span class="text-muted text-xs">-</span>'
        : canAct
            ? fromExpired
                ? `<span class="text-muted text-xs"><i class="bi bi-clock-history me-1"></i>Đã quá hạn</span>`
                : `<button class="btn btn-xs btn-success me-1" onclick="event.stopPropagation();openApvAction('${item.REQUEST_ID}','approve','${item.FROM_DATE||''}')"><i class="bi bi-check-lg"></i></button>
               <button class="btn btn-xs btn-danger"       onclick="event.stopPropagation();openApvAction('${item.REQUEST_ID}','reject','${item.FROM_DATE||''}')"><i class="bi bi-x-lg"></i></button>`
            : `<span class="text-warning text-xxs"><i class="bi bi-exclamation-triangle-fill me-1"></i>Cần cấp cao hơn</span>`;
    const reqSig = item.EMPCD
        ? `<div class="sig-cell-item">
               <div class="sig-cell-lbl">Người ký</div>
               <img src="${SIG_URL}?empCd=${encodeURIComponent(item.EMPCD)}" class="sig-cell-img" onerror="this.remove()" alt="Chữ ký"/>
           </div>` : '';
    const apSig = (item.STATUS !== 'PENDING' && item.FINAL_APPROVER)
        ? `<div class="sig-cell-item">
               <div class="sig-cell-lbl">Người duyệt</div>
               <img src="${SIG_URL}?empCd=${encodeURIComponent(item.FINAL_APPROVER)}" class="sig-cell-img" onerror="this.remove()" alt="Chữ ký"/>
               ${item.APPROVER_NAME ? `<div class="sig-cell-name vni-font">${escHtml(item.APPROVER_NAME)}</div>` : ''}
           </div>` : '';
    const sigCell = `<div class="sig-cell">${reqSig}${apSig}</div>`;

    return `<tr class="${isStale ? 'row-stale-pending' : ''}">
        <td class="px-2 text-xs text-secondary">${idx}</td>
        <td class="px-2 text-sm">${escHtml(item.EMPCD||'')}</td>
        <td class="px-2 text-sm vni-font" style="text-transform:uppercase;">${escHtml(item.EMP_NAME||'')}</td>
        <td class="px-2"><span class="badge bg-${ltColor}">${ltLabel}</span></td>
        <td class="px-2 text-sm text-nowrap">${formatDate(item.FROM_DATE)}</td>
        <td class="px-2 text-sm text-nowrap">${formatDate(item.TO_DATE)}</td>
        <td class="px-2 text-sm fw-bold">${item.TOTAL_DAYS != null ? item.TOTAL_DAYS + ' ngày' : '-'}</td>
        <td class="px-2 text-sm" style="max-width:180px;white-space:normal;color:#475569;">${item.REASON ? escHtml(item.REASON) : '<span class="text-muted">-</span>'}</td>
        <td class="text-center">${statusHtml}</td>
        <td class="text-center">${sigCell}</td>
        <td class="text-center">${actions}</td>
    </tr>`;
}

function loadApproval(page = 1) {
    apvPage = page;
    $('#approvalBody').html(`<tr><td colspan="11" class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></td></tr>`);
    MobileTableHelper.refresh('approvalBody');
    const range = getMonthRange();
    $.ajax({
        url: PAGE_URL, type: 'GET',
        data: { status: apvStatus, search: ($('#apvEmpFilter').val()||'').trim(), date_from: range.from, date_to: range.to, page, page_size: apvPageSize },
        success: function(res) {
            if (!res.success) {
                $('#approvalBody').html(`<tr><td colspan="11" class="text-center text-danger py-4">Lỗi: ${res.message||''}</td></tr>`);
                MobileTableHelper.refresh('approvalBody');
                return;
            }
            apvTotal = res.total || 0;
            apvTotalPages = res.total_pages || 0;
            const data = res.data || [];
            if (!data.length) {
                $('#approvalBody').html(emptyRow('Không có đơn nghỉ nào', 11));
            } else {
                $('#approvalBody').html(data.map((item,i) => buildApprovalRow(item,(page-1)*apvPageSize+i+1)).join(''));
            }
            renderApvPagination();
            MobileTableHelper.refresh('approvalBody');
        },
        error: function(xhr) {
            $('#approvalBody').html(`<tr><td colspan="11" class="text-center text-danger py-4">Lỗi kết nối (${xhr.status})</td></tr>`);
            MobileTableHelper.refresh('approvalBody');
        }
    });
}

function renderApvPagination() {
    if (!apvTotal) { $('#apvCount').text(''); $('#apvPagination').empty(); return; }
    const s=(apvPage-1)*apvPageSize+1, e=Math.min(apvPage*apvPageSize,apvTotal);
    $('#apvCount').html(`<span class="text-xs">${s}-${e} / <strong>${apvTotal}</strong> phiếu</span>`);
    const $bar=$('#apvPagination').empty();
    const mk=(label,p,disabled,active)=>{const li=$('<li class="page-item">').toggleClass('disabled',!!disabled).toggleClass('active',!!active);$('<a class="page-link">').html(label).on('click',()=>{if(!disabled&&!active)loadApproval(p);}).appendTo(li);return li;};
    $bar.append(mk('&lsaquo;',apvPage-1,apvPage<=1));
    let from=Math.max(1,apvPage-2),to=Math.min(apvTotalPages,apvPage+2);
    for(let p=from;p<=to;p++) $bar.append(mk(p,p,false,p===apvPage));
    $bar.append(mk('&rsaquo;',apvPage+1,apvPage>=apvTotalPages));
}

function isFromDateExpired(fromDate) {
    if (!fromDate) return false;
    const today = new Date(); today.setHours(0, 0, 0, 0);
    const fd = new Date(fromDate); fd.setHours(0, 0, 0, 0);
    return fd < today;
}

function openApvAction(id, type, fromDate) {
    if (isFromDateExpired(fromDate)) {
        showToast('Không thể xử lý đơn nghỉ đã bắt đầu hoặc quá hạn', 'error');
        return;
    }
    $('#tsActionId').val(id); $('#tsActionType').val(type);
    $('#tsActionComment').val(''); $('#tsActionError').addClass('d-none').text('');
    const isApprove = type === 'approve';
    $('#tsActionHeader').removeClass('bg-success bg-danger text-white').addClass(isApprove ? 'bg-success text-white' : 'bg-danger text-white');
    $('#tsActionTitle').text(isApprove ? 'Duyệt Đơn Nghỉ Phép' : 'Từ Chối Đơn Nghỉ Phép');
    $('#tsActionConfirm').removeClass('btn-success btn-danger').addClass(isApprove ? 'btn-success' : 'btn-danger');
    new bootstrap.Modal('#tsActionModal').show();
}

async function submitApprovalAction() {
    const id      = $('#tsActionId').val();
    const type    = $('#tsActionType').val();
    const comment = $('#tsActionComment').val();
    const url     = type === 'approve' ? APPROVE_URL : REJECT_URL;
    const $btn    = $('#tsActionConfirm').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>...');
    try {
        const res = await $.ajax({ url, type: 'POST', data: { request_id: id, comment } });
        if (res.success) {
            bootstrap.Modal.getInstance('#tsActionModal').hide();
            showToast(type === 'approve' ? 'Đã duyệt đơn nghỉ' : 'Đã từ chối đơn nghỉ', type === 'approve' ? 'success' : 'warning');
            loadApproval(apvPage);
            loadPendingBadge();
        } else {
            $('#tsActionError').removeClass('d-none').text(res.message || 'Lỗi xử lý');
        }
    } catch { $('#tsActionError').removeClass('d-none').text('Lỗi kết nối'); }
    finally  { $btn.prop('disabled', false).text('Xác Nhận'); }
}

// ─── Tab 4 ───────────────────────────────────────────────────────
function onMaEmpInput() {
    clearTimeout(maEmpTimeout);
    maEmpTimeout = setTimeout(() => loadMyAssign(1), 400);
}

function buildMyAssignRow(item, idx) {
    const lt = LEAVE_LABEL[item.LEAVE_TYPE] || item.LEAVE_TYPE || '-';
    const lc = LEAVE_COLOR[item.LEAVE_TYPE] || 'secondary';
    let statusHtml;
    if (item.CONFIRM_STATUS === 'CONFIRMED')
        statusHtml = `<span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Đã tiếp nhận thông tin</span>`;
    else
        statusHtml = `<span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Chưa tiếp nhận thông tin</span>`;
    return `<tr>
        <td class="px-2 text-xs text-secondary">${idx}</td>
        <td class="px-2 text-sm">${escHtml(item.EMPCD||'')}</td>
        <td class="px-2 text-sm vni-font" style="text-transform:uppercase;">${escHtml(item.EMP_NAME||'')}</td>
        <td class="px-2"><span class="badge bg-${lc}">${lt}</span></td>
        <td class="px-2 text-sm text-nowrap">${formatDate(item.FROM_DATE)}</td>
        <td class="px-2 text-sm text-nowrap">${formatDate(item.TO_DATE)}</td>
        <td class="px-2 text-sm fw-bold">${item.TOTAL_DAYS != null ? item.TOTAL_DAYS + ' ngày' : '-'}</td>
        <td class="px-2 text-sm text-nowrap text-secondary">${formatDate(item.ASSIGN_DATE)}</td>
        <td class="text-center">${statusHtml}</td>
    </tr>`;
}

function loadMyAssign(page = 1) {
    maPage = page;
    $('#myAssignBody').html(`<tr><td colspan="9" class="text-center py-5"><div class="spinner-border text-dark" role="status"></div></td></tr>`);
    MobileTableHelper.refresh('myAssignBody');
    $.ajax({
        url: MY_ASSIGN_URL, type: 'GET',
        data: {
            status: $('#maStatusFilter').val(),
            search: ($('#maEmpFilter').val()||'').trim(),
            page, page_size: maPageSize
        },
        success: function(res) {
            if (!res.success) {
                $('#myAssignBody').html(`<tr><td colspan="9" class="text-center text-danger py-4">Lỗi: ${res.message||''}</td></tr>`);
                MobileTableHelper.refresh('myAssignBody');
                return;
            }
            const s = res.summary || {};
            $('#maTotal').text((s.TOTAL||0).toLocaleString());
            $('#maPending').text((s.PENDING_CONFIRM||0).toLocaleString());
            $('#maConfirmed').text((s.CONFIRMED||0).toLocaleString());
            maTotal      = res.total      || 0;
            maTotalPages = res.total_pages || 0;
            const data   = res.data || [];
            if (!data.length) {
                $('#myAssignBody').html(emptyRow('Chưa sắp lịch cho ai', 9));
            } else {
                $('#myAssignBody').html(data.map((item,i) => buildMyAssignRow(item,(page-1)*maPageSize+i+1)).join(''));
            }
            renderMaPagination();
            MobileTableHelper.refresh('myAssignBody');
        },
        error: function(xhr) {
            $('#myAssignBody').html(`<tr><td colspan="9" class="text-center text-danger py-4">Lỗi kết nối (${xhr.status})</td></tr>`);
            MobileTableHelper.refresh('myAssignBody');
        }
    });
}

function renderMaPagination() {
    if (!maTotal) { $('#maCount').text(''); $('#maPagination').empty(); return; }
    const s=(maPage-1)*maPageSize+1, e=Math.min(maPage*maPageSize,maTotal);
    $('#maCount').html(`<span class="text-xs">${s}-${e} / <strong>${maTotal}</strong> lịch sắp</span>`);
    const $bar=$('#maPagination').empty();
    const mk=(label,p,disabled,active)=>{const li=$('<li class="page-item">').toggleClass('disabled',!!disabled).toggleClass('active',!!active);$('<a class="page-link">').html(label).on('click',()=>{if(!disabled&&!active)loadMyAssign(p);}).appendTo(li);return li;};
    $bar.append(mk('&lsaquo;',maPage-1,maPage<=1));
    let from=Math.max(1,maPage-2),to=Math.min(maTotalPages,maPage+2);
    for(let p=from;p<=to;p++) $bar.append(mk(p,p,false,p===maPage));
    $bar.append(mk('&rsaquo;',maPage+1,maPage>=maTotalPages));
}

