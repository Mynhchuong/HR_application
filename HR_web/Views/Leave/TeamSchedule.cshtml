            <div class="card">
                <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                    <div class="bg-gradient-primary shadow-primary border-radius-lg pt-3 pb-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <h6 class="text-white mb-0"><i class="bi bi-person-check me-1"></i> Lịch Nghỉ Tôi Đã Sắp</h6>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <select id="maStatusFilter" class="form-select form-select-sm" style="width:150px;height:30px;font-size:.8rem;" onchange="loadMyAssign(1)">
                                <option value="">Tất cả</option>
                                <option value="ASSIGNED">Chờ xác nhận</option>
