    const mk=(label,p,disabled,active)=>{const li=$('<li class="page-item">').toggleClass('disabled',!!disabled).toggleClass('active',!!active);$('<a class="page-link">').html(label).on('click',()=>{if(!disabled&&!active)loadMyAssign(p);}).appendTo(li);return li;};
    $bar.append(mk('&lsaquo;',maPage-1,maPage<=1));
