@{
    ViewData["Title"] = "Khoá đổi món ăn";
}

@section Styles {
<style>
    .ml-page { max-width: 1100px; margin: 0 auto; padding-bottom: 3rem; }
    .ml-hero {
        background: linear-gradient(135deg,#7c2d12 0%, #c2410c 50%, #f97316 100%);
        border-radius: 18px; padding: 1rem 1.25rem; margin-bottom: 1rem;
        color: #fff; display: flex; align-items: center; justify-content: space-between;
    }
    .ml-hero h5 { font-size: 1.05rem; font-weight: 800; margin: 0 0 .15rem; color: #fff !important; }
    .ml-hero small { font-size: .75rem; opacity: .85; }
    .ml-btn-new {
        background: white; color: #c2410c; border: none; border-radius: 10px;
        padding: .5rem .9rem; font-weight: 800; font-size: .85rem; cursor: pointer;
        display: inline-flex; align-items: center; gap: .25rem;
    }
    .ml-btn-new:hover { background: #fff7ed; }

    .ml-card { background: white; border-radius: 14px; box-shadow: 0 1px 4px rgba(0,0,0,.06); overflow: hidden; }
    .ml-table { width: 100%; border-collapse: collapse; }
    .ml-table th {
        padding: .7rem 1rem; font-size: .72rem; font-weight: 800; color: #64748b;
        text-transform: uppercase; letter-spacing: .04em; background: #f8fafc;
        border-bottom: 1px solid #f1f5f9; text-align: left;
    }
    .ml-table th.center { text-align: center; }
    .ml-table td { padding: .8rem 1rem; border-bottom: 1px solid #f8fafc; font-size: .85rem; vertical-align: middle; }
    .ml-table tr:last-child td { border-bottom: none; }
    .ml-table tr:hover td { background: #fff7ed; }

    .pill { font-size: .68rem; font-weight: 800; padding: 2px 9px; border-radius: 20px;
            text-transform: uppercase; white-space: nowrap; display: inline-block; }
    .pill-on  { background: #fee2e2; color: #b91c1c; }
    .pill-off { background: #f1f5f9; color: #94a3b8; }
    .pill-active   { background: #dcfce7; color: #166534; }
    .pill-inactive { background: #f1f5f9; color: #94a3b8; }

    .ml-edit-btn, .ml-del-btn {
        border-radius: 8px; padding: .25rem .55rem; font-size: .72rem; font-weight: 700;
        cursor: pointer; transition: all .12s; border: 1px solid; margin-right: .25rem;
    }
    .ml-edit-btn { background: #eff6ff; border-color: #bfdbfe; color: #1d4ed8; }
    .ml-edit-btn:hover { background: #1d4ed8; color: white; }
    .ml-del-btn  { background: #fef2f2; border-color: #fecaca; color: #dc2626; }
    .ml-del-btn:hover { background: #dc2626; color: white; }

    /* Modal */
    .ml-back { position: fixed; inset: 0; background: rgba(15,23,42,.55);
               display: none; align-items: center; justify-content: center; z-index: 1100; padding: 1rem; }
    .ml-back.show { display: flex; }
    .ml-sheet { background: white; border-radius: 16px; width: 100%; max-width: 540px;
                box-shadow: 0 14px 40px rgba(0,0,0,.2); overflow: hidden; }
    .ml-sheet-hd { padding: 1rem 1.25rem; color: white;
                   background: linear-gradient(135deg,#c2410c,#f97316);
                   display: flex; align-items: center; justify-content: space-between; }
    .ml-sheet-hd h5 { color: white; font-size: 1rem; font-weight: 800; margin: 0; }
    .ml-sheet-bd { padding: 1.1rem 1.25rem; }
    .ml-sheet-ft { padding: .8rem 1.25rem; background: #f8fafc; display: flex; justify-content: flex-end; gap: .5rem; }
    .ml-close { background: transparent; border: none; color: white; font-size: 1.4rem; cursor: pointer; line-height: 1; }
    .ml-form-row { margin-bottom: .8rem; }
    .ml-form-row label { display: block; font-size: .72rem; font-weight: 700; color: #475569;
                         margin-bottom: .25rem; text-transform: uppercase; letter-spacing: .03em; }
    .ml-form-row input[type=text], .ml-form-row input[type=date], .ml-form-row input[type=time],
    .ml-form-row input[type=datetime-local], .ml-form-row textarea {
        width: 100%; border: 1.5px solid #e2e8f0; border-radius: 10px;
        padding: .5rem .75rem; font-size: .9rem; outline: none; font-family: inherit;
    }
    .ml-form-row input:focus, .ml-form-row textarea:focus { border-color: #c2410c; }
    .ml-checkbox-row { display: flex; gap: 1rem; padding: .35rem 0; }
    .ml-checkbox-row label { display: flex; align-items: center; gap: .35rem; font-weight: 600; color: #1e293b; font-size: .88rem; cursor: pointer; }
    .ml-empty, .ml-loading { padding: 3rem 1rem; text-align: center; color: #94a3b8; }
</style>
}

<div class="ml-page px-2 py-2">
    <div class="ml-hero">
        <div>
            <h5><span class="material-symbols-rounded me-1" style="vertical-align:middle">lock</span>Khoá đổi món ăn</h5>
            <small>Cấu hình ngày & giờ chốt, không cho NV đổi món sau thời điểm chốt</small>
        </div>
        <button class="ml-btn-new" onclick="openEdit(0)">
            <span class="material-symbols-rounded">add</span>Tạo rule
        </button>
    </div>

    <div class="ml-card">
        <table class="ml-table">
            <thead>
                <tr>
                    <th>Ngày khoá</th>
                    <th class="center" style="width:80px">Trưa</th>
                    <th class="center" style="width:80px">Tăng ca</th>
                    <th class="center" style="width:130px">Loại bị khoá</th>
                    <th>Thời điểm chốt</th>
                    <th>Ghi chú</th>
                    <th class="center" style="width:90px">Trạng thái</th>
                    <th class="center" style="width:170px">Hành động</th>
                </tr>
            </thead>
            <tbody id="mlBody">
                <tr><td colspan="8" class="ml-loading"><div class="spinner-border text-warning" role="status"></div></td></tr>
            </tbody>
        </table>
    </div>
</div>

@Html.AntiForgeryToken()

<!-- Modal create/edit -->
<div class="ml-back" id="mlBack" onclick="if(event.target===this)closeEdit()">
    <div class="ml-sheet">
        <div class="ml-sheet-hd">
            <h5 id="mlTitle">Tạo rule khoá đổi món</h5>
            <button class="ml-close" onclick="closeEdit()">×</button>
        </div>
        <div class="ml-sheet-bd">
            <input type="hidden" id="fId" value="0" />
            <div class="ml-form-row">
                <label>Khoá đổi món CHO NGÀY NÀO? *</label>
                <input type="date" id="fLockDate" />
            </div>
            <div class="ml-form-row">
                <label>Phạm vi bữa ăn *</label>
                <div class="ml-checkbox-row">
                    <label><input type="checkbox" id="fLunch" /> Khoá đổi món TRƯA</label>
                    <label><input type="checkbox" id="fOt" /> Khoá đổi món TĂNG CA</label>
                </div>
            </div>
            <div class="ml-form-row">
                <label>Khoá đổi sang loại món (để trống = khoá mọi loại)</label>
                <div class="ml-checkbox-row">
                    <label><input type="checkbox" id="fMan"  /> 🍖 Mặn</label>
                    <label><input type="checkbox" id="fNhe"  /> 🥗 Nhẹ</label>
                    <label><input type="checkbox" id="fChay" /> 🥦 Chay</label>
                </div>
                <small class="text-secondary" style="font-size:.72rem">Tick để chặn NV đổi sang loại đó. Bỏ trống cả 3 = khoá mọi loại.</small>
            </div>
            <div class="ml-form-row">
                <label>Thời điểm chốt (cutoff) *</label>
                <input type="datetime-local" id="fCutoff" required />
            </div>
            <div class="ml-form-row">
                <label>Ghi chú *</label>
                <textarea id="fNote" rows="2" placeholder="VD: Thực đơn đặc biệt 25K, chỉ 2 món"></textarea>
            </div>
            <div class="ml-form-row">
                <label>Trạng thái</label>
                <div class="ml-checkbox-row">
                    <label><input type="checkbox" id="fActive" checked /> Đang hoạt động</label>
                </div>
            </div>
        </div>
        <div class="ml-sheet-ft">
            <button class="btn btn-light btn-sm" onclick="closeEdit()">Huỷ</button>
            <button class="btn btn-warning btn-sm" id="btnSave" onclick="saveRule()">
                <span class="material-symbols-rounded" style="font-size:1rem;vertical-align:middle">save</span> Lưu
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
const LIST_URL   = '@Url.Action("List","MealLock")';
const SAVE_URL   = '@Url.Action("Save","MealLock")';
const DELETE_URL = '@Url.Action("Delete","MealLock")';
const TOKEN      = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

function esc(s){ return (s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

function fmtDate(ds){
    if(!ds) return '—';
    const d = new Date(ds);
    return d.toLocaleDateString('vi-VN');
}
function fmtDateTime(ds){
    if(!ds) return '<span class="text-muted">— (khoá luôn)</span>';
    const d = new Date(ds);
    return d.toLocaleDateString('vi-VN') + ' ' + d.toLocaleTimeString('vi-VN').slice(0,5);
}
function toLocalDtInput(iso){
    if(!iso) return '';
    const d = new Date(iso);
    const pad = n => n.toString().padStart(2,'0');
    return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
}
function toLocalDateInput(iso){
    if(!iso) return '';
    const d = new Date(iso);
    const pad = n => n.toString().padStart(2,'0');
    return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`;
}

let dataCache = [];

async function load(){
    document.getElementById('mlBody').innerHTML =
        '<tr><td colspan="7" class="ml-loading"><div class="spinner-border text-warning" role="status"></div></td></tr>';
    try {
        const res  = await fetch(LIST_URL);
        const data = await res.json();
        if (!data.success) {
            document.getElementById('mlBody').innerHTML = `<tr><td colspan="7" class="ml-empty">Lỗi: ${esc(data.message||'')}</td></tr>`;
            return;
        }
        dataCache = data.data || [];
        if (dataCache.length === 0) {
            document.getElementById('mlBody').innerHTML =
                '<tr><td colspan="8" class="ml-empty"><span class="material-symbols-rounded" style="font-size:2.5rem;color:#fdba74;display:block">lock_open</span>Chưa có rule nào</td></tr>';
            return;
        }
        document.getElementById('mlBody').innerHTML = dataCache.map(r => {
            const typeChips = [];
            if (r.lockMan)  typeChips.push('<span class="pill pill-on" style="background:#fee2e2;color:#b91c1c">🍖 MẶN</span>');
            if (r.lockNhe)  typeChips.push('<span class="pill pill-on" style="background:#dbeafe;color:#1d4ed8">🥗 NHẸ</span>');
            if (r.lockChay) typeChips.push('<span class="pill pill-on" style="background:#dcfce7;color:#166534">🥦 CHAY</span>');
            const typesHtml = typeChips.length ? typeChips.join(' ')
                : '<span class="text-muted small">Mọi loại</span>';
            return `
            <tr>
                <td><strong>${fmtDate(r.lockDate)}</strong></td>
                <td class="text-center"><span class="pill ${r.lockLunch?'pill-on':'pill-off'}">${r.lockLunch?'KHOÁ':'—'}</span></td>
                <td class="text-center"><span class="pill ${r.lockOt?'pill-on':'pill-off'}">${r.lockOt?'KHOÁ':'—'}</span></td>
                <td class="text-center" style="line-height:1.8">${typesHtml}</td>
                <td>${fmtDateTime(r.cutoffDt)}</td>
                <td class="text-muted small vni-font" style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(r.note||'')}</td>
                <td class="text-center"><span class="pill ${r.isActive?'pill-active':'pill-inactive'}">${r.isActive?'BẬT':'TẮT'}</span></td>
                <td class="text-center">
                    <button class="ml-edit-btn" onclick="openEdit(${r.id})">✏️ Sửa</button>
                    <button class="ml-del-btn" onclick="deleteRule(${r.id})">🗑 Xoá</button>
                </td>
            </tr>`;
        }).join('');
    } catch {
        document.getElementById('mlBody').innerHTML = '<tr><td colspan="8" class="ml-empty">Lỗi kết nối</td></tr>';
    }
}

function openEdit(id){
    const r = id ? dataCache.find(x => x.id === id) : null;
    document.getElementById('fId').value          = id;
    document.getElementById('fLockDate').value    = r ? toLocalDateInput(r.lockDate) : '';
    document.getElementById('fLunch').checked     = r ? !!r.lockLunch : true;
    document.getElementById('fOt').checked        = r ? !!r.lockOt    : true;
    document.getElementById('fMan').checked       = r ? !!r.lockMan   : false;
    document.getElementById('fNhe').checked       = r ? !!r.lockNhe   : false;
    document.getElementById('fChay').checked      = r ? !!r.lockChay  : false;
    document.getElementById('fCutoff').value      = r ? toLocalDtInput(r.cutoffDt) : '';
    document.getElementById('fNote').value        = r?.note ?? '';
    document.getElementById('fActive').checked    = r ? !!r.isActive : true;
    document.getElementById('mlTitle').textContent = id ? 'Sửa rule khoá đổi món' : 'Tạo rule khoá đổi món';
    document.getElementById('mlBack').classList.add('show');
}
function closeEdit(){ document.getElementById('mlBack').classList.remove('show'); }

async function saveRule(){
    const lockDate = document.getElementById('fLockDate').value;
    if (!lockDate) { showToast('Vui lòng chọn ngày áp luật', 'warning'); return; }
    const lockLunch = document.getElementById('fLunch').checked;
    const lockOt    = document.getElementById('fOt').checked;
    if (!lockLunch && !lockOt) { showToast('Chọn ít nhất 1 phạm vi (Trưa hoặc Tăng ca)', 'warning'); return; }

    const cutoffVal = document.getElementById('fCutoff').value;
    if (!cutoffVal) { showToast('Vui lòng nhập thời điểm chốt', 'warning'); return; }

    const noteVal = document.getElementById('fNote').value.trim();
    if (!noteVal) { showToast('Vui lòng nhập ghi chú', 'warning'); return; }

    const payload = {
        id:        parseInt(document.getElementById('fId').value, 10) || 0,
        lockDate,
        lockLunch,
        lockOt,
        lockMan:   document.getElementById('fMan').checked,
        lockNhe:   document.getElementById('fNhe').checked,
        lockChay:  document.getElementById('fChay').checked,
        cutoffDt:  cutoffVal,
        note:      noteVal,
        isActive:  document.getElementById('fActive').checked
    };
    const btn = document.getElementById('btnSave');
    btn.disabled = true;
    try {
        const res  = await fetch(SAVE_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN },
            body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (!data.success) { showToast(data.message || 'Lưu thất bại', 'error'); return; }
        showToast(data.message || 'Đã lưu', 'success');
        closeEdit();
        load();
    } catch { showToast('Lỗi kết nối', 'error'); }
    finally { btn.disabled = false; }
}

function deleteRule(id){
    showConfirm('Xoá rule này? Sau khi xoá NV có thể đổi món lại bình thường vào ngày đã set.', async () => {
        try {
            const res = await fetch(DELETE_URL, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN },
                body: JSON.stringify({ id })
            });
            const data = await res.json();
            if (!data.success) { showToast(data.message || 'Không xoá được', 'error'); return; }
            showToast('Đã xoá', 'success');
            load();
        } catch { showToast('Lỗi kết nối', 'error'); }
    }, { title: 'Xoá rule', okText: 'Xoá', okClass: 'btn-danger', icon: 'delete', iconColor: '#dc2626', iconBg: '#fee2e2' });
}

load();
</script>
}
