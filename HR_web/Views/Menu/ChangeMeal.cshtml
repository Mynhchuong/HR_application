@model HR_web.Models.Menu.ChangeMealViewModel
@{
    ViewData["Title"] = "Đổi món ăn";
}

<style>
    :root { --fr: #c00000; --frd: #8b0000; }

    .cm-page { max-width: 520px; margin: 0 auto; padding-bottom: 5rem; }

    /* Hero */
    .cm-hero {
        background: linear-gradient(135deg, var(--frd) 0%, var(--fr) 100%);
        border-radius: 18px; padding: 1rem 1.25rem; margin-bottom: 1rem;
        color: #fff;
    }
    .cm-hero h5    { font-size: 1.05rem; font-weight: 800; margin: 0 0 .2rem; }
    .cm-hero small { font-size: .78rem; opacity: .85; }

    /* Section header */
    .cm-section {
        background: white; border-radius: 14px;
        box-shadow: 0 2px 8px rgba(0,0,0,.07);
        margin-bottom: .875rem; overflow: hidden;
    }
    .cm-section-title {
        padding: .6rem 1rem; font-size: .72rem; font-weight: 800;
        color: #64748b; text-transform: uppercase; letter-spacing: .06em;
        border-bottom: 1px solid #f1f5f9; background: #fafafa;
    }
    .cm-section-body { padding: .875rem 1rem; }

    /* Meal type buttons */
    .cm-meal-btns { display: flex; gap: .5rem; flex-wrap: wrap; }
    .cm-meal-btn {
        flex: 1; min-width: 80px; padding: .65rem .5rem;
        border-radius: 12px; border: 2px solid #e2e8f0;
        background: white; font-size: .88rem; font-weight: 700;
        color: #475569; cursor: pointer; text-align: center;
        transition: all .15s; -webkit-tap-highlight-color: transparent;
    }
    .cm-meal-btn:active { opacity: .75; transform: scale(.97); }
    .cm-meal-btn.man  { border-color: #f97316; color: #f97316; }
    .cm-meal-btn.nhe  { border-color: #0ea5e9; color: #0ea5e9; }
    .cm-meal-btn.chay { border-color: #22c55e; color: #22c55e; }
    .cm-meal-btn.man:hover  { background: #fff7ed; }
    .cm-meal-btn.nhe:hover  { background: #f0f9ff; }

    /* Date picker for meal change */
    .cm-pick-date {
        display: flex; align-items: center; gap: .5rem;
        margin-bottom: .75rem;
        background: #fff8f8; border: 1.5px solid #fca5a5;
        border-radius: 10px; padding: .5rem .75rem;
    }
    .cm-pick-date label { font-size: .72rem; font-weight: 700; color: #94a3b8; white-space: nowrap; }
    .cm-pick-date input[type=date] {
        flex: 1; border: none; background: transparent;
        font-size: .88rem; font-weight: 700; color: #c00000;
        outline: none; cursor: pointer;
    }
    .cm-meal-btn.chay:hover { background: #f0fdf4; }

    /* Special buttons */
    .cm-special-btns { display: flex; gap: .5rem; }
    .cm-special-btn {
        flex: 1; padding: .7rem .5rem;
        border-radius: 12px; border: 2px solid #a855f7;
        background: white; font-size: .86rem; font-weight: 700;
        color: #a855f7; cursor: pointer; text-align: center;
        transition: all .15s; -webkit-tap-highlight-color: transparent;
    }
    .cm-special-btn.nhe { border-color: #0ea5e9; color: #0ea5e9; }
    .cm-special-btn.active { background: #a855f7; color: white; }
    .cm-special-btn.nhe.active { background: #0ea5e9; color: white; }
    .cm-special-btn:active { opacity: .75; transform: scale(.97); }

    /* Date range section */
    .cm-date-section {
        display: none; margin-top: .875rem;
        background: #faf5ff; border: 1.5px solid #e9d5ff;
        border-radius: 12px; padding: .875rem 1rem;
    }
    .cm-date-section.nhe-mode {
        background: #f0f9ff; border-color: #bae6fd;
    }
    .cm-date-section.show { display: block; }
    .cm-date-row { display: flex; gap: .5rem; margin-bottom: .6rem; }
    .cm-date-field { flex: 1; }
    .cm-date-field label { font-size: .7rem; font-weight: 700; color: #64748b; display: block; margin-bottom: .25rem; }
    .cm-date-field input[type=date] {
        width: 100%; padding: .5rem .6rem; border-radius: 8px;
        border: 1.5px solid #e2e8f0; font-size: .85rem; font-weight: 600;
        color: #1e293b; outline: none;
    }
    .cm-date-field input[type=date]:focus { border-color: #a855f7; }

    /* Confirm button */
    .cm-confirm-btn {
        width: 100%; padding: .7rem; border-radius: 12px;
        background: var(--fr); color: white; border: none;
        font-size: .9rem; font-weight: 800; cursor: pointer;
        transition: opacity .15s;
    }
    .cm-confirm-btn:active { opacity: .8; }
    .cm-confirm-btn:disabled { background: #94a3b8; cursor: not-allowed; }

    /* Back button */
    .cm-back {
        display: inline-flex; align-items: center; gap: .45rem;
        font-size: .88rem; font-weight: 700; color: #475569;
        text-decoration: none; margin-bottom: .85rem;
        background: white; border: 1.5px solid #e2e8f0;
        border-radius: 50px; padding: .5rem 1rem;
        box-shadow: 0 1px 4px rgba(0,0,0,.06);
        transition: background .15s, box-shadow .15s;
        -webkit-tap-highlight-color: transparent;
    }
    .cm-back:hover { background: #f8fafc; box-shadow: 0 2px 8px rgba(0,0,0,.1); color: #1e293b; }
    .cm-back:active { opacity: .8; }

</style>

<div class="cm-page px-2 py-2">

    <a href="@Url.Action("Today")" class="cm-back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        Quay lại thực đơn
    </a>

    <div class="cm-hero">
        <h5>🔄 Đổi món ăn</h5>
        <small>@Model.FullName — @DateTime.Today.ToString("dd/MM/yyyy")</small>
    </div>

    <!-- Đổi sang loại khác ngày mai -->
    <div class="cm-section">
        <div class="cm-section-title">Đổi sang loại khác — <strong id="mealDateLabel">ngày mai</strong></div>
        <div class="cm-section-body">
            <div class="cm-pick-date">
                <label>📅 Ngày đổi</label>
                <input type="date" id="mealDate" onchange="onMealDateChange()" />
            </div>
            <div class="cm-meal-btns">
                @if (Model.CurrentFoodType != "MAN")
                {
                    <button class="cm-meal-btn man" onclick="submitMeal('MAN','Mặn')">🍖 Mặn</button>
                }
                @if (Model.CurrentFoodType != "NHE")
                {
                    <button class="cm-meal-btn nhe" onclick="submitMeal('NHE','Nhẹ')">🥗 Nhẹ</button>
                }
                @if (Model.CurrentFoodType != "CHAY")
                {
                    <button class="cm-meal-btn chay" onclick="submitMeal('CHAY','Chay')">🥦 Chay</button>
                }
            </div>
            @if (Model.CurrentFoodType is "MAN" or "NHE" or "CHAY")
            {
                <p style="font-size:.75rem;color:#94a3b8;margin:.6rem 0 0;text-align:center;">
                    Nút món hiện tại đã ẩn — chọn để đổi sang loại khác
                </p>
            }
        </div>
    </div>

    <!-- Đăng ký dài hạn -->
    <div class="cm-section">
        <div class="cm-section-title">Đăng ký dài hạn</div>
        <div class="cm-section-body">
            <div class="cm-special-btns">
                <button class="cm-special-btn" id="btnChayTruong" onclick="toggleSpecial('CHAY_TRUONG')">
                    <img src="@Url.Content("~/assets/img/icons/chaytruong.png")" style="height:2rem;vertical-align:middle;margin-right:.35rem;" alt="" />Chay trường
                </button>
                <button class="cm-special-btn nhe" id="btnNheTruong" onclick="toggleSpecial('NHE_TRUONG')">🥗 Món nhẹ</button>
            </div>

            <div class="cm-date-section" id="dateSection">
                <div class="cm-date-row">
                    <div class="cm-date-field">
                        <label>Từ ngày</label>
                        <input type="date" id="fromDate" />
                    </div>
                    <div class="cm-date-field">
                        <label>Đến ngày</label>
                        <input type="date" id="toDate" />
                    </div>
                </div>
                <button class="cm-confirm-btn" onclick="submitSpecial()">Xác nhận đăng ký</button>
            </div>
        </div>
    </div>

</div>

@Html.AntiForgeryToken()

<script>
const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
let selectedSpecial = '';

// ── Init meal date picker ────────────────────────────────────────────────────
(function initMealDate() {
    const inp = document.getElementById('mealDate');
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    const tStr = tomorrow.toISOString().split('T')[0];
    inp.min   = tStr;   // today + future blocked
    inp.value = tStr;   // default = tomorrow
})();

function onMealDateChange() {
    const inp   = document.getElementById('mealDate');
    const label = document.getElementById('mealDateLabel');
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    const tStr = tomorrow.toISOString().split('T')[0];
    label.textContent = inp.value === tStr ? 'ngày mai' : inp.value.split('-').reverse().join('/');
}

function _doFetch(body) {
    fetch('@Url.Action("ChangeMealSubmit")', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
        body: JSON.stringify(body)
    })
    .then(r => r.json())
    .then(d => {
        window.showToast(d.message, d.success ? 'success' : 'error');
        if (d.success) setTimeout(() => location.href = '@Url.Action("Today")', 1500);
    })
    .catch(() => window.showToast('Lỗi kết nối, vui lòng thử lại', 'error'));
}

function submitMeal(type, label) {
    const dateStr = document.getElementById('mealDate').value;
    const [y, m, d] = dateStr.split('-');
    const dateLabel = `${d}/${m}/${y}`;
    window.showConfirm(
        `Xác nhận đổi sang món ${label} ngày ${dateLabel}?`,
        () => _doFetch({ mealType: type, fromDate: dateStr, toDate: dateStr }),
        { title: 'Đổi món ăn', okText: 'Xác nhận', okClass: 'btn-danger',
          icon: 'restaurant', iconColor: '#c00000', iconBg: '#ffe4e4' }
    );
}

function toggleSpecial(type) {
    const ds   = document.getElementById('dateSection');
    const btnC = document.getElementById('btnChayTruong');
    const btnN = document.getElementById('btnNheTruong');

    if (selectedSpecial === type) {
        selectedSpecial = '';
        ds.classList.remove('show', 'nhe-mode');
        btnC.classList.remove('active');
        btnN.classList.remove('active');
        return;
    }

    selectedSpecial = type;
    btnC.classList.toggle('active', type === 'CHAY_TRUONG');
    btnN.classList.toggle('active', type === 'NHE_TRUONG');
    ds.classList.add('show');
    ds.classList.toggle('nhe-mode', type === 'NHE_TRUONG');

    const today = new Date().toISOString().split('T')[0];
    if (!document.getElementById('fromDate').value) document.getElementById('fromDate').value = today;
}

function submitSpecial() {
    const from  = document.getElementById('fromDate').value;
    const to    = document.getElementById('toDate').value;
    if (!from || !to) { window.showToast('Vui lòng chọn đủ ngày bắt đầu và kết thúc', 'warning'); return; }
    if (from > to)    { window.showToast('Ngày bắt đầu không được sau ngày kết thúc', 'warning'); return; }

    const label = selectedSpecial === 'CHAY_TRUONG' ? 'Chay trường' : 'Món nhẹ';
    window.showConfirm(
        `Xác nhận đăng ký ${label} từ ${from} đến ${to}?`,
        () => _doFetch({ mealType: selectedSpecial, fromDate: from, toDate: to }),
        { title: 'Đăng ký dài hạn', okText: 'Đăng ký', okClass: 'btn-success',
          icon: 'event_available', iconColor: '#16a34a', iconBg: '#dcfce7' }
    );
}
</script>
