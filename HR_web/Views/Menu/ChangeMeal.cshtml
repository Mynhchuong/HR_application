@model HR_web.Models.Menu.ChangeMealViewModel
@{
    ViewData["Title"] = "Đổi món ăn";
}

<style>
    :root { --fr: #c00000; --frd: #8b0000; }

    .cm-page { max-width: 520px; margin: 0 auto; padding-bottom: 5rem; }

    /* Hero */
    .cm-hero {
        background: linear-gradient(135deg, var(--frd) 0%, var(--fr) 100%);
        border-radius: 18px; padding: 1rem 1.25rem; margin-bottom: 1rem;
        color: #fff;
    }
    .cm-hero h5    { font-size: 1.05rem; font-weight: 800; margin: 0 0 .2rem; }
    .cm-hero small { font-size: .78rem; opacity: .85; }

    /* Section header */
    .cm-section {
        border-radius: 14px;
        box-shadow: 0 2px 8px rgba(0,0,0,.07);
        margin-bottom: .875rem; overflow: hidden;
    }
    .cm-section-title {
        padding: .65rem 1rem; font-size: .8rem; font-weight: 800;
        text-transform: uppercase; letter-spacing: .05em;
        display: flex; align-items: center; gap: .5rem;
    }
    .cm-section-title.lunch {
        background: #1F4E79; color: #fff;
    }
    .cm-section-title.ot {
        background: #375623; color: #fff;
    }
    .cm-section-title .badge-shift {
        font-size: .65rem; font-weight: 900; padding: 2px 8px;
        border-radius: 20px; letter-spacing: .04em;
        background: rgba(255,255,255,.22); color: #fff;
    }
    .cm-section-body { padding: .875rem 1rem; background: white; }

    /* Meal type buttons */
    .cm-meal-btns { display: flex; gap: .5rem; flex-wrap: wrap; }
    .cm-meal-btn {
        flex: 1; min-width: 80px; padding: .65rem .5rem;
        border-radius: 12px; border: 2px solid #e2e8f0;
        background: white; font-size: .88rem; font-weight: 700;
        color: #475569; cursor: pointer; text-align: center;
        transition: all .15s; -webkit-tap-highlight-color: transparent;
    }
    .cm-meal-btn:active { opacity: .75; transform: scale(.97); }
    .cm-meal-btn.man  { border-color: #f97316; color: #f97316; }
    .cm-meal-btn.nhe  { border-color: #0ea5e9; color: #0ea5e9; }
    .cm-meal-btn.chay { border-color: #22c55e; color: #22c55e; }
    .cm-meal-btn.man:hover  { background: #fff7ed; }
    .cm-meal-btn.nhe:hover  { background: #f0f9ff; }

    /* Date picker for meal change */
    .cm-pick-date {
        display: flex; align-items: center; gap: .5rem;
        margin-bottom: .75rem;
        background: #fff8f8; border: 1.5px solid #fca5a5;
        border-radius: 10px; padding: .5rem .75rem;
    }
    .cm-pick-date label { font-size: .72rem; font-weight: 700; color: #94a3b8; white-space: nowrap; }
    .cm-pick-date input[type=date] {
        flex: 1; border: none; background: transparent;
        font-size: .88rem; font-weight: 700; color: #c00000;
        outline: none; cursor: pointer;
    }
    .cm-meal-btn.chay:hover { background: #f0fdf4; }

    /* Special buttons */
    .cm-special-btns { display: flex; gap: .5rem; }
    .cm-special-btn {
        flex: 1; padding: .7rem .5rem;
        border-radius: 12px; border: 2px solid #a855f7;
        background: white; font-size: .86rem; font-weight: 700;
        color: #a855f7; cursor: pointer; text-align: center;
        transition: all .15s; -webkit-tap-highlight-color: transparent;
    }
    .cm-special-btn.nhe { border-color: #0ea5e9; color: #0ea5e9; }
    .cm-special-btn.active { background: #a855f7; color: white; }
    .cm-special-btn.nhe.active { background: #0ea5e9; color: white; }
    .cm-special-btn:active { opacity: .75; transform: scale(.97); }

    /* Date range section */
    .cm-date-section {
        display: none; margin-top: .875rem;
        background: #faf5ff; border: 1.5px solid #e9d5ff;
        border-radius: 12px; padding: .875rem 1rem;
    }
    .cm-date-section.nhe-mode {
        background: #f0f9ff; border-color: #bae6fd;
    }
    .cm-date-section.show { display: block; }
    .cm-date-row { display: flex; gap: .5rem; margin-bottom: .6rem; }
    .cm-date-field { flex: 1; }
    .cm-date-field label { font-size: .7rem; font-weight: 700; color: #64748b; display: block; margin-bottom: .25rem; }
    .cm-date-field input[type=date] {
        width: 100%; padding: .5rem .6rem; border-radius: 8px;
        border: 1.5px solid #e2e8f0; font-size: .85rem; font-weight: 600;
        color: #1e293b; outline: none;
    }
    .cm-date-field input[type=date]:focus { border-color: #a855f7; }

    /* Confirm button */
    .cm-confirm-btn {
        width: 100%; padding: .7rem; border-radius: 12px;
        background: var(--fr); color: white; border: none;
        font-size: .9rem; font-weight: 800; cursor: pointer;
        transition: opacity .15s;
    }
    .cm-confirm-btn:active { opacity: .8; }
    .cm-confirm-btn:disabled { background: #94a3b8; cursor: not-allowed; }

    /* Back button */
    .cm-back {
        display: inline-flex; align-items: center; gap: .45rem;
        font-size: .88rem; font-weight: 700; color: #475569;
        text-decoration: none; margin-bottom: .85rem;
        background: white; border: 1.5px solid #e2e8f0;
        border-radius: 50px; padding: .5rem 1rem;
        box-shadow: 0 1px 4px rgba(0,0,0,.06);
        transition: background .15s, box-shadow .15s;
        -webkit-tap-highlight-color: transparent;
    }
    .cm-back:hover { background: #f8fafc; box-shadow: 0 2px 8px rgba(0,0,0,.1); color: #1e293b; }
    .cm-back:active { opacity: .8; }

</style>

<div class="cm-page px-2 py-2">

    <a href="@Url.Action("Today")" class="cm-back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        Quay lại thực đơn
    </a>

    <div class="cm-hero">
        <h5>🔄 Đổi món ăn</h5>
        <small><span class="vni-font">@Model.FullName</span> — @DateTime.Today.ToString("dd/MM/yyyy")</small>
    </div>

    <div style="background:#fffbeb;border:1.5px solid #fde68a;border-radius:10px;padding:.55rem .85rem;font-size:.78rem;color:#92400e;margin-bottom:.75rem;line-height:1.5;">
        <b>⚠️ Lưu ý:</b> Đổi món ăn phải thực hiện <b>trước ít nhất 1 ngày</b> — không thể đổi cho ngày hôm nay.
    </div>

    <!-- Đổi món bữa ăn ca (LUNCH) -->
    <div class="cm-section">
        <div class="cm-section-title lunch">
            🍱 Bữa ăn chính
            <span class="badge-shift">Mọi ca</span>
            <span style="font-weight:400;opacity:.85;margin-left:auto;font-size:.7rem;">— <span id="mealDateLabel">ngày mai</span></span>
        </div>
        <div class="cm-section-body">
            <div class="cm-pick-date">
                <label>📅 Ngày đổi</label>
                <input type="date" id="mealDate" onchange="onMealDateChange()" />
            </div>
            <div id="currentMealBadge" style="text-align:center;margin-bottom:.6rem;font-size:.8rem;color:#64748b;min-height:1.4rem;"></div>
            <div class="cm-meal-btns">
                <button class="cm-meal-btn man"  id="btnMAN"  onclick="submitMeal('MAN','Mặn','LUNCH')">🍖 Mặn</button>
                <button class="cm-meal-btn nhe"  id="btnNHE"  onclick="submitMeal('NHE','Nhẹ','LUNCH')">🥗 Nhẹ</button>
                <button class="cm-meal-btn chay" id="btnCHAY" onclick="submitMeal('CHAY','Chay','LUNCH')">🥦 Chay</button>
            </div>
            <p id="currentMealHint" style="font-size:.75rem;color:#94a3b8;margin:.6rem 0 0;text-align:center;display:none;">
                Nút món hiện tại đã ẩn — chọn để đổi sang loại khác
            </p>
        </div>
    </div>

    <!-- Đổi món tăng ca (OT) -->
    <div class="cm-section">
        <div class="cm-section-title ot">
            ⏰ Bữa tăng ca (OT)
            <span class="badge-shift">OT</span>
            <span style="font-weight:400;opacity:.85;margin-left:auto;font-size:.7rem;">— <span id="otDateLabel">ngày mai</span></span>
        </div>
        <div class="cm-section-body">
            <div style="font-size:.72rem;color:#94a3b8;margin-bottom:.5rem;">Mục này chỉ áp dụng nếu bạn có đăng ký tăng ca ngày này — không liên quan đến ca làm việc chính.</div>
            <div class="cm-pick-date">
                <label>📅 Ngày đổi</label>
                <input type="date" id="otDate" onchange="onOtDateChange()" />
            </div>
            <div id="currentOtBadge" style="text-align:center;margin-bottom:.6rem;font-size:.8rem;color:#64748b;min-height:1.4rem;"></div>
            <div class="cm-meal-btns">
                <button class="cm-meal-btn man"  id="otBtnMAN"  onclick="submitMeal('MAN','Mặn','OT')">🍖 Mặn</button>
                <button class="cm-meal-btn nhe"  id="otBtnNHE"  onclick="submitMeal('NHE','Nhẹ','OT')">🥗 Nhẹ</button>
                <button class="cm-meal-btn chay" id="otBtnCHAY" onclick="submitMeal('CHAY','Chay','OT')">🥦 Chay</button>
            </div>
            <p id="otMealHint" style="font-size:.75rem;color:#94a3b8;margin:.6rem 0 0;text-align:center;display:none;">
                Nút món hiện tại đã ẩn — chọn để đổi sang loại khác
            </p>
        </div>
    </div>

    <!-- Đăng ký dài hạn -->
    <div class="cm-section">
        <div class="cm-section-title">Đăng ký dài hạn</div>
        <div class="cm-section-body">
            <div class="cm-special-btns">
                <button class="cm-special-btn" id="btnChayTruong" onclick="toggleSpecial('CHAY_TRUONG')">
                    <img src="@Url.Content("~/assets/img/icons/chaytruong.png")" style="height:2rem;vertical-align:middle;margin-right:.35rem;" alt="" />Chay trường
                </button>
                <button class="cm-special-btn nhe" id="btnNheTruong" onclick="toggleSpecial('NHE_TRUONG')">🥗 Món nhẹ</button>
            </div>

            <div class="cm-date-section" id="dateSection">
                <div class="cm-date-row">
                    <div class="cm-date-field">
                        <label>Từ ngày</label>
                        <input type="date" id="fromDate" />
                    </div>
                    <div class="cm-date-field">
                        <label>Đến ngày</label>
                        <input type="date" id="toDate" />
                    </div>
                </div>
                <button class="cm-confirm-btn" onclick="submitSpecial()">Xác nhận đăng ký</button>
            </div>
        </div>
    </div>

</div>

@Html.AntiForgeryToken()

<script>
const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
const MEAL_URL = '@Url.Action("GetMealForDate", "Menu")';
let selectedSpecial = '';

const MEAL_INFO = {
    MAN:  { label: '🍖 Đang ăn Mặn',  color: '#f97316' },
    NHE:  { label: '🥗 Đang ăn Nhẹ',  color: '#0ea5e9' },
    CHAY: { label: '🥦 Đang ăn Chay', color: '#22c55e' },
};

function updateMealButtons(currentType) {
    ['MAN', 'NHE', 'CHAY'].forEach(t => {
        document.getElementById('btn' + t).style.display = t === currentType ? 'none' : '';
    });
    const badge = document.getElementById('currentMealBadge');
    const info  = MEAL_INFO[currentType];
    badge.innerHTML = info
        ? `<span style="background:${info.color}18;color:${info.color};padding:.25rem .75rem;border-radius:50px;font-weight:700;">${info.label}</span>`
        : '';
    document.getElementById('currentMealHint').style.display = info ? '' : 'none';
}

function updateOtButtons(currentType) {
    ['MAN', 'NHE', 'CHAY'].forEach(t => {
        document.getElementById('otBtn' + t).style.display = t === currentType ? 'none' : '';
    });
    const badge = document.getElementById('currentOtBadge');
    const info  = MEAL_INFO[currentType];
    badge.innerHTML = info
        ? `<span style="background:${info.color}18;color:${info.color};padding:.25rem .75rem;border-radius:50px;font-weight:700;">${info.label}</span>`
        : '';
    document.getElementById('otMealHint').style.display = info ? '' : 'none';
}

// ── Init meal date pickers ───────────────────────────────────────────────────
function getTomorrowStr() {
    const t = new Date();
    t.setDate(t.getDate() + 1);
    return t.toISOString().split('T')[0];
}

(function initMealDate() {
    const inp = document.getElementById('mealDate');
    const tStr = getTomorrowStr();
    inp.min   = tStr;
    inp.value = tStr;
    onMealDateChange();
})();

(function initOtDate() {
    const inp = document.getElementById('otDate');
    const tStr = getTomorrowStr();
    inp.min   = tStr;
    inp.value = tStr;
    onOtDateChange();
})();

const LOCK_CHECK_URL = '@Url.Action("Check","MealLock")';
const lockState = { LUNCH: { locked: false, msg: '' }, OT: { locked: false, msg: '' } };

async function checkLock(date, typeMeal){
    try {
        const r = await fetch(`${LOCK_CHECK_URL}?date=${date}&typeMeal=${typeMeal}`);
        const d = await r.json();
        if (!d.success) return { locked: false };
        return d;
    } catch { return { locked: false }; }
}

function isSameWeek(isoDate){
    if (!isoDate) return true;
    const tgt = new Date(isoDate);
    const now = new Date();
    const startOfWeek = (d) => {
        const dt = new Date(d);
        const day = dt.getDay();
        const off = day === 0 ? -6 : 1 - day;
        dt.setDate(dt.getDate() + off);
        dt.setHours(0,0,0,0);
        return dt.getTime();
    };
    return startOfWeek(tgt) === startOfWeek(now);
}

function applyLockUI(typeMeal, lockInfo, targetDate){
    const prefix  = typeMeal === 'OT' ? 'otBtn' : 'btn';
    const badgeId = typeMeal === 'OT' ? 'currentOtBadge' : 'currentMealBadge';

    // Xác định những loại bị khoá. Nếu rule không restrict type → khoá hết.
    const typeRestricted = !!(lockInfo.lockMan || lockInfo.lockNhe || lockInfo.lockChay);
    const blockedTypes = lockInfo.locked
        ? (typeRestricted
            ? ['MAN','NHE','CHAY'].filter(t =>
                (t==='MAN' && lockInfo.lockMan) ||
                (t==='NHE' && lockInfo.lockNhe) ||
                (t==='CHAY' && lockInfo.lockChay))
            : ['MAN','NHE','CHAY'])
        : [];

    lockState[typeMeal] = {
        locked: !!lockInfo.locked,
        msg: lockInfo.reason || '',
        note: lockInfo.note || '',
        blockedTypes
    };

    const sameWeek = isSameWeek(targetDate);

    // Disable từng nút theo loại bị khoá thay vì disable hết
    ['MAN','NHE','CHAY'].forEach(t => {
        const b = document.getElementById(prefix + t);
        if (!b) return;
        const isBlocked = blockedTypes.includes(t);
        b.disabled = isBlocked;
        b.style.opacity = isBlocked ? '.4' : '';
        b.style.cursor  = isBlocked ? 'not-allowed' : '';
    });

    const badge   = document.getElementById(badgeId);
    const [y,m,d] = (targetDate||'').split('-');
    const dLabel  = (y && m && d) ? `${d}/${m}/${y}` : 'ngày này';

    if (lockInfo.locked) {
        const typeLabels = { MAN:'🍖 Mặn', NHE:'🥗 Nhẹ', CHAY:'🥦 Chay' };
        const typesText = typeRestricted
            ? blockedTypes.map(t => typeLabels[t]).join(', ')
            : 'mọi loại';
        const noteLine = lockInfo.note
            ? `<div style="font-weight:500;font-size:.72rem;color:#7f1d1d;margin-top:.2rem;font-style:italic;">📝 ${esc(lockInfo.note)}</div>`
            : '';
        badge.innerHTML = `
            <div style="background:#fef2f2;border:1.5px solid #fecaca;color:#b91c1c;border-radius:10px;padding:.55rem .75rem;font-size:.8rem;font-weight:700;line-height:1.5;text-align:left;">
                🔒 Ngày <b>${dLabel}</b> đã chốt số lượng — không thể đổi sang <b>${typesText}</b>.<br>
                <span style="font-weight:500;">Xin cảm ơn!</span>
                ${noteLine}
            </div>`;
    } else if (lockInfo.reason && lockInfo.cutoffDt && sameWeek) {
        const cur = badge.innerHTML;
        const noteLine = lockInfo.note
            ? `<br><span style="font-style:italic;">📝 ${esc(lockInfo.note)}</span>` : '';
        badge.innerHTML = cur + `
            <div style="margin-top:.4rem;background:#fffbeb;border:1px solid #fde68a;color:#92400e;border-radius:8px;padding:.45rem .65rem;font-size:.75rem;text-align:left;line-height:1.5;">
                ⏰ Ngày <b>${dLabel}</b> sẽ chốt số lượng — ${esc(lockInfo.reason)}.${noteLine}
            </div>`;
    }
}
function esc(s){ return (s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

async function onMealDateChange() {
    const inp   = document.getElementById('mealDate');
    const label = document.getElementById('mealDateLabel');
    const tStr  = getTomorrowStr();
    // iOS Safari bỏ qua min attribute → validate thủ công
    const todayStr = new Date().toISOString().split('T')[0];
    if (inp.value <= todayStr) {
        inp.value = tStr;
        window.showToast('Chỉ được đổi món từ ngày mai trở đi', 'warning');
    }
    label.textContent = inp.value === tStr ? 'ngày mai' : inp.value.split('-').reverse().join('/');

    document.getElementById('currentMealBadge').innerHTML =
        '<span style="color:#94a3b8;font-size:.75rem;">Đang tải...</span>';
    try {
        const res  = await fetch(MEAL_URL + '?date=' + inp.value + '&typeMeal=LUNCH');
        const data = await res.json();
        updateMealButtons(data.success ? data.foodType : 'MAN');
    } catch { updateMealButtons('MAN'); }
    applyLockUI('LUNCH', await checkLock(inp.value, 'LUNCH'), inp.value);
}

async function onOtDateChange() {
    const inp   = document.getElementById('otDate');
    const label = document.getElementById('otDateLabel');
    const tStr  = getTomorrowStr();
    // iOS Safari bỏ qua min attribute → validate thủ công
    const todayStr = new Date().toISOString().split('T')[0];
    if (inp.value <= todayStr) {
        inp.value = tStr;
        window.showToast('Chỉ được đổi món từ ngày mai trở đi', 'warning');
    }
    label.textContent = inp.value === tStr ? 'ngày mai' : inp.value.split('-').reverse().join('/');

    document.getElementById('currentOtBadge').innerHTML =
        '<span style="color:#94a3b8;font-size:.75rem;">Đang tải...</span>';
    try {
        const res  = await fetch(MEAL_URL + '?date=' + inp.value + '&typeMeal=OT');
        const data = await res.json();
        updateOtButtons(data.success ? data.foodType : 'MAN');
    } catch { updateOtButtons('MAN'); }
    applyLockUI('OT', await checkLock(inp.value, 'OT'), inp.value);
}

function _doFetch(body) {
    fetch('@Url.Action("ChangeMealSubmit")', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
        body: JSON.stringify(body)
    })
    .then(r => r.json())
    .then(d => {
        window.showToast(d.message, d.success ? 'success' : 'error');
        if (d.success) setTimeout(() => location.href = '@Url.Action("Today")', 1500);
    })
    .catch(() => window.showToast('Lỗi kết nối, vui lòng thử lại', 'error'));
}

function submitMeal(type, label, typeMeal) {
    const ls = lockState[typeMeal];
    if (ls?.locked && ls.blockedTypes?.includes(type)) {
        window.showToast(`Đã bị khoá đổi sang ${label}: ` + (ls.msg || ''), 'warning');
        return;
    }
    const dateInputId = typeMeal === 'OT' ? 'otDate' : 'mealDate';
    const dateStr = document.getElementById(dateInputId).value;
    const todayStr = new Date().toISOString().split('T')[0];
    if (!dateStr || dateStr <= todayStr) {
        window.showToast('Chỉ được đổi món từ ngày mai trở đi', 'warning');
        return;
    }
    const [y, m, d] = dateStr.split('-');
    const dateLabel = `${d}/${m}/${y}`;
    const title = typeMeal === 'OT' ? 'Đổi món tăng ca' : 'Đổi món ăn ca';
    window.showConfirm(
        `Xác nhận đổi sang món ${label} (${typeMeal === 'OT' ? 'tăng ca' : 'bữa ca'}) ngày ${dateLabel}?`,
        () => _doFetch({ mealType: type, typeMeal: typeMeal, fromDate: dateStr, toDate: dateStr }),
        { title: title, okText: 'Xác nhận', okClass: 'btn-danger',
          icon: 'restaurant', iconColor: '#c00000', iconBg: '#ffe4e4' }
    );
}

function toggleSpecial(type) {
    const ds   = document.getElementById('dateSection');
    const btnC = document.getElementById('btnChayTruong');
    const btnN = document.getElementById('btnNheTruong');

    if (selectedSpecial === type) {
        selectedSpecial = '';
        ds.classList.remove('show', 'nhe-mode');
        btnC.classList.remove('active');
        btnN.classList.remove('active');
        return;
    }

    selectedSpecial = type;
    btnC.classList.toggle('active', type === 'CHAY_TRUONG');
    btnN.classList.toggle('active', type === 'NHE_TRUONG');
    ds.classList.add('show');
    ds.classList.toggle('nhe-mode', type === 'NHE_TRUONG');

    const tomorrow = new Date(); tomorrow.setDate(tomorrow.getDate() + 1);
    const tomorrowStr = tomorrow.toISOString().split('T')[0];
    document.getElementById('fromDate').value = tomorrowStr;
}

function submitSpecial() {
    const from  = document.getElementById('fromDate').value;
    const to    = document.getElementById('toDate').value;
    if (!from || !to) { window.showToast('Vui lòng chọn đủ ngày bắt đầu và kết thúc', 'warning'); return; }
    if (from > to)    { window.showToast('Ngày bắt đầu không được sau ngày kết thúc', 'warning'); return; }

    const label = selectedSpecial === 'CHAY_TRUONG' ? 'Chay trường' : 'Món nhẹ';
    window.showConfirm(
        `Xác nhận đăng ký ${label} từ ${from} đến ${to}?`,
        () => _doFetch({ mealType: selectedSpecial, fromDate: from, toDate: to }),
        { title: 'Đăng ký dài hạn', okText: 'Đăng ký', okClass: 'btn-success',
          icon: 'event_available', iconColor: '#16a34a', iconBg: '#dcfce7' }
    );
}
</script>
