@model HR_web.Models.Menu.MenuWeekDetailViewModel
@{
    ViewData["Title"] = "Nhập thực đơn tuần";
    var shifts    = new[] { ("CA1","CA 1"), ("CA2","CA 2 / TĂNG CA"), ("CA3","CA 3") };
    var days      = new[] { (2,"Thứ 2"), (3,"Thứ 3"), (4,"Thứ 4"), (5,"Thứ 5"), (6,"Thứ 6"), (7,"Thứ 7") };
    var mealTypes = new[] { ("MAN","Món mặn"), ("DU_KIEN","Món dự kiến"), ("NHE","Món nhẹ"), ("CHAY","Món chay") };

    // Nhóm detail vào dict để tra nhanh: key = "shift|dayNo|mealType"
    var detailMap = Model.Details
        .GroupBy(d => $"{d.SHIFT}|{d.DAY_NO}|{d.MEAL_TYPE}")
        .ToDictionary(
            g => g.Key,
            g => string.Join("\n", g.OrderBy(d => d.DISPLAY_ORDER)
                                    .Select(d => d.FOOD_TEXT ?? d.FOOD_NAME ?? ""))
        );

    bool isPublished = Model.Week.STATUS == "PUBLISHED";
}

<div class="container-fluid py-4">

    {{!-- ── TOP BAR ── --}}
    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <div>
            <a href="@Url.Action("Manage")" class="btn btn-outline-secondary btn-sm mb-0">
                <i class="bi bi-arrow-left me-1"></i> Danh sách tuần
            </a>
        </div>
        <div class="text-center">
            <h5 class="mb-0">@(Model.Week.WEEK_NAME ?? $"Tuần {Model.Week.FROM_DATE:dd/MM} – {Model.Week.TO_DATE:dd/MM/yyyy}")</h5>
            <small class="text-secondary">@Model.Week.FROM_DATE.ToString("dd/MM/yyyy") → @Model.Week.TO_DATE.ToString("dd/MM/yyyy")</small>
        </div>
        <div class="d-flex gap-2">
            @if (!isPublished)
            {
                <button id="btnSave" class="btn btn-dark btn-sm mb-0">
                    <i class="bi bi-floppy me-1"></i> Lưu thực đơn
                </button>
            }
            else
            {
                <span class="badge bg-gradient-success px-3 py-2">Đã đăng — chỉ xem</span>
            }
        </div>
    </div>

    <div id="saveAlert"></div>

    {{!-- ── GRID NHẬP MÓN ── --}}
    @foreach (var (shiftKey, shiftLabel) in shifts)
    {
        var shiftColor = shiftKey switch
        {
            "CA1" => "#1F4E79",
            "CA2" => "#375623",
            _     => "#7B3F00"
        };

        <div class="card mb-4">
            <div class="card-header py-2 px-3 text-white" style="background:@shiftColor; border-radius:8px 8px 0 0;">
                <strong>@shiftLabel</strong>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered mb-0 align-middle" style="min-width:700px;">
                        <thead class="bg-light">
                            <tr>
                                <th style="width:90px;" class="text-center text-xs px-2">THỨ</th>
                                @foreach (var (_, mealLabel) in mealTypes)
                                {
                                    <th class="text-xs px-2">@mealLabel</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (dayNo, dayLabel) in days)
                            {
                                <tr>
                                    <td class="text-center fw-bold text-sm bg-light px-2">@dayLabel</td>
                                    @foreach (var (mealKey, _) in mealTypes)
                                    {
                                        var key = $"{shiftKey}|{dayNo}|{mealKey}";
                                        var val = detailMap.GetValueOrDefault(key, "");
                                        <td class="p-1">
                                            <textarea
                                                class="form-control form-control-sm menu-cell border-0 bg-transparent"
                                                rows="2"
                                                data-shift="@shiftKey"
                                                data-day="@dayNo"
                                                data-meal="@mealKey"
                                                placeholder="Nhập món... (nhiều món: xuống dòng)"
                                                @(isPublished ? "disabled" : "")
                                                style="resize:none;min-height:60px;font-size:12px;">@val</textarea>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @if (!isPublished)
    {
        <div class="text-end">
            <button id="btnSaveBottom" class="btn btn-dark btn-lg">
                <i class="bi bi-floppy me-1"></i> Lưu tất cả
            </button>
        </div>
    }
</div>

<script>
const WEEK_ID   = @Model.Week.ID;
const antiForgery = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)?.[1] ?? '';

function collectItems() {
    const items = [];
    document.querySelectorAll('.menu-cell').forEach(ta => {
        const raw = ta.value.trim();
        if (!raw) return;
        const lines = raw.split(/\r?\n/).map(l => l.trim()).filter(l => l);
        lines.forEach((line, i) => {
            items.push({
                DAY_NO:        parseInt(ta.dataset.day),
                SHIFT:         ta.dataset.shift,
                MEAL_TYPE:     ta.dataset.meal,
                FOOD_TEXT:     line,
                DISPLAY_ORDER: i + 1
            });
        });
    });
    return items;
}

async function saveGrid() {
    const btn     = document.getElementById('btnSave') ?? document.getElementById('btnSaveBottom');
    const alertEl = document.getElementById('saveAlert');
    btn && (btn.disabled = true, btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang lưu...');

    const items = collectItems();
    try {
        const res  = await fetch('@Url.Action("SaveGrid")', {
            method:  'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': antiForgery },
            body:    JSON.stringify({ WEEK_ID, ITEMS: items })
        });
        const data = await res.json();
        alertEl.innerHTML = data.success
            ? `<div class="alert alert-success py-2"><i class="bi bi-check-circle me-1"></i>${data.message}</div>`
            : `<div class="alert alert-danger py-2"><i class="bi bi-x-circle me-1"></i>${data.message}</div>`;
    } catch(e) {
        alertEl.innerHTML = `<div class="alert alert-danger py-2">Lỗi kết nối: ${e.message}</div>`;
    } finally {
        btn && (btn.disabled = false, btn.innerHTML = '<i class="bi bi-floppy me-1"></i>Lưu thực đơn');
        alertEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
}

document.getElementById('btnSave')?.addEventListener('click', saveGrid);
document.getElementById('btnSaveBottom')?.addEventListener('click', saveGrid);
</script>
