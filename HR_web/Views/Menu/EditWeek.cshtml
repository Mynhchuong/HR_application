@model HR_web.Models.Menu.MenuWeekDetailViewModel
@using Newtonsoft.Json
@{
    ViewData["Title"] = "Nhập thực đơn tuần";
    var shifts    = new[] { ("CA1","CA 1"), ("CA2","CA 2 / TĂNG CA"), ("CA3","CA 3") };
    var days      = new[] { (2,"Thứ 2"), (3,"Thứ 3"), (4,"Thứ 4"), (5,"Thứ 5"), (6,"Thứ 6"), (7,"Thứ 7") };
    var mealTypes = new[] { ("MAN","Món mặn"), ("DU_KIEN","Món dự kiến"), ("NHE","Món nhẹ"), ("CHAY","Món chay"), ("BANH","Món bánh") };

    // Build detail items map preserving FOOD_ID per cell
    var detailItemsMap = Model.Details
        .GroupBy(d => $"{d.SHIFT}|{d.DAY_NO}|{d.MEAL_TYPE}")
        .ToDictionary(
            g => g.Key,
            g => g.OrderBy(d => d.DISPLAY_ORDER)
                  .Select(d => new { foodId = d.FOOD_ID, name = d.FOOD_NAME ?? "" })
                  .Where(d => d.foodId.HasValue && !string.IsNullOrEmpty(d.name))
                  .ToList()
        );

    // Serialize food catalog for JS select
    var foodsJson = JsonConvert.SerializeObject(
        Model.Foods.Select(f => new { id = f.ID, name = f.FOOD_NAME, type = f.FOOD_TYPE })
    );

    bool isPublished = Model.Week.STATUS == "PUBLISHED";
}

<style>
.food-cell {
    min-height: 52px;
    padding: 4px 5px 3px;
}
.food-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
    margin-bottom: 3px;
}
.ftag {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-size: 11px;
    padding: 2px 6px 2px 7px;
    border-radius: 20px;
    line-height: 1.45;
    max-width: 100%;
    word-break: break-word;
}
.ftag.has-id { background:#d1fae5; color:#065f46; border:1px solid #a7f3d0; }
.ftag-rm {
    background:none; border:none; cursor:pointer;
    font-size:13px; line-height:1; padding:0 1px;
    color:inherit; opacity:.55; flex-shrink:0;
}
.ftag-rm:hover { opacity:1; }
/* Select2 compact override cho ô thực đơn */
.select2-container { width:100% !important; }
.select2-container .select2-selection--single {
    height:26px !important;
    border:1px solid #e2e8f0 !important;
    border-radius:6px !important;
    background:#f8fafc !important;
}
.select2-container .select2-selection--single .select2-selection__rendered {
    line-height:24px !important;
    font-size:11px !important;
    color:#334155 !important;
    padding-left:6px !important;
}
.select2-container .select2-selection--single .select2-selection__arrow {
    height:24px !important;
}
.select2-dropdown { font-size:12px; }
.select2-search--dropdown .select2-search__field { font-size:12px; }
</style>

<div class="container-fluid py-4">
<div class="card my-4">
    <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
        <div class="bg-gradient-success shadow-success border-radius-lg pt-3 pb-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <a href="@Url.Action("Manage")" class="text-white d-inline-flex align-items-center me-1" style="text-decoration:none;" title="Quay lại">
                    <i class="bi bi-arrow-left fs-5"></i>
                </a>
                <div>
                    <h6 class="text-white mb-0">@(Model.Week.WEEK_NAME ?? $"Tuần {Model.Week.FROM_DATE:dd/MM} – {Model.Week.TO_DATE:dd/MM/yyyy}")</h6>
                    <small class="text-white opacity-8">@Model.Week.FROM_DATE.ToString("dd/MM/yyyy") → @Model.Week.TO_DATE.ToString("dd/MM/yyyy")</small>
                </div>
            </div>
            <div class="d-flex gap-2 align-items-center">
                @if (!isPublished)
                {
                    <button id="btnSave" class="btn btn-sm btn-white mb-0">
                        <i class="bi bi-floppy me-1"></i> Lưu thực đơn
                    </button>
                }
                else
                {
                    <span class="badge bg-white text-success px-3 py-2">Đã đăng — chỉ xem</span>
                }
            </div>
        </div>
    </div>
    <div class="card-body">

    <div id="saveAlert"></div>

    @foreach (var (shiftKey, shiftLabel) in shifts)
    {
        var shiftColor = shiftKey switch
        {
            "CA1" => "#1F4E79",
            "CA2" => "#375623",
            _     => "#7B3F00"
        };

        <div class="card mb-4">
            <div class="card-header py-2 px-3 text-white" style="background:@shiftColor; border-radius:8px 8px 0 0;">
                <strong>@shiftLabel</strong>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered mb-0 align-middle" style="min-width:700px;">
                        <thead class="bg-light">
                            <tr>
                                <th style="width:90px;" class="text-center text-xs px-2">THỨ</th>
                                @foreach (var (_, mealLabel) in mealTypes)
                                {
                                    <th class="text-xs px-2">@mealLabel</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (dayNo, dayLabel) in days)
                            {
                                <tr>
                                    <td class="text-center fw-bold text-sm bg-light px-2">@dayLabel</td>
                                    @foreach (var (mealKey, _) in mealTypes)
                                    {
                                        var key   = $"{shiftKey}|{dayNo}|{mealKey}";
                                        var items = detailItemsMap.GetValueOrDefault(key);
                                        <td class="p-0">
                                            <div class="food-cell@(isPublished ? " readonly" : "")"
                                                 data-shift="@shiftKey" data-day="@dayNo" data-meal="@mealKey">
                                                <div class="food-tags">
                                                     @if (items != null && items.Any())
                                                     {
                                                         @foreach (var item in items)
                                                         {
                                                             <span class="ftag has-id" data-fid="@item.foodId">@item.name@if (!isPublished){<button type="button" class="ftag-rm">×</button>}</span>
                                                         }
                                                     }
                                                </div>
                                                @if (!isPublished)
                                                {
                                                    <select class="food-select">
                                                        <option value="">— Chọn món —</option>
                                                    </select>
                                                }
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    </div>
</div>
</div>

<script>
const WEEK_ID     = @Model.Week.ID;
const antiForgery = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)?.[1] ?? '';
const FOODS       = @Html.Raw(foodsJson);

// DU_KIEN dùng chung danh sách với MAN
const FOOD_TYPE_MAP = { MAN: 'MAN', DU_KIEN: 'MAN', NHE: 'NHE', CHAY: 'CHAY', BANH: 'BANH' };

// ── Remove tag ────────────────────────────────────────────────────────────────
document.addEventListener('click', e => {
    if (e.target.classList.contains('ftag-rm'))
        e.target.closest('.ftag')?.remove();
});

function esc(s) {
    return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function addTag(tagsEl, foodId, name) {
    const keys = [...tagsEl.querySelectorAll('.ftag')].map(t => t.dataset.fid ?? '');
    if (keys.includes(String(foodId))) return;
    const span = document.createElement('span');
    span.className = 'ftag has-id';
    span.dataset.fid = foodId;
    span.innerHTML = esc(name) + ' <button type="button" class="ftag-rm">×</button>';
    tagsEl.appendChild(span);
}

// ── Populate selects & khởi tạo Select2 (có ô tìm kiếm) ────────────────────
document.querySelectorAll('.food-cell:not(.readonly)').forEach(cell => {
    const sel  = cell.querySelector('.food-select');
    const tags = cell.querySelector('.food-tags');
    const foodType = FOOD_TYPE_MAP[cell.dataset.meal] ?? cell.dataset.meal;
    const options  = FOODS.filter(f => f.type === foodType);

    options.forEach(f => {
        const opt = document.createElement('option');
        opt.value = f.id;
        opt.textContent = f.name;
        sel.appendChild(opt);
    });

    $(sel).select2({
        placeholder: '— Chọn món —',
        allowClear: false,
        dropdownParent: $('body'),
        width: '100%',
        language: { searching: () => 'Đang tìm...', noResults: () => 'Không tìm thấy' }
    });

    $(sel).on('select2:select', function (e) {
        // BANH = suất 2 món, cho phép nhiều tag/ô. Các loại khác (MAN/NHE/CHAY/DU_KIEN) vẫn
        // chỉ 1 món/ô như cũ — món mới chọn thay thế món cũ.
        if (cell.dataset.meal !== 'BANH') tags.innerHTML = '';
        addTag(tags, parseInt(e.params.data.id), e.params.data.text);
        $(sel).val(null).trigger('change');
    });
});

// ── Collect items ─────────────────────────────────────────────────────────────
function collectItems() {
    const items = [];
    document.querySelectorAll('.food-cell').forEach(cell => {
        let order = 1;
        cell.querySelectorAll('.ftag').forEach(tag => {
            const base = {
                DAY_NO:       parseInt(cell.dataset.day),
                SHIFT:        cell.dataset.shift,
                MEAL_TYPE:    cell.dataset.meal,
                DISPLAY_ORDER: order++
            };
            if (tag.dataset.fid) {
                items.push({ ...base, FOOD_ID: parseInt(tag.dataset.fid) });
            }
        });
    });
    return items;
}

// ── Save ──────────────────────────────────────────────────────────────────────
async function saveGrid() {
    const btn     = document.getElementById('btnSave');
    const alertEl = document.getElementById('saveAlert');
    const items   = collectItems();

    if (items.length === 0) {
        alertEl.innerHTML = `<div class="alert alert-warning py-2"><i class="bi bi-exclamation-triangle me-1"></i>Không có món nào để lưu. Vui lòng thêm món trước.</div>`;
        alertEl.scrollIntoView({ behavior:'smooth', block:'nearest' });
        return;
    }

    if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang lưu...'; }
    try {
        const res  = await fetch('@Url.Action("SaveGrid")', {
            method:  'POST',
            headers: { 'Content-Type':'application/json', 'RequestVerificationToken': antiForgery },
            body:    JSON.stringify({ WEEK_ID, ITEMS: items })
        });
        const data = await res.json();
        alertEl.innerHTML = data.success
            ? `<div class="alert alert-success py-2"><i class="bi bi-check-circle me-1"></i>${data.message}</div>`
            : `<div class="alert alert-danger py-2"><i class="bi bi-x-circle me-1"></i>${data.message}</div>`;
    } catch(e) {
        alertEl.innerHTML = `<div class="alert alert-danger py-2">Lỗi kết nối: ${e.message}</div>`;
    } finally {
        if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-floppy me-1"></i>Lưu thực đơn'; }
        alertEl.scrollIntoView({ behavior:'smooth', block:'nearest' });
    }
}

document.getElementById('btnSave')?.addEventListener('click', saveGrid);
</script>
