@model List<HR_web.Models.Menu.MenuWeekModel>
@using Newtonsoft.Json
@{
    ViewData["Title"] = "Quản lý Thực đơn";
    var importErrors = TempData["ImportErrors"] as string;
    var errors = string.IsNullOrEmpty(importErrors)
        ? new List<HR_web.Models.Menu.ImportRowError>()
        : JsonConvert.DeserializeObject<List<HR_web.Models.Menu.ImportRowError>>(importErrors) ?? new();
}

<div class="container-fluid py-4">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success mx-2 py-2">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger mx-2 py-2">@TempData["ErrorMessage"]</div>
    }
    @if (TempData["ImportError"] != null)
    {
        <div class="alert alert-danger mx-2 py-2"><i class="bi bi-exclamation-triangle me-1"></i>@TempData["ImportError"]</div>
    }

    @if (errors.Any())
    {
        <div class="card border-danger mx-2 mb-3">
            <div class="card-header bg-danger text-white py-2">
                <i class="bi bi-x-circle-fill me-1"></i>
                Import thất bại — <strong>@errors.Count lỗi</strong> cần sửa trong file Excel trước khi import lại
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="px-3 py-2" style="width:40%">Vị trí</th>
                            <th class="px-3 py-2">Nội dung lỗi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in errors)
                        {
                            <tr>
                                <td class="px-3 py-1 text-danger fw-bold">@e.Location</td>
                                <td class="px-3 py-1 text-secondary">@e.Message</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer py-2 text-muted text-xs">
                Sửa các ô lỗi trong Excel rồi import lại.
            </div>
        </div>
    }

    <div class="row g-3">

        <div class="col-12 col-xl-8">
            <div class="card">
                <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                    <div class="bg-gradient-dark shadow-dark border-radius-lg pt-3 pb-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <h6 class="text-white mb-0"><i class="bi bi-calendar-week me-1"></i> Quản lý Thực đơn theo Tuần</h6>
                        <button class="btn btn-sm btn-white mb-0" data-bs-toggle="modal" data-bs-target="#modalCreateWeek">
                            <i class="bi bi-plus-lg me-1"></i> Tạo tuần mới
                        </button>
                    </div>
                </div>
                <div class="card-body px-0 pt-0 pb-2 mt-1">
                    @if (!Model.Any())
                    {
                        <div class="text-center py-5 text-secondary">
                            <i class="bi bi-calendar2-x" style="font-size:48px;opacity:.3;display:block;margin-bottom:.75rem;"></i>
                            <p>Chưa có tuần nào. Nhấn <strong>Tạo tuần mới</strong> hoặc <strong>Import Excel</strong>.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive px-3">
                            <table class="table align-items-center mb-0 table-hover">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="text-xxs text-secondary font-weight-bolder opacity-9 px-2">#</th>
                                        <th class="text-xxs text-secondary font-weight-bolder opacity-9 px-2">Tuần</th>
                                        <th class="text-xxs text-secondary font-weight-bolder opacity-9 px-2 text-center">Trạng thái</th>
                                        <th class="text-xxs text-secondary font-weight-bolder opacity-9 px-2">Cập nhật</th>
                                        <th class="text-xxs text-secondary font-weight-bolder opacity-9 px-2"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.Count; i++)
                                    {
                                        var w = Model[i];
                                        <tr>
                                            <td class="px-2 text-xs text-secondary">@(i + 1)</td>
                                            <td class="px-2">
                                                <div class="text-sm font-weight-bold">@(w.WEEK_NAME ?? $"Tuần {w.FROM_DATE:dd/MM} – {w.TO_DATE:dd/MM/yyyy}")</div>
                                                <div class="text-xs text-secondary">@w.FROM_DATE.ToString("dd/MM/yyyy") → @w.TO_DATE.ToString("dd/MM/yyyy")</div>
                                            </td>
                                            <td class="px-2 text-center">
                                                @if (w.STATUS == "PUBLISHED")
                                                {
                                                    <span class="badge bg-gradient-success">Đã đăng</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-gradient-secondary">Nháp</span>
                                                }
                                            </td>
                                            <td class="px-2 text-xs text-secondary">
                                                @((w.UPDT_DT ?? w.INST_DT)?.ToString("dd/MM/yyyy") ?? "—")
                                            </td>
                                            <td class="px-2 text-end">
                                                <div class="d-flex gap-1 justify-content-end flex-wrap">
                                                    <a href="@Url.Action("EditWeek", new { id = w.ID })"
                                                       class="btn btn-sm btn-outline-dark mb-0 px-2" title="Nhập thực đơn">
                                                        <i class="bi bi-pencil-square"></i>
                                                    </a>
                                                    @if (w.STATUS == "DRAFT")
                                                    {
                                                        <form method="post" action="@Url.Action("PublishWeek", new { id = w.ID })" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-sm btn-success mb-0 px-2" title="Đăng cho công nhân xem"
                                                                    onclick="return confirm('Đăng tuần này cho công nhân xem?')">
                                                                <i class="bi bi-send-fill"></i>
                                                            </button>
                                                        </form>
                                                        <form method="post" action="@Url.Action("DeleteWeek", new { id = w.ID })" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-sm btn-outline-danger mb-0 px-2"
                                                                    onclick="return confirm('Xóa tuần này?')">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                    else
                                                    {
                                                        <form method="post" action="@Url.Action("UnpublishWeek", new { id = w.ID })" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-sm btn-outline-warning mb-0 px-2" title="Ẩn thực đơn"
                                                                    onclick="return confirm('Ẩn thực đơn tuần này?')">
                                                                <i class="bi bi-eye-slash"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-4">
            <div class="card">
                <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                    <div class="bg-gradient-success shadow-success border-radius-lg pt-3 pb-2 px-3">
                        <h6 class="text-white mb-0"><i class="bi bi-file-earmark-excel me-1"></i> Import từ Excel</h6>
                    </div>
                </div>
                <div class="card-body">
                    <p class="text-sm text-secondary mb-3">
                        Tải mẫu Excel, điền thực đơn theo tuần, rồi upload lại để import vào hệ thống.
                    </p>

                    <button type="button" class="btn btn-outline-success w-100 mb-3"
                            onclick="dlFile('@Url.Action("DownloadTemplate")')">
                        <i class="bi bi-download me-1"></i> Tải mẫu Excel (.xlsx)
                    </button>

                    <hr class="my-2" />

                    <form method="post" action="@Url.Action("ImportExcel")" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label text-sm fw-bold">Chọn file Excel đã điền</label>
                            <input type="file" name="file" accept=".xlsx" class="form-control form-control-sm" required />
                            <div class="form-text text-xs">Chỉ nhận file .xlsx. Ngày bắt đầu/kết thúc lấy từ ô C2 và F2 trong file.</div>
                        </div>
                        <button type="submit" class="btn btn-success w-100">
                            <i class="bi bi-upload me-1"></i> Import
                        </button>
                    </form>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                    <div class="bg-gradient-info shadow-info border-radius-lg pt-3 pb-2 px-3 d-flex justify-content-between align-items-center">
                        <h6 class="text-white mb-0"><i class="bi bi-egg-fried me-1"></i> Danh mục Món ăn</h6>
                        <a href="@Url.Action("FoodManage")" class="btn btn-sm btn-white mb-0">Quản lý</a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<div class="modal fade" id="modalCreateWeek" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="@Url.Action("CreateWeek")">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Tạo tuần thực đơn mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label fw-bold">Từ ngày <span class="text-danger">*</span></label>
                            <input type="date" name="FROM_DATE" class="form-control" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold">Đến ngày <span class="text-danger">*</span></label>
                            <input type="date" name="TO_DATE" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">Ghi chú</label>
                            <input type="text" name="REMARK" class="form-control" placeholder="Tuần lễ thường / Tuần nghỉ lễ..." />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-dark">Tạo tuần</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function dlFile(url) {
    const a = document.createElement('a');
    a.href = url;
    a.style.display = 'none';
    document.body.appendChild(a);
    a.click();
    setTimeout(() => document.body.removeChild(a), 200);
}
</script>
</div>
