@model List<HR_web.Models.Menu.MenuWeekModel>
@using Newtonsoft.Json
@{
    ViewData["Title"] = "Quản lý Thực đơn";
    var importErrors = TempData["ImportErrors"] as string;
    var errors = string.IsNullOrEmpty(importErrors)
        ? new List<HR_web.Models.Menu.ImportRowError>()
        : JsonConvert.DeserializeObject<List<HR_web.Models.Menu.ImportRowError>>(importErrors) ?? new();
}

<div class="container-fluid py-4">

    @if (errors.Any())
    {
        <div class="card border-danger mx-0 mb-3">
            <div class="card-header bg-danger text-white py-2">
                <i class="bi bi-x-circle-fill me-1"></i>
                Import thất bại — <strong>@errors.Count lỗi</strong> cần sửa trong file Excel trước khi import lại
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="px-3 py-2" style="width:40%">Vị trí</th>
                            <th class="px-3 py-2">Nội dung lỗi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in errors)
                        {
                            <tr>
                                <td class="px-3 py-1 text-danger fw-bold">@e.Location</td>
                                <td class="px-3 py-1 text-secondary">@e.Message</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer py-2 text-muted text-xs">
                Sửa các ô lỗi trong Excel rồi import lại.
            </div>
        </div>
    }

    <div class="card">
        <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
            <div class="bg-gradient-success shadow-success border-radius-lg pt-3 pb-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h6 class="text-white mb-0"><i class="bi bi-calendar-week me-1"></i> Quản lý Thực đơn theo Tuần</h6>
                <div class="d-flex gap-2 flex-wrap">
                    <a href="@Url.Action("FoodManage")" class="btn btn-sm btn-outline-white mb-0">
                        <i class="bi bi-egg-fried me-1"></i> Món ăn
                    </a>
                    <button type="button" class="btn btn-sm btn-outline-white mb-0"
                            onclick="dlFile('@Url.Action("DownloadTemplate")')">
                        <i class="bi bi-download me-1"></i> Tải mẫu
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-white mb-0"
                            data-bs-toggle="modal" data-bs-target="#modalImport">
                        <i class="bi bi-upload me-1"></i> Import Excel
                    </button>
                    <button class="btn btn-sm btn-white mb-0" data-bs-toggle="modal" data-bs-target="#modalCreateWeek">
                        <i class="bi bi-plus-lg me-1"></i> Tạo tuần mới
                    </button>
                </div>
            </div>
        </div>

        <div class="card-body px-0 pt-0 pb-2 mt-1">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success mx-4 mt-3 py-2"><i class="bi bi-check-circle me-1"></i>@TempData["SuccessMessage"]</div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger mx-4 mt-3 py-2"><i class="bi bi-exclamation-triangle me-1"></i>@TempData["ErrorMessage"]</div>
            }
            @if (TempData["ImportError"] != null)
            {
                <div class="alert alert-danger mx-4 mt-3 py-2"><i class="bi bi-exclamation-triangle me-1"></i>@TempData["ImportError"]</div>
            }

            @if (!Model.Any())
            {
                <div class="text-center py-5 text-secondary">
                    <i class="bi bi-calendar2-x" style="font-size:48px;opacity:.3;display:block;margin-bottom:.75rem;"></i>
                    <p>Chưa có tuần nào. Nhấn <strong>Tạo tuần mới</strong> hoặc <strong>Import Excel</strong>.</p>
                </div>
            }
            else
            {
                <div class="table-responsive px-3 pt-1">
                    <table class="table align-items-center mb-0 table-hover">
                        <thead class="bg-light">
                            <tr>
                                <th class="text-xxs text-secondary font-weight-bolder opacity-9 px-2" style="width:40px">#</th>
                                <th class="text-xxs text-secondary font-weight-bolder opacity-9 px-2">Tuần</th>
                                <th class="text-xxs text-secondary font-weight-bolder opacity-9 px-2 text-center" style="width:110px">Trạng thái</th>
                                <th class="text-xxs text-secondary font-weight-bolder opacity-9 px-2 d-none d-md-table-cell" style="width:120px">Cập nhật</th>
                                <th class="text-xxs text-secondary font-weight-bolder opacity-9 px-2" style="width:130px"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                var w = Model[i];
                                <tr>
                                    <td class="px-2 text-xs text-secondary">@(i + 1)</td>
                                    <td class="px-2">
                                        <div class="text-sm font-weight-bold">@(w.WEEK_NAME ?? $"Tuần {w.FROM_DATE:dd/MM} – {w.TO_DATE:dd/MM/yyyy}")</div>
                                        <div class="text-xs text-secondary">@w.FROM_DATE.ToString("dd/MM/yyyy") → @w.TO_DATE.ToString("dd/MM/yyyy")</div>
                                    </td>
                                    <td class="px-2 text-center">
                                        @if (w.STATUS == "PUBLISHED")
                                        {
                                            <span class="badge bg-gradient-success">Đã đăng</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-gradient-secondary">Nháp</span>
                                        }
                                    </td>
                                    <td class="px-2 text-xs text-secondary d-none d-md-table-cell">
                                        @((w.UPDT_DT ?? w.INST_DT)?.ToString("dd/MM/yyyy") ?? "—")
                                    </td>
                                    <td class="px-2 text-end">
                                        <div class="d-flex gap-1 justify-content-end">
                                            <a href="@Url.Action("EditWeek", new { id = w.ID })"
                                               class="btn btn-outline-dark mb-0 px-3" title="Sửa thực đơn">
                                                <i class="bi bi-pencil-square fs-6"></i>
                                            </a>
                                            @if (w.STATUS == "DRAFT")
                                            {
                                                <button type="button" class="btn btn-success mb-0 px-3" title="Đăng cho công nhân xem"
                                                        data-url="@Url.Action("PublishWeek", new { id = w.ID })"
                                                        onclick="menuConfirm(this,'Đăng tuần này cho công nhân xem?','Đăng thực đơn','Đăng ngay','btn-success')">
                                                    <i class="bi bi-send-fill fs-6"></i>
                                                </button>
                                                <button type="button" class="btn btn-outline-danger mb-0 px-3" title="Xóa tuần"
                                                        data-url="@Url.Action("DeleteWeek", new { id = w.ID })"
                                                        onclick="menuConfirm(this,'Bạn có chắc muốn xóa tuần này không?','Xóa tuần','Xóa','btn-danger')">
                                                    <i class="bi bi-trash fs-6"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-outline-warning mb-0 px-3" title="Ẩn thực đơn"
                                                        data-url="@Url.Action("UnpublishWeek", new { id = w.ID })"
                                                        onclick="menuConfirm(this,'Ẩn thực đơn tuần này khỏi công nhân?','Ẩn thực đơn','Ẩn đi','btn-warning')">
                                                    <i class="bi bi-eye-slash fs-6"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

</div>

<!-- Modal: Tạo tuần mới -->
<div class="modal fade" id="modalCreateWeek" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="@Url.Action("CreateWeek")">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-plus-circle me-1"></i> Tạo tuần thực đơn mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label fw-bold">Từ ngày <span class="text-danger">*</span></label>
                            <input type="date" name="FROM_DATE" class="form-control" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold">Đến ngày <span class="text-danger">*</span></label>
                            <input type="date" name="TO_DATE" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">Ghi chú</label>
                            <input type="text" name="REMARK" class="form-control" placeholder="Tuần lễ thường / Tuần nghỉ lễ..." />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-dark"><i class="bi bi-check-lg me-1"></i> Tạo tuần</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Import Excel -->
<div class="modal fade" id="modalImport" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="@Url.Action("ImportExcel")" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-upload me-1"></i> Import thực đơn từ Excel</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-sm text-secondary mb-3">
                        Tải mẫu Excel, điền thực đơn theo tuần, rồi upload lại để import vào hệ thống.
                    </p>
                    <div class="mb-3">
                        <button type="button" class="btn btn-sm btn-outline-success"
                                onclick="dlFile('@Url.Action("DownloadTemplate")')">
                            <i class="bi bi-download me-1"></i> Tải mẫu Excel (.xlsx)
                        </button>
                    </div>
                    <div>
                        <label class="form-label fw-bold">Chọn file Excel đã điền <span class="text-danger">*</span></label>
                        <label id="fileDropZone" for="importFile"
                               style="display:flex;align-items:center;gap:10px;padding:14px 16px;border:2px dashed #dee2e6;border-radius:10px;background:#f8f9fa;cursor:pointer;transition:border-color .2s,background .2s;">
                            <i class="bi bi-file-earmark-excel" style="font-size:1.6rem;color:#198754;flex-shrink:0;"></i>
                            <span id="fileLabel" style="font-size:.85rem;color:#6c757d;">Nhấn để chọn file .xlsx...</span>
                        </label>
                        <input type="file" id="importFile" name="file" accept=".xlsx" required style="display:none;" />
                        <div class="form-text text-xs mt-1">Chỉ nhận file .xlsx. Ngày bắt đầu/kết thúc lấy từ ô C2 và F2 trong file.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-dark"><i class="bi bi-upload me-1"></i> Import</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
// Khi chọn Từ ngày → tự động tính Đến ngày = thứ 7 cùng tuần (+ 5 ngày)
document.querySelector('input[name="FROM_DATE"]').addEventListener('change', function () {
    if (!this.value) return;
    const from = new Date(this.value);
    const to   = new Date(from);
    to.setDate(from.getDate() + 5);
    document.querySelector('input[name="TO_DATE"]').value = to.toISOString().split('T')[0];
});

function dlFile(url) {
    const a = document.createElement('a');
    a.href = url;
    a.style.display = 'none';
    document.body.appendChild(a);
    a.click();
    setTimeout(() => document.body.removeChild(a), 200);
}

function postUrl(url) {
    const f = document.createElement('form');
    f.method = 'POST';
    f.action = url;
    const t = document.querySelector('input[name="__RequestVerificationToken"]');
    if (t) {
        const i = document.createElement('input');
        i.type = 'hidden'; i.name = '__RequestVerificationToken'; i.value = t.value;
        f.appendChild(i);
    }
    document.body.appendChild(f);
    f.submit();
}

function menuConfirm(btn, message, title, okText, okClass) {
    const url = btn.dataset.url;
    showConfirm(message, () => postUrl(url), { title, okText, okClass });
}

document.getElementById('importFile').addEventListener('change', function () {
    const zone  = document.getElementById('fileDropZone');
    const label = document.getElementById('fileLabel');
    if (this.files.length) {
        label.textContent = this.files[0].name;
        label.style.color = '#198754';
        zone.style.borderColor = '#198754';
        zone.style.background  = '#d1f0dc';
    } else {
        label.textContent = 'Nhấn để chọn file .xlsx...';
        label.style.color = '#6c757d';
        zone.style.borderColor = '#dee2e6';
        zone.style.background  = '#f8f9fa';
    }
});
</script>
}
