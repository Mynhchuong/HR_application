@model List<HR_web.Models.Menu.MenuDayViewModel>
@{
    ViewData["Title"] = "Thực đơn tuần này";

    var today      = DateTime.Today;
    bool isNextWeek = ViewBag.IsNextWeek == true;
    bool hasNextWeek = ViewBag.HasNextWeek == true;
    bool autoNextWeek = ViewBag.AutoNextWeek == true;
    bool noNextWeekMsg = ViewBag.NoNextWeekMsg == true;
    int todayNo    = isNextWeek ? -1 : ((int)today.DayOfWeek == 0 ? 0 : (int)today.DayOfWeek + 1);

    var dayConfig = new[]
    {
        (2,"Thứ 2"), (3,"Thứ 3"), (4,"Thứ 4"), (5,"Thứ 5"), (6,"Thứ 6"), (7,"Thứ 7"),
    };
    var shifts     = new[] { ("CA1","CA 1 — Ca sáng","#1F4E79"), ("CA2","CA 2 / Tăng ca","#375623"), ("CA3","CA 3 — Ca tối","#7B3F00") };
    var mealLabels = new Dictionary<string,string>
    {
        { "MAN","Món mặn" }, { "DU_KIEN","Dự kiến" }, { "NHE","Món nhẹ" }, { "CHAY","Món chay" }, { "BANH","Suất 2 món Bánh" }
    };
    var activeDays = Model.Select(m => m.DAY_NO).Distinct().OrderBy(d => d).ToHashSet();
    bool isEmpty   = !Model.Any();

    var monday   = (ViewBag.WeekMonday as DateTime?) ?? today.AddDays(-(((int)today.DayOfWeek + 6) % 7));
    var dayDates = new Dictionary<int, string>
    {
        { 2, monday.ToString("yyyyMMdd") },
        { 3, monday.AddDays(1).ToString("yyyyMMdd") },
        { 4, monday.AddDays(2).ToString("yyyyMMdd") },
        { 5, monday.AddDays(3).ToString("yyyyMMdd") },
        { 6, monday.AddDays(4).ToString("yyyyMMdd") },
        { 7, monday.AddDays(5).ToString("yyyyMMdd") },
    };
    var userWeekMeals = ViewBag.UserWeekMeals as Dictionary<string, string> ?? new Dictionary<string, string>();
    var mealBadge = new Dictionary<string, (string label, string bg, string fg)>
    {
        { "M", ("Mặn",  "#fee2e2", "#dc2626") },
        { "C", ("Chay", "#dcfce7", "#16a34a") },
        { "N", ("Nhẹ",  "#dbeafe", "#2563eb") },
        { "B", ("Bánh", "#fefce8", "#d97706") },
    };
}

<style>
    :root {
        --fr:  #c00000;
        --frd: #8b0000;
        --fbg: #fff8f8;
        --fbo: #fde8e8;
    }

    .menu-page { max-width: 680px; margin: 0 auto; padding-bottom: 5rem; }

    /* ── Hero ── */
    .food-hero {
        background: linear-gradient(135deg, var(--frd) 0%, var(--fr) 100%);
        border-radius: 18px; padding: 1rem 1.25rem; margin-bottom: .75rem;
        color: #fff; display: flex; align-items: center; justify-content: space-between;
    }
    .food-hero h5    { font-size: 1.05rem; font-weight: 800; margin: 0 0 .15rem; color: #fff !important; }
    .food-hero small { font-size: .75rem; opacity: .85; color: #fff !important; }
    .food-hero-icon  { font-size: 2.4rem; line-height: 1; }

    /* ── Tab toggle (Hôm nay / Cả tuần) ── */
    .food-tabs {
        display: flex; background: #f1f5f9; border-radius: 12px;
        padding: 4px; margin-bottom: .75rem; gap: 3px;
        touch-action: manipulation;
    }
    .food-tab {
        flex: 1; text-align: center; min-height: 44px;
        display: flex; align-items: center; justify-content: center;
        border-radius: 9px; font-size: .88rem; font-weight: 700;
        text-decoration: none !important; color: #64748b;
        transition: background .15s, color .15s, box-shadow .15s;
        -webkit-tap-highlight-color: transparent;
        user-select: none; cursor: pointer;
    }
    .food-tab.active { background: white; color: var(--fr); box-shadow: 0 1px 4px rgba(0,0,0,.12); }
    .food-tab:active { opacity: .75; }

    /* ── Day tabs ── */
    .day-tabs {
        display: flex; overflow-x: auto; background: white;
        border-radius: 14px; border: 1.5px solid #f0f0f0;
        box-shadow: 0 2px 6px rgba(0,0,0,.05);
        margin-bottom: .75rem; scrollbar-width: none;
        touch-action: pan-x;
    }
    .day-tabs::-webkit-scrollbar { display: none; }
    .day-tab {
        flex-shrink: 0; min-height: 52px; padding: 0 .9rem;
        display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px;
        font-size: .82rem; font-weight: 700; color: #64748b;
        border-bottom: 3px solid transparent; cursor: pointer;
        white-space: nowrap; transition: color .15s, border-color .15s;
        -webkit-tap-highlight-color: transparent; user-select: none;
        touch-action: manipulation;
    }
    .day-tab-name { display: flex; align-items: center; gap: 4px; }
    .day-tab.active  { color: var(--fr); border-bottom-color: var(--fr); }
    .day-tab.no-data { color: #cbd5e1; }
    .day-tab .dot    { width: 6px; height: 6px; border-radius: 50%; background: var(--fr); flex-shrink: 0; }
    .meal-chip {
        font-size: .58rem; font-weight: 800; padding: 1px 6px;
        border-radius: 6px; line-height: 1.6; letter-spacing: .02em;
    }

    /* ── Day content ── */
    .day-content { display: none; }
    .day-content.active { display: block; }

    .holiday-msg { text-align: center; padding: 2.5rem 1rem; color: #94a3b8; font-size: .88rem; }
    .today-label { text-align: center; padding: .35rem 0; font-size: .78rem; color: var(--fr); font-weight: 700; }

    /* ── Lunch banner ── */
    .lunch-banner { text-align: center; margin-bottom: .75rem; }
    .lunch-banner img { width: 100%; max-height: 170px; object-fit: contain; border-radius: 14px; }
    .lunch-tagline {
        font-size: .82rem; font-weight: 700; font-style: italic;
        color: var(--fr); margin: .35rem 0 0; letter-spacing: .01em;
    }

    /* ── Shift block ── */
    .shift-block { border-radius: 14px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,.08); margin-bottom: .625rem; }
    .shift-header { padding: .6rem 1rem; color: white; font-weight: 700; font-size: .85rem; }
    .meal-list { background: white; }

    /* ── Meal row ── */
    .meal-row {
        display: flex; align-items: center;
        padding: .7rem .9rem; gap: .75rem;
        border-bottom: 1px solid #f5f5f5; min-height: 52px;
        -webkit-tap-highlight-color: transparent;
    }
    .meal-row:last-child { border-bottom: none; }
    .meal-row:active { background: #fafafa; }

    .meal-img    { width: 56px; height: 56px; border-radius: 10px; object-fit: cover; flex-shrink: 0; }
    .meal-img-ph { width: 56px; height: 56px; border-radius: 10px; background: #f5f5f5;
                   display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 24px; }

    .meal-info { flex: 1; min-width: 0; }
    .meal-type { font-size: .65rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 2px; }
    .meal-name { font-size: .9rem; font-weight: 700; line-height: 1.35; color: #1e293b; }

    .meal-row-clickable { cursor: pointer; }
    .meal-row-clickable:active { background: #fff0f0 !important; }

    /* Food modal */
    .food-modal-backdrop {
        position: fixed; inset: 0; background: rgba(0,0,0,.55);
        z-index: 1050; display: none; align-items: flex-end;
        backdrop-filter: blur(3px);
    }
    .food-modal-backdrop.open { display: flex; }
    .food-modal-sheet {
        width: 100%; background: white;
        border-radius: 24px 24px 0 0;
        padding: 0 0 env(safe-area-inset-bottom,16px);
        transform: translateY(100%);
        transition: transform .3s cubic-bezier(.32,.72,0,1);
        max-height: 92dvh; overflow-y: auto;
    }
    .food-modal-backdrop.open .food-modal-sheet { transform: translateY(0); }
    .food-modal-handle { width: 40px; height: 4px; background: #e2e8f0; border-radius: 2px; margin: 10px auto 0; }
    .food-modal-img {
        width: 100%; max-height: 280px; object-fit: contain;
        border-radius: 0; display: block; background: #f8fafc;
    }
    .food-modal-img-ph {
        width: 100%; max-height: 280px; object-fit: cover; display: block;
        border-radius: 0;
    }
    .food-modal-body { padding: 1rem 1.25rem 1.5rem; }
    .food-modal-name { font-size: 1.1rem; font-weight: 900; color: #1e293b; margin-bottom: .5rem; }
    .food-modal-wow  { font-size: .95rem; font-weight: 700; font-style: italic; color: var(--fr); }
    .food-modal-close {
        position: absolute; top: .75rem; right: .75rem;
        width: 32px; height: 32px; border-radius: 50%;
        background: rgba(0,0,0,.35); border: none;
        display: flex; align-items: center; justify-content: center;
        color: white; font-size: 1rem; cursor: pointer; z-index: 1;
    }

    /* ── Banner "xem thực đơn tuần sau" ── */
    .next-week-cta {
        display: flex; flex-direction: column; align-items: center; gap: 2px;
        background: #fff7ed; border: 2px dashed #fb923c; border-radius: 14px;
        padding: .7rem 1rem; margin-bottom: .75rem;
        text-decoration: none !important; text-align: center;
        -webkit-tap-highlight-color: transparent;
        animation: ctaPulse 1.8s ease-in-out infinite;
    }
    .next-week-cta:active { opacity: .8; }
    .next-week-cta .cta-title { font-size: .9rem; font-weight: 800; color: #c2410c; }
    .next-week-cta .cta-tap   { font-size: .78rem; font-weight: 700; color: #ea580c; }
    @@keyframes ctaPulse {
        0%, 100% { box-shadow: 0 0 0 0 rgba(251,146,60,.45); }
        50%      { box-shadow: 0 0 0 7px rgba(251,146,60,0); }
    }

    .auto-nextweek-note {
        background: #eff6ff; border: 1.5px solid #bfdbfe; color: #1d4ed8;
        border-radius: 12px; padding: .55rem .8rem; margin-bottom: .75rem;
        font-size: .8rem; font-weight: 700; line-height: 1.5; text-align: center;
    }
</style>

<div class="food-modal-backdrop" id="foodModal" onclick="closeFoodModal(event)">
    <div class="food-modal-sheet" id="foodModalSheet">
        <div class="food-modal-handle"></div>
        <div style="position:relative;">
            <button class="food-modal-close" onclick="closeFoodModal()">✕</button>
            <img class="food-modal-img" id="foodModalImg" src="" alt=""
                 onerror="this.style.display='none';document.getElementById('foodModalPh').style.display='block';" />
            <img class="food-modal-img-ph" id="foodModalPh"
                 src="@Url.Content("~/assets/img/no-food-image.jpg")" alt="Chưa cập nhật hình"
                 style="display:none;" />
        </div>
        <div class="food-modal-body">
            <div class="food-modal-name" id="foodModalName"></div>
            <div class="food-modal-wow">😍 waooooo nhìn ngon miệng quá</div>
        </div>
    </div>
</div>

<div class="menu-page px-2 py-2">

    <div class="food-hero">
        <div>
            <h5>@(isNextWeek ? "Thực đơn tuần sau" : "Thực đơn tuần này")</h5>
            <small>@monday.ToString("dd/MM") – @monday.AddDays(5).ToString("dd/MM/yyyy")</small>
        </div>
        <div class="d-flex flex-column align-items-end gap-1">
            <span class="food-hero-icon">📅</span>
            @if (isNextWeek && !autoNextWeek)
            {
                <a href="@Url.Action("ThisWeek","Menu")" class="btn btn-sm"
                   style="background:rgba(255,255,255,.2);color:#fff;font-size:.72rem;font-weight:700;padding:4px 10px;border-radius:8px;text-decoration:none;">
                    ← Tuần này
                </a>
            }
            else if (hasNextWeek)
            {
                <a href="@Url.Action("NextWeek","Menu")" class="btn btn-sm"
                   style="background:rgba(255,255,255,.2);color:#fff;font-size:.72rem;font-weight:700;padding:4px 10px;border-radius:8px;text-decoration:none;">
                    Tuần sau →
                </a>
            }
        </div>
    </div>

    @if (autoNextWeek)
    {
        <div class="auto-nextweek-note">
            🗓️ Hôm nay Chủ nhật — thực đơn <b>tuần sau</b> đã được hiển thị sẵn cho bạn xem trước.
        </div>
    }
    else if (!isNextWeek && hasNextWeek)
    {
        <a href="@Url.Action("NextWeek","Menu")" class="next-week-cta">
            <span class="cta-title">📢 Căn tin đã đăng thực đơn tuần sau!</span>
            <span class="cta-tap">👉 Nhấn vào đây để xem thực đơn tuần sau</span>
        </a>
    }

    <div class="food-tabs">
        <a href="@Url.Action("Today")" class="food-tab">Hôm nay</a>
        <div class="food-tab active">Cả tuần</div>
    </div>

    @{
        var lunchImg = new Random().Next(2) == 0
            ? "~/assets/img/illustrations/A_LUNCH.png"
            : "~/assets/img/illustrations/C_LUNCH.png";
    }
    <div class="lunch-banner">
        <img src="@Url.Content(lunchImg)" alt="Bữa trưa ngon" />
        <p class="lunch-tagline">✨ Hãy tận hưởng mỹ vị từ bữa cơm trưa của công ty chúng ta!</p>
    </div>

    @if (isEmpty)
    {
        <div class="holiday-msg">
            <div style="font-size:2.8rem;margin-bottom:.5rem;">🍽️</div>
            @if (noNextWeekMsg)
            {
                <p>Hôm nay Chủ nhật — căn tin <b>chưa cập nhật</b> thực đơn tuần sau.<br />Bạn vui lòng quay lại xem sau nhé!</p>
            }
            else
            {
                <p>Chưa có thực đơn tuần này.</p>
            }
        </div>
    }
    else
    {
        <p style="text-align:center;font-size:.73rem;color:#94a3b8;margin-bottom:.5rem;">
            👆 Nhấn vào món ăn để xem hình
        </p>
        <div class="day-tabs" id="dayTabs">
            @foreach (var (dayNo, dayName) in dayConfig)
            {
                bool hasData = activeDays.Contains(dayNo);
                bool isToday = dayNo == todayNo;
                var tabDate  = dayDates.GetValueOrDefault(dayNo, "");
                userWeekMeals.TryGetValue(tabDate, out var tabMeal);
                <div class="day-tab @(hasData ? "" : "no-data")"
                     data-day="@dayNo" data-date="@tabDate" onclick="switchDay(@dayNo)">
                    <span class="day-tab-name">
                        @dayName
                        @if (isToday) { <span class="dot"></span> }
                        <span class="day-lock-ico" data-lock-day="@dayNo" style="display:none;font-size:.7rem;margin-left:2px;">🔒</span>
                    </span>
                    @if (hasData)
                    {
                        var chipCode = (!string.IsNullOrEmpty(tabMeal) && mealBadge.ContainsKey(tabMeal)) ? tabMeal : "M";
                        var tc = mealBadge[chipCode];
                        <span class="meal-chip" style="background:@tc.bg;color:@tc.fg;">@tc.label</span>
                    }
                </div>
            }
        </div>

        @foreach (var (dayNo, dayName) in dayConfig)
        {
            bool isToday  = dayNo == todayNo;
            var  dayItems = Model.Where(m => m.DAY_NO == dayNo).ToList();

            <div class="day-content" id="day-@dayNo" data-date="@dayDates.GetValueOrDefault(dayNo, "")">
                <div class="lock-banner" data-lock-content="@dayNo" style="display:none;margin-bottom:.6rem;"></div>

                @if (!dayItems.Any())
                {
                    <div class="holiday-msg">
                        <div style="font-size:2.2rem;margin-bottom:.4rem;">🏖️</div>
                        <p>Ngày nghỉ — không có thực đơn</p>
                    </div>
                }
                else
                {
                    if (isToday)
                    {
                        <div class="today-label">Hôm nay — @DateTime.Today.ToString("dd/MM/yyyy")</div>
                    }

                    var dayDateKey  = dayDates.GetValueOrDefault(dayNo, "");
                    userWeekMeals.TryGetValue(dayDateKey, out var userMealCode);
                    var contentCode = (!string.IsNullOrEmpty(userMealCode) && mealBadge.ContainsKey(userMealCode)) ? userMealCode : "M";
                    var badge       = mealBadge[contentCode];
                    <div style="display:flex;align-items:center;gap:.4rem;margin-bottom:.6rem;padding:.45rem .75rem;border-radius:12px;background:@badge.bg;font-size:.78rem;font-weight:700;color:@badge.fg;">
                        <span style="font-size:1rem;">🍽️</span> Bạn đăng ký: @badge.label
                    </div>

                    @foreach (var (shiftKey, shiftLabel, shiftColor) in shifts)
                    {
                        var shiftItems = dayItems.Where(m => m.SHIFT == shiftKey).ToList();
                        if (!shiftItems.Any()) continue;

                        var byMeal = shiftItems
                            .GroupBy(m => m.MEAL_TYPE)
                            .OrderBy(g => g.Key == "MAN" ? 0 : g.Key == "DU_KIEN" ? 1 : g.Key == "NHE" ? 2 : 3);

                        <div class="shift-block">
                            <div class="shift-header" style="background:@shiftColor;">@shiftLabel</div>
                            <div class="meal-list">
                                @foreach (var mealGroup in byMeal)
                                {
                                    var lbl   = mealLabels.GetValueOrDefault(mealGroup.Key, mealGroup.Key);
                                    var foods = mealGroup.OrderBy(f => f.DISPLAY_ORDER).ToList();
                                    @foreach (var food in foods)
                                    {
                                        var foodName = food.FOOD_NAME ?? "";
                                        var imgUrl   = food.IS_IMAGE == "Y" && food.FOOD_ID.HasValue
                                            ? Url.Action("GetFoodImage","Image", new { fileName = food.FOOD_ID + ".jpg" }) + "&v=" + DateTimeOffset.UtcNow.ToUnixTimeSeconds()
                                            : null;
                                        <div class="meal-row meal-row-clickable"
                                             data-food-img="@imgUrl"
                                             data-food-name="@foodName"
                                             onclick="openFoodModal(this)">
                                            @if (food.IS_IMAGE == "Y" && food.FOOD_ID.HasValue)
                                            {
                                                <img class="meal-img"
                                                     src="@imgUrl"
                                                     alt="@foodName" loading="lazy"
                                                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                                                <div class="meal-img-ph" style="display:none;">🍴</div>
                                            }
                                            else
                                            {
                                                <div class="meal-img-ph">🍴</div>
                                            }
                                            <div class="meal-info">
                                                <div class="meal-type">@lbl</div>
                                                <div class="meal-name">@foodName</div>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        }
    }

</div>

<script>
const todayNo = @todayNo;

function switchDay(dayNo) {
    document.querySelectorAll('.day-tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.day-content').forEach(c => c.classList.remove('active'));
    const tab     = document.querySelector(`.day-tab[data-day="${dayNo}"]`);
    const content = document.getElementById('day-' + dayNo);
    tab?.classList.add('active');
    content?.classList.add('active');
    tab?.scrollIntoView({ inline: 'center', behavior: 'smooth' });
}

window.addEventListener('DOMContentLoaded', () => {
    const days = [@string.Join(",", Model.Select(m => m.DAY_NO).Distinct().OrderBy(d=>d))];
    if (days.includes(todayNo))       switchDay(todayNo);
    else if (days.length > 0)         switchDay(days[0]);
    loadAllLocks();
});

// ── Check khoá đổi món cho từng ngày trong tuần ────────────────────────
const LOCK_CHECK_URL = '@Url.Action("Check","MealLock")';

function escTxt(s){ return (s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

function isSameWeek(isoDate){
    if (!isoDate) return false;
    const tgt = new Date(isoDate);
    const now = new Date();
    const startOfWeek = (d) => {
        const dt = new Date(d);
        const day = dt.getDay();
        const off = day === 0 ? -6 : 1 - day;
        dt.setDate(dt.getDate() + off);
        dt.setHours(0,0,0,0);
        return dt.getTime();
    };
    return startOfWeek(tgt) === startOfWeek(now);
}

async function loadAllLocks() {
    const tabs = document.querySelectorAll('.day-tab[data-date]');
    for (const tab of tabs) {
        const dateStr = tab.dataset.date;       // YYYYMMDD
        if (!dateStr || dateStr.length !== 8) continue;
        const iso = `${dateStr.slice(0,4)}-${dateStr.slice(4,6)}-${dateStr.slice(6,8)}`;
        try {
            const res = await fetch(`${LOCK_CHECK_URL}?date=${iso}&typeMeal=LUNCH`);
            const d   = await res.json();
            if (!d.success) continue;
            applyLockToDay(tab.dataset.day, iso, d);
        } catch {}
    }
}

function applyLockToDay(dayNo, isoDate, lockInfo) {
    // Chỉ hiện banner cho ngày trong tuần hiện tại (theo yêu cầu).
    // Nếu đang xem "Tuần sau" mà ngày đó chưa tới Mon → ẩn cảnh báo.
    if (!isSameWeek(isoDate)) return;
    const dLabel = isoDate.split('-').reverse().join('/');
    const icon = document.querySelector(`.day-lock-ico[data-lock-day="${dayNo}"]`);
    const banner = document.querySelector(`.lock-banner[data-lock-content="${dayNo}"]`);
    if (lockInfo.locked) {
        if (icon) icon.style.display = '';
        if (banner) {
            const noteLine = lockInfo.note
                ? `<div style="font-weight:500;font-size:.72rem;color:#7f1d1d;margin-top:.2rem;font-style:italic;">📝 ${escTxt(lockInfo.note)}</div>`
                : '';
            banner.style.display = '';
            banner.innerHTML = `
                <div style="background:#fef2f2;border:1.5px solid #fecaca;color:#b91c1c;border-radius:10px;padding:.55rem .75rem;font-size:.8rem;font-weight:700;line-height:1.5;">
                    🔒 Ngày <b>${dLabel}</b> có sự kiện món ăn đặc biệt nên kể từ bây giờ không thể đổi món cho ngày đó. Xin cảm ơn!
                    ${noteLine}
                </div>`;
        }
    } else if (lockInfo.reason && lockInfo.cutoffDt) {
        if (banner) {
            const noteLine = lockInfo.note
                ? `<br><span style="font-style:italic;">📝 ${escTxt(lockInfo.note)}</span>` : '';
            banner.style.display = '';
            banner.innerHTML = `
                <div style="background:#fffbeb;border:1px solid #fde68a;color:#92400e;border-radius:8px;padding:.5rem .75rem;font-size:.78rem;line-height:1.5;">
                    ⏰ Ngày <b>${dLabel}</b> sẽ chốt số lượng — ${escTxt(lockInfo.reason)}.${noteLine}
                </div>`;
        }
    }
}

function openFoodModal(el) {
    const imgUrl = el.dataset.foodImg;
    const name   = el.dataset.foodName || '';
    const modalImg = document.getElementById('foodModalImg');
    const modalPh  = document.getElementById('foodModalPh');
    document.getElementById('foodModalName').textContent = name;
    if (imgUrl) {
        modalImg.style.display = 'block';
        modalPh.style.display  = 'none';
        modalImg.src = imgUrl;
    } else {
        modalImg.style.display = 'none';
        modalPh.style.display  = 'block';
    }
    document.getElementById('foodModal').classList.add('open');
    document.body.style.overflow = 'hidden';
}

function closeFoodModal(e) {
    if (e && e.target !== document.getElementById('foodModal') &&
        !e.target.classList.contains('food-modal-close')) return;
    const sheet = document.getElementById('foodModalSheet');
    sheet.style.transform = 'translateY(100%)';
    setTimeout(() => {
        document.getElementById('foodModal').classList.remove('open');
        sheet.style.transform = '';
        document.body.style.overflow = '';
    }, 280);
}

(function(){
    const sheet = document.getElementById('foodModalSheet');
    let startY = 0;
    sheet.addEventListener('touchstart', e => { startY = e.touches[0].clientY; }, { passive: true });
    sheet.addEventListener('touchend', e => {
        if (e.changedTouches[0].clientY - startY > 80)
            closeFoodModal({ target: document.getElementById('foodModal') });
    }, { passive: true });
})();
</script>
