@model List<HR_web.Models.Menu.MenuDayViewModel>
@{
    ViewData["Title"] = "Thực đơn tuần này";

    var today      = DateTime.Today;
    bool isNextWeek = ViewBag.IsNextWeek == true;
    bool hasNextWeek = ViewBag.HasNextWeek == true;
    bool autoNextWeek = ViewBag.AutoNextWeek == true;
    bool noNextWeekMsg = ViewBag.NoNextWeekMsg == true;
    int todayNo    = isNextWeek ? -1 : ((int)today.DayOfWeek == 0 ? 0 : (int)today.DayOfWeek + 1);

    var dayConfig = new[]
    {
        (2,"Thứ 2"), (3,"Thứ 3"), (4,"Thứ 4"), (5,"Thứ 5"), (6,"Thứ 6"), (7,"Thứ 7"),
    };
    var shifts     = new[] { ("CA1","CA 1 — Ca sáng","#1F4E79"), ("CA2","CA 2 / Tăng ca","#375623"), ("CA3","CA 3 — Ca tối","#7B3F00") };
    var mealLabels = new Dictionary<string,string>
    {
        { "MAN","Món mặn" }, { "DU_KIEN","Dự kiến" }, { "NHE","Món nhẹ" }, { "CHAY","Món chay" }, { "BANH","Suất 2 món Bánh" }
    };
    var activeDays = Model.Select(m => m.DAY_NO).Distinct().OrderBy(d => d).ToHashSet();
    bool isEmpty   = !Model.Any();

    var monday   = (ViewBag.WeekMonday as DateTime?) ?? today.AddDays(-(((int)today.DayOfWeek + 6) % 7));
    var dayDates = new Dictionary<int, string>
    {
        { 2, monday.ToString("yyyyMMdd") },
        { 3, monday.AddDays(1).ToString("yyyyMMdd") },
        { 4, monday.AddDays(2).ToString("yyyyMMdd") },
        { 5, monday.AddDays(3).ToString("yyyyMMdd") },
        { 6, monday.AddDays(4).ToString("yyyyMMdd") },
        { 7, monday.AddDays(5).ToString("yyyyMMdd") },
    };
    // Đồng bộ giao diện với Menu/Today (2026-11-20): cùng màu nhãn món, cùng nút chọn ca, cùng lưới món ảnh to
    var mealColors = new Dictionary<string,(string bg, string fg)>
    {
        { "MAN", ("#FEF3C7","#92400E") }, { "DU_KIEN", ("#DBEAFE","#1E40AF") }, { "NHE", ("#D1FAE5","#065F46") },
        { "CHAY", ("#F0FDF4","#166534") }, { "BANH", ("#FEF9C3","#78350F") },
    };
    var mealIcons = new Dictionary<string,string>
    {
        { "MAN","meal-main" }, { "DU_KIEN","survey" }, { "NHE","meal-light" }, { "CHAY","meal-veg" }, { "BANH","meal-bread" }
    };
    var shiftUi = new[]
    {
        (Key: "CA1", Short: "Ca 1 · Trưa",    Icon: "shift-morning",   Color: "#2563eb", Desc: "Áp dụng cho mọi ca hành chính, ca 1 & ca hành chính"),
        (Key: "CA2", Short: "Ca 2 · Tăng ca", Icon: "shift-afternoon", Color: "#16a34a", Desc: "Chỉ áp dụng nếu có đăng ký tăng ca & ca 2"),
        (Key: "CA3", Short: "Ca 3 · Đêm",     Icon: "shift-night",     Color: "#d97706", Desc: "Phục vụ nhân viên ca 3 / ca đêm"),
    };
    // Ảnh món cache theo NGÀY (trước đây &v=giây → tải lại ảnh mỗi lần mở trang)
    var imgVer = today.ToString("yyyyMMdd");
    string? FoodImg(int? id, string? isImg) => isImg == "Y" && id.HasValue
        ? Url.Action("GetFoodImage", "Image", new { fileName = id + ".jpg" }) + "&v=" + imgVer : null;
    var banhFixed = (ViewBag.BanhFixed as List<HR_web.Models.Menu.MenuBanhFixedSlot> ?? new()).Where(b => b.FoodId.HasValue).ToList();
    var userWeekMeals = ViewBag.UserWeekMeals as Dictionary<string, string> ?? new Dictionary<string, string>();
    var mealBadge = new Dictionary<string, (string label, string bg, string fg)>
    {
        { "M", ("Mặn",  "#fee2e2", "#dc2626") },
        { "C", ("Chay", "#dcfce7", "#16a34a") },
        { "N", ("Nhẹ",  "#dbeafe", "#2563eb") },
        { "B", ("Bánh", "#fefce8", "#d97706") },
    };
}

<style>
    /* ═══ Thực đơn cả tuần — đồng bộ với Menu/Today (2026-11-20) ═══ */
    .tp { max-width: 720px; margin: 0 auto; padding-bottom: 1rem; }
    .tp-top { display: flex; align-items: center; justify-content: space-between; gap: .6rem; margin: .25rem 0 .75rem; }
    .tp-date b { display: block; font-size: 1.25rem; font-weight: 900; color: #0f172a; line-height: 1.2; }
    .tp-date span { font-size: .8rem; color: #64748b; font-weight: 600; }
    .tp-tabs { display: flex; background: #f1f5f9; border-radius: 12px; padding: 3px; gap: 3px; flex-shrink: 0; }
    .tp-tab { padding: 7px 14px; border-radius: 9px; font-size: .85rem; font-weight: 800; color: #64748b; text-decoration: none !important; }
    .tp-tab.active { background: #fff; color: #dc2626; box-shadow: 0 1px 4px rgba(0,0,0,.08); }

    .tp-note { background: #eff6ff; border: 1px solid #bfdbfe; color: #1d4ed8; border-radius: 12px; padding: .55rem .8rem; margin-bottom: .75rem; font-size: .82rem; font-weight: 700; }
    .tp-next { display: flex; align-items: center; gap: .5rem; background: #fff7ed; border: 1.5px dashed #fb923c; border-radius: 14px;
               padding: .65rem .85rem; margin-bottom: .75rem; text-decoration: none !important; color: #c2410c; font-weight: 800; font-size: .88rem; }
    .tp-next span:last-child { margin-left: auto; font-size: 1.2rem; }
    .tp-weeknav { display: inline-flex; align-items: center; gap: 4px; font-size: .8rem; font-weight: 800; color: #dc2626 !important; text-decoration: none !important; margin-bottom: .6rem; }

    /* Thanh chọn ngày */
    .tw-days { display: flex; gap: .4rem; overflow-x: auto; scrollbar-width: none; margin-bottom: .65rem; padding: 2px; }
    .tw-days::-webkit-scrollbar { display: none; }
    .tw-day { flex: 1 0 auto; min-width: 66px; display: flex; flex-direction: column; align-items: center; gap: 2px;
              background: #fff; border: 1.5px solid #e2e8f0; border-radius: 14px; padding: .45rem .35rem; cursor: pointer;
              -webkit-tap-highlight-color: transparent; position: relative; }
    .tw-day b { font-size: .85rem; font-weight: 900; color: #0f172a; }
    .tw-day small { font-size: .7rem; color: #94a3b8; font-weight: 700; }
    .tw-day .chip { font-size: .6rem; font-weight: 800; padding: 1px 6px; border-radius: 6px; }
    .tw-day.today b::after { content: ''; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #dc2626; margin-left: 4px; vertical-align: 2px; }
    .tw-day.active { background: #dc2626; border-color: #dc2626; box-shadow: 0 4px 12px rgba(220,38,38,.25); }
    .tw-day.active b, .tw-day.active small { color: #fff; }
    .tw-day.off { opacity: .45; }
    .tw-day .lk { position: absolute; top: -6px; right: -4px; }
    .tw-day .lk .ic3d { width: 1.1em; height: 1.1em; }

    .tw-mine { display: inline-flex; align-items: center; gap: .35rem; padding: .35rem .75rem; border-radius: 999px; font-size: .8rem; font-weight: 800; margin-bottom: .6rem; }
    .tw-mine .ic3d { width: 1.2em; height: 1.2em; }
    .tw-lock { border-radius: 10px; padding: .5rem .7rem; font-size: .8rem; font-weight: 700; line-height: 1.45; margin-bottom: .6rem; }
    .tw-lock .ic3d { width: 1.2em; height: 1.2em; }

    /* Chọn ca + lưới món (giống Today) */
    .tp-shifts { display: flex; gap: .4rem; overflow-x: auto; scrollbar-width: none; margin-bottom: .6rem; }
    .tp-shifts::-webkit-scrollbar { display: none; }
    .tp-sbtn { flex: 0 0 auto; display: flex; align-items: center; justify-content: center; gap: .35rem;
               border: 1.5px solid #e2e8f0; background: #fff; border-radius: 14px; padding: .55rem .8rem;
               font-size: .88rem; font-weight: 800; color: #475569; white-space: nowrap; }
    .tp-sbtn .ic3d { width: 1.35em; height: 1.35em; }
    .tp-sbtn.active { color: #fff; border-color: transparent; box-shadow: 0 4px 12px rgba(0,0,0,.12); }
    .tp-shift-info { font-size: .8rem; color: #64748b; font-weight: 600; margin: 0 .15rem .6rem; }
    .tp-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .6rem; margin-bottom: 1rem; }
    .tp-food { background: #fff; border-radius: 16px; overflow: hidden; box-shadow: 0 2px 8px rgba(15,23,42,.07);
               cursor: pointer; -webkit-tap-highlight-color: transparent; transition: transform .1s; display: flex; flex-direction: column; }
    .tp-food:active { transform: scale(.97); }
    .tp-food-img { position: relative; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; }
    .tp-food-img > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .tp-food-ini { font-size: 2rem; font-weight: 900; }
    .tp-food-badge { position: absolute; left: 6px; top: 6px; font-size: .68rem; font-weight: 800; padding: 2px 8px;
                     border-radius: 20px; box-shadow: 0 1px 4px rgba(0,0,0,.12); display: inline-flex; align-items: center; gap: 3px; }
    .tp-food-badge .ic3d { width: 1.1em; height: 1.1em; }
    .tp-food-name { overflow-wrap: anywhere; padding: .5rem .6rem .6rem; font-size: .9rem; font-weight: 800; color: #0f172a; line-height: 1.3; }
    @@media (min-width: 600px) { .tp-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    .tp-empty { text-align: center; padding: 2.5rem 1rem; color: #94a3b8; }
    .tp-empty .ic3d { width: 3rem; height: 3rem; display: block; margin: 0 auto .5rem; }
    .day-content { display: none; } .day-content.active { display: block; }

    .food-modal-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,.55); z-index: 1050; display: none; align-items: flex-end; }
    .food-modal-backdrop.open { display: flex; }
    .food-modal-sheet { width: 100%; max-width: 720px; margin: 0 auto; background: #fff; border-radius: 22px 22px 0 0;
                        padding-bottom: env(safe-area-inset-bottom, 12px); max-height: 92dvh; overflow-y: auto; animation: fmUp .28s cubic-bezier(.32,.72,0,1); }
    @@keyframes fmUp { from { transform: translateY(100%); } to { transform: none; } }
    .food-modal-img { width: 100%; max-height: 60vh; object-fit: contain; display: block; background: #f8fafc; }
    .food-modal-body { padding: .9rem 1.1rem 1.2rem; }
    .food-modal-type { font-size: .75rem; font-weight: 800; text-transform: uppercase; color: #dc2626; letter-spacing: .04em; }
    .food-modal-name { font-size: 1.2rem; font-weight: 900; color: #0f172a; line-height: 1.35; }
    .food-modal-close { position: absolute; top: .7rem; right: .7rem; width: 36px; height: 36px; border-radius: 50%; background: rgba(0,0,0,.45);
                        border: none; color: #fff; font-size: 1.05rem; z-index: 1; }
</style>

<div class="food-modal-backdrop" id="foodModal" onclick="closeFoodModal(event)">
    <div class="food-modal-sheet" id="foodModalSheet">
        <div style="position:relative;">
            <button class="food-modal-close" onclick="closeFoodModal()">✕</button>
            <img class="food-modal-img" id="foodModalImg" src="" alt="" />
        </div>
        <div class="food-modal-body">
            <div class="food-modal-type" id="foodModalType"></div>
            <div class="food-modal-name" id="foodModalName"></div>
        </div>
    </div>
</div>

<div class="tp px-2 py-2">
    <div class="tp-top">
        <div class="tp-date">
            <b>@(isNextWeek ? "Tuần sau" : "Tuần này")</b>
            <span>@monday.ToString("dd/MM") – @monday.AddDays(5).ToString("dd/MM/yyyy")</span>
        </div>
        <div class="tp-tabs">
            <a href="@Url.Action("Today")" class="tp-tab">Hôm nay</a>
            <span class="tp-tab active">Cả tuần</span>
        </div>
    </div>

    @if (autoNextWeek)
    {
        <div class="tp-note">@Html.Icon3D("hr-sunday") Hôm nay Chủ nhật — đang hiện sẵn thực đơn <b>tuần sau</b>.</div>
    }
    else if (isNextWeek)
    {
        <a href="@Url.Action("ThisWeek","Menu")" class="tp-weeknav">← Về thực đơn tuần này</a>
    }
    else if (hasNextWeek)
    {
        <a href="@Url.Action("NextWeek","Menu")" class="tp-next">
            @Html.Icon3D("bulletin-comment")<span>Căn tin đã đăng thực đơn tuần sau — bấm để xem</span><span>›</span>
        </a>
    }

    @if (isEmpty)
    {
        <div class="tp-empty">
            @Html.Icon3D("meal-default")
            @if (noNextWeekMsg)
            {
                <p>Hôm nay Chủ nhật — căn tin <b>chưa cập nhật</b> thực đơn tuần sau.<br />Bạn quay lại xem sau nhé!</p>
            }
            else
            {
                <p>Chưa có thực đơn tuần này.</p>
            }
        </div>
    }
    else
    {
        <!-- Chọn ngày -->
        <div class="tw-days" id="dayTabs">
            @foreach (var (dayNo, dayName) in dayConfig)
            {
                bool hasData = activeDays.Contains(dayNo);
                var tabDate  = dayDates.GetValueOrDefault(dayNo, "");
                var dt       = monday.AddDays(dayNo - 2);
                userWeekMeals.TryGetValue(tabDate, out var tabMeal);
                <div class="tw-day day-tab @(hasData ? "" : "off") @(dayNo == todayNo ? "today" : "")"
                     data-day="@dayNo" data-date="@tabDate" onclick="switchDay(@dayNo)">
                    <span class="lk day-lock-ico" data-lock-day="@dayNo" style="display:none">@Html.Icon3D("meal-locked")</span>
                    <b>@dayName.Replace("Thứ ", "T")</b>
                    <small>@dt.ToString("dd/MM")</small>
                    @if (hasData && !string.IsNullOrEmpty(tabMeal) && mealBadge.ContainsKey(tabMeal))
                    {
                        var tc = mealBadge[tabMeal];
                        <span class="chip" style="background:@tc.bg;color:@tc.fg;">@tc.label</span>
                    }
                </div>
            }
        </div>

        <!-- Chọn ca (áp cho mọi ngày, giống trang Hôm nay) -->
        <div class="tp-shifts" id="tpShifts">
            @foreach (var sh in shiftUi)
            {
                if (!Model.Any(m => m.SHIFT == sh.Key)) continue;
                <button type="button" class="tp-sbtn" data-shift="@sh.Key" data-color="@sh.Color">@Html.Icon3D(sh.Icon) @sh.Short</button>
            }
            @if (banhFixed.Any())
            {
                <button type="button" class="tp-sbtn" data-shift="BANH" data-color="#ca8a04">@Html.Icon3D("meal-bread") Bánh</button>
            }
        </div>

        @foreach (var (dayNo, dayName) in dayConfig)
        {
            var dayItems   = Model.Where(m => m.DAY_NO == dayNo).ToList();
            var dayDateKey = dayDates.GetValueOrDefault(dayNo, "");
            <div class="day-content" id="day-@dayNo" data-date="@dayDateKey">
                <div class="lock-banner" data-lock-content="@dayNo" style="display:none;"></div>
                @if (!dayItems.Any())
                {
                    <div class="tp-empty">@Html.Icon3D("leave-today")<p>Ngày nghỉ — không có thực đơn</p></div>
                }
                else
                {
                    userWeekMeals.TryGetValue(dayDateKey, out var userMealCode);
                    if (!string.IsNullOrEmpty(userMealCode) && mealBadge.ContainsKey(userMealCode))
                    {
                        var badge = mealBadge[userMealCode];
                        <div class="tw-mine" style="background:@badge.bg;color:@badge.fg;">@Html.Icon3D("meal-default") Bạn đăng ký: @badge.label</div>
                    }

                    @foreach (var sh in shiftUi)
                    {
                        var items = dayItems.Where(m => m.SHIFT == sh.Key)
                            .OrderBy(m => m.MEAL_TYPE == "MAN" ? 0 : m.MEAL_TYPE == "DU_KIEN" ? 1 : m.MEAL_TYPE == "NHE" ? 2 : m.MEAL_TYPE == "CHAY" ? 3 : 4)
                            .ThenBy(m => m.DISPLAY_ORDER).ToList();
                        <section class="tp-shift-pane" data-pane="@sh.Key" hidden>
                            @if (!items.Any())
                            {
                                <div class="tp-empty" style="padding:1.5rem 1rem"><p>Ca này không có thực đơn ngày này</p></div>
                            }
                            else
                            {
                                <div class="tp-shift-info">@sh.Desc</div>
                                <div class="tp-grid">
                                    @foreach (var food in items)
                                    {
                                        var name   = food.FOOD_NAME ?? "";
                                        var label  = mealLabels.GetValueOrDefault(food.MEAL_TYPE ?? "", food.MEAL_TYPE ?? "");
                                        var colors = mealColors.GetValueOrDefault(food.MEAL_TYPE ?? "", (bg: "#f1f5f9", fg: "#334155"));
                                        var img    = FoodImg(food.FOOD_ID, food.IS_IMAGE);
                                        <div class="tp-food" data-food-img="@img" data-food-name="@name" data-food-type="@label" onclick="openFoodModal(this)">
                                            <div class="tp-food-img" style="background:@colors.bg;">
                                                <span class="tp-food-ini" style="color:@colors.fg;">@(name.Length > 0 ? name[0].ToString().ToUpper() : "?")</span>
                                                @if (img != null)
                                                {
                                                    <img src="@img" alt="@name" loading="lazy" onerror="this.remove()" />
                                                }
                                                <span class="tp-food-badge" style="background:@colors.bg;color:@colors.fg;">@Html.Icon3D(mealIcons.GetValueOrDefault(food.MEAL_TYPE ?? "", "meal-default")) @label</span>
                                            </div>
                                            <div class="tp-food-name">@name</div>
                                        </div>
                                    }
                                </div>
                            }
                        </section>
                    }
                    @if (banhFixed.Any())
                    {
                        <section class="tp-shift-pane" data-pane="BANH" hidden>
                            <div class="tp-shift-info">Suất 2 món Bánh — luôn có mỗi ngày</div>
                            <div class="tp-grid">
                                @foreach (var bf in banhFixed)
                                {
                                    var img = FoodImg(bf.FoodId, bf.IsImage);
                                    <div class="tp-food" data-food-img="@img" data-food-name="@bf.FoodName" data-food-type="Bánh" onclick="openFoodModal(this)">
                                        <div class="tp-food-img" style="background:#FEF9C3;">
                                            <span class="tp-food-ini" style="color:#78350F;">@((bf.FoodName ?? "?").Substring(0, 1).ToUpper())</span>
                                            @if (img != null) { <img src="@img" alt="@bf.FoodName" loading="lazy" onerror="this.remove()" /> }
                                            <span class="tp-food-badge" style="background:#FEF9C3;color:#78350F;">@Html.Icon3D("meal-bread") Bánh</span>
                                        </div>
                                        <div class="tp-food-name">@bf.FoodName</div>
                                    </div>
                                }
                            </div>
                        </section>
                    }
                }
            </div>
        }
    }
</div>

<script>
const todayNo = @todayNo;

function switchDay(dayNo) {
    document.querySelectorAll('.day-tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.day-content').forEach(c => c.classList.remove('active'));
    const tab     = document.querySelector(`.day-tab[data-day="${dayNo}"]`);
    const content = document.getElementById('day-' + dayNo);
    tab?.classList.add('active');
    content?.classList.add('active');
    tab?.scrollIntoView({ inline: 'center', behavior: 'smooth' });
}

window.addEventListener('DOMContentLoaded', () => {
    const days = [@string.Join(",", Model.Select(m => m.DAY_NO).Distinct().OrderBy(d=>d))];
    if (days.includes(todayNo))       switchDay(todayNo);
    else if (days.length > 0)         switchDay(days[0]);
    initShiftTabs();
    loadAllLocks();
});

// ── Check khoá đổi món cho từng ngày trong tuần ────────────────────────
const LOCK_CHECK_URL = '@Url.Action("Check","MealLock")';

function escTxt(s){ return (s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

function isSameWeek(isoDate){
    if (!isoDate) return false;
    const tgt = new Date(isoDate);
    const now = new Date();
    const startOfWeek = (d) => {
        const dt = new Date(d);
        const day = dt.getDay();
        const off = day === 0 ? -6 : 1 - day;
        dt.setDate(dt.getDate() + off);
        dt.setHours(0,0,0,0);
        return dt.getTime();
    };
    return startOfWeek(tgt) === startOfWeek(now);
}

async function loadAllLocks() {
    const tabs = document.querySelectorAll('.day-tab[data-date]');
    for (const tab of tabs) {
        const dateStr = tab.dataset.date;       // YYYYMMDD
        if (!dateStr || dateStr.length !== 8) continue;
        const iso = `${dateStr.slice(0,4)}-${dateStr.slice(4,6)}-${dateStr.slice(6,8)}`;
        try {
            const res = await fetch(`${LOCK_CHECK_URL}?date=${iso}&typeMeal=LUNCH`);
            const d   = await res.json();
            if (!d.success) continue;
            applyLockToDay(tab.dataset.day, iso, d);
        } catch {}
    }
}

function applyLockToDay(dayNo, isoDate, lockInfo) {
    // Chỉ hiện banner cho ngày trong tuần hiện tại (theo yêu cầu).
    // Nếu đang xem "Tuần sau" mà ngày đó chưa tới Mon → ẩn cảnh báo.
    if (!isSameWeek(isoDate)) return;
    const dLabel = isoDate.split('-').reverse().join('/');
    const icon = document.querySelector(`.day-lock-ico[data-lock-day="${dayNo}"]`);
    const banner = document.querySelector(`.lock-banner[data-lock-content="${dayNo}"]`);
    if (lockInfo.locked) {
        if (icon) icon.style.display = '';
        if (banner) {
            const noteLine = lockInfo.note
                ? `<div style="font-weight:500;font-size:.75rem;margin-top:.15rem;font-style:italic;">${escTxt(lockInfo.note)}</div>`
                : '';
            banner.style.display = '';
            banner.innerHTML = `<div class="tw-lock" style="background:#fef2f2;color:#b91c1c;">
                    ${window.ic3d('meal-locked')} Ngày <b>${dLabel}</b> đã khoá đổi món (sự kiện đặc biệt).${noteLine}</div>`;
        }
    } else if (lockInfo.reason && lockInfo.cutoffDt) {
        if (banner) {
            const noteLine = lockInfo.note
                ? `<br><span style="font-style:italic;font-weight:500;">${escTxt(lockInfo.note)}</span>` : '';
            banner.style.display = '';
            banner.innerHTML = `<div class="tw-lock" style="background:#fffbeb;color:#92400e;">
                    ${window.ic3d('overtime')} Ngày <b>${dLabel}</b> sẽ chốt số lượng — ${escTxt(lockInfo.reason)}.${noteLine}</div>`;
        }
    }
}

const NO_IMG = '@Url.Content("~/assets/img/no-food-image.jpg")';
function openFoodModal(el) {
    const img = document.getElementById('foodModalImg');
    img.onerror = function () { this.onerror = null; this.src = NO_IMG; };
    img.src = el.dataset.foodImg || NO_IMG;
    document.getElementById('foodModalName').textContent = el.dataset.foodName || '';
    document.getElementById('foodModalType').textContent = el.dataset.foodType || '';
    document.getElementById('foodModal').classList.add('open');
    document.body.style.overflow = 'hidden';
}

function closeFoodModal(e) {
    if (e && e.target !== document.getElementById('foodModal') &&
        !e.target.classList.contains('food-modal-close')) return;
    document.getElementById('foodModal').classList.remove('open');
    document.body.style.overflow = '';
}

// Chọn ca: dùng CHUNG lựa chọn với trang Hôm nay (cùng localStorage), áp cho mọi ngày trong tuần.
// Chưa chọn thì tự chọn theo giờ (trước 15h Ca 1, 15–21h Ca 2, còn lại Ca 3).
function initShiftTabs() {
    const btns = [...document.querySelectorAll('#tpShifts .tp-sbtn')];
    if (!btns.length) return;
    const KEY = 'menuTodayShift', dayKey = new Date().toDateString();
    function pick(key) {
        btns.forEach(b => { const on = b.dataset.shift === key; b.classList.toggle('active', on); b.style.background = on ? b.dataset.color : ''; });
        document.querySelectorAll('.tp-shift-pane').forEach(p => p.hidden = p.dataset.pane !== key);
    }
    btns.forEach(b => b.addEventListener('click', () => {
        pick(b.dataset.shift);
        try { localStorage.setItem(KEY, JSON.stringify({ d: dayKey, s: b.dataset.shift })); } catch (e) { }
    }));
    let saved = null;
    try { const v = JSON.parse(localStorage.getItem(KEY) || 'null'); if (v && v.d === dayKey) saved = v.s; } catch (e) { }
    const h = new Date().getHours(), byTime = h < 15 ? 'CA1' : h < 21 ? 'CA2' : 'CA3';
    const has = k => btns.some(b => b.dataset.shift === k);
    pick(saved && has(saved) ? saved : has(byTime) ? byTime : btns[0].dataset.shift);
}

(function(){
    const sheet = document.getElementById('foodModalSheet');
    let startY = 0;
    sheet.addEventListener('touchstart', e => { startY = e.touches[0].clientY; }, { passive: true });
    sheet.addEventListener('touchend', e => {
        if (e.changedTouches[0].clientY - startY > 80)
            closeFoodModal({ target: document.getElementById('foodModal') });
    }, { passive: true });
})();
</script>
