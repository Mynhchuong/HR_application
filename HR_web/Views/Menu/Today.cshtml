@model List<HR_web.Models.Menu.MenuDayViewModel>
@{
    ViewData["Title"] = "Thực đơn hôm nay";

    var today    = DateTime.Today;
    var dayNames = new Dictionary<DayOfWeek, string>
    {
        { DayOfWeek.Monday,    "Thứ Hai"  },
        { DayOfWeek.Tuesday,   "Thứ Ba"   },
        { DayOfWeek.Wednesday, "Thứ Tư"   },
        { DayOfWeek.Thursday,  "Thứ Năm"  },
        { DayOfWeek.Friday,    "Thứ Sáu"  },
        { DayOfWeek.Saturday,  "Thứ Bảy"  },
        { DayOfWeek.Sunday,    "Chủ Nhật" },
    };
    var todayLabel = dayNames.GetValueOrDefault(today.DayOfWeek, "Hôm nay");
    var shifts = new[]
    {
        (
            Key: "CA1",
            Title: "Ca 1 — Hành Chính",
            Icon: "shift-morning",
            BgGradient: "linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%)",
            TimeBadge: "Bữa Trưa",
            BadgeIcon: "shift-noon",
            Desc: "Áp dụng cho mọi ca hành chính, ca 1 & ca hành chính"
        ),
        (
            Key: "CA2",
            Title: "Ca 2 — Tăng Ca",
            Icon: "shift-afternoon",
            BgGradient: "linear-gradient(135deg, #15803d 0%, #16a34a 100%)",
            TimeBadge: "Bữa Tăng Ca",
            BadgeIcon: "shift-afternoon",
            Desc: "Chỉ áp dụng nếu có đăng ký tăng ca  & ca 2"
        ),
        (
            Key: "CA3",
            Title: "Ca 3 — Tối & Đêm",
            Icon: "shift-night",
            BgGradient: "linear-gradient(135deg, #b45309 0%, #d97706 100%)",
            TimeBadge: "Bữa Đêm Ca 3",
            BadgeIcon: "shift-night",
            Desc: "Phục vụ nhân viên ca 3 / ca đêm"
        )
    };
    var mealColors = new Dictionary<string,(string bg, string fg)>
    {
        { "MAN",     ("#FEF3C7","#92400E") },
        { "DU_KIEN", ("#DBEAFE","#1E40AF") },
        { "NHE",     ("#D1FAE5","#065F46") },
        { "CHAY",    ("#F0FDF4","#166534") },
        { "BANH",    ("#FEF9C3","#78350F") },
    };
    var mealLabels = new Dictionary<string,string>
    {
        { "MAN","Món mặn" }, { "DU_KIEN","Dự kiến" }, { "NHE","Món nhẹ" }, { "CHAY","Món chay" }, { "BANH","Suất 2 món Bánh" }
    };
    var mealIcons = new Dictionary<string,string>
    {
        { "MAN","meal-main" }, { "DU_KIEN","survey" }, { "NHE","meal-light" }, { "CHAY","meal-veg" }, { "BANH","meal-bread" }
    };
    bool isEmpty = !Model.Any();

    // Âm lịch: nhắc người ăn chay (mùng 1, 14, rằm, cuối tháng) — chốt đổi món là tối HÔM TRƯỚC nên nhắc từ hôm trước
    var lunarToday = HR_web.Helpers.LunarCalendar.FromSolar(today);
    var nextDay    = today.AddDays(today.DayOfWeek == DayOfWeek.Saturday ? 2 : 1);   // CN căn tin nghỉ → nhắc cho thứ Hai
    var lunarNext  = HR_web.Helpers.LunarCalendar.FromSolar(nextDay);
}

<style>
    /* ═══ Thực đơn hôm nay — thiết kế lại 2026-11-20 (khách chê dài, khó xem) ═══
       - Chỉ hiện 1 ca một lúc (chọn bằng nút Ca 1/Ca 2/Ca 3, tự chọn theo giờ hiện tại, nhớ lựa chọn).
       - Món ăn dạng lưới 2 cột, ảnh to (món ăn là thứ cần nhìn hình nhất).
       - "Suất của bạn" + trạng thái khoá đổi món gom vào 1 thẻ ở đầu trang.
       - Ảnh món cache theo ngày (trước đây &v=giây hiện tại → tải lại ảnh MỖI lần mở trang). */
    .tp { max-width: 720px; margin: 0 auto; padding-bottom: 1rem; }
    .tp-top { display: flex; align-items: center; justify-content: space-between; gap: .6rem; margin: .25rem 0 .75rem; }
    .tp-date b { display: block; font-size: 1.25rem; font-weight: 900; color: #0f172a; line-height: 1.2; }
    .tp-date span { font-size: .8rem; color: #64748b; font-weight: 600; }
    .tp-date .lunar { display: block; font-size: .74rem; color: #a16207; font-weight: 700; }
    /* Nhắc ngày chay âm lịch */
    .tp-veg { display: flex; align-items: center; gap: .65rem; background: #f0fdf4; border: 1.5px solid #86efac; border-radius: 14px;
              padding: .65rem .85rem; margin-bottom: .75rem; color: #14532d; font-size: .85rem; font-weight: 700; line-height: 1.45; }
    .tp-veg .moon { font-size: 1.6rem; line-height: 1; flex-shrink: 0; }
    .tp-veg small { display: block; font-weight: 600; color: #166534; font-size: .78rem; }
    .tp-veg a { flex-shrink: 0; margin-left: auto; background: #16a34a; color: #fff !important; font-weight: 800; font-size: .82rem;
                padding: .45rem .75rem; border-radius: 10px; text-decoration: none !important; }
    .tp-tabs { display: flex; background: #f1f5f9; border-radius: 12px; padding: 3px; gap: 3px; flex-shrink: 0; }
    .tp-tab { padding: 7px 14px; border-radius: 9px; font-size: .85rem; font-weight: 800; color: #64748b; text-decoration: none !important; }
    .tp-tab.active { background: #fff; color: #dc2626; box-shadow: 0 1px 4px rgba(0,0,0,.08); }

    /* Thẻ suất ăn của bạn */
    .tp-my { background: linear-gradient(135deg, #991b1b 0%, #dc2626 100%); color: #fff; border-radius: 18px;
             padding: .95rem 1rem; margin-bottom: .75rem; box-shadow: 0 8px 22px rgba(220,38,38,.2); }
    .tp-my-ttl { font-size: .72rem; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; opacity: .85; margin-bottom: .45rem; }
    .tp-my-row { display: flex; align-items: center; gap: .7rem; }
    .tp-my-meals { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: .35rem; }
    .tp-my-meal { display: flex; align-items: center; gap: .5rem; font-weight: 800; font-size: 1rem; line-height: 1.3; }
    .tp-my-meal .ic3d { width: 1.6em; height: 1.6em; flex-shrink: 0; }
    .tp-my-meal small { display: block; font-size: .7rem; font-weight: 700; opacity: .8; text-transform: uppercase; }
    .tp-my-btn { flex-shrink: 0; background: #fff; color: #b91c1c !important; font-weight: 900; font-size: .88rem;
                 padding: .6rem .95rem; border-radius: 12px; text-decoration: none !important; box-shadow: 0 3px 10px rgba(0,0,0,.15); }
    .tp-my.empty { background: #fff; color: #334155; border: 1.5px dashed #fca5a5; box-shadow: none; }
    .tp-my.empty .tp-my-btn { background: #dc2626; color: #fff !important; }
    #todayLockBanner { margin-top: .6rem; }
    .tp-lock { border-radius: 10px; padding: .45rem .65rem; font-size: .8rem; font-weight: 700; line-height: 1.45;
               background: rgba(255,255,255,.16); }
    .tp-my.empty .tp-lock { background: #fef2f2; color: #991b1b; }
    .tp-lock .ic3d { width: 1.2em; height: 1.2em; }

    /* Lịch chốt tuần (thu gọn) */
    .tp-week-lock { background: #fff7ed; border: 1px solid #fed7aa; border-radius: 14px; margin-bottom: .75rem; color: #7c2d12; font-size: .82rem; }
    .tp-week-lock summary { list-style: none; padding: .6rem .85rem; font-weight: 800; color: #9a3412; display: flex; align-items: center; gap: .4rem; cursor: pointer; }
    .tp-week-lock summary::-webkit-details-marker { display: none; }
    .tp-week-lock summary::after { content: '›'; margin-left: auto; font-size: 1.2rem; transition: transform .2s; }
    .tp-week-lock[open] summary::after { transform: rotate(90deg); }
    .tp-week-lock .wl-body { padding: 0 .85rem .7rem; line-height: 1.5; }
    .tp-week-lock .wl-item { padding: .35rem 0; border-top: 1px dashed #fed7aa; }

    /* Chọn ca */
    .tp-shifts { display: flex; gap: .4rem; overflow-x: auto; scrollbar-width: none; margin-bottom: .6rem; }
    .tp-shifts::-webkit-scrollbar { display: none; }
    .tp-sbtn { flex: 0 0 auto; display: flex; align-items: center; justify-content: center; gap: .35rem;
               border: 1.5px solid #e2e8f0; background: #fff; border-radius: 14px; padding: .55rem .8rem;
               font-size: .88rem; font-weight: 800; color: #475569; white-space: nowrap; }
    .tp-sbtn .ic3d { width: 1.35em; height: 1.35em; }
    .tp-sbtn.active { color: #fff; border-color: transparent; box-shadow: 0 4px 12px rgba(0,0,0,.12); }
    .tp-shift-info { font-size: .8rem; color: #64748b; font-weight: 600; margin: 0 .15rem .6rem; }

    /* Lưới món ăn */
    .tp-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .6rem; margin-bottom: 1rem; }
    .tp-food { background: #fff; border-radius: 16px; overflow: hidden; box-shadow: 0 2px 8px rgba(15,23,42,.07);
               cursor: pointer; -webkit-tap-highlight-color: transparent; transition: transform .1s; display: flex; flex-direction: column; }
    .tp-food:active { transform: scale(.97); }
    .tp-food-img { position: relative; aspect-ratio: 4/3; background: #f1f5f9; display: flex; align-items: center; justify-content: center; }
    .tp-food-img > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .tp-food-ini { font-size: 2rem; font-weight: 900; }
    .tp-food-badge { position: absolute; left: 6px; top: 6px; font-size: .68rem; font-weight: 800; padding: 2px 8px;
                     border-radius: 20px; box-shadow: 0 1px 4px rgba(0,0,0,.12); display: inline-flex; align-items: center; gap: 3px; }
    .tp-food-badge .ic3d { width: 1.1em; height: 1.1em; }
    .tp-food-name { overflow-wrap: anywhere; padding: .5rem .6rem .6rem; font-size: .9rem; font-weight: 800; color: #0f172a; line-height: 1.3; }
    @@media (min-width: 600px) { .tp-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

    .tp-empty { text-align: center; padding: 2.5rem 1rem; color: #94a3b8; }
    .tp-empty .ic3d { width: 3rem; height: 3rem; display: block; margin: 0 auto .5rem; }
    .tp-feedback { display: flex; align-items: center; gap: .6rem; background: #fff; border: 1px solid #fed7aa; border-radius: 14px;
                   padding: .7rem .9rem; text-decoration: none !important; color: #9a3412; font-weight: 800; font-size: .88rem; }
    .tp-feedback small { display: block; font-weight: 600; color: #7c2d12; opacity: .8; font-size: .74rem; }
    .tp-feedback .arrow { margin-left: auto; font-size: 1.3rem; }

    /* Xem ảnh món (tấm trượt từ dưới) */
    .food-modal-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,.55); z-index: 1050; display: none; align-items: flex-end; }
    .food-modal-backdrop.open { display: flex; }
    .food-modal-sheet { width: 100%; max-width: 720px; margin: 0 auto; background: #fff; border-radius: 22px 22px 0 0;
                        padding-bottom: env(safe-area-inset-bottom, 12px); max-height: 92dvh; overflow-y: auto; animation: fmUp .28s cubic-bezier(.32,.72,0,1); }
    @@keyframes fmUp { from { transform: translateY(100%); } to { transform: none; } }
    .food-modal-img { width: 100%; max-height: 60vh; object-fit: contain; display: block; background: #f8fafc; }
    .food-modal-body { padding: .9rem 1.1rem 1.2rem; }
    .food-modal-type { font-size: .75rem; font-weight: 800; text-transform: uppercase; color: #dc2626; letter-spacing: .04em; }
    .food-modal-name { font-size: 1.2rem; font-weight: 900; color: #0f172a; line-height: 1.35; }
    .food-modal-close { position: absolute; top: .7rem; right: .7rem; width: 36px; height: 36px; border-radius: 50%; background: rgba(0,0,0,.45);
                        border: none; color: #fff; font-size: 1.05rem; z-index: 1; }
</style>

@{
    var userMeals = ViewBag.UserMeals as List<HR_web.Models.Menu.UserTodayMealModel>;
    var mealEmoji = new Dictionary<string,string> { { "MAN","meal-main" }, { "NHE","meal-light" }, { "CHAY","meal-veg" }, { "BANH","meal-bread" } };
    var banhFixed = (ViewBag.BanhFixed as List<HR_web.Models.Menu.MenuBanhFixedSlot> ?? new()).Where(b => b.FoodId.HasValue).ToList();
    // Ảnh món: cache theo NGÀY (HR đổi ảnh thì hôm sau thấy; trước đây &v=giây → không bao giờ cache)
    var imgVer = today.ToString("yyyyMMdd");
    string? FoodImg(int? id, string? isImg) => isImg == "Y" && id.HasValue
        ? Url.Action("GetFoodImage", "Image", new { fileName = id + ".jpg" }) + "&v=" + imgVer : null;
    var shiftColors = new Dictionary<string,string> { { "CA1", "#2563eb" }, { "CA2", "#16a34a" }, { "CA3", "#d97706" }, { "BANH", "#ca8a04" } };
    var shiftShort  = new Dictionary<string,string> { { "CA1", "Ca 1 · Trưa" }, { "CA2", "Ca 2 · Tăng ca" }, { "CA3", "Ca 3 · Đêm" } };
}

<!-- Xem ảnh món -->
<div class="food-modal-backdrop" id="foodModal" onclick="closeFoodModal(event)">
    <div class="food-modal-sheet">
        <div style="position:relative;">
            <button class="food-modal-close" onclick="closeFoodModal()">✕</button>
            <img class="food-modal-img" id="foodModalImg" src="" alt=""
                 onerror="this.onerror=null;this.src='@Url.Content("~/assets/img/no-food-image.jpg")';" />
        </div>
        <div class="food-modal-body">
            <div class="food-modal-type" id="foodModalType"></div>
            <div class="food-modal-name" id="foodModalName"></div>
        </div>
    </div>
</div>

<div class="tp px-2 py-2">
    <!-- Ngày + chuyển Hôm nay / Cả tuần -->
    <div class="tp-top">
        <div class="tp-date"><b>@todayLabel</b><span>@today.ToString("dd/MM/yyyy")</span><span class="lunar">Âm lịch @lunarToday.Text</span></div>
        <div class="tp-tabs">
            <span class="tp-tab active">Hôm nay</span>
            <a href="@Url.Action("ThisWeek")" class="tp-tab">Cả tuần</a>
        </div>
    </div>

    <!-- Nhắc ngày chay âm lịch -->
    @if (lunarNext.IsVegDay)
    {
        <div class="tp-veg">
            <span class="moon">@lunarNext.Moon</span>
            <span>@(nextDay == today.AddDays(1) ? "Ngày mai" : dayNames[nextDay.DayOfWeek]) (@nextDay.ToString("dd/MM")) là <b>@lunarNext.VegName âm lịch</b> (@lunarNext.Text)
                <small>Ai ăn chay nhớ đổi sang món Chay trước giờ chốt tối nay.</small></span>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a href="@Url.Action("ChangeMeal")">Đổi món</a>
            }
        </div>
    }
    else if (lunarToday.IsVegDay)
    {
        <div class="tp-veg">
            <span class="moon">@lunarToday.Moon</span>
            <span>Hôm nay là <b>@lunarToday.VegName âm lịch</b> (@lunarToday.Text)</span>
        </div>
    }

    <!-- Suất ăn của bạn + trạng thái khoá đổi món -->
    @if (userMeals != null && userMeals.Any())
    {
        var lunch  = userMeals.FirstOrDefault(m => m.SHIFT == "LUNCH") ?? userMeals.First();
        var otMeal = userMeals.FirstOrDefault(m => m.SHIFT == "OT");
        <div class="tp-my">
            <div class="tp-my-ttl">Suất ăn của bạn hôm nay</div>
            <div class="tp-my-row">
                <div class="tp-my-meals">
                    <div class="tp-my-meal">@Html.Icon3D(lunch.FOOD_TYPE != null && mealEmoji.TryGetValue(lunch.FOOD_TYPE, out var eL) ? eL : "meal-default")
                        <span><small>Trưa</small>@lunch.FOOD_NAME</span></div>
                    @if (otMeal != null)
                    {
                        <div class="tp-my-meal">@Html.Icon3D(otMeal.FOOD_TYPE != null && mealEmoji.TryGetValue(otMeal.FOOD_TYPE, out var eO) ? eO : "meal-default")
                            <span><small>Tăng ca</small>@otMeal.FOOD_NAME</span></div>
                    }
                </div>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a href="@Url.Action("ChangeMeal")" class="tp-my-btn">Đổi món</a>
                }
            </div>
            <div id="todayLockBanner" style="display:none"></div>
        </div>
    }
    else if (User.Identity?.IsAuthenticated == true)
    {
        <div class="tp-my empty">
            <div class="tp-my-row">
                <div class="tp-my-meals"><div class="tp-my-meal" style="font-size:.92rem;">Bạn chưa đăng ký suất ăn hôm nay</div></div>
                <a href="@Url.Action("ChangeMeal")" class="tp-my-btn">Chọn món</a>
            </div>
            <div id="todayLockBanner" style="display:none"></div>
        </div>
    }
    else
    {
        <div id="todayLockBanner" style="display:none;margin-bottom:.75rem;"></div>
    }

    <!-- Lịch chốt suất ăn tuần này (thu gọn, bấm mới mở) -->
    <div id="upcomingLockBanner" style="display:none"></div>

    @if (isEmpty && !banhFixed.Any())
    {
        <div class="tp-empty">@Html.Icon3D("meal-default")<p>Chưa có thực đơn hôm nay<br/>hoặc hôm nay là ngày nghỉ.</p></div>
    }
    else
    {
        <!-- Chọn ca: chỉ hiện 1 ca một lúc -->
        <div class="tp-shifts" id="tpShifts">
            @foreach (var sh in shifts)
            {
                if (!Model.Any(m => m.SHIFT == sh.Key)) continue;
                <button type="button" class="tp-sbtn" data-shift="@sh.Key" data-color="@shiftColors[sh.Key]">@Html.Icon3D(sh.Icon) @shiftShort[sh.Key]</button>
            }
            @if (banhFixed.Any())
            {
                <button type="button" class="tp-sbtn" data-shift="BANH" data-color="@shiftColors["BANH"]">@Html.Icon3D("meal-bread") Bánh</button>
            }
        </div>

        @foreach (var sh in shifts)
        {
            var items = Model.Where(m => m.SHIFT == sh.Key)
                .OrderBy(m => m.MEAL_TYPE == "MAN" ? 0 : m.MEAL_TYPE == "DU_KIEN" ? 1 : m.MEAL_TYPE == "NHE" ? 2 : m.MEAL_TYPE == "CHAY" ? 3 : 4)
                .ThenBy(m => m.DISPLAY_ORDER).ToList();
            if (!items.Any()) continue;
            <section class="tp-shift-pane" data-pane="@sh.Key" hidden>
                <div class="tp-shift-info">@sh.Desc</div>
                <div class="tp-grid">
                    @foreach (var food in items)
                    {
                        var name   = food.FOOD_NAME ?? "";
                        var label  = mealLabels.GetValueOrDefault(food.MEAL_TYPE ?? "", food.MEAL_TYPE ?? "");
                        var colors = mealColors.GetValueOrDefault(food.MEAL_TYPE ?? "", (bg: "#f1f5f9", fg: "#334155"));
                        var img    = FoodImg(food.FOOD_ID, food.IS_IMAGE);
                        <div class="tp-food" data-food-img="@img" data-food-name="@name" data-food-type="@label" onclick="openFoodModal(this)">
                            <div class="tp-food-img" style="background:@colors.bg;">
                                <span class="tp-food-ini" style="color:@colors.fg;">@(name.Length > 0 ? name[0].ToString().ToUpper() : "?")</span>
                                @if (img != null)
                                {
                                    <img src="@img" alt="@name" loading="lazy" onerror="this.remove()" />
                                }
                                <span class="tp-food-badge" style="background:@colors.bg;color:@colors.fg;">@Html.Icon3D(mealIcons.GetValueOrDefault(food.MEAL_TYPE ?? "", "meal-default")) @label</span>
                            </div>
                            <div class="tp-food-name">@name</div>
                        </div>
                    }
                </div>
            </section>
        }
        @if (banhFixed.Any())
        {
            <section class="tp-shift-pane" data-pane="BANH" hidden>
                <div class="tp-shift-info">Suất 2 món Bánh — luôn có mỗi ngày</div>
                <div class="tp-grid">
                    @foreach (var b in banhFixed)
                    {
                        var img = FoodImg(b.FoodId, b.IsImage);
                        <div class="tp-food" data-food-img="@img" data-food-name="@b.FoodName" data-food-type="Bánh" onclick="openFoodModal(this)">
                            <div class="tp-food-img" style="background:#FEF9C3;">
                                <span class="tp-food-ini" style="color:#78350F;">@((b.FoodName ?? "?").Substring(0, 1).ToUpper())</span>
                                @if (img != null)
                                {
                                    <img src="@img" alt="@b.FoodName" loading="lazy" onerror="this.remove()" />
                                }
                                <span class="tp-food-badge" style="background:#FEF9C3;color:#78350F;">@Html.Icon3D("meal-bread") Bánh</span>
                            </div>
                            <div class="tp-food-name">@b.FoodName</div>
                        </div>
                    }
                </div>
            </section>
        }
    }

    <!-- Góp ý món ăn -->
    <a href="@Url.Action("Create","EmployeeInquiry", new { topicCd = "CANTEEN", chatType = "DIRECT" })" class="tp-feedback">
        @Html.Icon3D("message")
        <span>Món ăn chưa vừa ý?<small>Nguội, vị lạ, chưa ngon… phản ánh để căn tin cải thiện</small></span>
        <span class="arrow">›</span>
    </a>
</div>

<script>
function escTxt(s){ return (s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

function getWeekRangeIso() {
    const now = new Date();
    const day = now.getDay();                         // 0=CN..6=T7
    const offsetMon = day === 0 ? -6 : 1 - day;
    const mon = new Date(now); mon.setDate(now.getDate() + offsetMon); mon.setHours(0,0,0,0);
    const sat = new Date(mon); sat.setDate(mon.getDate() + 5);
    const fmt = d => `${d.getFullYear()}-${(d.getMonth()+1).toString().padStart(2,'0')}-${d.getDate().toString().padStart(2,'0')}`;
    return { mon: fmt(mon), sat: fmt(sat), monDate: mon, satDate: sat };
}

// ── Check khoá đổi món hôm nay (gộp LUNCH + OT) ───────────────────────
(async function checkTodayLock(){
    const today = new Date();
    const iso = `${today.getFullYear()}-${(today.getMonth()+1).toString().padStart(2,'0')}-${today.getDate().toString().padStart(2,'0')}`;
    try {
        const [resL, resO] = await Promise.all([
            fetch(`@Url.Action("Check","MealLock")?date=${iso}&typeMeal=LUNCH`).then(r => r.json()),
            fetch(`@Url.Action("Check","MealLock")?date=${iso}&typeMeal=OT`).then(r => r.json())
        ]);
        const dLabel = today.toLocaleDateString('vi-VN');
        const banner = document.getElementById('todayLockBanner');

        const lockedScopes = [
            resL?.success && resL.locked ? 'TRƯA' : null,
            resO?.success && resO.locked ? 'TĂNG CA' : null
        ].filter(Boolean);
        const warnScopes = [
            resL?.success && !resL.locked && resL.reason && resL.cutoffDt ? { sc:'TRƯA', d:resL } : null,
            resO?.success && !resO.locked && resO.reason && resO.cutoffDt ? { sc:'TĂNG CA', d:resO } : null
        ].filter(Boolean);

        if (lockedScopes.length > 0) {
            const note = (resL?.note || resO?.note);
            const noteLine = note
                ? `<div style="font-weight:500;font-size:.76rem;margin-top:.15rem;font-style:italic;">${escTxt(note)}</div>`
                : '';
            banner.style.display = 'block';
            banner.innerHTML = `<div class="tp-lock">${window.ic3d('meal-locked')} Đã khoá đổi món hôm nay (${lockedScopes.join(' + ')})${noteLine}</div>`;
            // Hôm nay khoá rồi nhưng vẫn đổi được món cho các ngày sau → giữ nút, đổi chữ cho rõ
            document.querySelectorAll('.tp-my-btn').forEach(b => b.textContent = 'Đổi món ngày khác');
        } else if (warnScopes.length > 0) {
            const lines = warnScopes.map(w => `${w.sc}: ${escTxt(w.d.reason)}`).join('<br>');
            const note = warnScopes[0].d.note;
            const noteLine = note
                ? `<br><span style="font-style:italic;font-weight:500;">${escTxt(note)}</span>` : '';
            banner.style.display = 'block';
            banner.innerHTML = `<div class="tp-lock">${window.ic3d('overtime')} Sắp chốt đổi món hôm nay:<br>${lines}${noteLine}</div>`;
        }
    } catch {}
})();

// ── "Sắp tới trong tuần này" ──────────────────────────────────────────
(async function loadUpcomingLocks(){
    const w = getWeekRangeIso();
    try {
        const res = await fetch(`@Url.Action("List","MealLock")?from=${w.mon}&to=${w.sat}`);
        const d   = await res.json();
        if (!d.success || !d.data) return;

        const today0 = new Date(); today0.setHours(0,0,0,0);
        const upcoming = d.data
            .filter(r => r.isActive && (r.lockLunch || r.lockOt))
            .filter(r => new Date(r.lockDate) >= today0
                       && new Date(r.lockDate).toDateString() !== today0.toDateString())
            .sort((a,b) => new Date(a.lockDate) - new Date(b.lockDate));

        if (upcoming.length === 0) return;

        const dayFullNames = ['Chủ nhật', 'Thứ 2', 'Thứ 3', 'Thứ 4', 'Thứ 5', 'Thứ 6', 'Thứ 7'];
        const fmtShortDate = (dStr) => {
            const dt = new Date(dStr);
            const dd = String(dt.getDate()).padStart(2, '0');
            const mo = String(dt.getMonth() + 1).padStart(2, '0');
            return `${dd}/${mo}`;
        };

        const items = upcoming.map(r => {
            const dMeal = new Date(r.lockDate);
            const mealDayStr = `${dayFullNames[dMeal.getDay()]} (${fmtShortDate(r.lockDate)})`;

            let mealType = '';
            if (r.lockLunch && r.lockOt) mealType = 'Ăn Trưa & Tăng Ca';
            else if (r.lockLunch) mealType = 'Ăn Trưa';
            else if (r.lockOt) mealType = 'Suất Tăng Ca';
            else mealType = 'Suất Ăn';

            let cutLine = '';
            if (r.cutoffDt) {
                const dCut = new Date(r.cutoffDt);
                const cutDow = dayFullNames[dCut.getDay()];
                const hh = String(dCut.getHours()).padStart(2, '0');
                const mm = String(dCut.getMinutes()).padStart(2, '0');
                const cutDateStr = fmtShortDate(r.cutoffDt);
                cutLine = `Khóa đổi món lúc <strong style="color:#c2410c;">${hh}:${mm} ${cutDow} (${cutDateStr})</strong>`;
            } else {
                cutLine = `<strong style="color:#dc2626;">Khoá đổi món cả ngày</strong>`;
            }

            const noteLine = r.note ? `<div style="font-size:0.75rem;color:#9a3412;margin-top:2px;font-style:italic;">${window.ic3d('survey')} ${escTxt(r.note)}</div>` : '';

            return `<div class="wl-item"><strong>${mealType} ${mealDayStr}</strong>: ${cutLine}${noteLine}</div>`;
        }).join('');

        const banner = document.getElementById('upcomingLockBanner');
        banner.style.display = 'block';
        // Thu gọn mặc định — bấm mới mở (trước đây khung to luôn chiếm đầu trang)
        banner.innerHTML = `<details class="tp-week-lock"><summary>${window.ic3d('overtime')} Lịch chốt suất ăn tuần này (${upcoming.length})</summary><div class="wl-body">${items}</div></details>`;
    } catch {}
})();

function openFoodModal(el) {
    const imgEl = document.getElementById('foodModalImg');
    imgEl.onerror = function () { this.onerror = null; this.src = '@Url.Content("~/assets/img/no-food-image.jpg")'; };
    imgEl.src = el.getAttribute('data-food-img') || '@Url.Content("~/assets/img/no-food-image.jpg")';
    document.getElementById('foodModalName').textContent = el.getAttribute('data-food-name') || '';
    document.getElementById('foodModalType').textContent = el.getAttribute('data-food-type') || '';
    document.getElementById('foodModal').classList.add('open');
    document.body.style.overflow = 'hidden';
}

function closeFoodModal(e) {
    if (!e || e.target.id === 'foodModal' || e.target.classList.contains('food-modal-close')) {
        document.getElementById('foodModal').classList.remove('open');
        document.body.style.overflow = '';
    }
}

// ── Chọn ca: chỉ hiện 1 ca. Mặc định theo giờ hiện tại (trước 15h → Ca 1, 15h–21h → Ca 2, còn lại → Ca 3),
//    bấm chọn ca khác thì nhớ trong NGÀY hôm đó (hôm sau lại tự chọn theo giờ).
(function initShiftTabs() {
    const btns = [...document.querySelectorAll('#tpShifts .tp-sbtn')];
    if (!btns.length) return;
    const KEY = 'menuTodayShift', dayKey = new Date().toDateString();
    function pick(key) {
        btns.forEach(b => {
            const on = b.dataset.shift === key;
            b.classList.toggle('active', on);
            b.style.background = on ? b.dataset.color : '';
        });
        document.querySelectorAll('.tp-shift-pane').forEach(p => p.hidden = p.dataset.pane !== key);
    }
    btns.forEach(b => b.addEventListener('click', () => {
        pick(b.dataset.shift);
        try { localStorage.setItem(KEY, JSON.stringify({ d: dayKey, s: b.dataset.shift })); } catch (e) { }
    }));
    let saved = null;
    try { const v = JSON.parse(localStorage.getItem(KEY) || 'null'); if (v && v.d === dayKey) saved = v.s; } catch (e) { }
    const h = new Date().getHours();
    const byTime = h < 15 ? 'CA1' : h < 21 ? 'CA2' : 'CA3';
    const has = k => btns.some(b => b.dataset.shift === k);
    pick(saved && has(saved) ? saved : has(byTime) ? byTime : btns[0].dataset.shift);
})();
</script>
