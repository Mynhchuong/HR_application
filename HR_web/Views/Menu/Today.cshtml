@model List<HR_web.Models.Menu.MenuDayViewModel>
@{
    ViewData["Title"] = "Thực đơn hôm nay";

    var today    = DateTime.Today;
    var dayNames = new Dictionary<DayOfWeek, string>
    {
        { DayOfWeek.Monday,    "Thứ Hai"  },
        { DayOfWeek.Tuesday,   "Thứ Ba"   },
        { DayOfWeek.Wednesday, "Thứ Tư"   },
        { DayOfWeek.Thursday,  "Thứ Năm"  },
        { DayOfWeek.Friday,    "Thứ Sáu"  },
        { DayOfWeek.Saturday,  "Thứ Bảy"  },
        { DayOfWeek.Sunday,    "Chủ Nhật" },
    };
    var todayLabel = dayNames.GetValueOrDefault(today.DayOfWeek, "Hôm nay");
    var shifts = new[]
    {
        (
            Key: "CA1",
            Title: "Ca 1 — Hành Chính",
            Icon: "🌅",
            BgGradient: "linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%)",
            TimeBadge: "☀️ Bữa Trưa",
            Desc: "Áp dụng cho mọi ca hành chính, ca 1 & ca 2"
        ),
        (
            Key: "CA2",
            Title: "Ca 2 — Tăng Ca",
            Icon: "🌆",
            BgGradient: "linear-gradient(135deg, #15803d 0%, #16a34a 100%)",
            TimeBadge: "🌇 Bữa Tăng Ca",
            Desc: "Chỉ áp dụng nếu có đăng ký tăng ca — không liên quan ca làm việc chính"
        ),
        (
            Key: "CA3",
            Title: "Ca 3 — Tối & Đêm",
            Icon: "🌙",
            BgGradient: "linear-gradient(135deg, #b45309 0%, #d97706 100%)",
            TimeBadge: "🌃 Bữa Đêm Ca 3",
            Desc: "Phục vụ nhân viên ca 3 / ca đêm"
        )
    };
    var mealColors = new Dictionary<string,(string bg, string fg)>
    {
        { "MAN",     ("#FEF3C7","#92400E") },
        { "DU_KIEN", ("#DBEAFE","#1E40AF") },
        { "NHE",     ("#D1FAE5","#065F46") },
        { "CHAY",    ("#F0FDF4","#166534") },
    };
    var mealLabels = new Dictionary<string,string>
    {
        { "MAN","🍖 Món mặn" }, { "DU_KIEN","📋 Dự kiến" }, { "NHE","🥗 Món nhẹ" }, { "CHAY","🥦 Món chay" }
    };
    bool isEmpty = !Model.Any();
}

<style>
    :root { 
        --primary-red: #dc2626; 
        --primary-red-dark: #991b1b;
        --card-radius: 18px;
    }

    .tp { max-width: 680px; margin: 0 auto; padding-bottom: 4rem; }

    /* Hero Header */
    .tp-hero {
        background: linear-gradient(135deg, #991b1b 0%, #dc2626 100%);
        border-radius: var(--card-radius); 
        padding: 1.25rem 1.4rem;
        color: #fff; 
        margin-bottom: 0.85rem;
        box-shadow: 0 10px 25px rgba(220, 38, 38, 0.18);
        position: relative;
        overflow: hidden;
    }
    .tp-hero::after {
        content: '🍱';
        position: absolute;
        right: -10px;
        bottom: -15px;
        font-size: 5.5rem;
        opacity: 0.18;
        pointer-events: none;
        transform: rotate(-10deg);
    }
    .tp-hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 0.7rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        background: rgba(255,255,255,0.2);
        padding: 3px 10px;
        border-radius: 20px;
        margin-bottom: 0.4rem;
        backdrop-filter: blur(4px);
    }
    .tp-hero-day { font-size: 1.4rem; font-weight: 900; letter-spacing: -0.3px; line-height: 1.2; }
    .tp-hero-full { font-size: 0.78rem; opacity: 0.88; font-weight: 500; margin-top: 2px; }

    /* Tabs */
    .tp-tabs {
        display: flex; 
        background: #f1f5f9; 
        border-radius: 14px;
        padding: 4px; 
        margin-bottom: 0.85rem; 
        gap: 4px;
    }
    .tp-tab {
        flex: 1; text-align: center; min-height: 42px;
        display: flex; align-items: center; justify-content: center;
        border-radius: 11px; font-size: 0.875rem; font-weight: 700;
        text-decoration: none !important; color: #64748b;
        transition: all 0.2s ease;
        -webkit-tap-highlight-color: transparent;
    }
    .tp-tab.active { 
        background: white; 
        color: #dc2626; 
        box-shadow: 0 2px 8px rgba(0,0,0,0.08); 
    }

    /* Registered My Meal Card */
    .tp-mymeal {
        background: #ffffff;
        border: 1.5px solid #fecaca;
        border-radius: var(--card-radius);
        padding: 1rem 1.15rem;
        margin-bottom: 0.85rem;
        box-shadow: 0 4px 15px rgba(220, 38, 38, 0.06);
        position: relative;
    }
    .tp-mymeal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.65rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px dashed #fee2e2;
    }
    .tp-mymeal-ttl { 
        font-size: 0.72rem; 
        font-weight: 800; 
        color: #991b1b;
        text-transform: uppercase; 
        letter-spacing: 0.05em; 
    }
    .tp-mymeal-status {
        font-size: 0.68rem;
        font-weight: 800;
        color: #166534;
        background: #dcfce7;
        padding: 2px 8px;
        border-radius: 12px;
    }
    .tp-mymeal-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.85rem;
    }
    .tp-mymeal-left { flex: 1; min-width: 0; }
    .tp-mymeal-item {
        font-size: 0.92rem;
        font-weight: 700;
        color: #1e293b;
        line-height: 1.4;
        margin-bottom: 0.25rem;
    }
    .tp-mymeal-item:last-child { margin-bottom: 0; }
    .tp-mymeal-label { color: #64748b; font-weight: 600; font-size: 0.85rem; }
    .tp-mymeal-val { color: #dc2626; font-weight: 900; }
    .tp-mymeal-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: #dc2626;
        color: white !important;
        font-size: 0.8rem;
        font-weight: 700;
        padding: 7px 14px;
        border-radius: 20px;
        text-decoration: none !important;
        box-shadow: 0 3px 10px rgba(220, 38, 38, 0.22);
        white-space: nowrap;
        transition: all 0.2s ease;
        flex-shrink: 0;
    }
    .tp-mymeal-btn:hover { background: #b91c1c; transform: translateY(-1px); }

    /* Feedback CTA */
    .tp-feedback {
        display: flex; align-items: center; gap: 0.75rem;
        background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
        border: 1px solid #fed7aa; 
        border-radius: var(--card-radius);
        padding: 0.85rem 1.1rem; 
        margin-bottom: 1rem;
        text-decoration: none !important; color: inherit;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .tp-feedback:hover, .tp-feedback:active {
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(234,88,12,0.15);
    }
    .tp-feedback-icon  { font-size: 1.6rem; line-height: 1; flex-shrink: 0; }
    .tp-feedback-body  { flex: 1; min-width: 0; }
    .tp-feedback-title { font-weight: 800; color: #9a3412; font-size: 0.88rem; line-height: 1.3; }
    .tp-feedback-desc  { font-size: 0.72rem; color: #7c2d12; line-height: 1.4; margin-top: 1px; opacity: 0.85; }
    .tp-feedback-arrow { font-size: 1.3rem; color: #c2410c; font-weight: 900; line-height: 1; flex-shrink: 0; }

    /* Shift header decoration */
    .tp-shift {
        border-radius: var(--card-radius);
        overflow: hidden;
        box-shadow: 0 4px 16px rgba(0,0,0,0.06);
        margin-bottom: 1rem;
        border: 1px solid #e2e8f0;
        background: white;
    }
    .tp-shift-hd {
        padding: 0.75rem 1rem;
        color: white;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        position: relative;
        overflow: hidden;
    }
    .tp-shift-hd::after {
        content: '';
        position: absolute;
        top: -50%;
        right: -10%;
        width: 120px;
        height: 120px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 50%;
        pointer-events: none;
    }
    .tp-shift-hd-left {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        min-width: 0;
    }
    .tp-shift-icon {
        font-size: 1.4rem;
        line-height: 1;
        width: 38px;
        height: 38px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.22);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    .tp-shift-title {
        font-weight: 900;
        font-size: 0.95rem;
        letter-spacing: 0.01em;
        line-height: 1.25;
        color: #fff;
    }
    .tp-shift-desc {
        font-size: 0.68rem;
        opacity: 0.9;
        font-weight: 500;
        margin-top: 1px;
        color: #fff;
    }
    .tp-shift-pill {
        font-size: 0.7rem;
        font-weight: 800;
        padding: 4px 10px;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.22);
        border: 1px solid rgba(255, 255, 255, 0.35);
        color: white;
        white-space: nowrap;
        backdrop-filter: blur(4px);
        box-shadow: 0 2px 6px rgba(0,0,0,0.08);
        flex-shrink: 0;
    }

    /* Meal row */
    .tp-meal {
        display: flex; align-items: center; gap: 0.85rem;
        padding: 0.8rem 1rem; background: white;
        border-bottom: 1px solid #f1f5f9; min-height: 58px;
        transition: background 0.15s ease;
        cursor: pointer;
    }
    .tp-meal:last-child { border-bottom: none; }
    .tp-meal:hover, .tp-meal:active { background: #f8fafc; }

    .tp-meal-img {
        width: 56px; height: 56px; border-radius: 12px;
        object-fit: cover; flex-shrink: 0; background: #f1f5f9;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05);
    }
    .tp-meal-ph {
        width: 56px; height: 56px; border-radius: 12px;
        background: #f1f5f9; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.4rem; color: #cbd5e1;
    }

    .tp-meal-body  { flex: 1; min-width: 0; }
    .tp-meal-badge {
        display: inline-block; font-size: 0.65rem; font-weight: 800;
        padding: 2px 8px; border-radius: 20px; margin-bottom: 3px;
        letter-spacing: 0.03em;
    }
    .tp-meal-name  { font-size: 0.92rem; font-weight: 700; color: #0f172a; line-height: 1.35; }
    .tp-meal-action {
        font-size: 0.75rem; color: #94a3b8; font-weight: 600;
        display: flex; align-items: center; gap: 2px;
        flex-shrink: 0;
    }

    /* Empty */
    .tp-empty { text-align: center; padding: 3.5rem 1rem; color: #94a3b8; }
    .tp-empty-icon { font-size: 3.5rem; display: block; margin-bottom: 0.6rem; }

    /* Food modal bottom-sheet */
    .food-modal-backdrop {
        position: fixed; inset: 0; background: rgba(0,0,0,.55);
        z-index: 1050; display: none; align-items: flex-end;
        backdrop-filter: blur(3px);
    }
    .food-modal-backdrop.open { display: flex; }
    .food-modal-sheet {
        width: 100%; background: white;
        border-radius: 24px 24px 0 0;
        padding: 0 0 env(safe-area-inset-bottom,16px);
        transform: translateY(100%);
        transition: transform .3s cubic-bezier(.32,.72,0,1);
        max-height: 92dvh; overflow-y: auto;
    }
    .food-modal-backdrop.open .food-modal-sheet { transform: translateY(0); }
    .food-modal-handle {
        width: 40px; height: 4px; background: #e2e8f0;
        border-radius: 2px; margin: 10px auto 0;
    }
    .food-modal-img {
        width: 100%; max-height: 280px; object-fit: contain;
        border-radius: 0; display: block; background: #f8fafc;
    }
    .food-modal-img-ph {
        width: 100%; max-height: 280px; object-fit: cover; display: block;
        border-radius: 0;
    }
    .food-modal-body { padding: 1rem 1.25rem 1.5rem; }
    .food-modal-name {
        font-size: 1.1rem; font-weight: 900; color: #1e293b;
        line-height: 1.35; margin-bottom: .5rem;
    }
    .food-modal-wow {
        font-size: .95rem; font-weight: 700; font-style: italic;
        color: var(--primary-red); display: flex; align-items: center; gap: .35rem;
    }
    .food-modal-close {
        position: absolute; top: .75rem; right: .75rem;
        width: 32px; height: 32px; border-radius: 50%;
        background: rgba(0,0,0,.35); border: none;
        display: flex; align-items: center; justify-content: center;
        color: white; font-size: 1rem; cursor: pointer; z-index: 1;
    }
</style>

<!-- Food detail modal -->
<div class="food-modal-backdrop" id="foodModal" onclick="closeFoodModal(event)">
    <div class="food-modal-sheet" id="foodModalSheet">
        <div class="food-modal-handle"></div>
        <div style="position:relative;">
            <button class="food-modal-close" onclick="closeFoodModal()">✕</button>
            <img class="food-modal-img" id="foodModalImg" src="" alt=""
                 onerror="this.style.display='none';document.getElementById('foodModalPh').style.display='block';" />
            <img class="food-modal-img-ph" id="foodModalPh"
                 src="@Url.Content("~/assets/img/no-food-image.jpg")" alt="Chưa cập nhật hình"
                 style="display:none;" />
        </div>
        <div class="food-modal-body">
            <div class="food-modal-name" id="foodModalName"></div>
            <div class="food-modal-wow">😍 waooooo nhìn ngon miệng quá</div>
        </div>
    </div>
</div>

<div class="tp px-2 py-2">

    <!-- 1. Hero Header -->
    <div class="tp-hero">
        <div class="tp-hero-badge">🍱 THỰC ĐƠN HÔM NAY</div>
        <div class="tp-hero-day">@todayLabel</div>
        <div class="tp-hero-full">@today.ToString("dd/MM/yyyy")</div>
    </div>

    <!-- 2. Tabs Switch -->
    <div class="tp-tabs">
        <div class="tp-tab active">Hôm nay</div>
        <a href="@Url.Action("ThisWeek")" class="tp-tab">Cả tuần</a>
    </div>

    <!-- Lock Banners -->
    <div id="todayLockBanner" style="display:none;margin-bottom:.75rem;"></div>
    <div id="upcomingLockBanner" style="display:none;margin-bottom:.75rem;"></div>

    <!-- 3. Registered Meal Card (Tích hợp nút Đổi món) -->
    @{
        var userMeals = ViewBag.UserMeals as List<HR_web.Models.Menu.UserTodayMealModel>;
        var mealEmoji = new Dictionary<string,string>
        { { "MAN","🍖" }, { "NHE","🥗" }, { "CHAY","🥦" } };
    }

    @if (userMeals != null && userMeals.Any())
    {
        var lunch = userMeals.FirstOrDefault(m => m.SHIFT == "LUNCH") ?? userMeals.First();
        var otMeal = userMeals.FirstOrDefault(m => m.SHIFT == "OT");
        var emojiL = lunch.FOOD_TYPE != null && mealEmoji.TryGetValue(lunch.FOOD_TYPE, out var emL) ? emL : "🍽️";
        var emojiO = otMeal?.FOOD_TYPE != null && mealEmoji.TryGetValue(otMeal.FOOD_TYPE, out var emO) ? emO : "🍽️";

        <div class="tp-mymeal">
            <div class="tp-mymeal-header">
                <div class="tp-mymeal-ttl">📌 Suất ăn bạn đã đăng ký</div>
                <span class="tp-mymeal-status">✓ Đã ghi nhận</span>
            </div>
            <div class="tp-mymeal-content">
                <div class="tp-mymeal-left">
                    <div class="tp-mymeal-item">
                        <span class="tp-mymeal-label">Trưa: </span>
                        <span class="tp-mymeal-val">@emojiL @lunch.FOOD_NAME</span>
                    </div>
                    @if (otMeal != null)
                    {
                        <div class="tp-mymeal-item">
                            <span class="tp-mymeal-label">Tăng ca: </span>
                            <span class="tp-mymeal-val">@emojiO @otMeal.FOOD_NAME</span>
                        </div>
                    }
                </div>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a href="@Url.Action("ChangeMeal")" class="tp-mymeal-btn">
                        <span>🔄 Đổi món</span>
                    </a>
                }
            </div>
        </div>
    }
    else if (User.Identity?.IsAuthenticated == true)
    {
        <div class="tp-mymeal" style="border-style: dashed; background: #fafafa;">
            <div class="tp-mymeal-content">
                <div class="tp-mymeal-left">
                    <div class="tp-mymeal-item" style="font-size:0.85rem; color:#64748b;">
                        Bạn chưa đăng ký suất ăn nào cho hôm nay.
                    </div>
                </div>
                <a href="@Url.Action("ChangeMeal")" class="tp-mymeal-btn">
                    <span>➕ Chọn món</span>
                </a>
            </div>
        </div>
    }

    <!-- 4. Feedback CTA -->
    <a href="@Url.Action("Create","EmployeeInquiry", new { topicCd = "CANTEEN", chatType = "DIRECT" })" class="tp-feedback">
        <div class="tp-feedback-icon">💬</div>
        <div class="tp-feedback-body">
            <div class="tp-feedback-title">Món ăn hôm nay chưa vừa ý?</div>
            <div class="tp-feedback-desc">Nguội, có vị lạ, chưa ngon… Hãy phản ánh để chúng tôi cải thiện.</div>
        </div>
        <span class="tp-feedback-arrow">›</span>
    </a>

    <!-- 5. Shifts Food Menu -->
    @if (isEmpty)
    {
        <div class="tp-empty">
            <span class="tp-empty-icon">🍽️</span>
            <p>Chưa có thực đơn hôm nay<br/>hoặc hôm nay là ngày nghỉ.</p>
        </div>
    }
    else
    {
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.5rem;padding:0 4px;">
            <span style="font-size:.8rem;font-weight:800;color:#475569;text-transform:uppercase;letter-spacing:.04em;">Thực đơn các ca</span>
            <span style="font-size:.72rem;color:#94a3b8;">👆 Nhấn vào món ăn để xem hình</span>
        </div>

        @foreach (var shift in shifts)
        {
            var shiftItems = Model.Where(m => m.SHIFT == shift.Key).ToList();
            if (!shiftItems.Any()) continue;

            var byMeal = shiftItems
                .GroupBy(m => m.MEAL_TYPE)
                .OrderBy(g => g.Key == "MAN" ? 0 : g.Key == "DU_KIEN" ? 1 : g.Key == "NHE" ? 2 : 3)
                .ToList();

            <div class="tp-shift">
                <div class="tp-shift-hd" style="background:@shift.BgGradient;">
                    <div class="tp-shift-hd-left">
                        <span class="tp-shift-icon">@shift.Icon</span>
                        <div>
                            <div class="tp-shift-title">@shift.Title</div>
                            <div class="tp-shift-desc">@shift.Desc</div>
                        </div>
                    </div>
                    <span class="tp-shift-pill">@shift.TimeBadge</span>
                </div>
                @foreach (var grp in byMeal)
                {
                    var label  = mealLabels.GetValueOrDefault(grp.Key, grp.Key);
                    var colors = mealColors.GetValueOrDefault(grp.Key, (bg: "#f1f5f9", fg: "#334155"));
                    var foods  = grp.OrderBy(f => f.DISPLAY_ORDER).ToList();
                    @foreach (var food in foods)
                    {
                        var foodName = food.FOOD_NAME ?? "";
                        var initial  = foodName.Length > 0 ? foodName[0].ToString().ToUpper() : "?";
                        var imgUrl   = food.IS_IMAGE == "Y" && food.FOOD_ID.HasValue
                            ? Url.Action("GetFoodImage","Image", new { fileName = food.FOOD_ID + ".jpg" }) + "&v=" + DateTimeOffset.UtcNow.ToUnixTimeSeconds()
                            : null;
                        <div class="tp-meal"
                             data-food-img="@imgUrl"
                             data-food-name="@foodName"
                             onclick="openFoodModal(this)">
                            @if (food.IS_IMAGE == "Y" && food.FOOD_ID.HasValue)
                            {
                                <img class="tp-meal-img"
                                     src="@imgUrl"
                                     alt="@foodName" loading="lazy"
                                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                                <div class="tp-meal-ph" style="display:none;background:@colors.bg;">
                                    <span style="color:@colors.fg;font-size:1.1rem;font-weight:900;">@initial</span>
                                </div>
                            }
                            else
                            {
                                <div class="tp-meal-ph" style="background:@colors.bg;">
                                    <span style="color:@colors.fg;font-size:1.1rem;font-weight:900;">@initial</span>
                                </div>
                            }
                            <div class="tp-meal-body">
                                <span class="tp-meal-badge"
                                      style="background:@colors.bg; color:@colors.fg;">@label</span>
                                <div class="tp-meal-name">@foodName</div>
                            </div>
                            <div class="tp-meal-action">
                                <span>Xem</span>
                                <i class="bi bi-chevron-right" style="font-size:.7rem;"></i>
                            </div>
                        </div>
                    }
                }
            </div>
        }
    }

    <p class="tp-tagline">✨ Chúc quý cán bộ công nhân viên một bữa ăn ngon miệng!</p>

</div>

<script>
function escTxt(s){ return (s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

function getWeekRangeIso() {
    const now = new Date();
    const day = now.getDay();                         // 0=CN..6=T7
    const offsetMon = day === 0 ? -6 : 1 - day;
    const mon = new Date(now); mon.setDate(now.getDate() + offsetMon); mon.setHours(0,0,0,0);
    const sat = new Date(mon); sat.setDate(mon.getDate() + 5);
    const fmt = d => `${d.getFullYear()}-${(d.getMonth()+1).toString().padStart(2,'0')}-${d.getDate().toString().padStart(2,'0')}`;
    return { mon: fmt(mon), sat: fmt(sat), monDate: mon, satDate: sat };
}

// ── Check khoá đổi món hôm nay (gộp LUNCH + OT) ───────────────────────
(async function checkTodayLock(){
    const today = new Date();
    const iso = `${today.getFullYear()}-${(today.getMonth()+1).toString().padStart(2,'0')}-${today.getDate().toString().padStart(2,'0')}`;
    try {
        const [resL, resO] = await Promise.all([
            fetch(`@Url.Action("Check","MealLock")?date=${iso}&typeMeal=LUNCH`).then(r => r.json()),
            fetch(`@Url.Action("Check","MealLock")?date=${iso}&typeMeal=OT`).then(r => r.json())
        ]);
        const dLabel = today.toLocaleDateString('vi-VN');
        const banner = document.getElementById('todayLockBanner');

        const lockedScopes = [
            resL?.success && resL.locked ? 'TRƯA' : null,
            resO?.success && resO.locked ? 'TĂNG CA' : null
        ].filter(Boolean);
        const warnScopes = [
            resL?.success && !resL.locked && resL.reason && resL.cutoffDt ? { sc:'TRƯA', d:resL } : null,
            resO?.success && !resO.locked && resO.reason && resO.cutoffDt ? { sc:'TĂNG CA', d:resO } : null
        ].filter(Boolean);

        if (lockedScopes.length > 0) {
            const note = (resL?.note || resO?.note);
            const noteLine = note
                ? `<div style="font-weight:500;font-size:.76rem;color:#991b1b;margin-top:.2rem;font-style:italic;">📝 ${escTxt(note)}</div>`
                : '';
            banner.style.display = 'block';
            banner.innerHTML = `
                <div style="background:#fef2f2;border:1px solid #fecaca;color:#991b1b;border-radius:14px;padding:.75rem .95rem;font-size:.82rem;font-weight:700;line-height:1.5;box-shadow:0 2px 8px rgba(220,38,38,0.08);">
                    🔒 Hôm nay (<b>${dLabel}</b>) đã khóa đổi món <span style="color:#7f1d1d">[${lockedScopes.join(' + ')}]</span> — không thể thay đổi món ăn nữa.
                    ${noteLine}
                </div>`;
        } else if (warnScopes.length > 0) {
            const lines = warnScopes.map(w => `${w.sc}: ${escTxt(w.d.reason)}`).join('<br>');
            const note = warnScopes[0].d.note;
            const noteLine = note
                ? `<br><span style="font-style:italic;">📝 ${escTxt(note)}</span>` : '';
            banner.style.display = 'block';
            banner.innerHTML = `
                <div style="background:#fffbeb;border:1px solid #fde68a;color:#92400e;border-radius:14px;padding:.75rem .95rem;font-size:.82rem;line-height:1.5;box-shadow:0 2px 8px rgba(217,119,6,0.08);">
                    ⏰ Hôm nay (<b>${dLabel}</b>) sẽ chốt số lượng món:<br>${lines}${noteLine}
                </div>`;
        }
    } catch {}
})();

// ── "Sắp tới trong tuần này" ──────────────────────────────────────────
(async function loadUpcomingLocks(){
    const w = getWeekRangeIso();
    try {
        const res = await fetch(`@Url.Action("List","MealLock")?from=${w.mon}&to=${w.sat}`);
        const d   = await res.json();
        if (!d.success || !d.data) return;

        const today0 = new Date(); today0.setHours(0,0,0,0);
        const upcoming = d.data
            .filter(r => r.isActive && (r.lockLunch || r.lockOt))
            .filter(r => new Date(r.lockDate) >= today0
                       && new Date(r.lockDate).toDateString() !== today0.toDateString())
            .sort((a,b) => new Date(a.lockDate) - new Date(b.lockDate));

        if (upcoming.length === 0) return;

        const dayFullNames = ['Chủ nhật', 'Thứ 2', 'Thứ 3', 'Thứ 4', 'Thứ 5', 'Thứ 6', 'Thứ 7'];
        const fmtShortDate = (dStr) => {
            const dt = new Date(dStr);
            const dd = String(dt.getDate()).padStart(2, '0');
            const mo = String(dt.getMonth() + 1).padStart(2, '0');
            return `${dd}/${mo}`;
        };

        const items = upcoming.map(r => {
            const dMeal = new Date(r.lockDate);
            const mealDayStr = `${dayFullNames[dMeal.getDay()]} (${fmtShortDate(r.lockDate)})`;

            let mealType = '';
            if (r.lockLunch && r.lockOt) mealType = 'Ăn Trưa & Tăng Ca';
            else if (r.lockLunch) mealType = 'Ăn Trưa';
            else if (r.lockOt) mealType = 'Suất Tăng Ca';
            else mealType = 'Suất Ăn';

            let cutLine = '';
            if (r.cutoffDt) {
                const dCut = new Date(r.cutoffDt);
                const cutDow = dayFullNames[dCut.getDay()];
                const hh = String(dCut.getHours()).padStart(2, '0');
                const mm = String(dCut.getMinutes()).padStart(2, '0');
                const cutDateStr = fmtShortDate(r.cutoffDt);
                cutLine = `Khóa đổi món lúc <strong style="color:#c2410c;">${hh}:${mm} ${cutDow} (${cutDateStr})</strong>`;
            } else {
                cutLine = `<strong style="color:#dc2626;">Khoá đổi món cả ngày</strong>`;
            }

            const noteLine = r.note ? `<div style="font-size:0.75rem;color:#9a3412;margin-top:2px;font-style:italic;">📝 ${escTxt(r.note)}</div>` : '';

            return `<div style="background:rgba(255,255,255,0.85);border:1px solid rgba(254,215,170,0.7);border-radius:10px;padding:8px 12px;margin-bottom:5px;">
                <div><strong>${mealType} ${mealDayStr}</strong>: ${cutLine}</div>
                ${noteLine}
            </div>`;
        }).join('');

        const banner = document.getElementById('upcomingLockBanner');
        banner.style.display = 'block';
        banner.innerHTML = `
            <div style="background:linear-gradient(135deg, #fffdfa 0%, #fff7ed 100%);border:1px solid #fed7aa;border-radius:14px;padding:.75rem .95rem;color:#7c2d12;font-size:.82rem;line-height:1.5;box-shadow:0 4px 14px rgba(234,88,12,0.08);">
                <div style="font-weight:800;color:#9a3412;margin-bottom:.4rem;display:flex;align-items:center;gap:6px;">
                    <span>⏰</span>
                    <span>Lịch chốt suất ăn tuần này</span>
                </div>
                ${items}
            </div>`;
    } catch {}
})();

function openFoodModal(el) {
    const imgUrl   = el.getAttribute('data-food-img');
    const foodName = el.getAttribute('data-food-name');
    const modal    = document.getElementById('foodModal');
    const imgEl    = document.getElementById('foodModalImg');
    const phEl     = document.getElementById('foodModalPh');
    const nameEl   = document.getElementById('foodModalName');

    nameEl.textContent = foodName || '';
    if (imgUrl) {
        imgEl.src = imgUrl;
        imgEl.style.display = 'block';
        phEl.style.display  = 'none';
    } else {
        imgEl.style.display = 'none';
        phEl.style.display  = 'block';
    }
    modal.classList.add('open');
    document.body.style.overflow = 'hidden';
}

function closeFoodModal(e) {
    if (!e || e.target.id === 'foodModal' || e.target.classList.contains('food-modal-close')) {
        const modal = document.getElementById('foodModal');
        modal.classList.remove('open');
        document.body.style.overflow = '';
    }
}
</script>
