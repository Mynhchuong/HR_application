@model List<HR_web.Models.Menu.MenuDayViewModel>
@{
    ViewData["Title"] = "Thực đơn hôm nay";

    var today    = DateTime.Today;
    var dayNames = new Dictionary<DayOfWeek, string>
    {
        { DayOfWeek.Monday,    "Thứ Hai"  },
        { DayOfWeek.Tuesday,   "Thứ Ba"   },
        { DayOfWeek.Wednesday, "Thứ Tư"   },
        { DayOfWeek.Thursday,  "Thứ Năm"  },
        { DayOfWeek.Friday,    "Thứ Sáu"  },
        { DayOfWeek.Saturday,  "Thứ Bảy"  },
        { DayOfWeek.Sunday,    "Chủ Nhật" },
    };
    var todayLabel = dayNames.GetValueOrDefault(today.DayOfWeek, "Hôm nay");
    var shifts     = new[] { ("CA1","Ca 1 — Sáng","#1F4E79"), ("CA2","Ca 2 — Tăng ca","#375623"), ("CA3","Ca 3 — Tối","#7B3F00") };
    var mealColors = new Dictionary<string,(string bg, string fg)>
    {
        { "MAN",     ("#FEF3C7","#92400E") },
        { "DU_KIEN", ("#DBEAFE","#1E40AF") },
        { "NHE",     ("#D1FAE5","#065F46") },
        { "CHAY",    ("#F0FDF4","#166534") },
    };
    var mealLabels = new Dictionary<string,string>
    {
        { "MAN","Món mặn" }, { "DU_KIEN","Dự kiến" }, { "NHE","Món nhẹ" }, { "CHAY","Món chay" }
    };
    bool isEmpty = !Model.Any();
}

<style>
    :root { --red: #c00000; --red-d: #8b0000; }

    .tp { max-width: 680px; margin: 0 auto; padding-bottom: 5rem; }

    /* Hero */
    .tp-hero {
        background: linear-gradient(135deg, var(--red-d), var(--red));
        border-radius: 20px; padding: 1.1rem 1.25rem 1rem;
        color: #fff; margin-bottom: .75rem;
        display: flex; align-items: center; justify-content: space-between;
    }
    .tp-hero-date { font-size: .78rem; opacity: .8; margin-bottom: .2rem; }
    .tp-hero-day  { font-size: 1.25rem; font-weight: 900; letter-spacing: -.3px; }
    .tp-hero-full { font-size: .75rem; opacity: .75; }
    .tp-hero-icon { font-size: 3rem; line-height: 1; }

    /* Tabs */
    .tp-tabs {
        display: flex; background: #f1f5f9; border-radius: 14px;
        padding: 4px; margin-bottom: .75rem; gap: 3px;
    }
    .tp-tab {
        flex: 1; text-align: center; min-height: 42px;
        display: flex; align-items: center; justify-content: center;
        border-radius: 11px; font-size: .875rem; font-weight: 700;
        text-decoration: none !important; color: #64748b;
        transition: background .15s, color .15s, box-shadow .15s;
        -webkit-tap-highlight-color: transparent;
    }
    .tp-tab.active { background: white; color: var(--red); box-shadow: 0 1px 4px rgba(0,0,0,.12); }

    /* Tagline */
    .tp-tagline {
        font-size: .78rem; font-weight: 700; font-style: italic;
        color: var(--red); text-align: center;
        margin-bottom: .75rem; letter-spacing: .01em;
    }

    /* Change meal */
    .tp-change {
        display: flex; align-items: center; justify-content: center; gap: .4rem;
        width: 100%; padding: .6rem 1rem; border-radius: 12px; margin-bottom: .75rem;
        background: #fff; border: 2px solid var(--red); color: var(--red);
        font-size: .875rem; font-weight: 700; text-decoration: none;
        -webkit-tap-highlight-color: transparent;
    }
    .tp-change:active { background: #fff0f0; }

    /* My meal */
    .tp-mymeal {
        background: linear-gradient(135deg,#fff8f8,#fde8e8);
        border: 1.5px solid #fca5a5; border-radius: 18px;
        padding: .85rem 1rem .85rem 1.1rem;
        margin-bottom: .75rem;
        display: flex; align-items: center; justify-content: space-between; gap: .75rem;
        overflow: hidden;
    }
    .tp-mymeal-left { flex: 1; min-width: 0; }
    .tp-mymeal-ttl { font-size: .68rem; font-weight: 700; color: #94a3b8;
        text-transform: uppercase; letter-spacing: .06em; margin-bottom: .3rem; }
    .tp-mymeal-name { font-size: 1.5rem; font-weight: 900; color: var(--red); line-height: 1.2; }
    .tp-mymeal-img  { height: 90px; width: auto; object-fit: contain;
        flex-shrink: 0; margin-right: -.25rem; }

    /* Empty */
    .tp-empty { text-align: center; padding: 3.5rem 1rem; color: #94a3b8; }
    .tp-empty-icon { font-size: 3.5rem; display: block; margin-bottom: .6rem; }

    /* Feedback CTA */
    .tp-feedback {
        display: flex; align-items: center; gap: .75rem;
        background: linear-gradient(135deg,#fff7ed 0%,#ffedd5 100%);
        border: 1px solid #fed7aa; border-radius: 16px;
        padding: .85rem 1rem; margin-bottom: .75rem;
        text-decoration: none !important; color: inherit;
        transition: transform .15s ease, box-shadow .15s ease;
    }
    .tp-feedback:hover, .tp-feedback:active {
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(234,88,12,.18);
    }
    .tp-feedback-icon  { font-size: 1.8rem; line-height: 1; flex-shrink: 0; }
    .tp-feedback-body  { flex: 1; min-width: 0; }
    .tp-feedback-title { font-weight: 800; color: #9a3412; font-size: .92rem; line-height: 1.3; }
    .tp-feedback-desc  { font-size: .72rem; color: #7c2d12; line-height: 1.4; margin-top: .2rem; opacity: .85; }
    .tp-feedback-arrow { font-size: 1.4rem; color: #c2410c; font-weight: 900; line-height: 1; flex-shrink: 0; }

    /* Shift */
    .tp-shift { border-radius: 16px; overflow: hidden; box-shadow: 0 2px 10px rgba(0,0,0,.08); margin-bottom: .75rem; }
    .tp-shift-hd { padding: .65rem 1rem; color: white; font-weight: 800; font-size: .85rem; letter-spacing: .1px; }

    /* Meal row */
    .tp-meal {
        display: flex; align-items: center; gap: .75rem;
        padding: .75rem 1rem; background: white;
        border-bottom: 1px solid #f8fafc; min-height: 56px;
    }
    .tp-meal:last-child { border-bottom: none; }
    .tp-meal:active { background: #fafafa; }

    .tp-meal-img {
        width: 54px; height: 54px; border-radius: 12px;
        object-fit: cover; flex-shrink: 0; background: #f1f5f9;
    }
    .tp-meal-ph {
        width: 54px; height: 54px; border-radius: 12px;
        background: #f1f5f9; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.4rem; color: #cbd5e1;
    }

    .tp-meal-body  { flex: 1; min-width: 0; }
    .tp-meal-badge {
        display: inline-block; font-size: .62rem; font-weight: 800;
        padding: 2px 8px; border-radius: 20px; margin-bottom: 3px;
        letter-spacing: .04em; text-transform: uppercase;
    }
    .tp-meal-name  { font-size: .92rem; font-weight: 700; color: #1e293b; line-height: 1.35; }
    .tp-meal-extra { font-size: .78rem; color: #64748b; margin-top: 1px; }
    .tp-meal-clickable { cursor: pointer; }
    .tp-meal-clickable:active { background: #fff0f0 !important; }

    /* Food modal bottom-sheet */
    .food-modal-backdrop {
        position: fixed; inset: 0; background: rgba(0,0,0,.55);
        z-index: 1050; display: none; align-items: flex-end;
        backdrop-filter: blur(3px);
    }
    .food-modal-backdrop.open { display: flex; }
    .food-modal-sheet {
        width: 100%; background: white;
        border-radius: 24px 24px 0 0;
        padding: 0 0 env(safe-area-inset-bottom,16px);
        transform: translateY(100%);
        transition: transform .3s cubic-bezier(.32,.72,0,1);
        max-height: 92dvh; overflow-y: auto;
    }
    .food-modal-backdrop.open .food-modal-sheet { transform: translateY(0); }
    .food-modal-handle {
        width: 40px; height: 4px; background: #e2e8f0;
        border-radius: 2px; margin: 10px auto 0;
    }
    .food-modal-img {
        width: 100%; max-height: 280px; object-fit: contain;
        border-radius: 0; display: block; background: #f8fafc;
    }
    .food-modal-img-ph {
        width: 100%; max-height: 280px; object-fit: cover; display: block;
        border-radius: 0;
    }
    .food-modal-body { padding: 1rem 1.25rem 1.5rem; }
    .food-modal-name {
        font-size: 1.1rem; font-weight: 900; color: #1e293b;
        line-height: 1.35; margin-bottom: .5rem;
    }
    .food-modal-wow {
        font-size: .95rem; font-weight: 700; font-style: italic;
        color: var(--red); display: flex; align-items: center; gap: .35rem;
    }
    .food-modal-close {
        position: absolute; top: .75rem; right: .75rem;
        width: 32px; height: 32px; border-radius: 50%;
        background: rgba(0,0,0,.35); border: none;
        display: flex; align-items: center; justify-content: center;
        color: white; font-size: 1rem; cursor: pointer; z-index: 1;
    }
</style>

<!-- Food detail modal -->
<div class="food-modal-backdrop" id="foodModal" onclick="closeFoodModal(event)">
    <div class="food-modal-sheet" id="foodModalSheet">
        <div class="food-modal-handle"></div>
        <div style="position:relative;">
            <button class="food-modal-close" onclick="closeFoodModal()">✕</button>
            <img class="food-modal-img" id="foodModalImg" src="" alt=""
                 onerror="this.style.display='none';document.getElementById('foodModalPh').style.display='block';" />
            <img class="food-modal-img-ph" id="foodModalPh"
                 src="@Url.Content("~/assets/img/no-food-image.jpg")" alt="Chưa cập nhật hình"
                 style="display:none;" />
        </div>
        <div class="food-modal-body">
            <div class="food-modal-name" id="foodModalName"></div>
            <div class="food-modal-wow">😍 waooooo nhìn ngon miệng quá</div>
        </div>
    </div>
</div>

<div class="tp px-2 py-2">

    <div class="tp-hero">
        <div>
            <div class="tp-hero-date">Thực đơn hôm nay</div>
            <div class="tp-hero-day">@todayLabel</div>
            <div class="tp-hero-full">@today.ToString("dd/MM/yyyy")</div>
        </div>
        <span class="tp-hero-icon">🍱</span>
    </div>

    <div class="tp-tabs">
        <div class="tp-tab active">Hôm nay</div>
        <a href="@Url.Action("ThisWeek")" class="tp-tab">Cả tuần</a>
    </div>

    @{
        var lunchImg = new Random().Next(2) == 0
            ? "~/assets/img/illustrations/A_LUNCH.png"
            : "~/assets/img/illustrations/C_LUNCH.png";
        var userMeals = ViewBag.UserMeals as List<HR_web.Models.Menu.UserTodayMealModel>;
        var mealEmoji = new Dictionary<string,string>
        { { "MAN","🍖" }, { "NHE","🥗" }, { "CHAY","🥦" } };
    }

    <div id="todayLockBanner" style="display:none;margin-bottom:.6rem;"></div>
    <div id="upcomingLockBanner" style="display:none;margin-bottom:.6rem;"></div>

    @if (userMeals != null && userMeals.Any())
    {
        var lunch = userMeals.FirstOrDefault(m => m.SHIFT == "LUNCH") ?? userMeals.First();
        var otMeal = userMeals.FirstOrDefault(m => m.SHIFT == "OT");
        var emojiL = lunch.FOOD_TYPE  != null && mealEmoji.TryGetValue(lunch.FOOD_TYPE,  out var emL) ? emL : "🍽️";
        var emojiO = otMeal?.FOOD_TYPE != null && mealEmoji.TryGetValue(otMeal.FOOD_TYPE, out var emO) ? emO : "🍽️";
        <div class="tp-mymeal">
            <div class="tp-mymeal-left">
                <div class="tp-mymeal-ttl">Hôm nay bạn đăng ký</div>
                <div style="font-size:.95rem;font-weight:700;color:#1e293b;line-height:1.5;margin-bottom:.15rem;">
                    <span style="color:#64748b;">Trưa: </span>
                    <span style="color:var(--red);font-weight:900;">@emojiL @lunch.FOOD_NAME</span>
                </div>
                @if (otMeal != null)
                {
                    <div style="font-size:.95rem;font-weight:700;color:#1e293b;line-height:1.5;">
                        <span style="color:#64748b;">Tăng ca: </span>
                        <span style="color:var(--red);font-weight:900;">@emojiO @otMeal.FOOD_NAME</span>
                    </div>
                }
            </div>
            <img class="tp-mymeal-img" src="@Url.Content(lunchImg)" alt="" />
        </div>
    }

    <a href="@Url.Action("Create","EmployeeInquiry", new { topicCd = "CANTEEN", chatType = "DIRECT" })" class="tp-feedback">
        <div class="tp-feedback-icon">💬</div>
        <div class="tp-feedback-body">
            <div class="tp-feedback-title">Món ăn hôm nay chưa vừa ý?</div>
            <div class="tp-feedback-desc">Nguội, có vị lạ, chưa ngon… Hãy phản ánh để chúng tôi xử lý và cải thiện lần sau.</div>
        </div>
        <span class="tp-feedback-arrow">›</span>
    </a>

    @if (userMeals != null || User.Identity?.IsAuthenticated == true)
    {
        <a href="@Url.Action("ChangeMeal")" class="tp-change">🔄 Đổi món ăn</a>
        <p class="tp-tagline">✨ Hãy tận hưởng mỹ vị từ bữa cơm trưa của công ty chúng ta!</p>
    }

    @if (isEmpty)
    {
        <div class="tp-empty">
            <span class="tp-empty-icon">🍽️</span>
            <p>Chưa có thực đơn hôm nay<br/>hoặc hôm nay là ngày nghỉ.</p>
        </div>
    }
    else
    {
        <p style="text-align:center;font-size:.73rem;color:#94a3b8;margin-bottom:.6rem;">
            👆 Nhấn vào món ăn để xem hình
        </p>
        @foreach (var (shiftKey, shiftLabel, shiftColor) in shifts)
        {
            var shiftItems = Model.Where(m => m.SHIFT == shiftKey).ToList();
            if (!shiftItems.Any()) continue;

            var byMeal = shiftItems
                .GroupBy(m => m.MEAL_TYPE)
                .OrderBy(g => g.Key == "MAN" ? 0 : g.Key == "DU_KIEN" ? 1 : g.Key == "NHE" ? 2 : 3)
                .ToList();

            <div class="tp-shift">
                <div class="tp-shift-hd" style="background:@shiftColor;">@shiftLabel</div>
                @foreach (var grp in byMeal)
                {
                    var label  = mealLabels.GetValueOrDefault(grp.Key, grp.Key);
                    var colors = mealColors.GetValueOrDefault(grp.Key, (bg: "#f1f5f9", fg: "#334155"));
                    var foods  = grp.OrderBy(f => f.DISPLAY_ORDER).ToList();
                    @foreach (var food in foods)
                    {
                        var foodName = food.FOOD_NAME ?? "";
                        var initial  = foodName.Length > 0 ? foodName[0].ToString().ToUpper() : "?";
                        var imgUrl   = food.IS_IMAGE == "Y" && food.FOOD_ID.HasValue
                            ? Url.Action("GetFoodImage","Image", new { fileName = food.FOOD_ID + ".jpg" }) + "&v=" + DateTimeOffset.UtcNow.ToUnixTimeSeconds()
                            : null;
                        <div class="tp-meal tp-meal-clickable"
                             data-food-img="@imgUrl"
                             data-food-name="@foodName"
                             onclick="openFoodModal(this)">
                            @if (food.IS_IMAGE == "Y" && food.FOOD_ID.HasValue)
                            {
                                <img class="tp-meal-img"
                                     src="@imgUrl"
                                     alt="@foodName" loading="lazy"
                                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                                <div class="tp-meal-ph" style="display:none;background:@colors.bg;">
                                    <span style="color:@colors.fg;font-size:1.1rem;font-weight:900;">@initial</span>
                                </div>
                            }
                            else
                            {
                                <div class="tp-meal-ph" style="background:@colors.bg;">
                                    <span style="color:@colors.fg;font-size:1.1rem;font-weight:900;">@initial</span>
                                </div>
                            }
                            <div class="tp-meal-body">
                                <span class="tp-meal-badge"
                                      style="background:@colors.bg; color:@colors.fg;">@label</span>
                                <div class="tp-meal-name">@foodName</div>
                            </div>
                        </div>
                    }
                }
            </div>
        }
    }

</div>

<script>
function escTxt(s){ return (s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

function getWeekRangeIso() {
    const now = new Date();
    const day = now.getDay();                         // 0=CN..6=T7
    const offsetMon = day === 0 ? -6 : 1 - day;
    const mon = new Date(now); mon.setDate(now.getDate() + offsetMon); mon.setHours(0,0,0,0);
    const sat = new Date(mon); sat.setDate(mon.getDate() + 5);
    const fmt = d => `${d.getFullYear()}-${(d.getMonth()+1).toString().padStart(2,'0')}-${d.getDate().toString().padStart(2,'0')}`;
    return { mon: fmt(mon), sat: fmt(sat), monDate: mon, satDate: sat };
}

// ── Check khoá đổi món hôm nay (gộp LUNCH + OT) ───────────────────────
(async function checkTodayLock(){
    const today = new Date();
    const iso = `${today.getFullYear()}-${(today.getMonth()+1).toString().padStart(2,'0')}-${today.getDate().toString().padStart(2,'0')}`;
    try {
        const [resL, resO] = await Promise.all([
            fetch(`@Url.Action("Check","MealLock")?date=${iso}&typeMeal=LUNCH`).then(r => r.json()),
            fetch(`@Url.Action("Check","MealLock")?date=${iso}&typeMeal=OT`).then(r => r.json())
        ]);
        const dLabel = today.toLocaleDateString('vi-VN');
        const banner = document.getElementById('todayLockBanner');

        const lockedScopes = [
            resL?.success && resL.locked ? 'TRƯA' : null,
            resO?.success && resO.locked ? 'TĂNG CA' : null
        ].filter(Boolean);
        const warnScopes = [
            resL?.success && !resL.locked && resL.reason && resL.cutoffDt ? { sc:'TRƯA', d:resL } : null,
            resO?.success && !resO.locked && resO.reason && resO.cutoffDt ? { sc:'TĂNG CA', d:resO } : null
        ].filter(Boolean);

        if (lockedScopes.length > 0) {
            const note = (resL?.note || resO?.note);
            const noteLine = note
                ? `<div style="font-weight:500;font-size:.72rem;color:#7f1d1d;margin-top:.2rem;font-style:italic;">📝 ${escTxt(note)}</div>`
                : '';
            banner.style.display = '';
            banner.innerHTML = `
                <div style="background:#fef2f2;border:1.5px solid #fecaca;color:#b91c1c;border-radius:12px;padding:.65rem .85rem;font-size:.82rem;font-weight:700;line-height:1.5;">
                    🔒 Hôm nay (<b>${dLabel}</b>) đã chốt số lượng món <span style="color:#7f1d1d">[${lockedScopes.join(' + ')}]</span> — không thể đổi món nữa.
                    ${noteLine}
                </div>`;
        } else if (warnScopes.length > 0) {
            const lines = warnScopes.map(w => `${w.sc}: ${escTxt(w.d.reason)}`).join('<br>');
            const note = warnScopes[0].d.note;
            const noteLine = note
                ? `<br><span style="font-style:italic;">📝 ${escTxt(note)}</span>` : '';
            banner.style.display = '';
            banner.innerHTML = `
                <div style="background:#fffbeb;border:1px solid #fde68a;color:#92400e;border-radius:10px;padding:.6rem .8rem;font-size:.78rem;line-height:1.5;">
                    ⏰ Hôm nay (<b>${dLabel}</b>) sẽ chốt số lượng:<br>${lines}${noteLine}
                </div>`;
        }
    } catch {}
})();

// ── "Sắp tới trong tuần này" ──────────────────────────────────────────
(async function loadUpcomingLocks(){
    const w = getWeekRangeIso();
    try {
        const res = await fetch(`@Url.Action("List","MealLock")?from=${w.mon}&to=${w.sat}`);
        const d   = await res.json();
        if (!d.success || !d.data) return;

        const today0 = new Date(); today0.setHours(0,0,0,0);
        const upcoming = d.data
            .filter(r => r.isActive && (r.lockLunch || r.lockOt))
            .filter(r => new Date(r.lockDate) >= today0
                       && new Date(r.lockDate).toDateString() !== today0.toDateString())  // bỏ qua hôm nay (đã có banner riêng)
            .sort((a,b) => new Date(a.lockDate) - new Date(b.lockDate));

        if (upcoming.length === 0) return;

        const dayName = (d) => ['CN','T2','T3','T4','T5','T6','T7'][new Date(d).getDay()];
        const fmtDate  = (d) => new Date(d).toLocaleDateString('vi-VN');
        const fmtCutoff = (d) => d ? new Date(d).toLocaleString('vi-VN', { hour:'2-digit', minute:'2-digit', day:'2-digit', month:'2-digit' }) : null;

        const items = upcoming.map(r => {
            const scope = [r.lockLunch?'TRƯA':null, r.lockOt?'TĂNG CA':null].filter(Boolean).join(' + ');
            const cut = fmtCutoff(r.cutoffDt);
            const cutLine = cut
                ? `<span style="color:#92400e">chốt lúc <b>${cut}</b></span>`
                : `<span style="color:#b91c1c">khoá cả ngày</span>`;
            const noteLine = r.note ? ` — <i>${escTxt(r.note)}</i>` : '';
            return `<li style="margin-bottom:.25rem;">
                <b>${dayName(r.lockDate)} ${fmtDate(r.lockDate)}</b>
                <span style="color:#64748b;font-size:.72rem;">(${scope})</span>:
                ${cutLine}${noteLine}
            </li>`;
        }).join('');

        const banner = document.getElementById('upcomingLockBanner');
        banner.style.display = '';
        banner.innerHTML = `
            <div style="background:#fff7ed;border:1.5px solid #fed7aa;border-radius:12px;padding:.7rem .9rem;color:#7c2d12;font-size:.78rem;line-height:1.5;">
                <div style="font-weight:800;margin-bottom:.3rem;">📅 Sắp tới trong tuần này:</div>
                <ul style="margin:0;padding-left:1.2rem;">${items}</ul>
            </div>`;
    } catch {}
})();

function openFoodModal(el) {
    const imgUrl  = el.dataset.foodImg;
    const name    = el.dataset.foodName || '';
    const modal   = document.getElementById('foodModal');
    const modalImg= document.getElementById('foodModalImg');
    const modalPh = document.getElementById('foodModalPh');

    document.getElementById('foodModalName').textContent = name;

    if (imgUrl) {
        modalImg.style.display = 'block';
        modalPh.style.display  = 'none';
        modalImg.src = imgUrl;
    } else {
        modalImg.style.display = 'none';
        modalPh.style.display  = 'block';
    }

    modal.classList.add('open');
    document.body.style.overflow = 'hidden';
}

function closeFoodModal(e) {
    if (e && e.target !== document.getElementById('foodModal') &&
        !e.target.classList.contains('food-modal-close')) return;
    const modal = document.getElementById('foodModal');
    const sheet = document.getElementById('foodModalSheet');
    sheet.style.transform = 'translateY(100%)';
    setTimeout(() => {
        modal.classList.remove('open');
        sheet.style.transform = '';
        document.body.style.overflow = '';
    }, 280);
}

(function(){
    const sheet = document.getElementById('foodModalSheet');
    let startY = 0;
    sheet.addEventListener('touchstart', e => { startY = e.touches[0].clientY; }, { passive: true });
    sheet.addEventListener('touchend', e => {
        if (e.changedTouches[0].clientY - startY > 80)
            closeFoodModal({ target: document.getElementById('foodModal') });
    }, { passive: true });
})();
</script>
