@{
    ViewData["Title"] = "Quản lý mẫu thông báo";
}

@section Styles {
<style>
    #tmplTableBody tr td { vertical-align: middle; }
    .tmpl-key-badge {
        font-size: .7rem; font-weight: 700; font-family: monospace;
        background: #fef2f2; color: #dc2626; border-radius: 6px; padding: 2px 8px;
    }
    .lang-tabs { display: flex; gap: .4rem; margin-bottom: .75rem; }
    .lang-tab {
        padding: .3rem .75rem; border-radius: 8px; font-size: .8rem; font-weight: 700;
        cursor: pointer; border: 1.5px solid #e2e8f0; background: #f8fafc; color: #64748b;
    }
    .lang-tab.active { background: #dc2626; border-color: #dc2626; color: #fff; }
    .lang-pane { display: none; }
    .lang-pane.show { display: block; }
    .ph-list { display: flex; flex-wrap: wrap; gap: .3rem; margin-bottom: .5rem; }
    .ph-chip { font-size: .7rem; font-family: monospace; background: #f1f5f9; color: #475569; border-radius: 4px; padding: 2px 7px; }
    @@media (max-width: 767px) {
        .container-fluid { padding-left: 8px !important; padding-right: 8px !important; }
    }
</style>
}

<div class="container-fluid py-4">
    <div class="card">
        <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
            <div class="bg-gradient-dark shadow-dark border-radius-lg pt-3 pb-2 px-3">
                <h6 class="text-white mb-0"><i class="bi bi-bell-fill me-1"></i> Quản lý mẫu thông báo</h6>
                <div class="text-white text-xs opacity-8">Chỉnh nội dung VI/EN + bật/tắt gửi — không cần deploy lại code</div>
            </div>
        </div>

        <div class="px-3 pt-3 pb-2 d-flex flex-wrap align-items-end gap-2 filter-bar" style="background:#f8fafc;border-bottom:1px solid #e9ecef;">
            <div style="min-width:200px;flex:2 1 200px;">
                <label class="form-label small fw-bold mb-1 text-primary">Tìm theo tên / mã</label>
                <input type="text" id="filterSearch" class="form-control form-control-sm" placeholder="🔍 Vd: quà, GIFT_READY..." />
            </div>
            <div style="min-width:170px;flex:1 1 170px;max-width:220px;">
                <label class="form-label small fw-bold mb-1 text-primary">Nhóm</label>
                <select id="filterGroup" class="form-select form-select-sm">
                    <option value="ALL">Tất cả</option>
                    <option value="PAYSLIP">💰 Phiếu lương</option>
                    <option value="GP">🚪 Gate Pass</option>
                    <option value="LEAVE">🌴 Nghỉ phép</option>
                    <option value="OT">⏰ Tăng ca</option>
                    <option value="ATT_CONFIRM">🕒 Chấm công thiếu</option>
                    <option value="GIFT">🎁 Quà</option>
                    <option value="BULLETIN">📰 Bản tin</option>
                    <option value="SURVEY">📋 Khảo sát</option>
                    <option value="AI_CSR">🤖 AI CSR</option>
                </select>
            </div>
            <div style="min-width:170px;flex:1 1 170px;max-width:210px;">
                <label class="form-label small fw-bold mb-1 text-primary">Trạng thái</label>
                <select id="filterActive" class="form-select form-select-sm">
                    <option value="">Tất cả</option>
                    <option value="1">Đang bật</option>
                    <option value="0">Đang tắt</option>
                </select>
            </div>
            <div class="ms-auto"></div>
        </div>

        <div class="card-body px-0 pb-2">
            <div id="tmplCountBadge" class="px-3 pb-2 text-xs text-secondary"></div>
            <div class="table-responsive px-3">
                <table class="table table-sm align-items-center mb-0">
                    <thead>
                        <tr>
                            <th class="text-xs text-secondary" style="width:90px;" data-mobile="primary" data-mobile-slot="badge" data-mobile-label="Trạng thái">Gửi</th>
                            <th class="text-xs text-secondary" data-mobile="primary" data-mobile-slot="code" data-mobile-label="Mã">Mã</th>
                            <th class="text-xs text-secondary" data-mobile="primary" data-mobile-slot="name" data-mobile-label="Tên">Tên</th>
                            <th class="text-xs text-secondary" data-mobile="detail" data-mobile-label="Cập nhật lần cuối">Cập nhật lần cuối</th>
                            <th class="text-xs text-secondary text-center" style="width:70px;" data-mobile="primary" data-mobile-label="Sửa">Sửa</th>
                        </tr>
                    </thead>
                    <tbody id="tmplTableBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal sửa nội dung -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title mb-0">Sửa nội dung — <span id="editKeyLabel" class="tmpl-key-badge"></span></h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="lang-tabs">
                    <div class="lang-tab active" onclick="switchLang(this,'vi')">🇻🇳 Tiếng Việt</div>
                    <div class="lang-tab" onclick="switchLang(this,'en')">🇬🇧 English</div>
                </div>
                <div id="editPhList" class="ph-list"></div>
                <div class="lang-pane show" data-lang="vi">
                    <label class="form-label small fw-bold">Tiêu đề (VI)</label>
                    <input class="form-control form-control-sm mb-2" id="editTitleVi" />
                    <label class="form-label small fw-bold">Nội dung (VI)</label>
                    <textarea class="form-control form-control-sm" id="editBodyVi" rows="3"></textarea>
                </div>
                <div class="lang-pane" data-lang="en">
                    <label class="form-label small fw-bold">Title (EN)</label>
                    <input class="form-control form-control-sm mb-2" id="editTitleEn" />
                    <label class="form-label small fw-bold">Body (EN)</label>
                    <textarea class="form-control form-control-sm" id="editBodyEn" rows="3"></textarea>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-success" onclick="saveTemplate()"><i class="bi bi-check-lg me-1"></i>Lưu</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
const CSRF_TOKEN = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
const LIST_URL   = '@Url.Action("GetList")';
const SAVE_URL   = '@Url.Action("Save")';
const TOGGLE_URL = '@Url.Action("Toggle")';

const KEY_LABELS = {
    'PAYSLIP':            'Phiếu lương',
    'GP_SUBMITTED':       'Gate Pass — Gửi yêu cầu mới',
    'GP_APPROVED':        'Gate Pass — Được duyệt',
    'GP_REJECTED':        'Gate Pass — Bị từ chối',
    'LEAVE_SUBMITTED':    'Nghỉ phép — Gửi yêu cầu mới',
    'LEAVE_APPROVED':     'Nghỉ phép — Được duyệt',
    'LEAVE_REJECTED':     'Nghỉ phép — Bị từ chối',
    'LEAVE_ASSIGNED':     'Nghỉ phép — Sắp lịch cho nhân viên',
    'LEAVE_ACKNOWLEDGED': 'Nghỉ phép — Nhân viên đã xác nhận',
    'OT_SIGN_EMPLOYEE':   'Tăng ca — Nhắc ký từng người',
    'OT_SIGN_GENERAL':    'Tăng ca — Nhắc toàn bộ',
    'ATT_CONFIRM_REQUEST':  'Chấm công thiếu — Yêu cầu NV khai giờ',
    'ATT_CONFIRM_SUBMITTED':'Chấm công thiếu — NV đã khai, chờ quản lý',
    'ATT_CONFIRM_RESULT':   'Chấm công thiếu — Kết quả xác nhận',
    'GIFT_READY':           'Quà — Đến ngày nhận quà',
    'GIFT_CONFIRM_REQUEST': 'Quà — Yêu cầu xác nhận đã nhận',
    'BULLETIN_NEW':       'Bản tin — Đăng bài mới',
    'BULLETIN_REPLY':     'Bản tin — Có người trả lời bình luận',
    'SURVEY_NEW':         'Khảo sát — Phát hành mới',
    'AI_CSR_REPLIED':     'AI CSR — CSR trả lời',
};

const KEY_PLACEHOLDERS = {
    'GP_SUBMITTED':         ['{empName}', '{gpType}'],
    'LEAVE_SUBMITTED':      ['{empName}', '{leaveType}'],
    'LEAVE_ASSIGNED':       ['{leaveType}', '{fromDate}', '{toDate}'],
    'LEAVE_ACKNOWLEDGED':   ['{empCd}'],
    'OT_SIGN_EMPLOYEE':     ['{workDate}'],
    'OT_SIGN_GENERAL':      ['{workDate}'],
    'ATT_CONFIRM_REQUEST':  ['{workDate}'],
    'ATT_CONFIRM_SUBMITTED':['{empName}', '{workDate}'],
    'ATT_CONFIRM_RESULT':   ['{workDate}', '{status}'],
    'GIFT_READY':           ['{giftName}'],
    'GIFT_CONFIRM_REQUEST': ['{giftName}'],
    'BULLETIN_NEW':         ['{title}'],
    'SURVEY_NEW':           ['{surveyTitle}'],
    'AI_CSR_REPLIED':       ['{preview}'],
};

let allTemplates = [];

function esc(s) { return (s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function groupOf(key) {
    const groups = ['PAYSLIP','GP','LEAVE','OT','ATT_CONFIRM','GIFT','BULLETIN','SURVEY','AI_CSR'];
    return groups.find(g => key.startsWith(g)) || 'OTHER';
}
function formatDate(s) {
    if (!s) return '-';
    const d = new Date(s);
    if (isNaN(d)) return s;
    return d.toLocaleString('vi-VN', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit' });
}

function buildRow(item) {
    const label = KEY_LABELS[item.TEMPLATE_KEY] || item.TEMPLATE_KEY;
    const checked = item.IS_ACTIVE === 1 ? 'checked' : '';
    return `<tr data-key="${esc(item.TEMPLATE_KEY)}">
        <td>
            <div class="form-check form-switch mb-0">
                <input class="form-check-input noti-toggle" type="checkbox" role="switch" style="cursor:pointer;width:2.4em;height:1.3em;"
                       data-key="${esc(item.TEMPLATE_KEY)}" ${checked} onchange="toggleActive(this)">
            </div>
        </td>
        <td><span class="tmpl-key-badge">${esc(item.TEMPLATE_KEY)}</span></td>
        <td class="text-sm">${esc(label)}</td>
        <td class="text-xs text-secondary">${formatDate(item.UPDATED_DATE)}${item.UPDATED_BY ? ` — ${esc(item.UPDATED_BY)}` : ''}</td>
        <td class="text-center"><button class="btn btn-sm btn-outline-secondary" onclick="openEditModal('${esc(item.TEMPLATE_KEY)}')"><i class="bi bi-pencil"></i></button></td>
    </tr>`;
}

function renderTable() {
    const q = (document.getElementById('filterSearch').value || '').toLowerCase().trim();
    const grp = document.getElementById('filterGroup').value;
    const act = document.getElementById('filterActive').value;

    const rows = allTemplates.filter(item => {
        const label = (KEY_LABELS[item.TEMPLATE_KEY] || item.TEMPLATE_KEY).toLowerCase();
        if (q && !item.TEMPLATE_KEY.toLowerCase().includes(q) && !label.includes(q)) return false;
        if (grp !== 'ALL' && groupOf(item.TEMPLATE_KEY) !== grp) return false;
        if (act !== '' && String(item.IS_ACTIVE) !== act) return false;
        return true;
    });

    $('#tmplCountBadge').text(rows.length + ' / ' + allTemplates.length + ' mẫu thông báo');
    $('#tmplTableBody').html(rows.map(buildRow).join('') || '<tr><td colspan="5" class="text-center text-secondary py-4">Không tìm thấy mẫu nào khớp bộ lọc</td></tr>');
    MobileTableHelper.refresh('tmplTableBody');
}

async function loadList() {
    const res = await $.getJSON(LIST_URL);
    allTemplates = (res && res.data) || [];
    renderTable();
}

async function toggleActive(chk) {
    const key = chk.dataset.key;
    chk.disabled = true;
    try {
        const res = await $.ajax({
            url: TOGGLE_URL, type: 'POST', contentType: 'application/json',
            headers: { 'RequestVerificationToken': CSRF_TOKEN },
            data: JSON.stringify({ Key: key })
        });
        if (res.success) {
            showToast ? showToast(chk.checked ? 'Đã bật gửi' : 'Đã tắt gửi', 'success') : null;
            const item = allTemplates.find(t => t.TEMPLATE_KEY === key);
            if (item) item.IS_ACTIVE = chk.checked ? 1 : 0;
        } else {
            showToast ? showToast(res.message || 'Lỗi', 'error') : alert(res.message || 'Lỗi');
            chk.checked = !chk.checked;
        }
    } catch (e) {
        showToast ? showToast('Lỗi kết nối', 'error') : null;
        chk.checked = !chk.checked;
    } finally {
        chk.disabled = false;
    }
}

function switchLang(tab, lang) {
    const modalBody = tab.closest('.modal-body');
    modalBody.querySelectorAll('.lang-tab').forEach(t => t.classList.remove('active'));
    modalBody.querySelectorAll('.lang-pane').forEach(p => p.classList.remove('show'));
    tab.classList.add('active');
    modalBody.querySelector(`.lang-pane[data-lang="${lang}"]`).classList.add('show');
}

function openEditModal(key) {
    const item = allTemplates.find(t => t.TEMPLATE_KEY === key);
    if (!item) return;
    $('#editKeyLabel').text(key);
    $('#editTitleVi').val(item.TITLE_VI).data('key', key);
    $('#editBodyVi').val(item.BODY_VI);
    $('#editTitleEn').val(item.TITLE_EN || '');
    $('#editBodyEn').val(item.BODY_EN || '');

    const phs = KEY_PLACEHOLDERS[key] || [];
    $('#editPhList').html(phs.map(p => `<span class="ph-chip">${esc(p)}</span>`).join(''));

    document.querySelectorAll('#editModal .lang-tab')[0].click();
    new bootstrap.Modal(document.getElementById('editModal')).show();
}

async function saveTemplate() {
    const key = $('#editTitleVi').data('key');
    const payload = {
        TEMPLATE_KEY: key,
        TITLE_VI: $('#editTitleVi').val(),
        BODY_VI:  $('#editBodyVi').val(),
        TITLE_EN: $('#editTitleEn').val() || null,
        BODY_EN:  $('#editBodyEn').val()  || null,
    };
    try {
        const res = await $.ajax({
            url: SAVE_URL, type: 'POST', contentType: 'application/json',
            headers: { 'RequestVerificationToken': CSRF_TOKEN },
            data: JSON.stringify(payload)
        });
        if (res.success) {
            showToast ? showToast('Đã lưu', 'success') : null;
            bootstrap.Modal.getInstance(document.getElementById('editModal'))?.hide();
            await loadList();
        } else {
            showToast ? showToast(res.message || 'Lỗi', 'error') : alert(res.message || 'Lỗi');
        }
    } catch (e) {
        showToast ? showToast('Lỗi kết nối', 'error') : null;
    }
}

let searchTimeout;
$('#filterSearch').on('input', function () { clearTimeout(searchTimeout); searchTimeout = setTimeout(renderTable, 250); });
$('#filterGroup, #filterActive').on('change', renderTable);
window.loadData = renderTable; // để nút "Xóa lọc" tự chèn (list-page-helper.js) gọi đúng hàm render lại

$(function () {
    if (typeof MobileTableHelper !== 'undefined') MobileTableHelper.init('tmplTableBody');
    loadList();
});
</script>
}
