@{
    ViewData["Title"] = "Notifications";
}

<style>
    .noti-page { max-width: 680px; margin: 0 auto; padding-bottom: 5rem; }

    .noti-hero {
        background: linear-gradient(135deg, #1e3a5f 0%, #2563eb 100%);
        border-radius: 18px; padding: 1rem 1.25rem; margin-bottom: .75rem;
        color: #fff; display: flex; align-items: center; justify-content: space-between;
    }
    .noti-hero h5    { font-size: 1.05rem; font-weight: 800; margin: 0 0 .15rem; color: #fff !important; }
    .noti-hero small { font-size: .75rem; opacity: .8; color: #fff !important; }
    .noti-hero-icon  { font-size: 2.2rem; line-height: 1; }

    .noti-mark-all { display: flex; align-items: center; justify-content: flex-end; margin-bottom: .6rem; }
    .btn-mark-all {
        font-size: .8rem; font-weight: 700; color: #64748b;
        background: none; border: 1.5px solid #e2e8f0;
        padding: .35rem .85rem; border-radius: 20px; cursor: pointer;
        -webkit-tap-highlight-color: transparent; transition: all .15s;
    }
    .btn-mark-all:hover  { background: #f8fafc; border-color: #cbd5e1; }
    .btn-mark-all:active { opacity: .7; }

    .noti-list { background: white; border-radius: 14px; box-shadow: 0 2px 8px rgba(0,0,0,.07); overflow: hidden; }

    .noti-item {
        display: flex; align-items: flex-start; gap: .85rem;
        padding: .9rem 1rem; border-bottom: 1px solid #f1f5f9;
        cursor: pointer; -webkit-tap-highlight-color: transparent;
        transition: background .12s; position: relative;
    }
    .noti-item:last-child  { border-bottom: none; }
    .noti-item:active      { background: #f8fafc; }
    .noti-item.unread      { background: #eff6ff; }
    .noti-item.unread::before {
        content: ''; position: absolute; left: 0; top: 0; bottom: 0;
        width: 3px; background: #3b82f6; border-radius: 0 2px 2px 0;
    }
    .noti-item.unread:active { background: #dbeafe; }

    .noti-icon {
        width: 44px; height: 44px; border-radius: 13px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.3rem; flex-shrink: 0; margin-top: 1px;
    }

    .noti-content  { flex: 1; min-width: 0; }
    .noti-sender   { font-size: .8rem; font-weight: 700; color: #1e293b; margin-bottom: .1rem; display: flex; align-items: center; gap: .35rem; }
    .noti-empcd    { font-size: .68rem; font-weight: 600; color: #94a3b8; background: #f1f5f9; border-radius: 4px; padding: 1px 5px; font-family: monospace; }
    .noti-title    { font-size: .88rem; font-weight: 600; color: #1e293b; margin-bottom: .2rem; line-height: 1.35; }
    .noti-item.unread .noti-title { font-weight: 800; }
    .noti-body     { font-size: .8rem; color: #64748b; line-height: 1.45; }
    .noti-link-hint {
        display: inline-flex; align-items: center; gap: .25rem;
        margin-top: .4rem; padding: .25rem .6rem;
        background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe;
        border-radius: 999px; font-size: .72rem; font-weight: 700;
    }
    .noti-footer   { display: flex; align-items: center; gap: .5rem; margin-top: .3rem; }
    .noti-time     { font-size: .72rem; color: #94a3b8; }
    .noti-unread-dot {
        width: 7px; height: 7px; border-radius: 50%;
        background: #3b82f6; flex-shrink: 0; display: none;
    }
    .noti-item.unread .noti-unread-dot { display: inline-block; }

    .noti-empty { text-align: center; padding: 3rem 1rem; color: #94a3b8; background: white; border-radius: 14px; }
    .noti-empty .ei { font-size: 3rem; display: block; margin-bottom: .5rem; }

    .noti-load-more { text-align: center; margin-top: .75rem; }
    .btn-load-more {
        padding: .55rem 1.5rem; border-radius: 12px;
        background: white; border: 1.5px solid #e2e8f0;
        font-size: .85rem; font-weight: 700; color: #64748b;
        cursor: pointer; transition: all .15s;
    }
    .btn-load-more:hover  { background: #f8fafc; }
    .btn-load-more:active { opacity: .7; }
</style>

<div class="noti-page px-2 py-2">

    <div class="noti-hero">
        <div>
            <h5>Notifications</h5>
            <small id="unreadLabel">Loading...</small>
        </div>
        <span class="noti-hero-icon">🔔</span>
    </div>

    <div class="noti-mark-all">
        <button class="btn-mark-all" id="btnMarkAll" onclick="markAllRead()">✓ Mark all as read</button>
    </div>

    <div class="noti-list" id="notiList">
        <div class="noti-empty"><span class="ei">⏳</span><p>Loading notifications...</p></div>
    </div>

    <div class="noti-load-more" id="loadMoreWrap" style="display:none;">
        <button class="btn-load-more" onclick="loadMore()">Load more</button>
    </div>

</div>

@Html.AntiForgeryToken()

@section Scripts {
<script>
const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
const linkMap = {
    'GP_MY':          '@Url.Action("GpMyRequests",        "GatePass")',
    'GP_MANAGE':      '@Url.Action("GpListForExpat",       "GatePass")',
    'LEAVE_MY':       '@Url.Action("LeaveMyRequests",      "Leave")',
    'LEAVE_TEAM':     '@Url.Action("LeaveApprovalForExpat","Leave")',
    'LEAVE_ASSIGNED': '@Url.Action("LeaveMyRequests",      "Leave")',
    'OT_SIGN':        '@Url.Action("OtListForExpat",       "OT")',
    'PAYSLIP':        '@Url.Action("Index",                "Payslip")',
    'BULLETIN':       '@Url.Action("Index",                "Bulletin")',
    'SURVEY':         '@Url.Action("Index",                "SurveyAdmin")',// fallback
};
const bulletinDetailBase = '@Url.Action("Detail", "Bulletin")';
const surveyDoBase       = '@Url.Action("Do", "Survey")';

let page = 1;
const PAGE_SIZE = 20;
let loading = false;
let allItems = [];

function esc(s) {
    return (s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function timeAgo(dateStr) {
    const d = new Date(dateStr);
    const diff = Math.floor((Date.now() - d) / 1000);
    const hhmm = d.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', hour12: false });
    if (diff < 60)    return 'Just now';
    if (diff < 3600)  return Math.floor(diff/60) + ' min ago';
    if (diff < 86400) return Math.floor(diff/3600) + ' hr ago • ' + hhmm;
    if (diff < 604800)return Math.floor(diff/86400) + ' days ago • ' + hhmm;
    return d.toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' }) + ' • ' + hhmm;
}

const typeStyle = {
    'PAYSLIP':          { icon: '💰', bg: '#dcfce7' },
    'LEAVE_MY':         { icon: '🏖️', bg: '#e0f2fe' },
    'LEAVE_TEAM':       { icon: '👥', bg: '#e0f2fe' },
    'LEAVE_ASSIGNED':   { icon: '📋', bg: '#e0f2fe' },
    'OT_SIGN':          { icon: '⏰', bg: '#fff7ed' },
    'GP_MY':            { icon: '🚪', bg: '#f3e8ff' },
    'GP_MANAGE':        { icon: '🔑', bg: '#f3e8ff' },
    'BULLETIN':         { icon: '📰', bg: '#fef3c7' },
};

function renderItems(items, append = false) {
    const list = document.getElementById('notiList');
    if (!append) list.innerHTML = '';

    if (items.length === 0 && !append) {
        list.innerHTML = '<div class="noti-empty"><span class="ei">🔔</span><p>No notifications yet.</p></div>';
        return;
    }

    items.forEach(n => {
        const isUnread = n.IS_READ === 0;
        const style = typeStyle[n.LINK_ACTION] ?? { icon: '🔔', bg: '#f1f5f9' };
        const title = n.TITLE_EN || n.TITLE;
        const body  = n.BODY_EN  || n.BODY;
        const div = document.createElement('div');
        div.className = 'noti-item' + (isUnread ? ' unread' : '');
        div.dataset.id = n.ID;
        div.innerHTML = `
            <div class="noti-icon" style="background:${style.bg}">${style.icon}</div>
            <div class="noti-content">
                ${n.SENDER_NAME ? `<div class="noti-sender"><span class="vni-font">${esc(n.SENDER_NAME)}</span>${n.SENDER_EMPCD ? `<span class="noti-empcd">${esc(n.SENDER_EMPCD)}</span>` : ''}</div>` : ''}
                <div class="noti-title">${esc(title)}</div>
                <div class="noti-body">${esc(body)}</div>
                ${(n.LINK_ACTION && /^https?:\/\//i.test(n.LINK_ACTION))
                    ? `<div class="noti-link-hint"><span class="material-symbols-rounded" style="font-size:.95rem;vertical-align:-3px;">open_in_new</span> Click to view</div>`
                    : ''}
                <div class="noti-footer">
                    <span class="noti-time">${timeAgo(n.CREATED_DATE)}</span>
                    <span class="noti-unread-dot"></span>
                </div>
            </div>`;
        div.onclick = () => onNotiClick(n);
        list.appendChild(div);
    });
}

function onNotiClick(n) {
    if (n.IS_READ === 0) {
        fetch('@Url.Action("MarkRead")', {
            method: 'POST',
            keepalive: true,
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
            body: `notiId=${n.ID}`
        });
        n.IS_READ = 1;
        const el = document.querySelector(`.noti-item[data-id="${n.ID}"]`);
        if (el) el.classList.remove('unread');
        updateUnreadBadge(-1);
    }
    // BULLETIN → build URL Detail với TARGET_VAL (mobile/web cùng pattern)
    let url;
    if (n.LINK_ACTION === 'BULLETIN' && n.TARGET_VAL) {
        url = bulletinDetailBase + '/' + encodeURIComponent(n.TARGET_VAL);
    } else if (n.LINK_ACTION === 'SURVEY' && n.TARGET_VAL) {
        url = surveyDoBase + '/' + encodeURIComponent(n.TARGET_VAL);
    } else if (n.LINK_ACTION && /^https?:\/\//i.test(n.LINK_ACTION)) {
        // External link (article, government info, etc.) — open new tab
        window.open(n.LINK_ACTION, '_blank', 'noopener,noreferrer');
        return;
    } else {
        url = n.LINK_ACTION && linkMap[n.LINK_ACTION];
    }
    if (url) location.href = url;
}

let unreadCount = 0;
function updateUnreadBadge(delta) {
    unreadCount = Math.max(0, unreadCount + delta);
    const label = document.getElementById('unreadLabel');
    if (label) label.textContent = unreadCount > 0 ? `${unreadCount} unread` : 'All caught up';
    const bell = document.getElementById('bellBadge');
    if (bell) {
        if (unreadCount > 0) { bell.textContent = unreadCount > 99 ? '99+' : unreadCount; bell.style.display = 'block'; }
        else { bell.style.display = 'none'; }
    }
}

function markAllRead() {
    fetch('@Url.Action("MarkAllRead")', {
        method: 'POST',
        headers: { 'RequestVerificationToken': token }
    }).then(() => {
        document.querySelectorAll('.noti-item.unread').forEach(el => el.classList.remove('unread'));
        allItems.forEach(n => n.IS_READ = 1);
        updateUnreadBadge(-unreadCount);
    });
}

function loadMore() {
    if (loading) return;
    loading = true;
    page++;
    fetch(`@Url.Action("GetPage")?page=${page}&page_size=${PAGE_SIZE}`)
        .then(r => r.json())
        .then(d => {
            loading = false;
            if (!d.success || d.data.length === 0) {
                document.getElementById('loadMoreWrap').style.display = 'none';
                return;
            }
            allItems = allItems.concat(d.data);
            renderItems(d.data, true);
            if (d.data.length < PAGE_SIZE)
                document.getElementById('loadMoreWrap').style.display = 'none';
        })
        .catch(() => { loading = false; });
}

fetch(`@Url.Action("GetPage")?page=1&page_size=${PAGE_SIZE}`)
    .then(r => r.json())
    .then(d => {
        if (!d.success) return;
        allItems = d.data;
        renderItems(d.data);

        unreadCount = d.unread ?? 0;
        const label = document.getElementById('unreadLabel');
        if (label) label.textContent = unreadCount > 0 ? `${unreadCount} unread` : 'All caught up';

        if (d.data.length >= PAGE_SIZE)
            document.getElementById('loadMoreWrap').style.display = 'block';
    });
</script>
}
