@{
    ViewData["Title"] = "Quản Lý Tăng Ca (Admin)";
    var workDate = ViewBag.WorkDate as string ?? DateTime.Today.ToString("yyyy-MM-dd");
}

@section Styles {
    <style>
        .stats-card .icon { width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; border-radius: 12px; }
        #otTableBody tr td { vertical-align: middle; }
        .filter-bar select { min-width: 160px; }
        #paginationInfo { font-size: .82rem; color: #6c757d; }
        .emp-name { font-family: 'Times New Roman', serif; font-weight: 600; }
        .pagination .page-link { cursor: pointer; }
        .pagination .page-item.disabled .page-link { cursor: default; }
        #pageSizeSelect { width: auto; display: inline-block; }
        .bulk-bar { background:#fff3cd; border:1px solid #ffe69c; border-radius:10px; padding:.5rem .75rem; display:none; align-items:center; gap:.5rem; }
        .bulk-bar.show { display:flex; }
        .row-check, #selectAllChk { transform: scale(1.15); cursor:pointer; }
        tr.row-selected { background:#e7f3ff !important; }
        #progressBox { position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 9999; background: #fff; border-radius: 12px; box-shadow: 0 10px 40px rgba(0,0,0,.25); padding: 1.25rem 1.5rem; min-width: 380px; display: none; }
        #progressBox.show { display: block; }
        #progressBackdrop { position: fixed; inset: 0; background: rgba(0,0,0,.4); z-index: 9998; display: none; }
        #progressBackdrop.show { display: block; }
        #progressBar { height: 8px; border-radius: 4px; background: #e9ecef; overflow: hidden; margin: .5rem 0; }
        #progressBar > div { height: 100%; background: linear-gradient(90deg, #4ade80, #22c55e); transition: width .3s ease; width: 0%; }
        #progressLog { max-height: 160px; overflow-y: auto; font-family: monospace; font-size: 11px; background: #f8f9fa; border-radius: 6px; padding: .4rem .6rem; margin-top: .5rem; }
        #progressLog .ok  { color: #16a34a; }
        #progressLog .err { color: #dc2626; }
        #progressLog .skip{ color: #6b7280; }
    </style>
}

<div class="container-fluid py-4">

    <div class="row mb-4">
        <div class="col-6 col-xl-3 mb-3 mb-xl-0">
            <div class="card stats-card" data-filter-status=""><div class="card-body p-3"><div class="row"><div class="col-8"><p class="text-sm mb-0 text-uppercase font-weight-bold text-secondary">Tổng</p><h5 class="font-weight-bolder mb-0" id="summaryTotal">-</h5></div><div class="col-4 text-end"><div class="icon bg-gradient-info text-white shadow-info ms-auto"><i class="bi bi-people-fill fs-4"></i></div></div></div></div></div>
        </div>
        <div class="col-6 col-xl-3 mb-3 mb-xl-0">
            <div class="card stats-card" data-filter-status="PENDING"><div class="card-body p-3"><div class="row"><div class="col-8"><p class="text-sm mb-0 text-uppercase font-weight-bold text-warning">Chờ Ký</p><h5 class="font-weight-bolder mb-0" id="summaryPending">-</h5></div><div class="col-4 text-end"><div class="icon bg-gradient-warning text-white shadow-warning ms-auto"><i class="bi bi-hourglass-split fs-4"></i></div></div></div></div></div>
        </div>
        <div class="col-6 col-xl-3 mb-3 mb-xl-0">
            <div class="card stats-card" data-filter-status="CONFIRMED"><div class="card-body p-3"><div class="row"><div class="col-8"><p class="text-sm mb-0 text-uppercase font-weight-bold text-success">Đã Ký</p><h5 class="font-weight-bolder mb-0" id="summaryConfirmed">-</h5></div><div class="col-4 text-end"><div class="icon bg-gradient-success text-white shadow-success ms-auto"><i class="bi bi-check-circle-fill fs-4"></i></div></div></div></div></div>
        </div>
        <div class="col-6 col-xl-3 mb-3 mb-xl-0">
            <div class="card stats-card" data-filter-status="REJECTED"><div class="card-body p-3"><div class="row"><div class="col-8"><p class="text-sm mb-0 text-uppercase font-weight-bold text-danger">Từ Chối</p><h5 class="font-weight-bolder mb-0" id="summaryRejected">-</h5></div><div class="col-4 text-end"><div class="icon bg-gradient-danger text-white shadow-danger ms-auto"><i class="bi bi-x-circle-fill fs-4"></i></div></div></div></div></div>
        </div>
    </div>

    <div class="card my-4 mb-4">
        <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
            <div class="bg-gradient-dark shadow-dark border-radius-lg pt-3 pb-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h6 class="text-white text-capitalize mb-0"><i class="fas fa-user-shield me-1"></i> Quản Lý OT (Admin)</h6>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <div class="d-flex align-items-center bg-white border-radius-md px-2 shadow-sm" style="height:34px;gap:4px;">
                        <i class="bi bi-calendar3 text-dark"></i>
                        <input type="date" id="filterDate" class="form-control form-control-sm border-0 bg-transparent text-dark p-0"
                               style="width:120px;" value="@workDate" onchange="loadData(1)" />
                    </div>
                </div>
            </div>
        </div>

        @await Html.PartialAsync("_OTFilterBar", new HR_web.Models.OT.OTFilterBarModel
        {
            DeptUrl = Url.Action("GetDept", "Dropdown")!,
            LineUrl = Url.Action("GetLine", "Dropdown")!,
            WorkUrl = Url.Action("GetWork", "Dropdown")!
        })

        <div class="px-4 pt-2">
            <div id="bulkBar" class="bulk-bar">
                <i class="bi bi-check2-square text-warning fs-5"></i>
                <span>Đã chọn <strong id="selCount">0</strong> nhân viên</span>
                <div class="ms-auto d-flex gap-2 flex-wrap">
                    <button id="btnBulkSign"   class="btn btn-sm btn-success mb-0"><i class="bi bi-pen"></i> Ký giùm</button>
                    <button id="btnBulkDelete" class="btn btn-sm btn-danger mb-0"><i class="bi bi-trash"></i> Xoá</button>
                    <button id="btnClearSel"   class="btn btn-sm btn-outline-secondary mb-0"><i class="bi bi-x"></i> Bỏ chọn</button>
                </div>
            </div>
        </div>

        <div class="card-body px-0 pt-0 pb-2 mt-1">
            <div class="table-responsive p-0 px-4">
                <table class="table align-items-center mb-0 w-100 table-hover table-striped">
                    <thead class="bg-light">
                        <tr>
                            <th class="px-2 text-center" style="width:36px;">
                                <input type="checkbox" id="selectAllChk" title="Chọn tất cả trang này">
                            </th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Mã NV</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Họ &amp; Tên</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Bộ Phận</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Chuyền</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Nhóm Việc</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 text-center">Loại TC</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 text-center">Giờ TC</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 text-center">Thời Gian</th>
                            <th class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-9">Tình Trạng</th>
                        </tr>
                    </thead>
                    <tbody id="otTableBody"></tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center px-4 mt-3 mb-2" id="paginationWrapper">
                <div id="paginationCount" class="text-sm text-secondary"></div>
                <nav><ul class="pagination pagination-sm mb-0" id="paginationBar"></ul></nav>
            </div>
        </div>
    </div>
</div>

<!-- Progress overlay cho bulk operations -->
<div id="progressBackdrop"></div>
<div id="progressBox">
    <div class="d-flex align-items-center gap-2 mb-1">
        <div class="spinner-border spinner-border-sm text-success" role="status"></div>
        <strong id="progressTitle">Đang xử lý...</strong>
    </div>
    <div id="progressText" class="text-sm text-secondary">0 / 0</div>
    <div id="progressBar"><div></div></div>
    <div class="d-flex gap-3 text-xs mt-1">
        <span class="text-success">OK: <strong id="progOk">0</strong></span>
        <span class="text-secondary">Skip: <strong id="progSkip">0</strong></span>
        <span class="text-danger">Lỗi: <strong id="progErr">0</strong></span>
    </div>
    <div id="progressLog"></div>
</div>

@section Scripts {
    <script>
    const PAGE_URL         = '@Url.Action("GetOTHRDetailPage", "OT")';
    const URL_BULK_SIGN    = '@Url.Action("AdminBulkSignFor",  "OT")';
    const URL_BULK_DELETE  = '@Url.Action("AdminBulkDelete",   "OT")';
    const BATCH_SIZE       = 50;

    let currentPage=1, totalPages=1, totalRecords=0, isLoading=false, pageSize=100;
    // selected: Map<empcd, {empcd, name, hours, status}> — giữ selection xuyên trang
    const selected = new Map();

    function updateBulkBar() {
        const c = selected.size;
        $('#selCount').text(c);
        $('#bulkBar').toggleClass('show', c > 0);
    }

    function toggleRow(empcd, item, checked) {
        if (checked) selected.set(empcd, item);
        else         selected.delete(empcd);
        $(`tr[data-empcd="${empcd}"]`).toggleClass('row-selected', checked);
        updateBulkBar();
    }

    function buildRow(item) {
        const otType = item.OT_AFTER === 'Y' ? 'Sau' : (item.OT_BEFORE === 'Y' ? 'Trước' : '-');
        let timeHtml = '<span class="text-muted text-xs">-</span>';
        if (item.START_OT && item.END_OT) timeHtml = `<span class="badge bg-light text-dark fw-normal"><i class="bi bi-clock me-1"></i>${formatTime(item.START_OT)} - ${formatTime(item.END_OT)}</span>`;
        else if (item.START_OT)           timeHtml = `<span class="badge bg-light text-dark fw-normal"><i class="bi bi-clock me-1"></i>${formatTime(item.START_OT)}</span>`;

        let statusHtml = `<span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Chờ ký</span>`;
        if (item.CONFIRM_STATUS === 'CONFIRMED') statusHtml = `<span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Đã ký</span>`;
        else if (item.CONFIRM_STATUS === 'REJECTED') statusHtml = `<span class="badge bg-danger">Từ chối</span>`;

        const isSel = selected.has(item.EMPCD);
        return `<tr data-empcd="${escHtml(item.EMPCD)}" class="${isSel?'row-selected':''}">
            <td class="px-2 text-center"><input type="checkbox" class="row-check" data-empcd="${escHtml(item.EMPCD)}" ${isSel?'checked':''}></td>
            <td class="px-2 text-sm">${escHtml(item.EMPCD||'')}</td>
            <td class="px-2 text-sm emp-name vni-font" style="text-transform: uppercase;">${escHtml(item.EMP_NAME||'')}</td>
            <td class="px-2 text-sm">${escHtml(item.DEPT_NAME||'')}</td>
            <td class="px-2 text-sm">${escHtml(item.LINE_NAME||'')}</td>
            <td class="px-2 text-sm">${escHtml(item.WORK_NAME||'')}</td>
            <td class="px-2 text-sm text-center"><span class="badge border border-info text-info fw-normal">${otType}</span></td>
            <td class="px-2 text-sm text-center"><strong>${item.OT_HOURS||0}h</strong></td>
            <td class="px-2 text-sm text-center">${timeHtml}</td>
            <td class="align-middle text-center text-sm">${statusHtml}</td>
        </tr>`;
    }

    function getParams(page) {
        const rawStatus = $('#filterStatus').val();
        return {
            work_date: $('#filterDate').val(),
            search:    $('#searchInput').val(),
            status:    rawStatus === 'APPROVED' ? 'CONFIRMED' : rawStatus,
            dept_id:   $('#filterDept').val(),
            line_id:   $('#filterLine').val(),
            work_id:   $('#filterWork').val(),
            page,
            page_size: pageSize,
            admin:     1
        };
    }

    function loadData(page = 1) {
        if (isLoading) return;
        isLoading = true; currentPage = page;
        $('#otTableBody').html(`<tr><td colspan="10" class="text-center py-5"><div class="spinner-border text-primary" role="status"></div><div class="mt-2 text-sm text-secondary">Đang tải dữ liệu...</div></td></tr>`);
        $.ajax({
            url: PAGE_URL, type: 'GET', data: getParams(page),
            success: function(res) {
                if (!res || !res.success) {
                    $('#otTableBody').html(`<tr><td colspan="10" class="text-center text-danger py-4">Lỗi: ${res?.message || 'Dữ liệu không hợp lệ'}</td></tr>`);
                    return;
                }
                const s = res.summary || {};
                $('#summaryTotal').text((s.TOTAL||0).toLocaleString());
                $('#summaryPending').text((s.PENDING||0).toLocaleString());
                $('#summaryConfirmed').text((s.CONFIRMED||0).toLocaleString());
                $('#summaryRejected').text((s.REJECTED||0).toLocaleString());
                totalRecords = res.total || 0;
                totalPages   = res.total_pages || 0;
                const data = res.data || [];
                if (!data.length) {
                    $('#otTableBody').html(`<tr><td colspan="10" class="text-center text-muted py-4"><img src="@(new Random().Next(2)==0 ? Url.Content("~/assets/img/illustrations/A_nodata.png") : Url.Content("~/assets/img/illustrations/Chi_nodata.png"))" alt="" style="max-width:140px;display:block;margin:0 auto .5rem;opacity:.9;" />Không có dữ liệu</td></tr>`);
                } else {
                    // Cache item info into selected map if row already selected (update giờ mới nhất)
                    data.forEach(it => { if (selected.has(it.EMPCD)) selected.set(it.EMPCD, it); });
                    $('#otTableBody').html(data.map(buildRow).join(''));
                    window._pageData = data;
                }
                $('#selectAllChk').prop('checked', false);
                renderPagination();
            },
            error: function(xhr) {
                $('#otTableBody').html(`<tr><td colspan="10" class="text-center text-danger py-4">Lỗi kết nối (${xhr.status})</td></tr>`);
            },
            complete: function() { isLoading = false; }
        });
    }

    function renderPagination() {
        if (totalRecords === 0) {
            $('#paginationInfo').html(`<strong>0</strong> trong <strong>0</strong>`);
            $('#paginationCount').html(`Trang <strong>0</strong> / 0`);
            $('#paginationBar').empty();
            return;
        }
        const start = (currentPage-1)*pageSize+1, end = Math.min(currentPage*pageSize, totalRecords);
        $('#paginationInfo').html(`<strong>${start.toLocaleString()} - ${end.toLocaleString()}</strong> trong <strong>${totalRecords.toLocaleString()}</strong>`);
        $('#paginationCount').html(`Trang <strong>${currentPage}</strong> / ${totalPages}`);
        const $bar = $('#paginationBar').empty();
        const mkBtn = (label, p, disabled, active) => {
            const li = $('<li class="page-item">').toggleClass('disabled',!!disabled).toggleClass('active',!!active);
            $('<a class="page-link">').html(label).on('click', () => { if(!disabled&&!active) loadData(p); }).appendTo(li);
            return li;
        };
        $bar.append(mkBtn('&laquo;',1,currentPage<=1)).append(mkBtn('&lsaquo;',currentPage-1,currentPage<=1));
        let from=Math.max(1,currentPage-2), to=Math.min(totalPages,currentPage+2);
        if(from>1) $bar.append(mkBtn('1',1)).append('<li class="page-item disabled"><a class="page-link">…</a></li>');
        for(let p=from;p<=to;p++) $bar.append(mkBtn(p,p,false,p===currentPage));
        if(to<totalPages) $bar.append('<li class="page-item disabled"><a class="page-link">…</a></li>').append(mkBtn(totalPages,totalPages));
        $bar.append(mkBtn('&rsaquo;',currentPage+1,currentPage>=totalPages)).append(mkBtn('&raquo;',totalPages,currentPage>=totalPages));
    }

    // ─── Select handling ───
    $(document).on('change', '.row-check', function() {
        const empcd = $(this).data('empcd');
        const item  = (window._pageData || []).find(x => x.EMPCD === empcd);
        toggleRow(empcd, item || { EMPCD: empcd }, this.checked);
    });

    $('#selectAllChk').on('change', function() {
        const chk = this.checked;
        $('.row-check').each(function() {
            if (this.checked !== chk) $(this).prop('checked', chk).trigger('change');
        });
    });

    $('#btnClearSel').on('click', function() {
        selected.clear();
        $('.row-check').prop('checked', false);
        $('tr.row-selected').removeClass('row-selected');
        $('#selectAllChk').prop('checked', false);
        updateBulkBar();
    });

    // ─── Filter events ───
    $('#pageSizeSelect').on('change', function() { pageSize=parseInt($(this).val()); loadData(1); });
    $('#searchInput').on('input', debounce(() => loadData(1), 400));
    $('#filterDept').on('change', function() { $('#filterLine, #filterWork').val(null).trigger('change.select2'); loadData(1); });
    $('#filterLine').on('change', function() { $('#filterWork').val(null).trigger('change.select2'); loadData(1); });
    $('#filterStatus, #filterWork').on('change', () => loadData(1));

    // ─── Progress helpers ───
    function chunk(arr, n) { const out = []; for (let i = 0; i < arr.length; i += n) out.push(arr.slice(i, i + n)); return out; }
    function showProgress(title, total) {
        $('#progressTitle').text(title);
        $('#progressText').text(`0 / ${total}`);
        $('#progressBar > div').css('width', '0%');
        $('#progOk, #progSkip, #progErr').text(0);
        $('#progressLog').empty();
        $('#progressBackdrop, #progressBox').addClass('show');
    }
    function updateProgress(done, total, ok, skip, err) {
        const pct = total > 0 ? Math.round(done * 100 / total) : 0;
        $('#progressText').text(`${done} / ${total} (${pct}%)`);
        $('#progressBar > div').css('width', pct + '%');
        $('#progOk').text(ok); $('#progSkip').text(skip); $('#progErr').text(err);
    }
    function appendLog(items) {
        const $log = $('#progressLog');
        items.forEach(r => {
            const cls = r.OK ? 'ok' : (r.MESSAGE && r.MESSAGE.indexOf('Đã có') >= 0 ? 'skip' : 'err');
            const tag = r.OK ? 'OK' : (cls === 'skip' ? 'SKIP' : 'LỖI');
            $log.append(`<div class="${cls}">[${tag}] ${r.EMPCD} — ${escHtml(r.MESSAGE || '')}</div>`);
        });
        $log.scrollTop($log[0].scrollHeight);
    }
    function hideProgress() { $('#progressBackdrop, #progressBox').removeClass('show'); }

    // Chạy batching cho 1 endpoint. reqBuilder(batch) trả về body JSON.
    async function runBatched(title, url, empcds, reqBuilder) {
        const batches = chunk(empcds, BATCH_SIZE);
        showProgress(title, empcds.length);
        let done = 0, ok = 0, skip = 0, err = 0;
        for (let bi = 0; bi < batches.length; bi++) {
            const batch = batches[bi];
            $('#progressTitle').text(`${title} — batch ${bi+1}/${batches.length}`);
            try {
                const res = await $.ajax({
                    url, type: 'POST', contentType: 'application/json',
                    data: JSON.stringify(reqBuilder(batch)),
                    timeout: 120000
                });
                ok   += res.processed || 0;
                skip += res.skipped   || 0;
                err  += res.failed    || 0;
                appendLog(res.results || []);
            } catch (e) {
                err += batch.length;
                appendLog(batch.map(cd => ({ EMPCD: cd, OK: false, MESSAGE: 'Lỗi batch: ' + (e.statusText || e.message || 'unknown') })));
            }
            done += batch.length;
            updateProgress(done, empcds.length, ok, skip, err);
        }
        $('#progressTitle').text(`Xong: OK ${ok} / Skip ${skip} / Lỗi ${err}`);
        setTimeout(() => {
            hideProgress();
            selected.clear();
            loadData(currentPage);
            showToast(`Hoàn tất: OK ${ok}, Skip ${skip}, Lỗi ${err}`, err > 0 ? 'warning' : 'success');
        }, err > 0 || skip > 0 ? 2500 : 800);
    }

    // ─── Ký giùm (dùng giờ đồng bộ ERP, batch 50) ───
    $('#btnBulkSign').on('click', function() {
        if (selected.size === 0) { showToast('Chưa chọn nhân viên nào','warning'); return; }
        const empcds = Array.from(selected.keys());
        const nBatch = Math.ceil(empcds.length / BATCH_SIZE);
        showConfirm(`Ký giùm OT cho ${empcds.length} nhân viên (chia ${nBatch} batch × ${BATCH_SIZE}). Giờ TC lấy từ ERP.`, () => {
            runBatched('Đang ký giùm', URL_BULK_SIGN, empcds, batch => ({
                WORK_DATE: $('#filterDate').val(),
                ITEMS: batch.map(e => ({ EMPCD: e, OT_HOURS: null }))
            }));
        }, { title: 'Xác nhận ký giùm', okText: 'Ký', okClass: 'btn-success', icon: 'check_circle', iconColor: '#16a34a', iconBg: '#dcfce7' });
    });

    // ─── Xoá (batch 50) ───
    $('#btnBulkDelete').on('click', function() {
        if (selected.size === 0) { showToast('Chưa chọn nhân viên nào','warning'); return; }
        const empcds = Array.from(selected.keys());
        const nBatch = Math.ceil(empcds.length / BATCH_SIZE);
        showConfirm(`Xoá HR_OT_REQUEST của ${empcds.length} nhân viên (chia ${nBatch} batch × ${BATCH_SIZE}). Không thể hoàn tác.`, () => {
            runBatched('Đang xoá', URL_BULK_DELETE, empcds, batch => ({
                WORK_DATE: $('#filterDate').val(),
                EMPCDS: batch
            }));
        }, { title: 'Xác nhận xoá', okText: 'Xoá', okClass: 'btn-danger', icon: 'warning', iconColor: '#dc2626', iconBg: '#fee2e2' });
    });

    function formatTime(s){const d=new Date(s);if(isNaN(d))return'';return('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2);}
    function escHtml(str){return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
    function debounce(fn,d){let t;return function(){clearTimeout(t);t=setTimeout(fn,d);};}

    $(document).ready(() => {
        Select2Helper.init();
        loadData(1);
    });
    </script>
}
