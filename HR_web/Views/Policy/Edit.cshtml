@model HR_web.Models.Policy.CompanyPolicyModel
@{
    var isNew = Model.ID == 0;
    ViewData["Title"] = isNew ? "Thêm quy định" : "Sửa quy định";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/jodit@3.24.6/build/jodit.min.css" />
    <style>
        #formCard { max-width: 720px; margin: 0 auto; }

        .jodit-container {
            border-radius: 8px !important;
            border: 1.5px solid #d1d5db !important;
            overflow: hidden;
        }

        .jodit-container:focus-within {
            border-color: #4f46e5 !important;
            box-shadow: 0 0 0 3px rgba(79,70,229,0.1) !important;
        }

        .jodit-toolbar__box {
            background: #f8fafc !important;
            border-bottom: 1px solid #e2e8f0 !important;
        }

        .jodit-wysiwyg {
            font-size: 0.9rem !important;
            color: #1e293b !important;
        }
    </style>
}

<div class="container-fluid py-3">
    <div id="formCard">

        <a href="@Url.Action("Manage", "Policy")" class="d-inline-flex align-items-center gap-1 text-secondary text-sm mb-3 text-decoration-none">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>

        <div class="card">
            <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                <div class="bg-gradient-success shadow-success border-radius-lg pt-3 pb-2 px-3">
                    <h6 class="text-white mb-0">
                        <i class="bi @(isNew ? "bi-plus-circle" : "bi-pencil-square") me-1"></i>
                        @(isNew ? "Thêm quy định mới" : "Sửa quy định")
                    </h6>
                </div>
            </div>

            <div class="card-body pt-4 pb-4 px-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ID" />

                    <div class="row g-3">
                        <!-- Nhóm -->
                        <div class="col-12 col-md-6">
                            <label class="form-label text-sm font-weight-bold">Nhóm <span class="text-danger">*</span></label>
                            <input asp-for="CATEGORY" class="form-control"
                                   placeholder="Ví dụ: Nội quy lao động"
                                   list="category-list" autocomplete="off" />
                            <datalist id="category-list">
                                <option value="Nội quy lao động" />
                                <option value="An toàn lao động" />
                                <option value="Phúc lợi & lương" />
                                <option value="Kỷ luật" />
                                <option value="Khác" />
                            </datalist>
                        </div>

                        <!-- Thứ tự -->
                        <div class="col-12 col-md-6">
                            <label class="form-label text-sm font-weight-bold">Thứ tự hiển thị</label>
                            <input asp-for="DISPLAY_ORDER" type="number" min="0" class="form-control" />
                        </div>

                        <!-- Tiêu đề -->
                        <div class="col-12">
                            <label class="form-label text-sm font-weight-bold">Tiêu đề <span class="text-danger">*</span></label>
                            <input asp-for="TITLE" class="form-control"
                                   placeholder="Ví dụ: Điều 1 - Giờ làm việc" />
                        </div>

                        <!-- Nội dung (Jodit) -->
                        <div class="col-12">
                            <label class="form-label text-sm font-weight-bold">Nội dung <span class="text-danger">*</span></label>
                            <textarea asp-for="CONTENT" id="editor-content"></textarea>
                        </div>

                        <!-- Trạng thái -->
                        <div class="col-12">
                            <div class="d-flex align-items-center gap-3">
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" id="isActiveCheck"
                                           @(Model.IS_ACTIVE == 1 ? "checked" : "")
                                           onchange="document.getElementById('IS_ACTIVE').value = this.checked ? 1 : 0" />
                                    <label class="form-check-label text-sm font-weight-bold" for="isActiveCheck">
                                        Hiển thị cho nhân viên
                                    </label>
                                </div>
                                <input type="hidden" asp-for="IS_ACTIVE" id="IS_ACTIVE" />
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4 flex-wrap">
                        <button type="submit" class="btn btn-success mb-0">
                            <i class="bi bi-save me-1"></i>
                            @(isNew ? "Tạo mới" : "Lưu thay đổi")
                        </button>
                        <a href="@Url.Action("Manage", "Policy")" class="btn btn-outline-secondary mb-0">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jodit@3.24.6/build/jodit.min.js"></script>
    <script>
        Jodit.make('#editor-content', {
            height: 380,
            language: 'en',
            toolbarButtonSize: 'middle',
            showCharsCounter: false,
            showWordsCounter: false,
            showXPathInStatusbar: false,
            buttons: [
                'bold', 'italic', 'underline', 'strikethrough', '|',
                'brush', 'fontsize', '|',
                'ul', 'ol', '|',
                'left', 'center', 'right', '|',
                'table', '|',
                'link', 'hr', '|',
                'undo', 'redo', '|',
                'fullsize'
            ],
            buttonsMD: [
                'bold', 'italic', 'underline', '|',
                'brush', 'fontsize', '|',
                'ul', 'ol', '|',
                'table', 'link', '|',
                'undo', 'redo', '|',
                'fullsize'
            ],
            buttonsSM: [
                'bold', 'italic', '|',
                'brush', '|',
                'ul', 'ol', '|',
                'fullsize'
            ],
            uploader: { insertImageAsBase64URI: false },
            removeButtons: ['image', 'video', 'file', 'copyformat', 'speechRecognize', 'spellcheck', 'print', 'about'],
            disablePlugins: ['image', 'video', 'file', 'speech-recognize', 'spellcheck', 'print'],
            placeholder: 'Nhập nội dung quy định...',
        });
    </script>
}
