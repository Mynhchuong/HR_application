@model List<HR_web.Models.Policy.CompanyPolicyModel>
@{
    ViewData["Title"] = "Quy định công ty";

    var catGroups = Model
        .GroupBy(p => p.CATEGORY)
        .OrderBy(g => g.Key)
        .ToList();

    var lastUpdated = Model.Where(p => p.UPDT_DT.HasValue)
                           .OrderByDescending(p => p.UPDT_DT)
                           .FirstOrDefault();
    var heroImgs = new[] { "Sayhii.png", "A-alo.png" };
    var heroImg  = heroImgs[new Random().Next(heroImgs.Length)];
}

<style>
    :root {
        --pp:        #4f46e5;
        --pp-dark:   #4338ca;
        --pp-bg:     #eef2ff;
        --pp-border: #e0e7ff;
    }

    .policy-page {
        max-width: 680px;
        margin: 0 auto;
        padding-bottom: 5rem;
    }

    /* ── Hero ─────────────────────────────────── */
    .pp-hero {
        background: linear-gradient(135deg, #8b0000 0%, #c00000 100%);
        border-radius: 20px;
        padding: 1.25rem 1.4rem;
        margin-bottom: 1.5rem;
        color: #fff;
        position: relative;
        overflow: hidden;
    }
    .pp-hero h5    { font-size: 1.1rem; font-weight: 800; margin: 0 0 .2rem; color: #fff !important; }
    .pp-hero small { font-size: .78rem; opacity: .85; color: #fff !important; }
    .pp-hero-img {
        position: absolute; right: -6px; bottom: -4px;
        height: 100px; pointer-events: none; user-select: none;
    }

    /* ── Search ───────────────────────────────── */
    .pp-search { position: relative; margin-bottom: 1rem; }
    .pp-search input {
        width: 100%; border-radius: 14px;
        border: 1.5px solid #e2e8f0;
        padding: .65rem 2.5rem .65rem 2.5rem;
        font-size: .9rem; background: #fff; color: #1e293b;
        outline: none; box-shadow: 0 2px 8px rgba(0,0,0,.04);
        transition: border-color .2s; box-sizing: border-box;
    }
    .pp-search input:focus { border-color: var(--pp); box-shadow: 0 0 0 3px rgba(79,70,229,.1); }
    .pp-search .s-icon {
        position: absolute; left: .75rem; top: 50%; transform: translateY(-50%);
        color: #64748b; font-size: 20px; pointer-events: none;
    }
    .pp-search .s-clear {
        position: absolute; right: .75rem; top: 50%; transform: translateY(-50%);
        color: #64748b; font-size: 18px; cursor: pointer;
        background: none; border: none; padding: 0; display: none;
    }

    /* ── Section label ────────────────────────── */
    .pp-section-label {
        font-size: .72rem; font-weight: 700; letter-spacing: .07em;
        text-transform: uppercase; color: #64748b;
        padding: 0 4px; margin: 1.25rem 0 .6rem;
    }

    /* ── Grid ─────────────────────────────────── */
    .pp-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: .75rem;
    }
    @@media (min-width: 540px) {
        .pp-grid { grid-template-columns: repeat(3, 1fr); }
    }

    /* ── Card ─────────────────────────────────── */
    .pp-card {
        background: #fff;
        border: 1.5px solid var(--pp-border);
        border-radius: 18px;
        padding: 1.1rem .9rem 1rem;
        display: flex; flex-direction: column; align-items: center;
        text-align: center;
        text-decoration: none !important;
        color: inherit !important;
        box-shadow: 0 2px 8px rgba(0,0,0,.04);
        transition: transform .2s, box-shadow .2s, border-color .2s;
        -webkit-tap-highlight-color: transparent;
        cursor: pointer;
    }
    .pp-card:active { transform: scale(0.95); background: var(--pp-bg); }
    @@media (hover: hover) {
        .pp-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 20px rgba(79,70,229,.15);
            border-color: var(--pp);
        }
    }

    .pp-card-icon {
        width: 52px; height: 52px; border-radius: 14px;
        background: var(--pp-bg);
        display: flex; align-items: center; justify-content: center;
        margin-bottom: .65rem; font-size: 1.5rem;
        color: var(--pp-dark);
        transition: transform .2s;
    }
    .pp-card:hover .pp-card-icon { transform: rotate(5deg) scale(1.1); }

    .pp-card-title {
        font-size: .82rem; font-weight: 700; color: #1e293b; line-height: 1.3;
    }

    /* ── Empty ────────────────────────────────── */
    .pp-empty { text-align: center; padding: 3rem 1rem; color: #94a3b8; }
    .pp-empty img { height: 110px; width: auto; margin-bottom: .75rem; opacity: .85; }
</style>

<div class="policy-page px-2">

    <div class="pp-hero">
        <h5><i class="bi bi-journal-text me-2"></i>Quy định công ty</h5>
        <small>Chọn mục bạn muốn xem chi tiết</small>
        @if (lastUpdated?.UPDT_DT.HasValue == true)
        {
            var updName = !string.IsNullOrEmpty(lastUpdated.UPDT_FULL_NAME)
                ? lastUpdated.UPDT_FULL_NAME : lastUpdated.UPDT_ID;
            <small style="opacity:.7;">
                <span class="material-symbols-rounded" style="font-size:12px;vertical-align:middle;">update</span>
                Cập nhật @lastUpdated.UPDT_DT!.Value.ToString("dd/MM/yyyy")
                @if (!string.IsNullOrEmpty(updName)) { <text>— @updName</text> }
            </small>
        }
        <img src="@Url.Content("~/assets/img/illustrations/" + heroImg)" class="pp-hero-img" alt="" />
    </div>

    @if (!catGroups.Any())
    {
        <div class="pp-empty">
            <img src="@(new Random().Next(2)==0 ? Url.Content("~/assets/img/illustrations/A-hoi.png") : Url.Content("~/assets/img/illustrations/GT9.png"))" alt="" />
            <p>Chưa có quy định nào được công bố</p>
        </div>
    }
    else
    {
        <div class="pp-search">
            <span class="material-symbols-rounded s-icon">search</span>
            <input type="text" id="ppSearch" placeholder="Tìm kiếm quy định…"
                   oninput="ppDoSearch(this.value)" autocomplete="off" />
            <button class="s-clear material-symbols-rounded" id="ppClear"
                    onclick="ppClearSearch()">close</button>
        </div>

        <div id="ppNoResult" class="pp-empty" style="display:none;">
            <img src="@(new Random().Next(2)==0 ? Url.Content("~/assets/img/illustrations/A-hoi.png") : Url.Content("~/assets/img/illustrations/GT9.png"))" alt="" />
            <p>Không tìm thấy kết quả phù hợp</p>
        </div>

        <div id="ppContent">
        @foreach (var cat in catGroups)
        {
            var titleGroups = cat
                .GroupBy(p => p.TITLE)
                .OrderBy(tg => tg.Min(p => p.DISPLAY_ORDER))
                .ToList();

            <div class="pp-section" data-cat="@cat.Key.ToLower()">
                <div class="pp-section-label">
                    <i class="bi bi-folder2 me-1"></i>@cat.Key
                </div>
                <div class="pp-grid">
                @foreach (var tg in titleGroups)
                {
                    var ids = string.Join(",", tg.Select(p => p.ID));
                    <a href="@Url.Action("Detail", "Policy", new { ids })"
                       class="pp-card"
                       data-title="@tg.Key.ToLower()"
                       data-cat="@cat.Key.ToLower()">
                        <div class="pp-card-icon">
                            <span class="material-symbols-rounded">description</span>
                        </div>
                        <div class="pp-card-title">@tg.Key</div>
                    </a>
                }
                </div>
            </div>
        }
        </div>
    }
</div>

<script>
    function ppDoSearch(q) {
        q = q.trim().toLowerCase();
        document.getElementById('ppClear').style.display = q ? 'block' : 'none';

        const cards = document.querySelectorAll('.pp-card');
        let total = 0;

        cards.forEach(c => {
            const match = !q
                || (c.dataset.title || '').includes(q)
                || (c.dataset.cat   || '').includes(q);
            c.style.display = match ? '' : 'none';
            if (match) total++;
        });

        // Hide section labels when all cards inside are hidden
        document.querySelectorAll('.pp-section').forEach(sec => {
            const visible = [...sec.querySelectorAll('.pp-card')]
                .some(c => c.style.display !== 'none');
            sec.style.display = visible ? '' : 'none';
        });

        const noResult = document.getElementById('ppNoResult');
        const content  = document.getElementById('ppContent');
        noResult.style.display = (q && total === 0) ? '' : 'none';
        if (content) content.style.display = (q && total === 0) ? 'none' : '';
    }

    function ppClearSearch() {
        const inp = document.getElementById('ppSearch');
        inp.value = '';
        inp.focus();
        ppDoSearch('');
    }
</script>
