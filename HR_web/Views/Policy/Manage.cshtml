@model List<HR_web.Models.Policy.CompanyPolicyModel>
@{
    ViewData["Title"] = "Quản lý quy định công ty";
}

@section Styles {
<style>
    #policyDetailModal .modal-body { max-height: 65vh; overflow-y: auto; }
    #policyDetailModal .item-content p { margin-bottom: 0.5rem; }
    #policyDetailModal .item-content ul,
    #policyDetailModal .item-content ol { padding-left: 1.25rem; margin-bottom: 0.5rem; }
    #policyDetailModal .item-content table { width: 100%; border-collapse: collapse; font-size: 0.85rem; margin: 0.5rem 0; }
    #policyDetailModal .item-content table td,
    #policyDetailModal .item-content table th { border: 1px solid #e2e8f0; padding: 6px 8px; }
    #policyDetailModal .item-content table th { background: #ede9fe; font-weight: 600; }
</style>
}

<div class="container-fluid py-4">
    <div class="card my-4">
        <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
            <div class="bg-gradient-success shadow-success border-radius-lg pt-3 pb-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h6 class="text-white mb-0">
                    <i class="bi bi-journal-text me-1"></i> Quản lý quy định công ty
                </h6>
                <a href="@Url.Action("Edit", "Policy")" class="btn btn-sm btn-white mb-0 d-flex align-items-center" style="height:36px;">
                    <i class="bi bi-plus-lg me-1"></i> Thêm mới
                </a>
            </div>
        </div>

        <div class="card-body px-0 pt-0 pb-2 mt-1">
            @if (!Model.Any())
            {
                <div class="text-center py-5 text-secondary">
                    <i class="bi bi-journal-text" style="font-size:48px;opacity:.3;display:block;margin-bottom:.75rem;"></i>
                    <p>Chưa có quy định nào. Nhấn <strong>Thêm mới</strong> để bắt đầu.</p>
                </div>
            }
            else
            {
                <div class="table-responsive p-0 px-4">
                    <table class="table align-items-center mb-0 w-100 table-hover">
                        <thead class="bg-light">
                            <tr>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">#</th>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Nhóm / Tiêu đề</th>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2 d-none d-md-table-cell">Nội dung</th>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2 d-none d-md-table-cell text-center">Thứ tự</th>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Trạng thái</th>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2 d-none d-md-table-cell">Cập nhật</th>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                var item = Model[i];
                                var updaterName = !string.IsNullOrEmpty(item.UPDT_FULL_NAME) ? item.UPDT_FULL_NAME : item.UPDT_ID;
                                <tr>
                                    <td class="px-2 text-xs text-secondary">@(i + 1)</td>
                                    <td class="px-2">
                                        <div class="text-xxs font-weight-bold text-success mb-1">@item.CATEGORY</div>
                                        <div class="text-sm font-weight-bold text-dark">@item.TITLE</div>
                                    </td>
                                    <td class="px-2 d-none d-md-table-cell">
                                        <p class="text-xs text-secondary mb-0" style="max-width:200px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                            @System.Text.RegularExpressions.Regex.Replace(item.CONTENT, "<.*?>", "")
                                        </p>
                                    </td>
                                    <td class="px-2 d-none d-md-table-cell text-center text-sm">@item.DISPLAY_ORDER</td>
                                    <td class="px-2">
                                        @if (item.IS_ACTIVE == 1)
                                        {
                                            <span class="badge badge-sm bg-gradient-success">Hiện</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-sm bg-gradient-secondary">Ẩn</span>
                                        }
                                    </td>
                                    <td class="px-2 d-none d-md-table-cell">
                                        @if (item.UPDT_DT.HasValue)
                                        {
                                            <p class="text-xs text-secondary mb-0">@item.UPDT_DT.Value.ToString("dd/MM/yyyy")</p>
                                            <p class="text-xs text-secondary mb-0">@updaterName</p>
                                        }
                                        else if (item.INST_DT.HasValue)
                                        {
                                            <p class="text-xs text-secondary mb-0">@item.INST_DT.Value.ToString("dd/MM/yyyy")</p>
                                            <p class="text-xs text-secondary mb-0">@item.INST_ID</p>
                                        }
                                    </td>
                                    <td class="px-2">
                                        <div class="d-flex gap-1 align-items-center">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-info mb-0 px-2"
                                                    title="Xem nội dung"
                                                    onclick="showDetail(@item.ID)">
                                                <i class="bi bi-eye me-1"></i>Chi tiết
                                            </button>
                                            <a href="@Url.Action("Edit", "Policy", new { id = item.ID })"
                                               class="btn btn-sm btn-outline-primary mb-0 px-2" title="Sửa">
                                                <i class="bi bi-pencil me-1"></i>Sửa
                                            </a>
                                            <form id="toggle-form-@item.ID" asp-action="Toggle" asp-route-id="@item.ID" method="post" style="margin:0;">
                                                @Html.AntiForgeryToken()
                                                <button type="button"
                                                        class="btn btn-sm mb-0 px-2 @(item.IS_ACTIVE == 1 ? "btn-outline-danger" : "btn-outline-success")"
                                                        title="@(item.IS_ACTIVE == 1 ? "Ẩn" : "Hiện")"
                                                        onclick="showConfirm('@(item.IS_ACTIVE == 1 ? "Ẩn quy định này?" : "Hiện quy định này?")', function(){ document.getElementById('toggle-form-@item.ID').submit(); }, { title: '@(item.IS_ACTIVE == 1 ? "Ẩn quy định" : "Hiện quy định")', okText: 'Xác nhận', okClass: 'btn-warning' })">
                                                    <i class="bi @(item.IS_ACTIVE == 1 ? "bi-eye-slash" : "bi-eye") me-1"></i>@(item.IS_ACTIVE == 1 ? "Ẩn" : "Hiện")
                                                </button>
                                            </form>
                                            @if (item.IS_ACTIVE == 0)
                                            {
                                                <form id="delete-form-@item.ID" asp-action="Delete" asp-route-id="@item.ID" method="post" style="margin:0;">
                                                    @Html.AntiForgeryToken()
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-danger mb-0 px-2"
                                                            title="Xóa"
                                                            onclick="showConfirm('Xóa vĩnh viễn quy định này?', function(){ document.getElementById('delete-form-@item.ID').submit(); }, { title: 'Xóa quy định', okText: 'Xóa', okClass: 'btn-danger' })">
                                                        <i class="bi bi-trash3 me-1"></i>Xóa
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Detail Modal -->
<div class="modal fade" id="policyDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-gradient-info py-2 px-3">
                <div>
                    <p class="text-white text-xxs font-weight-bold mb-0" id="modalCategory"></p>
                    <h6 class="text-white mb-0" id="modalTitle"></h6>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="item-content" id="modalContent"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const policyData = {
        @foreach (var item in Model)
        {
            @:@item.ID: { category: @Json.Serialize(item.CATEGORY), title: @Json.Serialize(item.TITLE), content: @Json.Serialize(item.CONTENT) },
        }
    };

    function showDetail(id) {
        const p = policyData[id];
        if (!p) return;
        document.getElementById('modalCategory').textContent = p.category;
        document.getElementById('modalTitle').textContent    = p.title;
        document.getElementById('modalContent').innerHTML   = p.content;
        new bootstrap.Modal(document.getElementById('policyDetailModal')).show();
    }
</script>
}
