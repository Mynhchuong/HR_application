@model HR_web.Models.GatePass.GpFilterBarModel
@{
    bool en = Model.Lang == "en";
}

<div class="px-3 pt-3 pb-2 d-flex flex-wrap align-items-end gap-2 filter-bar" style="background:#f8fafc;border-bottom:1px solid #e9ecef;">

    <div style="min-width:140px;flex:1 1 140px;max-width:180px;">
        <label class="form-label small fw-bold mb-1 text-primary">@(en ? "Emp Code" : "Mã NV")</label>
        <input type="text" id="searchInput" class="form-control form-control-sm" placeholder="@(en ? "🔍 Search emp code..." : "🔍 Tìm mã NV...")" />
    </div>

    <div style="min-width:120px;flex:1 1 120px;max-width:160px;">
        <label class="form-label small fw-bold mb-1 text-primary">@(en ? "Status" : "Tình Trạng")</label>
        <select id="filterStatus" class="form-select form-select-sm">
            <option value="">@(en ? "All" : "Tất cả")</option>
            <option value="PENDING">@(en ? "Pending" : "Chờ duyệt")</option>
            <option value="APPROVED">@(en ? "Approved" : "Đã duyệt")</option>
            <option value="REJECTED">@(en ? "Rejected" : "Từ chối")</option>
        </select>
    </div>

    <div style="min-width:120px;flex:1 1 120px;max-width:160px;">
        <label class="form-label small fw-bold mb-1 text-primary">@(en ? "GP Type" : "Loại GP")</label>
        <select id="filterGpType" class="form-select form-select-sm">
            <option value="">@(en ? "All" : "Tất cả")</option>
            <option value="IN">@(en ? "Late Arrival" : "Đến trễ")</option>
            <option value="OUT">@(en ? "Early Leave" : "Ra sớm")</option>
            <option value="MID">@(en ? "Out/In During Work" : "Ra/Vào trong giờ làm")</option>
        </select>
    </div>

    <div style="min-width:150px;flex:2 1 150px;max-width:220px;">
        <label class="form-label small fw-bold mb-1 text-primary">@(en ? "Department" : "Bộ Phận")</label>
        <select id="filterDept" class="select2 form-control"
                data-url="@Model.DeptUrl"
                data-placeholder="@(en ? "All" : "Tất cả")"
                data-selected-id="@Model.DeptSelectedId"></select>
    </div>

    <div style="min-width:140px;flex:2 1 140px;max-width:200px;">
        <label class="form-label small fw-bold mb-1 text-primary">Line</label>
        <select id="filterLine" class="select2 form-control"
                data-url="@Model.LineUrl"
                data-parent="#filterDept"
                data-placeholder="@(en ? "All" : "Tất cả")"></select>
    </div>

    <div style="min-width:140px;flex:2 1 140px;max-width:200px;">
        <label class="form-label small fw-bold mb-1 text-primary">@(en ? "Work Group" : "Nhóm Việc")</label>
        <select id="filterWork" class="select2 form-control"
                data-url="@Model.WorkUrl"
                data-parent="#filterLine"
                data-parent-key="lineCd"
                data-placeholder="@(en ? "All" : "Tất cả")"></select>
    </div>

    <div class="d-flex align-items-end gap-2 ms-auto">
        <div>
            <label class="form-label small fw-bold mb-1 text-secondary">@(en ? "Show" : "Hiển thị")</label>
            <select id="pageSizeSelect" class="form-select form-select-sm" style="width:80px;">
                <option value="50" selected>50</option>
                <option value="100">100</option>
                <option value="500">500</option>
            </select>
        </div>
        <span id="paginationInfo" class="text-nowrap pb-1" style="font-size:.82rem;color:#6c757d;"></span>
    </div>

</div>
