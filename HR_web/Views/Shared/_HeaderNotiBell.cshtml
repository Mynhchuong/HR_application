@* Chuông thông báo trên header — chỉ máy tính (≥992px); điện thoại đã có mục Thông báo ở thanh dưới. *@
<style>
    .hdr-noti { position: relative; }
    .hdr-noti-btn {
        position: relative; width: 44px; height: 44px; border-radius: 50%;
        border: 1px solid var(--header-border, #e2e8f0); background: #fff; color: #475569;
        display: flex; align-items: center; justify-content: center; cursor: pointer;
        transition: background .15s, color .15s;
    }
    .hdr-noti-btn:hover, .hdr-noti.show .hdr-noti-btn { background: #eef2ff; color: #4f46e5; }
    .hdr-noti-btn .material-symbols-rounded { font-size: 1.45rem; }
    .hdr-noti-btn.ring .material-symbols-rounded { animation: hdrNotiRing .9s ease; }
    @@keyframes hdrNotiRing {
        0%, 100% { transform: rotate(0); } 15% { transform: rotate(16deg); } 30% { transform: rotate(-14deg); }
        45% { transform: rotate(10deg); } 60% { transform: rotate(-8deg); } 75% { transform: rotate(4deg); }
    }
    .hdr-noti-badge {
        position: absolute; top: -3px; right: -4px; min-width: 20px; height: 20px; padding: 0 5px;
        border-radius: 10px; background: #ef4444; color: #fff; border: 2px solid #fff;
        font-size: .68rem; font-weight: 800; line-height: 16px; text-align: center;
    }
    .hdr-noti-panel {
        width: 380px; max-height: min(640px, calc(100vh - 90px)); padding: 0; overflow: hidden;
        border: 0; border-radius: 16px; box-shadow: 0 16px 48px rgba(15, 23, 42, .18);
        flex-direction: column;
    }
    .hdr-noti-panel.show { display: flex; }
    .hdr-noti-head { display: flex; align-items: center; justify-content: space-between; padding: 14px 16px 6px; }
    .hdr-noti-head h6 { margin: 0; font-size: 1.15rem; font-weight: 800; color: #0f172a; }
    .hdr-noti-markall { border: 0; background: none; color: #4f46e5; font-size: .8rem; font-weight: 700; padding: 4px 6px; border-radius: 8px; }
    .hdr-noti-markall:hover { background: #eef2ff; }
    .hdr-noti-tabs { display: flex; gap: 6px; padding: 4px 16px 8px; }
    .hdr-noti-tab { border: 0; background: none; padding: 6px 12px; border-radius: 999px; font-size: .85rem; font-weight: 700; color: #334155; }
    .hdr-noti-tab.active { background: #e0e7ff; color: #4338ca; }
    .hdr-noti-list { overflow-y: auto; flex: 1; padding: 0 6px 6px; }
    .hdr-noti-group { font-size: .85rem; font-weight: 800; color: #0f172a; padding: 8px 10px 4px; }
    .hdr-noti-item {
        display: flex; gap: 10px; align-items: flex-start; padding: 8px 10px; border-radius: 10px;
        text-decoration: none; color: #334155;
    }
    .hdr-noti-item:hover { background: #f1f5f9; color: #334155; }
    .hdr-noti-ico {
        flex-shrink: 0; width: 44px; height: 44px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center; font-size: 1.3rem; background: #eef2ff;
    }
    .hdr-noti-txt { flex: 1; min-width: 0; font-size: .84rem; line-height: 1.35; }
    .hdr-noti-txt b { color: #0f172a; }
    .hdr-noti-body { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; color: #64748b; }
    .hdr-noti-time { font-size: .74rem; color: #94a3b8; margin-top: 2px; }
    .hdr-noti-item.unread .hdr-noti-time { color: #4f46e5; font-weight: 700; }
    .hdr-noti-dot { flex-shrink: 0; width: 10px; height: 10px; border-radius: 50%; background: #4f46e5; margin-top: 17px; visibility: hidden; }
    .hdr-noti-item.unread .hdr-noti-dot { visibility: visible; }
    .hdr-noti-check {
        display: none; flex-shrink: 0; width: 30px; height: 30px; margin-top: 7px; border-radius: 50%;
        border: 0; background: #e0e7ff; color: #4338ca; align-items: center; justify-content: center;
    }
    .hdr-noti-check .material-symbols-rounded { font-size: 1.1rem; }
    .hdr-noti-check:hover { background: #4f46e5; color: #fff; }
    .hdr-noti-item.unread:hover .hdr-noti-check { display: flex; }
    .hdr-noti-item.unread:hover .hdr-noti-dot { display: none; }
    .hdr-noti-empty { text-align: center; color: #94a3b8; font-size: .85rem; padding: 28px 12px; }
    .hdr-noti-foot { padding: 8px 12px 12px; }
    .hdr-noti-foot a {
        display: block; text-align: center; padding: 9px; border-radius: 10px; background: #f1f5f9;
        color: #334155; font-weight: 700; font-size: .85rem; text-decoration: none;
    }
    .hdr-noti-foot a:hover { background: #e2e8f0; }
</style>

<div class="hdr-noti dropdown d-none d-lg-block" id="hdrNoti">
    <button type="button" class="hdr-noti-btn" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" aria-label="Thông báo">
        <span class="material-symbols-rounded">notifications</span>
        <span class="hdr-noti-badge" id="hdrNotiBadge" hidden></span>
    </button>
    <div class="dropdown-menu dropdown-menu-end hdr-noti-panel">
        <div class="hdr-noti-head">
            <h6>Thông báo</h6>
            <button type="button" class="hdr-noti-markall" id="hdrNotiMarkAll">✓ Đánh dấu đã đọc</button>
        </div>
        <div class="hdr-noti-tabs">
            <button type="button" class="hdr-noti-tab active" data-tab="all">Tất cả</button>
            <button type="button" class="hdr-noti-tab" data-tab="unread">Chưa đọc</button>
        </div>
        <div class="hdr-noti-list" id="hdrNotiList"><div class="hdr-noti-empty">Đang tải...</div></div>
        <div class="hdr-noti-foot"><a href="@Url.Action("Index", "Notification")">Xem tất cả thông báo</a></div>
    </div>
</div>

<script>
(function () {
    const root = document.getElementById('hdrNoti');
    if (!root) return;
    const URLS = {
        count:   '@Url.Action("UnreadCount", "Notification")',
        page:    '@Url.Action("GetPage", "Notification")',
        go:      '@Url.Action("Go", "Notification")',
        read:    '@Url.Action("MarkRead", "Notification")',
        readAll: '@Url.Action("MarkAllRead", "Notification")'
    };
    const ICONS = {
        PAYSLIP: 'payslip', LEAVE_MY: 'leave-today', LEAVE_TEAM: 'team', LEAVE_ASSIGNED: 'assigned-leave', LEAVE_MANAGE: 'approve-leave',
        OT_SIGN: 'overtime', ATT_CONFIRM_WORKER: 'attendance', ATT_CONFIRM_MANAGER: 'attendance', GIFT_MY: 'gift',
        GP_MY: 'gatepass', GP_MANAGE: 'approve-gp', BULLETIN: 'hr-bulletin', AI_CSR: 'ai-csr', SURVEY: 'survey'
    };
    const badge = document.getElementById('hdrNotiBadge');
    const list  = document.getElementById('hdrNotiList');
    let items = [], tab = 'all', lastCount = -1;

    const isVisible = () => getComputedStyle(root).display !== 'none';
    const token = () => document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    const esc = s => (s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

    function setBadge(n) {
        if (n > 0) { badge.textContent = n > 99 ? '99+' : n; badge.hidden = false; }
        else badge.hidden = true;
    }
    function refreshCount() {
        if (!isVisible() || document.hidden) return;
        fetch(URLS.count, { headers: { Accept: 'application/json' } })
            .then(r => r.json())
            .then(d => {
                const n = d.count || 0;
                // Có thông báo mới: rung chuông, bảng đang mở thì tải lại danh sách
                if (lastCount >= 0 && n > lastCount) {
                    const b = root.querySelector('.hdr-noti-btn');
                    b.classList.remove('ring'); void b.offsetWidth; b.classList.add('ring');
                    if (root.querySelector('.hdr-noti-panel.show')) loadList();
                }
                lastCount = n;
                setBadge(n);
            })
            .catch(() => {});
    }

    function iconOf(a) {
        a = a || '';
        if (a.indexOf('inquiry/') === 0) return window.ic3d('message');
        if (a.indexOf('BULLETIN_CMT:') === 0) return window.ic3d('bulletin-comment');
        return window.ic3d(ICONS[a] || 'bell');
    }
    function timeAgo(s) {
        const d = new Date(s), sec = Math.floor((Date.now() - d) / 1000);
        if (sec < 60) return 'Vừa xong';
        if (sec < 3600) return Math.floor(sec / 60) + ' phút';
        if (sec < 86400) return Math.floor(sec / 3600) + ' giờ';
        if (sec < 604800) return Math.floor(sec / 86400) + ' ngày';
        return d.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
    }
    function hrefOf(n) {
        const a = n.LINK_ACTION || '';
        if (/^https?:\/\//i.test(a)) return a;
        return `${URLS.go}?action=${encodeURIComponent(a)}&target=${encodeURIComponent(n.TARGET_VAL || '')}&noti=${n.ID}`;
    }
    function itemHtml(n) {
        const ext = /^https?:\/\//i.test(n.LINK_ACTION || '');
        return `<a class="hdr-noti-item${n.IS_READ ? '' : ' unread'}" data-id="${n.ID}" href="${esc(hrefOf(n))}"${ext ? ' target="_blank" rel="noopener"' : ''}>
            <span class="hdr-noti-ico">${iconOf(n.LINK_ACTION)}</span>
            <span class="hdr-noti-txt"><b>${esc(n.TITLE)}</b><span class="hdr-noti-body">${esc(n.BODY)}</span>
                <div class="hdr-noti-time">${timeAgo(n.CREATED_DATE)}</div></span>
            <span class="hdr-noti-dot"></span>
            <button type="button" class="hdr-noti-check" title="Đánh dấu đã đọc"><span class="material-symbols-rounded">done</span></button>
        </a>`;
    }
    function render() {
        const shown = tab === 'unread' ? items.filter(n => !n.IS_READ) : items;
        if (!shown.length) {
            list.innerHTML = `<div class="hdr-noti-empty">${tab === 'unread' ? 'Bạn đã đọc hết thông báo 🎉' : 'Chưa có thông báo nào.'}</div>`;
            return;
        }
        const today = new Date(); today.setHours(0, 0, 0, 0);
        const todayItems = shown.filter(n => new Date(n.CREATED_DATE) >= today);
        const older = shown.filter(n => new Date(n.CREATED_DATE) < today);
        let html = '';
        if (todayItems.length) html += '<div class="hdr-noti-group">Hôm nay</div>' + todayItems.map(itemHtml).join('');
        if (older.length) html += '<div class="hdr-noti-group">Trước đó</div>' + older.map(itemHtml).join('');
        list.innerHTML = html;
    }
    function loadList() {
        fetch(`${URLS.page}?page=1&page_size=30`, { headers: { Accept: 'application/json' } })
            .then(r => r.json())
            .then(d => {
                if (!d.success) return;
                items = d.data || [];
                lastCount = d.unread || 0;
                setBadge(lastCount);
                render();
            })
            .catch(() => { list.innerHTML = '<div class="hdr-noti-empty">Không tải được thông báo.</div>'; });
    }

    root.addEventListener('show.bs.dropdown', loadList);
    root.querySelectorAll('.hdr-noti-tab').forEach(b => b.addEventListener('click', () => {
        tab = b.dataset.tab;
        root.querySelectorAll('.hdr-noti-tab').forEach(x => x.classList.toggle('active', x === b));
        render();
    }));
    function markRead(id) {
        return fetch(URLS.read, {
            method: 'POST', keepalive: true,
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token() },
            body: 'notiId=' + id
        }).then(refreshCount).catch(() => {});
    }
    list.addEventListener('click', e => {
        const btn = e.target.closest('.hdr-noti-check');
        if (!btn) return;
        e.preventDefault(); e.stopPropagation();
        const a = btn.closest('.hdr-noti-item');
        const n = items.find(x => String(x.ID) === a.dataset.id);
        if (n) n.IS_READ = 1;
        a.classList.remove('unread');
        lastCount = Math.max(0, lastCount - 1); setBadge(lastCount);
        markRead(a.dataset.id);
        if (tab === 'unread') render();
    }, true);
    // Link ngoài mở tab mới nên không qua /Notification/Go — tự đánh dấu đã đọc
    list.addEventListener('click', e => {
        const a = e.target.closest('.hdr-noti-item');
        if (!a || a.target !== '_blank') return;
        markRead(a.dataset.id);
        a.classList.remove('unread');
    });
    document.getElementById('hdrNotiMarkAll').addEventListener('click', () => {
        fetch(URLS.readAll, { method: 'POST', headers: { 'RequestVerificationToken': token() } })
            .then(() => { items.forEach(n => n.IS_READ = 1); lastCount = 0; setBadge(0); render(); })
            .catch(() => {});
    });

    refreshCount();
    setInterval(refreshCount, 10000);
    document.addEventListener('visibilitychange', refreshCount);
})();
</script>
