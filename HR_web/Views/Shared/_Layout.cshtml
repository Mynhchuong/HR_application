                <span class="material-symbols-rounded">notifications</span>
                <span id="bellBadge" style="display:none;position:absolute;top:-4px;right:-6px;background:#c00000;color:white;font-size:.6rem;font-weight:800;border-radius:20px;padding:1px 5px;min-width:16px;text-align:center;line-height:1.4;"></span>
            </div>
            <span class="nav-text">Thông báo</span>
