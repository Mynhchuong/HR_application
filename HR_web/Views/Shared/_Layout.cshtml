        <a href="@Url.Content(inqUrl)" class="nav-item-mobile @(inqActive ? "active" : "")">
            <div class="icon-wrap" style="position:relative;">
                <span class="material-symbols-rounded">forum</span>
                <span id="inqBadge" style="display:none;position:absolute;top:-4px;right:-6px;background:#c00000;color:white;font-size:.6rem;font-weight:800;border-radius:20px;padding:1px 5px;min-width:16px;text-align:center;line-height:1.4;"></span>
            </div>
            <span class="nav-text">Hộp thư</span>
        </a>
        <a href="@Url.Content("~/Profile/ProfileUser")" class="nav-item-mobile @(Context.Request.Path.Value?.Contains("/Profile") == true ? "active" : "")">
            <div class="icon-wrap">
                <span class="material-symbols-rounded">person</span>
            </div>
            <span class="nav-text">Hồ sơ</span>
        </a>
    </nav>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.1.0-rc.0/js/select2.min.js"></script>
    <!-- Alert Helper -->
    <script src="~/Scripts/alert-helper.js" asp-append-version="true"></script>
    <!-- Select2 Helper -->
    <script src="~/assets/js/select2-helper.js" asp-append-version="true"></script>
    <!-- Mobile Table Helper -->
    <script src="~/js/mobile-table.js" asp-append-version="true"></script>
    <script src="~/assets/js/video-fullscreen.js" asp-append-version="true"></script>

    <!-- Material Dashboard JS -->
    <script src="~/assets/js/plugins/perfect-scrollbar.min.js" asp-append-version="true"></script>
    <script src="~/assets/js/material-dashboard.min.js?v=3.2.0" asp-append-version="true"></script>

    <script>
    // Fix: Material Dashboard 3 ripple cleanup crashes when element is removed from DOM
    // before the animation setTimeout fires (e.g. Bootstrap modal close).
    (function () {
        const _orig = Node.prototype.removeChild;
        Node.prototype.removeChild = function (child) {
            if (child && this.contains(child)) return _orig.call(this, child);
        };
    })();
    </script>

    <script>
        window.showLoading = function () {
            document.getElementById('pageLoadingOverlay')?.classList.add('show');
        };

        window.hideLoading = function () {
            document.getElementById('pageLoadingOverlay')?.classList.remove('show');
        };

        $(document).ready(function () {
            var body = document.body;
            var btnToggle = document.getElementById("hr-btnToggle");
            var btnCloseSidebar = document.getElementById("hr-iconSidenav");
            var backdrop = document.querySelector(".hr-backdrop");
            var isMobile = function () { return window.innerWidth <= 991.98; };
            var setMobileSidebar = function (isOpen) {
                body.classList.toggle("hr-mobile-open", isOpen);
                if (btnToggle) {
                    btnToggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
                }
            };

            function toggleSidebar() {
                if (isMobile()) {
                    setMobileSidebar(!body.classList.contains("hr-mobile-open"));
                } else {
                    body.classList.toggle("hr-menu-hidden");
                    localStorage.setItem("hr_menu_hidden", body.classList.contains("hr-menu-hidden"));
                }
            }

            function syncDesktopState() {
                if (!isMobile()) {
                    setMobileSidebar(false);
                    if (localStorage.getItem("hr_menu_hidden") === "true") {
                        body.classList.add("hr-menu-hidden");
                    } else {
                        body.classList.remove("hr-menu-hidden");
                    }
                }
            }

            // Khởi tạo trạng thái
            syncDesktopState();

            if (btnToggle) {
                btnToggle.addEventListener("click", function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    toggleSidebar();
                });
            }

            if (btnCloseSidebar) {
                btnCloseSidebar.addEventListener("click", function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    setMobileSidebar(false);
                });
            }

            if (backdrop) {
                backdrop.addEventListener("click", function() {
                    setMobileSidebar(false);
                });
            }

            window.addEventListener("resize", function() {
                if (!isMobile()) {
                    syncDesktopState();
                } else {
                    body.classList.remove("hr-menu-hidden");
                }
            });

            $('a').not('[target="_blank"]').not('[href^="#"]').not('[data-bs-toggle]').not('[download]').on('click', function() {
                if (!$(this).hasClass('dropdown-toggle')) {
                    window.showLoading();
                }
            });
        });

        // Hide on normal load
        window.addEventListener('load', function () {
            window.hideLoading();
        });

        // Hide when page is restored from bfcache (browser back/forward button)
        window.addEventListener('pageshow', function (e) {
            if (e.persisted) window.hideLoading();
        });

        // Hide on popstate (mobile hardware back, history navigation)
        window.addEventListener('popstate', function () {
            window.hideLoading();
        });
    </script>

    <!-- Global Confirm Modal -->
    <div class="modal fade" id="globalConfirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 28px;">
                <div class="modal-body p-4 text-center">
                    <div class="mb-3">
                        <div id="globalConfirmIconWrap" class="rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 70px; height: 70px; background: #fee2e2;">
                            <span class="material-symbols-rounded" id="globalConfirmIcon" style="font-size: 2.5rem; color: #dc2626;">delete</span>
                        </div>
                    </div>
                    <h5 class="fw-bold mb-2" id="globalConfirmTitle">Xác nhận</h5>
                    <p class="text-muted small mb-4" id="globalConfirmMessage"></p>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-light w-100 py-2 rounded-3 fw-bold" data-bs-dismiss="modal">Hủy</button>
                        <button type="button" class="btn btn-danger w-100 py-2 rounded-3 fw-bold" id="globalConfirmOk">Xóa</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script>
        window.showToast = function(message, type) {
            const colors = { success: 'text-bg-success', error: 'text-bg-danger', warning: 'text-bg-warning', info: 'text-bg-info' };
            const icons  = { success: 'check_circle', error: 'error', warning: 'warning', info: 'info' };
            const cls = colors[type||'success'] || colors.success;
            const ico = icons[type||'success']  || icons.success;
            const div = document.createElement('div');
            div.className = `toast align-items-center ${cls} border-0 alert-toast show`;
            div.setAttribute('role','alert');
            div.innerHTML = `<div class="d-flex align-items-center"><div class="toast-body flex-fill"><span class="material-symbols-rounded me-2">${ico}</span>${message}</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>`;
            document.getElementById('toast-container').appendChild(div);
            setTimeout(() => { div.classList.remove('show'); setTimeout(() => div.remove(), 400); }, 3500);
        };
        window.showConfirm = function(message, onConfirm, options) {
            const opts = options || {};
            document.getElementById('globalConfirmTitle').textContent   = opts.title   || 'Xác nhận';
            document.getElementById('globalConfirmMessage').textContent = message;
            document.getElementById('globalConfirmOk').textContent      = opts.okText  || 'Xóa';
            document.getElementById('globalConfirmOk').className        = 'btn w-100 py-2 rounded-3 fw-bold ' + (opts.okClass || 'btn-danger');
            // Icon tuỳ chỉnh
            const iconEl   = document.getElementById('globalConfirmIcon');
            const iconWrap = document.getElementById('globalConfirmIconWrap');
            iconEl.textContent           = opts.icon      || 'delete';
            iconEl.style.color           = opts.iconColor || '#dc2626';
            iconWrap.style.background    = opts.iconBg    || '#fee2e2';
            const modalEl = document.getElementById('globalConfirmModal');
            const modal   = new bootstrap.Modal(modalEl);
            const okBtn   = document.getElementById('globalConfirmOk');
            const handler = function() { modal.hide(); onConfirm(); };
            okBtn.addEventListener('click', handler, { once: true });
            modalEl.addEventListener('hidden.bs.modal', function() {
                okBtn.removeEventListener('click', handler);
            }, { once: true });
            modal.show();
        };
    </script>

    <!-- Logout Modal -->
    <div class="modal fade" id="logoutModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 28px;">
                <div class="modal-body p-4 text-center">
                    <div class="mb-3">
                        <div class="bg-soft-orange rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 70px; height: 70px;">
                            <span class="material-symbols-rounded text-warning" style="font-size: 2.5rem;">logout</span>
                        </div>
                    </div>
                    <h5 class="fw-bold mb-2">Đăng xuất?</h5>
                    <p class="text-muted small mb-4">Bạn có chắc chắn muốn thoát khỏi hệ thống không?</p>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-light w-100 py-2 rounded-3 fw-bold" data-bs-dismiss="modal">Hủy</button>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="w-100" id="logoutForm">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger w-100 py-2 rounded-3 fw-bold">Thoát</button>
                        </form>
                        <script>
                        // Trước khi submit form logout: cố gắng unregister FCM token + clear noti tray.
                        // KHÔNG block form submit dù có lỗi gì.
                        (function(){
                            var f = document.getElementById('logoutForm');
                            if (!f) return;
                            f.addEventListener('submit', function () {
                                var bridge = window.MysamhoBridge || window.Android;
                                var token = null;
                                try {
                                    if (bridge && typeof bridge.getFcmToken === 'function')
                                        token = bridge.getFcmToken();
                                } catch (e) {}
                                if (!token) {
                                    try { token = localStorage.getItem('FCM_TOKEN'); } catch (e) {}
                                }
                                if (token) {
                                    try {
                                        navigator.sendBeacon(
                                            '@Url.Action("UnregisterToken","Notification")',
                                            new Blob([JSON.stringify({ Token: token })], { type: 'application/json' })
                                        );
                                    } catch (e) {}
                                }
                                try {
                                    if (bridge && typeof bridge.clearAllNotifications === 'function')
                                        bridge.clearAllNotifications();
                                    else if (window.webkit && window.webkit.messageHandlers
                                        && window.webkit.messageHandlers.clearNotifications)
                                        window.webkit.messageHandlers.clearNotifications.postMessage(null);
                                } catch (e) {}
                                // Không gọi preventDefault → form vẫn submit bình thường
                            });
                        })();
                        </script>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)

    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
        // Unread badge
        (function() {
            fetch('@Url.Action("UnreadCount","Notification")')
                .then(r => r.json())
                .then(d => {
                    if (d.count > 0) {
                        var b = document.getElementById('bellBadge');
                        if (b) { b.textContent = d.count > 99 ? '99+' : d.count; b.style.display = 'block'; }
                    }
                }).catch(() => {});
        })();

        // Inquiry unread badge
        (function() {
            @if (mobileRole == "HR")
            {
                <text>
            fetch('@Url.Action("GetList","HrInquiry")?status=OPEN&pageSize=100')
                .then(r => r.json())
                .then(d => {
                    var total = (d.data || []).reduce(function(s, i) { return s + (i.unreadHr || 0); }, 0);
                    if (total > 0) { var b = document.getElementById('inqBadge'); if (b) { b.textContent = total > 99 ? '99+' : total; b.style.display = 'block'; } }
                }).catch(function() {});
                </text>
            }
            else if (mobileRole == "Admin")
            {
                <text>
            fetch('@Url.Action("GetList","AdminInquiry")?status=OPEN&pageSize=100')
                .then(r => r.json())
                .then(d => {
                    var total = (d.data || []).reduce(function(s, i) { return s + (i.unreadHr || 0); }, 0);
                    if (total > 0) { var b = document.getElementById('inqBadge'); if (b) { b.textContent = total > 99 ? '99+' : total; b.style.display = 'block'; } }
                }).catch(function() {});
                </text>
            }
            else
            {
                <text>
            fetch('@Url.Action("GetMyList","EmployeeInquiry")')
                .then(r => r.json())
                .then(d => {
                    var total = (d.data || []).reduce(function(s, i) { return s + (i.unreadEmp || 0); }, 0);
                    if (total > 0) { var b = document.getElementById('inqBadge'); if (b) { b.textContent = total > 99 ? '99+' : total; b.style.display = 'block'; } }
                }).catch(function() {});
                </text>
            }
        })();

        // FCM token registration (native WebView bridge)
        (function tryRegisterToken(attempt) {
            if (attempt > 10) return;
            var bridge = window.MysamhoBridge || window.Android;
            if (!bridge || typeof bridge.getFcmToken !== 'function') {
                setTimeout(function() { tryRegisterToken(attempt + 1); }, 500);
                return;
            }
            try {
                var fcmToken = bridge.getFcmToken();
                if (!fcmToken) {
                    setTimeout(function() { tryRegisterToken(attempt + 1); }, 500);
                    return;
                }
                var osType = (typeof window.webkit !== 'undefined') ? 'IOS' : 'ANDROID';
                var antiForgery = document.querySelector('input[name="__RequestVerificationToken"]');
                var aft = antiForgery ? antiForgery.value : '';
                fetch('@Url.Action("RegisterToken","Notification")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': aft },
                    body: JSON.stringify({ token: fcmToken, osType: osType })
                }).catch(() => {});
            } catch(e) {}
        })(0);
        </script>
    }
</body>
</html>
