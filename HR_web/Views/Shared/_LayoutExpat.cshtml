    <script>
        window.showOtLogPopup = async function(empcd, workDate, empName) {
            const UI_LANG = '@lang';  const IS_KO = UI_LANG === 'ko';
            const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
            const fmtDt = s => { if (!s) return ''; const d = new Date(s); return isNaN(d) ? '' : d.toLocaleString(IS_KO ? 'ko-KR' : 'en-GB', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit' }); };
            // Khớp đủ mọi CONFIRM_STATUS/ACTION thực tế ghi vào HR_OT_LOG (OtLogHelper.LogAction) —
            // trước đây thiếu SUPP_PEND/SUPP_REQ nên popup hiện thẳng mã code thô, HR đọc không hiểu
            // (báo cáo 2026-09-30: "SUPP_REQ — → SUPP_PEND", "SUPP_PEND → Đồng ý").
            const statusLabel = s => (IS_KO ? {
                CONFIRMED: '승인', REJECTED: '거부', PENDING: '서명 대기',
                SUPP_PEND: '추가 서명 대기 (인사팀 요청)',
            } : {
                CONFIRMED: 'Confirmed', REJECTED: 'Rejected', PENDING: 'Pending signature',
                SUPP_PEND: 'Pending supplemental signature (HR requested)',
            })[s] || (s || '—');
            const actionLabel = a => (IS_KO ? {
                INS: '최초 서명', UPD: '변경', DEL: '삭제',
                SUPP_REQ: '인사팀 추가 서명 요청', PLAN_CHG: 'ERP 근무계획 변경',
            } : {
                INS: 'First signature', UPD: 'Changed', DEL: 'Deleted',
                SUPP_REQ: 'HR requested supplemental signature', PLAN_CHG: 'ERP changed shift plan',
            })[a] || (a || '');

            const modalEl = document.getElementById('otLogModal');
            const modal   = new bootstrap.Modal(modalEl);
            const body    = document.getElementById('otLogModalBody');
            body.innerHTML = '<div class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary"></div></div>';
            modal.show();

            try {
                const url = `${window.OT_LOG_URL || '/OT/GetOtLog'}?empcd=${encodeURIComponent(empcd)}&work_date=${encodeURIComponent(workDate)}`;
                const res  = await fetch(url);
                const json = await res.json();
                if (!json.success) {
                    body.innerHTML = `<div class="text-center text-danger py-3">${esc(json.message || (IS_KO ? '이력을 불러오지 못했습니다' : 'Failed to load history'))}</div>`;
                    return;
                }
                const rows = json.data || [];
                if (!rows.length) {
                    body.innerHTML = `<div class="text-center text-muted py-3">${IS_KO ? '이력 없음' : 'No history'}</div>`;
                    return;
                }
                body.innerHTML =
                    `<div class="small text-muted mb-2">${empName ? `<span class="vni-font" style="text-transform:uppercase;">${esc(empName)}</span> — ` : ''}${esc(empcd)}</div>` +
                    '<ul class="list-unstyled mb-0">' +
                    rows.map(e => {
                        const hoursChanged = e.OLD_HOURS != null && e.NEW_HOURS != null && Number(e.OLD_HOURS) !== Number(e.NEW_HOURS);
                        const actorLabel = e.ACTOR_NAME ? `<span class="vni-font">${esc(e.ACTOR_NAME)}</span> (${esc(e.ACTOR_EMPCD || '')})` : esc(e.ACTOR_EMPCD || '');
                        // PLAN_CHG: ERP tự đổi số giờ OT sau khi NV đã ký (không phải NV/HR đổi ý
                        // trạng thái) — không có OLD_STATUS/NEW_STATUS nên hiện riêng, tránh in "— → —"
                        // vô nghĩa. Không có ACTOR_EMPCD vì đây là hệ thống tự phát hiện, không phải ai
                        // bấm (yêu cầu HR 2026-09-30: "để ý người ta hay đổi quá").
                        if (e.ACTION === 'PLAN_CHG') {
                            return `<li class="d-flex justify-content-between align-items-start border-bottom py-2">
                        <div>
                            <span class="badge bg-warning text-dark me-1">${actionLabel(e.ACTION)}</span>
                            ${IS_KO ? '연장근무 시간' : 'OT hours'}: ${e.OLD_HOURS}h &rarr; <strong>${e.NEW_HOURS}h</strong>
                            <div class="text-xs text-muted">${IS_KO ? '기존 서명 내역과 불일치가 자동 감지됨' : 'System auto-detected a mismatch with the previously signed record'}</div>
                        </div>
                        <div class="text-xs text-muted text-end" style="white-space:nowrap;">${fmtDt(e.INST_DT)}</div>
                    </li>`;
                        }
                        return `<li class="d-flex justify-content-between align-items-start border-bottom py-2">
                        <div>
                            <span class="badge bg-light text-dark border me-1">${actionLabel(e.ACTION)}</span>
                            ${statusLabel(e.OLD_STATUS)} &rarr; <strong>${statusLabel(e.NEW_STATUS)}</strong>
                            ${hoursChanged ? `<div class="text-xs text-muted">${IS_KO ? '시간' : 'Hours'}: ${e.OLD_HOURS}h &rarr; ${e.NEW_HOURS}h</div>` : ''}
                            ${e.ACTOR_EMPCD ? `<div class="text-xs text-muted">${IS_KO ? '처리자:' : 'by'} ${actorLabel}</div>` : ''}
                        </div>
                        <div class="text-xs text-muted text-end" style="white-space:nowrap;">${fmtDt(e.INST_DT)}</div>
                    </li>`;
                    }).join('') +
                    '</ul>';
            } catch (err) {
                body.innerHTML = `<div class="text-center text-danger py-3">${IS_KO ? '연결 오류' : 'Connection error'}</div>`;
            }
        };
    </script>
