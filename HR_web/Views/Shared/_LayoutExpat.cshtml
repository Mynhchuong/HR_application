    <div class="modal fade" id="logoutModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 28px;">
                <div class="modal-body p-4 text-center">
                    <div class="mb-3">
                        <div class="bg-soft-orange rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 70px; height: 70px;">
                            <span class="material-symbols-rounded text-warning" style="font-size: 2.5rem;">logout</span>
                        </div>
                    </div>
                    <h5 class="fw-bold mb-2">@T("Log out?", "로그아웃 하시겠습니까?")</h5>
                    <p class="text-muted small mb-4">@T("Are you sure you want to log out?", "시스템에서 로그아웃 하시겠습니까?")</p>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-light w-100 py-2 rounded-3 fw-bold" data-bs-dismiss="modal">@T("Cancel", "취소")</button>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="w-100" id="logoutForm">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger w-100 py-2 rounded-3 fw-bold">@T("Log out", "로그아웃")</button>
                        </form>
                        <script>
                        // Trước khi submit form logout: cố gắng unregister FCM token + clear noti tray.
                        // KHÔNG block form submit dù có lỗi gì.
                        (function(){
                            var f = document.getElementById('logoutForm');
                            if (!f) return;
                            f.addEventListener('submit', function () {
                                var bridge = window.MysamhoBridge || window.Android;
                                var token = null;
                                try {
                                    if (bridge && typeof bridge.getFcmToken === 'function')
                                        token = bridge.getFcmToken();
                                } catch (e) {}
                                if (!token) {
                                    try { token = localStorage.getItem('FCM_TOKEN'); } catch (e) {}
                                }
                                if (token) {
                                    try {
                                        navigator.sendBeacon(
                                            '@Url.Action("UnregisterToken","Notification")',
                                            new Blob([JSON.stringify({ Token: token })], { type: 'application/json' })
                                        );
                                    } catch (e) {}
                                }
                                try {
                                    if (bridge && typeof bridge.clearAllNotifications === 'function')
                                        bridge.clearAllNotifications();
                                    else if (window.webkit && window.webkit.messageHandlers
                                        && window.webkit.messageHandlers.clearNotifications)
                                        window.webkit.messageHandlers.clearNotifications.postMessage(null);
                                } catch (e) {}
                                // Clear session flag để login lần sau vẫn thấy hero popup
                                try { sessionStorage.removeItem('home_hero_popup_dismissed'); } catch (e) {}
                                // Xoá tài khoản/mật khẩu đã lưu cho đăng nhập Face ID/vân tay.
                                // 2026-10-26 xoá VÔ ĐIỀU KIỆN với lý do "logout = không muốn tự đăng nhập nữa".
                                // 2026-11-13 BỎ cách đó: giờ NV đã tự tick chọn "lần sau đăng nhập bằng Face ID",
                                // mà đăng xuất rồi đăng nhập lại chính là lúc người ta mong Face ID hiện ra nhất.
                                // Xoá lúc này làm tính năng như hỏng. Muốn xoá thì tắt công tắc ở trang Cài đặt
                                // (chỗ đó mới gọi clearCredentials) — đúng ý NV, không đoán thay.
                                try {
                                    var bioOn = true;
                                    try { bioOn = localStorage.getItem('bio_login_v2') !== '0'; } catch (e) {}
                                    if (!bioOn) {
                                        if (window.Android && typeof window.Android.clearCredentials === 'function')
                                            window.Android.clearCredentials();
                                        else if (window.webkit && window.webkit.messageHandlers
                                            && window.webkit.messageHandlers.clearCredentials)
                                            window.webkit.messageHandlers.clearCredentials.postMessage(null);
                                    }
                                } catch (e) {}
                                // Không gọi preventDefault → form vẫn submit bình thường
                            });
                        })();
                        </script>
                    </div>
                </div>
            </div>
        </div>
    </div>

