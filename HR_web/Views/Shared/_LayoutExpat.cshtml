        <script>
        // ── Helper dùng chung cho MỌI badge số trên menu (bottom-nav mobile + sidebar desktop) ──
        // Sau này thêm badge mới chỉ cần gọi loadBadge(...), khỏi viết lại fetch/set từng chỗ.
        //   ids   : 1 id hoặc mảng id các <span> badge (element không tồn tại trên trang thì bỏ qua)
        //   value : số > 0 mới hiện badge; 0/undefined thì ẩn (giữ nguyên style disp mặc định)
        function setMenuBadge(ids, value) {
            (Array.isArray(ids) ? ids : [ids]).forEach(function(id) {
                var b = document.getElementById(id);
                if (!b || !(value > 0)) return;
                b.textContent = value > 99 ? '99+' : value;
                b.style.display = 'inline-block';
            });
        }
        // url        : endpoint AJAX trả JSON
        // ids        : id badge (xem setMenuBadge)
        // extractFn  : (json) => number — lấy số ra từ response, mặc định đọc field "count"
        function loadBadge(url, ids, extractFn) {
            // Trang đích của 1 "app gate" bắt buộc (Survey/Gift/bắt đổi mật khẩu.../...) phải bỏ
            // qua mọi badge — nếu không, badge gọi sang controller KHÔNG nằm trong whitelist của
            // gate đó (OT, AttendanceConfirm, Inquiry...) sẽ bị chính gate chặn (409), app-gate.js
            // lại tự redirect NGAY VỀ TRANG NÀY → tải lại trang → gọi badge lại → lặp vô hạn, NV
            // không bao giờ hoàn thành nổi (bug thật 2026-09-23 — trước đó chỉ vá path "gift", bỏ
            // sót "survey"; "profile" thêm vào khi RequireUpdateProfileFilter được chuẩn hoá trả
            // 409 JSON giống AppGateFilterBase, nếu không sẽ dính lại đúng bug này khi NV đang bị
            // bắt buộc đổi mật khẩu/chữ ký). Thêm gate mới có trang đích riêng thì PHẢI thêm route
            // vào đây — không có cách nào tự suy ra từ AppGateRegistry phía server.
            if (/\/(gift|survey|profile)(\/|$)/i.test(window.location.pathname)) return;
            fetch(url)
                .then(function(r) { return r.json(); })
                .then(function(d) { setMenuBadge(ids, (extractFn || function(d){ return d.count; })(d)); })
                .catch(function() {});
        }

        // Gom hết các loadBadge(...) vào 1 hàm gọi lại được — native (iOS/Android) gọi
        // window.onNativeNotificationReceived() khi có push đến LÚC APP ĐANG MỞ (foreground) để badge
        // tự cập nhật ngay, không cần NV F5/chuyển trang mới thấy số mới (trước đây chỉ 1 chiều: web
        // lấy FCM token đăng ký, native xoá badge lúc logout — không có chiều ngược báo "có tin mới").
        function refreshAllBadges() {
            // Notification — bottom-nav mobile (#bellBadge) + sidebar desktop (#sideBellBadge)
            loadBadge('@Url.Action("UnreadCount","Notification")', ['bellBadge', 'sideBellBadge']);

            // Bulletin — số bài đang publish nhưng user chưa mở
            loadBadge('@Url.Action("UnreadCount","Bulletin")', 'bulletinBadge');

            // Expat KHÔNG có các mục "Xác nhận Tăng ca"/"Xác nhận chấm công"/"Nhận quà"/"Hộp thư
            // phản ánh" trong menu (xem SideMenuBuilder, nhánh Id="Expat") nên bỏ hẳn các badge đó —
            // gọi cũng không có phần tử nào để gắn số, chỉ tốn request mỗi lần tải trang.
        }
        refreshAllBadges();
        window.onNativeNotificationReceived = refreshAllBadges;

        // FCM token registration (native WebView bridge)
        (function tryRegisterToken(attempt) {
            if (attempt > 10) return;
            var bridge = window.MysamhoBridge || window.Android;
            if (!bridge || typeof bridge.getFcmToken !== 'function') {
                setTimeout(function() { tryRegisterToken(attempt + 1); }, 500);
                return;
            }
            try {
                var fcmToken = bridge.getFcmToken();
                if (!fcmToken) {
                    setTimeout(function() { tryRegisterToken(attempt + 1); }, 500);
                    return;
                }
                var osType = (typeof window.webkit !== 'undefined') ? 'IOS' : 'ANDROID';
                var antiForgery = document.querySelector('input[name="__RequestVerificationToken"]');
                var aft = antiForgery ? antiForgery.value : '';
                fetch('@Url.Action("RegisterToken","Notification")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': aft },
                    body: JSON.stringify({ token: fcmToken, osType: osType })
                }).catch(() => {});
            } catch(e) {}
        })(0);

        // Báo mã NV cho app native iOS (bridge setEmpcd) — iOS phân phối qua Apple Business Manager,
        // không có App Store public, mỗi NV có 1 link redeem riêng (HR_APP_LINK). Lúc app kiểm tra
        // version (AppVersionController.Check), cần biết đang là NV nào để trả đúng link ĐÃ GÁN cho
        // họ làm nút "Cập nhật ngay" — mở lại đúng link cũ sẽ ra thẳng trang app trên App Store, không
        // redeem lại (yêu cầu 2026-10-26: "xài lại link cũ để update iOS"). Android dùng Play Store
        // public URL chung, không cần bridge này.
        if (window.webkit && window.webkit.messageHandlers && window.webkit.messageHandlers.setEmpcd) {
            try { window.webkit.messageHandlers.setEmpcd.postMessage(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(layoutUser?.EmpCd ?? ""))); } catch (e) {}
        }
        </script>
    }
</body>
</html>
