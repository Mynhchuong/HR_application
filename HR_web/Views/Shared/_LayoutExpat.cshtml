@using HR_web.Helpers
@{
    // ════════════════════════════════════════════════════════════════════════════════
    // LAYOUT RIÊNG CHO NV NƯỚC NGOÀI (role Expat) — tách khỏi _Layout.cshtml (tiếng Việt)
    // theo yêu cầu 2026-11-11, để tối ưu giao diện mobile + web desktop độc lập, không
    // ảnh hưởng NV thường. Ngôn ngữ: "ko" (người Hàn, mặc định theo ECM100.NATION) hoặc
    // "en" (quốc tịch khác). NV tự đổi được -> lưu HR_USERS.LANG_PREF (xem LangPrefHelper).
    //
    // LƯU Ý khi sửa: phần plumbing bên dưới (CSS/JS, FCM, gate, bridge native, modal dùng
    // chung) hiện ĐANG TRÙNG với _Layout.cshtml — sửa lỗi plumbing phải nhớ sửa cả 2 file.
    // ════════════════════════════════════════════════════════════════════════════════
    var layoutUser = AuthHelper.GetCurrentUser(User);
    var lang = layoutUser?.UiLang == "ko" ? "ko" : "en";   // chuẩn hoá ở UserInfoModel.UiLang
    var isKo = lang == "ko";
    // T("tiếng Anh", "tiếng Hàn") — gom chuỗi hiển thị về 1 chỗ cho dễ đọc, khỏi lồng ternary.
    Func<string, string, string> T = (en, ko) => isKo ? ko : en;
    // Đổ nguyên từ điển ExpatText xuống JS (window.EXPAT_TR) cho các file .js dùng chung tự tra;
    // tiếng Anh thì rỗng để trExpat() fallback về chính chuỗi tiếng Anh, khỏi tải vài KB vô ích.
    var expatTrJson = isKo ? ExpatText.KoJson : "{}";   // serialize 1 lần, cache tĩnh
    var rawName = layoutUser?.FullName ?? layoutUser?.EmpCd ?? "User";
    var displayName = rawName;
    if (!string.IsNullOrEmpty(rawName))
    {
        var nameParts = rawName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (nameParts.Length >= 3)
        {
            displayName = nameParts[0] + " ... " + nameParts[nameParts.Length - 1];
        }
    }
}
<!DOCTYPE html>
<html lang="@lang">
<head>
    <meta charset="utf-8" />
    <!-- maximum-scale=1 + user-scalable=no — chặn hẳn auto-zoom của iOS Safari/WKWebView khi focus
         input (không phụ thuộc cỡ chữ từng ô, chặn tại gốc luôn thay vì sửa từng input 1 — yêu cầu
         tắt zoom 2026-10-26, đồng bộ với việc đã tắt pinch-zoom native Android/iOS). Không ảnh hưởng
         MediaViewer (media-viewer.js) — zoom ảnh/video ở đó tự code bằng touch event JS riêng, độc
         lập với thẻ viewport này. -->
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <title>@ViewData["Title"] - My SAMHO</title>
    <link rel="icon" type="image/png" href="~/assets/img/samho-logo.png" />

    <!-- Fonts & Icons -->
    <!-- Tự host (không còn gọi CDN công cộng) — "Mạng nội bộ Samho" (WiFi nhà máy) không có Internet
         ra ngoài, trước đây các thẻ <link>/<script> trỏ CDN bị treo chờ timeout rất lâu, làm trang
         kẹt loading (báo cáo 2026-10-02 "app load liên tục", đặc biệt rõ ở NV mới). -->
    <link href="~/lib/googlefonts/inter.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/googlefonts/material-symbols.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/fontawesome/css/all.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/bootstrap-icons/bootstrap-icons.css" rel="stylesheet" asp-append-version="true" />

    <!-- Material Dashboard CSS -->
    <link href="~/assets/css/nucleo-icons.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/assets/css/nucleo-svg.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/assets/css/material-dashboard.css?v=3.2.0" rel="stylesheet" asp-append-version="true" />

    <!-- Select2 CSS -->
    <link href="~/lib/select2/select2.min.css" rel="stylesheet" asp-append-version="true" />
    <!-- Site-wide utility classes (site.css) -->
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    <!-- Mobile Table Helper CSS -->
    <link href="~/css/mobile-table.css" rel="stylesheet" asp-append-version="true" />
    <!-- List Page Helper CSS (stats + filter bar + header, mobile) -->
    <link href="~/css/list-page-helper.css" rel="stylesheet" asp-append-version="true" />
    <!-- Time Picker Helper CSS (dropdown chọn giờ kiểu Gate Pass, dùng chung nhiều trang) -->
    <link href="~/css/time-picker.css" rel="stylesheet" asp-append-version="true" />
    <!-- Video Fullscreen Helper CSS -->
    <link href="~/assets/css/video-fullscreen.css" rel="stylesheet" asp-append-version="true" />
    <!-- Menu điều hướng (sidebar + hamburger + mobile bottom-nav) — tách riêng 2026-10-13 cho dễ sửa -->
    <link href="~/assets/css/hr-nav.css" rel="stylesheet" asp-append-version="true" />

    @RenderSection("Styles", required: false)

    <style>
        @@font-face {
            font-family: 'Vnitbi__';
            src: url('@Url.Content("~/fonts/Vnitbi__.ttf")') format('truetype');
            font-display: block;
        }
        .vni-font, .vni-font * {
            font-family: 'Vnitbi__', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif !important;
        }
        :root {
            --header-height: 64px;
            --header-accent: linear-gradient(135deg, #1f2937 0%, #334155 45%, #2563eb 100%);
            --header-surface: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
            --header-border: rgba(148, 163, 184, 0.22);
            --header-title: #334155;
            --header-subtle: #64748b;
        }

        body {
            margin: 0;
            font-family: 'Inter', sans-serif;
        }

        /* Premium Toast Styling */
        .alert-toast {
            border-radius: 16px !important;
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.2) !important;
            margin-bottom: 1rem;
            animation: toastSlideIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            border: 1px solid rgba(255, 255, 255, 0.2) !important;
            overflow: hidden;
        }

        .alert-toast.text-bg-success { background: rgba(45, 206, 137, 0.85) !important; }
        .alert-toast.text-bg-danger { background: rgba(245, 54, 88, 0.85) !important; }
        .alert-toast.text-bg-warning { background: rgba(251, 99, 64, 0.85) !important; color: #fff !important; }
        .alert-toast.text-bg-info { background: rgba(17, 205, 239, 0.85) !important; }

        @@keyframes toastSlideIn {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }

        .main-body {
            flex: 1;
            padding: 1rem;
        }

        .main-header {
            position: sticky;
            top: 0;
            z-index: 1025;
            padding: 0 1.5rem;
            background: var(--header-surface);
            border-bottom: 1px solid var(--header-border);
            display: flex;
            align-items: center;
            min-height: 74px;
        }

        .main-header-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            width: 100%;
            padding: 0;
            background: transparent;
        }

        .main-header-left,
        .main-header-right {
            display: flex;
            align-items: center;
            min-width: 0;
        }

        .main-header-left {
            gap: 0.75rem;
            flex: 1;
        }

        .main-header-right {
            flex-shrink: 0;
        }

        .header-title-wrap {
            min-width: 0;
            flex: 1;
        }

        .header-title {
            display: block;
            max-width: 100%;
            color: var(--header-title);
            font-size: 1.1rem;
            font-weight: 800;
            line-height: 1.2;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            letter-spacing: -0.02em;
        }

        .header-user-toggle {
            max-width: 250px;
            padding: 0.45rem 0.8rem !important;
            border-radius: 50px !important;
            border: 1.5px solid rgba(99,102,241,0.25) !important;
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%) !important;
            color: #ffffff !important;
            font-size: 0.9rem;
            box-shadow: 0 2px 8px rgba(99,102,241,0.3);
        }

        .header-user-toggle:hover {
            background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%) !important;
            box-shadow: 0 4px 12px rgba(99,102,241,0.4);
        }

        .header-user-toggle::after {
            margin-left: 0.45rem;
            color: #ffffff !important;
        }

        .header-user-icon {
            width: 28px;
            height: 28px;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,0.2) !important;
            color: #ffffff !important;
            font-size: 1rem;
            flex-shrink: 0;
        }

        .header-user-name {
            display: inline-block;
            min-width: 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            font-size: 0.9rem;
            font-weight: 600;
            color: #ffffff !important;
        }

        .app-footer {
            font-size: 10.5px;
            padding: 15px 0;
            color: #9aa0a6;
            text-align: center;
            opacity: 0.85;
            background: #f8f9fa;
        }

        /* Loading Overlay */
        #pageLoadingOverlay {
            position: fixed;
            inset: 0;
            z-index: 9999;
            background: rgba(255, 255, 255, 0.88);
            backdrop-filter: blur(4px);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 18px;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.25s ease;
        }
        #pageLoadingOverlay.show {
            opacity: 1;
            pointer-events: all;
        }
        .loading-spinner-ring {
            width: 56px;
            height: 56px;
            border: 5px solid #e0e7ff;
            border-top-color: #5e72e4;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }
        @@media (max-width: 991.98px) {
            .main-header {
                padding: 0 0.75rem;
                min-height: 56px;
            }

            .main-header-bar {
                padding: 0;
            }

            .header-title {
                font-size: 0.9rem;
            }

            .header-user-icon {
                width: 22px;
                height: 22px;
                font-size: 0.85rem;
            }

            .header-user-toggle {
                border: none;
                box-shadow: none;
                padding: 0.2rem 0.4rem !important;
            }

            .header-user-name {
                display: none;
            }

            .header-user-toggle::after {
                display: none;
            }
        }

        @@keyframes spin { to { transform: rotate(360deg); } }
    
        /* Menu tài khoản: 3 mục cao bằng nhau, đủ lớn để bấm trên điện thoại (NV hay bấm nhầm
           Đăng xuất khi định vào Cài đặt — phản ánh 2026-11-13). Bỏ đường kẻ ngăn vì nó làm
           khoảng cách giữa 3 mục không đều. */
        .acct-menu { border-radius: 16px; padding: .35rem; min-width: 210px; }
        .acct-menu .dropdown-item {
            min-height: 48px; padding: .6rem .85rem; border-radius: 12px; font-weight: 600;
        }
        .acct-menu .dropdown-item + .dropdown-item { margin-top: 2px; }
        .acct-menu .material-symbols-rounded { font-size: 1.35rem; }
</style>

    @* ── NGÔN NGỮ GIAO DIỆN ──────────────────────────────────────────────────────────
       Đặt trong <head>, TRƯỚC mọi thứ khác. Lý do: các file .js dùng chung (list-page-helper.js,
       hr-nav.js, time-picker-helper.js) dựng bảng nhãn ngay lúc tải, và home.js được nhúng thẳng
       trong thân trang nên chạy TRƯỚC khối <script> ở cuối body. Khai báo muộn hơn thì
       window.UI_LANG còn undefined và nhãn rơi hết về tiếng Việt. *@
    <script>
        window.UI_LANG = '@lang';
        var IS_KO_UI = window.UI_LANG === 'ko';   // dùng lại ở modal xác nhận cuối body
        // Từ điển Anh → Hàn cho chuỗi dựng trong file .js dùng chung — nguồn là
        // HR_web/Helpers/ExpatText.cs, không gõ lại bản dịch ở JS. Tiếng Anh thì rỗng (fallback).
        window.EXPAT_TR = @Html.Raw(expatTrJson);
        window.trExpat = function (s) { return (window.EXPAT_TR && window.EXPAT_TR[s]) || s; };
        // list-page-helper.js đọc nhãn này lúc tải — lấy qua từ điển để chỉ có 1 bản dịch duy nhất.
        window.CLEAR_FILTER_LABEL = window.trExpat('Clear filters');
    </script>

</head>
<body class="bg-gray-100">

    <!-- Sidenav Backdrop for mobile -->
    <div class="hr-backdrop"></div>

    <!-- Loading Overlay -->
    <div id="pageLoadingOverlay">
        <div class="loading-spinner-ring"></div>
        <div class="fw-bold text-primary">@T("Loading...", "불러오는 중...")</div>
    </div>

    <!-- Toast Alerts Container -->
    <div id="toast-container" class="position-fixed top-0 end-0 p-3" style="z-index: 9998;">
        @Html.RenderAlerts()
    </div>


    <!-- Sidebar (hr_web) -->
    <aside id="hr-sidebar" class="sidenav navbar navbar-vertical navbar-expand-xs border-0 fixed-start bg-white">
        @await Html.PartialAsync("_SideNavExpat")
    </aside>

    <!-- Main Content -->
    <main class="main-content">
        <!-- Header -->
        <div class="main-header shadow-sm">
            <div class="main-header-bar">
            <div class="main-header-left">
                <button id="hr-btnToggle" class="btn btn-link border-0 shadow-none header-toggle-btn" type="button" aria-label="Toggle menu" aria-expanded="false">
                    <span class="material-symbols-rounded" style="font-size: 1.35rem;">menu</span>
                </button>
                <div class="header-title-wrap ms-1">
                    <span class="header-title" title="@ViewData["Title"]">@ViewData["Title"]</span>
                </div>
            </div>

            <div class="main-header-right">
                <div class="dropdown">
                    <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 header-user-toggle" href="#" role="button" data-bs-toggle="dropdown">
                        <span class="header-user-icon">
                            <span class="material-symbols-rounded">person</span>
                        </span>
                        <span class="header-user-name vni-font" title="@rawName">@displayName</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg acct-menu">
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2 py-2" asp-controller="Profile" asp-action="ProfileUser">
                                <span class="material-symbols-rounded text-primary" style="font-size: 1.2rem;">account_circle</span> @T("Profile", "프로필")
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2 py-2" asp-controller="Settings" asp-action="Index">
                                <span class="material-symbols-rounded text-primary" style="font-size: 1.2rem;">settings</span> @T("Settings", "설정")
                            </a>
                        </li>
                                                @* Đổi ngôn ngữ: mặc định theo quốc tịch (ECM100.NATION), bấm đây để tự đổi —
                           lưu HR_USERS.LANG_PREF nên lần đăng nhập sau vẫn giữ (xem AccountController.SetLanguage). *@
                        <li>
                            <form method="post" asp-controller="Account" asp-action="SetLanguage" class="m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="lang" value="@(isKo ? "en" : "ko")" />
                                <input type="hidden" name="returnUrl" value="@(Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString)" />
                                <button type="submit" class="dropdown-item d-flex align-items-center gap-2 py-2">
                                    <span class="material-symbols-rounded text-success" style="font-size: 1.2rem;">language</span>
                                    @(isKo ? "Switch to English" : "한국어로 전환")
                                </button>
                            </form>
                        </li>
                                                <li>
                            <a class="dropdown-item text-danger d-flex align-items-center gap-2 py-2" href="javascript:;" data-bs-toggle="modal" data-bs-target="#logoutModal">
                                <span class="material-symbols-rounded" style="font-size: 1.2rem;">logout</span> @T("Logout", "로그아웃")
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
            </div>
        </div>

        <!-- Body -->
        <section class="main-body">
            @RenderBody()
        </section>

        <!-- Footer -->
        <footer class="app-footer">
            © 2026 VietNam Samho Co., LTD · Powered by IT Team
        </footer>
    </main>

    <!-- Mobile Bottom Navigation — bản Expat: chỉ 1 nhánh, không cần phân role như _Layout -->
    @{
        string notiUrl    = "~/Notification/IndexForExpat";
        string inqUrl     = "~/Leave/TeamCalendarForExpat";
        bool   slot4Active = Context.Request.Path.Value?.Contains("/Leave/TeamCalendar") == true;
    }
    <nav class="mobile-bottom-nav">
        <a href="@Url.Content("~/Home/Index")" class="nav-item-mobile @(Context.Request.Path.Value?.Contains("/Home") == true ? "active" : "")">
            <div class="icon-wrap">
                <span class="material-symbols-rounded">home</span>
            </div>
            <span class="nav-text">@T("Home", "홈")</span>
        </a>
        <a href="@Url.Content("~/Bulletin/Index")" class="nav-item-mobile @(Context.Request.Path.Value?.Contains("/Bulletin") == true ? "active" : "")">
            <div class="icon-wrap" style="position:relative;">
                <span class="material-symbols-rounded">campaign</span>
                <span id="bulletinBadge" style="display:none;position:absolute;top:-4px;right:-6px;background:#c00000;color:white;font-size:.6rem;font-weight:800;border-radius:20px;padding:1px 5px;min-width:16px;text-align:center;line-height:1.4;"></span>
            </div>
            <span class="nav-text">@T("Bulletin", "공지")</span>
        </a>
        <a href="@Url.Content(notiUrl)" class="nav-item-mobile @(Context.Request.Path.Value?.Contains("/Notification") == true ? "active" : "")" id="navBell">
            <div class="icon-wrap" style="position:relative;">
                <span class="material-symbols-rounded">notifications</span>
                <span id="bellBadge" style="display:none;position:absolute;top:-4px;right:-6px;background:#c00000;color:white;font-size:.6rem;font-weight:800;border-radius:20px;padding:1px 5px;min-width:16px;text-align:center;line-height:1.4;"></span>
            </div>
            <span class="nav-text">@T("Notice", "알림")</span>
        </a>
        <a href="@Url.Content(inqUrl)" class="nav-item-mobile @(slot4Active ? "active" : "")">
            <div class="icon-wrap" style="position:relative;">
                <span class="material-symbols-rounded">calendar_month</span>
            </div>
            <span class="nav-text">@T("Calendar", "일정")</span>
        </a>
        <!-- Nối thẳng vào sidebar đầy đủ — trước đây bottom-nav mobile chỉ có 4 lối tắt cố định,
             tách biệt hẳn với sidebar (muốn vào chức năng khác phải mở hamburger ở header, xa tầm
             tay ngón cái) — hợp nhất 2 đường điều hướng lại (yêu cầu 2026-10-13). -->
        <button type="button" class="nav-item-mobile" onclick="window.hrToggleSidebar && window.hrToggleSidebar()">
            <div class="icon-wrap">
                <span class="material-symbols-rounded">menu</span>
            </div>
            <span class="nav-text">@T("Menu", "메뉴")</span>
        </button>
    </nav>

    <!-- Scripts -->


    <!-- Tự host (xem ghi chú ở phần <head>) — tránh treo trang khi app ở "Mạng nội bộ" không có Internet -->
    <script src="~/lib/jquery/jquery-3.6.0.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <!-- Menu điều hướng (đóng/mở sidebar, tìm kiếm, ghim yêu thích) — tách riêng 2026-10-13 -->
    <script src="~/js/hr-nav.js" asp-append-version="true"></script>
    <script src="~/lib/select2/select2.min.js" asp-append-version="true"></script>
    <!-- Gift Gate — bắt 409 gift_pending từ mọi $.ajax, điều hướng sang trang xác nhận nhận quà -->
    <script src="~/js/app-gate.js" asp-append-version="true"></script>
    <!-- Alert Helper -->
    <script src="~/Scripts/alert-helper.js" asp-append-version="true"></script>
    <!-- Select2 Helper -->
    <script src="~/assets/js/select2-helper.js" asp-append-version="true"></script>
    <!-- Mobile Table Helper -->
    <script src="~/js/mobile-table.js" asp-append-version="true"></script>
    <!-- Time Picker Helper (dropdown chọn giờ kiểu Gate Pass, dùng chung nhiều trang) -->
    <script src="~/js/time-picker-helper.js" asp-append-version="true"></script>
    <script src="~/js/list-page-helper.js" asp-append-version="true"></script>
    <script src="~/assets/js/video-fullscreen.js" asp-append-version="true"></script>

    <!-- Material Dashboard JS -->
    <script src="~/assets/js/plugins/perfect-scrollbar.min.js" asp-append-version="true"></script>
    <script src="~/assets/js/material-dashboard.min.js?v=3.2.0" asp-append-version="true"></script>

    <script>
    // Fix: Material Dashboard 3 ripple cleanup crashes when element is removed from DOM
    // before the animation setTimeout fires (e.g. Bootstrap modal close).
    (function () {
        const _orig = Node.prototype.removeChild;
        Node.prototype.removeChild = function (child) {
            if (child && this.contains(child)) return _orig.call(this, child);
        };
    })();
    </script>

    <script>
        window.showLoading = function () {
            document.getElementById('pageLoadingOverlay')?.classList.add('show');
        };

        window.hideLoading = function () {
            document.getElementById('pageLoadingOverlay')?.classList.remove('show');
        };

        $(document).ready(function () {
            $('a').not('[target="_blank"]').not('[href^="#"]').not('[data-bs-toggle]').not('[download]').not('.no-loading, [data-no-loading]').on('click', function(e) {
                if (e.isDefaultPrevented()) return;
                if (!$(this).hasClass('dropdown-toggle')) {
                    window.showLoading();
                }
            });
        });

        // Hide on normal load
        window.addEventListener('load', function () {
            window.hideLoading();
        });

        // Hide when page is restored from bfcache (browser back/forward button)
        window.addEventListener('pageshow', function (e) {
            if (e.persisted) window.hideLoading();
        });

        // Hide on popstate (mobile hardware back, history navigation)
        window.addEventListener('popstate', function () {
            window.hideLoading();
        });

        // Chặn "thoát" 1 gate bắt buộc (survey chưa làm, quà chưa xác nhận, ...) qua nút back cứng
        // Android: khi WebView phục hồi trang TRƯỚC ĐÓ từ back-forward cache, request KHÔNG đi qua
        // server nên AppGateFilterBase (Survey/Gift/...) không chạy lại được. Ở đây re-check thủ
        // công bằng AJAX ngay khi trang được phục hồi, theo ĐÚNG thứ tự ưu tiên các gate đăng ký
        // trong Program.cs — còn pending gate nào thì đẩy sang gate đó, không cho dùng tiếp app.
        // Thêm gate mới (vd Banner): chỉ cần thêm 1 dòng vào GATES, không viết IIFE riêng.
        (function () {
            var GATES = [
                { checkUrl: '@Url.Action("CheckPending", "Survey")', pathRe: /\/survey(\/|$)/i },
                { checkUrl: '@Url.Action("CheckPending", "Gift")',   pathRe: /\/gift(\/|$)/i },
            ];
            var checking = false;
            function tryGate(i) {
                if (i >= GATES.length) { checking = false; return; }
                var gate = GATES[i];
                if (gate.pathRe.test(window.location.pathname)) { tryGate(i + 1); return; } // đang ở trang gate đó rồi, khỏi check
                fetch(gate.checkUrl, { credentials: 'same-origin' })
                    .then(function (r) { return r.ok ? r.json() : null; })
                    .then(function (res) {
                        if (res && res.redirect_url) window.location.href = res.redirect_url;
                        else tryGate(i + 1);
                    })
                    .catch(function () { tryGate(i + 1); /* im lặng bỏ qua — không phá luồng back bình thường */ });
            }
            function recheckAppGates() {
                if (checking) return;
                checking = true;
                tryGate(0);
            }
            window.addEventListener('pageshow', function (e) { if (e.persisted) recheckAppGates(); });
            window.addEventListener('popstate', recheckAppGates);
        })();
    </script>

