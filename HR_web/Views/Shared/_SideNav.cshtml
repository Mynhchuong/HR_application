@using HR_web.Helpers
@using HR_web.Models.Account
@inject HR_web.API.Service.TrainingService TrainingService

@{
    var user = AuthHelper.GetCurrentUser(User);
    var currentPath = Context.Request.Path.Value?.ToLower().TrimEnd('/') ?? "";
    var isMobileApp = MobileHelper.IsMobileApp(Context);
    bool isActiveTeacher = false;
    if (user != null)
    {
        isActiveTeacher = await TrainingService.IsActiveTeacherAsync(user.EmpCd);
    }
    var menus = SideMenuBuilder.Build(user, isMobileApp, isActiveTeacher);
    var menuThemes = new[]
    {
        "menu-theme-personal",
        "menu-theme-clerk",
        "menu-theme-manager",
        "menu-theme-hr"
    };

    // Tìm tiêu đề trang từ menu đang active
    string pageTitle = "";
    foreach (var menu in menus.Where(m => m.VisibleWhen?.Invoke() == true))
    {
        foreach (var item in menu.Children)
        {
            if (string.IsNullOrEmpty(item.Url)) continue;
            var menuPath = Url.Content(item.Url).ToLower().TrimEnd('/');
            if (currentPath.StartsWith(menuPath))
            {
                pageTitle = item.Title;
                break;
            }
        }
        if (!string.IsNullOrEmpty(pageTitle)) break;
    }
}

<!-- CSS của sidenav đã chuyển sang wwwroot/assets/css/hr-nav.css (load ở _Layout.cshtml) — tách
     riêng cho dễ sửa (yêu cầu 2026-10-13). -->

<!-- ===== SIDENAV HEADER ===== -->
<div class="sidenav-header">
    <i class="fas fa-times p-3 cursor-pointer text-dark opacity-5 position-absolute end-0 top-0 d-block d-lg-none"
       id="hr-iconSidenav"></i>

    <div class="navbar-brand px-4 py-4 m-0 d-flex align-items-center cursor-default" style="border-bottom: 1px solid rgba(0,0,0,0.03);">
        <div class="d-flex align-items-center justify-content-center bg-white shadow-sm rounded-3 me-2" style="width: 42px; height: 42px; border: 1px solid #f1f5f9; flex-shrink: 0;">
            <img src="~/assets/img/samho-logo.png" class="navbar-brand-img" style="width: 30px; height: auto;" alt="logo" />
        </div>
        <div class="d-flex flex-column">
            <span class="fw-bolder" style="letter-spacing: -0.5px; line-height: 1.1;">
                <span style="color: #ed1c24; font-size: 1.25rem;">My</span> 
                <span style="color: #1e293b; font-size: 1.25rem;">SAMHO</span>
            </span>
            <span class="text-uppercase text-muted fw-bold" style="font-size: 0.65rem; letter-spacing: 0.5px; opacity: 0.8;">HR Portal</span>
        </div>
    </div>
</div>

<hr class="horizontal dark mt-0 mb-2" />

<!-- ===== SEARCH (sticky — luôn thấy được dù đang cuộn menu dài) ===== -->
<div class="sidenav-search-wrap px-3 pb-2">
    <div style="position:relative;">
        <i class="material-symbols-rounded"
           style="position:absolute;left:10px;top:50%;transform:translateY(-50%);font-size:1.05rem;color:#94a3b8;pointer-events:none;">search</i>
        <input type="text" id="sidenavSearch" placeholder="Tìm chức năng..."
               autocomplete="off"
               style="width:100%;height:38px;border:1.5px solid #e2e8f0;border-radius:12px;
                      padding:0 12px 0 34px;font-size:0.85rem;color:#1e293b;
                      background:#f8fafc;transition:all 0.2s;">
    </div>
</div>

<!-- ===== YÊU THÍCH (mục đã ghim — localStorage, JS tự đổ vào, rỗng thì tự ẩn) =====
     Đây là lối tắt chính giúp menu không cảm giác "phình dài hơn" dù sau này có thêm bao nhiêu
     role/chức năng nữa (yêu cầu 2026-10-13: thiết kế chịu được mở rộng). -->
<div id="sidenavFavorites" class="d-none"></div>

<!-- ===== SIDENAV MENU ===== -->
<div class="navbar-collapse w-auto max-height-vh-100 h-100" id="sidenav-collapse-main">
    <ul class="navbar-nav">

        @foreach (var menuEntry in menus.Where(m => m.VisibleWhen?.Invoke() == true).Select((menu, index) => new { menu, index }))
        {
            var menu = menuEntry.menu;
            var themeClass = menuThemes[menuEntry.index % menuThemes.Length];
            bool open = menu.Children.Any(c =>
                !string.IsNullOrEmpty(c.Url) &&
                currentPath.StartsWith(Url.Content(c.Url).ToLower())
            );

            <li class="nav-item mt-2 @themeClass">
                <a class="nav-link text-dark d-flex justify-content-between align-items-center"
                   data-bs-toggle="collapse"
                   href="#@menu.Id"
                   aria-expanded="@open.ToString().ToLower()">

                    <span class="d-flex align-items-center">
                        <span class="menu-icon-shell">
                            <i class="material-symbols-rounded">@menu.Icon</i>
                        </span>
                        <span class="nav-link-text">@menu.Title</span>
                    </span>

                    <i class="material-symbols-rounded">expand_more</i>
                </a>

                <div class="collapse ps-3 @(open ? "show" : "")" id="@menu.Id">
                    <ul class="navbar-nav">
                        @{ string? lastGroup = null; }
                        @foreach (var item in menu.Children.Where(c => c.VisibleWhen == null || c.VisibleWhen()))
                        {
                            bool active = !string.IsNullOrEmpty(item.Url) &&
                                          currentPath.StartsWith(Url.Content(item.Url).ToLower());

                            // Đổi cụm (Group) so với item trước → chèn nhãn màu cho cụm mới.
                            if (!string.IsNullOrEmpty(item.Group) && item.Group != lastGroup
                                && MenuGroupCatalog.Styles.TryGetValue(item.Group, out var groupStyle))
                            {
                                <li class="menu-group-label" style="color:@groupStyle.Color;">
                                    <span class="menu-group-dot" style="background:@groupStyle.Color;"></span>@groupStyle.Label
                                </li>
                            }
                            lastGroup = item.Group;

                            string? itemColor = null;
                            if (!string.IsNullOrEmpty(item.Group) && MenuGroupCatalog.Styles.TryGetValue(item.Group, out var itemStyle))
                            {
                                itemColor = itemStyle.Color;
                            }

                            <li class="nav-item menu-child-item" data-search="@item.Title.ToLower()">
                                <div class="d-flex align-items-center">
                                    <a class="nav-link text-dark rounded px-2 py-1 flex-grow-1 @(active ? "active fw-bold bg-light" : "")"
                                       href="@Url.Content(item.Url ?? "#")">
                                        <span class="menu-child-icon" style="@(itemColor != null ? $"background:{itemColor}22;" : "")">
                                            <i class="material-symbols-rounded" style="@(itemColor != null ? $"color:{itemColor};" : "")">@item.Icon</i>
                                        </span>
                                        <span class="nav-link-text">@item.Title</span>
                                        @if (!string.IsNullOrEmpty(item.BadgeId))
                                        {
                                            <span id="@item.BadgeId" class="menu-unread-badge" style="display:none;">0</span>
                                        }
                                    </a>
                                    @if (!string.IsNullOrEmpty(item.Url))
                                    {
                                        <button type="button" class="menu-pin-btn" title="Ghim vào Yêu thích"
                                                data-pin-url="@Url.Content(item.Url)" data-pin-title="@item.Title" data-pin-icon="@item.Icon">
                                            <i class="material-symbols-rounded">star_outline</i>
                                        </button>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </li>
        }

    </ul>
</div>

<!-- JS tìm kiếm + ghim yêu thích đã chuyển sang wwwroot/js/hr-nav.js (load ở _Layout.cshtml). -->
