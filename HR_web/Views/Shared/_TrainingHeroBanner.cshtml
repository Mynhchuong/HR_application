@model HR_web.Models.Training.TrainingHeroBannerVM
<div class="card border-0 mb-4">
    <div class="bg-gradient-@Model.Gradient border-radius-lg p-4 d-flex justify-content-between align-items-center overflow-hidden">
        <div class="text-white" style="max-width:65%;">
            <h4 class="text-white mb-1">@Model.Title</h4>
            @if (!string.IsNullOrEmpty(Model.Subtitle))
            {
                <p class="text-white opacity-8 mb-0 text-sm">@Model.Subtitle</p>
            }
        </div>
        @if (!string.IsNullOrEmpty(Model.IllustrationImg))
        {
            <img src="@Url.Content(Model.IllustrationImg)" alt=""
                 class="d-none d-md-block"
                 style="height:120px;width:auto;object-fit:contain;" />
        }
    </div>
</div>
