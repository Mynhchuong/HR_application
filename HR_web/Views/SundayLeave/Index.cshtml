@{
    ViewData["Title"] = "Danh sách làm Chủ Nhật";
}

@section Styles {
<style>
    #tblBody tr td { vertical-align: middle; }
    .row-selected td { background: #fef9c3 !important; }
    #bulkBar {
        display: none; position: fixed; bottom: 28px; left: 50%; transform: translateX(-50%);
        background: #1e293b; color: #fff; border-radius: 14px; padding: 10px 20px;
        align-items: center; gap: 14px; z-index: 9999; box-shadow: 0 4px 24px rgba(0,0,0,.28);
    }
    #bulkBar.show { display: flex; }
    #bulkBar .sel-count { font-size: .88rem; font-weight: 700; }
    #bulkBar .btn-bulk-delete { background:#dc2626;color:#fff;border:none;border-radius:8px;padding:6px 16px;font-weight:600;font-size:.82rem;cursor:pointer; }
    #bulkBar .btn-bulk-delete:hover { background:#b91c1c; }
    #bulkBar .btn-bulk-cancel  { background:transparent;color:#cbd5e1;border:1px solid #475569;border-radius:8px;padding:6px 14px;font-size:.82rem;cursor:pointer; }
    #bulkBar .btn-bulk-cancel:hover { color:#fff;border-color:#94a3b8; }
</style>
}

<div class="container-fluid py-4">
    <div class="card my-4">
        <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
            <div class="bg-gradient-success shadow-success border-radius-lg pt-3 pb-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h6 class="text-white mb-0"><i class="material-symbols-rounded me-1" style="font-size:1.1rem;vertical-align:middle">wb_sunny</i> DS Nhân Viên Làm Chủ Nhật</h6>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <button class="btn btn-sm mb-0" style="background:#fff;color:#344767;font-weight:600;"
                            data-bs-toggle="modal" data-bs-target="#addModal">
                        <i class="bi bi-person-plus-fill me-1"></i> Thêm NV
                    </button>
                    <button class="btn btn-sm mb-0" style="background:#7030a0;color:#fff;font-weight:600;"
                            onclick="document.getElementById('importFile').click()">
                        <i class="bi bi-upload me-1"></i> Import Excel
                    </button>
                    <a href="@Url.Action("DownloadTemplate","SundayLeave")"
                       class="btn btn-sm mb-0" style="background:#0070c0;color:#fff;font-weight:600;">
                        <i class="bi bi-download me-1"></i> Tải mẫu
                    </a>
                    <button class="btn btn-sm mb-0" style="background:#1d6f42;color:#fff;font-weight:600;"
                            onclick="exportExcel()">
                        <i class="bi bi-file-earmark-excel me-1"></i> Xuất Excel
                    </button>
                </div>
            </div>
        </div>

        <!-- Filter bar — same style as LeaveListForHR -->
        <div class="px-3 pt-3 pb-2 d-flex flex-wrap align-items-end gap-2" style="background:#f8fafc;border-bottom:1px solid #e9ecef;">
            <div style="min-width:140px;flex:1 1 140px;max-width:200px;">
                <label class="form-label small fw-bold mb-1 text-primary">Mã NV / Tên</label>
                <input type="text" id="fSearch" class="form-control form-control-sm" placeholder="🔍 Tìm...">
            </div>
            <div style="min-width:160px;flex:2 1 160px;max-width:260px;">
                <label class="form-label small fw-bold mb-1 text-primary">Phòng Ban</label>
                <select id="fDept" class="select2 form-control"
                        data-url="@Url.Action("GetDept","Dropdown")"
                        data-placeholder="Tất cả"></select>
            </div>
            <div style="min-width:160px;flex:2 1 160px;max-width:260px;">
                <label class="form-label small fw-bold mb-1 text-primary">Line</label>
                <select id="fLine" class="select2 form-control"
                        data-url="@Url.Action("GetLine","Dropdown")"
                        data-parent="#fDept"
                        data-placeholder="Tất cả"></select>
            </div>
            <div style="min-width:140px;flex:2 1 140px;max-width:220px;">
                <label class="form-label small fw-bold mb-1 text-primary">Work</label>
                <select id="fWork" class="select2 form-control"
                        data-url="@Url.Action("GetWork","Dropdown")"
                        data-parent="#fLine"
                        data-parent-key="lineCd"
                        data-parent2="#fDept"
                        data-parent2-key="deptCd"
                        data-placeholder="Tất cả"></select>
            </div>
        </div>

        <div class="card-body px-0 pt-0 pb-2 mt-1">
            <div class="table-responsive p-0 px-4">
                <table class="table align-items-center mb-0 w-100 table-hover table-striped">
                    <thead class="bg-light">
                        <tr>
                            <th class="text-center px-2" style="width:44px;">
                                <input type="checkbox" id="chkAll" style="cursor:pointer;width:16px;height:16px;" title="Chọn tất cả">
                            </th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">#</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Mã NV</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Họ &amp; Tên</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Phòng Ban</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Line</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Work</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Ngày thêm</th>
                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2"></th>
                        </tr>
                    </thead>
                    <tbody id="tblBody">
                        <tr><td colspan="9" class="text-center py-5"><div class="spinner-border text-success" role="status"></div></td></tr>
                    </tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center px-4 mt-2 mb-2">
                <div id="countInfo" class="text-sm text-secondary"></div>
            </div>
        </div>
    </div>
</div>

<!-- Bulk bar -->
<div id="bulkBar">
    <span class="sel-count"><span id="selCount">0</span> đã chọn</span>
    <button class="btn-bulk-delete" onclick="confirmBulkDelete()"><i class="bi bi-trash3-fill me-1"></i>Xoá</button>
    <button class="btn-bulk-cancel" onclick="clearSelection()">Bỏ chọn</button>
</div>

<!-- hidden file input -->
<input type="file" id="importFile" accept=".xlsx,.xls" style="display:none" onchange="doImport(this)">

@Html.AntiForgeryToken()

<!-- Modal: Thêm NV -->
<div class="modal fade" id="addModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg" style="border-radius:20px">
            <div class="modal-body p-4">
                <h6 class="fw-bold mb-3"><i class="bi bi-person-plus-fill text-success me-2"></i>Thêm NV làm Chủ Nhật</h6>
                <input id="addEmpCd" type="text" class="form-control" placeholder="Nhập mã nhân viên..." maxlength="20"
                       onkeydown="if(event.key==='Enter')submitAdd()">
            </div>
            <div class="modal-footer border-0 pt-0 px-4 pb-4 gap-2">
                <button class="btn btn-outline-secondary flex-fill" data-bs-dismiss="modal">Huỷ</button>
                <button class="btn btn-success flex-fill" onclick="submitAdd()">Thêm</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Import result -->
<div class="modal fade" id="importResultModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg" style="border-radius:20px">
            <div class="modal-header border-0 pb-0">
                <h6 class="fw-bold mb-0"><i class="bi bi-table text-primary me-2"></i>Kết quả Import</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="importSummary" class="text-sm text-secondary mb-2"></div>
                <div class="table-responsive" style="max-height:320px">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="bg-light"><tr><th>Mã NV</th><th>Kết quả</th></tr></thead>
                        <tbody id="importResultBody"></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button class="btn btn-success w-100" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
const TOKEN = document.querySelector('input[name="__RequestVerificationToken"]').value;

function escHtml(str) { return String(str ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function debounce(fn, d) { let t; return function() { clearTimeout(t); t = setTimeout(fn, d); }; }

// ── Load list ────────────────────────────────────────────────────────────────
function loadList() {
    clearSelection();
    $('#tblBody').html('<tr><td colspan="9" class="text-center py-5"><div class="spinner-border text-success" role="status"></div></td></tr>');

    const params = {};
    const dept = $('#fDept').val(), line = $('#fLine').val(), work = $('#fWork').val();
    const search = $('#fSearch').val().trim();
    if (dept)   params.deptCd = dept;
    if (line)   params.lineCd = line;
    if (work)   params.workCd = work;
    if (search) params.search = search;

    $.ajax({
        url: '@Url.Action("GetList","SundayLeave")', type: 'GET', data: params,
        success: function(res) {
            const data = res.data || [];
            $('#countInfo').html(data.length ? `<span class="text-xs">${data.length} nhân viên</span>` : '');

            if (!data.length) {
                $('#tblBody').html('<tr><td colspan="9" class="text-center text-muted py-4"><img src="@(new Random().Next(2)==0 ? Url.Content("~/assets/img/illustrations/A_nodata.png") : Url.Content("~/assets/img/illustrations/Chi_nodata.png"))" alt="" style="max-width:140px;display:block;margin:0 auto .5rem;opacity:.9;" />Không có dữ liệu</td></tr>');
                return;
            }

            $('#tblBody').html(data.map((e, i) => `
                <tr>
                    <td class="text-center px-2">
                        <input type="checkbox" class="row-chk" value="${escHtml(e.EMPCD)}"
                               onchange="onRowCheck(this)" style="cursor:pointer;width:16px;height:16px;">
                    </td>
                    <td class="px-2 text-xs text-secondary">${i + 1}</td>
                    <td class="px-2 text-sm">${escHtml(e.EMPCD)}</td>
                    <td class="px-2">
                        <div class="emp-name vni-font" style="text-transform:uppercase;font-size:.9rem;">${escHtml(e.EMP_NAME)}</div>
                    </td>
                    <td class="px-2"><span class="badge bg-primary">${escHtml(e.DEPT_NAME || e.DEPT_ID || '-')}</span></td>
                    <td class="px-2 text-sm">${escHtml(e.LINE_NAME || e.LINE_ID || '-')}</td>
                    <td class="px-2 text-sm">${escHtml(e.WORK_NAME || e.WORK_ID || '-')}</td>
                    <td class="px-2 text-sm text-secondary">${escHtml(e.INST_DT)}</td>
                    <td class="px-2">
                        <button class="btn btn-sm btn-outline-danger px-2 py-1"
                                data-empcd="${escHtml(e.EMPCD)}" data-name="${escHtml(e.EMP_NAME)}"
                                onclick="removeEmp(this.dataset.empcd, this.dataset.name)">
                            <i class="bi bi-trash3"></i>
                        </button>
                    </td>
                </tr>`).join(''));

            document.getElementById('chkAll').checked = false;
            document.getElementById('chkAll').indeterminate = false;
        },
        error: function() {
            $('#tblBody').html('<tr><td colspan="9" class="text-center text-danger py-4">Lỗi tải dữ liệu</td></tr>');
        }
    });
}

// ── Add / Remove ─────────────────────────────────────────────────────────────
async function submitAdd() {
    const empCd = document.getElementById('addEmpCd').value.trim();
    if (!empCd) { showToast('Nhập mã nhân viên!', 'warning'); return; }
    const res  = await fetch('@Url.Action("Add","SundayLeave")', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN },
        body: JSON.stringify({ empCd })
    });
    const json = await res.json();
    showToast(json.message, json.success ? 'success' : 'error');
    if (json.success) {
        bootstrap.Modal.getInstance(document.getElementById('addModal'))?.hide();
        document.getElementById('addEmpCd').value = '';
        loadList();
    }
}

function removeEmp(empCd, name) {
    showConfirm(`Xoá <strong>${name || empCd}</strong> khỏi danh sách làm Chủ Nhật?`, async () => {
        const res  = await fetch('@Url.Action("Remove","SundayLeave")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN },
            body: JSON.stringify({ empCd })
        });
        const json = await res.json();
        showToast(json.message, json.success ? 'success' : 'error');
        if (json.success) loadList();
    }, { title: 'Xác nhận xoá', okText: 'Xoá', icon: 'person_remove', iconColor: '#dc2626', iconBg: '#fee2e2' });
}

// ── Bulk select ───────────────────────────────────────────────────────────────
function onRowCheck(chk) {
    chk.closest('tr').classList.toggle('row-selected', chk.checked);
    updateBulkBar();
}

function updateBulkBar() {
    const all     = document.querySelectorAll('.row-chk');
    const checked = document.querySelectorAll('.row-chk:checked');
    const n = checked.length;
    document.getElementById('chkAll').indeterminate = n > 0 && n < all.length;
    document.getElementById('chkAll').checked       = n > 0 && n === all.length;
    document.getElementById('selCount').textContent  = n;
    document.getElementById('bulkBar').classList.toggle('show', n > 0);
}

document.getElementById('chkAll').addEventListener('change', function() {
    document.querySelectorAll('.row-chk').forEach(c => {
        c.checked = this.checked;
        c.closest('tr').classList.toggle('row-selected', this.checked);
    });
    updateBulkBar();
});

function clearSelection() {
    document.querySelectorAll('.row-chk').forEach(c => {
        c.checked = false;
        c.closest('tr')?.classList.remove('row-selected');
    });
    const ca = document.getElementById('chkAll');
    if (ca) { ca.checked = false; ca.indeterminate = false; }
    document.getElementById('bulkBar').classList.remove('show');
}

function confirmBulkDelete() {
    const empCds = [...document.querySelectorAll('.row-chk:checked')].map(c => c.value);
    if (!empCds.length) return;
    showConfirm(
        `Xoá <strong>${empCds.length}</strong> nhân viên khỏi danh sách làm Chủ Nhật?<br><small class="text-danger">Thao tác này không thể hoàn tác.</small>`,
        async () => {
            const res  = await fetch('@Url.Action("RemoveBulk","SundayLeave")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN },
                body: JSON.stringify({ empCds })
            });
            const json = await res.json();
            showToast(json.message, json.success ? 'success' : 'error');
            if (json.success) { clearSelection(); loadList(); }
        },
        { title: 'Xác nhận xoá hàng loạt', okText: `Xoá ${empCds.length} NV`, icon: 'delete_forever', iconColor: '#dc2626', iconBg: '#fee2e2' }
    );
}

// ── Export ────────────────────────────────────────────────────────────────────
function exportExcel() {
    const qs = new URLSearchParams();
    const dept = $('#fDept').val(), line = $('#fLine').val(), work = $('#fWork').val();
    const search = $('#fSearch').val().trim();
    if (dept)   qs.set('deptCd', dept);
    if (line)   qs.set('lineCd', line);
    if (work)   qs.set('workCd', work);
    if (search) qs.set('search', search);
    window.location.href = '@Url.Action("ExportExcel","SundayLeave")?' + qs.toString();
}

// ── Import ────────────────────────────────────────────────────────────────────
async function doImport(input) {
    if (!input.files?.length) return;
    const form = new FormData();
    form.append('file', input.files[0]);
    form.append('__RequestVerificationToken', TOKEN);
    input.value = '';
    showToast('Đang import...', 'info');
    const res  = await fetch('@Url.Action("ImportExcel","SundayLeave")', { method: 'POST', body: form });
    const json = await res.json();
    if (!json.success && !json.results?.length) { showToast(json.message || 'Import thất bại', 'error'); return; }
    const results  = json.results || [];
    const okCount  = results.filter(r => r.success).length;
    document.getElementById('importSummary').textContent =
        `Tổng: ${results.length} | Thành công: ${okCount} | Lỗi: ${results.length - okCount}`;
    document.getElementById('importResultBody').innerHTML = results.map(r => `
        <tr>
            <td><strong>${escHtml(r.empCd)}</strong></td>
            <td><span class="badge ${r.success ? 'bg-success' : 'bg-danger'}">${escHtml(r.message)}</span></td>
        </tr>`).join('');
    new bootstrap.Modal(document.getElementById('importResultModal')).show();
    if (okCount > 0) loadList();
}

// ── Init ──────────────────────────────────────────────────────────────────────
$(document).ready(function() {
    if (typeof Select2Helper !== 'undefined') Select2Helper.init();

    $('#fDept').on('change', function() { $('#fLine, #fWork').val(null).trigger('change.select2'); loadList(); });
    $('#fLine').on('change', function() { $('#fWork').val(null).trigger('change.select2'); loadList(); });
    $('#fWork').on('change', () => loadList());
    $('#fSearch').on('input', debounce(loadList, 400));

    loadList();
});
</script>
}
