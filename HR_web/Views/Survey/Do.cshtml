@model HR_web.Models.Survey.SurveyDoViewModel
@{
    ViewData["Title"] = Model?.Survey?.TITLE ?? "Survey";
    Layout = "_LayoutEmbed";

    var isEn        = Model?.Survey?.LANG == "EN";
    var isQuiz      = Model?.Survey?.SURVEY_TYPE == "QUIZ";
    var questions   = Model?.Survey?.QUESTIONS ?? new();
    // Answers đã save từ trước (resume)
    var answersJson = Newtonsoft.Json.JsonConvert.SerializeObject(Model?.Response?.ANSWERS ?? new());
    var surveyId    = Model?.Survey?.ID ?? 0;
    var mascotName  = Random.Shared.Next(2) == 0 ? "survey_boy.png" : "survey_girl.png";
}

@section Styles {
    <link href="~/assets/css/survey.css" rel="stylesheet" asp-append-version="true" />
}

@if (!string.IsNullOrEmpty(Model?.Error))
{
    <div class="survey-notice">
        <div class="survey-notice-icon">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>
        <div class="survey-notice-title">
            @(isEn ? "Survey unavailable" : "Survey không khả dụng")
        </div>
        <div class="survey-notice-msg">@Model.Error</div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary mt-3">
            @(isEn ? "Back to Home" : "Về trang chủ")
        </a>
    </div>
}
else if (Model?.Survey == null || questions.Count == 0)
{
    <div class="survey-notice">
        <div class="survey-notice-icon"><i class="bi bi-exclamation-circle"></i></div>
        <div class="survey-notice-msg">
            @(isEn ? "Survey has no questions." : "Survey chưa có câu hỏi.")
        </div>
    </div>
}
else
{
    <!-- ── Landing modal (hiện trước, user nhấn Bắt đầu mới vô làm) ── -->
    <div class="survey-landing" id="surveyLanding">
        <div class="sv-landing-card">
            <div class="sv-landing-mascot">
                <img src="@Url.Content("~/assets/img/icons/" + mascotName)" alt="mascot" onerror="this.style.display='none'" />
            </div>
            <div class="sv-landing-title" title="@Model.Survey.TITLE">@Model.Survey.TITLE</div>
            @if (!string.IsNullOrWhiteSpace(Model.Survey.DESCRIPTION))
            {
                <div class="sv-landing-desc">@Model.Survey.DESCRIPTION</div>
            }
            <div class="sv-landing-mandatory">
                <i class="bi bi-info-circle-fill me-1"></i>
                @(isEn
                    ? "You must complete this survey to continue using the My Samho app. Thank you."
                    : "Bạn phải làm hết bài khảo sát mới được sử dụng ứng dụng My Samho. Xin cảm ơn.")
            </div>
            <div class="sv-landing-actions">
                <button type="button" class="btn btn-primary btn-lg sv-btn-start" id="btnStartSurvey">
                    <i class="bi bi-play-fill me-1"></i>
                    @(isEn ? "Start" : "Bắt đầu làm")
                </button>
            </div>
        </div>
    </div>

    <div class="survey-container d-none" id="surveyContainer"
         data-survey-id="@surveyId"
         data-survey-type="@Model.Survey.SURVEY_TYPE"
         data-lang="@Model.Survey.LANG"
         data-total="@questions.Count"
         data-mascot="/assets/img/icons/@mascotName">

        <!-- ── Header ── -->
        <header class="survey-header">
            <div class="survey-title" title="@Model.Survey.TITLE">@Model.Survey.TITLE</div>
        </header>

        <div class="survey-progress">
            <div class="survey-progress-bar" id="progressBar" style="width: 0%"></div>
        </div>
        <div class="survey-progress-text">
            <span id="progressText">1 / @questions.Count</span>
        </div>

        <!-- ── Question wrapper (JS render 1 câu / lần) ── -->
        <main class="survey-body">
            <div id="questionWrapper"></div>
            <div class="sv-question-mascot">
                <img src="@Url.Content("~/assets/img/icons/" + mascotName)" alt="mascot" onerror="this.parentElement.style.display='none'" />
            </div>
        </main>

        <!-- ── Footer nav ── -->
        <footer class="survey-footer">
            <button type="button" class="btn btn-outline-secondary" id="btnBack" disabled>
                <i class="bi bi-chevron-left"></i>
                <span>@(isEn ? "Back" : "Quay lại")</span>
            </button>
            <button type="button" class="btn btn-primary" id="btnNext" disabled>
                <span id="btnNextLabel">@(isEn ? "Next" : "Tiếp theo")</span>
                <i class="bi bi-chevron-right"></i>
            </button>
        </footer>
    </div>

    <!-- ── Modal xác nhận "Tôi không biết chữ" ── -->
    <div class="survey-modal" id="modalIlliterate">
        <div class="survey-modal-content">
            <div class="survey-modal-title">
                @(isEn ? "Confirm illiteracy" : "Xác nhận không biết chữ")
            </div>
            <div class="survey-modal-body">
                @if (isEn)
                {
                    <p>You confirm that you cannot read and do not need to complete the survey?</p>
                    <p>HR will note this. Future surveys will be <b>automatically skipped</b> for you.</p>
                    <p>You are responsible for this choice.</p>
                }
                else
                {
                    <p>Bạn xác nhận không biết chữ để không cần làm survey?</p>
                    <p>Phòng nhân sự sẽ lưu ý lại và các survey sau bạn sẽ được <b>miễn tự động</b>.</p>
                    <p>Bạn phải chịu trách nhiệm với lựa chọn này.</p>
                }
            </div>
            <div class="survey-modal-actions">
                <button type="button" class="btn btn-outline-secondary" data-close="modalIlliterate">
                    @(isEn ? "Cancel" : "Huỷ")
                </button>
                <button type="button" class="btn btn-danger" id="btnIlliterateConfirm">
                    @(isEn ? "Confirm" : "Xác nhận")
                </button>
            </div>
        </div>
    </div>

    <!-- ── Modal xác nhận Submit ── -->
    <div class="survey-modal" id="modalSubmit">
        <div class="survey-modal-content">
            <div class="sv-modal-icon">
                <i class="bi bi-@(isQuiz ? "patch-question-fill text-warning" : "send-check-fill text-primary")"></i>
            </div>
            <div class="survey-modal-title">
                @(isEn ? (isQuiz ? "Submit your quiz?" : "Submit your answers?")
                       : (isQuiz ? "Nộp bài trắc nghiệm?" : "Gửi câu trả lời?"))
            </div>
            <div class="survey-modal-body">
                @if (isQuiz)
                {
                    <p class="mb-2">@(isEn ? "Please review your answers before submitting." : "Vui lòng kiểm tra lại các câu trả lời trước khi nộp.")</p>
                    <div class="sv-warn-box">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span>@(isEn ? "You can NOT redo this quiz after submitting." : "Sau khi nộp bạn KHÔNG thể làm lại bài này.")</span>
                    </div>
                }
                else
                {
                    <p>@(isEn ? "Thank you for your feedback. Your response will be recorded." : "Cảm ơn bạn đã tham gia khảo sát. Câu trả lời của bạn sẽ được ghi nhận.")</p>
                }
            </div>
            <div class="survey-modal-actions">
                <button type="button" class="btn btn-outline-secondary" data-close="modalSubmit">
                    @(isEn ? "Cancel" : "Huỷ")
                </button>
                <button type="button" class="btn btn-primary" id="btnSubmitConfirm">
                    <i class="bi bi-check-lg me-1"></i> @(isEn ? "Submit" : "Nộp bài")
                </button>
            </div>
        </div>
    </div>

    <!-- ── Modal kết quả (sau submit) ── -->
    <div class="survey-modal" id="modalResult">
        <div class="survey-modal-content">
            <div class="survey-modal-title" id="resultTitle"></div>
            <div class="survey-modal-body" id="resultBody"></div>
            <div class="survey-modal-actions">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                    @(isEn ? "Go home" : "Về trang chủ")
                </a>
            </div>
        </div>
    </div>

    @* Anti-forgery token dùng cho POST AJAX *@
    <form id="antiForgeryForm">@Html.AntiForgeryToken()</form>

    @section Scripts {
        <script>
            window.SURVEY_DATA = {
                surveyId: @surveyId,
                type:     @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Survey.SURVEY_TYPE)),
                lang:     @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Survey.LANG)),
                questions:@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(questions)),
                answers:  @Html.Raw(answersJson),
                urls: {
                    saveAnswer: '@Url.Action("SaveAnswer", "Survey")',
                    submit:     '@Url.Action("Submit", "Survey")',
                    skip:       '@Url.Action("Skip", "Survey")',
                    testSubmit: '@Url.Action("TestSubmit", "SurveyAdmin")',
                    homeIndex:  '@Url.Action("Index", "Home")',
                    adminIndex: '@Url.Action("Index", "SurveyAdmin")',
                }
            };
        </script>
        <script src="~/assets/js/survey.js" asp-append-version="true"></script>
    }
}
