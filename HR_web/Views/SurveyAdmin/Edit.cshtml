@model HR_web.Models.Survey.SurveyModel
@{
    var isNew         = (bool)(ViewBag.IsNew ?? true);
    var isLimitedEdit = (bool)(ViewBag.IsLimitedEdit ?? false);
    ViewData["Title"] = isNew ? "Tạo Survey" : "Sửa Survey";
}

@section Styles {
    <link href="~/assets/css/survey-admin.css" rel="stylesheet" asp-append-version="true" />
}

<div class="container-fluid py-4">
    <div class="card my-4">
        <div class="card-header sa-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span class="sa-title">
                <i class="bi bi-@(isNew ? "plus-circle-fill" : "pencil-square") me-2"></i>
                @(isNew ? "Tạo Survey mới" : $"Sửa Survey #{Model.ID}")
            </span>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
        </div>

        <div class="card-body p-0">
            @if (isLimitedEdit)
            {
                <div class="alert alert-warning m-3 mb-0 py-2 small">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                    Survey đang chạy (<b>@Model.STATUS</b>) — chỉ sửa được <b>Tiêu đề, Mô tả, Ngày kết thúc, Đối tượng nhận</b>.
                    Câu hỏi, Loại survey, Ngày bắt đầu, Điểm đậu đã khoá để không ảnh hưởng các câu trả lời đã có.
                </div>
            }
            <!-- Wizard step indicator -->
            <div class="sa-wizard-steps">
                <div class="sa-step active" data-step="1">
                    <div class="sa-step-num">1</div>
                    <div class="sa-step-label">Loại + Ngôn ngữ</div>
                </div>
                <div class="sa-step-line"></div>
                <div class="sa-step" data-step="2">
                    <div class="sa-step-num">2</div>
                    <div class="sa-step-label">Câu hỏi</div>
                </div>
                <div class="sa-step-line" data-line-for="3"></div>
                <div class="sa-step" data-step="3">
                    <div class="sa-step-num">3</div>
                    <div class="sa-step-label">Phạm vi</div>
                </div>
                <div class="sa-step-line" data-line-for="4"></div>
                <div class="sa-step" data-step="4">
                    <div class="sa-step-num">4</div>
                    <div class="sa-step-label">Thời gian</div>
                </div>
            </div>

            <div class="p-4">
                <!-- ── Step 1 ──────────────────────── -->
                <div class="sa-panel" data-panel="1">
                    <h6 class="sa-panel-title">Chọn loại survey và ngôn ngữ</h6>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="sa-label">Loại</label>
                            <div class="d-flex gap-2 mt-1">
                                <label class="sa-radio-card @(Model.SURVEY_TYPE == "POLL" ? "active" : "") @(isLimitedEdit ? "disabled" : "")">
                                    <input type="radio" name="SURVEY_TYPE" value="POLL" @(Model.SURVEY_TYPE == "POLL" ? "checked" : "") @(isLimitedEdit ? "disabled" : "") />
                                    <div class="sa-radio-title">📋 POLL</div>
                                    <div class="sa-radio-desc">Khảo sát, không chấm điểm</div>
                                </label>
                                <label class="sa-radio-card @(Model.SURVEY_TYPE == "QUIZ" ? "active" : "") @(isLimitedEdit ? "disabled" : "")">
                                    <input type="radio" name="SURVEY_TYPE" value="QUIZ" @(Model.SURVEY_TYPE == "QUIZ" ? "checked" : "") @(isLimitedEdit ? "disabled" : "") />
                                    <div class="sa-radio-title">🎯 QUIZ</div>
                                    <div class="sa-radio-desc">Trắc nghiệm có điểm</div>
                                </label>
                            </div>
                            @if (isLimitedEdit)
                            {
                                <div class="form-text text-warning">Không đổi được Loại khi survey đang chạy.</div>
                            }
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="sa-label">Ngôn ngữ <span class="text-danger">*</span>
                                <span class="sa-hint">— quyết định đối tượng nhận survey</span>
                            </label>
                            <div class="d-flex gap-2 mt-1">
                                <label class="sa-radio-card @(Model.LANG == "VI" ? "active" : "") @(isNew ? "" : "disabled")">
                                    <input type="radio" name="LANG" value="VI" @(Model.LANG == "VI" ? "checked" : "") @(isNew ? "" : "disabled") />
                                    <div class="sa-radio-title">🇻🇳 Tiếng Việt</div>
                                    <div class="sa-radio-desc">Nhân viên VN</div>
                                </label>
                                <label class="sa-radio-card @(Model.LANG == "EN" ? "active" : "") @(isNew ? "" : "disabled")">
                                    <input type="radio" name="LANG" value="EN" @(Model.LANG == "EN" ? "checked" : "") @(isNew ? "" : "disabled") />
                                    <div class="sa-radio-title">🌐 English</div>
                                    <div class="sa-radio-desc">Chỉ Expat</div>
                                </label>
                            </div>
                            <div class="form-text">
                                <i class="bi bi-info-circle me-1"></i>
                                Chọn <b>VI</b> → chỉ NV Việt Nam thấy. Chọn <b>EN</b> → chỉ Expat thấy.
                            </div>
                            @if (!isNew)
                            {
                                <div class="form-text text-warning">Không đổi được LANG sau khi tạo.</div>
                            }
                        </div>

                        <div class="col-12">
                            <label class="sa-label">Tiêu đề <span class="text-danger">*</span>
                                <span class="sa-hint">— tối đa 150 ký tự, hiển thị trên đầu bài survey</span>
                            </label>
                            <input type="text" id="fTitle" class="form-control" maxlength="150"
                                   value="@Model.TITLE" placeholder="VD: Khảo sát mức độ hài lòng Quý 1..." />
                            <div class="form-text"><span id="fTitleCounter">0</span>/150 ký tự</div>
                        </div>

                        <div class="col-12">
                            <label class="sa-label">Mô tả
                                <span class="sa-hint">— nội dung ngắn giới thiệu ở landing page trước khi user làm bài</span>
                            </label>
                            <textarea id="fDescription" class="form-control" rows="3" maxlength="500"
                                      placeholder="VD: Mời anh/chị tham gia khảo sát để đánh giá điều kiện làm việc.">@Model.DESCRIPTION</textarea>
                        </div>
                    </div>
                </div>

                <!-- ── Step 2 ──────────────────────── -->
                <div class="sa-panel d-none" data-panel="2">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="sa-panel-title mb-0">Danh sách câu hỏi</h6>
                        <div class="sa-quiz-info d-none">
                            Tổng điểm: <span id="totalPoints">0</span>
                        </div>
                    </div>

                    @if (isLimitedEdit)
                    {
                        <div class="alert alert-secondary py-2 small mb-2">
                            <i class="bi bi-lock-fill me-1"></i>Câu hỏi đã khoá, chỉ xem — không thể sửa khi survey đang chạy.
                        </div>
                    }
                    <div id="questionList" style="@(isLimitedEdit ? "pointer-events:none;opacity:.65;" : "")"></div>
                    <button type="button" class="btn btn-outline-primary btn-sm w-100 mt-2 @(isLimitedEdit ? "d-none" : "")" id="btnAddQuestion">
                        <i class="bi bi-plus-lg"></i> Thêm câu hỏi
                    </button>
                </div>

                <!-- ── Step 3 ──────────────────────── -->
                <div class="sa-panel d-none" data-panel="3">
                    <h6 class="sa-panel-title">Phạm vi người nhận</h6>
                    <div class="row g-2">
                        @foreach (var (val, name, desc) in new[] {
                            ("ALL", "Toàn công ty", "Gửi cho tất cả nhân viên active"),
                            ("DEPT_LINE_WORK", "Theo Dept/Line/Work", "Chọn phòng ban, ca, tổ"),
                            ("EMPCD_LIST", "Danh sách EmpCD", "Paste hoặc nhập từng mã thẻ"),
                            ("MIXED", "Kết hợp", "Union scope + EmpCD list"),
                        })
                        {
                            <div class="col-12 col-md-6 col-lg-3">
                                <label class="sa-radio-card w-100 @(Model.RECIPIENT_MODE == val ? "active" : "")">
                                    <input type="radio" name="RECIPIENT_MODE" value="@val" @(Model.RECIPIENT_MODE == val ? "checked" : "") />
                                    <div class="sa-radio-title">@name</div>
                                    <div class="sa-radio-desc">@desc</div>
                                </label>
                            </div>
                        }
                    </div>

                    <!-- Dept/Line/Work builder -->
                    <div id="scopeDLW" class="sa-scope-block mt-3 d-none">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="fw-semibold">Danh sách scope Dept/Line/Work</div>
                            <button type="button" class="btn btn-sm btn-outline-primary" id="btnAddScopeDLW">
                                <i class="bi bi-plus-lg"></i> Thêm dòng
                            </button>
                        </div>
                        <div class="alert alert-info py-2 small mb-2">
                            <i class="bi bi-info-circle me-1"></i>
                            <b>Mẹo:</b> chọn Dept và để Line / Work ở giá trị mặc định "Tất cả..." → survey gửi cho <b>toàn bộ Dept</b>.
                            Muốn giới hạn thì chọn Line/Work cụ thể.
                        </div>
                        <div id="scopeDLWList"></div>
                        <div id="scopeTotalCount" class="text-end text-muted small mt-1 fw-semibold"></div>
                    </div>

                    <!-- EMPCD list -->
                    <div id="scopeEMPCD" class="sa-scope-block mt-3 d-none">
                        <label class="sa-label">Danh sách mã thẻ (mỗi mã 1 dòng hoặc phân cách bằng dấu phẩy)</label>
                        <textarea id="fEmpcdList" class="form-control" rows="6"
                                  placeholder="12345678&#10;23456789,34567890"></textarea>
                    </div>
                </div>

                <!-- ── Step 4 ──────────────────────── -->
                <div class="sa-panel d-none" data-panel="4">
                    <h6 class="sa-panel-title">Thời gian và điểm đậu</h6>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="sa-label">Ngày bắt đầu <span class="text-danger">*</span></label>
                            <input type="date" id="fStartDate" class="form-control"
                                   value="@Model.START_DATE?.ToString("yyyy-MM-dd")" @(isLimitedEdit ? "disabled" : "") />
                            <div class="form-text">
                                @(isLimitedEdit ? "Không đổi được ngày bắt đầu khi survey đang chạy." : "Active từ 00:00 ngày bắt đầu.")
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="sa-label">Ngày kết thúc <span class="text-danger">*</span></label>
                            <input type="date" id="fEndDate" class="form-control"
                                   value="@Model.END_DATE?.ToString("yyyy-MM-dd")" />
                            <div class="form-text">Tới 23:59 ngày kết thúc.</div>
                        </div>
                        <div class="col-12 col-md-6" id="passScoreWrap" style="display:none">
                            <label class="sa-label">
                                <i class="bi bi-trophy-fill text-warning me-1"></i>
                                Điểm đậu — số điểm tối thiểu để user PASS <span class="text-danger">*</span>
                            </label>
                            <input type="number" id="fPassScore" class="form-control" min="0" step="0.5"
                                   value="@Model.PASS_SCORE" placeholder="Nhập số điểm để đậu, VD: 70" @(isLimitedEdit ? "disabled" : "") />
                            <div class="form-text">
                                @if (isLimitedEdit)
                                {
                                    <text>Không đổi được điểm đậu khi survey đang chạy.</text>
                                }
                                else
                                {
                                    <text>So sánh với tổng điểm các câu hỏi. Tổng hiện tại: <b><span id="passScoreHintTotal">0</span></b> điểm.</text>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Footer nav wizard -->
                <div class="sa-wizard-footer mt-4">
                    <button type="button" class="btn btn-outline-secondary" id="btnPrev" disabled>
                        <i class="bi bi-chevron-left"></i> Trước
                    </button>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-primary" id="btnSaveDraft">
                            <i class="bi bi-save"></i> @(isLimitedEdit ? "Lưu thay đổi" : "Lưu nháp")
                        </button>
                        <button type="button" class="btn btn-primary d-none" id="btnPublish">
                            <i class="bi bi-upload"></i> Publish
                        </button>
                        <button type="button" class="btn btn-primary" id="btnNext">
                            Tiếp <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Template row Dept/Line/Work (dùng bởi JS clone) -->
<template id="tmplScopeDLW">
    <div class="sa-dlw-row d-flex gap-2 mb-2 align-items-center">
        <select class="form-control form-control-sm dlw-dept" style="min-width:160px;"></select>
        <select class="form-control form-control-sm dlw-line" style="min-width:140px;"></select>
        <select class="form-control form-control-sm dlw-work" style="min-width:140px;"></select>
        <span class="dlw-count badge bg-secondary" style="white-space:nowrap;min-width:64px;font-size:.75rem;"></span>
        <button type="button" class="btn btn-sm btn-outline-danger btn-del-dlw"><i class="bi bi-x"></i></button>
    </div>
</template>

<!-- Publish progress modal -->
<div id="pubProgressModal" class="sa-pub-modal">
    <div class="sa-pub-card">
        <div class="sa-pub-title">
            <i class="bi bi-cloud-upload-fill me-2"></i> Đang publish survey
        </div>
        <div id="pubPhase" class="sa-pub-phase">Đang publish survey...</div>
        <div class="sa-pub-bar-wrap">
            <div id="pubBar" class="sa-pub-bar"></div>
        </div>
        <div id="pubCounter" class="sa-pub-counter"></div>
        <div class="sa-pub-hint">Vui lòng không đóng trang. Với danh sách lớn có thể mất vài giây.</div>
    </div>
</div>

<form id="antiForgeryForm">@Html.AntiForgeryToken()</form>

@section Scripts {
    <script>
        window.SURVEY_EDIT = {
            id:            @(Model.ID),
            isNew:         @(isNew.ToString().ToLower()),
            isLimitedEdit: @(isLimitedEdit.ToString().ToLower()),
            initial: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model)),
            urls: {
                getDept:       '@Url.Action("GetDept",   "Dropdown")',
                getLine:       '@Url.Action("GetLine",   "Dropdown")',
                getWork:       '@Url.Action("GetWork",   "Dropdown")',
                scopeCount:    '@Url.Action("ScopeCount", "SurveyAdmin")',
                save:          '@Url.Action("Save", "SurveyAdmin")',
                changeStatus:  '@Url.Action("ChangeStatus", "SurveyAdmin")',
                publishStream: '@Url.Action("PublishStream", "SurveyAdmin")',
                editBase:      '@Url.Action("Edit", "SurveyAdmin")',
                index:         '@Url.Action("Index", "SurveyAdmin")',
            }
        };
    </script>
    <script src="~/assets/js/survey-admin.js" asp-append-version="true"></script>
    <script>
        // Title char counter
        (function () {
            const $t = document.getElementById('fTitle');
            const $c = document.getElementById('fTitleCounter');
            if (!$t || !$c) return;
            const upd = () => { $c.textContent = $t.value.length; };
            $t.addEventListener('input', upd);
            upd();
        })();
    </script>
}
