@model List<HR_web.Models.Survey.SurveyModel>
@{
    ViewData["Title"] = "Quản lý Survey";
    var fStatus = ViewBag.FilterStatus as string;
    var fType   = ViewBag.FilterType   as string;
    var fSearch = ViewBag.FilterSearch as string;
}

@section Styles {
    <link href="~/assets/css/survey-admin.css" rel="stylesheet" asp-append-version="true" />
}

<div class="container-fluid py-4">
    <div class="card my-4">
        <div class="card-header sa-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span class="sa-title">
                <i class="bi bi-clipboard2-check-fill me-2"></i> Quản lý Survey
            </span>
            <div class="d-flex gap-2">
                <a href="@Url.Action("Index", "SurveyExempt")" class="btn btn-outline-secondary" title="Nhân viên không cần làm survey (mù chữ, không có smartphone…)">
                    <i class="bi bi-person-x me-1"></i> DS miễn làm survey
                </a>
                <a href="@Url.Action("Edit", "SurveyAdmin")" class="btn btn-primary">
                    <i class="bi bi-plus-lg me-1"></i> Tạo mới
                </a>
            </div>
        </div>

        <div class="card-body px-0 pt-0 pb-2 mt-1">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible mx-4 mt-3" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible mx-4 mt-3" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Filter bar (auto-submit khi thay đổi) -->
            <form method="get" id="filterForm" class="row g-2 sa-filter mb-3 mx-4 mt-3">
                <div class="col-6 col-md-3">
                    <select name="status" class="form-select form-select-sm sa-auto">
                        <option value="">--- Tất cả trạng thái ---</option>
                        @foreach (var s in new[] { "DRAFT", "SCHEDULED", "ACTIVE", "PAUSED", "EXPIRED", "CANCELLED" })
                        {
                            <option value="@s" selected="@(fStatus == s)">@s</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-3">
                    <select name="type" class="form-select form-select-sm sa-auto">
                        <option value="">--- Tất cả loại ---</option>
                        <option value="POLL" selected="@(fType == "POLL")">POLL — Khảo sát</option>
                        <option value="QUIZ" selected="@(fType == "QUIZ")">QUIZ — Trắc nghiệm</option>
                    </select>
                </div>
                <div class="col-12 col-md-5">
                    <input type="text" name="search" id="fSearch" value="@fSearch" placeholder="Tìm theo tiêu đề..."
                           class="form-control form-control-sm" />
                </div>
                <div class="col-12 col-md-1 d-flex">
                    <a href="@Url.Action("Index")" class="btn btn-sm btn-outline-secondary w-100" title="Xoá lọc">
                        <i class="bi bi-x-lg"></i>
                    </a>
                </div>
            </form>

            <!-- Table -->
            <div class="table-responsive p-0 px-4">
                <table class="table table-hover sa-table align-middle mb-0 w-100">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Tiêu đề</th>
                            <th>Loại</th>
                            <th>Lang</th>
                            <th>Trạng thái</th>
                            <th>Bắt đầu</th>
                            <th>Kết thúc</th>
                            <th>#Nhận</th>
                            <th>#Đã nộp</th>
                            <th style="width: 220px;">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="10">
                                    <div class="sa-empty">
                                        <i class="bi bi-clipboard2-x"></i>
                                        <p class="mb-0">Chưa có survey nào. Nhấn <strong>Tạo mới</strong> để bắt đầu.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var s in Model)
                            {
                                var canEdit    = s.STATUS is "DRAFT" or "SCHEDULED";
                                var canPublish = s.STATUS == "DRAFT";
                                var canPause   = s.STATUS == "ACTIVE";
                                var canResume  = s.STATUS == "PAUSED";
                                var canCancel  = s.STATUS is "SCHEDULED" or "ACTIVE" or "PAUSED";
                                var canDelete  = s.STATUS is "DRAFT" or "EXPIRED" or "CANCELLED";
                                <tr data-id="@s.ID">
                                    <td class="text-secondary small">#@s.ID</td>
                                    <td>
                                        <div class="sa-title-cell" title="@s.TITLE">@s.TITLE</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-@(s.SURVEY_TYPE == "QUIZ" ? "info" : "secondary")">@s.SURVEY_TYPE</span>
                                    </td>
                                    <td>
                                        @if (s.LANG == "EN")
                                        {
                                            <span class="badge bg-warning text-dark" title="Chỉ Expat thấy survey này">🌐 EN — Expat</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border" title="Chỉ NV Việt Nam thấy">🇻🇳 VI</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="sa-status sa-status-@s.STATUS.ToLower()">@s.STATUS</span>
                                    </td>
                                    <td class="small">@(s.START_DATE?.ToString("dd/MM/yyyy") ?? "-")</td>
                                    <td class="small">@(s.END_DATE?.ToString("dd/MM/yyyy")   ?? "-")</td>
                                    <td class="text-center fw-semibold">@s.RECIPIENT_COUNT</td>
                                    <td class="text-center fw-semibold">@s.SUBMITTED_COUNT</td>
                                    <td>
                                        <div class="sa-actions">
                                            @if (canEdit)
                                            {
                                                <a href="@Url.Action("Edit", new { id = s.ID })" class="btn btn-info" title="Sửa"><i class="bi bi-pencil-square"></i><span>Sửa</span></a>
                                            }
                                            <a href="@Url.Action("Preview", new { id = s.ID })" class="btn btn-outline-primary" title="Xem trước"><i class="bi bi-eye"></i><span>Xem</span></a>
                                            <a href="@Url.Action("TestMode", new { id = s.ID })" class="btn btn-outline-secondary" title="Làm thử"><i class="bi bi-play-circle"></i><span>Thử</span></a>
                                            <a href="@Url.Action("Report", new { id = s.ID })" class="btn btn-outline-info" title="Báo cáo"><i class="bi bi-bar-chart"></i><span>Báo cáo</span></a>
                                            @if (canPublish)
                                            {
                                                <button type="button" class="btn btn-success sa-action" data-action="publish" title="Publish"><i class="bi bi-cloud-upload-fill"></i><span>Publish</span></button>
                                            }
                                            @if (canPause)
                                            {
                                                <button type="button" class="btn btn-warning sa-action" data-action="pause" title="Tạm dừng"><i class="bi bi-pause-fill"></i><span>Tạm dừng</span></button>
                                            }
                                            @if (canResume)
                                            {
                                                <button type="button" class="btn btn-success sa-action" data-action="resume" title="Tiếp tục"><i class="bi bi-play-fill"></i><span>Tiếp tục</span></button>
                                            }
                                            @if (canCancel)
                                            {
                                                <button type="button" class="btn btn-outline-warning sa-action" data-action="cancel" title="Huỷ"><i class="bi bi-x-circle"></i><span>Huỷ</span></button>
                                            }
                                            @if (canDelete)
                                            {
                                                <button type="button" class="btn btn-outline-danger sa-action" data-action="delete" title="Xoá"><i class="bi bi-trash"></i><span>Xoá</span></button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<form id="antiForgeryForm">@Html.AntiForgeryToken()</form>

@section Scripts {
<script>
(function () {
    const TOKEN = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]')?.value ?? '';

    // Auto-submit filter khi select thay đổi hoặc gõ search (debounce)
    document.querySelectorAll('#filterForm .sa-auto').forEach(el => {
        el.addEventListener('change', () => document.getElementById('filterForm').submit());
    });
    let searchTimer;
    document.getElementById('fSearch')?.addEventListener('input', () => {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => document.getElementById('filterForm').submit(), 450);
    });

    const map = {
        publish: { status: 'SCHEDULED', title: 'Publish survey', msg: 'Publish survey này?', ok: 'Publish',   okClass: 'btn-primary', icon: 'cloud_upload',    iconColor: '#4f46e5', iconBg: '#e0e7ff' },
        pause:   { status: 'PAUSED',    title: 'Tạm dừng',       msg: 'Tạm dừng survey này?', ok: 'Tạm dừng', okClass: 'btn-warning', icon: 'pause_circle',    iconColor: '#d97706', iconBg: '#fef3c7' },
        resume:  { status: 'ACTIVE',    title: 'Tiếp tục',       msg: 'Tiếp tục survey?',      ok: 'Tiếp tục', okClass: 'btn-success', icon: 'play_circle',     iconColor: '#16a34a', iconBg: '#dcfce7' },
        cancel:  { status: 'CANCELLED', title: 'Huỷ survey',     msg: 'Huỷ survey này? Không thể hoàn tác.', ok: 'Huỷ', okClass: 'btn-danger', icon: 'cancel', iconColor: '#dc2626', iconBg: '#fee2e2' },
        'delete':{ status: 'DELETED',   title: 'Xoá survey',     msg: 'Xoá survey này?',       ok: 'Xoá',      okClass: 'btn-danger',  icon: 'delete',          iconColor: '#dc2626', iconBg: '#fee2e2' },
    };

    document.querySelectorAll('.sa-action').forEach(btn => {
        btn.addEventListener('click', () => {
            const tr = btn.closest('tr');
            const id = parseInt(tr.dataset.id, 10);
            const cfg = map[btn.dataset.action];
            if (!cfg) return;
            const doIt = async () => {
                btn.disabled = true;
                try {
                    const res = await fetch('/SurveyAdmin/ChangeStatus', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN },
                        body: JSON.stringify({ Id: id, NewStatus: cfg.status }),
                    });
                    const r = await res.json();
                    if (r.success) {
                        if (window.showToast) window.showToast(cfg.title + ' thành công', 'success');
                        setTimeout(() => location.reload(), 500);
                    } else {
                        (window.showToast || alert)(r.message || 'Không thực hiện được', 'error');
                        btn.disabled = false;
                    }
                } catch (e) {
                    (window.showToast || alert)('Lỗi kết nối', 'error');
                    btn.disabled = false;
                }
            };
            if (window.showConfirm) {
                window.showConfirm(cfg.msg, doIt, {
                    title: cfg.title, okText: cfg.ok, okClass: cfg.okClass,
                    icon: cfg.icon, iconColor: cfg.iconColor, iconBg: cfg.iconBg
                });
            } else if (confirm(cfg.msg)) { doIt(); }
        });
    });
})();
</script>
}
