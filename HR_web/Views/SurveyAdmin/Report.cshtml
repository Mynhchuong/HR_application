@model HR_web.Models.Survey.SurveyReportViewModel
@{
    var o = Model.Overview!;
    ViewData["Title"] = "Report: " + o.TITLE;
    var isQuiz = o.SURVEY_TYPE == "QUIZ";
    var quiz   = Model.Quiz;
    var total  = Math.Max(o.TOTAL_RECIPIENTS, 1);

    string Pct(int part) => Math.Round(part * 100.0 / total, 1) + "%";
}

@section Styles {
    <link href="~/assets/css/survey-admin.css" rel="stylesheet" asp-append-version="true" />
}

<div class="container-fluid py-3">
    <div class="card">
        <div class="card-header sa-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span class="fw-bold">
                <i class="bi bi-bar-chart-fill me-2"></i>
                Report — @o.TITLE
            </span>
            <div class="d-flex gap-2">
                <a href="@Url.Action("Participants", new { id = o.SURVEY_ID })" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-people me-1"></i> Danh sách NV
                </a>
                <a href="@Url.Action("ReportExport", new { id = o.SURVEY_ID })"
                   class="btn btn-sm btn-success sa-export-btn" download
                   title="Xuất báo cáo Excel — gồm Overview + Quiz (nếu là quiz)">
                    <i class="bi bi-file-earmark-excel-fill me-1"></i> Xuất Excel
                </a>
                <a href="@Url.Action("Index")" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Quay lại
                </a>
            </div>
        </div>

        <div class="card-body p-3">
            <!-- Summary boxes -->
            <div class="row g-3 mb-3">
                <div class="col-6 col-md-2">
                    <div class="sa-stat">
                        <div class="sa-stat-value">@o.TOTAL_RECIPIENTS</div>
                        <div class="sa-stat-label">Người nhận</div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="sa-stat sa-stat-success">
                        <div class="sa-stat-value">@o.SUBMITTED_COUNT</div>
                        <div class="sa-stat-label">Đã nộp (@Pct(o.SUBMITTED_COUNT))</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="sa-stat sa-stat-info">
                        <div class="sa-stat-value">@o.IN_PROGRESS_COUNT</div>
                        <div class="sa-stat-label">Đang làm (@Pct(o.IN_PROGRESS_COUNT))</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="sa-stat">
                        <div class="sa-stat-value">@o.NOT_STARTED_COUNT</div>
                        <div class="sa-stat-label">Chưa làm (@Pct(o.NOT_STARTED_COUNT))</div>
                    </div>
                </div>
            </div>

            @* Quiz summary *@
            @if (isQuiz && quiz != null)
            {
                <div class="card mb-3">
                    <div class="card-header sa-header fw-bold">
                        <i class="bi bi-trophy me-2"></i>Quiz result
                    </div>
                    <div class="card-body">
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <div class="sa-stat sa-stat-info">
                                    <div class="sa-stat-value">@quiz.AVG_SCORE</div>
                                    <div class="sa-stat-label">Điểm trung bình</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="sa-stat sa-stat-success">
                                    <div class="sa-stat-value">@quiz.PASS_COUNT</div>
                                    <div class="sa-stat-label">Pass</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="sa-stat sa-stat-danger">
                                    <div class="sa-stat-value">@quiz.FAIL_COUNT</div>
                                    <div class="sa-stat-label">Fail</div>
                                </div>
                            </div>
                        </div>

                        <div class="table-responsive sa-report-scroll">
                            <table class="table table-sm sa-table sa-report-table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>EmpCd</th>
                                        <th>Họ và tên</th>
                                        <th>Dept</th>
                                        <th>Line</th>
                                        <th>Work</th>
                                        <th class="text-center">Điểm</th>
                                        <th class="text-center">Kết quả</th>
                                        <th>Nộp lúc</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var u in quiz.USERS)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@u.EMPCD</td>
                                            <td class="sa-name-cell vni-font">@u.FULL_NAME</td>
                                            <td class="small">@u.DEPTCD</td>
                                            <td class="small">@u.LINECD</td>
                                            <td class="small">@u.WORKCD</td>
                                            <td class="text-center fw-semibold">@u.SCORE / @u.MAX_SCORE</td>
                                            <td class="text-center">
                                                @if (u.IS_PASS == 1)
                                                {
                                                    <span class="sv-result-badge pass">PASS</span>
                                                }
                                                else if (u.IS_PASS == 0)
                                                {
                                                    <span class="sv-result-badge fail">FAIL</span>
                                                }
                                            </td>
                                            <td class="small text-muted">@(u.SUBMIT_DT?.ToString("dd/MM HH:mm") ?? "")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            <!-- ── Chart tổng quan ── -->
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header py-2 fw-semibold">
                            <i class="bi bi-pie-chart-fill me-2 text-primary"></i>Phân bố trạng thái nộp
                        </div>
                        <div class="card-body">
                            <canvas id="chartStatus" height="200"></canvas>
                        </div>
                    </div>
                </div>
                @if (isQuiz && quiz != null)
                {
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header py-2 fw-semibold">
                                <i class="bi bi-bar-chart-fill me-2 text-success"></i>Kết quả Pass / Fail
                            </div>
                            <div class="card-body">
                                <canvas id="chartPassFail" height="200"></canvas>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Per-question -->
            <h5 class="mt-4 mb-3"><i class="bi bi-list-check me-2"></i>Chi tiết theo câu hỏi</h5>
            @foreach (var q in o.QUESTIONS)
            {
                <div class="card mb-3 sa-question-report">
                    <div class="card-body">
                        <div class="fw-semibold mb-2">
                            <span class="sa-question-num">@q.DISPLAY_ORDER</span>
                            @q.QUESTION_TEXT
                            <span class="badge bg-secondary ms-1">@q.QUESTION_TYPE</span>
                            @if (isQuiz && q.POINTS > 0)
                            {
                                <span class="badge bg-info">@q.POINTS đ</span>
                            }
                        </div>

                        @if (q.OPTIONS != null && q.OPTIONS.Any())
                        {
                            var maxCnt = q.OPTIONS.Max(o => o.COUNT);
                            <div class="sa-answer-bars">
                                @foreach (var op in q.OPTIONS)
                                {
                                    var pct = maxCnt > 0 ? (op.COUNT * 100 / Math.Max(maxCnt, 1)) : 0;
                                    <div class="sa-answer-bar-row">
                                        <div class="sa-answer-bar-label">@op.OPTION_TEXT</div>
                                        <div class="sa-answer-bar-wrap">
                                            <div class="sa-answer-bar" style="width: @(pct)%"></div>
                                        </div>
                                        <div class="sa-answer-bar-value">@op.COUNT</div>
                                        @if (op.COUNT > 0)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary sa-opt-detail py-0 px-2 ms-2"
                                                    style="font-size:.72rem;white-space:nowrap;"
                                                    data-opt-id="@op.OPTION_ID"
                                                    data-opt-text="@Html.Raw(System.Text.Json.JsonSerializer.Serialize(op.OPTION_TEXT))">
                                                <i class="bi bi-people me-1"></i>Xem chi tiết
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else if (q.RATING_DIST != null)
                        {
                            var maxDist = q.RATING_DIST.Max();
                            <div class="sa-answer-bars">
                                @for (int i = 0; i < 5; i++)
                                {
                                    var pct = maxDist > 0 ? (q.RATING_DIST[i] * 100 / Math.Max(maxDist, 1)) : 0;
                                    <div class="sa-answer-bar-row">
                                        <div class="sa-answer-bar-label">@(i + 1) ⭐</div>
                                        <div class="sa-answer-bar-wrap">
                                            <div class="sa-answer-bar sa-answer-bar-star" style="width: @(pct)%"></div>
                                        </div>
                                        <div class="sa-answer-bar-value">@q.RATING_DIST[i]</div>
                                    </div>
                                }
                            </div>
                        }
                        else if (q.QUESTION_TYPE == "TEXT")
                        {
                            <div class="text-muted small mb-2">
                                @q.TEXT_COUNT câu trả lời.
                                <button type="button" class="btn btn-sm btn-outline-secondary sa-load-text" data-qid="@q.QUESTION_ID">
                                    <i class="bi bi-eye"></i> Xem chi tiết
                                </button>
                            </div>
                            <div class="sa-text-answers d-none" data-qid="@q.QUESTION_ID"></div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal: danh sách NV chọn đáp án -->
<div class="modal fade" id="optRespondentsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header py-2" style="background:#1e3a5f;">
                <div class="d-flex flex-column">
                    <h6 class="modal-title text-white mb-0">Ai đã chọn đáp án này?</h6>
                    <small class="text-white-50" id="optModalTitle" style="font-size:.75rem;"></small>
                </div>
                <div class="d-flex gap-2 ms-3">
                    <a id="optModalExport" href="#" class="btn btn-sm btn-success py-0 px-2" download style="font-size:.75rem;">
                        <i class="bi bi-file-earmark-excel me-1"></i>Excel
                    </a>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
            </div>
            <div class="modal-body p-0" id="optModalBody" style="max-height:65vh;overflow-y:auto;">
                <div class="text-center py-4"><div class="spinner-border spinner-border-sm text-primary"></div></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
// ── Chart trạng thái nộp ──
(function () {
    const el = document.getElementById('chartStatus');
    if (!el || typeof Chart === 'undefined') return;
    new Chart(el, {
        type: 'doughnut',
        data: {
            labels: ['Đã nộp', 'Đang làm', 'Chưa làm'],
            datasets: [{
                data: [@o.SUBMITTED_COUNT, @o.IN_PROGRESS_COUNT, @o.NOT_STARTED_COUNT],
                backgroundColor: ['#16a34a', '#3b82f6', '#94a3b8'],
                borderWidth: 2, borderColor: '#fff'
            }]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { position: 'bottom', labels: { font: { size: 11 } } } }
        }
    });
})();

@if (isQuiz && quiz != null)
{
    <text>
    (function () {
        const el = document.getElementById('chartPassFail');
        if (!el || typeof Chart === 'undefined') return;
        new Chart(el, {
            type: 'bar',
            data: {
                labels: ['Pass', 'Fail'],
                datasets: [{
                    label: 'Số lượng',
                    data: [@quiz.PASS_COUNT, @quiz.FAIL_COUNT],
                    backgroundColor: ['#16a34a', '#dc2626'],
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
            }
        });
    })();
    </text>
}

// ── Option respondents modal ──
const RESP_URL   = '@Url.Action("ReportOptionRespondents", "SurveyAdmin")';
const EXPORT_URL = '@Url.Action("ReportOptionExport", "SurveyAdmin")';
let optModal;

document.querySelectorAll('.sa-opt-detail').forEach(btn => {
    btn.addEventListener('click', async () => {
        const optId   = btn.dataset.optId;
        const optText = JSON.parse(btn.dataset.optText);

        if (!optModal) optModal = new bootstrap.Modal(document.getElementById('optRespondentsModal'));
        document.getElementById('optModalTitle').textContent = optText;
        document.getElementById('optModalBody').innerHTML =
            '<div class="text-center py-4"><div class="spinner-border spinner-border-sm text-primary"></div></div>';
        document.getElementById('optModalExport').href =
            EXPORT_URL + '?optId=' + optId + '&optionText=' + encodeURIComponent(optText);
        optModal.show();

        try {
            const res = await fetch(RESP_URL + '?optId=' + optId);
            const j   = await res.json();
            if (!j.success) { document.getElementById('optModalBody').innerHTML = '<div class="text-danger p-3">Lỗi tải</div>'; return; }
            const data = j.data;
            if (!data.length) {
                document.getElementById('optModalBody').innerHTML = '<div class="text-muted text-center py-4">Không có dữ liệu</div>';
                return;
            }
            let html = `<table class="table table-sm table-hover mb-0" style="font-size:.8rem;">
                <thead style="position:sticky;top:0;background:#f8fafc;">
                    <tr>
                        <th style="font-size:.72rem;color:#64748b;padding:5px 8px;">#</th>
                        <th style="font-size:.72rem;color:#64748b;padding:5px 8px;">Mã NV</th>
                        <th style="font-size:.72rem;color:#64748b;padding:5px 8px;">Họ tên</th>
                        <th style="font-size:.72rem;color:#64748b;padding:5px 8px;">Phòng / Chuyền / Tổ</th>
                        <th style="font-size:.72rem;color:#64748b;padding:5px 8px;">Nộp lúc</th>
                    </tr>
                </thead><tbody>`;
            data.forEach((r, i) => {
                const loc = [r.DEPTCD, r.LINECD, r.WORKCD].filter(Boolean).join(' / ');
                const dt  = r.SUBMIT_DT ? new Date(r.SUBMIT_DT).toLocaleString('vi-VN', {dateStyle:'short',timeStyle:'short'}) : '—';
                html += `<tr>
                    <td style="padding:4px 8px;color:#94a3b8;">${i+1}</td>
                    <td style="padding:4px 8px;font-family:monospace;font-size:.75rem;font-weight:600;">${esc(r.EMPCD)}</td>
                    <td style="padding:4px 8px;" class="vni-font">${esc(r.FULL_NAME||'')}</td>
                    <td style="padding:4px 8px;font-size:.72rem;color:#64748b;">${esc(loc)}</td>
                    <td style="padding:4px 8px;font-size:.75rem;color:#64748b;white-space:nowrap;">${dt}</td>
                </tr>`;
            });
            html += '</tbody></table>';
            document.getElementById('optModalBody').innerHTML = html;
        } catch(e) {
            document.getElementById('optModalBody').innerHTML = '<div class="text-danger p-3">Lỗi kết nối</div>';
        }
    });
});

function esc(s) { return String(s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

document.querySelectorAll('.sa-load-text').forEach(btn => {
    btn.addEventListener('click', async () => {
        const qid  = btn.dataset.qid;
        const $box = document.querySelector('.sa-text-answers[data-qid="' + qid + '"]');
        btn.disabled = true;
        try {
            const res  = await fetch('@Url.Action("ReportTextAnswers", "SurveyAdmin")?qid=' + qid + '&page=1');
            const j    = await res.json();
            if (!j.success) { alert(j.message || 'Lỗi tải'); return; }
            $box.classList.remove('d-none');
            $box.innerHTML = j.data.length === 0
                ? '<div class="text-muted small">Chưa có câu trả lời</div>'
                : j.data.map(a => `
                    <div class="sa-text-answer">
                        <div class="sa-text-answer-meta">
                            <b>${a.EMPCD}</b> ${a.FULL_NAME ? '— <span class="vni-font">' + a.FULL_NAME + '</span>' : ''}
                            ${a.INST_DT ? '<span class="text-muted small ms-2">' + new Date(a.INST_DT).toLocaleString('vi-VN') + '</span>' : ''}
                        </div>
                        <div class="sa-text-answer-body">${(a.ANSWER_TEXT || '').replace(/</g, '&lt;')}</div>
                    </div>`).join('');
        } catch (e) { alert('Lỗi kết nối'); }
        finally { btn.disabled = false; }
    });
});
</script>
}
