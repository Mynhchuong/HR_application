@{
    Layout = "_Layout";
    ViewData["Title"] = "Quét máy";
}

@section Styles {
<style>
    .tpm-wrap { max-width: 640px; margin: 0 auto; padding-bottom: 4rem; }
    .tpm-card { background:#fff; border:1px solid #e2e8f0; border-radius:16px; padding:1rem; margin-bottom:.8rem; }
    .tpm-hero { background:linear-gradient(135deg,#8b0000,#c00000); color:#fff; border:0; }
    .tpm-hero h5 { margin:0; font-weight:800; }
    .tpm-hero small { opacity:.9; }
    .tpm-btn { border:0; border-radius:12px; padding:.65rem 1rem; font-weight:700; font-size:.92rem; cursor:pointer; width:100%; text-align:center; text-decoration:none; display:block; }
    .tpm-btn.primary { background:#c00000; color:#fff; }
    .tpm-btn.light { background:#f1f5f9; color:#0f172a; border:1.5px solid #e2e8f0; }
    .tpm-btn:disabled { opacity:.55; cursor:not-allowed; }
    .tpm-row { display:flex; gap:.5rem; }
    .tpm-row > * { flex:1; }
    .tpm-input { width:100%; border:1.5px solid #e2e8f0; border-radius:12px; padding:.55rem .75rem; font-size:.92rem; outline:none; background:#fff; }
    .tpm-input:focus { border-color:#c00000; }
    .tpm-msg { font-size:.85rem; margin-top:.5rem; color:#475569; }
    .tpm-msg.err { color:#b91c1c; }
    .tpm-code { font-size:1.15rem; font-weight:800; color:#0f172a; }
    .tpm-name { color:#475569; font-size:.9rem; }
    .tpm-kv { display:flex; justify-content:space-between; gap:1rem; padding:.4rem 0; border-bottom:1px dashed #e2e8f0; font-size:.88rem; }
    .tpm-kv:last-child { border-bottom:0; }
    .tpm-kv span:first-child { color:#64748b; flex:0 0 auto; }
    .tpm-kv span:last-child { text-align:right; font-weight:600; overflow-wrap:anywhere; }
    .tpm-badge { display:inline-block; padding:.15rem .6rem; border-radius:999px; font-size:.75rem; font-weight:700; white-space:nowrap; }
    .tpm-notice { background:#fff7ed; border:1px solid #fed7aa; color:#9a3412; border-radius:12px; padding:.6rem .8rem; font-size:.88rem; }
    .tpm-desc { background:#f8fafc; border-radius:10px; padding:.5rem .7rem; font-size:.88rem; margin:.5rem 0; white-space:pre-wrap; overflow-wrap:anywhere; }
</style>
}

<div class="container-fluid py-4">
<div class="tpm-wrap">
    @Html.AntiForgeryToken()

    <div class="tpm-card tpm-hero">
        <h5>Quét máy</h5>
        <small>Quét hoặc nhập mã máy để xem thông tin và xử lý báo hư.</small>
    </div>

    <div class="tpm-card">
        <div class="tpm-row">
            <input type="text" class="tpm-input" id="mCode" placeholder="Mã máy (VD: MC26-00001)" autocomplete="off" autocapitalize="characters">
            <button type="button" class="tpm-btn light" id="mScan" style="flex:0 0 auto;width:auto">Quét</button>
            <button type="button" class="tpm-btn primary" id="mFind" style="flex:0 0 auto;width:auto">Tra cứu</button>
        </div>
        <div class="tpm-msg" id="msg"></div>
    </div>

    <div id="result"></div>
</div>
</div>

@section Scripts {
<script src="~/js/native-scanner.js" asp-append-version="true"></script>
<script src="~/js/tpm-maint.js" asp-append-version="true"></script>
<script>
(function () {
    const TM = window.TpmMaint, esc = TM.esc, toast = TM.toast;
    const URL_MACH = '@Url.Action("Machine", "Tpm")';
    const URL_LIST = '@Url.Action("MaintBroken", "Tpm")';
    const URL_XFER = '@Url.Action("Transfer", "Tpm")';
    const $ = id => document.getElementById(id);
    const fmtD = iso => { if (!iso) return ''; const d = new Date(iso); const p = n => String(n).padStart(2,'0'); return `${p(d.getDate())}/${p(d.getMonth()+1)}/${d.getFullYear()}`; };
    const fmtDT = iso => { if (!iso) return ''; const d = new Date(iso); const p = n => String(n).padStart(2,'0'); return `${p(d.getDate())}/${p(d.getMonth()+1)}/${d.getFullYear()} ${p(d.getHours())}:${p(d.getMinutes())}`; };
    const kv = (k, v) => v ? `<div class="tpm-kv"><span>${k}</span><span>${esc(v)}</span></div>` : '';
    const setMsg = (t, err) => { $('msg').textContent = t || ''; $('msg').className = 'tpm-msg' + (err ? ' err' : ''); };
    let curCode = '';

    TM.init({
        token: document.querySelector('input[name="__RequestVerificationToken"]')?.value || '',
        urls: { recv: '@Url.Action("MaintReceive", "Tpm")', repair: '@Url.Action("MaintRepair", "Tpm")',
                parts: '@Url.Action("MaintNeedsParts", "Tpm")', cancel: '@Url.Action("MaintCancel", "Tpm")' },
        onChanged: () => lookup(curCode)
    });
    TM.bind($('result'));

    async function lookup(raw) {
        const code = String(raw || '').trim().toUpperCase();
        if (!code) { setMsg('Vui lòng nhập mã máy.', true); return; }
        curCode = code; $('mCode').value = code; setMsg('Đang tra cứu ' + code + '...'); $('result').innerHTML = '';
        try {
            const d = await (await fetch(URL_MACH + '?itemCode=' + encodeURIComponent(code))).json();
            if (!d.success) { setMsg(TM.errText(d), true); return; }
            setMsg('');
            const m = d.data;
            // Phiếu đang mở của máy: lấy bản đầy đủ (mô tả, người báo, ghi chú linh kiện) từ danh sách
            let ticket = m.OpenBroken ? Object.assign({}, m.OpenBroken) : null;
            if (ticket) {
                try {
                    const l = await (await fetch(URL_LIST + '?myAreaOnly=false')).json();
                    const full = (l.items || []).find(x => x.BrokenId === ticket.BrokenId);
                    if (full) ticket = full;
                } catch (e) { }
            }
            render(m, ticket);
        } catch (e) { setMsg('Lỗi kết nối, vui lòng thử lại.', true); }
    }

    function render(m, t) {
        let ticketHtml = '';
        if (t) {
            ticketHtml = `<div class="tpm-card">
                <div class="d-flex justify-content-between align-items-center mb-1"><b>Phiếu báo hư đang mở</b>${TM.badge(t.Status)}</div>
                ${t.Description ? `<div class="tpm-desc">${esc(t.Description)}</div>` : ''}
                ${kv('Người báo', t.ReportedByNm)}
                ${kv('Báo lúc', fmtDT(t.ReportedAt))}
                ${kv('Người nhận', t.ReceivedByNm)}
                ${TM.actionsHtml(t, m.ItemCode)}
            </div>`;
        }
        $('result').innerHTML = `<div class="tpm-card">
                <div class="tpm-code">${esc(m.ItemCode)}</div>
                <div class="tpm-name mb-2">${esc(m.NameEn)}</div>
                ${kv('Mã tài sản', m.FaCode)}
                ${kv('Quy cách', m.Specification)}
                ${kv('Vị trí', m.LocationPath || 'Chưa gán vị trí')}
                ${kv('Trạng thái', m.StatusNmVn || m.StatusCd)}
                ${kv('Xuất xứ', m.MadeByNm)}
                ${kv('Nhà cung cấp', m.VendorNm)}
                <a class="tpm-btn light mt-2" href="${URL_XFER}?code=${encodeURIComponent(m.ItemCode)}">Chuyển vị trí máy này</a>
            </div>` + ticketHtml;
        $('result').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    $('mFind').onclick = () => lookup($('mCode').value);
    $('mCode').addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); lookup(e.target.value); } });
    $('mScan').onclick = () => {
        if (!window.NativeScanner || !window.NativeScanner.scan({ onResult: c => lookup(c), onCancel: () => {}, onError: () => toast('Không mở được camera, hãy nhập mã máy.', 'warning') }))
            toast('Thiết bị chưa hỗ trợ quét, hãy nhập mã máy.', 'warning');
    };
    const pre = new URLSearchParams(location.search).get('code'); if (pre) lookup(pre);
})();
</script>
}
