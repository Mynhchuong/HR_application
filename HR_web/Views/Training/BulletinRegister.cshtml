@{
    ViewData["Title"] = "Đăng ký Đào tạo";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var empCd = ViewBag.EmpCd as string;
    var targetClassId = ViewBag.ClassId ?? 0;
}

<div class="container-fluid py-4" style="font-family: 'Outfit', sans-serif;">
    <!-- Breadcrumbs -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("MyClasses", "Training")" class="text-decoration-none">Đào tạo của tôi</a></li>
            <li class="breadcrumb-item active" aria-current="page">Đăng ký lớp học mới</li>
        </ol>
    </nav>

    <!-- Header Banner -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm overflow-hidden" style="border-radius: 20px; background: linear-gradient(135deg, #198754 0%, #157347 100%);">
                <div class="card-body p-4 text-white position-relative">
                    <div class="position-absolute end-0 bottom-0 opacity-10 d-none d-md-block" style="transform: translate(10%, 10%);">
                        <span class="material-symbols-rounded" style="font-size: 15rem;">add_circle</span>
                    </div>
                    <h2 class="fw-bold mb-1">Đăng Ký Lớp Học Mở</h2>
                    <p class="mb-0 opacity-75">Tự do lựa chọn các lớp học phù hợp để nâng cao kỹ năng và tích lũy chứng chỉ đào tạo.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Classes Container -->
    <div class="row" id="open-classes-container">
        <div class="col-12 text-center py-5">
            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Đang tìm kiếm danh sách lớp học mở...</p>
        </div>
    </div>
</div>

<style>
    .class-card {
        border-radius: 16px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid rgba(0,0,0,0.06);
    }
    .class-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08) !important;
    }
    .badge-success-soft {
        background-color: #d1e7dd;
        color: #0f5132;
    }
</style>

@section Scripts {
    <script>
        window.TRAINING_URLS = {
            getClassList: '@Url.Action("GetClassList", "TrainingAdmin")',
            registerClass: '@Url.Action("RegisterClass", "Training")',
            myClasses: '@Url.Action("MyClasses", "Training")'
        };
        const empCd = '@empCd';
        const targetClassId = parseInt('@targetClassId') || 0;

        document.addEventListener('DOMContentLoaded', function () {
            loadOpenClasses();
        });

        function loadOpenClasses() {
            const container = document.getElementById('open-classes-container');
            
            // Gọi API lấy toàn bộ lớp học của TrainingAdmin (SCHEDULED để lọc các lớp sắp khai giảng)
            fetch(`${window.TRAINING_URLS.getClassList}?status=SCHEDULED`)
                .then(r => r.json())
                .then(res => {
                    if (!res.success) {
                        container.innerHTML = `<div class="col-12"><div class="alert alert-warning">${res.message || 'Lỗi tải danh sách lớp học mở.'}</div></div>`;
                        return;
                    }

                    // Lọc những lớp học có REGISTRATION_MODE = 'OPEN'
                    let list = (res.data || []).filter(c => c.REGISTRATION_MODE === 'OPEN');
                    
                    // Nếu có chỉ định targetClassId cụ thể (link từ Bulletin)
                    if (targetClassId > 0) {
                        list = list.filter(c => c.ID === targetClassId);
                    }

                    if (list.length === 0) {
                        container.innerHTML = `
                            <div class="col-12 text-center py-5">
                                <span class="material-symbols-rounded text-muted" style="font-size: 5rem;">add_circle</span>
                                <h5 class="fw-bold mt-3">Không tìm thấy lớp học mở đăng ký phù hợp</h5>
                                <p class="text-muted small">Vui lòng quay lại sau hoặc liên hệ HR để được hỗ trợ gán lớp.</p>
                            </div>
                        `;
                        return;
                    }

                    container.innerHTML = '';
                    list.forEach(item => {
                        const timeText = item.START_DATE ? new Date(item.START_DATE).toLocaleDateString('vi-VN') : 'Chưa định ngày';
                        const deadlineText = item.REGISTRATION_DEADLINE ? new Date(item.REGISTRATION_DEADLINE).toLocaleDateString('vi-VN') : 'Không giới hạn';
                        const maxStudentsText = item.MAX_STUDENTS ? `${item.MAX_STUDENTS} học viên` : 'Không giới hạn';

                        container.innerHTML += `
                            <div class="col-12 col-md-6 col-lg-4 mb-4">
                                <div class="card h-100 border-0 shadow-sm class-card">
                                    <div class="card-body p-4 d-flex flex-column">
                                        <div class="d-flex justify-content-between align-items-start mb-3">
                                            <span class="badge badge-success-soft text-success rounded px-2.5 py-1 fw-bold small">Đăng ký tự do</span>
                                            <span class="small text-muted"><i class="bi bi-calendar-event me-1"></i>Khai giảng: ${timeText}</span>
                                        </div>
                                        <h5 class="fw-bold text-dark text-truncate-2 mb-1">${item.COURSE_TITLE}</h5>
                                        <p class="text-muted small mb-3">Lớp: ${item.CLASS_NAME}</p>
                                        
                                        <div class="mt-auto">
                                            <div class="card bg-light border-0 p-3 mb-3" style="border-radius: 12px;">
                                                <div class="d-flex align-items-center justify-content-between small text-muted mb-1">
                                                    <span>Số buổi học:</span>
                                                    <span class="fw-bold text-dark">${item.SESSION_COUNT || 0} buổi</span>
                                                </div>
                                                <div class="d-flex align-items-center justify-content-between small text-muted mb-1">
                                                    <span>Hạn đăng ký:</span>
                                                    <span class="fw-bold text-danger">${deadlineText}</span>
                                                </div>
                                                <div class="d-flex align-items-center justify-content-between small text-muted">
                                                    <span>Số slot tối đa:</span>
                                                    <span class="fw-bold text-dark">${maxStudentsText}</span>
                                                </div>
                                            </div>

                                            <div class="d-grid">
                                                <button onclick="registerClass(${item.ID}, '${item.CLASS_NAME}')" class="btn btn-success py-2 rounded-3 fw-bold d-flex align-items-center justify-content-center gap-1">
                                                    <span class="material-symbols-rounded" style="font-size: 1.2rem;">person_add</span>
                                                    Đăng ký tham gia
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        `;
                    });
                })
                .catch(err => {
                    container.innerHTML = `<div class="col-12"><div class="alert alert-danger">Lỗi kết nối hệ thống: ${err.message}</div></div>`;
                });
        }

        function registerClass(classId, className) {
            window.showConfirm(`Bạn muốn đăng ký tham gia lớp học "${className}" không?`, () => {
                fetch(`${window.TRAINING_URLS.registerClass}?classId=${classId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ CLASS_ID: classId, EMPCD: empCd })
                })
                .then(r => r.json())
                .then(res => {
                    if (res.success) {
                        window.showToast('Đăng ký lớp học thành công, đang chờ HR phê duyệt!', 'success');
                        setTimeout(() => {
                            window.location.href = window.TRAINING_URLS.myClasses;
                        }, 1500);
                    } else {
                        window.showToast(res.message || 'Không thể đăng ký lớp học.', 'error');
                    }
                })
                .catch(err => {
                    window.showToast('Lỗi kết nối: ' + err.message, 'error');
                });
            }, {
                title: 'Xác nhận Đăng ký',
                okText: 'Đăng ký',
                okClass: 'btn-success',
                icon: 'person_add',
                iconColor: '#198754',
                iconBg: '#e8f5e9'
            });
        }
    </script>
}
