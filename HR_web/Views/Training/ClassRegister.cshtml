@{
    ViewData["Title"] = "Đăng ký lớp học";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var empCd = ViewBag.EmpCd as string;
    var classId = ViewBag.ClassId;
}

<div class="container-fluid py-4">
    <div class="card my-4">
        @await Html.PartialAsync("_TrainingPageHeader", new TrainingPageHeaderVM
        {
            Title = "Đăng ký lớp học",
            Icon = "bi-person-plus",
            Gradient = "primary",
            BackUrl = Url.Action("MyClasses", "Training"),
        })
        <div class="card-body">
            <div class="row">
                <div class="col-12 col-md-8 col-lg-6 mx-auto">
                    <div id="register-card">
                        <div class="text-center py-4">
                            <div class="spinner-border text-success" role="status"></div>
                            <p class="mt-2 text-muted mb-0">Đang tải thông tin lớp học...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.TRAINING_URLS = {
            getClassDetail: '@Url.Action("GetClassDetail", "Training")',
            submitClassRegister: '@Url.Action("SubmitClassRegister", "Training")'
        };
        const empCd = '@empCd';
        const classId = @classId;

        document.addEventListener('DOMContentLoaded', function () {
            loadClassForRegister();
        });

        function loadClassForRegister() {
            const card = document.getElementById('register-card');
            fetch(`${window.TRAINING_URLS.getClassDetail}?classId=${classId}&empcd=${empCd}`)
                .then(r => r.json())
                .then(res => {
                    if (!res.success) {
                        card.innerHTML = `<div class="alert alert-warning mb-0">${res.message || 'Không tìm thấy lớp học.'}</div>`;
                        return;
                    }

                    const cls = res.data.cls;
                    const myEnrollment = res.data.myEnrollment;

                    const enrollStatusMap = {
                        'PENDING_APPROVAL': { label: 'Đang chờ HR duyệt đăng ký của bạn', cls: 'alert-warning' },
                        'ENROLLED':         { label: 'Bạn đã tham gia lớp này',            cls: 'alert-success' },
                        'COMPLETED':        { label: 'Bạn đã hoàn thành lớp này',           cls: 'alert-success' },
                        'FAILED':           { label: 'Bạn đã tham gia lớp này (không đạt)', cls: 'alert-secondary' },
                        'REJECTED':         { label: 'Đăng ký trước đó của bạn đã bị từ chối', cls: 'alert-secondary' },
                        'DROPPED':          { label: 'Bạn đã bị loại khỏi lớp này trước đó', cls: 'alert-secondary' },
                    };

                    let actionHtml;
                    if (myEnrollment) {
                        const st = enrollStatusMap[myEnrollment.STATUS] || { label: myEnrollment.STATUS, cls: 'alert-secondary' };
                        actionHtml = `<div class="alert ${st.cls} border-0 mb-0 text-center fw-bold">${st.label}</div>`;
                    } else if (cls.STATUS !== 'OPEN_FOR_REGISTRATION') {
                        actionHtml = `<div class="alert alert-secondary border-0 mb-0 text-center fw-bold">Lớp học đã đóng đăng ký.</div>`;
                    } else {
                        actionHtml = `
                            <div class="d-grid">
                                <button onclick="submitRegister()" id="btn-register" class="btn btn-success py-2.5 rounded-3 fw-bold shadow-sm">
                                    Đăng ký tham gia
                                </button>
                            </div>`;
                    }

                    const deadlineText = cls.REGISTRATION_DEADLINE ? new Date(cls.REGISTRATION_DEADLINE).toLocaleDateString('vi-VN') : 'Không giới hạn';
                    const slotText = cls.MAX_STUDENTS ? `${cls.MAX_STUDENTS} học viên` : 'Không giới hạn';

                    card.innerHTML = `
                        <h4 class="fw-bold text-dark mb-1">${cls.COURSE_TITLE || ''}</h4>
                        <p class="text-muted mb-3">Lớp: ${cls.CLASS_NAME}</p>
                        <div class="bg-light p-3 mb-4 rounded-3 border">
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span>Hạn đăng ký:</span>
                                <span class="fw-bold text-dark">${deadlineText}</span>
                            </div>
                            <div class="d-flex justify-content-between small text-muted">
                                <span>Số slot tối đa:</span>
                                <span class="fw-bold text-dark">${slotText}</span>
                            </div>
                        </div>
                        ${actionHtml}
                    `;
                })
                .catch(err => {
                    card.innerHTML = `<div class="alert alert-danger mb-0">Lỗi kết nối: ${err.message}</div>`;
                });
        }

        function submitRegister() {
            const btn = document.getElementById('btn-register');
            btn.disabled = true;
            fetch(`${window.TRAINING_URLS.submitClassRegister}?classId=${classId}`, {
                method: 'POST'
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    window.showToast('Đăng ký thành công, đang chờ HR phê duyệt!', 'success');
                    loadClassForRegister();
                } else {
                    btn.disabled = false;
                    window.showToast(res.message || 'Không thể đăng ký lớp học.', 'error');
                }
            })
            .catch(err => {
                btn.disabled = false;
                window.showToast('Lỗi kết nối: ' + err.message, 'error');
            });
        }
    </script>
}
