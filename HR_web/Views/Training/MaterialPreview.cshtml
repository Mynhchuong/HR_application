@{
    ViewData["Title"] = ViewBag.MaterialTitle;
    Layout = "~/Views/Shared/_Layout.cshtml";
    int classId = ViewBag.ClassId;
    string title = ViewBag.MaterialTitle;
    string fileType = ViewBag.FileType;
    string fileUrl = ViewBag.FileUrl;
}

<div class="container-fluid py-4">
    <div class="card my-4">
        @await Html.PartialAsync("_TrainingPageHeader", new TrainingPageHeaderVM
        {
            Title = title,
            Icon = "bi-file-earmark",
            Gradient = "primary",
            BackUrl = Url.Action("ClassDetail", "Training", new { id = classId }) + "?tab=materials",
        })
        <div class="card-body">
            @if (fileType == "PDF")
            {
                <iframe src="@fileUrl" style="width:100%;height:75vh;border:0;border-radius:12px;background:#f8f9fa;"></iframe>
            }
            else if (fileType == "IMG")
            {
                @* Bấm để xem full-screen pinch-zoom qua MediaViewer dùng chung (giống ảnh trong chat) —
                   nhiều ảnh tài liệu là chụp màn hình quy định/hướng dẫn, cần phóng to mới đọc rõ chữ
                   trên điện thoại (yêu cầu 2026-10-26: NV xưởng 100% xem qua app). *@
                <div class="text-center">
                    <img src="@fileUrl" alt="@title" class="mp-img-trigger" style="max-width:100%;border-radius:12px;cursor:zoom-in;" />
                </div>
            }
            else if (fileType == "MP4")
            {
                @* Thumbnail nhỏ + nút play thay vì nhúng thẳng <video controls> — trước đây hiện khung
                   đen to gần hết màn hình vì chưa có poster, tự tải metadata ngay khi vào trang (cùng
                   lỗi vừa fix ở Inquiry chat). Bấm mới phát qua MediaViewer, fullscreen đúng kiểu mobile. *@
                <div class="mp-video-trigger" data-video-url="@fileUrl" role="button" aria-label="Xem video"
                     style="width:100%;aspect-ratio:16/9;border-radius:12px;background:#000;display:flex;align-items:center;justify-content:center;cursor:pointer;">
                    <span class="material-symbols-rounded" style="font-size:3rem;color:#fff;opacity:.9;">play_arrow</span>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-file-earmark-text text-muted" style="font-size:4rem;"></i>
                    <p class="text-muted mt-3 mb-0">Định dạng này không xem trước trực tiếp được. Vui lòng tải về máy để xem.</p>
                </div>
            }

            <div class="d-grid mt-4">
                <a href="@fileUrl" download class="btn btn-primary py-2 rounded-3 fw-bold d-flex align-items-center justify-content-center gap-1">
                    <i class="bi bi-download"></i> Tải về máy
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/media-viewer.js" asp-append-version="true"></script>
    <script>
        (function () {
            var imgTrigger = document.querySelector('.mp-img-trigger');
            if (imgTrigger) {
                imgTrigger.addEventListener('click', function () {
                    window.MediaViewer && window.MediaViewer.open([{ url: imgTrigger.src, type: 'image' }], 0);
                });
            }
            var videoTrigger = document.querySelector('.mp-video-trigger');
            if (videoTrigger) {
                videoTrigger.addEventListener('click', function () {
                    window.MediaViewer && window.MediaViewer.open([{ url: videoTrigger.getAttribute('data-video-url'), type: 'video' }], 0);
                });
            }
        })();
    </script>
}
