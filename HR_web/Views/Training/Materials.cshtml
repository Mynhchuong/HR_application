@{
    ViewData["Title"] = "Tài liệu học tập";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var empCd = ViewBag.EmpCd as string;
    var classId = ViewBag.ClassId;
}

<div class="container-fluid py-4" style="font-family: 'Outfit', sans-serif;">
    <!-- Breadcrumbs -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("MyClasses", "Training")" class="text-decoration-none">Đào tạo của tôi</a></li>
            <li class="breadcrumb-item"><a id="class-link" href="@Url.Action("ClassDetail", "Training", new { id = classId })" class="text-decoration-none">Chi tiết lớp học</a></li>
            <li class="breadcrumb-item active" aria-current="page">Tài liệu học tập</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-12 col-lg-10 mx-auto">
            <!-- Header Card -->
            <div class="card border-0 shadow-sm p-4 mb-4" style="border-radius: 16px; background: linear-gradient(135deg, #0d6efd 0%, #0b5ed7 100%); text-white">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-white bg-opacity-20 text-white rounded-3 p-3 d-flex align-items-center justify-content-center">
                        <span class="material-symbols-rounded" style="font-size: 2.5rem;">folder_open</span>
                    </div>
                    <div>
                        <h3 class="fw-bold text-white mb-1">Tài Liệu Học Tập</h3>
                        <p class="mb-0 text-white text-opacity-75 small">Xem, tải xuống và theo dõi tài liệu bài giảng được giáo viên cung cấp.</p>
                    </div>
                </div>
            </div>

            <!-- Materials List Container -->
            <div class="row" id="materials-list">
                <div class="col-12 text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-primary-soft { background-color: #e7f1ff; }
    .bg-danger-soft { background-color: #f8d7da; color: #842029; }
    .bg-success-soft { background-color: #d1e7dd; color: #0f5132; }
    .bg-secondary-soft { background-color: #f8f9fa; color: #6c757d; }
    .material-card {
        border-radius: 14px;
        transition: all 0.2s ease;
        border: 1px solid rgba(0,0,0,0.04);
    }
    .material-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 16px rgba(0,0,0,0.06) !important;
    }
</style>

@section Scripts {
    <script>
        window.TRAINING_URLS = {
            getClassDetail: '@Url.Action("GetClassDetail", "Training")',
            trackMaterialView: '@Url.Action("TrackMaterialView", "Training")'
        };
        const empCd = '@empCd';
        const classId = @classId;
        let classData = null;

        document.addEventListener('DOMContentLoaded', function () {
            loadMaterials();
        });

        function loadMaterials() {
            fetch(`${window.TRAINING_URLS.getClassDetail}?classId=${classId}&empcd=${empCd}`)
                .then(r => r.json())
                .then(res => {
                    if (!res.success) {
                        document.getElementById('materials-list').innerHTML = `<div class="col-12"><div class="alert alert-warning">${res.message || 'Lỗi tải tài liệu.'}</div></div>`;
                        return;
                    }
                    classData = res.data;
                    renderMaterials();
                })
                .catch(err => {
                    document.getElementById('materials-list').innerHTML = `<div class="col-12"><div class="alert alert-danger">Lỗi kết nối: ${err.message}</div></div>`;
                });
        }

        function renderMaterials() {
            const mList = document.getElementById('materials-list');
            const list = classData.materials || [];

            if (list.length === 0) {
                mList.innerHTML = `
                    <div class="col-12 text-center py-5">
                        <div class="card border-0 shadow-sm p-5 text-center text-muted" style="border-radius: 16px;">
                            <span class="material-symbols-rounded text-muted" style="font-size: 4rem;">folder_open</span>
                            <h6 class="fw-bold mt-2">Chưa có tài liệu nào</h6>
                            <p class="text-muted small mb-0">Giảng viên chưa tải lên tài liệu học tập cho lớp này.</p>
                        </div>
                    </div>
                `;
                return;
            }

            mList.innerHTML = '';
            list.forEach(m => {
                let icon = 'description';
                if (m.FILE_TYPE === 'PDF') icon = 'picture_as_pdf';
                else if (m.FILE_TYPE === 'XLS' || m.FILE_TYPE === 'XLSX') icon = 'table_chart';
                else if (m.FILE_TYPE === 'DOC' || m.FILE_TYPE === 'DOCX') icon = 'article';
                else if (m.FILE_TYPE === 'MP4') icon = 'video_library';
                else if (m.FILE_TYPE === 'IMG') icon = 'image';

                const reqBadge = m.IS_REQUIRED === 1 ? '<span class="badge bg-danger-soft ms-2 small">Bắt buộc</span>' : '';
                const viewedBadge = m.HAS_VIEWED === 1 
                    ? '<span class="badge bg-success-soft ms-1 small">Đã xem</span>' 
                    : '<span class="badge bg-secondary-soft ms-1 small">Chưa xem</span>';

                mList.innerHTML += `
                    <div class="col-12 col-md-6 mb-3">
                        <div class="card border-0 shadow-sm p-3 h-100 material-card">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-primary-soft rounded-3 p-3 text-primary d-flex align-items-center justify-content-center">
                                    <span class="material-symbols-rounded" style="font-size: 2.2rem;">${icon}</span>
                                </div>
                                <div class="flex-fill min-w-0">
                                    <h6 class="fw-bold text-dark text-truncate mb-1" title="${m.TITLE}">${m.TITLE}</h6>
                                    <p class="text-muted small mb-0">${m.FILE_TYPE} | ${reqBadge} ${viewedBadge}</p>
                                </div>
                                <div>
                                    <button onclick="viewMaterial(${m.ID}, '${m.FILE_URL}')" class="btn btn-sm btn-primary rounded-circle p-2.5 d-flex align-items-center justify-content-center shadow-sm">
                                        <span class="material-symbols-rounded" style="font-size: 1.2rem;">download</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            });
        }

        function viewMaterial(materialId, url) {
            fetch(window.TRAINING_URLS.trackMaterialView, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ MATERIAL_ID: materialId })
            })
            .then(() => {
                window.open(url, '_blank');
                loadMaterials();
            });
        }
    </script>
}
