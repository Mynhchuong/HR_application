@{
    ViewData["Title"] = "Tài liệu học tập";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var empCd = ViewBag.EmpCd as string;
    var classId = ViewBag.ClassId;
}

<div class="container-fluid py-4">
    <div class="card my-4">
        @await Html.PartialAsync("_TrainingPageHeader", new TrainingPageHeaderVM
        {
            Title = "Tài Liệu Học Tập",
            Icon = "bi-folder2-open",
            Gradient = "primary",
            BackUrl = Url.Action("ClassDetail", "Training", new { id = classId }),
        })
        <div class="card-body">
            <p class="text-muted mb-4">Xem, tải xuống và theo dõi tài liệu bài giảng được giáo viên cung cấp.</p>

            <div class="row" id="materials-list">
                <div class="col-12 text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .material-card {
        border-radius: 14px;
        transition: all 0.2s ease;
        border: 1px solid rgba(0,0,0,0.04);
    }
    .material-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 16px rgba(0,0,0,0.06) !important;
    }
</style>

@section Scripts {
    <script>
        window.TRAINING_URLS = {
            getClassDetail: '@Url.Action("GetClassDetail", "Training")',
            trackMaterialView: '@Url.Action("TrackMaterialView", "Training")'
        };
        const empCd = '@empCd';
        const classId = @classId;
        let classData = null;

        document.addEventListener('DOMContentLoaded', function () {
            loadMaterials();
        });

        function loadMaterials() {
            fetch(`${window.TRAINING_URLS.getClassDetail}?classId=${classId}&empcd=${empCd}`)
                .then(r => r.json())
                .then(res => {
                    if (!res.success) {
                        document.getElementById('materials-list').innerHTML = `<div class="col-12"><div class="alert alert-warning">${res.message || 'Lỗi tải tài liệu.'}</div></div>`;
                        return;
                    }
                    classData = res.data;
                    renderMaterials();
                })
                .catch(err => {
                    document.getElementById('materials-list').innerHTML = `<div class="col-12"><div class="alert alert-danger">Lỗi kết nối: ${err.message}</div></div>`;
                });
        }

        function renderMaterials() {
            const mList = document.getElementById('materials-list');
            const list = classData.materials || [];

            if (list.length === 0) {
                mList.innerHTML = `
                    <div class="col-12 text-center py-5">
                        <div class="card border-0 shadow-sm p-5 text-center text-muted" style="border-radius: 16px;">
                            <i class="bi bi-folder2-open text-muted" style="font-size: 4rem;"></i>
                            <h6 class="fw-bold mt-2">Chưa có tài liệu nào</h6>
                            <p class="text-muted small mb-0">Giảng viên chưa tải lên tài liệu học tập cho lớp này.</p>
                        </div>
                    </div>
                `;
                return;
            }

            mList.innerHTML = '';
            list.forEach(m => {
                let icon = 'bi-file-earmark';
                if (m.FILE_TYPE === 'PDF') icon = 'bi-file-earmark-pdf';
                else if (m.FILE_TYPE === 'XLS' || m.FILE_TYPE === 'XLSX') icon = 'bi-file-earmark-spreadsheet';
                else if (m.FILE_TYPE === 'DOC' || m.FILE_TYPE === 'DOCX') icon = 'bi-file-earmark-text';
                else if (m.FILE_TYPE === 'MP4') icon = 'bi-camera-video';
                else if (m.FILE_TYPE === 'IMG') icon = 'bi-file-earmark-image';

                const reqBadge = m.IS_REQUIRED === 1 ? '<span class="badge bg-danger ms-2 small">Bắt buộc</span>' : '';
                const viewedBadge = m.HAS_VIEWED === 1
                    ? '<span class="badge bg-success ms-1 small">Đã xem</span>'
                    : '<span class="badge bg-secondary ms-1 small">Chưa xem</span>';

                mList.innerHTML += `
                    <div class="col-12 col-md-6 mb-3">
                        <div class="card border-0 shadow-sm p-3 h-100 material-card">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-gradient-primary rounded-3 p-3 text-white d-flex align-items-center justify-content-center">
                                    <i class="${icon}" style="font-size: 2.2rem;"></i>
                                </div>
                                <div class="flex-fill min-w-0">
                                    <h6 class="fw-bold text-dark text-truncate mb-1" title="${m.TITLE}">${m.TITLE}</h6>
                                    <p class="text-muted small mb-0">${m.FILE_TYPE} | ${reqBadge} ${viewedBadge}</p>
                                </div>
                                <div>
                                    <button onclick="viewMaterial(${m.ID}, '${m.FILE_URL}')" class="btn btn-sm btn-primary rounded-circle p-2.5 d-flex align-items-center justify-content-center shadow-sm">
                                        <i class="bi bi-download" style="font-size: 1.2rem;"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            });
        }

        function viewMaterial(materialId, url) {
            fetch(window.TRAINING_URLS.trackMaterialView, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ MATERIAL_ID: materialId })
            })
            .then(() => {
                window.open(url, '_blank');
                loadMaterials();
            });
        }
    </script>
}
