@{
    ViewData["Title"] = "Đào tạo của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var empCd = ViewBag.EmpCd as string;
}

<div class="container-fluid py-4" style="font-family: 'Outfit', sans-serif;">
    <!-- Header Banner -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm overflow-hidden" style="border-radius: 20px; background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);">
                <div class="card-body p-4 text-white position-relative">
                    <div class="position-absolute end-0 bottom-0 opacity-10 d-none d-md-block" style="transform: translate(10%, 10%);">
                        <span class="material-symbols-rounded" style="font-size: 15rem;">school</span>
                    </div>
                    <h2 class="fw-bold mb-1">Cổng Đào Tạo Cá Nhân</h2>
                    <p class="mb-0 opacity-75">Theo dõi lịch học, tài liệu, thảo luận Q&A và tham gia các bài thi đánh giá của bạn.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm" style="border-radius: 12px;">
                <div class="card-body p-2">
                    <ul class="nav nav-tabs nav-justified border-0" id="studentTabs" role="tablist">
                        <li class="nav-item">
                            <button onclick="switchTab('classes')" class="nav-link active py-3 fw-bold border-0 d-flex align-items-center justify-content-center gap-2" id="tab-classes">
                                <span class="material-symbols-rounded">menu_book</span>
                                Lớp học của tôi
                            </button>
                        </li>
                        <li class="nav-item">
                            <button onclick="switchTab('certs')" class="nav-link py-3 fw-bold border-0 d-flex align-items-center justify-content-center gap-2" id="tab-certs">
                                <span class="material-symbols-rounded">card_membership</span>
                                Chứng chỉ của tôi
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Tab 1: Lớp học -->
    <div id="panel-classes" class="tab-panel">
        <div class="row mb-4 align-items-center">
            <div class="col-12">
                <h4 class="fw-bold text-dark mb-0">Lớp học đang tham gia</h4>
            </div>
        </div>
        <div class="row" id="my-classes-container">
            <div class="col-12 text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2 text-muted">Đang tải danh sách lớp học...</p>
            </div>
        </div>
    </div>

    <!-- Tab 2: Chứng chỉ -->
    <div id="panel-certs" class="tab-panel d-none">
        <div class="card border-0 shadow-sm p-4" style="border-radius: 16px;">
            <h4 class="fw-bold text-dark mb-4">Danh sách chứng chỉ đào tạo đã đạt</h4>
            
            <div class="table-responsive bg-light p-2 rounded-3">
                <table class="table table-hover align-middle mb-0 bg-white rounded shadow-sm text-nowrap">
                    <thead>
                        <tr class="text-muted small">
                            <th class="ps-3">Tên khóa học</th>
                            <th>Lớp học</th>
                            <th>Ngày cấp</th>
                            <th>Điểm số</th>
                            <th class="pe-3">Chuyên cần</th>
                        </tr>
                    </thead>
                    <tbody id="my-certs-tbody">
                        <tr>
                            <td colspan="5" class="text-center text-muted py-5">
                                <div class="spinner-border text-primary spinner-border-sm" role="status"></div>
                                <span class="ms-2">Đang tải...</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .class-card {
        border-radius: 16px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid rgba(0,0,0,0.06);
    }
    .class-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08) !important;
    }
    .progress-bar-custom {
        height: 6px;
        border-radius: 3px;
        background-color: #e9ecef;
    }
    .badge-express {
        background-color: #ffe8cc;
        color: #fd7e14;
    }
    .badge-standard {
        background-color: #e3faf2;
        color: #0ca678;
    }
</style>

@section Scripts {
    <script>
        window.TRAINING_URLS = {
            getMyClasses: '@Url.Action("GetMyClasses", "Training")',
            classDetailTemplate: '@Url.Action("ClassDetail", "Training", new { id = "__ID__" })',
            getCertificateList: '@Url.Action("GetMyCertificates", "Training")'
        };
        const empCd = '@empCd';

        document.addEventListener('DOMContentLoaded', function () {
            loadMyClasses();
        });

        function switchTab(tab) {
            document.querySelectorAll('#studentTabs button').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.tab-panel').forEach(p => p.classList.add('d-none'));

            if (tab === 'classes') {
                document.getElementById('tab-classes').classList.add('active');
                document.getElementById('panel-classes').classList.remove('d-none');
                loadMyClasses();
            } else if (tab === 'certs') {
                document.getElementById('tab-certs').classList.add('active');
                document.getElementById('panel-certs').classList.remove('d-none');
                loadMyCertificates();
            }
        }

        function loadMyClasses() {
            const container = document.getElementById('my-classes-container');
            container.innerHTML = `
                <div class="col-12 text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 text-muted">Đang tải...</p>
                </div>
            `;
            
            fetch(`${window.TRAINING_URLS.getMyClasses}?empcd=${empCd}`)
                .then(r => r.json())
                .then(res => {
                    if (!res || !res.success) {
                        container.innerHTML = `<div class="col-12"><div class="alert alert-warning">${(res && res.message) || 'Lỗi kết nối máy chủ.'}</div></div>`;
                        return;
                    }

                    const list = res.data || [];
                    if (list.length === 0) {
                        container.innerHTML = `
                            <div class="col-12 text-center py-5">
                                <span class="material-symbols-rounded text-muted" style="font-size: 5rem;">menu_book</span>
                                <h5 class="fw-bold mt-3">Bạn chưa tham gia lớp học nào</h5>
                                <p class="text-muted small">Hãy bấm nút "Đăng ký lớp học mới" ở góc trên để tìm các lớp học mở tự do.</p>
                            </div>
                        `;
                        return;
                    }

                    container.innerHTML = '';
                    list.forEach(item => {
                        const isCompleted = item.STATUS === 'COMPLETED';
                        const isFailed = item.STATUS === 'FAILED';
                        const pct = item.TOTAL_SESSIONS > 0 ? Math.round((item.COMPLETED_SESSIONS / item.TOTAL_SESSIONS) * 100) : 0;
                        
                        let statusBadge = `<span class="badge bg-primary rounded-pill px-3 py-2">Đang học</span>`;
                        if (isCompleted) statusBadge = `<span class="badge bg-success rounded-pill px-3 py-2">Hoàn thành</span>`;
                        else if (isFailed) statusBadge = `<span class="badge bg-danger rounded-pill px-3 py-2">Không đạt</span>`;
                        
                        let groupText = item.GROUP_NAME ? `<span class="badge bg-secondary ms-1">${item.GROUP_NAME}</span>` : '';

                        const modeBadge = item.CLASS_MODE === 'EXPRESS' 
                             ? `<span class="badge badge-express px-2 py-1 small">Học nhanh</span>`
                             : `<span class="badge badge-standard px-2 py-1 small">Tiêu chuẩn</span>`;

                        container.innerHTML += `
                            <div class="col-12 col-md-6 col-lg-4 mb-4">
                                <div class="card h-100 border-0 shadow-sm class-card">
                                    <div class="card-body p-4 d-flex flex-column">
                                        <div class="d-flex justify-content-between align-items-start mb-3">
                                            ${modeBadge}
                                            ${statusBadge}
                                        </div>
                                        <h5 class="fw-bold mb-1 text-dark text-truncate-2">${item.COURSE_TITLE}</h5>
                                        <p class="text-muted small mb-3">Lớp: ${item.CLASS_NAME} ${groupText}</p>
                                        
                                        <div class="mt-auto">
                                            <!-- Giáo viên -->
                                            <div class="d-flex align-items-center gap-2 mb-3">
                                                <span class="material-symbols-rounded text-muted" style="font-size: 1.2rem;">person</span>
                                                <span class="small text-muted">GV: <span class="vni-font font-semibold">${item.PRIMARY_TEACHER_NAME || 'Chưa phân công'}</span></span>
                                            </div>

                                            <!-- Tiến độ -->
                                            <div class="mb-3">
                                                <div class="d-flex justify-content-between small text-muted mb-1">
                                                    <span>Tiến độ học tập</span>
                                                    <span>${item.COMPLETED_SESSIONS}/${item.TOTAL_SESSIONS} buổi (${pct}%)</span>
                                                </div>
                                                <div class="progress progress-bar-custom">
                                                    <div class="progress-bar" role="progressbar" style="width: ${pct}%"></div>
                                                </div>
                                            </div>

                                            <div class="d-grid">
                                                <a href="${window.TRAINING_URLS.classDetailTemplate.replace('__ID__', item.CLASS_ID)}" class="btn btn-outline-primary py-2 rounded-3 fw-bold d-flex align-items-center justify-content-center gap-1">
                                                    <span class="material-symbols-rounded" style="font-size: 1.2rem;">login</span>
                                                    Vào lớp học
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        `;
                    });
                })
                .catch(err => {
                    container.innerHTML = `<div class="col-12"><div class="alert alert-danger">Lỗi kết nối hệ thống: ${err.message}</div></div>`;
                });
        }

        function loadMyCertificates() {
            const tbody = document.getElementById('my-certs-tbody');
            tbody.innerHTML = `
                <tr>
                    <td colspan="5" class="text-center text-muted py-5">
                        <div class="spinner-border text-primary spinner-border-sm" role="status"></div>
                        <span class="ms-2">Đang tải danh sách chứng chỉ...</span>
                    </td>
                </tr>
            `;

            fetch(`${window.TRAINING_URLS.getCertificateList}?empcd=${empCd}`)
                .then(r => r.json())
                .then(res => {
                    if (!res.success || !res.data) {
                        tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-4">Bạn chưa có chứng chỉ nào.</td></tr>';
                        return;
                    }

                    const list = res.data;
                    if (list.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-4">Bạn chưa có chứng chỉ nào.</td></tr>';
                        return;
                    }

                    tbody.innerHTML = '';
                    list.forEach(c => {
                        const dateStr = c.COMPLETION_DATE ? new Date(c.COMPLETION_DATE).toLocaleDateString('vi-VN') : '-';
                        const scoreStr = c.FINAL_SCORE !== null ? `${c.FINAL_SCORE} / 100` : '-';
                        const attendStr = c.ATTENDANCE_PERCENT !== null ? `${c.ATTENDANCE_PERCENT.toFixed(1)}%` : '-';

                        tbody.innerHTML += `
                            <tr>
                                <td class="ps-3 fw-bold text-dark">${c.COURSE_TITLE}</td>
                                <td>${c.CLASS_NAME}</td>
                                <td>${dateStr}</td>
                                <td><strong class="text-success">${scoreStr}</strong></td>
                                <td class="pe-3"><strong class="text-primary">${attendStr}</strong></td>
                            </tr>
                        `;
                    });
                })
                .catch(() => {
                    tbody.innerHTML = '<tr><td colspan="5" class="text-center text-danger py-4">Lỗi kết nối hệ thống. Vui lòng thử lại sau.</td></tr>';
                });
        }
    </script>
}
