@using HR_web.Models.Training
@{
    ViewData["Title"] = "Báo cáo Training";
    var classes = ViewBag.Classes as List<ClassListItem> ?? new List<ClassListItem>();
    int? selectedClassId = ViewBag.SelectedClassId as int?;
    string tab = (ViewBag.Tab as string) ?? "class";
}

@section Styles {
    <style>
        .rpt-tab-nav { display:flex; gap:4px; border-bottom:2px solid #e9ecef; margin-bottom:1rem; }
        .rpt-tab-nav a { padding:.6rem 1rem; text-decoration:none; color:#6c757d; font-weight:500; border-bottom:2px solid transparent; margin-bottom:-2px; }
        .rpt-tab-nav a.active { color:#0d6efd; border-color:#0d6efd; }
        .rpt-tab-nav a:hover { color:#0d6efd; }
        .kpi-box { border:1px solid #e9ecef; border-radius:8px; padding:1rem; background:#f8fafc; }
        .kpi-box .val { font-size:1.6rem; font-weight:700; color:#0d6efd; }
        .kpi-box .lbl { font-size:.8rem; color:#6c757d; text-transform:uppercase; letter-spacing:.5px; }
        .matrix-cell-P { background:#d4edda; color:#155724; }
        .matrix-cell-L { background:#fff3cd; color:#856404; }
        .matrix-cell-A { background:#f8d7da; color:#721c24; }
        .matrix-cell-E { background:#e2e3e5; color:#495057; }
        .matrix-cell-em { background:#f8fafc; color:#adb5bd; }
        #histoChart { max-height:300px; }
        .top-wrong-item { border-left:3px solid #dc3545; padding:.5rem .8rem; background:#fff5f5; border-radius:4px; margin-bottom:.4rem; }
    </style>
}

<div class="container-fluid py-4">
    <div class="card mb-4">
        <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
            <div class="bg-gradient-primary shadow-primary border-radius-lg pt-3 pb-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h6 class="text-white text-capitalize mb-0"><i class="bi bi-bar-chart-line-fill me-1"></i> Báo cáo Training §14</h6>
                <form method="get" action="@Url.Action("Reports", "Training")" class="d-flex align-items-center gap-2">
                    <input type="hidden" name="tab" value="@tab" />
                    <label class="text-white small mb-0">Chọn lớp:</label>
                    <select name="classId" class="form-select form-select-sm" onchange="this.form.submit()" style="min-width:280px;">
                        <option value="">-- chọn lớp --</option>
                        @foreach (var c in classes)
                        {
                            <option value="@c.ID" selected="@(c.ID == selectedClassId)">
                                @c.CLASS_NAME (@c.STATUS)
                            </option>
                        }
                    </select>
                </form>
            </div>
        </div>

        <div class="card-body">
            @if (selectedClassId == null)
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-info-circle fs-3"></i>
                    <p class="mt-2 mb-0">Chọn lớp ở trên để xem báo cáo</p>
                </div>
            }
            else
            {
                <nav class="rpt-tab-nav">
                    <a href="@Url.Action("Reports", "Training", new { classId = selectedClassId, tab = "class" })" class="@(tab == "class" ? "active" : "")">📊 Overview</a>
                    <a href="@Url.Action("Reports", "Training", new { classId = selectedClassId, tab = "attendance" })" class="@(tab == "attendance" ? "active" : "")">📅 Điểm danh</a>
                    <a href="@Url.Action("Reports", "Training", new { classId = selectedClassId, tab = "test" })" class="@(tab == "test" ? "active" : "")">📝 Test</a>
                    <a href="@Url.Action("Reports", "Training", new { classId = selectedClassId, tab = "satisfaction" })" class="@(tab == "satisfaction" ? "active" : "")">⭐ Đánh giá</a>
                </nav>

                <div id="reportContent"><div class="text-center text-muted py-4">Đang tải…</div></div>
            }
        </div>
    </div>
</div>

@if (selectedClassId != null)
{
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
    <script>
    const CLASS_ID = @selectedClassId;
    const TAB      = '@tab';
    const URLS = {
        class:        '@Url.Action("GetReportClass",        "Training")',
        attendance:   '@Url.Action("GetReportAttendance",   "Training")',
        test:         '@Url.Action("GetReportTest",         "Training")',
        satisfaction: '@Url.Action("GetReportSatisfaction", "Training")',
        expClass:     '@Url.Action("ExportClass",        "Training")',
        expAttend:    '@Url.Action("ExportAttendance",   "Training")',
        expTest:      '@Url.Action("ExportTest",         "Training")',
        expSat:       '@Url.Action("ExportSatisfaction", "Training")',
    };

    function esc(s) {
        if (s == null) return '';
        return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    }
    function num(v) { return v == null ? '-' : v; }

    async function loadClassReport() {
        const res = await fetch(`${URLS.class}?classId=${CLASS_ID}`);
        const json = await res.json();
        if (!json.success || !json.data) return renderErr('Không có dữ liệu');
        const d = json.data;
        const html = `
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">${esc(d.CLASS_NAME)} <small class="text-muted">${esc(d.COURSE_TITLE)}</small></h5>
                <a href="${URLS.expClass}?classId=${CLASS_ID}" class="btn btn-sm btn-success">
                    <i class="bi bi-file-earmark-excel me-1"></i> Xuất Excel
                </a>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-6 col-md-3"><div class="kpi-box"><div class="val">${d.ENROLLED_COUNT}</div><div class="lbl">Đang học</div></div></div>
                <div class="col-6 col-md-3"><div class="kpi-box"><div class="val text-success">${d.COMPLETED_COUNT}</div><div class="lbl">Hoàn thành</div></div></div>
                <div class="col-6 col-md-3"><div class="kpi-box"><div class="val text-danger">${d.FAILED_COUNT}</div><div class="lbl">Rớt</div></div></div>
                <div class="col-6 col-md-3"><div class="kpi-box"><div class="val text-info">${d.CERTIFIED_COUNT}</div><div class="lbl">Có chứng chỉ</div></div></div>
                <div class="col-6 col-md-3"><div class="kpi-box"><div class="val">${d.ASSIGNED_COUNT}</div><div class="lbl">Bắt buộc</div></div></div>
                <div class="col-6 col-md-3"><div class="kpi-box"><div class="val">${d.SELF_REGISTER_COUNT}</div><div class="lbl">Tự đăng ký</div></div></div>
                <div class="col-6 col-md-3"><div class="kpi-box"><div class="val text-warning">${d.DROPPED_COUNT}</div><div class="lbl">Bị đá</div></div></div>
                <div class="col-6 col-md-3"><div class="kpi-box"><div class="val">${num(d.AVG_ATTENDANCE_PERCENT?.toFixed?.(1))}%</div><div class="lbl">Điểm danh TB</div></div></div>
            </div>
            <div class="row g-3">
                <div class="col-lg-6">
                    <div class="card"><div class="card-body">
                        <h6 class="mb-2">📊 Phân phối điểm final test</h6>
                        <canvas id="histoChart"></canvas>
                    </div></div>
                </div>
                <div class="col-lg-6">
                    <div class="card"><div class="card-body">
                        <h6 class="mb-2">👥 Breakdown per group</h6>
                        ${d.GROUP_BREAKDOWN.length === 0
                            ? '<p class="text-muted text-center py-3">Class không chia nhóm</p>'
                            : `<table class="table table-sm">
                                <thead><tr><th>Nhóm</th><th>Đang học</th><th>Xong</th><th>Cert</th><th>TB điểm danh</th></tr></thead>
                                <tbody>${d.GROUP_BREAKDOWN.map(g => `<tr>
                                    <td><strong>${esc(g.GROUP_NAME)}</strong></td>
                                    <td>${g.ENROLLED}</td>
                                    <td>${g.COMPLETED}</td>
                                    <td>${g.CERTIFIED}</td>
                                    <td>${g.AVG_ATTENDANCE == null ? '-' : g.AVG_ATTENDANCE.toFixed(1) + '%'}</td>
                                </tr>`).join('')}</tbody>
                              </table>`}
                    </div></div>
                </div>
            </div>`;
        document.getElementById('reportContent').innerHTML = html;

        // Bar chart histogram
        new Chart(document.getElementById('histoChart'), {
            type: 'bar',
            data: {
                labels: d.SCORE_HISTOGRAM.map(x => x.LABEL),
                datasets: [{ data: d.SCORE_HISTOGRAM.map(x => x.COUNT), backgroundColor: '#0d6efd' }],
            },
            options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } } },
        });
    }

    async function loadAttendance() {
        const res = await fetch(`${URLS.attendance}?classId=${CLASS_ID}`);
        const json = await res.json();
        if (!json.success || !json.data) return renderErr('Không có dữ liệu');
        const d = json.data;
        const cellCls = { PRESENT: 'matrix-cell-P', LATE: 'matrix-cell-L', ABSENT: 'matrix-cell-A', EXCUSED: 'matrix-cell-E' };
        const cellLbl = { PRESENT: '✓', LATE: 'L', ABSENT: '✗', EXCUSED: 'E' };
        const html = `
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">📅 Ma trận điểm danh (${d.STUDENTS.length} học viên × ${d.SESSIONS.length} buổi)</h5>
                <a href="${URLS.expAttend}?classId=${CLASS_ID}" class="btn btn-sm btn-success">
                    <i class="bi bi-file-earmark-excel me-1"></i> Xuất Excel
                </a>
            </div>
            <p class="text-muted small mb-2">Ký hiệu: ✓ = Present, L = Late, ✗ = Absent, E = Excused, (rỗng) = không thuộc group session này</p>
            <div class="table-responsive" style="max-height:70vh;">
                <table class="table table-sm table-bordered mb-0" style="font-size:.75rem;">
                    <thead class="bg-light sticky-top">
                        <tr>
                            <th style="min-width:100px;">EMPCD</th>
                            <th style="min-width:150px;">Tên</th>
                            <th style="min-width:80px;">Nhóm</th>
                            <th style="min-width:80px;">Điểm danh %</th>
                            ${d.SESSIONS.map(s => `<th class="text-center" style="min-width:80px;">
                                #${s.SESSION_NO}<br>
                                <small>${new Date(s.SESSION_DATE).toLocaleDateString('vi-VN')}</small>
                                ${s.GROUP_NAME ? `<br><small class="badge bg-warning text-dark">${esc(s.GROUP_NAME)}</small>` : ''}
                            </th>`).join('')}
                        </tr>
                    </thead>
                    <tbody>
                        ${d.STUDENTS.map(st => `<tr>
                            <td>${esc(st.EMPCD)}</td>
                            <td class="vni-font" style="text-transform:uppercase;">${esc(st.EMP_NAME||'')}</td>
                            <td>${esc(st.GROUP_NAME||'-')}</td>
                            <td><strong>${st.ATTENDANCE_PERCENT.toFixed(1)}%</strong></td>
                            ${d.SESSIONS.map(s => {
                                const v = st.STATUS_PER_SESSION[s.SESSION_ID] || '';
                                if (v === '') return `<td class="matrix-cell-em text-center">·</td>`;
                                return `<td class="${cellCls[v]||''} text-center"><strong>${cellLbl[v]||v}</strong></td>`;
                            }).join('')}
                        </tr>`).join('')}
                    </tbody>
                </table>
            </div>`;
        document.getElementById('reportContent').innerHTML = html;
    }

    async function loadTestReport() {
        // Class có thể có nhiều test — v1 chỉ hỗ trợ FINAL_TEST_ID (server tự pick).
        // Endpoint yêu cầu testId. Fetch danh sách test của Class → user chọn test.
        const listRes = await fetch(`/apiHR/TrainingAdmin/test/list?classId=${CLASS_ID}`.replace('/apiHR/','/proxy-not-set/')).catch(() => null);
        // Simpler: fetch class detail để lấy FINAL_TEST_ID (nếu có)
        document.getElementById('reportContent').innerHTML = `
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-1"></i>
                <strong>Chọn Test ID để xem báo cáo:</strong>
                <div class="mt-2 d-flex align-items-center gap-2">
                    <input type="number" id="testIdInput" class="form-control form-control-sm" style="max-width:150px;" placeholder="Nhập TEST_ID" />
                    <button id="loadTestBtn" class="btn btn-sm btn-primary">Xem</button>
                </div>
                <p class="small text-muted mt-2 mb-0">TEST_ID lấy từ trang tests của Class hoặc DB.</p>
            </div>
            <div id="testReportBody"></div>`;
        document.getElementById('loadTestBtn').onclick = async () => {
            const testId = document.getElementById('testIdInput').value;
            if (!testId) return;
            const res = await fetch(`${URLS.test}?testId=${testId}`);
            const json = await res.json();
            if (!json.success || !json.data) {
                document.getElementById('testReportBody').innerHTML = '<div class="alert alert-warning">Không có dữ liệu</div>';
                return;
            }
            const d = json.data;
            document.getElementById('testReportBody').innerHTML = `
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">📝 ${esc(d.TEST_TITLE)}</h5>
                    <a href="${URLS.expTest}?testId=${testId}" class="btn btn-sm btn-success">
                        <i class="bi bi-file-earmark-excel me-1"></i> Xuất Excel
                    </a>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-6 col-md-3"><div class="kpi-box"><div class="val">${d.ATTEMPT_COUNT}</div><div class="lbl">Số lần làm</div></div></div>
                    <div class="col-6 col-md-3"><div class="kpi-box"><div class="val text-success">${d.PASS_COUNT}</div><div class="lbl">Pass</div></div></div>
                    <div class="col-6 col-md-3"><div class="kpi-box"><div class="val text-danger">${d.FAIL_COUNT}</div><div class="lbl">Fail</div></div></div>
                    <div class="col-6 col-md-3"><div class="kpi-box"><div class="val">${num(d.AVG_SCORE?.toFixed?.(2))}</div><div class="lbl">Điểm TB</div></div></div>
                </div>
                <div class="row g-3">
                    <div class="col-lg-8">
                        <div class="card"><div class="card-body">
                            <h6>Điểm từng học viên</h6>
                            <div class="table-responsive" style="max-height:60vh;">
                                <table class="table table-sm">
                                    <thead class="bg-light"><tr><th>EMPCD</th><th>Tên</th><th>Điểm</th><th>Pass</th><th>Nộp</th></tr></thead>
                                    <tbody>${d.SCORES.map(s => `<tr>
                                        <td>${esc(s.EMPCD)}</td>
                                        <td class="vni-font" style="text-transform:uppercase;">${esc(s.EMP_NAME||'')}</td>
                                        <td><strong>${s.SCORE == null ? '-' : s.SCORE}${s.MAX_SCORE ? '/' + s.MAX_SCORE : ''}</strong></td>
                                        <td>${s.IS_PASS == 1 ? '<span class="badge bg-success">PASS</span>' : s.IS_PASS == 0 ? '<span class="badge bg-danger">FAIL</span>' : '-'}</td>
                                        <td class="text-muted small">${s.SUBMIT_DT ? new Date(s.SUBMIT_DT).toLocaleString('vi-VN') : '-'}</td>
                                    </tr>`).join('')}</tbody>
                                </table>
                            </div>
                        </div></div>
                    </div>
                    <div class="col-lg-4">
                        <div class="card"><div class="card-body">
                            <h6>🎯 Top 5 câu sai nhiều</h6>
                            ${d.TOP_WRONG_QUESTIONS.length === 0 ? '<p class="text-muted">Chưa có dữ liệu</p>' :
                              d.TOP_WRONG_QUESTIONS.map(q => `<div class="top-wrong-item">
                                <div class="small text-muted">${q.QUESTION_TYPE}</div>
                                <div>${esc(q.QUESTION_TEXT)}</div>
                                <div class="small mt-1"><span class="text-danger fw-bold">${q.WRONG_COUNT}/${q.ATTEMPT_COUNT}</span> sai (${q.WRONG_PERCENT}%)</div>
                              </div>`).join('')}
                        </div></div>
                    </div>
                </div>`;
        };
    }

    async function loadSatisfaction() {
        const res = await fetch(`${URLS.satisfaction}?classId=${CLASS_ID}`);
        const json = await res.json();
        if (!json.success || !json.data) return renderErr('Không có dữ liệu');
        const d = json.data;
        document.getElementById('reportContent').innerHTML = `
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">⭐ Đánh giá sau khoá (${d.RESPONSE_COUNT} phản hồi)</h5>
                <a href="${URLS.expSat}?classId=${CLASS_ID}" class="btn btn-sm btn-success">
                    <i class="bi bi-file-earmark-excel me-1"></i> Xuất Excel
                </a>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-md-6"><div class="kpi-box"><div class="val">${num(d.AVG_CONTENT?.toFixed?.(2))}/5</div><div class="lbl">📚 Nội dung khoá</div></div></div>
                <div class="col-md-6"><div class="kpi-box"><div class="val">${num(d.AVG_ORGANIZATION?.toFixed?.(2))}/5</div><div class="lbl">🎯 Tổ chức</div></div></div>
            </div>
            <div class="row g-3">
                <div class="col-lg-6">
                    <div class="card"><div class="card-body">
                        <h6>👨‍🏫 Giáo viên</h6>
                        ${d.TEACHER_AGGREGATES.length === 0 ? '<p class="text-muted">Chưa có rating giáo viên</p>' :
                          `<table class="table table-sm">
                            <thead><tr><th>Tên</th><th>Rating TB</th><th>Số phản hồi</th></tr></thead>
                            <tbody>${d.TEACHER_AGGREGATES.map(t => `<tr>
                                <td class="vni-font" style="text-transform:uppercase;">${esc(t.TEACHER_NAME||t.TEACHER_EMPCD)}</td>
                                <td><strong>${t.AVG_RATING.toFixed(2)}/5</strong></td>
                                <td>${t.COUNT}</td>
                            </tr>`).join('')}</tbody>
                          </table>`}
                    </div></div>
                </div>
                <div class="col-lg-6">
                    <div class="card"><div class="card-body">
                        <h6>💬 Feedback</h6>
                        <div style="max-height:400px;overflow-y:auto;">
                            ${d.FEEDBACK_LIST.length === 0 ? '<p class="text-muted">Chưa có feedback</p>' :
                              d.FEEDBACK_LIST.map(f => `<div class="border-start border-3 border-info ps-2 mb-2 small">${esc(f)}</div>`).join('')}
                        </div>
                    </div></div>
                </div>
            </div>`;
    }

    function renderErr(msg) {
        document.getElementById('reportContent').innerHTML = `<div class="alert alert-warning"><i class="bi bi-exclamation-triangle me-1"></i>${esc(msg)}</div>`;
    }

    document.addEventListener('DOMContentLoaded', () => {
        if      (TAB === 'class')        loadClassReport();
        else if (TAB === 'attendance')   loadAttendance();
        else if (TAB === 'test')         loadTestReport();
        else if (TAB === 'satisfaction') loadSatisfaction();
    });
    </script>
}
}
