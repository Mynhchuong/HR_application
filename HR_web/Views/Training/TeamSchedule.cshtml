@{
    ViewData["Title"] = "Lịch training team";
    var from    = ViewBag.From as string ?? "";
    var to      = ViewBag.To   as string ?? "";
    var isToday = (bool)(ViewBag.Today ?? false);
    var hasScope= (bool)(ViewBag.HasScope ?? false);
}

@section Styles {
    <style>
        .stats-card .icon { width:48px;height:48px;display:flex;align-items:center;justify-content:center;border-radius:12px; }
        #teamTableBody tr td { vertical-align:middle; }
        #teamTableBody .emp-name { font-family:'Times New Roman',serif;font-weight:600; }
        .filter-bar select, .filter-bar input { min-width:120px; }
        .badge-time { background:#e7f5ff;color:#0d6efd;font-weight:500; }
        .badge-status-UPCOMING  { background:#e7f5ff;color:#0d6efd; }
        .badge-status-ONGOING   { background:#d4edda;color:#155724; }
        .badge-status-COMPLETED { background:#e2e3e5;color:#495057; }
        .badge-group { background:#fff3cd;color:#856404; }
    </style>
}

<div class="container-fluid py-4">
    @if (!hasScope)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Bạn không có phạm vi quản lý nào. Trang này dành cho Manager / Supervisor / Clerk có row trong <code>HR_USERS_DEPT</code>.
        </div>
    }
    else
    {
        <div class="row mb-3">
            <div class="col-6 col-xl-3 mb-3 mb-xl-0">
                <div class="card stats-card"><div class="card-body p-3"><div class="row"><div class="col-8">
                    <p class="text-sm mb-0 text-uppercase font-weight-bold text-info">Buổi học</p>
                    <h5 class="font-weight-bolder mb-0" id="summaryTotal">-</h5>
                </div><div class="col-4 text-end">
                    <div class="icon bg-gradient-info text-white shadow-info ms-auto"><i class="bi bi-calendar-week fs-4"></i></div>
                </div></div></div></div>
            </div>
            <div class="col-6 col-xl-3 mb-3 mb-xl-0">
                <div class="card stats-card"><div class="card-body p-3"><div class="row"><div class="col-8">
                    <p class="text-sm mb-0 text-uppercase font-weight-bold text-success">Học viên</p>
                    <h5 class="font-weight-bolder mb-0" id="summaryStudents">-</h5>
                </div><div class="col-4 text-end">
                    <div class="icon bg-gradient-success text-white shadow-success ms-auto"><i class="bi bi-people-fill fs-4"></i></div>
                </div></div></div></div>
            </div>
            <div class="col-6 col-xl-3 mb-3 mb-xl-0">
                <div class="card stats-card"><div class="card-body p-3"><div class="row"><div class="col-8">
                    <p class="text-sm mb-0 text-uppercase font-weight-bold text-warning">Lớp</p>
                    <h5 class="font-weight-bolder mb-0" id="summaryClasses">-</h5>
                </div><div class="col-4 text-end">
                    <div class="icon bg-gradient-warning text-white shadow-warning ms-auto"><i class="bi bi-mortarboard-fill fs-4"></i></div>
                </div></div></div></div>
            </div>
            <div class="col-6 col-xl-3 mb-3 mb-xl-0">
                <div class="card stats-card"><div class="card-body p-3"><div class="row"><div class="col-8">
                    <p class="text-sm mb-0 text-uppercase font-weight-bold text-primary">Hôm nay</p>
                    <h5 class="font-weight-bolder mb-0" id="summaryToday">-</h5>
                </div><div class="col-4 text-end">
                    <div class="icon bg-gradient-primary text-white shadow-primary ms-auto"><i class="bi bi-calendar-day fs-4"></i></div>
                </div></div></div></div>
            </div>
        </div>

        <div class="card my-4 mb-4">
            <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                <div class="bg-gradient-info shadow-info border-radius-lg pt-3 pb-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h6 class="text-white text-capitalize mb-0">
                        <i class="bi bi-calendar-check me-1"></i> Lịch training của NV thuộc scope quản lý
                    </h6>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <button type="button" id="exportExcelBtn" class="btn btn-sm btn-success mb-0 text-nowrap d-flex align-items-center" style="height:36px;">
                            <i class="bi bi-file-earmark-excel me-1 fs-6"></i> Xuất Excel
                        </button>
                    </div>
                </div>
            </div>

            <div class="px-3 pt-3 pb-2 d-flex flex-wrap align-items-end gap-2 filter-bar" style="background:#f8fafc;border-bottom:1px solid #e9ecef;">
                <div>
                    <label class="form-label small fw-bold mb-1 text-primary">Từ ngày</label>
                    <input type="date" id="filterFrom" class="form-control form-control-sm" value="@from" />
                </div>
                <div>
                    <label class="form-label small fw-bold mb-1 text-primary">Đến ngày</label>
                    <input type="date" id="filterTo" class="form-control form-control-sm" value="@to" />
                </div>
                <div>
                    <label class="form-label small fw-bold mb-1 text-primary">Trạng thái</label>
                    <select id="filterStatus" class="form-select form-select-sm">
                        <option value="ALL">Tất cả</option>
                        <option value="UPCOMING">Sắp diễn ra</option>
                        <option value="ONGOING">Đang diễn ra</option>
                        <option value="COMPLETED">Đã xong</option>
                    </select>
                </div>
                <div style="flex:1 1 200px;max-width:280px;">
                    <label class="form-label small fw-bold mb-1 text-primary">Tìm kiếm</label>
                    <input type="text" id="searchInput" class="form-control form-control-sm" placeholder="🔍 EMPCD / tên / dept / lớp..." />
                </div>
                <div>
                    <button type="button" id="reloadBtn" class="btn btn-sm btn-primary mb-0" style="height:31px;">
                        <i class="bi bi-arrow-clockwise me-1"></i> Tải lại
                    </button>
                </div>
            </div>

            <div class="card-body px-0 pt-0 pb-2 mt-1">
                <div class="table-responsive p-0 px-4">
                    <table class="table align-items-center mb-0 w-100 table-hover table-striped">
                        <thead class="bg-light">
                            <tr>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">#</th>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Ngày</th>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2 text-center">Giờ</th>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Mã NV</th>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Họ &amp; Tên</th>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Bộ Phận / Chuyền / Nhóm</th>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Lớp</th>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Nội dung buổi</th>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2">Địa điểm</th>
                                <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-9 px-2 text-center">Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody id="teamTableBody">
                            <tr><td colspan="10" class="text-center text-muted py-4">Đang tải...</td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="px-4 mt-3 mb-2">
                    <div id="paginationCount" class="text-sm text-secondary"></div>
                </div>
            </div>
        </div>
    }
</div>

@if (hasScope)
{
@section Scripts {
    <script>
    const API_URL = '@Url.Action("GetTeamSchedule", "Training")';
    let allRows = [];

    function escHtml(s) {
        if (s == null) return '';
        return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    }

    function fmtDate(iso) {
        try { const d = new Date(iso); return d.toLocaleDateString('vi-VN'); } catch { return iso; }
    }

    function fmtTime(hhmm) {
        if (!hhmm || hhmm.length !== 4) return hhmm || '';
        return hhmm.substring(0,2) + ':' + hhmm.substring(2,4);
    }

    function statusLabel(s) {
        switch (s) {
            case 'UPCOMING':  return 'Sắp diễn ra';
            case 'ONGOING':   return 'Đang diễn ra';
            case 'COMPLETED': return 'Đã xong';
            case 'CANCELLED': return 'Đã huỷ';
            default:          return s || '';
        }
    }

    function buildRow(item, idx) {
        const time = `<span class="badge badge-time"><i class="bi bi-clock me-1"></i>${fmtTime(item.START_TIME)} - ${fmtTime(item.END_TIME)}</span>`;
        const dept = [item.DEPT_NAME, item.LINE_NAME, item.WORK_NAME].filter(x => x).join(' / ');
        const group = item.GROUP_NAME ? `<span class="badge badge-group ms-1">${escHtml(item.GROUP_NAME)}</span>` : '';
        const stCls = `badge-status-${item.SESSION_STATUS || 'UPCOMING'}`;
        return `<tr>
            <td class="px-2 text-xs text-secondary">${idx}</td>
            <td class="px-2 text-sm">${fmtDate(item.SESSION_DATE)}</td>
            <td class="px-2 text-sm text-center">${time}</td>
            <td class="px-2 text-sm">${escHtml(item.EMPCD)}</td>
            <td class="px-2 text-sm emp-name vni-font" style="text-transform:uppercase;">${escHtml(item.EMP_NAME || '')}</td>
            <td class="px-2 text-xs text-secondary">${escHtml(dept)}</td>
            <td class="px-2 text-sm">
                <div class="fw-bold">${escHtml(item.CLASS_NAME)}${group}</div>
                <div class="text-xs text-muted">${escHtml(item.COURSE_TITLE)}</div>
            </td>
            <td class="px-2 text-sm">${escHtml(item.TOPIC || '-')}</td>
            <td class="px-2 text-sm text-muted">${escHtml(item.LOCATION || '-')}</td>
            <td class="px-2 text-center"><span class="badge ${stCls}">${statusLabel(item.SESSION_STATUS)}</span></td>
        </tr>`;
    }

    function render(rows) {
        const body = document.getElementById('teamTableBody');
        if (!rows.length) {
            body.innerHTML = `<tr><td colspan="10" class="text-center text-muted py-4">Không có buổi học nào trong khoảng ngày đã chọn.</td></tr>`;
            document.getElementById('paginationCount').textContent = '0 dòng';
            return;
        }
        body.innerHTML = rows.map((r, i) => buildRow(r, i + 1)).join('');
        document.getElementById('paginationCount').textContent = `${rows.length} dòng`;
    }

    function updateSummary(rows) {
        document.getElementById('summaryTotal').textContent    = rows.length;
        document.getElementById('summaryStudents').textContent = new Set(rows.map(r => r.EMPCD)).size;
        document.getElementById('summaryClasses').textContent  = new Set(rows.map(r => r.CLASS_ID)).size;
        const today = new Date().toISOString().substring(0, 10);
        document.getElementById('summaryToday').textContent    = rows.filter(r => (r.SESSION_DATE || '').substring(0, 10) === today).length;
    }

    function applyFilter() {
        const q = (document.getElementById('searchInput').value || '').toUpperCase().trim();
        if (!q) { render(allRows); return; }
        const filtered = allRows.filter(r => {
            const hay = [r.EMPCD, r.EMP_NAME, r.DEPT_NAME, r.LINE_NAME, r.WORK_NAME,
                         r.CLASS_NAME, r.COURSE_TITLE, r.TOPIC, r.LOCATION, r.GROUP_NAME]
                        .filter(x => x).join(' ').toUpperCase();
            return hay.includes(q);
        });
        render(filtered);
    }

    async function load() {
        const from   = document.getElementById('filterFrom').value;
        const to     = document.getElementById('filterTo').value;
        const status = document.getElementById('filterStatus').value;
        const q = new URLSearchParams({ from, to, status }).toString();
        const body = document.getElementById('teamTableBody');
        body.innerHTML = `<tr><td colspan="10" class="text-center text-muted py-4">Đang tải...</td></tr>`;
        try {
            const res = await fetch(`${API_URL}?${q}`, { headers: { 'Accept': 'application/json' } });
            const json = await res.json();
            allRows = (json && json.success) ? (json.data || []) : [];
            updateSummary(allRows);
            applyFilter();
        } catch (e) {
            body.innerHTML = `<tr><td colspan="10" class="text-center text-danger py-4">Lỗi tải dữ liệu: ${escHtml(e.message)}</td></tr>`;
        }
    }

    function exportExcel() {
        // Copy data sang clipboard TSV (đơn giản v1 — HR paste vào Excel).
        const rows = Array.from(document.querySelectorAll('#teamTableBody tr'));
        const header = ['#','Ngày','Giờ','Mã NV','Họ & Tên','Bộ phận / Chuyền / Nhóm','Lớp','Nội dung','Địa điểm','Trạng thái'];
        const lines = [header.join('\t')];
        for (const tr of rows) {
            const tds = tr.querySelectorAll('td');
            if (tds.length !== 10) continue;
            lines.push(Array.from(tds).map(td => td.innerText.replace(/\t/g,' ').replace(/\n/g,' | ')).join('\t'));
        }
        navigator.clipboard.writeText(lines.join('\n'))
            .then(() => alert('Đã copy dữ liệu — paste vào Excel (Ctrl+V).'))
            .catch(() => alert('Không copy được — dùng browser hỗ trợ clipboard API.'));
    }

    document.addEventListener('DOMContentLoaded', () => {
        document.getElementById('reloadBtn').addEventListener('click', load);
        document.getElementById('filterFrom').addEventListener('change', load);
        document.getElementById('filterTo').addEventListener('change', load);
        document.getElementById('filterStatus').addEventListener('change', load);
        document.getElementById('searchInput').addEventListener('input', applyFilter);
        document.getElementById('exportExcelBtn').addEventListener('click', exportExcel);
        load();
    });
    </script>
}
}
