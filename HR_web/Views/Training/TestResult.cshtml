@{
    ViewData["Title"] = "Kết quả bài thi";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var empCd = ViewBag.EmpCd as string;
    var testId = ViewBag.TestId;
}

<div class="container-fluid py-4">
    <div class="card my-4">
        @await Html.PartialAsync("_TrainingPageHeader", new TrainingPageHeaderVM
        {
            Title = "Kết quả bài thi",
            Icon = "bi-clipboard-check",
            Gradient = "primary",
        })
        <div class="card-body">
            <div class="row">
                <div class="col-12 col-md-8 col-lg-6 mx-auto">
                    <div id="result-card">
                        <div class="text-center p-5">
                            <div class="spinner-border text-primary" role="status"></div>
                            <p class="mt-2 text-muted mb-0">Đang tải kết quả bài thi của bạn...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.TRAINING_URLS = {
            getTestResult: '@Url.Action("GetTestResult", "Training")',
            getClassDetail: '@Url.Action("ClassDetail", "Training", new { id = "__ID__" })'
        };
        const empCd = '@empCd';
        const testId = @testId;

        document.addEventListener('DOMContentLoaded', function () {
            loadTestResult();
        });

        function escapeHtml(s) {
            const div = document.createElement('div');
            div.textContent = s;
            return div.innerHTML;
        }

        function loadTestResult() {
            const wrap = document.getElementById('result-card');
            fetch(`${window.TRAINING_URLS.getTestResult}?id=${testId}&empcd=${empCd}`)
                .then(r => r.json())
                .then(res => {
                    if (res.status === 403) {
                        wrap.innerHTML = `<div class="p-4 text-center text-danger">Bạn không có quyền truy cập kết quả bài thi này!</div>`;
                        return;
                    }
                    if (!res.success) {
                        wrap.innerHTML = `<div class="p-4 text-center text-warning">${res.message || 'Lỗi tải kết quả.'}</div>`;
                        return;
                    }

                    const data = res.data || {};
                    const att = data.att || data.ATTEMPT || data.attempt || {}; // Handle property names
                    const passFailStr = data.pass_FAIL || data.PASS_FAIL || data.passFail || data.pass_fail || '';
                    const passFail = passFailStr.toUpperCase();

                    const isGradedVal = att.IS_GRADED ?? att.isGraded ?? att.is_graded;
                    const isGraded = isGradedVal === 1 || isGradedVal === true;

                    let statusClass = 'text-warning';
                    let statusLabel = 'Đang chờ chấm điểm tự luận';
                    let icon = 'bi-hourglass-split';
                    let iconColor = 'text-warning';
                    let iconBg = 'bg-warning-subtle';

                    if (isGraded) {
                        if (passFail === 'PASS') {
                            statusClass = 'text-success';
                            statusLabel = 'ĐẠT BÀI THI';
                            icon = 'bi-check-circle';
                            iconColor = 'text-success';
                            iconBg = 'bg-success-subtle';
                        } else if (passFail === 'FAIL') {
                            statusClass = 'text-danger';
                            statusLabel = 'KHÔNG ĐẠT';
                            icon = 'bi-x-circle';
                            iconColor = 'text-danger';
                            iconBg = 'bg-danger-subtle';
                        } else {
                            statusClass = 'text-success';
                            statusLabel = 'HOÀN THÀNH';
                            icon = 'bi-check-circle';
                            iconColor = 'text-success';
                            iconBg = 'bg-success-subtle';
                        }
                    }

                    const submitDtVal = att.SUBMIT_DT || att.submitDt || att.submit_dt;
                    const submitDate = submitDtVal ? new Date(submitDtVal).toLocaleString('vi-VN') : '-';
                    const score = (att.SCORE !== null && att.SCORE !== undefined) ? att.SCORE : ((att.score !== null && att.score !== undefined) ? att.score : '-');
                    const maxScore = (att.MAX_SCORE !== null && att.MAX_SCORE !== undefined) ? att.MAX_SCORE : ((att.maxScore !== null && att.maxScore !== undefined) ? att.maxScore : '-');
                    // Chưa chấm xong tự luận → không hiện điểm số (điểm hiện tại chưa tính phần tự luận, dễ gây hiểu lầm).
                    const scoreDisplay = isGraded ? `${score} / ${maxScore} điểm` : 'Chưa chấm điểm';
                    const empcdVal = att.EMPCD || att.empcd || '';

                    // Câu tự luận của chính mình: đề + bài làm + điểm & nhận xét GV (nếu đã chấm).
                    // API chỉ trả câu TEXT — không có đáp án đúng nên không vi phạm quy chế.
                    const essays = data.ESSAYS || data.essays || [];
                    let essayHtml = '';
                    if (essays.length > 0) {
                        essayHtml = `
                            <div class="text-start mb-4">
                                <h6 class="fw-bold text-dark mb-3">Phần tự luận (${essays.length} câu)</h6>
                                ${essays.map((e, i) => {
                                    const graded = e.POINTS_AWARDED !== null && e.POINTS_AWARDED !== undefined;
                                    const badge = graded
                                        ? `<span class="badge bg-primary text-nowrap">${e.POINTS_AWARDED} / ${e.QUESTION_POINTS} điểm</span>`
                                        : `<span class="badge bg-warning text-dark text-nowrap">Chờ chấm</span>`;
                                    return `
                                    <div class="card border p-3 mb-2" style="border-radius: 12px;">
                                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                            <span class="fw-bold text-dark small">Câu ${i + 1}: ${escapeHtml(e.QUESTION_TEXT || '')}</span>
                                            ${badge}
                                        </div>
                                        <div class="small text-muted mb-1">Bài làm của bạn:</div>
                                        <div class="small text-dark bg-light rounded p-2 ${e.GRADER_COMMENT ? 'mb-2' : 'mb-0'}" style="white-space: pre-wrap;">${escapeHtml(e.ANSWER_TEXT || '(bỏ trống)')}</div>
                                        ${e.GRADER_COMMENT ? `<div class="small"><span class="text-muted">Nhận xét của giáo viên:</span> <span class="fst-italic text-dark">${escapeHtml(e.GRADER_COMMENT)}</span></div>` : ''}
                                    </div>`;
                                }).join('')}
                            </div>`;
                    }

                    wrap.innerHTML = `
                        <div class="text-center p-5">
                            <div class="mb-4">
                                <div class="rounded-circle ${iconBg} d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                                    <i class="bi ${icon} ${iconColor}" style="font-size: 3.5rem;"></i>
                                </div>
                            </div>

                            <h4 class="fw-bold text-dark mb-1">Kết quả bài kiểm tra</h4>
                            <h3 class="fw-bold ${statusClass} mt-2 mb-4">${statusLabel}</h3>

                            <div class="card border-0 p-4 mb-4" style="border-radius: 16px; background-color: #f8f9fa;">
                                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                                    <span class="text-muted">Mã nhân viên:</span>
                                    <span class="fw-bold text-dark">${empcdVal}</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                                    <span class="text-muted">Trạng thái chấm:</span>
                                    <span class="fw-bold text-dark">${isGraded ? 'Đã chấm xong' : 'Chưa chấm tự luận'}</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                                    <span class="text-muted">Thời gian nộp:</span>
                                    <span class="fw-bold text-dark">${submitDate}</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-muted">Điểm số:</span>
                                    <span class="fs-4 fw-bold ${isGraded ? 'text-primary' : 'text-warning'}">${scoreDisplay}</span>
                                </div>
                            </div>

                            ${essayHtml}

                            <p class="small text-muted mb-0">Theo quy chế bảo mật đào tạo của công ty, đáp án đúng của các câu hỏi sẽ không được hiển thị.</p>
                        </div>
                    `;
                })
                .catch(err => {
                    wrap.innerHTML = `<div class="p-4 text-center text-danger">Lỗi kết nối: ${err.message}</div>`;
                });
        }
    </script>
}
