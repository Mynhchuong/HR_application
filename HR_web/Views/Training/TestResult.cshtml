@{
    ViewData["Title"] = "Kết quả bài thi";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var empCd = ViewBag.EmpCd as string;
    var testId = ViewBag.TestId;
}

<div class="container-fluid py-4" style="font-family: 'Outfit', sans-serif;">
    <!-- Back to Class Detail -->
    <div class="mb-4">
        <a id="back-link" href="#" class="text-decoration-none text-muted d-inline-flex align-items-center gap-1 small fw-bold">
            <span class="material-symbols-rounded" style="font-size: 1.1rem;">arrow_back</span>
            Trở lại chi tiết lớp học
        </a>
    </div>

    <div class="row">
        <div class="col-12 col-md-8 col-lg-6 mx-auto">
            <div class="card border-0 shadow-sm overflow-hidden" style="border-radius: 20px;" id="result-card">
                <div class="card-body text-center p-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 text-muted mb-0">Đang tải kết quả bài thi của bạn...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.TRAINING_URLS = {
            getTestResult: '@Url.Action("GetTestResult", "Training")',
            getClassDetail: '@Url.Action("ClassDetail", "Training", new { id = "__ID__" })'
        };
        const empCd = '@empCd';
        const testId = @testId;

        document.addEventListener('DOMContentLoaded', function () {
            loadTestResult();
        });

        function loadTestResult() {
            const wrap = document.getElementById('result-card');
            fetch(`${window.TRAINING_URLS.getTestResult}?id=${testId}&empcd=${empCd}`)
                .then(r => r.json())
                .then(res => {
                    if (res.status === 403) {
                        wrap.innerHTML = `<div class="card-body p-4 text-center text-danger">Bạn không có quyền truy cập kết quả bài thi này!</div>`;
                        return;
                    }
                    if (!res.success) {
                        wrap.innerHTML = `<div class="card-body p-4 text-center text-warning">${res.message || 'Lỗi tải kết quả.'}</div>`;
                        return;
                    }

                    const data = res.data || {};
                    const att = data.att || data.ATTEMPT || data.attempt || {}; // Handle property names
                    const passFailStr = data.pass_FAIL || data.PASS_FAIL || data.passFail || data.pass_fail || '';
                    const passFail = passFailStr.toUpperCase();
                    
                    const isGradedVal = att.IS_GRADED ?? att.isGraded ?? att.is_graded;
                    const isGraded = isGradedVal === 1 || isGradedVal === true;

                    // Set back link to Class Detail if test has class id
                    const classIdVal = att.CLASS_ID || att.classId || att.class_id;
                    if (classIdVal) {
                        document.getElementById('back-link').href = window.TRAINING_URLS.getClassDetail.replace('__ID__', classIdVal);
                    } else {
                        document.getElementById('back-link').href = '@Url.Action("MyClasses", "Training")';
                    }

                    let statusClass = 'text-warning';
                    let statusLabel = 'Đang chờ chấm điểm tự luận';
                    let icon = 'pending';
                    let iconColor = 'text-warning';
                    let iconBg = 'bg-warning-soft';

                    if (isGraded) {
                        if (passFail === 'PASS') {
                            statusClass = 'text-success';
                            statusLabel = 'ĐẠT KHOÁ HỌC';
                            icon = 'check_circle';
                            iconColor = 'text-success';
                            iconBg = 'bg-success-soft';
                        } else {
                            statusClass = 'text-danger';
                            statusLabel = 'KHÔNG ĐẠT';
                            icon = 'cancel';
                            iconColor = 'text-danger';
                            iconBg = 'bg-danger-soft';
                        }
                    }

                    const submitDtVal = att.SUBMIT_DT || att.submitDt || att.submit_dt;
                    const submitDate = submitDtVal ? new Date(submitDtVal).toLocaleString('vi-VN') : '-';
                    const score = (att.SCORE !== null && att.SCORE !== undefined) ? att.SCORE : ((att.score !== null && att.score !== undefined) ? att.score : '-');
                    const maxScore = (att.MAX_SCORE !== null && att.MAX_SCORE !== undefined) ? att.MAX_SCORE : ((att.maxScore !== null && att.maxScore !== undefined) ? att.maxScore : '-');
                    const empcdVal = att.EMPCD || att.empcd || '';

                    wrap.innerHTML = `
                        <div class="card-body text-center p-5">
                            <div class="mb-4">
                                <div class="rounded-circle ${iconBg} d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                                    <span class="material-symbols-rounded ${iconColor}" style="font-size: 3.5rem;">${icon}</span>
                                </div>
                            </div>
                            
                            <h4 class="fw-bold text-dark mb-1">Kết quả bài kiểm tra</h4>
                            <h3 class="fw-bold ${statusClass} mt-2 mb-4">${statusLabel}</h3>

                            <div class="card border-0 p-4 mb-4" style="border-radius: 16px; background-color: #f8f9fa;">
                                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                                    <span class="text-muted">Mã nhân viên:</span>
                                    <span class="fw-bold text-dark">${empcdVal}</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                                    <span class="text-muted">Trạng thái chấm:</span>
                                    <span class="fw-bold text-dark">${isGraded ? 'Đã chấm xong' : 'Chưa chấm tự luận'}</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                                    <span class="text-muted">Thời gian nộp:</span>
                                    <span class="fw-bold text-dark">${submitDate}</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-muted">Điểm số:</span>
                                    <span class="fs-4 fw-bold text-primary">${score} / ${maxScore} điểm</span>
                                </div>
                            </div>
                            
                            <p class="small text-muted mb-0">Theo quy chế bảo mật đào tạo của công ty, đáp án chi tiết các câu hỏi sẽ không được hiển thị.</p>
                        </div>
                    `;
                })
                .catch(err => {
                    wrap.innerHTML = `<div class="card-body p-4 text-center text-danger">Lỗi kết nối: ${err.message}</div>`;
                });
        }
    </script>
}

<style>
    .bg-success-soft { background-color: #d1e7dd; }
    .bg-danger-soft { background-color: #f8d7da; }
    .bg-warning-soft { background-color: #fff3cd; }
</style>
