@{
    ViewData["Title"] = "Điểm danh tổng hợp";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var classId = ViewBag.ClassId;
    var empCd = ViewBag.EmpCd as string;
}

<div class="container-fluid py-4" style="font-family: 'Outfit', sans-serif;">
    <div class="mb-3">
        <a href="@Url.Action("ClassAssign", "TrainingAdmin", new { id = ViewBag.ClassId })" class="text-decoration-none text-muted d-inline-flex align-items-center gap-1 small fw-bold">
            <span class="material-symbols-rounded" style="font-size: 1.1rem;">arrow_back</span>
            Trở lại quản trị lớp
        </a>
    </div>
    <!-- Breadcrumbs -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "TrainingAdmin")" class="text-decoration-none">Cổng quản trị</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("ClassAssign", "TrainingAdmin", new { id = classId })" class="text-decoration-none">Chi tiết lớp học</a></li>
            <li class="breadcrumb-item active" aria-current="page">Báo cáo chuyên cần</li>
        </ol>
    </nav>

    <!-- Matrix Card -->
    <div class="card border-0 shadow-sm p-4" style="border-radius: 16px;">
        <div id="attendance-report-container">
            <div class="text-center py-5">
                <div class="spinner-border text-success" role="status"></div>
                <p class="mt-2 text-muted mb-0">Đang tải dữ liệu điểm danh...</p>
            </div>
        </div>
    </div>
</div>

<style>
    .matrix-cell-P { background-color: #d1e7dd; color: #0f5132; }
    .matrix-cell-L { background-color: #fff3cd; color: #664d03; }
    .matrix-cell-A { background-color: #f8d7da; color: #842029; }
    .matrix-cell-E { background-color: #e2e3e5; color: #41464b; }
    .matrix-cell-em { background-color: #f8f9fa; color: #adb5bd; }
    .table-head-sticky th {
        position: sticky;
        top: 0;
        background-color: #f8f9fa;
        z-index: 100;
        box-shadow: inset 0 -2px 0 #dee2e6;
    }
</style>

@section Scripts {
    <script>
        window.TRAINING_URLS = {
            getReportAttendance: '@Url.Action("GetReportAttendance", "TrainingAdmin")',
            expAttend: '@Url.Action("ExportAttendance", "TrainingAdmin")'
        };

        const CLASS_ID = @classId;

        document.addEventListener('DOMContentLoaded', () => {
            loadAttendanceReport();
        });

        async function loadAttendanceReport() {
            const wrap = document.getElementById('attendance-report-container');
            const res = await fetch(`${window.TRAINING_URLS.getReportAttendance}?classId=${CLASS_ID}`);
            const json = await res.json();
            
            if (!json.success || !json.data || !json.data.STUDENTS) {
                wrap.innerHTML = `
                    <div class="alert alert-warning text-center border-0 py-4 shadow-sm" style="border-radius: 12px;">
                        <span class="material-symbols-rounded text-warning mb-2" style="font-size: 2.5rem;">warning</span>
                        <p class="mb-0 text-dark fw-bold">Không tìm thấy dữ liệu điểm danh của lớp học này.</p>
                    </div>
                `;
                return;
            }

            const d = json.data;
            const cellCls = { PRESENT: 'matrix-cell-P', LATE: 'matrix-cell-L', ABSENT: 'matrix-cell-A', EXCUSED: 'matrix-cell-E' };
            const cellLbl = { PRESENT: '✓', LATE: 'L', ABSENT: '✗', EXCUSED: 'E' };

            const html = `
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                    <div>
                        <h4 class="fw-bold mb-0 text-dark">Ma trận điểm danh chuyên cần</h4>
                        <span class="text-muted small">Quy mô: ${d.STUDENTS.length} học viên × ${d.SESSIONS.length} buổi học</span>
                    </div>
                    <a href="${window.TRAINING_URLS.expAttend}?classId=${CLASS_ID}" class="btn btn-success fw-bold shadow-sm d-flex align-items-center gap-1 px-3">
                        <span class="material-symbols-rounded" style="font-size: 1.2rem;">download</span> Xuất Excel
                    </a>
                </div>

                <div class="alert alert-light border p-3 mb-3" style="border-radius: 12px;">
                    <span class="small text-muted fw-bold d-block mb-1">Chú giải ký hiệu:</span>
                    <span class="badge bg-success-soft text-success me-2">✓ Có mặt (P)</span>
                    <span class="badge bg-warning-soft text-warning me-2">L Đi học muộn (L)</span>
                    <span class="badge bg-danger-soft text-danger me-2">✗ Vắng mặt (A)</span>
                    <span class="badge bg-secondary-soft text-secondary me-2">E Vắng có phép (E)</span>
                    <span class="badge bg-light text-muted border">· Không xếp lịch</span>
                </div>

                <div class="table-responsive" style="max-height: 70vh; border-radius: 12px; border: 1px solid #dee2e6;">
                    <table class="table table-sm table-bordered align-middle mb-0 text-nowrap" style="font-size: .8rem;">
                        <thead class="table-head-sticky bg-light">
                            <tr>
                                <th class="ps-3" style="min-width: 100px;">Mã NV</th>
                                <th style="min-width: 150px;">Họ và Tên</th>
                                <th style="min-width: 90px;">Tổ/Nhóm</th>
                                <th style="min-width: 80px;">Điểm danh %</th>
                                ${d.SESSIONS.map(s => `<th class="text-center" style="min-width: 90px;">
                                    Buổi ${s.SESSION_NO}<br>
                                    <small class="text-muted">${new Date(s.SESSION_DATE).toLocaleDateString('vi-VN')}</small>
                                    ${s.GROUP_NAME ? `<br><span class="badge bg-warning text-dark px-1.5 py-0.5" style="font-size: 0.65rem;">${esc(s.GROUP_NAME)}</span>` : ''}
                                </th>`).join('')}
                            </tr>
                        </thead>
                        <tbody>
                            ${d.STUDENTS.map(st => `<tr>
                                <td class="ps-3 fw-bold text-dark">${esc(st.EMPCD)}</td>
                                <td class="fw-bold vni-font" style="text-transform:uppercase;">${esc(st.EMP_NAME || '')}</td>
                                <td><span class="badge bg-light text-dark border">${esc(st.GROUP_NAME || '-')}</span></td>
                                <td><strong class="text-primary">${st.ATTENDANCE_PERCENT.toFixed(1)}%</strong></td>
                                ${d.SESSIONS.map(s => {
                                    const v = st.STATUS_PER_SESSION[s.SESSION_ID] || '';
                                    if (v === '') return `<td class="matrix-cell-em text-center text-muted">·</td>`;
                                    return `<td class="${cellCls[v] || ''} text-center"><strong>${cellLbl[v] || v}</strong></td>`;
                                }).join('')}
                            </tr>`).join('')}
                        </tbody>
                    </table>
                </div>
            `;

            wrap.innerHTML = html;
        }

        function esc(s) {
            if (s == null) return '';
            return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
        }
    </script>
}
