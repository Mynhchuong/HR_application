@{
    ViewData["Title"] = "Quản lý Chứng chỉ";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var empCd = ViewBag.EmpCd as string;
}

<div class="container-fluid py-4">
    @await Html.PartialAsync("_TrainingHeroBanner", new TrainingHeroBannerVM
    {
        Title = "Quản lý Chứng chỉ Đào tạo",
        Subtitle = "Xem danh sách chứng chỉ đào tạo đã cấp, tìm kiếm theo nhân viên, phòng ban và thực hiện thu hồi khi cần thiết.",
        Gradient = "warning",
        IllustrationImg = "~/assets/img/illustrations/guarated.png",
    })

    <style>
        /* Tên khóa học / lớp học có thể rất dài — cho phép xuống 2 hàng thay vì tràn ngang 1 hàng
           (table cha có text-nowrap nên phải override lại white-space ở đây) */
        .cert-wrap-cell {
            white-space: normal !important;
            max-width: 220px;
            line-height: 1.3;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        /* Cột Học viên: tên NV thường ngắn (giữ 1 hàng), nhưng dòng org (dept/line/work) có thể
           dài — bọc riêng dòng đó để không kéo giãn cả bảng ra quá khổ. */
        .cert-org-line {
            white-space: normal !important;
            max-width: 260px;
        }
    </style>

    <!-- Filters Section -->
    <div class="card filter-bar border-0 shadow-sm p-4 mb-4" style="border-radius: 16px;">
        <h5 class="fw-bold text-dark mb-3">Bộ lọc tìm kiếm</h5>
        <div class="row g-3">
            <div class="col-6 col-lg-2">
                <label class="form-label small fw-bold text-muted">Chọn khóa học</label>
                <select id="filter-course" class="form-select" onchange="onCourseChanged()" style="border-radius: 8px;">
                    <option value="">-- Tất cả khóa học --</option>
                </select>
            </div>
            <div class="col-6 col-lg-2">
                <label class="form-label small fw-bold text-muted">Chọn lớp học</label>
                <select id="filter-class" class="form-select" style="border-radius: 8px;">
                    <option value="">-- Tất cả các lớp --</option>
                </select>
            </div>
            <div class="col-6 col-lg-2">
                <label class="form-label small fw-bold text-muted">Bộ phận (Dept)</label>
                <select id="filter-dept" class="form-select" onchange="onDeptChanged()" style="border-radius: 8px;">
                    <option value="">-- Tất cả bộ phận --</option>
                </select>
            </div>
            <div class="col-6 col-lg-2">
                <label class="form-label small fw-bold text-muted">Chuyền (Line)</label>
                <select id="filter-line" class="form-select" style="border-radius: 8px;">
                    <option value="">-- Tất cả chuyền --</option>
                </select>
            </div>
            <div class="col-6 col-lg-2">
                <label class="form-label small fw-bold text-muted">Nhập Mã số NV</label>
                <input type="text" id="filter-empcd" class="form-control" placeholder="Mã nhân viên..." style="border-radius: 8px;" />
            </div>
            <div class="col-6 col-lg-2 d-flex align-items-end">
                <button onclick="loadCertificates(1)" class="btn btn-success w-100 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-1" style="height: 38px; border-radius: 8px;">
                    <i class="bi bi-search" style="font-size: 1.1rem;"></i> Lọc dữ liệu
                </button>
            </div>
        </div>
    </div>

    <!-- Certificates Table -->
    <div class="card border-0 shadow-sm p-4" style="border-radius: 16px;">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <h5 class="fw-bold mb-0 text-dark">Chứng chỉ đã cấp</h5>
            <button onclick="exportCertificates()" class="btn btn-outline-success btn-sm fw-bold d-flex align-items-center gap-1">
                <i class="bi bi-download" style="font-size: 1.1rem;"></i> Xuất Excel
            </button>
        </div>

        <div class="table-responsive bg-light p-2 rounded-3">
            <table class="table table-hover align-middle mb-0 bg-white rounded shadow-sm text-nowrap">
                <thead>
                    <tr class="text-muted small">
                        <th class="ps-3" data-mobile="primary" data-mobile-slot="name" data-mobile-label="Học viên">Học viên</th>
                        <th data-mobile="primary" data-mobile-label="Khóa học">Khóa học</th>
                        <th data-mobile="detail" data-mobile-label="Lớp học">Lớp học</th>
                        <th data-mobile="detail" data-mobile-label="Ngày hoàn thành">Ngày hoàn thành</th>
                        <th data-mobile="primary" data-mobile-label="Điểm thi cuối kỳ">Điểm thi cuối kỳ</th>
                        <th data-mobile="detail" data-mobile-label="Chuyên cần">Chuyên cần</th>
                        <th class="pe-3 text-end" data-mobile="detail" data-mobile-label="Hành động">Hành động</th>
                    </tr>
                </thead>
                <tbody id="certificates-tbody">
                    <tr>
                        <td colspan="7" class="text-center text-muted py-5">
                            <div class="spinner-border text-success spinner-border-sm" role="status"></div>
                            <span class="ms-2">Đang tải dữ liệu...</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="d-flex justify-content-between align-items-center px-1 pt-3">
            <div id="cert-pagination-count" class="text-sm text-secondary"></div>
            <nav><ul class="pagination pagination-sm mb-0" id="cert-pagination-bar"></ul></nav>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.TRAINING_URLS = {
            getClassList: '@Url.Action("GetClassList", "TrainingAdmin")',
            getCourses: '@Url.Action("GetCourses", "TrainingAdmin")',
            getCertificateList: '@Url.Action("GetCertificateList", "TrainingAdmin")',
            revokeCertificate: '@Url.Action("RevokeCertificate", "TrainingAdmin")',
            getDept: '@Url.Action("GetDept", "Dropdown")',
            getLine: '@Url.Action("GetLine", "Dropdown")'
        };

        const currentLoginUser = '@empCd';
        let deptList = [];
        let certList = [];
        let certPage = 1, certPageSize = 50, certTotal = 0, certTotalPages = 0;

        document.addEventListener('DOMContentLoaded', () => {
            loadFilterOptions();
            loadCertificates(1);
            MobileTableHelper.init('certificates-tbody');
        });

        function loadFilterOptions() {
            // Load Courses
            fetch(window.TRAINING_URLS.getCourses)
                .then(r => r.json())
                .then(res => {
                    const select = document.getElementById('filter-course');
                    (res.data || []).forEach(c => {
                        select.innerHTML += `<option value="${c.ID}">${c.TITLE}</option>`;
                    });
                });

            // Load Classes
            fetch(`${window.TRAINING_URLS.getClassList}`)
                .then(r => r.json())
                .then(res => {
                    const select = document.getElementById('filter-class');
                    (res.data || []).forEach(c => {
                        select.innerHTML += `<option value="${c.ID}">${c.CLASS_NAME}</option>`;
                    });
                });

            // Load Depts
            fetch(window.TRAINING_URLS.getDept)
                .then(r => r.json())
                .then(res => {
                    const select = document.getElementById('filter-dept');
                    res.forEach(d => {
                        select.innerHTML += `<option value="${d.id}">${d.id} - ${d.text}</option>`;
                    });
                });
        }

        // Chọn khóa học → thu hẹp dropdown Lớp học chỉ còn lớp thuộc khóa đó (courseId truyền
        // thẳng cho loadCertificates() để lọc được cả khi chưa chọn lớp cụ thể).
        function onCourseChanged() {
            const courseId = document.getElementById('filter-course').value;
            const classSelect = document.getElementById('filter-class');
            classSelect.innerHTML = '<option value="">-- Tất cả các lớp --</option>';

            const qs = courseId ? `?courseId=${courseId}` : '';
            fetch(`${window.TRAINING_URLS.getClassList}${qs}`)
                .then(r => r.json())
                .then(res => {
                    (res.data || []).forEach(c => {
                        classSelect.innerHTML += `<option value="${c.ID}">${c.CLASS_NAME}</option>`;
                    });
                });
        }

        function onDeptChanged() {
            const deptCd = document.getElementById('filter-dept').value;
            const lineSelect = document.getElementById('filter-line');
            lineSelect.innerHTML = '<option value="">-- Tất cả chuyền --</option>';
            
            if (!deptCd) return;

            fetch(`${window.TRAINING_URLS.getLine}?deptCd=${encodeURIComponent(deptCd)}`)
                .then(r => r.json())
                .then(res => {
                    res.forEach(l => {
                        lineSelect.innerHTML += `<option value="${l.id}">${l.text}</option>`;
                    });
                });
        }

        function certFilterParams() {
            const courseId = document.getElementById('filter-course').value;
            const classId = document.getElementById('filter-class').value;
            const deptcd = document.getElementById('filter-dept').value;
            const linecd = document.getElementById('filter-line').value;
            const empcd = document.getElementById('filter-empcd').value.trim();

            let qs = '';
            if (courseId) qs += `&courseId=${courseId}`;
            if (classId) qs += `&classId=${classId}`;
            if (deptcd) qs += `&deptcd=${encodeURIComponent(deptcd)}`;
            if (linecd) qs += `&linecd=${encodeURIComponent(linecd)}`;
            if (empcd) qs += `&empcd=${encodeURIComponent(empcd)}`;
            return qs;
        }

        function loadCertificates(page = 1) {
            certPage = page;
            const tbody = document.getElementById('certificates-tbody');
            tbody.innerHTML = `
                <tr>
                    <td colspan="7" class="text-center text-muted py-5">
                        <div class="spinner-border text-success spinner-border-sm" role="status"></div>
                        <span class="ms-2">Đang tải...</span>
                    </td>
                </tr>
            `;

            const qs = certFilterParams() + `&page=${page}&page_size=${certPageSize}`;

            fetch(`${window.TRAINING_URLS.getCertificateList}?${qs}`)
                .then(r => r.json())
                .then(res => {
                    if (!res.success || !res.data) {
                        tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-4">Không tìm thấy chứng chỉ nào.</td></tr>';
                        certTotal = 0; certTotalPages = 0;
                        renderCertPagination();
                        return;
                    }

                    const list = res.data;
                    certList = list;
                    certTotal = res.total || 0;
                    certTotalPages = res.total_pages || 0;
                    if (list.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-4">Không tìm thấy chứng chỉ nào.</td></tr>';
                        renderCertPagination();
                        return;
                    }

                    tbody.innerHTML = '';
                    list.forEach(c => {
                        const dateStr = c.COMPLETION_DATE ? new Date(c.COMPLETION_DATE).toLocaleDateString('vi-VN') : '-';
                        const scoreStr = c.FINAL_SCORE !== null ? `${c.FINAL_SCORE}${c.MAX_SCORE != null ? ' / ' + c.MAX_SCORE : ''}` : '-';
                        const attendStr = c.ATTENDANCE_PERCENT !== null ? `${c.ATTENDANCE_PERCENT.toFixed(1)}%` : '-';
                        const orgLine = [c.DEPT_NAME, c.LINE_NAME, c.WORK_NAME].filter(Boolean).join(' / ') || '-';

                        tbody.innerHTML += `
                            <tr>
                                <td class="ps-3">
                                    <div class="fw-bold vni-font text-dark" style="text-transform:uppercase;">${c.EMP_NAME || 'Nhân viên'}</div>
                                    <div class="text-muted cert-org-line" style="font-size:.7rem;">#${c.EMPCD} · ${orgLine}</div>
                                </td>
                                <td><div class="cert-wrap-cell" title="${c.COURSE_TITLE}">${c.COURSE_TITLE}</div></td>
                                <td><div class="cert-wrap-cell" title="${c.CLASS_NAME}">${c.CLASS_NAME}</div></td>
                                <td>${dateStr}</td>
                                <td><strong class="text-success">${scoreStr}</strong></td>
                                <td><strong class="text-primary">${attendStr}</strong></td>
                                <td class="pe-3 text-end">
                                    <button onclick="revokeCert(${c.CLASS_ID}, '${c.EMPCD}')" class="btn btn-xs btn-outline-danger fw-bold rounded-2">Thu hồi</button>
                                </td>
                            </tr>
                        `;
                    });
                    renderCertPagination();
                })
                .catch(() => {
                    tbody.innerHTML = '<tr><td colspan="7" class="text-center text-danger py-4">Lỗi kết nối hoặc không có quyền truy cập dữ liệu.</td></tr>';
                })
                .finally(() => {
                    MobileTableHelper.refresh('certificates-tbody');
                });
        }

        function renderCertPagination() {
            const countEl = document.getElementById('cert-pagination-count');
            const barEl = document.getElementById('cert-pagination-bar');
            if (!certTotal) { countEl.textContent = ''; barEl.innerHTML = ''; return; }
            const s = (certPage - 1) * certPageSize + 1, e = Math.min(certPage * certPageSize, certTotal);
            countEl.innerHTML = `<span class="text-xs">${s}-${e} / <strong>${certTotal}</strong> chứng chỉ</span>`;

            const mk = (label, p, disabled, active) => {
                const li = document.createElement('li');
                li.className = 'page-item' + (disabled ? ' disabled' : '') + (active ? ' active' : '');
                const a = document.createElement('a');
                a.className = 'page-link';
                a.style.cursor = 'pointer';
                a.innerHTML = label;
                if (!disabled && !active) a.onclick = () => loadCertificates(p);
                li.appendChild(a);
                return li;
            };

            barEl.innerHTML = '';
            barEl.appendChild(mk('&lsaquo;', certPage - 1, certPage <= 1, false));
            const from = Math.max(1, certPage - 2), to = Math.min(certTotalPages, certPage + 2);
            for (let p = from; p <= to; p++) barEl.appendChild(mk(p, p, false, p === certPage));
            barEl.appendChild(mk('&rsaquo;', certPage + 1, certPage >= certTotalPages, false));
        }

        function revokeCert(classId, empcd) {
            window.showConfirm(`Bạn chắc chắn muốn THU HỒI chứng chỉ của học viên (${empcd}) trong lớp học này?`, () => {
                fetch(window.TRAINING_URLS.revokeCertificate, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ CLASS_ID: classId, EMPCD: empcd })
                })
                .then(r => r.json())
                .then(res => {
                    if (res.success) {
                        window.showToast('Đã thu hồi chứng chỉ thành công!', 'success');
                        loadCertificates(certPage);
                    } else {
                        window.showToast(res.message || 'Lỗi khi thu hồi.', 'error');
                    }
                });
            }, {
                title: 'Thu hồi chứng chỉ',
                okText: 'Thu hồi',
                okClass: 'btn-danger',
                icon: 'workspace_premium',
                iconColor: '#dc2626',
                iconBg: '#fee2e2'
            });
        }

        async function exportCertificates() {
            window.showToast('Đang tải toàn bộ dữ liệu để xuất...', 'info');

            let certExportList = [], pg = 1, pgTotal = 1;
            do {
                const qs = certFilterParams() + `&page=${pg}&page_size=500`;
                const res = await fetch(`${window.TRAINING_URLS.getCertificateList}?${qs}`).then(r => r.json());
                if (!res || !res.success) break;
                pgTotal = res.total_pages || 1;
                certExportList = certExportList.concat(res.data || []);
                pg++;
            } while (pg <= pgTotal);

            if (certExportList.length === 0) {
                window.showToast('Không có dữ liệu để xuất.', 'warning');
                return;
            }
            const esc = v => '"' + String(v ?? '').replace(/"/g, '""') + '"';
            let csvContent = "\uFEFFMã NV,Họ và Tên,Bộ phận/Chuyền/Line,Khóa học,Lớp học,Ngày hoàn thành,Điểm thi cuối kỳ,Chuyên cần\n";
            certExportList.forEach(c => {
                const dateStr = c.COMPLETION_DATE ? new Date(c.COMPLETION_DATE).toLocaleDateString('vi-VN') : '-';
                const scoreStr = c.FINAL_SCORE !== null ? `${c.FINAL_SCORE}${c.MAX_SCORE != null ? ' / ' + c.MAX_SCORE : ''}` : '-';
                const attendStr = c.ATTENDANCE_PERCENT !== null ? `${c.ATTENDANCE_PERCENT.toFixed(1)}%` : '-';
                const orgLine = [c.DEPT_NAME, c.LINE_NAME, c.WORK_NAME].filter(Boolean).join(' / ') || '-';
                csvContent += [
                    esc(c.EMPCD), esc(c.EMP_NAME || 'Nhân viên'), esc(orgLine),
                    esc(c.COURSE_TITLE), esc(c.CLASS_NAME), esc(dateStr), esc(scoreStr), esc(attendStr)
                ].join(',') + '\n';
            });

            const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
            const link = document.createElement("a");
            link.href = URL.createObjectURL(blob);
            link.setAttribute("download", `danh_sach_chung_chi_${new Date().toISOString().slice(0,10)}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    </script>
}
