@{
    ViewData["Title"] = "Quản lý Chứng chỉ";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var empCd = ViewBag.EmpCd as string;
}

<div class="container-fluid py-4" style="font-family: 'Outfit', sans-serif;">
    <!-- Header Banner -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm overflow-hidden" style="border-radius: 20px; background: linear-gradient(135deg, #198754 0%, #157347 100%);">
                <div class="card-body p-4 text-white position-relative">
                    <div class="position-absolute end-0 bottom-0 opacity-10 d-none d-md-block" style="transform: translate(10%, 10%);">
                        <span class="material-symbols-rounded" style="font-size: 15rem;">card_membership</span>
                    </div>
                    <h2 class="fw-bold mb-1">Quản lý Chứng chỉ Đào tạo</h2>
                    <p class="mb-0 opacity-75">Xem danh sách chứng chỉ đào tạo đã cấp, tìm kiếm theo nhân viên, phòng ban và thực hiện thu hồi khi cần thiết.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="card border-0 shadow-sm p-4 mb-4" style="border-radius: 16px;">
        <h5 class="fw-bold text-dark mb-3">Bộ lọc tìm kiếm</h5>
        <div class="row g-3">
            <div class="col-12 col-md-3">
                <label class="form-label small fw-bold text-muted">Chọn lớp học</label>
                <select id="filter-class" class="form-select" style="border-radius: 8px;">
                    <option value="">-- Tất cả các lớp --</option>
                </select>
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label small fw-bold text-muted">Bộ phận (Dept)</label>
                <select id="filter-dept" class="form-select" onchange="onDeptChanged()" style="border-radius: 8px;">
                    <option value="">-- Tất cả bộ phận --</option>
                </select>
            </div>
            <div class="col-12 col-md-2">
                <label class="form-label small fw-bold text-muted">Chuyền (Line)</label>
                <select id="filter-line" class="form-select" style="border-radius: 8px;">
                    <option value="">-- Tất cả chuyền --</option>
                </select>
            </div>
            <div class="col-12 col-md-2">
                <label class="form-label small fw-bold text-muted">Nhập Mã số NV</label>
                <input type="text" id="filter-empcd" class="form-control" placeholder="Mã nhân viên..." style="border-radius: 8px;" />
            </div>
            <div class="col-12 col-md-2 d-flex align-items-end">
                <button onclick="loadCertificates()" class="btn btn-success w-100 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-1" style="height: 38px; border-radius: 8px;">
                    <span class="material-symbols-rounded" style="font-size: 1.1rem;">search</span> Lọc dữ liệu
                </button>
            </div>
        </div>
    </div>

    <!-- Certificates Table -->
    <div class="card border-0 shadow-sm p-4" style="border-radius: 16px;">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <h5 class="fw-bold mb-0 text-dark">Chứng chỉ đã cấp</h5>
            <button onclick="exportCertificates()" class="btn btn-outline-success btn-sm fw-bold d-flex align-items-center gap-1">
                <span class="material-symbols-rounded" style="font-size: 1.1rem;">download</span> Xuất Excel
            </button>
        </div>

        <div class="table-responsive bg-light p-2 rounded-3">
            <table class="table table-hover align-middle mb-0 bg-white rounded shadow-sm text-nowrap">
                <thead>
                    <tr class="text-muted small">
                        <th class="ps-3">Mã NV</th>
                        <th>Họ và Tên</th>
                        <th>Bộ phận</th>
                        <th>Khóa học</th>
                        <th>Lớp học</th>
                        <th>Ngày hoàn thành</th>
                        <th>Điểm thi</th>
                        <th>Chuyên cần</th>
                        <th class="pe-3 text-end">Hành động</th>
                    </tr>
                </thead>
                <tbody id="certificates-tbody">
                    <tr>
                        <td colspan="9" class="text-center text-muted py-5">
                            <div class="spinner-border text-success spinner-border-sm" role="status"></div>
                            <span class="ms-2">Đang tải dữ liệu...</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.TRAINING_URLS = {
            getClassList: '@Url.Action("GetClassList", "TrainingAdmin")',
            getCertificateList: '@Url.Action("GetCertificateList", "TrainingAdmin")',
            revokeCertificate: '@Url.Action("RevokeCertificate", "TrainingAdmin")',
            getDept: '@Url.Action("GetDept", "Dropdown")',
            getLine: '@Url.Action("GetLine", "Dropdown")'
        };

        const currentLoginUser = '@empCd';
        let deptList = [];

        document.addEventListener('DOMContentLoaded', () => {
            loadFilterOptions();
            loadCertificates();
        });

        function loadFilterOptions() {
            // Load Classes
            fetch(`${window.TRAINING_URLS.getClassList}`)
                .then(r => r.json())
                .then(res => {
                    const select = document.getElementById('filter-class');
                    (res.data || []).forEach(c => {
                        select.innerHTML += `<option value="${c.ID}">${c.CLASS_NAME}</option>`;
                    });
                });

            // Load Depts
            fetch(window.TRAINING_URLS.getDept)
                .then(r => r.json())
                .then(res => {
                    const select = document.getElementById('filter-dept');
                    res.forEach(d => {
                        select.innerHTML += `<option value="${d.id}">${d.id} - ${d.text}</option>`;
                    });
                });
        }

        function onDeptChanged() {
            const deptCd = document.getElementById('filter-dept').value;
            const lineSelect = document.getElementById('filter-line');
            lineSelect.innerHTML = '<option value="">-- Tất cả chuyền --</option>';
            
            if (!deptCd) return;

            fetch(`${window.TRAINING_URLS.getLine}?deptCd=${encodeURIComponent(deptCd)}`)
                .then(r => r.json())
                .then(res => {
                    res.forEach(l => {
                        lineSelect.innerHTML += `<option value="${l.id}">${l.text}</option>`;
                    });
                });
        }

        function loadCertificates() {
            const tbody = document.getElementById('certificates-tbody');
            tbody.innerHTML = `
                <tr>
                    <td colspan="9" class="text-center text-muted py-5">
                        <div class="spinner-border text-success spinner-border-sm" role="status"></div>
                        <span class="ms-2">Đang tải...</span>
                    </td>
                </tr>
            `;

            const classId = document.getElementById('filter-class').value;
            const deptcd = document.getElementById('filter-dept').value;
            const linecd = document.getElementById('filter-line').value;
            const empcd = document.getElementById('filter-empcd').value.trim();

            let qs = '';
            if (classId) qs += `&classId=${classId}`;
            if (deptcd) qs += `&deptcd=${encodeURIComponent(deptcd)}`;
            if (linecd) qs += `&linecd=${encodeURIComponent(linecd)}`;
            if (empcd) qs += `&empcd=${encodeURIComponent(empcd)}`;

            fetch(`${window.TRAINING_URLS.getCertificateList}?${qs}`)
                .then(r => r.json())
                .then(res => {
                    if (!res.success || !res.data) {
                        tbody.innerHTML = '<tr><td colspan="9" class="text-center text-muted py-4">Không tìm thấy chứng chỉ nào.</td></tr>';
                        return;
                    }

                    const list = res.data;
                    if (list.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="9" class="text-center text-muted py-4">Không tìm thấy chứng chỉ nào.</td></tr>';
                        return;
                    }

                    tbody.innerHTML = '';
                    list.forEach(c => {
                        const dateStr = c.COMPLETION_DATE ? new Date(c.COMPLETION_DATE).toLocaleDateString('vi-VN') : '-';
                        const scoreStr = c.FINAL_SCORE !== null ? `${c.FINAL_SCORE} / 100` : '-';
                        const attendStr = c.ATTENDANCE_PERCENT !== null ? `${c.ATTENDANCE_PERCENT.toFixed(1)}%` : '-';

                        tbody.innerHTML += `
                            <tr>
                                <td class="ps-3 fw-bold text-dark">${c.EMPCD}</td>
                                <td class="fw-bold vni-font" style="text-transform:uppercase;">${c.EMP_NAME || 'Nhân viên'}</td>
                                <td><span class="badge bg-light text-dark border">${c.DEPTCD || '-'}</span></td>
                                <td>${c.COURSE_TITLE}</td>
                                <td>${c.CLASS_NAME}</td>
                                <td>${dateStr}</td>
                                <td><strong class="text-success">${scoreStr}</strong></td>
                                <td><strong class="text-primary">${attendStr}</strong></td>
                                <td class="pe-3 text-end">
                                    <button onclick="revokeCert(${c.CLASS_ID}, '${c.EMPCD}')" class="btn btn-xs btn-outline-danger fw-bold rounded-2">Thu hồi</button>
                                </td>
                            </tr>
                        `;
                    });
                })
                .catch(() => {
                    tbody.innerHTML = '<tr><td colspan="9" class="text-center text-danger py-4">Lỗi kết nối hoặc không có quyền truy cập dữ liệu.</td></tr>';
                });
        }

        function revokeCert(classId, empcd) {
            window.showConfirm(`Bạn chắc chắn muốn THU HỒI chứng chỉ của học viên (${empcd}) trong lớp học này?`, () => {
                fetch(window.TRAINING_URLS.revokeCertificate, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ CLASS_ID: classId, EMPCD: empcd })
                })
                .then(r => r.json())
                .then(res => {
                    if (res.success) {
                        window.showToast('Đã thu hồi chứng chỉ thành công!', 'success');
                        loadCertificates();
                    } else {
                        window.showToast(res.message || 'Lỗi khi thu hồi.', 'error');
                    }
                });
            });
        }

        function exportCertificates() {
            // Standard client table export or redirect to excel export endpoint
            window.showToast('Đang tạo tệp Excel chứng chỉ...', 'info');
            // Since we export, we can fetch list and build client table or redirect to export endpoint
            // Wait, we can implement it by converting html table to excel or redirecting
            // Let's do a simple client side Excel download
            let csvContent = "\uFEFFMã NV,Họ và Tên,Bộ phận,Khóa học,Lớp học,Ngày hoàn thành,Điểm thi,Chuyên cần\n";
            const rows = document.querySelectorAll("#certificates-tbody tr");
            if (rows.length === 0 || rows[0].cells.length < 8) {
                window.showToast('Không có dữ liệu để xuất.', 'warning');
                return;
            }
            rows.forEach(r => {
                if (r.cells.length >= 8) {
                    const rowData = [];
                    for(let i=0; i<8; i++) {
                        rowData.push('"' + r.cells[i].innerText.replace(/"/g, '""') + '"');
                    }
                    csvContent += rowData.join(",") + "\n";
                }
            });

            const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
            const link = document.createElement("a");
            link.href = URL.createObjectURL(blob);
            link.setAttribute("download", `danh_sach_chung_chi_${new Date().toISOString().slice(0,10)}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    </script>
}
