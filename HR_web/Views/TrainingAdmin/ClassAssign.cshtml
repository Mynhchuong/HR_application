@{
    ViewData["Title"] = "Quản trị Lớp học";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var classId = ViewBag.ClassId;
    var empCd = ViewBag.EmpCd as string;
}

<div class="container-fluid py-4">
    <div class="card my-4">
        @await Html.PartialAsync("_TrainingPageHeader", new TrainingPageHeaderVM
        {
            Title = "Quản trị Lớp học",
            Icon = "bi-mortarboard",
            Gradient = "primary",
            BackUrl = Url.Action("Index", "TrainingAdmin"),
        })
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3 flex-wrap gap-2">
            <h4 class="fw-bold mb-0 text-primary" id="detail-class-name">Chi tiết Lớp: --</h4>
            <div>
                <a href="@Url.Action("ClassEdit", "TrainingAdmin", new { id = classId })" class="btn btn-sm btn-outline-warning fw-bold me-1">
                    <i class="bi bi-gear align-middle me-1"></i>Cấu hình & Bài thi cuối khóa
                </a>
                <a href="@Url.Action("ClassReport", "TrainingAdmin", new { id = classId })" class="btn btn-sm btn-outline-primary fw-bold me-1">
                    <i class="bi bi-bar-chart align-middle me-1"></i>Báo cáo lớp
                </a>
                <a href="@Url.Action("AttendanceReport", "TrainingAdmin", new { id = classId })" class="btn btn-sm btn-outline-success fw-bold">
                    <i class="bi bi-check2-square align-middle me-1"></i>Điểm danh tổng hợp
                </a>
            </div>
        </div>

        <div id="class-lifecycle-actions" class="mb-4 d-flex gap-2 flex-wrap bg-light p-3 rounded-3 align-items-center">
            <span class="small fw-bold text-muted me-2">Trạng thái: <span id="detail-class-status-badge">--</span></span>
            <span class="text-muted small me-3">|</span>
            <div id="class-lifecycle-buttons" class="d-flex gap-2"></div>
            <div id="class-bulletin-link" class="ms-auto"></div>
        </div>

        <!-- Sub-tabs for Class Administration -->
        <ul class="nav nav-tabs mb-4 border-bottom" id="classAdminSubtabs">
            <li class="nav-item">
                <a class="nav-link active fw-bold border-0" id="subtab-sessions" data-bs-toggle="tab" href="#subpanel-sessions">Buổi học</a>
            </li>
            <li class="nav-item">
                <a class="nav-link fw-bold border-0" id="subtab-teachers" data-bs-toggle="tab" href="#subpanel-teachers">Giảng viên giảng dạy</a>
            </li>
            <li class="nav-item">
                <a class="nav-link fw-bold border-0" id="subtab-students" data-bs-toggle="tab" href="#subpanel-students">Học viên & Tổ nhóm</a>
            </li>
        </ul>

        <div class="tab-content">
            <!-- Sessions Subpanel -->
            <div class="tab-pane fade show active" id="subpanel-sessions">
                <div class="row">
                    <!-- Sessions list -->
                    <div class="col-12 mb-4">
                        <div class="card bg-light border-0 p-3" style="border-radius: 12px;">
                            <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                                <h6 class="fw-bold text-dark mb-0">Lịch các buổi học</h6>
                                <div class="d-flex gap-2">
                                    <a href="@Url.Action("SessionImportTemplate", "TrainingAdmin")" class="btn btn-sm btn-outline-secondary rounded-pill px-3 shadow-sm" download>Tải file mẫu</a>
                                    <button onclick="document.getElementById('session-import-file').click()" class="btn btn-sm btn-outline-primary rounded-pill px-3 shadow-sm">Nhập từ Excel</button>
                                    <input type="file" id="session-import-file" accept=".xlsx,.xls" class="d-none" onchange="submitSessionImport(this.files[0])" />
                                    <button onclick="openCreateSessionModal()" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm">Sắp lịch buổi học</button>
                                </div>
                            </div>
                            <div id="session-import-progress" class="text-muted small mb-2 d-none">Đang nhập file...</div>
                            <div class="table-responsive">
                                <table class="table table-sm align-middle text-nowrap bg-white rounded-3 shadow-sm">
                                    <thead>
                                        <tr>
                                            <th class="ps-3" data-mobile="primary" data-mobile-slot="code" data-mobile-label="Buổi">Buổi</th>
                                            <th data-mobile="primary" data-mobile-slot="name" data-mobile-label="Ngày">Ngày</th>
                                            <th data-mobile="primary" data-mobile-label="Thời gian">Thời gian</th>
                                            <th data-mobile="detail" data-mobile-label="Nhóm">Nhóm</th>
                                            <th data-mobile="detail" data-mobile-label="Phòng">Phòng</th>
                                            <th data-mobile="detail" data-mobile-label="Chủ đề">Chủ đề</th>
                                            <th class="pe-3 text-end" data-mobile="detail" data-mobile-label="Thao tác">Thao tác</th>
                                        </tr>
                                    </thead>
                                    <tbody id="sub-sessions-list">
                                        <!-- Dynamic -->
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Teachers Subpanel -->
            <div class="tab-pane fade" id="subpanel-teachers">
                <div class="row">
                    <div class="col-12 col-lg-8 mb-4">
                        <div class="card bg-light border-0 p-3" style="border-radius: 12px;">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="fw-bold text-dark mb-0">Giảng viên giảng dạy</h6>
                                <button onclick="openAssignTeacherModal()" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm">Gán giáo viên</button>
                            </div>
                            <div id="sub-teachers-list">
                                <!-- Dynamic -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Students & Groups Subpanel -->
            <div class="tab-pane fade" id="subpanel-students">
                <div class="row">
                    <!-- Students List -->
                    <div class="col-12 col-lg-8 mb-4">
                        <div class="card bg-light border-0 p-3" style="border-radius: 12px;">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="fw-bold text-dark mb-0">Danh sách học viên trong lớp</h6>
                                <div class="d-flex gap-2 flex-wrap">
                                    <a href="@Url.Action("StudentImportTemplate", "TrainingAdmin")" class="btn btn-sm btn-outline-secondary rounded-pill px-3 shadow-sm" download>Tải mẫu</a>
                                    <button onclick="document.getElementById('student-import-file').click()" class="btn btn-sm btn-outline-primary rounded-pill px-3 shadow-sm">Nhập từ Excel</button>
                                    <input type="file" id="student-import-file" accept=".xlsx,.xls" class="d-none" onchange="submitStudentImport(this.files[0])" />
                                    <a href="#" onclick="exportStudents(); return false;" class="btn btn-sm btn-outline-success rounded-pill px-3 shadow-sm">Xuất Excel</a>
                                    <button onclick="openAssignStudentModal()" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm">Thêm học viên</button>
                                </div>
                            </div>
                            <div class="filter-bar mb-2 d-flex gap-2 flex-wrap">
                                <input type="text" id="student-filter-empcd" class="form-control form-control-sm" style="max-width:260px;" placeholder="Lọc theo mã nhân viên..." oninput="onStudentFilterChange()" />
                                <select id="student-filter-group" class="form-select form-select-sm" style="max-width:200px;" onchange="onStudentFilterChange()">
                                    <option value="">-- Tất cả nhóm --</option>
                                </select>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-sm align-middle text-nowrap bg-white rounded-3 shadow-sm">
                                    <thead>
                                        <tr>
                                            <th class="ps-3" data-mobile="primary" data-mobile-slot="code" data-mobile-label="Mã NV">Mã NV</th>
                                            <th data-mobile="primary" data-mobile-slot="name" data-mobile-label="Họ và tên">Họ và tên</th>
                                            <th data-mobile="detail" data-mobile-label="Bộ phận/Chuyền/Line">Bộ phận/Chuyền/Line</th>
                                            <th data-mobile="primary" data-mobile-label="Tổ/Nhóm">Tổ/Nhóm</th>
                                            <th data-mobile="primary" data-mobile-label="Trạng thái">Trạng thái</th>
                                            <th class="pe-3 text-end" data-mobile="detail" data-mobile-label="Thao tác">Thao tác</th>
                                        </tr>
                                    </thead>
                                    <tbody id="sub-students-list">
                                        <!-- Dynamic -->
                                    </tbody>
                                </table>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="small text-muted" id="student-list-summary"></span>
                                <nav>
                                    <ul class="pagination pagination-sm mb-0" id="student-pagination"></ul>
                                </nav>
                            </div>
                        </div>
                    </div>

                    <!-- Groups Split Control -->
                    <div class="col-12 col-lg-4 mb-4">
                        <div class="card bg-light border-0 p-3" style="border-radius: 12px;">
                            <h6 class="fw-bold text-dark mb-3">Phân chia Tổ/Nhóm học tập</h6>
                            
                            <!-- Auto split form — chia đều học viên (ENROLLED, chưa gán nhóm) vào TẤT CẢ
                                 nhóm đã tạo bên dưới (round-robin theo EMPCD). Cần tạo nhóm trước.
                                 Đang ẩn theo yêu cầu — chưa cần dùng, giữ lại code để bật lại sau. -->
                            <div class="mb-3 bg-white p-3 rounded shadow-sm border d-none">
                                <label class="form-label small fw-bold text-muted d-block">Chia đều học viên chưa gán vào các nhóm hiện có</label>
                                <button onclick="autoSplitGroupSubmit()" class="btn btn-primary fw-bold shadow-sm w-100">Chia tự động (round-robin)</button>
                                <div class="form-text">Cần tạo nhóm trước ở khung bên dưới — học viên chưa gán nhóm sẽ được chia đều vào toàn bộ nhóm đã tạo.</div>
                            </div>

                            <!-- Bulk manual assign — nhập nhiều mã thẻ 1 lần vào 1 nhóm cụ thể -->
                            <div class="mb-4 bg-white p-3 rounded shadow-sm border">
                                <label class="form-label small fw-bold text-muted">Gán nhiều học viên vào 1 nhóm (nhập tay)</label>
                                <select id="bulk-assign-group" class="form-select form-select-sm mb-2" style="border-radius: 6px;">
                                    <option value="">-- Chọn nhóm --</option>
                                </select>
                                <div class="d-flex gap-2 mb-2">
                                    <button type="button" onclick="fillBulkAssignAll(false)" class="btn btn-outline-secondary btn-sm flex-fill">Chọn tất cả HV</button>
                                    <button type="button" onclick="fillBulkAssignAll(true)" class="btn btn-outline-secondary btn-sm flex-fill">HV chưa có nhóm</button>
                                </div>
                                <textarea id="bulk-assign-empcd" class="form-control form-control-sm mb-2" rows="3" placeholder="Nhập nhiều mã thẻ, cách nhau bởi dấu phẩy, khoảng trắng hoặc xuống dòng"></textarea>
                                <button onclick="submitBulkAssignGroup()" class="btn btn-outline-primary btn-sm fw-bold w-100">Gán vào nhóm</button>
                            </div>

                            <!-- Group list -->
                            <div class="bg-white p-3 rounded shadow-sm border">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="fw-bold text-muted small">Danh sách nhóm hiện tại</span>
                                    <button onclick="openCreateGroupModal()" class="btn btn-sm btn-outline-primary rounded-pill px-2">Tạo nhóm</button>
                                </div>
                                <div id="sub-groups-list">
                                    <!-- Dynamic -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </div>
    </div>
</div>

<!-- Overlay chờ khi nhập Excel / gán nhóm số lượng lớn -->
<div id="import-loading-overlay" style="display:none; position:fixed; inset:0; z-index:2000; background:rgba(255,255,255,.75); backdrop-filter:blur(2px);">
    <div class="d-flex flex-column align-items-center justify-content-center h-100 gap-3">
        <div class="spinner-border text-primary" style="width:3rem; height:3rem;" role="status"></div>
        <div id="import-loading-text" class="fw-bold text-muted">Đang xử lý dữ liệu...</div>
    </div>
</div>

<!-- Overlay loading toàn trang — các thao tác nặng (thêm/import hàng trăm học viên, chia nhóm...) -->
<div id="page-loading-overlay" class="position-fixed top-0 start-0 w-100 h-100 align-items-center justify-content-center" style="display: none; background: rgba(255,255,255,.8); z-index: 20000; backdrop-filter: blur(2px);">
    <div class="text-center">
        <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;"></div>
        <div id="page-loading-text" class="fw-bold text-dark">Đang xử lý...</div>
        <div class="small text-muted mt-1">Vui lòng chờ, không đóng trang</div>
    </div>
</div>

<!-- ==================== MODALS ==================== -->

<!-- CREATE SESSION MODAL -->
<div class="modal fade" id="createSessionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg training-modal-card">
            <div class="modal-header border-bottom-0 p-4 pb-0">
                <h5 class="fw-bold modal-title" id="sessionModalTitle">Sắp lịch buổi học mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="sessionForm">
                    <input type="hidden" id="sess-id" />
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Thứ tự buổi học (Số buổi)</label>
                        <input type="number" id="sess-no" class="form-control" value="1" min="1" required style="border-radius: 8px;" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Ngày học</label>
                        <input type="date" id="sess-date" class="form-control" required style="border-radius: 8px;" />
                    </div>
                    <div class="row mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">Giờ bắt đầu</label>
                            <input type="time" id="sess-start" class="form-control" required style="border-radius: 8px;" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">Giờ kết thúc</label>
                            <input type="time" id="sess-end" class="form-control" required style="border-radius: 8px;" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Chủ đề bài giảng</label>
                        <input type="text" id="sess-topic" class="form-control" placeholder="Nhập chủ đề..." required style="border-radius: 8px;" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Địa điểm / Phòng học</label>
                        <input type="text" id="sess-loc" class="form-control" placeholder="Phòng học A, Xưởng B..." style="border-radius: 8px;" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Nhóm áp dụng (nếu lớp có chia nhóm)</label>
                        <select id="sess-group" class="form-select" style="border-radius: 8px;">
                            <option value="">-- Buổi chung cả lớp --</option>
                        </select>
                    </div>
                    <div class="d-grid mt-4">
                        <button type="button" onclick="submitCreateSession()" class="btn btn-primary py-2.5 rounded-3 fw-bold shadow-sm">Lưu buổi học</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ASSIGN TEACHER MODAL -->
<div class="modal fade" id="assignTeacherModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg training-modal-card">
            <div class="modal-header border-bottom-0 p-4 pb-0">
                <h5 class="fw-bold modal-title">Gán giảng viên phụ trách</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="teacherForm">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Mã số nhân viên giảng dạy (EMPCD)</label>
                        <input type="text" id="teach-empcd" class="form-control" placeholder="Ví dụ: 12345" required style="border-radius: 8px;" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Vai trò giảng dạy</label>
                        <select id="teach-role" class="form-select" style="border-radius: 8px;">
                            <option value="1">Giáo viên chính</option>
                            <option value="0">Trợ giảng</option>
                        </select>
                    </div>
                    <div class="d-grid mt-4">
                        <button type="button" onclick="submitAssignTeacher()" class="btn btn-primary py-2.5 rounded-3 fw-bold shadow-sm">Xác nhận gán</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ASSIGN STUDENT MODAL -->
<div class="modal fade" id="assignStudentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg training-modal-card">
            <div class="modal-header border-bottom-0 p-4 pb-0">
                <h5 class="fw-bold modal-title">Thêm học viên vào lớp</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="studentForm">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Danh sách mã nhân viên (EMPCD)</label>
                        <textarea id="stud-empcd" class="form-control" placeholder="Nhập một hoặc nhiều mã nhân viên (cách nhau bởi dấu phẩy, khoảng trắng hoặc dòng mới)&#10;Ví dụ: 24092522, 99888" rows="5" required style="border-radius: 12px;"></textarea>
                    </div>
                    <div id="assign-loading-progress" class="text-center my-3 d-none">
                        <div class="spinner-border text-primary spinner-border-sm" role="status"></div>
                        <span id="assign-progress-text" class="small text-muted ms-2">Đang thêm...</span>
                    </div>
                    <div class="d-grid mt-4">
                        <button type="button" id="btn-submit-student" onclick="submitAssignStudent()" class="btn btn-primary py-2.5 rounded-3 fw-bold shadow-sm">Thêm vào lớp</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- CLONE CLASS MODAL (§15b Cách 2 — Sao chép sang đợt mới) -->
<div class="modal fade" id="cloneClassModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg training-modal-card">
            <div class="modal-header border-bottom-0 p-4 pb-0">
                <h5 class="fw-bold modal-title">Sao chép sang đợt mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="clone-source-class-id" />
                <p class="text-muted small">Giữ nguyên giáo trình, giáo viên, cấu trúc nhóm và đề thi (đề thi được sao chép riêng cho đợt mới, ở trạng thái Nháp — cần Publish lại). Buổi học sẽ dịch ngày theo đúng khoảng cách với ngày bắt đầu mới. Danh sách học viên và pre-assign phải nhập lại cho đợt mới.</p>
                <div class="mb-3">
                    <label class="form-label small fw-bold text-muted">Tên đợt mới</label>
                    <input type="text" id="clone-class-name" class="form-control" maxlength="80" placeholder="VD: An toàn K2/08/2026" required style="border-radius: 8px;" />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-bold text-muted">Ngày bắt đầu đợt mới</label>
                    <input type="date" id="clone-start-date" class="form-control" required style="border-radius: 8px;" />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-bold text-muted">Danh sách học viên (tuỳ chọn — có thể bổ sung sau)</label>
                    <textarea id="clone-empcd" class="form-control" placeholder="Nhập mã nhân viên, cách nhau bởi dấu phẩy, khoảng trắng hoặc dòng mới" rows="4" style="border-radius: 12px;"></textarea>
                </div>
                <div class="d-grid mt-4">
                    <button type="button" id="btn-submit-clone-class" onclick="submitCloneClass()" class="btn btn-primary py-2.5 rounded-3 fw-bold shadow-sm">Tạo đợt mới (Nháp)</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- CREATE GROUP MODAL -->
<div class="modal fade" id="createGroupModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg training-modal-card">
            <div class="modal-header border-bottom-0 p-4 pb-0">
                <h5 class="fw-bold modal-title" id="groupModalTitle">Tạo Tổ/Nhóm mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="groupForm">
                    <input type="hidden" id="group-id" />
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Tên Tổ/Nhóm học tập</label>
                        <input type="text" id="group-name" class="form-control" placeholder="Ví dụ: Nhóm sản xuất A, Tổ 1..." required style="border-radius: 8px;" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Số học viên tối đa (tuỳ chọn)</label>
                        <input type="number" id="group-max" class="form-control" placeholder="Để trống nếu không giới hạn" style="border-radius: 8px;" />
                    </div>
                    <div class="d-grid mt-4">
                        <button type="button" id="btn-submit-group" onclick="submitCreateGroup()" class="btn btn-primary py-2.5 rounded-3 fw-bold shadow-sm">Tạo nhóm</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .training-modal-card { border-radius: 20px; }
</style>

@section Scripts {
    <script>
        window.TRAINING_URLS = {
            getClassDetailAdmin: '@Url.Action("GetClassDetailAdmin", "TrainingAdmin")',
            publishRegistration: '@Url.Action("PublishRegistration", "TrainingAdmin")',
            finalizeEnrollment: '@Url.Action("FinalizeEnrollment", "TrainingAdmin")',
            remindReview:      '@Url.Action("RemindReview", "TrainingAdmin", new { id = "__ID__" })',
            cancelClass: '@Url.Action("CancelClass", "TrainingAdmin")',
            closeClass: '@Url.Action("CloseClass", "TrainingAdmin")',
            finalizeClass: '@Url.Action("FinalizeClass", "TrainingAdmin")',
            saveSession: '@Url.Action("SaveSession", "TrainingAdmin")',
            cancelSession: '@Url.Action("CancelSession", "TrainingAdmin")',
            sessionImport: '@Url.Action("SessionImport", "TrainingAdmin")',
            assignTeacher: '@Url.Action("AssignTeacher", "TrainingAdmin")',
            removeTeacher: '@Url.Action("RemoveTeacher", "TrainingAdmin")',
            assignStudent: '@Url.Action("AssignStudent", "TrainingAdmin")',
            studentImport: '@Url.Action("StudentImport", "TrainingAdmin")',
            exportStudents: '@Url.Action("ExportEnrollments", "TrainingAdmin")',
            approveEnrollment: '@Url.Action("ApproveEnrollment", "TrainingAdmin")',
            rejectEnrollment: '@Url.Action("RejectEnrollment", "TrainingAdmin")',
            saveGroup: '@Url.Action("SaveGroup", "TrainingAdmin")',
            deleteGroup: '@Url.Action("DeleteGroup", "TrainingAdmin")',
            autoSplitGroup: '@Url.Action("AutoSplitGroup", "TrainingAdmin")',
            assignGroup: '@Url.Action("AssignGroup", "TrainingAdmin")',
            removeStudent: '@Url.Action("RemoveStudent", "TrainingAdmin")',
            cloneFromClass: '@Url.Action("CloneFromClass", "TrainingAdmin")',
            classAssignTemplate: '@Url.Action("ClassAssign", "TrainingAdmin", new { id = "__ID__" })'
        };

        const selectedClassId = @classId;
        const empCd = '@empCd';
        let selectedClassData = null;
        let studentFilterText = '';
        let studentsPage = 1;
        const STUDENTS_PER_PAGE = 20;

        // Modals
        let modalSession = null;
        let modalTeacher = null;
        let modalStudent = null;
        let modalGroup = null;

        document.addEventListener('DOMContentLoaded', function () {
            modalSession = new bootstrap.Modal(document.getElementById('createSessionModal'));
            modalTeacher = new bootstrap.Modal(document.getElementById('assignTeacherModal'));
            modalStudent = new bootstrap.Modal(document.getElementById('assignStudentModal'));
            modalGroup = new bootstrap.Modal(document.getElementById('createGroupModal'));

            loadClassDetailAdmin();
            MobileTableHelper.init('sub-sessions-list');
            MobileTableHelper.init('sub-students-list');
            MobileTableHelper.init('sub-teachers-tbody');
        });

        function loadClassDetailAdmin() {
            fetch(`${window.TRAINING_URLS.getClassDetailAdmin}?classId=${selectedClassId}`)
                .then(r => r.json())
                .then(res => {
                    if (!res.success) {
                        window.showToast(res.message || 'Lỗi tải chi tiết lớp học.', 'error');
                        return;
                    }
                    selectedClassData = res.data;
                    
                    renderLifecycle();
                    renderSubSessions();
                    renderSubTeachers();
                    renderSubStudents();
                    renderSubGroups();
                });
        }

        function renderLifecycle() {
            const cls = selectedClassData.cls;
            document.getElementById('detail-class-name').innerText = `Quản trị Lớp: ${cls.CLASS_NAME}`;
            const badge = document.getElementById('detail-class-status-badge');

            // Bản tin quảng cáo tự tạo khi bấm "Mở Đăng ký tự do" — link nhanh sang Bulletin để xem/sửa.
            const bulletinId = cls.BULLETIN_ID || cls.bulletinId;
            document.getElementById('class-bulletin-link').innerHTML = bulletinId
                ? `<a href="/Bulletin/Detail/${bulletinId}" target="_blank" class="btn btn-sm btn-outline-info fw-bold">
                        <i class="bi bi-megaphone align-middle me-1" style="font-size:1rem;"></i>Xem bản tin đăng ký
                   </a>`
                : '';

            const statusLabelsMap = {
                'DRAFT': 'Nháp',
                'OPEN_FOR_REGISTRATION': 'Đang mở ĐK',
                'SCHEDULED': 'Đã lên lịch',
                'IN_PROGRESS': 'Đang học',
                'COMPLETED': 'Đã kết thúc',
                'CLOSED': 'Đã đóng',
                'CANCELLED': 'Đã hủy'
            };
            badge.innerText = statusLabelsMap[cls.STATUS] || cls.STATUS;
            badge.className = 'badge ' + (
                cls.STATUS === 'DRAFT' ? 'bg-secondary' :
                cls.STATUS === 'OPEN_FOR_REGISTRATION' ? 'bg-info text-dark' :
                cls.STATUS === 'SCHEDULED' ? 'bg-primary' :
                cls.STATUS === 'IN_PROGRESS' ? 'bg-success' :
                cls.STATUS === 'COMPLETED' ? 'bg-success' :
                'bg-dark'
            );

            const buttonsWrap = document.getElementById('class-lifecycle-buttons');
            buttonsWrap.innerHTML = '';

            if (cls.STATUS === 'DRAFT') {
                if (cls.REGISTRATION_MODE === 'OPEN') {
                    buttonsWrap.innerHTML += `<button onclick="publishRegistration(${cls.ID})" class="btn btn-sm btn-info fw-bold">Mở Đăng ký tự do</button>`;
                } else {
                    buttonsWrap.innerHTML += `<button onclick="finalizeEnrollment(${cls.ID})" class="btn btn-sm btn-primary fw-bold">Lên lịch học</button>`;
                }
                buttonsWrap.innerHTML += `<button onclick="cancelClass(${cls.ID})" class="btn btn-sm btn-outline-danger fw-bold">Hủy Lớp</button>`;
            } else if (cls.STATUS === 'OPEN_FOR_REGISTRATION') {
                buttonsWrap.innerHTML += `<button onclick="finalizeEnrollment(${cls.ID})" class="btn btn-sm btn-primary fw-bold">Chốt DS & Lên lịch học</button>`;
                buttonsWrap.innerHTML += `<button onclick="cancelClass(${cls.ID})" class="btn btn-sm btn-outline-danger fw-bold">Hủy Lớp</button>`;
            } else if (cls.STATUS === 'SCHEDULED' || cls.STATUS === 'IN_PROGRESS') {
                buttonsWrap.innerHTML += `<button onclick="cancelClass(${cls.ID})" class="btn btn-sm btn-outline-danger fw-bold">Hủy Lớp</button>`;
            } else if (cls.STATUS === 'COMPLETED' || cls.STATUS === 'CLOSED') {
                // Còn học viên ENROLLED = chưa chạy finalize (chốt xong ai cũng thành COMPLETED/FAILED).
                // Hiện cả khi CLOSED — recovery cho lớp lỡ bị đóng trước khi chốt kết quả.
                const hasUnfinalized = (selectedClassData.enrollments || []).some(e => e.STATUS === 'ENROLLED');
                if (hasUnfinalized) {
                    buttonsWrap.innerHTML += `<button onclick="finalizeClass(${cls.ID})" class="btn btn-sm btn-success fw-bold">Chốt kết quả & cấp chứng chỉ</button>`;
                }
                if (cls.STATUS === 'COMPLETED') {
                    buttonsWrap.innerHTML += `<button onclick="closeClass(${cls.ID})" class="btn btn-sm btn-dark fw-bold">Đóng & Lưu trữ lớp</button>`;
                }
            }

            // Nhắc mềm học viên nộp đánh giá — không bắt buộc, không chặn chốt lớp, chỉ giúp HR
            // nhắc trước khi bấm "Chốt kết quả". Hiện khi lớp đã học xong/đang chốt (có enrollment thật).
            if (['SCHEDULED', 'IN_PROGRESS', 'COMPLETED', 'CLOSED'].includes(cls.STATUS)) {
                buttonsWrap.innerHTML += `<button onclick="remindReview(${cls.ID})" class="btn btn-sm btn-outline-warning fw-bold">
                    <i class="bi bi-bell align-middle me-1" style="font-size:1rem;"></i>Nhắc đánh giá
                </button>`;
            }

            // §15b Cách 2 — "Sao chép sang đợt mới": chỉ cho phép từ SCHEDULED hoặc COMPLETED
            // (khớp validate server TrainingClassService.CloneFromClassAsync), và Class không phải EXPRESS.
            if ((cls.STATUS === 'SCHEDULED' || cls.STATUS === 'COMPLETED') && cls.IS_EXPRESS !== 1 && cls.isExpress !== 1) {
                buttonsWrap.innerHTML += `<button onclick="openCloneClassModal(${cls.ID}, '${(cls.CLASS_NAME || '').replace(/'/g, "\\'")}')" class="btn btn-sm btn-outline-primary fw-bold">Sao chép sang đợt mới</button>`;
            }
        }

        function openCloneClassModal(id, className) {
            document.getElementById('clone-source-class-id').value = id;
            document.getElementById('clone-class-name').value = className ? (className + ' (Đợt mới)') : '';
            document.getElementById('clone-start-date').value = '';
            document.getElementById('clone-empcd').value = '';
            new bootstrap.Modal(document.getElementById('cloneClassModal')).show();
        }

        function submitCloneClass() {
            const sourceId   = parseInt(document.getElementById('clone-source-class-id').value, 10);
            const className = document.getElementById('clone-class-name').value.trim();
            const startDate  = document.getElementById('clone-start-date').value;
            const empcdRaw   = document.getElementById('clone-empcd').value.trim();
            const empcds = empcdRaw ? empcdRaw.split(/[\s,]+/).map(s => s.trim()).filter(Boolean) : [];

            if (!className || !startDate) {
                window.showToast('Vui lòng nhập tên đợt mới và ngày bắt đầu.', 'warning');
                return;
            }

            const btn = document.getElementById('btn-submit-clone-class');
            btn.disabled = true;
            fetch(window.TRAINING_URLS.cloneFromClass, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    SOURCE_CLASS_ID: sourceId,
                    CLASS_NAME: className,
                    START_DATE: startDate,
                    EMPCDS: empcds
                })
            }).then(r => r.json()).then(res => {
                btn.disabled = false;
                if (res.success) {
                    bootstrap.Modal.getInstance(document.getElementById('cloneClassModal'))?.hide();
                    window.showToast('Đã tạo đợt mới (Nháp) từ lớp này!', 'success');
                    if (res.data && res.data.id) {
                        window.location.href = window.TRAINING_URLS.classAssignTemplate.replace('__ID__', res.data.id);
                    }
                } else {
                    window.showToast(res.message || 'Lỗi sao chép lớp học.', 'error');
                }
            }).catch(() => { btn.disabled = false; window.showToast('Lỗi kết nối máy chủ.', 'error'); });
        }

        // Overlay loading toàn trang — dùng cho thao tác nặng để người dùng biết chờ
        function showPageLoading(msg) {
            document.getElementById('page-loading-text').textContent = msg || 'Đang xử lý...';
            document.getElementById('page-loading-overlay').style.display = 'flex';
        }
        function updatePageLoading(msg) {
            document.getElementById('page-loading-text').textContent = msg;
        }
        function hidePageLoading() {
            document.getElementById('page-loading-overlay').style.display = 'none';
        }

        // Thay cụm nút lifecycle bằng spinner trong lúc chờ server — các action như "Lên lịch học"
        // phải xử lý cả lớp (enqueue noti, reject pending...) nên lớp đông sẽ mất vài giây.
        // Lỗi/timeout → renderLifecycle() trả nút về; thành công → loadClassDetailAdmin() tự vẽ lại.
        function setLifecycleLoading(msg) {
            document.getElementById('class-lifecycle-buttons').innerHTML = `
                <span class="d-inline-flex align-items-center gap-2 text-muted small fw-bold py-1">
                    <span class="spinner-border spinner-border-sm text-primary"></span> ${msg}
                </span>`;
        }

        function publishRegistration(id) {
            setLifecycleLoading('Đang mở đăng ký tự do...');
            fetch(window.TRAINING_URLS.publishRegistration, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ID: id })
            }).then(r => r.json()).then(res => {
                if (res.success) {
                    window.showToast(res.message || 'Đã mở đăng ký tự do thành công!', 'success');
                    loadClassDetailAdmin();
                } else {
                    renderLifecycle();
                    window.showToast(res.message || 'Lỗi mở đăng ký.', 'error');
                }
            }).catch(err => { renderLifecycle(); window.showToast('Lỗi kết nối: ' + err.message, 'error'); });
        }

        function finalizeEnrollment(id) {
            setLifecycleLoading('Đang chốt danh sách & gửi thông báo cho học viên...');
            fetch(window.TRAINING_URLS.finalizeEnrollment, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ID: id })
            }).then(r => r.json()).then(res => {
                if (res.success) {
                    window.showToast(res.message || 'Đã chốt danh sách và lên lịch học thành công!', 'success');
                    loadClassDetailAdmin();
                } else {
                    renderLifecycle();
                    window.showToast(res.message || 'Lỗi lên lịch học.', 'error');
                }
            }).catch(err => { renderLifecycle(); window.showToast('Lỗi kết nối: ' + err.message, 'error'); });
        }

        // Nhắc mềm học viên chưa nộp đánh giá — không bắt buộc, không chặn chốt lớp.
        function remindReview(id) {
            fetch(window.TRAINING_URLS.remindReview.replace('__ID__', id), { method: 'POST' })
                .then(r => r.json())
                .then(res => {
                    if (res.success) window.showToast(res.message, 'success');
                    else window.showToast(res.message || 'Lỗi gửi nhắc đánh giá.', 'error');
                })
                .catch(err => window.showToast('Lỗi kết nối: ' + err.message, 'error'));
        }

        // Sessions list — chỉ Sửa/Xóa được khi buổi còn UPCOMING (khớp rule §5: đã ONGOING/COMPLETED
        // thì không sửa được nữa; CANCELLED thì đã xóa rồi). "Xóa" ở đây gọi API Cancel có sẵn
        // (giữ record + tự động báo học viên buổi bị hủy) chứ không xóa hẳn khỏi DB.
        function renderSubSessions() {
            const tbody = document.getElementById('sub-sessions-list');
            const list = selectedClassData.sessions || [];
            tbody.innerHTML = '';

            // Lớp CHƯA công bố (nháp / đang mở ĐK) → sửa/xóa được mọi buổi chưa hủy — server sẽ
            // tự reset buổi lỡ "Đang diễn ra" về UPCOMING khi lưu (buổi của lớp nháp không thể diễn ra).
            const clsDraft = ['DRAFT', 'OPEN_FOR_REGISTRATION'].includes(selectedClassData.cls?.STATUS);
            list.forEach(s => {
                const dateStr = s.SESSION_DATE ? new Date(s.SESSION_DATE).toLocaleDateString('vi-VN') : '';
                const canEdit = s.STATUS === 'UPCOMING' || (clsDraft && s.STATUS !== 'CANCELLED');
                let actions = `<span class="badge bg-secondary-subtle text-secondary-emphasis">${s.STATUS === 'CANCELLED' ? 'Đã hủy' : (s.STATUS === 'COMPLETED' ? 'Đã xong' : s.STATUS === 'ONGOING' ? 'Đang diễn ra' : '')}</span>`;
                if (canEdit) {
                    actions = `
                        <button onclick="openEditSessionModal(${s.ID})" class="btn btn-xs btn-outline-primary rounded-circle p-1 d-flex align-items-center justify-content-center d-inline-flex" title="Sửa buổi học">
                            <i class="bi bi-pencil" style="font-size:1rem;"></i>
                        </button>
                        <button onclick="cancelSession(${s.ID}, ${s.SESSION_NO})" class="btn btn-xs btn-outline-danger rounded-circle p-1 d-flex align-items-center justify-content-center d-inline-flex ms-1" title="Xóa buổi học">
                            <i class="bi bi-trash" style="font-size:1rem;"></i>
                        </button>`;
                }

                const groupLabel = s.GROUP_NAME
                    ? `<span class="badge bg-info-subtle text-info-emphasis">${s.GROUP_NAME}</span>`
                    : `<span class="text-muted small">Chung cả lớp</span>`;

                tbody.innerHTML += `
                    <tr>
                        <td class="ps-3 fw-bold text-dark">Buổi ${s.SESSION_NO}</td>
                        <td>${dateStr}</td>
                        <td>${s.START_TIME} - ${s.END_TIME}</td>
                        <td>${groupLabel}</td>
                        <td>${s.LOCATION || 'N/A'}</td>
                        <td class="text-truncate" style="max-width: 180px;" title="${s.TOPIC || ''}">${s.TOPIC || '-'}</td>
                        <td class="pe-3 text-end">${actions}</td>
                    </tr>
                `;
            });

            if (list.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="text-center py-3 text-muted small">Lớp học chưa được lên lịch buổi học nào.</td></tr>`;
            }
            MobileTableHelper.refresh('sub-sessions-list');
        }

        // Populate dropdown chọn nhóm trong modal Sắp lịch/Sửa buổi học — dùng chung DS nhóm đã tạo
        // của lớp (selectedClassData.groups). Nếu lớp không chia nhóm thì list rỗng, chỉ còn option mặc định.
        function populateSessionGroupOptions(selectedGroupId) {
            const sel = document.getElementById('sess-group');
            const groups = selectedClassData.groups || [];
            sel.innerHTML = '<option value="">-- Buổi chung cả lớp --</option>' +
                groups.map(g => `<option value="${g.ID}">${g.GROUP_NAME}</option>`).join('');
            sel.value = selectedGroupId ? String(selectedGroupId) : '';
        }

        // Số buổi đánh RIÊNG theo từng nhóm (buổi 1 Nhóm 1 ≠ buổi 1 Nhóm 2) — gợi ý
        // số kế tiếp = max SESSION_NO của các buổi CÙNG NHÓM đang chọn + 1.
        function suggestNextSessionNo() {
            const groupVal = document.getElementById('sess-group').value;
            const gid = groupVal ? parseInt(groupVal) : null;
            const list = (selectedClassData.sessions || []).filter(s => (s.GROUP_ID ?? null) === gid);
            document.getElementById('sess-no').value = list.reduce((m, s) => Math.max(m, s.SESSION_NO), 0) + 1;
        }

        function openCreateSessionModal() {
            document.getElementById('sessionModalTitle').textContent = 'Sắp lịch buổi học mới';
            document.getElementById('sess-id').value = '';
            document.getElementById('sess-date').value = '';
            document.getElementById('sess-start').value = '08:00';
            document.getElementById('sess-end').value = '11:30';
            document.getElementById('sess-topic').value = '';
            document.getElementById('sess-loc').value = '';
            populateSessionGroupOptions(null);
            suggestNextSessionNo();
            // Đổi nhóm trong modal tạo mới → tính lại số buổi gợi ý theo nhóm đó
            document.getElementById('sess-group').onchange = () => {
                if (!document.getElementById('sess-id').value) suggestNextSessionNo();
            };
            modalSession.show();
        }

        // HHMM ("0800") → "08:00" cho input type=time.
        function hhmmToTimeInput(hhmm) {
            if (!hhmm || hhmm.length !== 4) return '';
            return `${hhmm.substring(0, 2)}:${hhmm.substring(2)}`;
        }

        function openEditSessionModal(id) {
            const s = (selectedClassData.sessions || []).find(x => x.ID === id);
            if (!s) return;
            document.getElementById('sessionModalTitle').textContent = `Sửa Buổi ${s.SESSION_NO}`;
            document.getElementById('sess-id').value = s.ID;
            document.getElementById('sess-no').value = s.SESSION_NO;
            document.getElementById('sess-date').value = s.SESSION_DATE ? s.SESSION_DATE.substring(0, 10) : '';
            document.getElementById('sess-start').value = hhmmToTimeInput(s.START_TIME);
            document.getElementById('sess-end').value = hhmmToTimeInput(s.END_TIME);
            document.getElementById('sess-topic').value = s.TOPIC || '';
            document.getElementById('sess-loc').value = s.LOCATION || '';
            populateSessionGroupOptions(s.GROUP_ID);
            modalSession.show();
        }

        function submitCreateSession() {
            const id = document.getElementById('sess-id').value;
            const no = parseInt(document.getElementById('sess-no').value);
            const date = document.getElementById('sess-date').value;
            const start = document.getElementById('sess-start').value.trim().replace(':', '');
            const end = document.getElementById('sess-end').value.trim().replace(':', '');
            const topic = document.getElementById('sess-topic').value.trim();
            const loc = document.getElementById('sess-loc').value.trim();
            const groupVal = document.getElementById('sess-group').value;

            if (!date || !start || !end || !topic) {
                window.showToast('Vui lòng điền các trường bắt buộc!', 'warning');
                return;
            }

            fetch(window.TRAINING_URLS.saveSession, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    ID: id ? parseInt(id) : null,
                    CLASS_ID: selectedClassId,
                    SESSION_NO: no,
                    SESSION_DATE: date,
                    START_TIME: start,
                    END_TIME: end,
                    TOPIC: topic,
                    LOCATION: loc || null,
                    GROUP_ID: groupVal ? parseInt(groupVal) : null
                })
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    window.showToast(id ? 'Đã cập nhật buổi học!' : 'Sắp xếp buổi học thành công!', 'success');
                    modalSession.hide();
                    loadClassDetailAdmin();
                } else {
                    window.showToast(res.message || 'Lỗi sắp lịch.', 'error');
                }
            });
        }

        function cancelSession(id, sessionNo) {
            window.showConfirm(`Xóa buổi ${sessionNo}? Học viên sẽ nhận thông báo buổi học đã bị hủy.`, () => {
                fetch(window.TRAINING_URLS.cancelSession, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ID: id })
                })
                .then(r => r.json())
                .then(res => {
                    if (res.success) {
                        window.showToast('Đã xóa buổi học!', 'success');
                        loadClassDetailAdmin();
                    } else {
                        window.showToast(res.message || 'Lỗi xóa buổi học.', 'error');
                    }
                })
                .catch(err => window.showToast('Lỗi kết nối: ' + err.message, 'error'));
            }, {
                title: 'Xóa buổi học', okText: 'Xóa', okClass: 'btn-danger',
                icon: 'delete', iconColor: '#dc3545', iconBg: '#fee2e2'
            });
        }

        function submitSessionImport(file) {
            if (!file) return;
            const progress = document.getElementById('session-import-progress');
            progress.classList.remove('d-none');
            showPageLoading('Đang nhập các buổi học từ Excel...');

            const formData = new FormData();
            formData.append('file', file);
            formData.append('classId', selectedClassId);

            fetch(window.TRAINING_URLS.sessionImport, { method: 'POST', body: formData })
                .then(r => r.json())
                .then(res => {
                    hidePageLoading();
                    progress.classList.add('d-none');
                    document.getElementById('session-import-file').value = '';
                    if (res.success) {
                        const d = res.data || {};
                        let msg = `Đã nhập ${d.INSERTED ?? 0} buổi học.`;
                        loadClassDetailAdmin();
                        if (d.ERRORS && d.ERRORS.length > 0) {
                            window.showConfirm(`${msg}\n\nCó ${d.ERRORS.length} dòng lỗi:\n${d.ERRORS.join('\n')}`, () => {});
                        } else {
                            window.showToast(msg, 'success');
                        }
                    } else {
                        window.showToast(res.message || 'Lỗi nhập file.', 'error');
                    }
                })
                .catch(err => {
                    hidePageLoading();
                    progress.classList.add('d-none');
                    window.showToast('Lỗi kết nối: ' + err.message, 'error');
                });
        }

        // Bật/tắt overlay chờ toàn trang (nhập Excel / gán nhóm số lượng lớn)
        function setImportOverlay(show, text) {
            if (text) document.getElementById('import-loading-text').textContent = text;
            document.getElementById('import-loading-overlay').style.display = show ? 'block' : 'none';
        }

        // Import DS học viên từ Excel (EMPCD + tên nhóm) — server tự tạo nhóm thiếu rồi gán,
        // enroll theo lô 50 người/lần phía server để tránh treo khi file lớn
        function submitStudentImport(file) {
            if (!file) return;
            const formData = new FormData();
            formData.append('file', file);
            formData.append('classId', selectedClassId);

            setImportOverlay(true, 'Đang nhập danh sách học viên (xử lý theo lô 50 người)... Vui lòng chờ, không đóng trang.');
            fetch(window.TRAINING_URLS.studentImport, { method: 'POST', body: formData })
                .then(r => r.json())
                .then(res => {
                    setImportOverlay(false);
                    document.getElementById('student-import-file').value = '';
                    if (res.success) {
                        const d = res.data || {};
                        let msg = `Đã nhập: ${d.NEW_INSERTED ?? 0} học viên mới, ${d.SKIPPED_EXISTED ?? 0} đã có sẵn.`;
                        if (d.GROUPS_CREATED > 0) msg += `\nTự tạo ${d.GROUPS_CREATED} nhóm mới.`;
                        if (d.GROUP_ASSIGNED > 0) msg += `\nGán nhóm cho ${d.GROUP_ASSIGNED} học viên.`;
                        if (d.SKIPPED_DROPPED > 0) msg += `\n${d.SKIPPED_DROPPED} người đang bị loại (DROPPED) — cần khôi phục trước.`;
                        loadClassDetailAdmin();
                        if (d.ERRORS && d.ERRORS.length > 0) {
                            window.showConfirm(`${msg}\n\nLỗi:\n${d.ERRORS.join('\n')}`, () => {});
                        } else {
                            window.showToast(msg, 'success');
                        }
                    } else {
                        window.showToast(res.message || 'Lỗi nhập file.', 'error');
                    }
                })
                .catch(err => {
                    setImportOverlay(false);
                    window.showToast('Lỗi kết nối: ' + err.message, 'error');
                });
        }

        // Teachers list — 1 GV có thể phụ trách NHIỀU nhóm: API trả 1 row/nhóm (GROUP_ID null =
        // cả lớp), gom theo EMPCD rồi render badge từng nhóm (có nút × gỡ) + dropdown thêm nhóm.
        function renderSubTeachers() {
            const wrap = document.getElementById('sub-teachers-list');
            const list = selectedClassData.teachers || [];
            const groups = selectedClassData.groups || [];

            if (list.length === 0) {
                wrap.innerHTML = `<p class="text-muted small text-center py-3">Chưa gán giảng viên nào.</p>`;
                return;
            }

            const byEmp = new Map();
            list.forEach(t => {
                if (!byEmp.has(t.EMPCD)) byEmp.set(t.EMPCD, { EMPCD: t.EMPCD, EMP_NAME: t.EMP_NAME, IS_PRIMARY: 0, GROUP_IDS: [] });
                const agg = byEmp.get(t.EMPCD);
                if (t.IS_PRIMARY === 1) agg.IS_PRIMARY = 1;
                if (t.GROUP_ID && !agg.GROUP_IDS.includes(t.GROUP_ID)) agg.GROUP_IDS.push(t.GROUP_ID);
            });

            const gName = id => (groups.find(g => g.ID === id) || {}).GROUP_NAME || `Nhóm #${id}`;
            const rows = [...byEmp.values()].map(t => {
                const badges = t.GROUP_IDS.length === 0
                    ? '<span class="badge bg-secondary-subtle text-secondary-emphasis">Cả lớp</span>'
                    : t.GROUP_IDS.map(gid => `
                        <span class="badge bg-info-subtle text-info-emphasis d-inline-flex align-items-center gap-1">${gName(gid)}
                            <a href="javascript:void(0)" onclick="removeTeacherGroup('${t.EMPCD}', ${gid})" class="text-danger text-decoration-none fw-bold" title="Bỏ nhóm này">×</a>
                        </span>`).join(' ');
                const remaining = groups.filter(g => !t.GROUP_IDS.includes(g.ID));
                const addCtl = remaining.length === 0 ? '' : `
                    <span class="d-inline-flex align-items-center gap-1">
                        <select id="teach-addgrp-${t.EMPCD}" class="form-select form-select-sm w-auto" style="border-radius: 6px;">
                            ${remaining.map(g => `<option value="${g.ID}">${g.GROUP_NAME}</option>`).join('')}
                        </select>
                        <button onclick="addTeacherGroup('${t.EMPCD}')" class="btn btn-xs btn-outline-primary fw-bold px-2" title="Thêm nhóm phụ trách">+</button>
                    </span>`;
                return `
                <tr>
                    <td class="ps-3">
                        <span class="fw-bold vni-font text-dark" style="text-transform:uppercase;">${t.EMP_NAME || t.EMPCD}</span>
                        <span class="small text-muted d-block">${t.EMPCD}</span>
                    </td>
                    <td>${t.IS_PRIMARY === 1
                        ? '<span class="badge bg-primary">GV chính</span>'
                        : '<span class="badge bg-secondary-subtle text-secondary-emphasis">Trợ giảng</span>'}</td>
                    <td>
                        <div class="d-flex align-items-center gap-1 flex-wrap">${badges} ${addCtl}</div>
                    </td>
                    <td class="pe-3 text-end">
                        <button onclick="removeTeacher('${t.EMPCD}')" class="btn btn-xs btn-outline-danger rounded-circle p-1 d-inline-flex align-items-center justify-content-center" title="Gỡ giáo viên">
                            <i class="bi bi-trash" style="font-size:1rem;"></i>
                        </button>
                    </td>
                </tr>`;
            }).join('');

            wrap.innerHTML = `
                <div class="table-responsive" style="max-height: 320px; overflow-y: auto;">
                    <table class="table table-sm align-middle text-nowrap bg-white rounded-3 shadow-sm mb-0">
                        <thead>
                            <tr>
                                <th class="ps-3" data-mobile="primary" data-mobile-slot="name" data-mobile-label="Giáo viên">Giáo viên</th>
                                <th data-mobile="primary" data-mobile-label="Vai trò">Vai trò</th>
                                <th data-mobile="detail" data-mobile-label="Nhóm phụ trách">Nhóm phụ trách</th>
                                <th class="pe-3 text-end" data-mobile="detail" data-mobile-label="Thao tác">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="sub-teachers-tbody">${rows}</tbody>
                    </table>
                </div>`;
            MobileTableHelper.refresh('sub-teachers-tbody');
        }

        // DS nhóm hiện tại của GV (từ rows đã tải — 1 row/nhóm)
        function currentTeacherGroupIds(empcd) {
            return [...new Set((selectedClassData.teachers || [])
                .filter(t => t.EMPCD === empcd && t.GROUP_ID)
                .map(t => t.GROUP_ID))];
        }

        // Lưu DS nhóm ĐẦY ĐỦ của GV (server replace toàn bộ rows) — [] = dạy cả lớp,
        // giữ nguyên vai trò IS_PRIMARY hiện tại
        function saveTeacherGroups(empcd, groupIds) {
            const isPrimary = (selectedClassData.teachers || []).some(t => t.EMPCD === empcd && t.IS_PRIMARY === 1) ? 1 : 0;
            fetch(window.TRAINING_URLS.assignTeacher, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    CLASS_ID: selectedClassId,
                    EMPCD: empcd,
                    IS_PRIMARY: isPrimary,
                    GROUP_IDS: groupIds
                })
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    window.showToast('Đã cập nhật nhóm phụ trách!', 'success');
                    loadClassDetailAdmin();
                } else {
                    window.showToast(res.message || 'Lỗi cập nhật nhóm phụ trách.', 'error');
                }
            })
            .catch(err => window.showToast('Lỗi kết nối: ' + err.message, 'error'));
        }

        function addTeacherGroup(empcd) {
            const sel = document.getElementById('teach-addgrp-' + empcd);
            if (!sel || !sel.value) return;
            saveTeacherGroups(empcd, [...currentTeacherGroupIds(empcd), parseInt(sel.value)]);
        }

        // Gỡ 1 nhóm khỏi GV — hết nhóm thì GV quay về dạy cả lớp (muốn gỡ hẳn dùng nút xóa GV)
        function removeTeacherGroup(empcd, gid) {
            saveTeacherGroups(empcd, currentTeacherGroupIds(empcd).filter(x => x !== gid));
        }

        function openAssignTeacherModal() {
            document.getElementById('teach-empcd').value = '';
            document.getElementById('teach-role').value = '1';
            modalTeacher.show();
        }

        function submitAssignTeacher() {
            const empcd = document.getElementById('teach-empcd').value.trim();
            const role = document.getElementById('teach-role').value;

            if (!empcd) {
                window.showToast('Vui lòng nhập mã giảng viên!', 'warning');
                return;
            }

            // GV đã có trong lớp (re-add để đổi vai trò) → giữ nguyên các nhóm phụ trách hiện tại
            // (server replace toàn bộ rows theo GROUP_IDS). GV mới → [] = dạy cả lớp.
            fetch(window.TRAINING_URLS.assignTeacher, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    CLASS_ID: selectedClassId,
                    EMPCD: empcd,
                    IS_PRIMARY: parseInt(role),
                    GROUP_IDS: currentTeacherGroupIds(empcd)
                })
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    window.showToast('Đã phân công giáo viên thành công!', 'success');
                    modalTeacher.hide();
                    loadClassDetailAdmin();
                } else {
                    window.showToast(res.message || 'Lỗi gán giáo viên.', 'error');
                }
            });
        }

        function removeTeacher(empcd) {
