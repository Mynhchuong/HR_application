@{
    ViewData["Title"] = "Quản lý Lớp học";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var empCd = ViewBag.EmpCd as string;
    var classId = ViewBag.ClassId;
}

<div class="container-fluid py-4">
    <div class="card my-4">
    @await Html.PartialAsync("_TrainingPageHeader", new TrainingPageHeaderVM
    {
        Title = "Quản lý Lớp học",
        Icon = "bi-kanban",
        Gradient = "success",
        BackUrl = Url.Action("MyClasses", "TrainingTeach"),
    })
    <div class="card-body">

    <!-- Header Card -->
    <div class="row mb-4">
        <div class="col-12" id="class-header-container">
            <div class="card border-0 shadow-sm p-4" style="border-radius: 16px;">
                <div class="placeholder-glow">
                    <span class="placeholder col-6 mb-2"></span>
                    <span class="placeholder col-4 mb-3 d-block"></span>
                    <span class="placeholder col-2"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Layout Grid -->
    <div class="row">
        <!-- Left: Sessions & Tests (tách riêng thành 2 tab) -->
        <div class="col-12 col-lg-7 mb-4">
            <div class="card border-0 shadow-sm p-4" style="border-radius: 16px;">
                <ul class="nav nav-tabs mb-4" id="manageTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="sessions-tab-btn" data-bs-toggle="tab" data-bs-target="#sessions-pane" type="button" role="tab" aria-controls="sessions-pane" aria-selected="true">
                            <i class="bi bi-check2-square text-success me-1"></i>
                            Điểm danh & Buổi học
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tests-tab-btn" data-bs-toggle="tab" data-bs-target="#tests-pane" type="button" role="tab" aria-controls="tests-pane" aria-selected="false">
                            <i class="bi bi-star-fill text-warning me-1"></i>
                            Bài kiểm tra & Đánh giá
                        </button>
                    </li>
                </ul>

                <div class="tab-content">
                    <!-- Sessions Timeline -->
                    <div class="tab-pane fade show active" id="sessions-pane" role="tabpanel" aria-labelledby="sessions-tab-btn">
                        <div class="timeline-container" id="sessions-list">
                            <div class="text-center py-4">
                                <div class="spinner-border text-success" role="status"></div>
                            </div>
                        </div>
                        <div id="sessions-pagination" class="d-flex justify-content-center gap-2 mt-3"></div>
                    </div>

                    <!-- Tests Section -->
                    <div class="tab-pane fade" id="tests-pane" role="tabpanel" aria-labelledby="tests-tab-btn">
                        <div class="d-flex justify-content-end align-items-center mb-3 gap-2 flex-wrap">
                            <button type="button" onclick="openCopyTestModal()" class="btn btn-sm btn-outline-info fw-bold rounded-2">
                                <i class="bi bi-files me-1"></i>Chọn / Copy đề thi từ lớp khác cùng khóa
                            </button>
                            <a href="@Url.Action("TestCreate", "TrainingTeach", new { id = classId })" class="btn btn-sm btn-outline-warning fw-bold rounded-2">
                                + Tạo bài thi mới
                            </a>
                        </div>
                        <!-- Chú thích trạng thái -->
                        <div class="d-flex flex-wrap gap-2 mb-3 align-items-center" style="font-size:0.78rem;">
                            <span class="badge bg-secondary">Nháp</span><span class="text-muted">– Học viên chưa làm được</span>
                            <span class="ms-2 badge bg-success">Đang mở</span><span class="text-muted">– Học viên đang làm được</span>
                            <span class="ms-2 badge bg-danger">Đã khóa</span><span class="text-muted">– Đã kết thúc</span>
                        </div>
                        <div id="tests-list">
                            <div class="text-center py-4">
                                <div class="spinner-border text-warning" role="status"></div>
                            </div>
                        </div>
                        <!-- Phân trang -->
                        <div id="tests-pagination" class="d-flex justify-content-center gap-2 mt-3"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Materials & Q&A -->
        <div class="col-12 col-lg-5 mb-4">
            <!-- Materials Section -->
            <div class="card border-0 shadow-sm p-4 mb-4" style="border-radius: 16px;">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold mb-0 d-flex align-items-center gap-2 text-dark">
                        <i class="bi bi-folder2-open text-primary"></i>
                        Tài liệu học tập
                    </h5>
                    <a href="@Url.Action("UploadMaterial", "TrainingTeach", new { id = classId })" class="btn btn-sm btn-outline-success fw-bold rounded-2">
                        Tải lên tài liệu
                    </a>
                </div>
                <div id="materials-list">
                    <div class="text-center py-4">
                        <div class="spinner-border text-success" role="status"></div>
                    </div>
                </div>
            </div>

            <!-- QA Section -->
            <div class="card border-0 shadow-sm p-4" style="border-radius: 16px;">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold mb-0 d-flex align-items-center gap-2 text-dark">
                        <i class="bi bi-chat-dots text-info"></i>
                        Hỏi đáp học viên
                    </h5>
                    <a href="@Url.Action("QA", "TrainingTeach", new { id = classId })" class="btn btn-sm btn-outline-info fw-bold rounded-2">
                        Xem chi tiết Q&A
                    </a>
                </div>
                <div id="qa-list">
                    <div class="text-center py-4">
                        <div class="spinner-border text-info" role="status"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </div>
    </div>
</div>

<!-- Modal Xuất bản -->
<div class="modal fade" id="publishModal" tabindex="-1" aria-labelledby="publishModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="publishModalLabel">
                    <i class="bi bi-send text-warning" id="publishModalIcon" style="vertical-align:middle;"></i>
                    <span id="publishModalTitle">Xuất bản bài kiểm tra</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3" id="publishModalDesc">Sau khi xuất bản, học viên sẽ có thể làm bài trong khoảng thời gian bạn chọn.</p>
                <div class="mb-3">
                    <label class="form-label fw-semibold small" for="pub-from">Thời gian mở bài <span class="text-danger">*</span></label>
                    <input type="datetime-local" id="pub-from" class="form-control rounded-3" required>
                </div>
                <div class="mb-1">
                    <label class="form-label fw-semibold small" for="pub-to">Thời gian đóng bài <span class="text-danger">*</span></label>
                    <input type="datetime-local" id="pub-to" class="form-control rounded-3" required>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary rounded-3" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-warning fw-bold rounded-3" id="confirmPublishBtn" onclick="confirmPublish()">
                    <i class="bi bi-send" style="font-size:.9rem;vertical-align:middle;"></i> Xuất bản
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .timeline-container {
        position: relative;
        padding-left: 24px;
        border-left: 2px solid #dee2e6;
    }
    .timeline-item {
        position: relative;
        padding-bottom: 24px;
    }
    .timeline-item:last-child { padding-bottom: 0; }
    .timeline-badge {
        position: absolute;
        left: -35px;
        top: 4px;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background-color: #dee2e6;
        border: 4px solid #fff;
    }
    .timeline-badge.completed { background-color: #198754; }
    .timeline-badge.ongoing   { background-color: #0d6efd; }
    .timeline-badge.upcoming  { background-color: #adb5bd; }
    .test-action-btn { font-size: 0.75rem; padding: 3px 9px; border-radius: 6px; }
    @@media (max-width: 767.98px) {
        #manageTabs .nav-link { font-size: .78rem; padding: .5rem .65rem; }
        #manageTabs .nav-link i { font-size: .85rem !important; }
    }
</style>

@section Scripts {
<script>
    window.TRAINING_URLS = {
        getClassDetail:   '@Url.Action("GetClassDetail",   "TrainingTeach")',
        getClassTests:    '@Url.Action("GetClassTests",    "Training")',
        deleteMaterial:   '@Url.Action("DeleteMaterial",  "TrainingTeach")',
        getQAList:        '@Url.Action("GetQAList",        "Training")',
        sessionAttendance:'@Url.Action("SessionAttendance","TrainingTeach", new { id = "__ID__" })',
        testGrade:        '@Url.Action("TestGrade",        "TrainingTeach", new { id = "__ID__" })',
        testReport:       '@Url.Action("TestReport",       "TrainingTeach", new { id = "__ID__" })',
        testPublish:      '@Url.Action("TestPublish",      "TrainingTeach")',
        testUpdateSchedule: '@Url.Action("TestUpdateSchedule", "TrainingTeach")',
        testDelete:       '@Url.Action("TestDelete",       "TrainingTeach")',
        testPreview:      '@Url.Action("TestPreview",      "TrainingTeach", new { id = "__ID__" })',
        setFinalTest:     '@Url.Action("SetFinalTest",     "TrainingTeach")',
    };
    const empCd   = '@empCd';
    const classId = @classId;
    let classData  = null;
    let allTests   = [];
    const TESTS_PER_PAGE = 3;

    function esc(s) {
        if (s == null) return '';
        return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    }
    let testsPage  = 1;
    let allSessions = [];
    const SESSIONS_PER_PAGE = 5;
    let sessionsPage = 1;

    document.addEventListener('DOMContentLoaded', function () {
        // loadTestsList() đọc classData.cls.FINAL_TEST_ID để hiện badge "Bài thi cuối khóa" —
        // phải chờ loadClassDetail() gán xong classData, nếu không sẽ race (tests list load
        // xong trước → classData vẫn null → badge không hiện dù DB đã set đúng).
        loadClassDetail().then(() => {
            loadTestsList();
        });
        loadQAList();
    });

    /* ── Class Detail / Header / Sessions / Materials ── */
    function loadClassDetail() {
        return fetch(`${window.TRAINING_URLS.getClassDetail}?classId=${classId}&empcd=${empCd}`)
            .then(r => r.json())
            .then(res => {
                if (!res.success) {
                    document.querySelector('.container-fluid').innerHTML =
                        `<div class="alert alert-warning p-4 text-center">${res.message || 'Lỗi tải lớp học.'}</div>`;
                    return;
                }
                classData = res.data;
                renderHeader();
                renderSessions();
                renderMaterials();
            });
    }

    function renderHeader() {
        const hWrap = document.getElementById('class-header-container');
        const cls = classData.cls;
        // 1 GV có thể nhiều nhóm (1 row/nhóm) → gom theo EMPCD tránh trùng tên, kèm tên các nhóm phụ trách
        const tMap = new Map();
        (classData.teachers || []).forEach(t => {
            if (!tMap.has(t.EMPCD)) tMap.set(t.EMPCD, { NAME: t.EMP_NAME, PRI: 0, GROUPS: [] });
            const agg = tMap.get(t.EMPCD);
            if (t.IS_PRIMARY) agg.PRI = 1;
            if (t.GROUP_NAME && !agg.GROUPS.includes(t.GROUP_NAME)) agg.GROUPS.push(t.GROUP_NAME);
        });
        const teachers = [...tMap.values()].map(t =>
            `<span class="vni-font">${t.NAME}</span> (${t.PRI ? 'Chính' : 'Trợ giảng'}${t.GROUPS.length ? ' – ' + t.GROUPS.join(', ') : ''})`).join(', ');
        hWrap.innerHTML = `
            <div class="card border-0 shadow-sm p-4" style="border-radius:16px;">
                <div class="row align-items-center">
                    <div class="col-12 col-md-8">
                        <span class="badge bg-success px-3 py-2 rounded-pill mb-2">Giảng dạy</span>
                        <h3 class="fw-bold text-dark mb-1">${cls.COURSE_TITLE}</h3>
                        <h6 class="text-muted mb-0">Lớp: ${cls.CLASS_NAME} | Giáo viên: <strong>${teachers || 'Chưa có'}</strong></h6>
                    </div>
                    <div class="col-12 col-md-4 text-md-end mt-3 mt-md-0">
                        <div class="card bg-light border-0 p-3 d-inline-block text-start" style="border-radius:12px;min-width:200px;">
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span>Tổng số buổi:</span>
                                <span class="fw-bold text-dark">${getMySessions().length}</span>
                            </div>
                            <div class="d-flex justify-content-between small text-muted">
                                <span>Tổng học viên:</span>
                                <span class="fw-bold text-dark">${classData.enrollments?.length || 0} học viên</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>`;
    }

    // 1 GV có thể được gán riêng cho 1/nhiều nhóm (GROUP_ID) hoặc dạy cả lớp (GROUP_ID null trên mọi row).
    // Trả về null nếu GV dạy cả lớp (hoặc không phải là GV của lớp, VD HR/Admin xem) → không lọc buổi học.
    function getMyGroupIds() {
        const myRows = (classData.teachers || []).filter(t => t.EMPCD === empCd);
        if (myRows.length === 0 || myRows.some(t => !t.GROUP_ID)) return null;
        return myRows.map(t => t.GROUP_ID);
    }

    // Buổi học GROUP_ID = null áp dụng cho cả lớp → luôn hiện; buổi có GROUP_ID chỉ hiện nếu thuộc nhóm GV phụ trách.
    function getMySessions() {
        const myGroupIds = getMyGroupIds();
        const list = classData.sessions || [];
        const filtered = myGroupIds ? list.filter(s => !s.GROUP_ID || myGroupIds.includes(s.GROUP_ID)) : list;
        return [...filtered].sort((a, b) => {
            const da = new Date(a.SESSION_DATE) - new Date(b.SESSION_DATE);
            return da !== 0 ? da : (a.START_TIME || '').localeCompare(b.START_TIME || '');
        });
    }

    function renderSessions() {
        allSessions  = getMySessions();
        sessionsPage = 1;
        renderSessionsPage();
    }

    // Buổi ONGOING nhưng SYSDATE đã qua END_TIME (còn trong buffer 30' chờ job tự chuyển COMPLETED)
    function sessionEndDateTime(s) {
        if (!s.SESSION_DATE || !s.END_TIME) return null;
        const et = String(s.END_TIME).replace(':', '').padStart(4, '0');
        const endDt = new Date(s.SESSION_DATE);
        endDt.setHours(parseInt(et.slice(0, 2), 10), parseInt(et.slice(2, 4), 10), 0, 0);
        return endDt;
    }
    function isPastSessionEndTime(s) {
        const endDt = sessionEndDateTime(s);
        return !!endDt && new Date() > endDt;
    }
    // Job nền tự chuyển ONGOING -> COMPLETED lúc END_TIME + 30 phút (xem TrainingLifecycleService.cs)
    function getAutoLockTime(s) {
        const endDt = sessionEndDateTime(s);
        if (!endDt) return null;
        return new Date(endDt.getTime() + 30 * 60000);
    }

    function renderSessionsPage() {
        const wrap   = document.getElementById('sessions-list');
        const pagDiv = document.getElementById('sessions-pagination');

        if (allSessions.length === 0) {
            wrap.innerHTML   = '<p class="text-muted small">Chưa sắp xếp lịch học.</p>';
            pagDiv.innerHTML = '';
            return;
        }

        const totalPages = Math.ceil(allSessions.length / SESSIONS_PER_PAGE);
        const start      = (sessionsPage - 1) * SESSIONS_PER_PAGE;
        const pageItems  = allSessions.slice(start, start + SESSIONS_PER_PAGE);

        wrap.innerHTML = '';
        pageItems.forEach(s => {
            let bc = 'upcoming', sl = 'Chưa dạy';
            let lockNote = '';
            if (s.STATUS === 'COMPLETED') { bc = 'completed'; sl = 'Đã kết thúc'; }
            else if (s.STATUS === 'ONGOING') {
                bc = 'ongoing';
                // Hệ thống chỉ tự chuyển ONGOING -> COMPLETED sau khi hết giờ 30 phút (tránh chốt vắng
                // nhầm khi lớp trễ giờ) — ghi rõ "chờ chốt" + GIỜ KHOÁ CỤ THỂ thay vì im im không ai biết.
                if (isPastSessionEndTime(s)) {
                    sl = 'Chờ chốt điểm danh';
                    const lockDt = getAutoLockTime(s);
                    if (lockDt) lockNote = `<div class="small text-warning fw-bold mt-1"><i class="bi bi-lock-clock me-1"></i>Hệ thống sẽ tự khóa điểm danh lúc ${lockDt.toLocaleTimeString('vi-VN', {hour:'2-digit',minute:'2-digit'})}</div>`;
                } else {
                    sl = 'Đang diễn ra';
                }
            }
            const sDate = s.SESSION_DATE ? new Date(s.SESSION_DATE).toLocaleDateString('vi-VN') : '';
            const fmtTime = t => {
                if (!t) return '';
                const s2 = String(t).replace(':', '').padStart(4, '0');
                return s2.slice(0, 2) + ':' + s2.slice(2, 4);
            };
            const groupBadge = s.GROUP_NAME
                ? `<span class="badge bg-info-subtle text-info-emphasis border border-info-subtle ms-2">${s.GROUP_NAME}</span>`
                : '';
            wrap.innerHTML += `
                <div class="timeline-item">
                    <div class="timeline-badge ${bc}"></div>
                    <div class="card border bg-white p-3 shadow-sm rounded-3">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h6 class="fw-bold mb-0 text-dark">Buổi ${s.SESSION_NO}: ${s.TOPIC || 'Chủ đề'}${groupBadge}</h6>
                                <span class="small text-muted">${sDate} | ${fmtTime(s.START_TIME)} - ${fmtTime(s.END_TIME)}</span>
                                ${lockNote}
                            </div>
                            <span class="badge bg-light text-dark border">${sl}</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2 flex-wrap gap-2">
                            <span class="small text-muted"><i class="bi bi-geo-alt"></i> Phòng: ${s.LOCATION || 'N/A'}</span>
                            <a href="${window.TRAINING_URLS.sessionAttendance.replace('__ID__', s.ID)}" class="btn btn-sm btn-success px-3 rounded-2 fw-bold">
                                Điểm danh buổi
                            </a>
                        </div>
                    </div>
                </div>`;
        });

        pagDiv.innerHTML = '';
        if (totalPages > 1) {
            for (let i = 1; i <= totalPages; i++) {
                const btn = document.createElement('button');
                btn.className   = `btn btn-sm ${i === sessionsPage ? 'btn-success' : 'btn-outline-secondary'}`;
                btn.textContent = i;
                btn.onclick     = () => { sessionsPage = i; renderSessionsPage(); };
                pagDiv.appendChild(btn);
            }
        }
    }

    function renderMaterials() {
        const mList = document.getElementById('materials-list');
        const list  = classData.materials || [];
        if (list.length === 0) { mList.innerHTML = '<p class="text-muted small">Chưa đăng tải tài liệu học tập nào.</p>'; return; }
        mList.innerHTML = '';
        list.forEach(m => {
            mList.innerHTML += `
                <div class="card border p-3 mb-2 rounded-3 shadow-sm d-flex justify-content-between align-items-center flex-row">
                    <div class="min-w-0 flex-fill">
                        <h6 class="fw-bold mb-0 text-dark text-truncate" title="${m.TITLE}">${m.TITLE}</h6>
                        <span class="small text-muted">${m.FILE_TYPE} | ${m.IS_REQUIRED === 1 ? 'Bắt buộc' : 'Tùy chọn'}</span>
                    </div>
                    <div class="d-flex gap-1 ms-2">
                        <a href="${m.FILE_URL}" download="${m.FILE_NAME || m.TITLE || 'tailieu'}" class="btn btn-xs btn-outline-primary rounded-circle p-1 d-flex align-items-center">
                            <i class="bi bi-download" style="font-size:1rem;"></i>
                        </a>
                        <button onclick="deleteMaterial(${m.ID})" class="btn btn-xs btn-outline-danger rounded-circle p-1 d-flex align-items-center">
                            <i class="bi bi-trash" style="font-size:1rem;"></i>
                        </button>
                    </div>
                </div>`;
        });
    }

    function deleteMaterial(id) {
        window.showConfirm('Bạn chắc chắn muốn xóa tài liệu này không?', () => {
            fetch(window.TRAINING_URLS.deleteMaterial, {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ID: id })
            }).then(r => r.json()).then(res => {
                if (res.success) { window.showToast('Xóa tài liệu thành công!', 'success'); loadClassDetail(); }
                else window.showToast(res.message || 'Lỗi xóa tài liệu.', 'error');
            });
        });
    }

    /* ── Tests ── */
    function loadTestsList() {
        fetch(`${window.TRAINING_URLS.getClassTests}?classId=${classId}`)
            .then(r => r.json())
            .then(res => {
                if (!res.success) {
                    document.getElementById('tests-list').innerHTML = '<p class="text-danger small">Lỗi tải danh sách bài test.</p>';
                    return;
                }
                allTests  = res.data || [];
                testsPage = 1;
                renderTestsPage();
            });
    }

    function renderTestsPage() {
        const wrap   = document.getElementById('tests-list');
        const pagDiv = document.getElementById('tests-pagination');

        if (allTests.length === 0) {
            wrap.innerHTML   = '<div class="text-center py-3 text-muted small">Lớp học chưa tạo bài kiểm tra nào.</div>';
            pagDiv.innerHTML = '';
            return;
        }

        const totalPages = Math.ceil(allTests.length / TESTS_PER_PAGE);
        const start      = (testsPage - 1) * TESTS_PER_PAGE;
        const pageItems  = allTests.slice(start, start + TESTS_PER_PAGE);

        wrap.innerHTML = '';
        pageItems.forEach(t => {
            const statusMap = {
                DRAFT:     { label: 'Nháp',     cls: 'secondary' },
                PUBLISHED: { label: 'Đang mở',  cls: 'success'   },
                CLOSED:    { label: 'Đã khóa',  cls: 'danger'    },
            };
            const st       = statusMap[t.STATUS] || { label: t.STATUS, cls: 'secondary' };
            const isDraft  = t.STATUS === 'DRAFT';
            const canGrade = t.STATUS !== 'DRAFT';
            const qCount   = t.QUESTION_COUNT || 0;
            const aCount   = t.ATTEMPT_COUNT  || 0;

            const publishBtn = isDraft ? `
                <button onclick="publishTest(${t.ID})" class="btn btn-sm btn-warning test-action-btn fw-bold">
                    <i class="bi bi-send" style="font-size:.85rem;vertical-align:middle;"></i> Xuất bản
                </button>` : '';

            // Bài đã xuất bản (PUBLISHED/OPEN) — cho sửa lại ngày mở/đóng nếu chọn nhầm hoặc cần gia hạn.
            const editScheduleBtn = (t.STATUS === 'PUBLISHED' || t.STATUS === 'OPEN') ? `
                <button onclick="editTestSchedule(${t.ID}, '${t.AVAILABLE_FROM || ''}', '${t.AVAILABLE_TO || ''}')" class="btn btn-sm btn-outline-warning test-action-btn fw-bold" title="Sửa ngày mở/đóng bài">
                    <i class="bi bi-calendar-event" style="font-size:.85rem;vertical-align:middle;"></i> Sửa thời gian
                </button>` : '';

            const deleteBtn  = isDraft ? `
                <button onclick="deleteTest(${t.ID})" class="btn btn-sm btn-outline-danger test-action-btn" title="Xóa bài nháp">
                    <i class="bi bi-trash" style="font-size:.85rem;vertical-align:middle;"></i>
                </button>` : '';

            const previewBtn = `
                <a href="${window.TRAINING_URLS.testPreview.replace('__ID__', t.ID)}" class="btn btn-sm btn-outline-info test-action-btn" title="Xem thử đề thi">
                    <i class="bi bi-eye" style="font-size:.85rem;vertical-align:middle;"></i>
                </a>`;

            const gradeBtn   = canGrade ? `
                <a href="${window.TRAINING_URLS.testGrade.replace('__ID__', t.ID)}" class="btn btn-sm btn-outline-warning test-action-btn fw-bold">
                    <i class="bi bi-clipboard-check" style="font-size:.85rem;vertical-align:middle;"></i> Chấm tự luận
                </a>` : '';

            // Xem điểm tất cả học viên + chi tiết ai sai câu nào (khác gradeBtn ở trên vốn chỉ để
            // chấm tay các câu tự luận) — hiện khi bài đã publish trở đi, đã có người làm.
            const reportBtn  = canGrade ? `
                <a href="${window.TRAINING_URLS.testReport.replace('__ID__', t.ID)}" class="btn btn-sm btn-outline-primary test-action-btn fw-bold">
                    <i class="bi bi-clipboard-data" style="font-size:.85rem;vertical-align:middle;"></i> Xem điểm &amp; câu sai
                </a>` : '';

            const draftNote  = isDraft ? `
                <div class="alert alert-warning border-0 py-1 px-2 mb-2 rounded-2" style="font-size:.78rem;">
                    <i class="bi bi-info-circle" style="font-size:.9rem;vertical-align:middle;"></i>
                    Học viên <strong>chưa</strong> làm được. Nhấn <strong>Xuất bản</strong> để mở.
                </div>` : '';

            const isFinalTest = classData && classData.cls && (t.ID == classData.cls.FINAL_TEST_ID || t.ID == classData.cls.finalTestId);
            const finalTestBadge = isFinalTest ? `
                <span class="badge bg-danger text-white ms-2 d-inline-flex align-items-center gap-1" style="font-size:0.75rem;">
                    <i class="bi bi-award" style="font-size:.9rem;"></i> Bài thi cuối khóa
                </span>` : '';

            const setFinalBtn = (!isFinalTest) ? `
                <button onclick="setFinalTest(${t.ID})" class="btn btn-sm btn-outline-danger test-action-btn fw-bold py-1 px-2.5 rounded-2 d-inline-flex align-items-center gap-1" style="font-size:0.78rem;" title="Đặt làm bài thi cuối khóa">
                    <i class="bi bi-award" style="font-size:1rem;"></i> Đặt làm Bài thi cuối khóa
                </button>` : '';

            wrap.innerHTML += `
                <div class="card border p-3 mb-3 rounded-3 shadow-sm ${isFinalTest ? 'border-danger-subtle bg-danger-faint' : ''}">
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <h6 class="fw-bold mb-0 text-dark d-flex align-items-center">${t.TITLE} ${finalTestBadge}</h6>
                        <span class="badge bg-${st.cls} ms-2">${st.label}</span>
                    </div>
                    <p class="text-muted small mb-2">
                        ${t.DURATION_MINUTES} phút&nbsp;|&nbsp;Điểm sàn: ${t.PASS_SCORE ?? '—'}&nbsp;|&nbsp;${qCount} câu hỏi&nbsp;|&nbsp;${aCount} lượt làm
                    </p>
                    ${draftNote}
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mt-2">
                        <div class="d-flex flex-wrap gap-1">
                            ${publishBtn}${editScheduleBtn}${reportBtn}${gradeBtn}${previewBtn}${deleteBtn}
                        </div>
                        ${setFinalBtn}
                    </div>
                </div>`;
        });

        /* Pagination buttons */
        pagDiv.innerHTML = '';
        if (totalPages > 1) {
            for (let i = 1; i <= totalPages; i++) {
                const btn = document.createElement('button');
                btn.className   = `btn btn-sm ${i === testsPage ? 'btn-warning' : 'btn-outline-secondary'}`;
                btn.textContent = i;
                btn.onclick     = () => { testsPage = i; renderTestsPage(); };
                pagDiv.appendChild(btn);
            }
        }
    }

    let _publishTestId = null;
    let _publishMode = 'publish'; // 'publish' (DRAFT -> PUBLISHED) | 'reschedule' (sửa ngày bài đã publish)

    function publishTest(id) {
        _publishTestId = id;
        _publishMode = 'publish';
        // Đặt giá trị mặc định: từ bây giờ đến 7 ngày sau
        const now = new Date();
        const toDate = new Date(now.getTime() + 7 * 24 * 60 * 60 * 1000);
        const toLocal = d => new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
        document.getElementById('pub-from').value = toLocal(now);
        document.getElementById('pub-to').value   = toLocal(toDate);
        document.getElementById('confirmPublishBtn').innerHTML = '<i class="bi bi-send" style="font-size:.9rem;vertical-align:middle;"></i> Xuất bản';
        document.getElementById('publishModalTitle').textContent = 'Xuất bản bài kiểm tra';
        document.getElementById('publishModalDesc').textContent = 'Sau khi xuất bản, học viên sẽ có thể làm bài trong khoảng thời gian bạn chọn.';
        document.getElementById('publishModalIcon').className = 'bi bi-send text-warning';
        new bootstrap.Modal(document.getElementById('publishModal')).show();
    }

    // Sửa ngày mở/đóng cho bài ĐÃ xuất bản — cùng modal với publishTest, chỉ đổi mode + endpoint gọi.
    function editTestSchedule(id, currentFrom, currentTo) {
        _publishTestId = id;
        _publishMode = 'reschedule';
        const toLocal = iso => {
            if (!iso) return '';
            const d = new Date(iso);
            return new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
        };
        document.getElementById('pub-from').value = toLocal(currentFrom);
        document.getElementById('pub-to').value   = toLocal(currentTo);
        document.getElementById('confirmPublishBtn').innerHTML = '<i class="bi bi-calendar-event" style="font-size:.9rem;vertical-align:middle;"></i> Lưu thời gian';
        document.getElementById('publishModalTitle').textContent = 'Sửa thời gian bài kiểm tra';
        document.getElementById('publishModalDesc').textContent = 'Bài đã xuất bản — cập nhật lại khoảng thời gian học viên được làm bài.';
        document.getElementById('publishModalIcon').className = 'bi bi-calendar-event text-warning';
        new bootstrap.Modal(document.getElementById('publishModal')).show();
    }

    function confirmPublish() {
        const from = document.getElementById('pub-from').value;
        const to   = document.getElementById('pub-to').value;
        if (!from || !to) { window.showToast('Vui lòng nhập đầy đủ thời gian mở và đóng bài.', 'error'); return; }
        if (new Date(to) <= new Date(from)) { window.showToast('Thời gian đóng bài phải sau thời gian mở bài.', 'error'); return; }

        const isReschedule = _publishMode === 'reschedule';
        const url = isReschedule ? window.TRAINING_URLS.testUpdateSchedule : window.TRAINING_URLS.testPublish;

        const btn = document.getElementById('confirmPublishBtn');
        btn.disabled = true;
        btn.textContent = isReschedule ? 'Đang lưu...' : 'Đang xuất bản...';

        fetch(url, {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ID: _publishTestId, AVAILABLE_FROM: from, AVAILABLE_TO: to })
        }).then(r => r.json()).then(res => {
            bootstrap.Modal.getInstance(document.getElementById('publishModal')).hide();
            btn.disabled = false;
            btn.innerHTML = isReschedule
                ? '<i class="bi bi-calendar-event" style="font-size:.9rem;vertical-align:middle;"></i> Lưu thời gian'
                : '<i class="bi bi-send" style="font-size:.9rem;vertical-align:middle;"></i> Xuất bản';
            if (res.success) {
                window.showToast(isReschedule ? 'Đã cập nhật thời gian!' : 'Xuất bản thành công!', 'success');
                loadTestsList();
            } else {
                window.showToast(res.message || (isReschedule ? 'Lỗi cập nhật thời gian.' : 'Lỗi xuất bản.'), 'error');
            }
        });
    }

    function deleteTest(id) {
        window.showConfirm('Xóa bài kiểm tra nháp này? Hành động không thể hoàn tác.', () => {
            fetch(window.TRAINING_URLS.testDelete, {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ID: id })
            }).then(r => r.json()).then(res => {
                if (res.success) { window.showToast('Xóa thành công!', 'success'); loadTestsList(); }
                else window.showToast(res.message || 'Lỗi xóa.', 'error');
            });
        });
    }

    /* ── Q&A ── */
    function loadQAList() {
        fetch(`${window.TRAINING_URLS.getQAList}?classId=${classId}&empcd=${empCd}`)
            .then(r => r.json())
            .then(res => {
                const qaWrap = document.getElementById('qa-list');
                if (!res.success) { qaWrap.innerHTML = '<p class="text-danger small">Lỗi tải Q&A.</p>'; return; }
                const list = res.data || [];
                const pendingCount = list.filter(q => !q.ANSWER_TEXT).length;
                if (list.length === 0) { qaWrap.innerHTML = '<p class="text-muted small">Không có câu hỏi thảo luận nào.</p>'; return; }
                qaWrap.innerHTML = `
                    <div class="alert alert-info border-0 p-3 mb-0 rounded-3">
                        Đang có <strong>${pendingCount}</strong> câu hỏi chờ bạn trả lời.
                    </div>`;
            });
    }

    function setFinalTest(testId) {
        window.showConfirm('Bạn muốn đặt bài thi này làm Bài thi cuối khóa (Final Test) của lớp học? Học viên bắt buộc phải thi đạt bài này mới được chốt hoàn thành lớp học.', () => {
            fetch(window.TRAINING_URLS.setFinalTest, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ CLASS_ID: classId, TEST_ID: testId })
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    window.showToast('Đã thiết lập bài thi cuối khóa thành công!', 'success');
                    loadClassDetail().then(() => {
                        loadTestsList();
                    });
                } else {
                    window.showToast(res.message || 'Lỗi thiết lập bài thi cuối khóa.', 'error');
                }
            })
            .catch(err => window.showToast('Lỗi kết nối: ' + err.message, 'error'));
        }, {
            title: 'Thiết lập Bài thi cuối khóa',
            okText: 'Xác nhận',
            okClass: 'btn-danger',
            icon: 'workspace_premium',
            iconColor: '#dc3545',
            iconBg: '#f8d7da'
        });
    }

    window.openCopyTestModal = async function() {
        const modalEl = document.getElementById('copyTestModal');
        const modal = new bootstrap.Modal(modalEl);
        modal.show();
        
        const loading = document.getElementById('copy-tests-loading');
        const container = document.getElementById('copy-tests-container');
        loading.classList.remove('d-none');
        container.classList.add('d-none');

        try {
            const res = await fetch(`@Url.Action("GetCourseTests", "TrainingTeach")?classId=${classId}`);
            const json = await res.json();
            
            if (!json.success || !json.data || json.data.length === 0) {
                container.innerHTML = `<div class="alert alert-warning mb-0 text-center">Chưa có bài kiểm tra nào được tạo trong khóa học này.</div>`;
            } else {
                const tests = json.data;
                container.innerHTML = `
                    <div class="list-group">
                        ${tests.map(t => `
                            <div class="list-group-item p-3 d-flex justify-content-between align-items-center flex-wrap gap-2 rounded-3 mb-2 border shadow-sm">
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                        <h6 class="fw-bold mb-0 text-dark">${esc(t.TITLE)}</h6>
                                        <span class="badge bg-secondary-subtle text-secondary-emphasis">${t.QUESTION_COUNT} câu hỏi</span>
                                        <span class="badge bg-info-subtle text-info-emphasis">${t.DURATION_MINUTES} phút</span>
                                        ${t.CLASS_ID === classId ? '<span class="badge bg-success">Đang thuộc Lớp này</span>' : `<span class="badge bg-light text-dark border">Lớp: ${esc(t.CLASS_NAME || 'Đề mẫu khóa')}</span>`}
                                    </div>
                                    <div class="small text-muted">${esc(t.DESCRIPTION || 'Không có mô tả')}</div>
                                </div>
                                <div class="d-flex gap-2 flex-wrap">
                                    ${t.CLASS_ID !== classId ? `
                                        <button type="button" onclick="doCopyTest(${t.ID}, false)" class="btn btn-sm btn-primary fw-bold rounded-2 shadow-sm">
                                            <i class="bi bi-copy me-1"></i>Sao chép sang Lớp này
                                        </button>
                                        <button type="button" onclick="doCopyTest(${t.ID}, true)" class="btn btn-sm btn-outline-primary fw-bold rounded-2">
                                            <i class="bi bi-intersect me-1"></i>Áp dụng cho ALL Lớp cùng Khóa
                                        </button>
                                    ` : '<span class="small text-success fw-bold"><i class="bi bi-check-circle me-1"></i>Đã có sẵn trong Lớp</span>'}
                                </div>
                            </div>
                        `).join('')}
                    </div>
                `;
            }
        } catch (err) {
            container.innerHTML = `<div class="alert alert-danger mb-0">Lỗi kết nối máy chủ.</div>`;
        } finally {
            loading.classList.add('d-none');
            container.classList.remove('d-none');
        }
    };

    window.doCopyTest = async function(sourceTestId, copyToAll) {
        const msg = copyToAll 
            ? 'Bạn có chắc chắn muốn sao chép đề thi này sang TẤT CẢ các lớp học khác trong cùng khóa?' 
            : 'Bạn có chắc chắn muốn sao chép đề thi này sang lớp học hiện tại?';
        
        window.showConfirm(msg, async () => {
            try {
                const res = await fetch('@Url.Action("CopyTest", "TrainingTeach")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        source_test_id: sourceTestId,
                        target_class_id: classId,
                        copy_to_all_classes_in_course: copyToAll
                    })
                });
                const json = await res.json();
                if (json.success) {
                    window.showToast(json.message || 'Đã sao chép đề thi thành công!', 'success');
                    const modalEl = document.getElementById('copyTestModal');
                    const modalInstance = bootstrap.Modal.getInstance(modalEl);
                    if (modalInstance) modalInstance.hide();
                    if (typeof loadTestsList === 'function') loadTestsList();
                } else {
                    window.showToast(json.message || 'Lỗi sao chép đề thi', 'error');
                }
            } catch (err) {
                window.showToast('Lỗi kết nối máy chủ', 'error');
            }
        }, {
            title: 'Sao chép Đề thi',
            icon: 'content_copy',
            iconColor: '#0d6efd',
            iconBg: '#e7f1ff',
            okText: 'Sao chép',
            okClass: 'btn-primary',
        });
    };
</script>

<!-- Modal Copy Đề Thi -->
<div class="modal fade" id="copyTestModal" tabindex="-1" aria-labelledby="copyTestModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="copyTestModalLabel">
                    <i class="bi bi-files text-info me-2"></i>Chọn Đề thi từ Lớp khác cùng Khóa học
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-3">
                <div class="alert alert-info border-0 p-3 mb-3 rounded-3 small">
                    <i class="bi bi-info-circle me-1"></i> Các đề thi đã tạo ở các lớp khác thuộc cùng khóa học sẽ được liệt kê bên dưới. Giảng viên chỉ cần bấm <strong>"Sao chép sang Lớp này"</strong> hoặc <strong>"Áp dụng cho ALL Lớp"</strong> mà không cần tạo lại đề thi!
                </div>
                <div id="copy-tests-loading" class="text-center py-4">
                    <div class="spinner-border text-info" role="status"></div>
                    <p class="mt-2 text-muted small mb-0">Đang tìm danh sách đề thi trong khóa...</p>
                </div>
                <div id="copy-tests-container" class="d-none">
                    <!-- List of available tests -->
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light fw-bold rounded-3" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

