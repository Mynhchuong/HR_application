@{
    ViewData["Title"] = "Lớp giảng dạy";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var empCd = ViewBag.EmpCd as string;
}

<div class="container-fluid py-4">
    @await Html.PartialAsync("_TrainingHeroBanner", new TrainingHeroBannerVM
    {
        Title = "Quản Lý Lớp Học Giảng Dạy",
        Subtitle = "Điểm danh học viên, quản lý và đăng tải tài liệu giảng dạy, chấm điểm tự luận các bài thi.",
        Gradient = "success",
        IllustrationImg = "~/assets/img/illustrations/giaovien.png",
    })

    <!-- Quick Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-4">
            <div class="card stats-card border-0 shadow-sm p-4 h-100" data-filter-status="" style="border-radius: 16px; border-left: 5px solid #0d6efd !important;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="text-muted small fw-bold text-uppercase mb-1">Tổng lớp phụ trách</h6>
                        <h3 class="fw-bold mb-0 text-dark" id="stat-total-classes">0</h3>
                    </div>
                    <i class="bi bi-easel text-primary bg-primary-subtle text-primary-emphasis p-3 rounded-3" style="font-size: 2rem;"></i>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-4">
            <div class="card stats-card border-0 shadow-sm p-4 h-100" data-filter-status="IN_PROGRESS" style="border-radius: 16px; border-left: 5px solid #198754 !important;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="text-muted small fw-bold text-uppercase mb-1">Lớp đang giảng dạy</h6>
                        <h3 class="fw-bold mb-0 text-success" id="stat-active-classes">0</h3>
                    </div>
                    <i class="bi bi-journal-text text-success bg-success-subtle text-success-emphasis p-3 rounded-3" style="font-size: 2rem;"></i>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-4">
            <div class="card stats-card border-0 shadow-sm p-4 h-100" data-filter-status="COMPLETED" style="border-radius: 16px; border-left: 5px solid #6c757d !important;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="text-muted small fw-bold text-uppercase mb-1">Lớp đã kết thúc</h6>
                        <h3 class="fw-bold mb-0 text-secondary" id="stat-completed-classes">0</h3>
                    </div>
                    <i class="bi bi-mortarboard text-secondary bg-secondary-subtle text-secondary-emphasis p-3 rounded-3" style="font-size: 2rem;"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter & View Controls -->
    <div class="card filter-bar border-0 shadow-sm p-3 mb-4" style="border-radius: 16px;">
        <div class="row align-items-center g-3">
            <div class="col-12 col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-0" style="border-radius: 10px 0 0 10px;"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="search-input" class="form-control bg-light border-0" placeholder="Tìm kiếm tên lớp, khóa học..." style="border-radius: 0 10px 10px 0; height: 45px;" oninput="filterAndRender()" />
                </div>
            </div>
            <div class="col-12 col-md-3">
                <select id="filterStatus" class="form-select bg-light border-0" style="border-radius: 10px; height: 45px;" onchange="filterAndRender()">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="IN_PROGRESS">Đang giảng dạy</option>
                    <option value="SCHEDULED">Đã lên lịch</option>
                    <option value="COMPLETED">Đã kết thúc</option>
                    <option value="DRAFT">Nháp</option>
                    <option value="OPEN_FOR_REGISTRATION">Đang mở đăng ký</option>
                </select>
            </div>
            <div class="col-12 col-md-4 text-end d-flex align-items-center justify-content-md-end gap-2">
                <span class="small text-muted me-2 d-none d-lg-inline">Chế độ xem:</span>
                <button type="button" class="btn btn-light shadow-sm py-2 px-3 fw-bold d-inline-flex align-items-center gap-1 active-view-btn" id="btn-grid-view" onclick="switchView('grid')" style="border-radius: 10px; height: 45px;">
                    <i class="bi bi-grid-3x3-gap"></i> Lưới
                </button>
                <button type="button" class="btn btn-light shadow-sm py-2 px-3 fw-bold d-inline-flex align-items-center gap-1" id="btn-table-view" onclick="switchView('table')" style="border-radius: 10px; height: 45px;">
                    <i class="bi bi-list-ul"></i> Bảng
                </button>
            </div>
        </div>
    </div>

    <!-- Main Classes Content Area -->
    <div id="classes-list-container">
        <!-- Rendered dynamically -->
        <div class="text-center py-5">
            <div class="spinner-border text-success" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3 text-muted">Đang tải danh sách lớp học của bạn...</p>
        </div>
    </div>
</div>

<style>
    .teacher-class-card {
        border-radius: 20px;
        border: 1px solid rgba(0,0,0,0.05);
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        background: #fff;
    }
    .teacher-class-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 16px 32px rgba(0, 0, 0, 0.08) !important;
    }    .active-view-btn {
        background-color: #198754 !important;
        color: #fff !important;
        border: none !important;
    }
    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>

@section Scripts {
    <script>
        window.TRAINING_URLS = {
            getTeacherClasses: '@Url.Action("GetTeacherClasses", "TrainingTeach")',
            classManage: '@Url.Action("ClassManage", "TrainingTeach", new { id = "__ID__" })'
        };
        const empCd = '@empCd';
        let allClasses = [];
        let viewMode = 'grid';

        document.addEventListener('DOMContentLoaded', function () {
            loadTeacherClasses();
            MobileTableHelper.init('teacher-classes-tbody');
        });

        function loadTeacherClasses() {
            fetch(`${window.TRAINING_URLS.getTeacherClasses}?empcd=${empCd}`)
                .then(r => r.json())
                .then(res => {
                    if (!res.success) {
                        document.getElementById('classes-list-container').innerHTML = `
                            <div class="alert alert-warning text-center p-4">${res.message || 'Lỗi tải danh sách lớp.'}</div>
                        `;
                        return;
                    }

                    allClasses = res.data || [];
                    computeStats();
                    filterAndRender();
                })
                .catch(err => {
                    document.getElementById('classes-list-container').innerHTML = `
                        <div class="alert alert-danger text-center p-4">Lỗi kết nối hệ thống: ${err.message}</div>
                    `;
                });
        }

        function computeStats() {
            document.getElementById('stat-total-classes').textContent = allClasses.length;
            document.getElementById('stat-active-classes').textContent = allClasses.filter(c => (c.STATUS || c.status) === 'IN_PROGRESS').length;
            document.getElementById('stat-completed-classes').textContent = allClasses.filter(c => (c.STATUS || c.status) === 'COMPLETED').length;
        }

        function filterAndRender() {
            const searchVal = document.getElementById('search-input').value.toLowerCase().trim();
            const statusVal = document.getElementById('filterStatus').value;
            
            let filtered = allClasses;
            if (searchVal) {
                filtered = filtered.filter(c => 
                    (c.CLASS_NAME || c.className || '').toLowerCase().includes(searchVal) ||
                    (c.COURSE_TITLE || c.courseTitle || '').toLowerCase().includes(searchVal)
                );
            }
            if (statusVal) {
                filtered = filtered.filter(c => (c.STATUS || c.status) === statusVal);
            }
            
            renderClasses(filtered);
        }

        function switchView(mode) {
            viewMode = mode;
            document.getElementById('btn-grid-view').classList.toggle('active-view-btn', mode === 'grid');
            document.getElementById('btn-table-view').classList.toggle('active-view-btn', mode === 'table');
            filterAndRender();
        }

        function renderClasses(list) {
            const container = document.getElementById('classes-list-container');
            if (list.length === 0) {
                container.innerHTML = `
                    <div class="card border-0 shadow-sm text-center py-5" style="border-radius: 16px;">
                        <i class="bi bi-search text-muted" style="font-size: 5rem;"></i>
                        <h5 class="fw-bold text-dark mt-3">Không tìm thấy lớp học phù hợp</h5>
                        <p class="text-muted small">Vui lòng điều chỉnh lại bộ lọc tìm kiếm của bạn.</p>
                    </div>
                `;
                return;
            }

            if (viewMode === 'table') {
                renderTableView(list, container);
            } else {
                renderGridView(list, container);
            }
        }

        function renderGridView(list, container) {
            let html = '<div class="row">';
            list.forEach(item => {
                const classId = item.ID || item.id;
                const courseTitle = item.COURSE_TITLE || item.courseTitle || 'Chưa rõ khóa học';
                const className = item.CLASS_NAME || item.className || 'Chưa rõ';
                const start = item.START_DATE || item.startDate ? new Date(item.START_DATE || item.startDate).toLocaleDateString('vi-VN') : 'N/A';
                const end = item.END_DATE || item.endDate ? new Date(item.END_DATE || item.endDate).toLocaleDateString('vi-VN') : 'N/A';
                const status = item.STATUS || item.status || 'DRAFT';
                const sessionCount = item.SESSION_COUNT || item.sessionCount || 0;
                
                // FIXED BUG 1: Map ENROLLMENT_COUNT/enrollmentCount correctly
                const studentCount = item.ENROLLMENT_COUNT || item.enrollmentCount || 0;

                const badge = getStatusBadge(status);

                html += `
                    <div class="col-12 col-md-6 col-lg-4 mb-4">
                        <div class="card h-100 border-0 shadow-sm teacher-class-card">
                            <div class="card-body p-4 d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-3 gap-1">
                                    <span class="badge ${badge.cls} px-2.5 py-1.5 fw-bold small">${badge.label}</span>
                                    <span class="small text-muted fw-medium">${start} - ${end}</span>
                                </div>
                                <h5 class="fw-bold text-dark mb-1 text-truncate-2" style="line-height: 1.4; height: 2.8rem; overflow: hidden;" title="${courseTitle}">${courseTitle}</h5>
                                <p class="text-muted small mb-3">Mã lớp: <strong class="text-dark">${className}</strong></p>

                                <div class="card bg-light border-0 p-3 mb-4" style="border-radius: 12px;">
                                    <div class="d-flex justify-content-between small text-muted mb-2">
                                        <span><i class="bi bi-calendar3 me-1"></i>Tổng số buổi:</span>
                                        <span class="fw-bold text-dark">${sessionCount} buổi</span>
                                    </div>
                                    <div class="d-flex justify-content-between small text-muted">
                                        <span><i class="bi bi-people-fill me-1"></i>Sĩ số học viên:</span>
                                        <span class="fw-bold text-success">${studentCount} học viên</span>
                                    </div>
                                </div>

                                <div class="mt-auto">
                                    <a href="${window.TRAINING_URLS.classManage.replace('__ID__', classId)}" class="btn btn-success w-100 py-2.5 rounded-3 fw-bold d-flex align-items-center justify-content-center gap-1 shadow-sm">
                                        <i class="bi bi-calendar-check" style="font-size: 1.2rem;"></i>
                                        Quản lý lớp học
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            });
            html += '</div>';
            container.innerHTML = html;
        }

        function renderTableView(list, container) {
            let html = `
                <div class="card border-0 shadow-sm p-4" style="border-radius: 16px;">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle text-nowrap">
                            <thead>
                                <tr class="table-light">
                                    <th class="ps-3" data-mobile="primary" data-mobile-slot="name" data-mobile-label="Khóa học">Khóa học</th>
                                    <th data-mobile="primary" data-mobile-slot="code" data-mobile-label="Mã lớp">Mã lớp</th>
                                    <th data-mobile="detail" data-mobile-label="Thời gian học">Thời gian học</th>
                                    <th class="text-center" data-mobile="detail" data-mobile-label="Số buổi">Số buổi</th>
                                    <th class="text-center" data-mobile="primary" data-mobile-label="Sĩ số">Sĩ số</th>
                                    <th class="text-center" data-mobile="primary" data-mobile-label="Trạng thái">Trạng thái</th>
                                    <th class="text-end pe-3" data-mobile="detail" data-mobile-label="Hành động">Hành động</th>
                                </tr>
                            </thead>
                            <tbody id="teacher-classes-tbody">
            `;

            list.forEach(item => {
                const classId = item.ID || item.id;
                const courseTitle = item.COURSE_TITLE || item.courseTitle || 'Chưa rõ khóa học';
                const className = item.CLASS_NAME || item.className || 'Chưa rõ';
                const start = item.START_DATE || item.startDate ? new Date(item.START_DATE || item.startDate).toLocaleDateString('vi-VN') : 'N/A';
                const end = item.END_DATE || item.endDate ? new Date(item.END_DATE || item.endDate).toLocaleDateString('vi-VN') : 'N/A';
                const status = item.STATUS || item.status || 'DRAFT';
                const sessionCount = item.SESSION_COUNT || item.sessionCount || 0;
                
                // FIXED BUG 1: Map ENROLLMENT_COUNT/enrollmentCount correctly
                const studentCount = item.ENROLLMENT_COUNT || item.enrollmentCount || 0;

                const badge = getStatusBadge(status);

                html += `
                    <tr>
                        <td class="ps-3">
                            <div class="fw-bold text-dark text-wrap" style="max-width: 320px;">${courseTitle}</div>
                        </td>
                        <td><span class="badge bg-light text-dark border px-2 py-1.5 fw-bold">${className}</span></td>
                        <td class="small text-muted">${start} - ${end}</td>
                        <td class="text-center fw-bold text-dark">${sessionCount}</td>
                        <td class="text-center fw-bold text-success">${studentCount}</td>
                        <td class="text-center"><span class="badge ${badge.cls} px-2.5 py-1.5 fw-bold">${badge.label}</span></td>
                        <td class="text-end pe-3">
                            <a href="${window.TRAINING_URLS.classManage.replace('__ID__', classId)}" class="btn btn-sm btn-success px-3 py-2 rounded-2 fw-bold d-inline-flex align-items-center gap-1">
                                <i class="bi bi-calendar-check" style="font-size: 1.1rem;"></i> Quản lý
                            </a>
                        </td>
                    </tr>
                `;
            });

            html += `
                            </tbody>
                        </table>
                    </div>
                </div>
            `;
            container.innerHTML = html;
            MobileTableHelper.refresh('teacher-classes-tbody');
        }

        function getStatusBadge(status) {
            switch (status) {
                case 'IN_PROGRESS':
                    return { cls: 'bg-success-subtle text-success-emphasis', label: 'Đang giảng dạy' };
                case 'SCHEDULED':
                    return { cls: 'bg-primary-subtle text-primary-emphasis', label: 'Đã lên lịch' };
                case 'COMPLETED':
                    return { cls: 'bg-secondary-subtle text-secondary-emphasis', label: 'Đã kết thúc' };
                case 'DRAFT':
                    return { cls: 'bg-light text-dark border', label: 'Nháp' };
                case 'OPEN_FOR_REGISTRATION':
                    return { cls: 'bg-warning-subtle text-warning-emphasis', label: 'Mở đăng ký' };
                default:
                    return { cls: 'bg-light text-dark', label: status };
            }
        }
    </script>
}
