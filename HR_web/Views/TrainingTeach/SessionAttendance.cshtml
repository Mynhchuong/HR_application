@{
    ViewData["Title"] = "Điểm danh Buổi học";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var empCd = ViewBag.EmpCd as string;
    var sessionId = ViewBag.SessionId;
}

<div class="container-fluid py-4" style="font-family: 'Outfit', sans-serif;">
    <!-- Back button -->
    <div class="mb-3">
        <a id="back-link" href="@Url.Action("MyClasses", "TrainingTeach")" class="text-decoration-none text-muted d-inline-flex align-items-center gap-1 small fw-bold">
            <span class="material-symbols-rounded" style="font-size: 1.1rem;">arrow_back</span>
            Quay lại quản lý lớp học
        </a>
    </div>

    <!-- Session Detail Header -->
    <div class="row mb-4">
        <div class="col-12" id="session-header-container">
            <div class="card border-0 shadow-sm p-4" style="border-radius: 16px;">
                <div class="placeholder-glow">
                    <span class="placeholder col-6 mb-2"></span>
                    <span class="placeholder col-4"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters & Batch Actions -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm p-3" style="border-radius: 16px;">
                <div class="row align-items-center g-3">
                    <!-- Group Filter -->
                    <div class="col-12 col-md-4">
                        <label class="form-label small fw-bold text-muted mb-1">Lọc theo Tổ/Nhóm</label>
                        <select id="group-filter" class="form-select" onchange="filterStudents()" style="border-radius: 8px;">
                            <option value="">Tất cả tổ nhóm</option>
                        </select>
                    </div>
                    <!-- Search -->
                    <div class="col-12 col-md-4">
                        <label class="form-label small fw-bold text-muted mb-1">Tìm học viên (Mã NV)</label>
                        <input type="text" id="search-input" class="form-control" placeholder="Nhập mã nhân viên..." oninput="filterStudents()" style="border-radius: 8px;" />
                    </div>
                    <!-- Batch Action Buttons -->
                    <div class="col-12 col-md-4 text-md-end pt-md-4">
                        <div class="btn-group w-100 w-md-auto">
                            <button id="btn-batch-present" onclick="confirmAttendanceBatch('PRESENT')" class="btn btn-outline-success fw-bold d-flex align-items-center justify-content-center gap-1" style="border-radius: 8px 0 0 8px;">
                                <span class="material-symbols-rounded" style="font-size: 1.1rem;">done_all</span>
                                Có mặt tất cả
                            </button>
                            <button id="btn-batch-absent" onclick="confirmAttendanceBatch('ABSENT')" class="btn btn-outline-danger fw-bold d-flex align-items-center justify-content-center gap-1" style="border-radius: 0 8px 8px 0;">
                                <span class="material-symbols-rounded" style="font-size: 1.1rem;">close</span>
                                Vắng tất cả
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Student Attendance Grid -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm overflow-hidden" style="border-radius: 16px;">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 text-nowrap">
                        <thead class="bg-light table-head-custom">
                            <tr>
                                <th class="ps-4">Mã NV</th>
                                <th>Họ tên học viên</th>
                                <th>Tổ/Nhóm</th>
                                <th class="text-center" style="width: 320px;">Trạng thái điểm danh</th>
                                <th>Lý do (nếu Vắng/Muộn)</th>
                                <th class="pe-4 text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="student-grid">
                            <!-- JS dynamic rows -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .table-head-custom th {
        font-weight: 700;
        color: #495057;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.5px;
        padding-top: 16px;
        padding-bottom: 16px;
        border-bottom: 2px solid #dee2e6;
    }
    .status-btn-group {
        display: inline-flex;
        border-radius: 8px;
        background-color: #f1f3f5;
        padding: 3px;
        border: 1px solid #e9ecef;
    }
    .status-btn {
        border: none;
        background: transparent;
        padding: 6px 14px;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 700;
        color: #495057;
        transition: all 0.15s ease;
    }
    .status-btn.present.active {
        background-color: #2b8a3e;
        color: #fff;
        box-shadow: 0 2px 6px rgba(43,138,62,0.3);
    }
    .status-btn.late.active {
        background-color: #e67e22;
        color: #fff;
        box-shadow: 0 2px 6px rgba(230,126,34,0.3);
    }
    .status-btn.absent.active {
        background-color: #c92a2a;
        color: #fff;
        box-shadow: 0 2px 6px rgba(201,42,42,0.3);
    }
    .bg-success-soft { background-color: #d1e7dd; color: #0f5132; }
</style>

@section Scripts {
    <script>
        window.TRAINING_URLS = {
            getTeacherAttendanceView: '@Url.Action("GetTeacherAttendanceView", "TrainingTeach")',
            confirmAttendance: '@Url.Action("ConfirmAttendance", "TrainingTeach")',
            confirmAttendanceBatch: '@Url.Action("ConfirmAttendanceBatch", "TrainingTeach")',
            classManage: '@Url.Action("ClassManage", "TrainingTeach", new { id = "__ID__" })'
        };
        const empCd = '@empCd';
        const sessionId = @sessionId;
        
        let allStudents = [];
        let sessionInfo = null;

        document.addEventListener('DOMContentLoaded', function () {
            loadAttendanceData();
        });

        function normalizeKeys(obj) {
            if (!obj || typeof obj !== 'object') return obj;
            if (Array.isArray(obj)) {
                return obj.map(normalizeKeys);
            }
            const res = {};
            for (const key in obj) {
                if (obj.hasOwnProperty(key)) {
                    res[key.toUpperCase()] = normalizeKeys(obj[key]);
                }
            }
            return res;
        }

        function loadAttendanceData() {
            fetch(`${window.TRAINING_URLS.getTeacherAttendanceView}?sessionId=${sessionId}&empcd=${empCd}`)
                .then(r => r.json())
                .then(res => {
                    if (!res || res.status === 403 || res.statusCode === 403) {
                        document.querySelector('.container-fluid').innerHTML = `<div class="alert alert-danger text-center">Bạn không phải giảng viên đứng lớp của buổi học này!</div>`;
                        return;
                    }
                    if (!res.success) {
                        document.querySelector('.container-fluid').innerHTML = `<div class="alert alert-warning text-center">${res.message || 'Lỗi tải danh sách điểm danh.'}</div>`;
                        return;
                    }

                    const normalizedData = normalizeKeys(res.data);
                    sessionInfo = normalizedData.SESSION;
                    allStudents = normalizedData.ATTENDANCE || [];

                    document.getElementById('back-link').href = window.TRAINING_URLS.classManage.replace('__ID__', sessionInfo.CLASS_ID);

                    renderHeader();
                    renderGroupFilter();
                    renderGrid();
                });
        }

        function renderHeader() {
            const wrap = document.getElementById('session-header-container');
            const s = sessionInfo;
            const dateStr = new Date(s.SESSION_DATE).toLocaleDateString('vi-VN');
            const isFinished = s.STATUS === 'FINISHED';

            const badgeHtml = isFinished
                ? `<span class="badge bg-danger text-white px-2.5 py-1.5 fw-bold mb-2">Buổi học đã kết thúc</span>`
                : `<span class="badge bg-success-soft text-success px-2.5 py-1.5 fw-bold mb-2">Điểm danh Buổi học</span>`;

            const warningHtml = isFinished
                ? `<div class="alert alert-danger border-0 d-flex align-items-center gap-2 mb-0 mt-3 rounded-3" style="font-size: .85rem;">
                       <span class="material-symbols-rounded text-danger" style="font-size: 1.2rem;">warning</span>
                       <div>Buổi học này đã kết thúc. Bạn không thể cập nhật hoặc sửa đổi thông tin điểm danh.</div>
                   </div>`
                : '';

            wrap.innerHTML = `
                <div class="card border-0 shadow-sm p-4" style="border-radius: 16px; background: #fff;">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            ${badgeHtml}
                            <h3 class="fw-bold mb-1 text-dark">${s.TOPIC || 'Không có chủ đề'}</h3>
                            <p class="text-muted mb-0">Lớp: <strong>${s.CLASS_NAME}</strong> | Thời gian: <strong>${s.START_TIME} - ${s.END_TIME} (${dateStr})</strong> | Phòng: <strong>${s.LOCATION || 'N/A'}</strong></p>
                        </div>
                        <div class="text-end">
                            <span class="small text-muted d-block">Sĩ số lớp</span>
                            <span class="fs-2 fw-bold text-success">${allStudents.length}</span>
                        </div>
                    </div>
                    ${warningHtml}
                </div>
            `;

            if (isFinished) {
                const btnPres = document.getElementById('btn-batch-present');
                const btnAbs = document.getElementById('btn-batch-absent');
                if (btnPres) btnPres.disabled = true;
                if (btnAbs) btnAbs.disabled = true;
            }
        }

        function renderGroupFilter() {
            const select = document.getElementById('group-filter');
            const groupsSet = new Set();
            
            allStudents.forEach(st => {
                if (st.GROUP_NAME) groupsSet.add(st.GROUP_NAME);
            });

            select.innerHTML = '<option value="">Tất cả tổ nhóm</option>';
            groupsSet.forEach(g => {
                select.innerHTML += `<option value="${g}">${g}</option>`;
            });
        }

        function toUnsigned(str) {
            if (!str) return '';
            let text = str.toLowerCase().trim();
            const vniMap = {
                'aù':'u', 'aø':'a', 'aû':'a', 'aõ':'a', 'aï':'a', 'aâ':'a', 'aê':'a',
                'eù':'e', 'eø':'e', 'eû':'e', 'eã':'e', 'eï':'e', 'eâ':'e',
                'où':'o', 'oø':'o', 'oû':'o', 'oõ':'o', 'oï':'o', 'oô':'o',
                'uù':'u', 'uø':'u', 'uû':'u', 'uõ':'u', 'uï':'u',
                'yù':'y', 'yø':'y', 'yû':'y', 'yõ':'y', 'yï':'y',
                'ö':'u', 'ô':'o', 'ñ':'d',
                'á':'a', 'à':'a', 'ả':'a', 'ã':'a', 'ạ':'a',
                'ă':'a', 'ắ':'a', 'ằ':'a', 'ẳ':'a', 'ẵ':'a', 'ặ':'a',
                'â':'a', 'ấ':'a', 'ầ':'a', 'ẩ':'a', 'ẫ':'a', 'ậ':'a',
                'é':'e', 'è':'e', 'ẻ':'e', 'ẽ':'e', 'ẹ':'e',
                'ê':'e', 'ế':'e', 'ề':'e', 'ể':'e', 'ễ':'e', 'ệ':'e',
                'í':'i', 'ì':'i', 'ỉ':'i', 'ĩ':'i', 'ị':'i',
                'ó':'o', 'ò':'o', 'ỏ':'o', 'õ':'o', 'ọ':'o',
                'ô':'o', 'ố':'o', 'ồ':'o', 'ổ':'o', 'ỗ':'o', 'ộ':'o',
                'ơ':'o', 'ớ':'o', 'ờ':'o', 'ở':'o', 'ỡ':'o', 'ợ':'o',
                'ú':'u', 'ù':'u', 'ủ':'u', 'ũ':'u', 'ụ':'u',
                'ư':'u', 'ứ':'u', 'ừ':'u', 'ử':'u', 'ữ':'u', 'ự':'u',
                'ý':'y', 'ỳ':'y', 'ỷ':'y', 'ỹ':'y', 'ỵ':'y',
                'đ':'d'
            };
            for (const key in vniMap) {
                if (key.length > 1) text = text.replaceAll(key, vniMap[key]);
            }
            for (const key in vniMap) {
                if (key.length === 1) text = text.replaceAll(key, vniMap[key]);
            }
            return text.normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        }

        function renderGrid() {
            const tbody = document.getElementById('student-grid');
            const filterGroup = document.getElementById('group-filter').value;
            const search = toUnsigned(document.getElementById('search-input').value);

            tbody.innerHTML = '';
            
            let count = 0;
            const isFinished = sessionInfo && sessionInfo.STATUS === 'FINISHED';
            const disabledAttr = isFinished ? 'disabled' : '';

            allStudents.forEach(st => {
                if (filterGroup && st.GROUP_NAME !== filterGroup) return;
                
                const empcdUnsigned = toUnsigned(st.EMPCD);
                const matchesSearch = empcdUnsigned.includes(search);
                if (!matchesSearch) return;

                count++;

                const status = st.ATTENDANCE_STATUS || st.STATUS || 'PRESENT';
                const actPresent = status === 'PRESENT' ? 'active' : '';
                const actLate    = status === 'LATE'    ? 'active' : '';
                const actAbsent  = status === 'ABSENT'  ? 'active' : '';

                const reasonVal = st.REASON || st.NOTE || '';

                tbody.innerHTML += `
                    <tr id="row_${st.EMPCD}">
                        <td class="ps-4 fw-bold text-dark">${st.EMPCD}</td>
                        <td class="fw-bold vni-font" style="text-transform: uppercase;">${st.EMP_NAME || 'N/A'}</td>
                        <td><span class="badge bg-light text-dark border">${st.GROUP_NAME || '-'}</span></td>
                        <td class="text-center">
                            <div class="status-btn-group">
                                <button onclick="setStatus('${st.EMPCD}', 'PRESENT')" class="status-btn present ${actPresent}" id="btn_P_${st.EMPCD}" ${disabledAttr}>P (Có mặt)</button>
                                <button onclick="setStatus('${st.EMPCD}', 'LATE')" class="status-btn late ${actLate}" id="btn_L_${st.EMPCD}" ${disabledAttr}>L (Muộn)</button>
                                <button onclick="setStatus('${st.EMPCD}', 'ABSENT')" class="status-btn absent ${actAbsent}" id="btn_A_${st.EMPCD}" ${disabledAttr}>A (Vắng)</button>
                            </div>
                        </td>
                        <td>
                            <input type="text" id="reason_${st.EMPCD}" class="form-control form-control-sm" placeholder="Ghi chú lý do..." value="${reasonVal}" style="border-radius: 6px; max-width: 250px;" onchange="saveReason('${st.EMPCD}')" ${disabledAttr} />
                        </td>
                        <td class="pe-4 text-end">
                            <button onclick="confirmAttendanceSingle('${st.EMPCD}')" class="btn btn-sm btn-success rounded-3 fw-bold d-inline-flex align-items-center gap-0.5" ${disabledAttr}>
                                <span class="material-symbols-rounded" style="font-size: 1rem;">save</span>
                                Lưu
                            </button>
                        </td>
                    </tr>
                `;
            });

            if (count === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="text-center py-4 text-muted">Không tìm thấy học viên nào phù hợp bộ lọc.</td></tr>`;
            }
        }

        window.filterStudents = function() {
            renderGrid();
        };

        window.setStatus = function(empcd, status) {
            const student = allStudents.find(s => s.EMPCD === empcd);
            if (student) {
                student.ATTENDANCE_STATUS = status;
            }

            const btnP = document.getElementById(`btn_P_${empcd}`);
            const btnL = document.getElementById(`btn_L_${empcd}`);
            const btnA = document.getElementById(`btn_A_${empcd}`);

            btnP.classList.remove('active');
            btnL.classList.remove('active');
            btnA.classList.remove('active');

            if (status === 'PRESENT') btnP.classList.add('active');
            else if (status === 'LATE') btnL.classList.add('active');
            else if (status === 'ABSENT') btnA.classList.add('active');
        };

        window.saveReason = function(empcd) {
            const student = allStudents.find(s => s.EMPCD === empcd);
            if (student) {
                student.REASON = document.getElementById(`reason_${empcd}`).value.trim();
            }
        };

        window.confirmAttendanceSingle = function(studentEmpcd) {
            const student = allStudents.find(s => s.EMPCD === studentEmpcd);
            if (!student) return;

            fetch(window.TRAINING_URLS.confirmAttendance, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    SESSION_ID: sessionId,
                    ATTENDEE_EMPCD: student.EMPCD,
                    ATTENDANCE_STATUS: student.ATTENDANCE_STATUS || student.STATUS || 'PRESENT',
                    REASON: student.REASON || null
                })
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    window.showToast(`Đã lưu điểm danh học viên ${student.EMP_NAME || student.EMPCD}`, 'success');
                } else {
                    window.showToast(res.message || 'Lỗi lưu điểm danh.', 'error');
                }
            })
            .catch(err => window.showToast('Lỗi kết nối: ' + err.message, 'error'));
        };

        window.confirmAttendanceBatch = function(status) {
            const filterGroup = document.getElementById('group-filter').value;
            
            const msg = filterGroup 
                ? `Bạn muốn điểm danh nhanh trạng thái "${status}" cho cả Tổ/Nhóm "${filterGroup}" không?`
                : `Bạn muốn điểm danh nhanh trạng thái "${status}" cho TOÀN BỘ lớp học không?`;

            window.showConfirm(msg, () => {
                fetch(window.TRAINING_URLS.confirmAttendanceBatch, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        SESSION_ID: sessionId,
                        GROUP_NAME: filterGroup || null,
                        ATTENDANCE_STATUS: status
                    })
                })
                .then(r => r.json())
                .then(res => {
                    if (res.success) {
                        window.showToast('Đã điểm danh nhanh thành công!', 'success');
                        loadAttendanceData();
                    } else {
                        window.showToast(res.message || 'Lỗi điểm danh lô.', 'error');
                    }
                })
                .catch(err => window.showToast('Lỗi kết nối: ' + err.message, 'error'));
            }, {
                title: 'Điểm danh nhanh',
                okText: 'Áp dụng',
                okClass: status === 'PRESENT' ? 'btn-success' : 'btn-danger',
                icon: status === 'PRESENT' ? 'done_all' : 'close',
                iconColor: status === 'PRESENT' ? '#198754' : '#dc2626',
                iconBg: status === 'PRESENT' ? '#e8f5e9' : '#fde8e8'
            });
        };
    </script>
}
