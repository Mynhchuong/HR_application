@{
    ViewData["Title"] = "Chấm điểm tự luận";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var empCd = ViewBag.EmpCd as string;
    var testId = ViewBag.TestId;
}

<div class="container-fluid py-4">
    <!-- Back to Dashboard -->
    <div class="mb-3">
        <a href="@Url.Action("MyClasses", "TrainingTeach")" class="text-decoration-none text-muted d-inline-flex align-items-center gap-1 small fw-bold">
            <i class="bi bi-arrow-left" style="font-size: 1.1rem;"></i>
            Quay lại cổng giảng dạy
        </a>
    </div>

    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm p-4" style="border-radius: 16px;">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div>
                        <span class="badge bg-warning-subtle text-warning-emphasis px-2.5 py-1.5 fw-bold mb-2">Chấm điểm Tự luận</span>
                        <h3 class="fw-bold mb-1 text-dark" id="test-title">Đang tải tên bài kiểm tra...</h3>
                        <p class="text-muted mb-0">Chấm điểm các câu trả lời tự luận viết tay từ học viên để hoàn tất kết quả bài thi.</p>
                    </div>
                    <div class="bg-light px-4 py-3 text-center rounded-3" style="min-width: 150px;">
                        <span class="small text-muted d-block">Bài thi chưa chấm</span>
                        <span class="fs-2 fw-bold text-warning" id="pending-count">0</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Student Attempt List with Essays -->
    <div class="row">
        <div class="col-12" id="attempts-container">
            <div class="text-center py-5">
                <div class="spinner-border text-warning" role="status"><span class="visually-hidden">Loading...</span></div>
                <p class="mt-2 text-muted">Đang tải danh sách bài thi cần chấm tự luận...</p>
            </div>
        </div>
    </div>
</div>

<style>
    .attempt-card {
        border-radius: 16px;
        border: 1px solid rgba(0,0,0,0.06);
        background-color: #fff;
        transition: all 0.2s;
    }
    .essay-card {
        border-radius: 12px;
        background-color: #f8f9fa;
        border: 1px solid #e9ecef;
    }</style>

@section Scripts {
    <script>
        window.TRAINING_URLS = {
            getPendingGrade: '@Url.Action("GetPendingGrade", "TrainingTeach")',
            grade: '@Url.Action("Grade", "TrainingTeach")'
        };
        const empCd = '@empCd';
        const testId = @testId;

        let gradingData = [];

        document.addEventListener('DOMContentLoaded', function () {
            loadGradingData();
        });

        function loadGradingData() {
            fetch(`${window.TRAINING_URLS.getPendingGrade}?id=${testId}&empcd=${empCd}`)
                .then(r => r.json())
                .then(res => {
                    if (!res) {
                        document.getElementById('attempts-container').innerHTML = `<div class="alert alert-danger text-center">Bạn không có quyền truy cập hoặc lỗi kết nối máy chủ!</div>`;
                        return;
                    }
                    if (res.status === 403 || res.statusCode === 403) {
                        document.getElementById('attempts-container').innerHTML = `<div class="alert alert-danger text-center">${res.message || 'Bạn không có quyền chấm bài kiểm tra này!'}</div>`;
                        return;
                    }
                    if (!res.success) {
                        document.getElementById('attempts-container').innerHTML = `<div class="alert alert-warning text-center">${res.message || 'Lỗi tải bài thi cần chấm.'}</div>`;
                        return;
                    }

                    gradingData = res.data || [];
                    document.getElementById('pending-count').textContent = gradingData.length;

                    const firstItem = gradingData[0] || {};
                    const firstAtt = firstItem.attempt || firstItem.ATTEMPT;
                    if (firstAtt) {
                        document.getElementById('test-title').textContent = "Bài thi: " + (firstAtt.TEST_TITLE || firstAtt.testTitle || "Đánh giá đào tạo");
                    } else {
                        document.getElementById('test-title').textContent = "Chưa có bài thi cần chấm tự luận";
                    }

                    renderAttempts();
                });
        }

        function renderAttempts() {
            const container = document.getElementById('attempts-container');
            
            if (gradingData.length === 0) {
                container.innerHTML = `
                    <div class="card border-0 shadow-sm text-center py-5" style="border-radius: 16px;">
                        <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
                        <h5 class="fw-bold text-dark mt-3">Tất cả bài thi đã được chấm điểm hoàn chỉnh!</h5>
                        <p class="text-muted small">Không còn bài làm tự luận nào đang chờ giảng viên chấm điểm.</p>
                        <div class="mt-2">
                             <a href="@(ViewBag.ClassId != null ? Url.Action("ClassManage", "TrainingTeach", new { id = (int)ViewBag.ClassId }) : Url.Action("MyClasses", "TrainingTeach"))" class="btn btn-outline-success rounded-3 fw-bold px-4">Quay về quản lý</a>
                        </div>
                    </div>
                `;
                return;
            }

            container.innerHTML = '';
            gradingData.forEach((item, idx) => {
                const att = item.attempt || item.ATTEMPT;
                if (!att) return;

                const submitDtStr = att.SUBMIT_DT || att.submitDt;
                const submitDate = submitDtStr ? new Date(submitDtStr).toLocaleString('vi-VN') : 'N/A';
                
                let essaysHtml = '';
                const essaysList = item.essays || item.ESSAYS || [];
                essaysList.forEach(es => {
                    const ansId = es.ANSWER_ID || es.answerId;
                    const qText = es.QUESTION_TEXT || es.questionText;
                    const qPoints = es.QUESTION_POINTS || es.questionPoints || 0;
                    const aText = es.ANSWER_TEXT || es.answerText;
                    
                    const pointsId = `points_${ansId}`;
                    const commentId = `comment_${ansId}`;
                    
                    essaysHtml += `
                        <div class="essay-card p-4 mb-3 position-relative">
                            <div class="d-flex justify-content-between mb-3 border-bottom pb-2">
                                <h6 class="fw-bold text-primary mb-0"><i class="bi bi-question-circle-fill me-1"></i>Câu hỏi: ${qText}</h6>
                                <span class="badge bg-secondary-subtle text-secondary-emphasis px-2 py-1 small">Điểm tối đa: ${qPoints}đ</span>
                            </div>
                            
                            <div class="mb-3">
                                <label class="small fw-bold text-muted mb-1 d-block">Câu trả lời của học viên:</label>
                                <div class="bg-white p-3 border rounded text-dark small" style="white-space: pre-wrap; min-height: 80px;">${aText || 'Không có câu trả lời.'}</div>
                            </div>
                            
                            <div class="row g-3">
                                <div class="col-12 col-md-3">
                                    <label class="form-label small fw-bold text-muted">Điểm cho học viên (0 - ${qPoints})</label>
                                    <input type="number" id="${pointsId}" class="form-control" placeholder="Điểm..." min="0" max="${qPoints}" step="0.5" style="border-radius: 8px;" />
                                </div>
                                <div class="col-12 col-md-7">
                                    <label class="form-label small fw-bold text-muted">Nhận xét của giáo viên (tuỳ chọn)</label>
                                    <input type="text" id="${commentId}" class="form-control" placeholder="Nhập nhận xét..." style="border-radius: 8px;" />
                                </div>
                                <div class="col-12 col-md-2 text-end pt-md-4">
                                    <button onclick="submitGrade(${ansId}, ${qPoints})" class="btn btn-warning w-100 py-2 rounded-3 fw-bold d-inline-flex align-items-center justify-content-center gap-1">
                                        <i class="bi bi-save" style="font-size: 1.1rem;"></i>
                                        Lưu điểm
                                    </button>
                                </div>
                            </div>
                        </div>
                    `;
                });

                const empCdVal = att.EMPCD || att.empcd || '';
                const empNameVal = att.EMP_NAME || att.empName || 'N/A';
                const attemptNoVal = att.ATTEMPT_NO || att.attemptNo || 1;
                const scoreVal = att.SCORE || att.score || 0;

                container.innerHTML += `
                    <div class="card border-0 shadow-sm p-4 mb-4 attempt-card">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 bg-light p-3 rounded-3">
                            <div>
                                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-person-fill me-1"></i>Học viên: <span class="vni-font" style="text-transform:uppercase;">${empNameVal}</span> (${empCdVal})</h6>
                                <span class="small text-muted">Nộp bài ngày: ${submitDate} | Số lần thi: Lượt ${attemptNoVal}</span>
                            </div>
                            <div class="text-md-end">
                                <span class="small text-muted d-block">Trắc nghiệm đạt:</span>
                                <span class="fw-bold text-dark">${scoreVal} điểm</span>
                            </div>
                        </div>
                        
                        <div class="essays-wrapper mt-3">
                            ${essaysHtml}
                        </div>
                    </div>
                `;
            });
        }

        window.submitGrade = function(answerId, maxPoints) {
            const ptsInput = document.getElementById(`points_${answerId}`);
            const commentInput = document.getElementById(`comment_${answerId}`);
            
            const pointsVal = parseFloat(ptsInput.value);
            const comment = commentInput.value.trim();

            if (isNaN(pointsVal) || pointsVal < 0 || pointsVal > maxPoints) {
                window.showToast(`Điểm số không hợp lệ! Vui lòng nhập điểm từ 0 đến ${maxPoints}`, 'warning');
                return;
            }

            fetch(window.TRAINING_URLS.grade, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    ANSWER_ID: answerId,
                    POINTS_AWARDED: pointsVal,
                    GRADER_COMMENT: comment || null
                })
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    window.showToast('Lưu điểm thành công!', 'success');
                    loadGradingData();
                } else {
                    window.showToast(res.message || 'Lỗi chấm điểm.', 'error');
                }
            })
            .catch(err => window.showToast('Lỗi kết nối: ' + err.message, 'error'));
        };
    </script>
}
