@{
    ViewData["Title"] = "Xem trước bài kiểm tra";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var empCd = ViewBag.EmpCd as string;
    var testId = ViewBag.TestId;
}

<div class="container py-4" style="max-width: 900px;">
    <div class="card my-4">
        @await Html.PartialAsync("_TrainingPageHeader", new TrainingPageHeaderVM
        {
            Title = "Xem trước đề thi",
            Icon = "bi-eye",
            Gradient = "warning",
            BackUrl = Url.Action("MyClasses", "TrainingTeach"),
        })
    <div class="card-body">

    <!-- Header Card / Loading -->
    <div id="preview-loading" class="text-center py-5">
        <div class="spinner-border text-warning" style="width: 3rem; height: 3rem;" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-3 text-muted">Đang tải nội dung đề thi...</p>
    </div>

    <!-- Preview Container -->
    <div id="preview-content" class="d-none">
        <div class="card border-0 shadow-sm p-4 mb-4" style="border-radius: 16px; background: linear-gradient(135deg, #fff 0%, #fdfbf7 100%); border-left: 5px solid #ffc107 !important;">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div>
                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill mb-2 fw-bold">Chế độ xem trước</span>
                    <h3 class="fw-bold text-dark mb-1" id="test-title">Tên bài thi</h3>
                    <p class="text-muted mb-0" id="test-description">Mô tả bài thi</p>
                </div>
                <div class="card bg-white border shadow-sm p-3" style="border-radius: 12px; min-width: 220px;">
                    <div class="d-flex justify-content-between small text-muted mb-1">
                        <span>Thời gian làm bài:</span>
                        <span class="fw-bold text-dark" id="test-duration">-- phút</span>
                    </div>
                    <div class="d-flex justify-content-between small text-muted mb-1">
                        <span>Điểm sàn đạt:</span>
                        <span class="fw-bold text-dark" id="test-pass-score">-- điểm</span>
                    </div>
                    <div class="d-flex justify-content-between small text-muted">
                        <span>Số lượng câu hỏi:</span>
                        <span class="fw-bold text-dark" id="test-qcount">-- câu</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="alert alert-info border-0 shadow-sm mb-4 d-flex align-items-center gap-2" style="border-radius: 12px;">
            <i class="bi bi-info-circle text-info"></i>
            <span class="small">Đây là chế độ xem trước dành cho giáo viên. Các đáp án đúng được làm nổi bật bằng màu <strong>xanh lá cây</strong>.</span>
        </div>

        <!-- Questions list container -->
        <div id="questions-list"></div>
    </div>
    </div>
    </div>
</div>

<style>
    .question-card {
        border-radius: 16px;
        border: 1px solid rgba(0,0,0,0.08);
        transition: all 0.2s;
    }
    .question-card:hover {
        border-color: #ffc107;
    }
    .option-item {
        border-radius: 10px;
        border: 1px solid #dee2e6;
        padding: 12px 16px;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 12px;
        background-color: #fff;
    }
    .option-item.correct-option {
        border-color: #198754;
        background-color: #d1e7dd;
        color: #0f5132;
        font-weight: 600;
    }
</style>

@section Scripts {
    <script>
        const testId = @testId;
        const getTestDetailUrl = '@Url.Action("GetTestDetailForPreview", "TrainingTeach")';

        document.addEventListener('DOMContentLoaded', function () {
            loadTestDetail();
        });

        function loadTestDetail() {
            fetch(`${getTestDetailUrl}?id=${testId}`)
                .then(r => r.json())
                .then(res => {
                    if (!res.success) {
                        document.getElementById('preview-loading').innerHTML = `
                            <div class="alert alert-danger p-4 text-center">
                                ${res.message || 'Lỗi tải thông tin đề thi hoặc bạn không có quyền xem đề thi này.'}
                            </div>`;
                        return;
                    }

                    const test = res.data.test || res.data.TEST || {};
                    const questions = res.data.questions || res.data.QUESTIONS || [];

                    // Render metadata
                    const title = test.TITLE || test.title || '';
                    const desc = test.DESCRIPTION || test.description || '';
                    const dur = test.DURATION_MINUTES || test.durationMinutes || 0;
                    const passScore = (test.PASS_SCORE || test.passScore) ?? '—';

                    document.getElementById('test-title').textContent = title;
                    document.getElementById('test-description').textContent = desc || 'Không có mô tả.';
                    document.getElementById('test-duration').textContent = `${dur} phút`;
                    document.getElementById('test-pass-score').textContent = `${passScore} điểm`;
                    document.getElementById('test-qcount').textContent = `${questions.length} câu`;

                    renderQuestions(questions);

                    document.getElementById('preview-loading').classList.add('d-none');
                    document.getElementById('preview-content').classList.remove('d-none');
                })
                .catch(err => {
                    document.getElementById('preview-loading').innerHTML = `
                        <div class="alert alert-danger p-4 text-center">
                            Không thể kết nối đến máy chủ. Vui lòng thử lại sau.
                        </div>`;
                });
        }

        function renderQuestions(questions) {
            const listContainer = document.getElementById('questions-list');
            listContainer.innerHTML = '';

            if (questions.length === 0) {
                listContainer.innerHTML = '<div class="alert alert-warning text-center">Đề thi này chưa có câu hỏi nào.</div>';
                return;
            }

            questions.forEach((q, idx) => {
                let optionsHtml = '';
                const qType = q.QUESTION_TYPE || q.questionType;
                const qText = q.QUESTION_TEXT || q.questionText || '';
                const qPoints = q.POINTS || q.points || 0;
                const qOpts = q.OPTIONS || q.options || [];

                if (qType === 'TEXT') {
                    optionsHtml = `
                        <div class="p-3 border rounded-3 bg-light text-muted small">
                            <i class="bi bi-pencil-square align-middle me-1" style="font-size: 1.1rem;"></i>
                            Câu hỏi tự luận (giáo viên sẽ chấm điểm thủ công sau khi học viên nộp bài)
                        </div>`;
                } else {
                    const typeLabel = qType === 'MULTI' ? 'Chọn nhiều đáp án' : 'Chọn 1 đáp án';
                    optionsHtml += `<div class="mb-2"><span class="badge bg-light text-dark border small mb-2">${typeLabel}</span></div>`;
                    
                    qOpts.forEach(opt => {
                        const isCorrectVal = opt.IS_CORRECT || opt.isCorrect;
                        const isCorrect = isCorrectVal === 1 || isCorrectVal === true;
                        const optText = opt.OPTION_TEXT || opt.optionText || '';

                        const optClass = isCorrect ? 'option-item correct-option' : 'option-item';
                        const icon = isCorrect 
                            ? '<i class="bi bi-check-circle text-success" style="font-size: 1.25rem;"></i>' 
                            : '<i class="bi bi-circle text-muted" style="font-size: 1.25rem;"></i>';

                        optionsHtml += `
                            <div class="${optClass}">
                                ${icon}
                                <span class="option-text">${optText}</span>
                                ${isCorrect ? '<span class="badge bg-success ms-auto">Đúng</span>' : ''}
                            </div>`;
                    });
                }

                listContainer.innerHTML += `
                    <div class="card border-0 shadow-sm p-4 mb-4 question-card">
                        <div class="d-flex align-items-start gap-2 mb-3">
                            <span class="badge bg-warning text-dark rounded px-2.5 py-1.5 fw-bold">Câu ${idx + 1}</span>
                            <h6 class="fw-bold mb-0 text-dark pt-1 lh-base">${qText}</h6>
                            <span class="small text-muted ms-auto fw-semibold">${qPoints} điểm</span>
                        </div>
                        <div class="question-body">
                            ${optionsHtml}
                        </div>
                    </div>`;
            });
        }
    </script>
}
