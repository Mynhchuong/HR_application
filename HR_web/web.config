<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- 500 MB = 524288000 bytes -->
        <requestLimits maxAllowedContentLength="524288000" />
      </requestFiltering>
    </security>
  </system.webServer>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\HR_web.dll" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <handlerSettings>
          <handlerSetting name="debugFile" value=".\logs\ancm.log" />
          <handlerSetting name="debugLevel" value="WARNING" />
        </handlerSettings>
      </aspNetCore>
      <staticContent>
        <remove fileExtension=".mp4" />
        <remove fileExtension=".webm" />
        <remove fileExtension=".mov" />
        <mimeMap fileExtension=".mp4"  mimeType="video/mp4" />
        <mimeMap fileExtension=".webm" mimeType="video/webm" />
        <mimeMap fileExtension=".mov"  mimeType="video/quicktime" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
