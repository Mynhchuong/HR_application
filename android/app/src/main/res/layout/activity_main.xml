<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".MainActivity">

    <WebView
        android:id="@+id/webView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:progressDrawable="@drawable/progress_bar_states"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layoutNoInternet"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:background="#FFFFFF"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:scaleType="fitCenter"
                android:src="@drawable/chi"
                android:layout_marginEnd="16dp"/>

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:scaleType="fitCenter"
                android:src="@drawable/a_hoi"
                android:layout_marginStart="16dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Không kết nối được máy chủ. Vui lòng kiểm tra internet/wifi rồi thử lại.\nCannot connect. Please check your connection and try again."
            android:textSize="18sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:textColor="#333333"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="Thử lại" />

    </LinearLayout>

    <!-- Splash — che khoảng trắng chớp giữa lúc WebView bắt đầu tải và trang Home vẽ xong lần đầu
         (progress bar mỏng không đủ rõ, cảm giác app đứng hình — yêu cầu tối ưu UX 2026-10-26). Ẩn ở
         onPageFinished (MainActivity.java). Khai SAU CÙNG trong XML để luôn vẽ đè lên WebView/no-internet. -->
    <LinearLayout
        android:id="@+id/layoutSplash"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!--
          Cụm logo của màn hình mở app. Thứ tự vẽ: đĩa (icon app) -> vòng đen -> vòng đỏ -> chữ S.
          Tất cả chồng lên nhau cùng một chỗ để "biến hình" bằng cách mờ chồng, xem
          MainActivity.startSplashAnimation(). Kích thước vòng theo đúng tỉ lệ logo gốc của công ty
          (3231 x 2724 -> 172dp x 145dp), vòng Samho hơi dẹt chứ không tròn đều.
        -->
        <FrameLayout
            android:id="@+id/splashGroup"
            android:layout_width="172dp"
            android:layout_height="145dp">

            <View
                android:id="@+id/splashDisc"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_gravity="center" />

            <ImageView
                android:id="@+id/splashRingDark"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/logo_ring"
                android:scaleType="fitXY"
                android:alpha="0"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/splashRingRed"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/logo_ring"
                android:scaleType="fitXY"
                android:alpha="0"
                android:contentDescription="@null" />

            <!-- Chữ S đặt theo tỉ lệ đo từ file logo gốc: x=22.75% y=19.16% w=55.4% h=59.73% -->
            <ImageView
                android:id="@+id/splashS"
                android:layout_width="95dp"
                android:layout_height="87dp"
                android:layout_marginStart="39dp"
                android:layout_marginTop="28dp"
                android:src="@drawable/logo_s"
                android:scaleType="fitXY"
                android:alpha="0"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:id="@+id/splashName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textSize="26sp"
            android:alpha="0" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>