<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:cardUseCompatPadding="true"
    android:layout_margin="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <ImageView
            android:id="@+id/dialogImage"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:scaleType="fitCenter"
            android:src="@drawable/chi"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chào mừng bạn! / Welcome!"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vui lòng chọn mạng để bắt đầu\nPlease select a network to continue"
            android:textSize="15sp"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInternal"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Mạng nội bộ Samho / Company Network"
            android:textSize="14sp"
            app:cornerRadius="12dp"
            app:icon="@android:drawable/ic_menu_directions"
            android:layout_marginBottom="12dp"
            style="@style/Widget.MaterialComponents.Button"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExternal"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Mạng bên ngoài (4G/Wifi) / External (4G/Wifi)"
            android:textSize="14sp"
            app:cornerRadius="12dp"
            app:icon="@android:drawable/ic_menu_share"
            android:backgroundTint="#F5F5F5"
            android:textColor="#333333"
            style="@style/Widget.MaterialComponents.Button.TextButton"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Khuyến nghị dùng 4G cá nhân để trải nghiệm tốt nhất\nWe recommend using your personal 4G for the best experience"
            android:textSize="12sp"
            android:textColor="#999999"
            android:gravity="center"
            android:layout_marginTop="14dp"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
