<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget màn hình chính My Samho.

  RemoteViews KHÔNG cho phép inflate động theo role, nên 2 bố cục (công nhân / quản lý) nằm sẵn
  trong cùng 1 layout, provider chỉ bật-tắt visibility. Chỉ dùng các view RemoteViews hỗ trợ
  (LinearLayout/TextView/ImageView) — ConstraintLayout KHÔNG dùng được trong widget.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <!-- ── Đầu thẻ: tên app · người dùng · chuông chưa đọc ───────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_stat_noti"
            android:contentDescription="@string/widget_title"
            android:tint="@color/widget_accent" />

        <TextView
            android:id="@+id/wHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/widget_title"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/wUnread"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/widget_pill"
            android:textColor="@color/widget_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ══ Bố cục CÔNG NHÂN ══════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/wWorker"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginTop="8dp">

        <!-- Thông báo quan trọng -->
        <TextView
            android:id="@+id/wNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Đơn của mình: duyệt chưa -->
        <TextView
            android:id="@+id/wMyReq"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/widget_muted"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Bản tin Samho mới nhất -->
        <TextView
            android:id="@+id/wBulletin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/widget_muted"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- ══ Bố cục QUẢN LÝ / EXPAT — 3 ô số ═══════════════════════════════ -->
    <LinearLayout
        android:id="@+id/wManager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/wCellApprove"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_pill">
            <TextView android:id="@+id/wNumApprove"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/widget_accent" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:id="@+id/wLblApprove"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/widget_muted" android:textSize="10sp"
                android:gravity="center" android:maxLines="2"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeMaxTextSize="10sp"
                android:autoSizeStepGranularity="1sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wCellGate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_pill">
            <TextView android:id="@+id/wNumGate"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/widget_text" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:id="@+id/wLblGate"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/widget_muted" android:textSize="10sp"
                android:gravity="center" android:maxLines="2"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeMaxTextSize="10sp"
                android:autoSizeStepGranularity="1sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wCellLeave"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_pill">
            <TextView android:id="@+id/wNumLeave"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/widget_text" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:id="@+id/wLblLeave"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/widget_muted" android:textSize="10sp"
                android:gravity="center" android:maxLines="2"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeMaxTextSize="10sp"
                android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Chân thẻ: mốc cập nhật / nhắc đăng nhập lại -->
    <TextView
        android:id="@+id/wFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/widget_muted"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
